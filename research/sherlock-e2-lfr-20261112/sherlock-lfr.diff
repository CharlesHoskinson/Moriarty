+//! Sherlock E2: the Fr recursion AIR set `L_Fr` that verifies one `L` proof.
+//!
+//! Plan: `research/sherlock-e2-lfr-20261112/PLAN.md` (Moriarty). Route: a dedicated verifier of
+//! the `L` vk with the `L` shape pinned (D-1), run as a tape over generic Fr AIRs.
+
+#![allow(clippy::needless_range_loop)] // index loops mirror the arithmetic of the AIRs
+
+pub mod alu;
+pub mod bb;
+pub mod fixture;
+pub mod fr;
+pub mod lverify;
