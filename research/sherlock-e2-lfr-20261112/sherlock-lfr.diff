diff --git a/crates/sherlock-lfr/src/lverify.rs b/crates/sherlock-lfr/src/lverify.rs
new file mode 100644
index 0000000..58a0cbe
--- /dev/null
+++ b/crates/sherlock-lfr/src/lverify.rs
@@ -0,0 +1,1213 @@
+//! I6: the tape generator for the `L` verifier, part 1 (shape pin, preamble, LogUp PoW, LogUp
+//! GKR, the GKR claim checks). A mirror of `stark-backend/src/verifier/mod.rs` (preamble),
+//! `batch_constraints.rs` (steps 1 to 3) and `fractional_sumcheck_gkr.rs`, line by line.
+//!
+//! The ops depend only on the `L` vk and the pinned shape [`LShape`] (D-1); the proof gives the
+//! input values. Each proof value is an `Input` (BabyBear or `EF4`) or `FrInput` op, in the order
+//! the verifier reads it. Each check of the verifier is an `AssertEq` op; `check_witness` is an
+//! observe, a sample, a `LowBits` op and an `AssertEq` with 0.
+
+use std::{cmp::Reverse, collections::HashMap};
+
+use openvm_stark_backend::{
+    calculate_n_logup, keygen::types::MultiStarkVerifyingKey, proof::Proof,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{Bls12381Fr as Fr, U_TRANSCRIPT};
+use p3_baby_bear::BabyBear;
+use p3_field::{Field, PrimeCharacteristicRing, PrimeField32};
+
+use crate::{
+    bb::{from_ef4, Ef4},
+    fixture::LSC,
+    tape::{Addr, Tape, Val, ValKind},
+    transcript::TapeTranscript,
+};
+
+/// The pinned shape of `L` (D-1): per AIR in vk order, its log height or `None` (absent).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LShape {
+    pub log_heights: Vec<Option<usize>>,
+}
+
+impl LShape {
+    pub fn of(proof: &Proof<LSC>) -> Self {
+        Self {
+            log_heights: proof
+                .trace_vdata
+                .iter()
+                .map(|v| v.as_ref().map(|v| v.log_height))
+                .collect(),
+        }
+    }
+
+    /// Present AIRs sorted as the verifier's `trace_id_to_air_id`.
+    pub fn trace_order(&self) -> Vec<usize> {
+        let mut ids: Vec<usize> = (0..self.log_heights.len()).collect();
+        ids.sort_by_key(|&i| {
+            (
+                self.log_heights[i].is_none(),
+                self.log_heights[i].map(Reverse),
+                i,
+            )
+        });
+        ids.truncate(self.log_heights.iter().flatten().count());
+        ids
+    }
+}
+
+/// A tape under construction with its input values and its transcript.
+pub struct Gen {
+    pub tape: Tape,
+    pub tt: TapeTranscript,
+    pub inputs: Vec<Val>,
+    consts: HashMap<[u64; 4], Addr>,
+}
+
+impl Default for Gen {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Gen {
+    pub fn new() -> Self {
+        let mut tape = Tape::default();
+        let tt = TapeTranscript::new(&mut tape, U_TRANSCRIPT);
+        Self {
+            tape,
+            tt,
+            inputs: vec![],
+            consts: HashMap::new(),
+        }
+    }
+
+    // ---- values -------------------------------------------------------------------------
+    pub fn ef_in(&mut self, v: Ef4) -> Addr {
+        let a = self.tape.input(ValKind::Ef4);
+        self.inputs.push(Val::Bb(from_ef4(v)));
+        a
+    }
+    pub fn bb_in(&mut self, v: BabyBear) -> Addr {
+        let a = self.tape.input(ValKind::Bb);
+        self.inputs
+            .push(Val::Bb([v.as_canonical_u32() as u64, 0, 0, 0]));
+        a
+    }
+    pub fn fr_in(&mut self, v: Fr) -> Addr {
+        let a = self.tape.fr_input();
+        self.inputs.push(Val::Fr(v));
+        a
+    }
+    /// A constant of the key (one op per distinct value).
+    pub fn konst(&mut self, v: [u64; 4]) -> Addr {
+        if let Some(&a) = self.consts.get(&v) {
+            return a;
+        }
+        let kind = if v[1..] == [0; 3] {
+            ValKind::Bb
+        } else {
+            ValKind::Ef4
+        };
+        let a = self.tape.constant(kind, v);
+        self.consts.insert(v, a);
+        a
+    }
+    pub fn kbb(&mut self, v: u64) -> Addr {
+        self.konst([v % crate::bb::P, 0, 0, 0])
+    }
+    pub fn kef(&mut self, v: Ef4) -> Addr {
+        self.konst(from_ef4(v))
+    }
+    pub fn add(&mut self, a: Addr, b: Addr) -> Addr {
+        self.tape.add(a, b)
+    }
+    pub fn sub(&mut self, a: Addr, b: Addr) -> Addr {
+        self.tape.sub(a, b)
+    }
+    pub fn mul(&mut self, a: Addr, b: Addr) -> Addr {
+        self.tape.mul(a, b)
+    }
+    pub fn assert_eq(&mut self, a: Addr, b: Addr) {
+        self.tape.assert_eq(a, b)
+    }
+
+    // ---- transcript ---------------------------------------------------------------------
+    pub fn observe(&mut self, a: Addr) {
+        self.tt.observe(&mut self.tape, a)
+    }
+    pub fn observe_ext(&mut self, a: Addr) {
+        self.tt.observe_ext(&mut self.tape, a)
+    }
+    pub fn observe_commit(&mut self, a: Addr) {
+        self.tt.observe_commit(&mut self.tape, a)
+    }
+    pub fn sample(&mut self) -> Addr {
+        self.tt.sample(&mut self.tape)
+    }
+    pub fn sample_ext(&mut self) -> Addr {
+        self.tt.sample_ext(&mut self.tape)
+    }
+    pub fn sample_bits(&mut self, bits: u32) -> Addr {
+        let s = self.sample();
+        self.tape.low_bits(s, bits)
+    }
+    /// `FiatShamirTranscript::check_witness`: observe `w`, then `sample_bits(bits) == 0`.
+    pub fn check_witness(&mut self, bits: usize, w: Addr) {
+        if bits == 0 {
+            return;
+        }
+        self.observe(w);
+        let low = self.sample_bits(bits as u32);
+        let zero = self.kbb(0);
+        self.assert_eq(low, zero);
+    }
+
+    // ---- polynomial helpers (poly_common.rs) ------------------------------------------------
+    /// `interpolate_linear_at_01`.
+    pub fn lin01(&mut self, e0: Addr, e1: Addr, x: Addr) -> Addr {
+        let p = self.sub(e1, e0);
+        let px = self.mul(p, x);
+        self.add(px, e0)
+    }
+    /// `interpolate_cubic_at_0123`.
+    pub fn cubic0123(&mut self, e: [Addr; 4], x: Addr) -> Addr {
+        let inv6 = self.kbb(BabyBear::from_u64(6).inverse().as_canonical_u32() as u64);
+        let inv2 = self.kbb(BabyBear::TWO.inverse().as_canonical_u32() as u64);
+        let three = self.kbb(3);
+        let s1 = self.sub(e[1], e[0]);
+        let s2 = self.sub(e[2], e[0]);
+        let s3 = self.sub(e[3], e[0]);
+        let t = self.sub(s2, s1);
+        let t3 = self.mul(t, three);
+        let d3 = self.sub(s3, t3);
+        let p = self.mul(d3, inv6);
+        let u = self.sub(s2, d3);
+        let uh = self.mul(u, inv2);
+        let q = self.sub(uh, s1);
+        let sp = self.sub(s1, p);
+        let r = self.sub(sp, q);
+        let a = self.mul(p, x);
+        let a = self.add(a, q);
+        let a = self.mul(a, x);
+        let a = self.add(a, r);
+        let a = self.mul(a, x);
+        self.add(a, e[0])
+    }
+    /// `xi r + (1 - xi)(1 - r)`.
+    pub fn eq1(&mut self, xi: Addr, r: Addr) -> Addr {
+        let one = self.kbb(1);
+        let a = self.mul(xi, r);
+        let omx = self.sub(one, xi);
+        let omr = self.sub(one, r);
+        let b = self.mul(omx, omr);
+        self.add(a, b)
+    }
+}
+
+/// The tape values of part 1 that the later stages read.
+#[derive(Clone, Debug)]
+pub struct Part1 {
+    pub alpha: Addr,
+    pub beta: Addr,
+    /// `xi` of length `l_skip + n_global`.
+    pub xi: Vec<Addr>,
+    pub lambda: Addr,
+    /// Per present trace (trace order): the numerator and denominator terms.
+    pub num_terms: Vec<Addr>,
+    pub den_terms: Vec<Addr>,
+    pub n_logup: usize,
+    pub n_global: usize,
+    /// The commitments as WHIR reads them: common main, then per present trace (trace order)
+    /// its preprocessed (none in `L`) and cached commitments.
+    pub commits: Vec<Addr>,
+}
+
+/// Errors of the generator: the proof does not have the pinned shape.
+#[derive(Debug, PartialEq, Eq)]
+pub enum ShapeError {
+    Heights,
+    Lengths(&'static str),
+}
+
+/// Part 1 of the `L` verifier on the tape: preamble, LogUp PoW, alpha, beta, GKR, the rest of
+/// `xi`, lambda, and the per-AIR LogUp terms with the GKR claim checks. Ops depend only on `vk`
+/// and `shape`; `proof` gives the input values.
+pub fn gen_part1(
+    g: &mut Gen,
+    vk: &MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &Proof<LSC>,
+) -> Result<Part1, ShapeError> {
+    if LShape::of(proof) != *shape {
+        return Err(ShapeError::Heights);
+    }
+    let mvk = &vk.inner;
+    let params = &mvk.params;
+    let l_skip = params.l_skip;
+    let order = shape.trace_order();
+
+    // Trace height constraints (the pinned shape; no ops).
+    for c in &mvk.trace_height_constraints {
+        let sum: u64 = order
+            .iter()
+            .map(|&i| {
+                (1u64 << shape.log_heights[i].unwrap().max(l_skip)) * c.coefficients[i] as u64
+            })
+            .sum();
+        assert!(
+            sum < c.threshold as u64,
+            "pinned shape breaks a height constraint"
+        );
+    }
+
+    // Preamble (verifier/mod.rs).
+    let pre_hash = g.tape.fr_const(vk.pre_hash[0]);
+    g.observe_commit(pre_hash);
+    let cm = g.fr_in(proof.common_main_commit[0]);
+    g.observe_commit(cm);
+    let mut cached_per_air: Vec<Vec<Addr>> = vec![vec![]; mvk.per_air.len()];
+    for (i, avk) in mvk.per_air.iter().enumerate() {
+        let lh = shape.log_heights[i];
+        if !avk.is_required {
+            let b = g.kbb(lh.is_some() as u64);
+            g.observe(b);
+        }
+        if let Some(lh) = lh {
+            assert!(
+                avk.preprocessed_data.is_none(),
+                "L has no preprocessed trace (L-STRUCTURE.md)"
+            );
+            let h = g.kbb(lh as u64);
+            g.observe(h);
+            let tv = proof.trace_vdata[i].as_ref().unwrap();
+            if tv.cached_commitments.len() != avk.params.width.cached_mains.len() {
+                return Err(ShapeError::Lengths("cached commitments"));
+            }
+            for c in &tv.cached_commitments {
+                let a = g.fr_in(c[0]);
+                g.observe_commit(a);
+                cached_per_air[i].push(a);
+            }
+        }
+        if proof.public_values[i].len() != avk.params.num_public_values {
+            return Err(ShapeError::Lengths("public values"));
+        }
+        for pv in &proof.public_values[i] {
+            let a = g.bb_in(*pv);
+            g.observe(a);
+        }
+    }
+
+    // batch_constraints.rs step 1: LogUp PoW.
+    let w = g.bb_in(proof.gkr_proof.logup_pow_witness);
+    g.check_witness(params.logup.pow_bits, w);
+    // Step 2: alpha, beta, GKR.
+    let alpha = g.sample_ext();
+    let beta = g.sample_ext();
+    let n_per_trace: Vec<isize> = order
+        .iter()
+        .map(|&i| shape.log_heights[i].unwrap() as isize - l_skip as isize)
+        .collect();
+    let total_interactions: u64 = order
+        .iter()
+        .zip(&n_per_trace)
+        .map(|(&i, &n)| {
+            (mvk.per_air[i].symbolic_constraints.interactions.len() as u64)
+                << (l_skip + n.max(0) as usize)
+        })
+        .sum();
+    assert!(total_interactions > 0, "L has interactions");
+    let n_logup = calculate_n_logup(l_skip, total_interactions);
+    let (p_xi, q_xi, mut xi) = gen_gkr(g, proof, l_skip + n_logup)?;
+    let n_max = n_per_trace.iter().copied().max().unwrap().max(0) as usize;
+    let n_global = n_max.max(n_logup);
+    while xi.len() != l_skip + n_global {
+        xi.push(g.sample_ext());
+    }
+    let lambda = g.sample_ext();
+
+    // Step 3: per-AIR terms and the GKR claim checks.
+    let bp = &proof.batch_constraint_proof;
+    if bp.numerator_term_per_air.len() != order.len()
+        || bp.denominator_term_per_air.len() != order.len()
+    {
+        return Err(ShapeError::Lengths("LogUp terms"));
+    }
+    let (mut p_claim, mut q_claim) = (p_xi, q_xi);
+    let (mut num_terms, mut den_terms) = (vec![], vec![]);
+    for (&sp, &sq) in bp
+        .numerator_term_per_air
+        .iter()
+        .zip(&bp.denominator_term_per_air)
+    {
+        let (ap, aq) = (g.ef_in(sp), g.ef_in(sq));
+        p_claim = g.sub(p_claim, ap);
+        q_claim = g.sub(q_claim, aq);
+        g.observe_ext(ap);
+        g.observe_ext(aq);
+        num_terms.push(ap);
+        den_terms.push(aq);
+    }
+    let zero = g.kbb(0);
+    g.assert_eq(p_claim, zero);
+    g.assert_eq(q_claim, alpha);
+    Ok(Part1 {
+        alpha,
+        beta,
+        xi,
+        lambda,
+        num_terms,
+        den_terms,
+        n_logup,
+        n_global,
+        commits: std::iter::once(cm)
+            .chain(order.iter().flat_map(|&i| cached_per_air[i].clone()))
+            .collect(),
+    })
+}
+
+/// `verify_gkr` (fractional_sumcheck_gkr.rs). Returns `(p(xi), q(xi), xi)`.
+fn gen_gkr(
+    g: &mut Gen,
+    proof: &Proof<LSC>,
+    total_rounds: usize,
+) -> Result<(Addr, Addr, Vec<Addr>), ShapeError> {
+    let gp = &proof.gkr_proof;
+    if gp.claims_per_layer.len() != total_rounds {
+        return Err(ShapeError::Lengths("GKR layers"));
+    }
+    if gp.sumcheck_polys.len() != total_rounds - 1 {
+        return Err(ShapeError::Lengths("GKR sumcheck polys"));
+    }
+    let q0 = g.ef_in(gp.q0_claim);
+    g.observe_ext(q0);
+    let zero = g.kbb(0);
+    let layer = |g: &mut Gen, j: usize| -> [Addr; 4] {
+        let c = &gp.claims_per_layer[j];
+        let v = [c.p_xi_0, c.q_xi_0, c.p_xi_1, c.q_xi_1].map(|x| g.ef_in(x));
+        for a in v {
+            g.observe_ext(a);
+        }
+        v
+    };
+    let cross = |g: &mut Gen, [p0, q0, p1, q1]: [Addr; 4]| -> (Addr, Addr) {
+        let a = g.mul(p0, q1);
+        let b = g.mul(p1, q0);
+        let pc = g.add(a, b);
+        let qc = g.mul(q0, q1);
+        (pc, qc)
+    };
+    let reduce = |g: &mut Gen, [p0, q0, p1, q1]: [Addr; 4], mu: Addr| -> (Addr, Addr) {
+        (g.lin01(p0, p1, mu), g.lin01(q0, q1, mu))
+    };
+
+    let c0 = layer(g, 0);
+    let (pc, qc) = cross(g, c0);
+    g.assert_eq(pc, zero);
+    g.assert_eq(qc, q0);
+    let mu = g.sample_ext();
+    let (mut numer, mut denom) = reduce(g, c0, mu);
+    let mut gkr_r = vec![mu];
+
+    for round in 1..total_rounds {
+        let lambda = g.sample_ext();
+        let ld = g.mul(lambda, denom);
+        let mut claim = g.add(numer, ld);
+        let polys = &gp.sumcheck_polys[round - 1];
+        if polys.len() != round {
+            return Err(ShapeError::Lengths("GKR sub-rounds"));
+        }
+        let mut round_r = vec![];
+        let mut eq = g.kbb(1);
+        for (sr, evals) in polys.iter().enumerate() {
+            let e = evals.map(|x| g.ef_in(x));
+            for a in e {
+                g.observe_ext(a);
+            }
+            let ri = g.sample_ext();
+            round_r.push(ri);
+            let ev0 = g.sub(claim, e[0]);
+            claim = g.cubic0123([ev0, e[0], e[1], e[2]], ri);
+            let f = g.eq1(gkr_r[sr], ri);
+            eq = g.mul(eq, f);
+        }
+        let c = layer(g, round);
+        let (pc, qc) = cross(g, c);
+        let lq = g.mul(lambda, qc);
+        let s = g.add(pc, lq);
+        let expected = g.mul(s, eq);
+        g.assert_eq(expected, claim);
+        let mu = g.sample_ext();
+        (numer, denom) = reduce(g, c, mu);
+        gkr_r = std::iter::once(mu).chain(round_r).collect();
+    }
+    Ok((numer, denom, gkr_r))
+}
+
+/// `true` iff `x` is the `Ef4` value of a BabyBear `v` (test helper).
+pub fn is_bb(x: [u64; 4], v: BabyBear) -> bool {
+    x == [v.as_canonical_u32() as u64, 0, 0, 0]
+}
+
+// ==========================================================================================
+// I7: part 2, zerocheck and constraint batching (batch_constraints.rs steps 4 to 9).
+// ==========================================================================================
+
+/// The tape values of part 2 that the later stages read.
+#[derive(Clone, Debug)]
+pub struct Part2 {
+    /// `r_0, r_1, .., r_{n_max}`.
+    pub rs: Vec<Addr>,
+    /// Per present trace (trace order), per part (common main first, then preprocessed and
+    /// cached, as in the proof), the openings `(claim, claim_rot)`; `claim_rot` is the constant
+    /// 0 when the AIR does not need rotation.
+    pub openings: Vec<Vec<Vec<(Addr, Addr)>>>,
+    pub n_max: usize,
+}
+
+impl Gen {
+    pub fn neg(&mut self, a: Addr) -> Addr {
+        let z = self.kbb(0);
+        self.sub(z, a)
+    }
+    /// `x^(2^k)` for `k = 0..n` (`exp_powers_of_2`).
+    pub fn pow2s(&mut self, x: Addr, n: usize) -> Vec<Addr> {
+        let mut v = vec![x];
+        while v.len() < n {
+            let l = *v.last().unwrap();
+            v.push(self.mul(l, l));
+        }
+        v.truncate(n);
+        v
+    }
+    /// `x^e` by squaring (e > 0).
+    pub fn pow(&mut self, x: Addr, e: u64) -> Addr {
+        assert!(e > 0);
+        let mut acc: Option<Addr> = None;
+        let mut base = x;
+        let mut e = e;
+        while e > 0 {
+            if e & 1 == 1 {
+                acc = Some(match acc {
+                    None => base,
+                    Some(a) => self.mul(a, base),
+                });
+            }
+            e >>= 1;
+            if e > 0 {
+                base = self.mul(base, base);
+            }
+        }
+        acc.unwrap()
+    }
+    /// `eval_eq_uni(l_skip, x, y)`.
+    pub fn eq_uni(&mut self, l_skip: usize, x: Addr, y: Addr) -> Addr {
+        let one = self.kbb(1);
+        let xs = self.pow2s(x, l_skip);
+        let ys = self.pow2s(y, l_skip);
+        let mut res = one;
+        for (xp, yp) in xs.into_iter().zip(ys) {
+            let s = self.add(xp, yp);
+            let a = self.mul(s, res);
+            let xm = self.sub(xp, one);
+            let ym = self.sub(yp, one);
+            let b = self.mul(xm, ym);
+            res = self.add(a, b);
+        }
+        let h = BabyBear::ONE.halve().exp_u64(l_skip as u64);
+        let k = self.kbb(h.as_canonical_u32() as u64);
+        self.mul(res, k)
+    }
+    /// `progression_exp_2(m, l)` = `1 + m + .. + m^(2^l - 1)`.
+    fn progression_exp_2(&mut self, m: Addr, l: usize) -> Addr {
+        let one = self.kbb(1);
+        let (mut pow, mut sum) = (m, one);
+        for _ in 0..l {
+            let t = self.add(one, pow);
+            sum = self.mul(sum, t);
+            pow = self.mul(pow, pow);
+        }
+        sum
+    }
+    /// `horner_eval` of coefficient addresses at `x`.
+    pub fn horner(&mut self, coeffs: &[Addr], x: Addr) -> Addr {
+        let mut acc = self.kbb(0);
+        for &c in coeffs.iter().rev() {
+            let m = self.mul(acc, x);
+            acc = self.add(m, c);
+        }
+        acc
+    }
+}
+
+fn bb_u64(x: BabyBear) -> u64 {
+    x.as_canonical_u32() as u64
+}
+
+/// Part 2 of the `L` verifier on the tape (`batch_constraints.rs` steps 4 to 9).
+pub fn gen_part2(
+    g: &mut Gen,
+    vk: &MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &Proof<LSC>,
+    p1: &Part1,
+) -> Result<Part2, ShapeError> {
+    use openvm_stark_backend::air_builders::symbolic::{
+        symbolic_variable::Entry, SymbolicExpressionNode as N,
+    };
+    use p3_field::TwoAdicField;
+
+    let mvk = &vk.inner;
+    let l_skip = mvk.params.l_skip;
+    let order = shape.trace_order();
+    let n_per_trace: Vec<isize> = order
+        .iter()
+        .map(|&i| shape.log_heights[i].unwrap() as isize - l_skip as isize)
+        .collect();
+    let bp = &proof.batch_constraint_proof;
+    let (xi, lambda) = (&p1.xi, p1.lambda);
+
+    // 4. mu and the batched sum claim.
+    let mu = g.sample_ext();
+    let mut sum_claim = g.kbb(0);
+    let mut cur_mu_pow = g.kbb(1);
+    for (&sp, &sq) in p1.num_terms.iter().zip(&p1.den_terms) {
+        let a = g.mul(sp, cur_mu_pow);
+        sum_claim = g.add(sum_claim, a);
+        cur_mu_pow = g.mul(cur_mu_pow, mu);
+        let b = g.mul(sq, cur_mu_pow);
+        sum_claim = g.add(sum_claim, b);
+        cur_mu_pow = g.mul(cur_mu_pow, mu);
+    }
+
+    // 5. Univariate round.
+    let d = mvk.params.max_constraint_degree;
+    if bp.univariate_round_coeffs.len() != (d + 1) * ((1 << l_skip) - 1) + 1 {
+        return Err(ShapeError::Lengths("univariate round"));
+    }
+    let coeffs: Vec<Addr> = bp
+        .univariate_round_coeffs
+        .iter()
+        .map(|&c| g.ef_in(c))
+        .collect();
+    for &c in &coeffs {
+        g.observe_ext(c);
+    }
+    let s_deg = d + 1;
+    let r0 = g.sample_ext();
+    let mut acc = g.kbb(0);
+    for &c in coeffs.iter().step_by(1 << l_skip) {
+        acc = g.add(acc, c);
+    }
+    let n_skip = g.kbb(1 << l_skip);
+    let sum_univ = g.mul(acc, n_skip);
+    g.assert_eq(sum_claim, sum_univ);
+    let mut cur_sum = g.horner(&coeffs, r0);
+    let mut rs = vec![r0];
+
+    // 6. Multilinear rounds.
+    let n_max = n_per_trace.iter().copied().max().unwrap().max(0) as usize;
+    if bp.sumcheck_round_polys.len() != n_max {
+        return Err(ShapeError::Lengths("sumcheck rounds"));
+    }
+    let mut fact = vec![BabyBear::ONE; s_deg + 1];
+    for i in 1..=s_deg {
+        fact[i] = fact[i - 1] * BabyBear::from_usize(i);
+    }
+    for round in 0..n_max {
+        let ev = &bp.sumcheck_round_polys[round];
+        if ev.len() != s_deg {
+            return Err(ShapeError::Lengths("sumcheck round evals"));
+        }
+        let e: Vec<Addr> = ev.iter().map(|&x| g.ef_in(x)).collect();
+        for &a in &e {
+            g.observe_ext(a);
+        }
+        let s0 = g.sub(cur_sum, e[0]);
+        let evals: Vec<Addr> = std::iter::once(s0).chain(e).collect();
+        let r = g.sample_ext();
+        let one = g.kbb(1);
+        let mut pref = vec![one; s_deg + 1];
+        let mut suf = vec![one; s_deg + 1];
+        for i in 0..s_deg {
+            let ki = g.kbb(i as u64);
+            let t = g.sub(r, ki);
+            pref[i + 1] = g.mul(pref[i], t);
+            let kj = g.kbb((s_deg - i) as u64);
+            let u = g.sub(kj, r);
+            suf[i + 1] = g.mul(suf[i], u);
+        }
+        let mut sum = g.kbb(0);
+        for i in 0..=s_deg {
+            let w = bb_u64((fact[i] * fact[s_deg - i]).inverse());
+            let kw = g.kbb(w);
+            let a = g.mul(evals[i], pref[i]);
+            let a = g.mul(a, suf[s_deg - i]);
+            let a = g.mul(a, kw);
+            sum = g.add(sum, a);
+        }
+        cur_sum = sum;
+        rs.push(r);
+    }
+
+    // 7. eq_3b per trace.
+    let n_logup = p1.n_logup;
+    let one = g.kbb(1);
+    let one_minus_xi: Vec<Addr> = xi.iter().map(|&x| g.sub(one, x)).collect();
+    let mut stacked_idx = 0usize;
+    let mut eq_3b_per_trace = vec![];
+    for (t, &n) in n_per_trace.iter().enumerate() {
+        let ni = mvk.per_air[order[t]]
+            .symbolic_constraints
+            .interactions
+            .len();
+        let n_lift = n.max(0) as usize;
+        let mut v = vec![];
+        for _ in 0..ni {
+            let mut b_int = stacked_idx >> (l_skip + n_lift);
+            let mut e = one;
+            for j in l_skip + n_lift..l_skip + n_logup {
+                let f = if b_int & 1 == 1 {
+                    xi[j]
+                } else {
+                    one_minus_xi[j]
+                };
+                e = g.mul(e, f);
+                b_int >>= 1;
+            }
+            stacked_idx += 1 << (l_skip + n_lift);
+            v.push(e);
+        }
+        eq_3b_per_trace.push(v);
+    }
+
+    // 8. eq_ns and eq_sharp_ns.
+    let mut eq_ns = vec![one; n_max + 1];
+    let mut eq_sharp_ns = vec![one; n_max + 1];
+    eq_ns[0] = g.eq_uni(l_skip, xi[0], r0);
+    {
+        // eval_eq_sharp_uni(omega_skip_pows, xi[..l_skip], r0)
+        let mut evals = vec![one];
+        for &x in &xi[..l_skip] {
+            let omx = g.sub(one, x);
+            let mut next = vec![0; evals.len() * 2];
+            for (k, &lo) in evals.iter().enumerate() {
+                next[k] = g.mul(lo, omx);
+                next[k + evals.len()] = g.mul(lo, x);
+            }
+            evals = next;
+        }
+        let omega = BabyBear::two_adic_generator(l_skip);
+        let mut res = g.kbb(0);
+        for (k, &e) in evals.iter().enumerate() {
+            let w = g.kbb(bb_u64(omega.exp_u64(k as u64)));
+            let q = g.eq_uni(l_skip, r0, w);
+            let a = g.mul(q, e);
+            res = g.add(res, a);
+        }
+        eq_sharp_ns[0] = res;
+    }
+    for i in 1..=n_max {
+        let f = g.eq1(xi[l_skip + i - 1], rs[i]);
+        eq_ns[i] = g.mul(eq_ns[i - 1], f);
+        eq_sharp_ns[i] = g.mul(eq_sharp_ns[i - 1], f);
+    }
+    let mut r_rev_prod = rs[n_max];
+    for i in (0..n_max).rev() {
+        eq_ns[i] = g.mul(eq_ns[i], r_rev_prod);
+        eq_sharp_ns[i] = g.mul(eq_sharp_ns[i], r_rev_prod);
+        r_rev_prod = g.mul(r_rev_prod, rs[i]);
+    }
+
+    // 9. Openings, constraint and interaction evaluations.
+    if bp.column_openings.len() != order.len() {
+        return Err(ShapeError::Lengths("column openings"));
+    }
+    let zero = g.kbb(0);
+    let mut openings: Vec<Vec<Vec<(Addr, Addr)>>> = vec![];
+    for (t, air_open) in bp.column_openings.iter().enumerate() {
+        let avk = &mvk.per_air[order[t]];
+        let need_rot = avk.params.need_rot;
+        let w = &avk.params.width;
+        let mut widths = vec![w.common_main];
+        if avk.preprocessed_data.is_some() {
+            widths.push(w.preprocessed.unwrap_or(0));
+        }
+        widths.extend(w.cached_mains.iter().copied());
+        if air_open.len() != widths.len() {
+            return Err(ShapeError::Lengths("opening parts"));
+        }
+        let mut parts = vec![];
+        for (claims, &wd) in air_open.iter().zip(&widths) {
+            if claims.len() != wd * if need_rot { 2 } else { 1 } {
+                return Err(ShapeError::Lengths("openings per part"));
+            }
+            let v: Vec<(Addr, Addr)> = if need_rot {
+                claims
+                    .chunks_exact(2)
+                    .map(|c| (g.ef_in(c[0]), g.ef_in(c[1])))
+                    .collect()
+            } else {
+                claims.iter().map(|&c| (g.ef_in(c), zero)).collect()
+            };
+            parts.push(v);
+        }
+        openings.push(parts);
+    }
+    // Common main openings first, then preprocessed and cached, per trace.
+    for parts in &openings {
+        for &(c, cr) in &parts[0] {
+            g.observe_ext(c);
+            g.observe_ext(cr);
+        }
+    }
+    let mut interactions_evals = vec![];
+    let mut constraints_evals = vec![];
+    for (t, parts) in openings.iter().enumerate() {
+        for part in &parts[1..] {
+            for &(c, cr) in part {
+                g.observe_ext(c);
+                g.observe_ext(cr);
+            }
+        }
+        let air = order[t];
+        let avk = &mvk.per_air[air];
+        let n = n_per_trace[t];
+        let n_lift = n.max(0) as usize;
+        let has_pre = avk.preprocessed_data.is_some();
+        let preprocessed = has_pre.then(|| parts[1].clone());
+        let cached_idx = 1 + has_pre as usize;
+        let mut part_main: Vec<Vec<(Addr, Addr)>> = parts[cached_idx..].to_vec();
+        part_main.push(parts[0].clone());
+
+        // Selectors (evaluator.rs) at the lifted point.
+        let (l, rs_n, norm) = if n < 0 {
+            let r = g.pow(rs[0], 1u64 << (-n) as u32);
+            (
+                l_skip.wrapping_add_signed(n),
+                vec![r],
+                Some(bb_u64(
+                    BabyBear::from_usize(1 << n.unsigned_abs()).inverse(),
+                )),
+            )
+        } else {
+            (l_skip, rs[..=(n as usize)].to_vec(), None)
+        };
+        let omega = BabyBear::two_adic_generator(l);
+        let inv = g.kbb(bb_u64(BabyBear::from_usize(1 << l).inverse()));
+        let mut prod1 = one;
+        let mut prod2 = one;
+        for &x in &rs_n[1..] {
+            let omx = g.sub(one, x);
+            prod1 = g.mul(prod1, omx);
+            prod2 = g.mul(prod2, x);
+        }
+        let pe = g.progression_exp_2(rs_n[0], l);
+        let a = g.mul(inv, pe);
+        let is_first = g.mul(a, prod1);
+        let kom = g.kbb(bb_u64(omega));
+        let r_om = g.mul(rs_n[0], kom);
+        let pe2 = g.progression_exp_2(r_om, l);
+        let a = g.mul(inv, pe2);
+        let is_last = g.mul(a, prod2);
+        let is_trans = g.sub(one, is_last);
+
+        // The DAG (eval_nodes).
+        let dag = &avk.symbolic_constraints.constraints;
+        let mut nodes: Vec<Addr> = Vec::with_capacity(dag.nodes.len());
+        for node in &dag.nodes {
+            let v = match node {
+                N::Variable(var) => {
+                    let pick = |p: &(Addr, Addr), off: usize| if off == 0 { p.0 } else { p.1 };
+                    match var.entry {
+                        Entry::Preprocessed { offset } => pick(
+                            &preprocessed.as_ref().expect("preprocessed")[var.index],
+                            offset,
+                        ),
+                        Entry::Main { part_index, offset } => {
+                            pick(&part_main[part_index][var.index], offset)
+                        }
+                        Entry::Public => {
+                            // Public values are tape inputs of part 1 (L has none).
+                            unimplemented!("public values of L")
+                        }
+                        Entry::Challenge => unimplemented!("challenge variable"),
+                    }
+                }
+                N::IsFirstRow => is_first,
+                N::IsLastRow => is_last,
+                N::IsTransition => is_trans,
+                N::Constant(c) => g.kbb(bb_u64(*c)),
+                N::Add {
+                    left_idx,
+                    right_idx,
+                    ..
+                } => g.add(nodes[*left_idx], nodes[*right_idx]),
+                N::Sub {
+                    left_idx,
+                    right_idx,
+                    ..
+                } => g.sub(nodes[*left_idx], nodes[*right_idx]),
+                N::Neg { idx, .. } => g.neg(nodes[*idx]),
+                N::Mul {
+                    left_idx,
+                    right_idx,
+                    ..
+                } => g.mul(nodes[*left_idx], nodes[*right_idx]),
+            };
+            nodes.push(v);
+        }
+        let mut expr = g.kbb(0);
+        let mut lp = one;
+        for &idx in &dag.constraint_idx {
+            let a = g.mul(nodes[idx], lp);
+            expr = g.add(expr, a);
+            lp = g.mul(lp, lambda);
+        }
+        let ce = g.mul(eq_ns[n_lift], expr);
+        constraints_evals.push(ce);
+
+        let mut num = g.kbb(0);
+        let mut den = g.kbb(0);
+        let ints = &avk.symbolic_constraints.interactions;
+        assert_eq!(ints.len(), eq_3b_per_trace[t].len());
+        for (it, &e3) in ints.iter().zip(&eq_3b_per_trace[t]) {
+            let nv = nodes[it.count];
+            let mut acc = g.kbb(0);
+            let mut bp_pow = one;
+            let bus = g.kbb(it.bus_index as u64 + 1);
+            for x in it
+                .message
+                .iter()
+                .map(|&i| nodes[i])
+                .chain(std::iter::once(bus))
+            {
+                let a = g.mul(x, bp_pow);
+                acc = g.add(acc, a);
+                bp_pow = g.mul(bp_pow, p1.beta);
+            }
+            let a = g.mul(e3, nv);
+            num = g.add(num, a);
+            let b = g.mul(e3, acc);
+            den = g.add(den, b);
+        }
+        let num = match norm {
+            Some(k) => {
+                let kk = g.kbb(k);
+                g.mul(num, kk)
+            }
+            None => num,
+        };
+        let a = g.mul(num, eq_sharp_ns[n_lift]);
+        interactions_evals.push(a);
+        let b = g.mul(den, eq_sharp_ns[n_lift]);
+        interactions_evals.push(b);
+    }
+    let mut evaluated = g.kbb(0);
+    let mut mp = one;
+    for &x in interactions_evals.iter().chain(&constraints_evals) {
+        let a = g.mul(x, mp);
+        evaluated = g.add(evaluated, a);
+        mp = g.mul(mp, mu);
+    }
+    g.assert_eq(cur_sum, evaluated);
+    Ok(Part2 {
+        rs,
+        openings,
+        n_max,
+    })
+}
+
+// ==========================================================================================
+// I8: part 3, the stacked reduction (stacked_reduction.rs).
+// ==========================================================================================
+
+/// The tape values of part 3 that WHIR reads.
+#[derive(Clone, Debug)]
+pub struct Part3 {
+    /// `u_0, .., u_{n_stack}`.
+    pub u: Vec<Addr>,
+    /// Per commitment, per stacked column: the opening `q_j(u)` (a proof value).
+    pub stacking_openings: Vec<Vec<Addr>>,
+    /// The commitments, in the verifier's order (common main, then per trace preprocessed and
+    /// cached).
+    pub commits: Vec<Addr>,
+}
+
+impl Gen {
+    /// `eval_eq_uni_at_one(l, x)`.
+    pub fn eq_uni_at_one(&mut self, l: usize, x: Addr) -> Addr {
+        let one = self.kbb(1);
+        let mut res = one;
+        for xp in self.pow2s(x, l) {
+            let t = self.add(xp, one);
+            res = self.mul(res, t);
+        }
+        let h = BabyBear::ONE.halve().exp_u64(l as u64);
+        let k = self.kbb(bb_u64(h));
+        self.mul(res, k)
+    }
+    /// `eval_eq_mle(x, y)` for addresses.
+    pub fn eq_mle(&mut self, x: &[Addr], y: &[Addr]) -> Addr {
+        let mut acc = self.kbb(1);
+        for (&a, &b) in x.iter().zip(y) {
+            let f = self.eq1(a, b);
+            acc = self.mul(acc, f);
+        }
+        acc
+    }
+    /// `eval_eq_prism(l, x, y)`.
+    pub fn eq_prism(&mut self, l: usize, x: &[Addr], y: &[Addr]) -> Addr {
+        let a = self.eq_uni(l, x[0], y[0]);
+        let b = self.eq_mle(&x[1..], &y[1..]);
+        self.mul(a, b)
+    }
+    /// `eval_eq_rot_cube(x, y)` -> `(eq, rot)`.
+    pub fn eq_rot_cube(&mut self, x: &[Addr], y: &[Addr]) -> (Addr, Addr) {
+        let one = self.kbb(1);
+        let (mut rot, mut eq) = (one, one);
+        for i in (0..x.len()).rev() {
+            let omy = self.sub(one, y[i]);
+            let omx = self.sub(one, x[i]);
+            let a = self.mul(x[i], omy);
+            let a = self.mul(a, eq);
+            let b = self.mul(omx, y[i]);
+            let b = self.mul(b, rot);
+            rot = self.add(a, b);
+            let f = self.eq1(x[i], y[i]);
+            eq = self.mul(eq, f);
+        }
+        (eq, rot)
+    }
+    /// `eval_rot_kernel_prism(l, x, y)`.
+    pub fn rot_kernel_prism(&mut self, l: usize, x: &[Addr], y: &[Addr]) -> Addr {
+        use p3_field::TwoAdicField;
+        let omega = self.kbb(bb_u64(BabyBear::two_adic_generator(l)));
+        let (eq_cube, rot_cube) = self.eq_rot_cube(&x[1..], &y[1..]);
+        let y0w = self.mul(y[0], omega);
+        let a = self.eq_uni(l, x[0], y0w);
+        let a = self.mul(a, eq_cube);
+        let b = self.eq_uni_at_one(l, x[0]);
+        let c = self.eq_uni_at_one(l, y0w);
+        let d = self.sub(rot_cube, eq_cube);
+        let b = self.mul(b, c);
+        let b = self.mul(b, d);
+        self.add(a, b)
+    }
+    /// `interpolate_quadratic_at_012`.
+    pub fn quad012(&mut self, e: [Addr; 3], x: Addr) -> Addr {
+        let inv2 = self.kbb(bb_u64(BabyBear::TWO.inverse()));
+        let s1 = self.sub(e[1], e[0]);
+        let s2 = self.sub(e[2], e[1]);
+        let t = self.sub(s2, s1);
+        let p = self.mul(t, inv2);
+        let q = self.sub(s1, p);
+        let a = self.mul(p, x);
+        let a = self.add(a, q);
+        let a = self.mul(a, x);
+        self.add(a, e[0])
+    }
+}
+
+/// Part 3 of the `L` verifier on the tape: the stacked reduction. `commits` are the tape
+/// addresses of the commitments observed in part 1 (common main first).
+pub fn gen_part3(
+    g: &mut Gen,
+    vk: &MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &Proof<LSC>,
+    p1: &Part1,
+    p2: &Part2,
+) -> Result<Part3, ShapeError> {
+    let commits = p1.commits.clone();
+    use openvm_stark_backend::verifier::proof_shape::verify_proof_shape;
+
+    let mvk = &vk.inner;
+    let l_skip = mvk.params.l_skip;
+    let n_stack = mvk.params.n_stack;
+    let order = shape.trace_order();
+    // The layouts depend only on the shape and the vk (the proof shape check also checks the
+    // proof's lengths).
+    let layouts = verify_proof_shape::<LSC>(mvk, proof).map_err(|_| ShapeError::Heights)?;
+    let mut need_rot_per_commit: Vec<Vec<bool>> = vec![order
+        .iter()
+        .map(|&i| mvk.per_air[i].params.need_rot)
+        .collect()];
+    for &i in &order {
+        let nr = mvk.per_air[i].params.need_rot;
+        if mvk.per_air[i].preprocessed_data.is_some() {
+            need_rot_per_commit.push(vec![nr]);
+        }
+        for _ in 0..mvk.per_air[i].params.width.cached_mains.len() {
+            need_rot_per_commit.push(vec![nr]);
+        }
+    }
+    assert_eq!(layouts.len(), need_rot_per_commit.len());
+    assert_eq!(layouts.len(), commits.len());
+
+    let mut lambda_idx = 0usize;
+    let lambda_indices_per_layout: Vec<Vec<(usize, bool)>> = layouts
+        .iter()
+        .enumerate()
+        .map(|(ci, layout)| {
+            layout
+                .sorted_cols
+                .iter()
+                .map(|&(mat_idx, _, _)| {
+                    lambda_idx += 1;
+                    (lambda_idx - 1, need_rot_per_commit[ci][mat_idx])
+                })
+                .collect()
+        })
+        .collect();
+    let t_len = lambda_idx;
+
+    // t_claims: common main of every trace, then the other parts per trace. The rotation
+    // claim of an AIR without rotation is the constant 0, as in part 2.
+    let mut t_claims: Vec<(Addr, Addr)> = vec![];
+    for parts in &p2.openings {
+        t_claims.extend(parts[0].iter().copied());
+    }
+    for parts in &p2.openings {
+        for part in &parts[1..] {
+            t_claims.extend(part.iter().copied());
+        }
+    }
+    assert_eq!(t_claims.len(), t_len);
+
+    let lambda = g.sample_ext();
+    let l2 = g.mul(lambda, lambda);
+    let one = g.kbb(1);
+    let mut lambda_sqr_powers = vec![one];
+    while lambda_sqr_powers.len() < t_len {
+        let l = *lambda_sqr_powers.last().unwrap();
+        lambda_sqr_powers.push(g.mul(l, l2));
+    }
+
+    // Univariate round.
+    let sp = &proof.stacking_proof;
+    if sp.univariate_round_coeffs.len() != 2 * ((1 << l_skip) - 1) + 1 {
+        return Err(ShapeError::Lengths("stacking univariate round"));
+    }
+    if sp.sumcheck_round_polys.len() != n_stack {
+        return Err(ShapeError::Lengths("stacking sumcheck rounds"));
+    }
+    let mut s0 = g.kbb(0);
+    for (&(t0, t1), &lp) in t_claims.iter().zip(&lambda_sqr_powers) {
+        let a = g.mul(t1, lambda);
+        let a = g.add(t0, a);
+        let a = g.mul(a, lp);
+        s0 = g.add(s0, a);
+    }
+    let coeffs: Vec<Addr> = sp
+        .univariate_round_coeffs
+        .iter()
+        .map(|&c| g.ef_in(c))
+        .collect();
+    let mut acc = g.kbb(0);
+    for &c in coeffs.iter().step_by(1 << l_skip) {
+        acc = g.add(acc, c);
+    }
+    let k = g.kbb(1 << l_skip);
+    let s0_sum = g.mul(acc, k);
+    g.assert_eq(s0, s0_sum);
+    for &c in &coeffs {
+        g.observe_ext(c);
+    }
+    let mut u = vec![g.sample_ext()];
+    let mut claim = g.horner(&coeffs, u[0]);
+
+    // Rounds 1 to n_stack.
+    for j in 1..=n_stack {
+        let [e1, e2] = sp.sumcheck_round_polys[j - 1].map(|x| g.ef_in(x));
+        g.observe_ext(e1);
+        g.observe_ext(e2);
+        let uj = g.sample_ext();
+        u.push(uj);
+        let e0 = g.sub(claim, e1);
+        claim = g.quad012([e0, e1, e2], uj);
+    }
+
+    // Final check.
+    if sp.stacking_openings.len() != layouts.len() {
+        return Err(ShapeError::Lengths("stacking openings"));
+    }
+    let r = &p2.rs;
+    let zero = g.kbb(0);
+    let mut q_coeffs: Vec<Vec<Addr>> = sp
+        .stacking_openings
+        .iter()
+        .map(|v| vec![zero; v.len()])
+        .collect();
+    // Shared values per (n, need_rot): eq_prism, rot kernel and ind depend only on n.
+    let mut cache: HashMap<(isize, bool), Addr> = HashMap::new();
+    for (ci, layout) in layouts.iter().enumerate() {
+        for (col, &(_, _, s)) in layout.sorted_cols.iter().enumerate() {
+            let (li, need_rot) = lambda_indices_per_layout[ci][col];
+            let n = s.log_height() as isize - l_skip as isize;
+            let n_lift = n.max(0) as usize;
+            // eq_mle(u[n_lift + 1..], b) with constant bits b.
+            let mut eq_mle = one;
+            for (k, j) in (l_skip + n_lift..l_skip + n_stack).enumerate() {
+                let x = u[n_lift + 1 + k];
+                let f = if (s.row_idx >> j) & 1 == 1 {
+                    x
+                } else {
+                    g.sub(one, x)
+                };
+                eq_mle = g.mul(eq_mle, f);
+            }
+            let h = match cache.get(&(n, need_rot)) {
+                Some(&h) => h,
+                None => {
+                    let ind = if n < 0 {
+                        let z = g.pow(u[0], 1u64 << l_skip.wrapping_add_signed(n));
+                        g.eq_uni_at_one(n.unsigned_abs(), z)
+                    } else {
+                        one
+                    };
+                    let (l, rs_n) = if n < 0 {
+                        (
+                            l_skip.wrapping_add_signed(n),
+                            vec![g.pow(r[0], 1u64 << (-n) as u32)],
+                        )
+                    } else {
+                        (l_skip, r[..=n_lift].to_vec())
+                    };
+                    let mut b = g.eq_prism(l, &u[..=n_lift], &rs_n);
+                    if need_rot {
+                        let rk = g.rot_kernel_prism(l, &u[..=n_lift], &rs_n);
+                        let rl = g.mul(rk, lambda);
+                        b = g.add(b, rl);
+                    }
+                    let h = g.mul(b, ind);
+                    cache.insert((n, need_rot), h);
+                    h
+                }
+            };
+            // coeffs[s.col_idx] += eq_mle * lambda_sqr^li * h
+            let a = g.mul(lambda_sqr_powers[li], h);
+            let a = g.mul(eq_mle, a);
+            q_coeffs[ci][s.col_idx] = g.add(q_coeffs[ci][s.col_idx], a);
+        }
+    }
+    let mut final_sum = g.kbb(0);
+    let mut openings = vec![];
+    for (qc, qv) in q_coeffs.iter().zip(&sp.stacking_openings) {
+        let mut row = vec![];
+        for (&c, &q) in qc.iter().zip(qv) {
+            let qa = g.ef_in(q);
+            g.observe_ext(qa);
+            let a = g.mul(c, qa);
+            final_sum = g.add(final_sum, a);
+            row.push(qa);
+        }
+        openings.push(row);
+    }
+    g.assert_eq(claim, final_sum);
+    Ok(Part3 {
+        u,
+        stacking_openings: openings,
+        commits,
+    })
+}
