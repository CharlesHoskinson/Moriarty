+// ------------------------------------------------------------------------------------------
+// PackAir: program (main, after the other columns) [addr_b[8], use[8], addr_out, mult_out]; main [b[8], out].
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct PackProg {
+    pub ins: Vec<Addr>,
+    pub out: Addr,
+    pub mult: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct PackAir {
+    pub prog: Arc<Vec<PackProg>>,
+}
+air_boiler!(PackAir, 9, 18);
+
+impl PackAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![Fr::ZERO; 18];
+                for (i, &a) in p.ins.iter().enumerate() {
+                    r[i] = fu(a as u64);
+                    r[8 + i] = Fr::ONE;
+                }
+                r[16] = fu(p.out as u64);
+                r[17] = fu(p.mult);
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 18, vec![Fr::ZERO; 18])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![Fr::ZERO; 9];
+                for (i, &a) in p.ins.iter().enumerate() {
+                    r[i] = fu(get(mem, a).bb()[0]);
+                }
+                r[8] = get(mem, p.out).fr();
+                r
+            })
+            .collect();
+        self.finish(rows_to_matrix(rows, self.prog.len(), 9, vec![Fr::ZERO; 9]))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for PackAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_PACK, 9, 18);
+        let mut acc = AB::Expr::ZERO;
+        for i in (0..8).rev() {
+            builder.assert_zero((AB::Expr::ONE - p[8 + i].clone()) * x[i].clone());
+            acc = acc * AB::Expr::from_u64(1 << 31) + x[i].clone();
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[i].clone(), &[x[i].clone()]),
+                -p[8 + i].clone(),
+                1,
+            );
+        }
+        builder.assert_eq(x[8].clone(), acc);
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[16].clone(), &[x[8].clone()]),
+            p[17].clone(),
+            1,
+        );
+    }
+}
