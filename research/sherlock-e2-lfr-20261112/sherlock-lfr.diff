@@ -0,0 +1,56 @@
+//! A recording wrapper around the stock `L` transcript: it logs every observe, commitment
+//! observe and sample while the stock verifier runs. The log is the reference for the tape.
+
+use std::sync::{Arc, Mutex};
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey, proof::Proof, verifier::verify, FiatShamirTranscript,
+    StarkEngine,
+};
+use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::{
+    default_transcript, BabyBearBls12381PoseidonCpuEngine, Bls12381Fr, Transcript,
+};
+use p3_baby_bear::BabyBear;
+
+use crate::fixture::{l_ud, LSC};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ev {
+    Obs(BabyBear),
+    Commit(Bls12381Fr),
+    Sample(BabyBear),
+}
+
+#[derive(Clone)]
+pub struct Rec {
+    pub inner: Transcript,
+    pub log: Arc<Mutex<Vec<Ev>>>,
+}
+
+impl FiatShamirTranscript<LSC> for Rec {
+    fn observe(&mut self, v: BabyBear) {
+        self.log.lock().unwrap().push(Ev::Obs(v));
+        FiatShamirTranscript::<LSC>::observe(&mut self.inner, v);
+    }
+    fn sample(&mut self) -> BabyBear {
+        let v = FiatShamirTranscript::<LSC>::sample(&mut self.inner);
+        self.log.lock().unwrap().push(Ev::Sample(v));
+        v
+    }
+    fn observe_commit(&mut self, d: [Bls12381Fr; 1]) {
+        self.log.lock().unwrap().push(Ev::Commit(d[0]));
+        FiatShamirTranscript::<LSC>::observe_commit(&mut self.inner, d);
+    }
+}
+
+/// The stock verifier's transcript events on an `L` proof, and its verdict.
+pub fn stock_log(vk: &MultiStarkVerifyingKey<LSC>, proof: &Proof<LSC>) -> (Vec<Ev>, bool) {
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(l_ud(48));
+    let mut rec = Rec {
+        inner: default_transcript(),
+        log: Default::default(),
+    };
+    let ok = verify(engine.config(), vk, proof, &mut rec).is_ok();
+    let log = rec.log.lock().unwrap().clone();
+    (log, ok)
+}
diff --git a/crates/sherlock-lfr/src/tape.rs b/crates/sherlock-lfr/src/tape.rs
new file mode 100644
index 0000000..2daa786
--- /dev/null
+++ b/crates/sherlock-lfr/src/tape.rs
@@ -0,0 +1,644 @@
+//! I4: the tape (a straight-line program fixed by the key) and its write-once memory.
+//!
+//! Every tape value has one address and is written once. A writer sends `[addr, v0, v1, v2, v3]`
+//! on [`MEM_BUS`] with the multiplicity `mult` = the number of reads of `addr` in the tape; each
+//! read sends the same message with count `-1`. Addresses, op kinds and multiplicities come from
+//! the program table (the one preprocessed trace), so the key fixes the program; only the values
+//! are witness.
+//!
+//! AIRs:
+//! Program cells (addresses, kinds, multiplicities, constants) are main columns received from
+//! the one program table (`crate::program`), not per-AIR preprocessed traces.
+//!
+//! - [`InputAir`]: tape inputs (values of the `L` proof) and constants. Program `[addr,
+//!   mult, z1, z2, z3, is_const, k0..k3]`; main `v[4]` and a canonical gadget per coefficient
+//!   (`lo, hi, inv, is_max`). Each coefficient is canonical BabyBear; `z_k = 1` forces
+//!   coefficient `k` to 0 (a BabyBear value); `is_const = 1` forces `v = k`.
+//! - [`BbAluProgAir`]: the `BbAlu` row plus `[addr_a, addr_b, addr_c, mult_c]`; the program
+//!   message is `[add, sub, mul, addr_a, addr_b, addr_c, mult_c]` (the selectors are the ALU
+//!   columns). It reads `a` and `b` (count `-active`) and writes `c` (count `mult_c`).
+
+use std::sync::Arc;
+
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, BaseAir},
+    p3_field::Field,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+use p3_field::PrimeCharacteristicRing;
+
+use crate::{
+    alu::{
+        alu_trace, canonical_cells, eval_canonical, AluKind, AluOp, AluRow, BbAluAir, A, B, C,
+        SEL_ADD,
+    },
+    bb::P,
+    program::{receive_prog, TAG_ALU, TAG_INPUT},
+    range::RangeCounts,
+};
+
+pub const MEM_BUS: BusIndex = 2;
+pub type Addr = u32;
+
+/// Value type of a tape input.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ValKind {
+    Bb,
+    Ef4,
+}
+
+/// A memory value: BabyBear or `EF4` (4 canonical coefficients; BabyBear has 3 zero ones), or
+/// one Fr word. On the bus both are `[addr, v0, v1, v2, v3]`; an Fr word is `[addr, v, 0, 0, 0]`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Val {
+    Bb([u64; 4]),
+    Fr(Fr),
+}
+
+impl Val {
+    pub fn bb(&self) -> [u64; 4] {
+        match self {
+            Val::Bb(v) => *v,
+            Val::Fr(_) => panic!("Fr value read as BabyBear"),
+        }
+    }
+    pub fn fr(&self) -> Fr {
+        match self {
+            Val::Fr(v) => *v,
+            Val::Bb(_) => panic!("BabyBear value read as Fr"),
+        }
+    }
+    pub fn cells(&self) -> [Fr; 4] {
+        match self {
+            Val::Bb(v) => std::array::from_fn(|k| Fr::from_u64(v[k])),
+            Val::Fr(v) => [*v, Fr::ZERO, Fr::ZERO, Fr::ZERO],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Op {
+    Input {
+        kind: ValKind,
+        out: Addr,
+    },
+    Const {
+        kind: ValKind,
+        val: [u64; 4],
+        out: Addr,
+    },
+    Alu {
+        kind: AluKind,
+        a: Addr,
+        b: Addr,
+        out: Addr,
+    },
+    /// A free Fr word (a value of the `L` proof, such as a commitment).
+    FrInput {
+        out: Addr,
+    },
+    FrConst {
+        val: Fr,
+        out: Addr,
+    },
+    /// The Midnight Poseidon permutation of 3 Fr words.
+    Perm {
+        ins: [Addr; 3],
+        outs: [Addr; 3],
+    },
+    /// `sum_i b_i 2^(31 i)` of 1 to 8 BabyBear words (multi-field packing).
+    Pack {
+        ins: Vec<Addr>,
+        out: Addr,
+    },
+    /// The 5 low base-`p` digits of an Fr word (multi-field squeeze).
+    Split {
+        x: Addr,
+        outs: [Addr; 5],
+    },
+    /// 4 BabyBear words -> one `EF4` value.
+    Compose {
+        ins: [Addr; 4],
+        out: Addr,
+    },
+    /// One `EF4` value -> its 4 coefficients as BabyBear words.
+    Decompose {
+        x: Addr,
+        outs: [Addr; 4],
+    },
+    /// The values at `a` and `b` are equal (a check of the verifier; no output).
+    AssertEq {
+        a: Addr,
+        b: Addr,
+    },
+    /// `x mod 2^n` of a BabyBear word (`sample_bits`), `n <= 31`.
+    LowBits {
+        x: Addr,
+        n: u32,
+        out: Addr,
+    },
+}
+
+/// A straight-line program over BabyBear and `EF4` values.
+#[derive(Clone, Debug, Default)]
+pub struct Tape {
+    pub ops: Vec<Op>,
+    next: Addr,
+}
+
+impl Tape {
+    fn fresh(&mut self) -> Addr {
+        self.next += 1; // address 0 is never used (padding rows carry it with count 0)
+        self.next
+    }
+    pub fn input(&mut self, kind: ValKind) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::Input { kind, out });
+        out
+    }
+    pub fn constant(&mut self, kind: ValKind, val: [u64; 4]) -> Addr {
+        assert!(val.iter().all(|&v| v < P));
+        assert!(kind == ValKind::Ef4 || val[1..] == [0; 3]);
+        let out = self.fresh();
+        self.ops.push(Op::Const { kind, val, out });
+        out
+    }
+    pub fn alu(&mut self, kind: AluKind, a: Addr, b: Addr) -> Addr {
+        assert!(
+            a <= self.next && b <= self.next && a > 0 && b > 0,
+            "read before write"
+        );
+        let out = self.fresh();
+        self.ops.push(Op::Alu { kind, a, b, out });
+        out
+    }
+    pub fn add(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Add, a, b)
+    }
+    pub fn sub(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Sub, a, b)
+    }
+    pub fn mul(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Mul, a, b)
+    }
+    pub fn num_addrs(&self) -> usize {
+        self.next as usize + 1
+    }
+    fn check(&self, a: Addr) {
+        assert!(a > 0 && a <= self.next, "read before write");
+    }
+    pub fn fr_input(&mut self) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::FrInput { out });
+        out
+    }
+    pub fn fr_const(&mut self, val: Fr) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::FrConst { val, out });
+        out
+    }
+    pub fn perm(&mut self, ins: [Addr; 3]) -> [Addr; 3] {
+        ins.iter().for_each(|&a| self.check(a));
+        let outs = [self.fresh(), self.fresh(), self.fresh()];
+        self.ops.push(Op::Perm { ins, outs });
+        outs
+    }
+    pub fn pack(&mut self, ins: &[Addr]) -> Addr {
+        assert!(!ins.is_empty() && ins.len() <= 8);
+        ins.iter().for_each(|&a| self.check(a));
+        let out = self.fresh();
+        self.ops.push(Op::Pack {
+            ins: ins.to_vec(),
+            out,
+        });
+        out
+    }
+    pub fn split(&mut self, x: Addr) -> [Addr; 5] {
+        self.check(x);
+        let outs = std::array::from_fn(|_| self.fresh());
+        self.ops.push(Op::Split { x, outs });
+        outs
+    }
+    pub fn compose(&mut self, ins: [Addr; 4]) -> Addr {
+        ins.iter().for_each(|&a| self.check(a));
+        let out = self.fresh();
+        self.ops.push(Op::Compose { ins, out });
+        out
+    }
+    pub fn decompose(&mut self, x: Addr) -> [Addr; 4] {
+        self.check(x);
+        let outs = std::array::from_fn(|_| self.fresh());
+        self.ops.push(Op::Decompose { x, outs });
+        outs
+    }
+    pub fn assert_eq(&mut self, a: Addr, b: Addr) {
+        self.check(a);
+        self.check(b);
+        self.ops.push(Op::AssertEq { a, b });
+    }
+    pub fn low_bits(&mut self, x: Addr, n: u32) -> Addr {
+        assert!(n <= 31);
+        self.check(x);
+        let out = self.fresh();
+        self.ops.push(Op::LowBits { x, n, out });
+        out
+    }
+
+    /// Read counts per address.
+    pub fn reads(&self) -> Vec<u64> {
+        let mut r = vec![0u64; self.num_addrs()];
+        let mut rd = |a: &Addr| r[*a as usize] += 1;
+        for op in &self.ops {
+            match op {
+                Op::Alu { a, b, .. } => {
+                    rd(a);
+                    rd(b);
+                }
+                Op::Perm { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Pack { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Split { x, .. } => rd(x),
+                Op::Compose { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Decompose { x, .. } => rd(x),
+                Op::AssertEq { a, b } => {
+                    rd(a);
+                    rd(b);
+                }
+                Op::LowBits { x, .. } => rd(x),
+                Op::Input { .. } | Op::Const { .. } | Op::FrInput { .. } | Op::FrConst { .. } => {}
+            }
+        }
+        r
+    }
+
+    /// Run a BabyBear and `EF4` tape on the input values (in order of the `Input` ops).
+    pub fn execute(&self, inputs: &[[u64; 4]]) -> Vec<[u64; 4]> {
+        let ins: Vec<Val> = inputs.iter().map(|v| Val::Bb(*v)).collect();
+        self.execute_vals(&ins)
+            .into_iter()
+            .map(|v| v.map(|v| v.bb()).unwrap_or([0; 4]))
+            .collect()
+    }
+
+    /// Run the tape on the input values (in order of the `Input` and `FrInput` ops). Returns
+    /// every value (`None` at address 0). Panics if an `AssertEq` fails.
+    pub fn execute_vals(&self, inputs: &[Val]) -> Vec<Option<Val>> {
+        let (mem, failed) = self.execute_checked(inputs);
+        assert!(failed.is_empty(), "tape assertions failed at ops {failed:?}");
+        mem
+    }
+
+    /// Run the tape; returns the memory and the op indices of the failed `AssertEq` ops (the
+    /// plain-Rust verdict of the tape: accept iff none failed).
+    pub fn execute_checked(&self, inputs: &[Val]) -> (Vec<Option<Val>>, Vec<usize>) {
+        let mut failed = vec![];
+        let mut mem: Vec<Option<Val>> = vec![None; self.num_addrs()];
+        let mut it = inputs.iter();
+        let get = |mem: &Vec<Option<Val>>, a: &Addr| mem[*a as usize].expect("unwritten address");
+        for (idx, op) in self.ops.iter().enumerate() {
+            match op {
+                Op::AssertEq { a, b } => {
+                    if get(&mem, a) != get(&mem, b) {
+                        failed.push(idx);
+                    }
+                }
+                Op::LowBits { x, n, out } => {
+                    let v = get(&mem, x).bb()[0];
+                    mem[*out as usize] = Some(Val::Bb([v & ((1u64 << n) - 1), 0, 0, 0]));
+                }
+                Op::Input { kind, out } => {
+                    let v = it.next().expect("too few inputs").bb();
+                    assert!(v.iter().all(|&x| x < P), "input not canonical");
+                    assert!(*kind == ValKind::Ef4 || v[1..] == [0; 3], "BabyBear input");
+                    mem[*out as usize] = Some(Val::Bb(v));
+                }
+                Op::Const { val, out, .. } => mem[*out as usize] = Some(Val::Bb(*val)),
+                Op::Alu { kind, a, b, out } => {
+                    let op = AluOp {
+                        kind: *kind,
+                        a: get(&mem, a).bb(),
+                        b: get(&mem, b).bb(),
+                    };
+                    mem[*out as usize] = Some(Val::Bb(op.result()));
+                }
+                Op::FrInput { out } => {
+                    mem[*out as usize] = Some(Val::Fr(it.next().expect("too few inputs").fr()))
+                }
+                Op::FrConst { val, out } => mem[*out as usize] = Some(Val::Fr(*val)),
+                Op::Perm { ins, outs } => {
+                    let (o, _) = crate::poseidon::permute_trace(ins.map(|a| get(&mem, &a).fr()));
+                    for i in 0..3 {
+                        mem[outs[i] as usize] = Some(Val::Fr(o[i]));
+                    }
+                }
+                Op::Pack { ins, out } => {
+                    let words: Vec<u64> = ins.iter().map(|a| get(&mem, a).bb()[0]).collect();
+                    mem[*out as usize] = Some(Val::Fr(crate::fr::pack(&words)));
+                }
+                Op::Split { x, outs } => {
+                    let d = crate::fr::split(get(&mem, x).fr()).0;
+                    for i in 0..5 {
+                        mem[outs[i] as usize] = Some(Val::Bb([d[i], 0, 0, 0]));
+                    }
+                }
+                Op::Compose { ins, out } => {
+                    let v = ins.map(|a| get(&mem, &a).bb()[0]);
+                    mem[*out as usize] = Some(Val::Bb(v));
+                }
+                Op::Decompose { x, outs } => {
+                    let v = get(&mem, x).bb();
+                    for i in 0..4 {
+                        mem[outs[i] as usize] = Some(Val::Bb([v[i], 0, 0, 0]));
+                    }
+                }
+            }
+        }
+        assert!(it.next().is_none(), "too many inputs");
+        (mem, failed)
+    }
+
+    /// The preprocessed programs of the two AIRs.
+    pub fn programs(&self) -> (InputAir, BbAluProgAir) {
+        let reads = self.reads();
+        let mut inp = vec![];
+        let mut alu = vec![];
+        for op in &self.ops {
+            match op {
+                Op::Input { kind, out } => inp.push(InputProg {
+                    addr: *out,
+                    mult: reads[*out as usize],
+                    bb: *kind == ValKind::Bb,
+                    konst: None,
+                }),
+                Op::Const { kind, val, out } => inp.push(InputProg {
+                    addr: *out,
+                    mult: reads[*out as usize],
+                    bb: *kind == ValKind::Bb,
+                    konst: Some(*val),
+                }),
+                Op::Alu { kind, a, b, out } => alu.push(AluProg {
+                    kind: *kind,
+                    a: *a,
+                    b: *b,
+                    out: *out,
+                    mult: reads[*out as usize],
+                }),
+                _ => panic!("programs() is for BabyBear and EF4 tapes; use machine::Machine"),
+            }
+        }
+        (
+            InputAir {
+                prog: Arc::new(inp),
+            },
+            BbAluProgAir {
+                prog: Arc::new(alu),
+            },
+        )
+    }
+}
+
+pub fn padded(n: usize) -> usize {
+    n.next_power_of_two().max(2)
+}
+
+// ------------------------------------------------------------------------------------------
+// InputAir
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct InputProg {
+    pub addr: Addr,
+    pub mult: u64,
+    pub bb: bool,
+    pub konst: Option<[u64; 4]>,
+}
+
+#[derive(Clone, Debug)]
+pub struct InputAir {
+    pub prog: Arc<Vec<InputProg>>,
+}
+
+pub const IN_PRE_WIDTH: usize = 10;
+pub const IN_WIDTH: usize = 20;
+
+impl<F: Field> BaseAir<F> for InputAir {
+    fn width(&self) -> usize {
+        IN_WIDTH + IN_PRE_WIDTH
+    }
+}
+
+impl InputAir {
+    /// Program rows (unpadded), sent by the program table under `TAG_INPUT`.
+    pub fn prog_rows<F: Field>(&self) -> Vec<Vec<F>> {
+        let mut out = vec![];
+        for p in self.prog.iter() {
+            let mut v = vec![F::ZERO; IN_PRE_WIDTH];
+            let r = &mut v[..];
+            r[0] = F::from_u32(p.addr);
+            r[1] = F::from_u64(p.mult);
+            if p.bb {
+                r[2] = F::ONE;
+                r[3] = F::ONE;
+                r[4] = F::ONE;
+            }
+            if let Some(k) = p.konst {
+                r[5] = F::ONE;
+                for j in 0..4 {
+                    r[6 + j] = F::from_u64(k[j]);
+                }
+            }
+            out.push(v);
+        }
+        out
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for InputAir {}
+impl<F: Field> PartitionedBaseAir<F> for InputAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for InputAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..IN_WIDTH).map(|i| r[i].into()).collect();
+        let pv: Vec<AB::Expr> = (IN_WIDTH..IN_WIDTH + IN_PRE_WIDTH)
+            .map(|i| r[i].into())
+            .collect();
+        drop(r);
+        receive_prog(builder, TAG_INPUT, &pv);
+        for k in 0..4 {
+            let v = x[k].clone();
+            eval_canonical(
+                builder,
+                v.clone(),
+                x[4 + k].clone(),
+                x[8 + k].clone(),
+                x[12 + k].clone(),
+                x[16 + k].clone(),
+            );
+            if k > 0 {
+                builder.assert_zero(pv[1 + k].clone() * v.clone());
+            }
+            builder.assert_zero(pv[5].clone() * (v - pv[6 + k].clone()));
+        }
+        let msg: Vec<AB::Expr> = std::iter::once(pv[0].clone())
+            .chain(x[0..4].iter().cloned())
+            .collect();
+        builder.push_interaction(MEM_BUS, msg, pv[1].clone(), 1);
+    }
+}
+
+impl InputAir {
+    /// Main trace from the value of each row (in program order). Canonical cells are computed
+    /// from the values as given, so a test can pass a non-canonical value.
+    pub fn trace<F: Field>(
+        &self,
+        vals: &[[u64; 4]],
+        counts: &mut RangeCounts,
+    ) -> RowMajorMatrix<F> {
+        assert_eq!(vals.len(), self.prog.len());
+        let h = padded(self.prog.len());
+        let w = IN_WIDTH + IN_PRE_WIDTH;
+        let prog = self.prog_rows::<F>();
+        let mut v = vec![F::ZERO; h * w];
+        for i in 0..h {
+            let val = vals.get(i).copied().unwrap_or([0; 4]);
+            let row = &mut v[i * w..(i + 1) * w];
+            if let Some(p) = prog.get(i) {
+                row[IN_WIDTH..].copy_from_slice(p);
+            }
+            for k in 0..4 {
+                row[k] = F::from_u64(val[k]);
+                let cc = canonical_cells::<F>(val[k]);
+                for j in 0..4 {
+                    row[4 + 4 * j + k] = cc[j];
+                }
+                let (lo, hi) = (val[k] & 0xffff, val[k] >> 16);
+                for x in [Some(lo), Some(hi), 0x7800u64.checked_sub(hi)]
+                    .into_iter()
+                    .flatten()
+                {
+                    if x < (1 << 16) {
+                        counts.add(x);
+                    }
+                }
+            }
+        }
+        RowMajorMatrix::new(v, w)
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// BbAluProgAir
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct AluProg {
+    pub kind: AluKind,
+    pub a: Addr,
+    pub b: Addr,
+    pub out: Addr,
+    pub mult: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct BbAluProgAir {
+    pub prog: Arc<Vec<AluProg>>,
+}
+
+/// Program cells of an ALU row: `[add, sub, mul, addr_a, addr_b, addr_c, mult_c]`.
+pub const ALU_PRE_WIDTH: usize = 7;
+/// Program columns appended to the `BbAlu` row (the selectors are already ALU columns).
+pub const ALU_PROG_COLS: usize = 4;
+
+impl<F: Field> BaseAir<F> for BbAluProgAir {
+    fn width(&self) -> usize {
+        crate::alu::ALU_WIDTH + ALU_PROG_COLS
+    }
+}
+
+impl BbAluProgAir {
+    /// Program rows (unpadded), sent by the program table under `TAG_ALU`.
+    pub fn prog_rows<F: Field>(&self) -> Vec<Vec<F>> {
+        let mut out = vec![];
+        for p in self.prog.iter() {
+            let mut r = vec![F::ZERO; ALU_PRE_WIDTH];
+            let s = match p.kind {
+                AluKind::Add => 0,
+                AluKind::Sub => 1,
+                AluKind::Mul => 2,
+            };
+            r[s] = F::ONE;
+            r[3] = F::from_u32(p.a);
+            r[4] = F::from_u32(p.b);
+            r[5] = F::from_u32(p.out);
+            r[6] = F::from_u64(p.mult);
+            out.push(r);
+        }
+        out
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for BbAluProgAir {}
+impl<F: Field> PartitionedBaseAir<F> for BbAluProgAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for BbAluProgAir {
+    fn eval(&self, builder: &mut AB) {
+        let w = crate::alu::ALU_WIDTH;
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..w + ALU_PROG_COLS).map(|i| r[i].into()).collect();
+        drop(r);
+        // The ALU identities (selectors from main) ...
+        <BbAluAir as Air<AB>>::eval(&BbAluAir, builder);
+        // ... with the selectors and addresses fixed by the program table.
+        let pv: Vec<AB::Expr> = x[SEL_ADD..SEL_ADD + 3]
+            .iter()
+            .chain(&x[w..w + ALU_PROG_COLS])
+            .cloned()
+            .collect();
+        receive_prog(builder, TAG_ALU, &pv);
+        let active = pv[0].clone() + pv[1].clone() + pv[2].clone();
+        let msg = |addr: AB::Expr, base: usize| -> Vec<AB::Expr> {
+            std::iter::once(addr)
+                .chain(x[base..base + 4].iter().cloned())
+                .collect()
+        };
+        builder.push_interaction(MEM_BUS, msg(pv[3].clone(), A), -active.clone(), 1);
+        builder.push_interaction(MEM_BUS, msg(pv[4].clone(), B), -active, 1);
+        builder.push_interaction(MEM_BUS, msg(pv[5].clone(), C), pv[6].clone(), 1);
+    }
+}
+
+impl BbAluProgAir {
+    /// Honest rows from the executed memory.
+    pub fn rows(&self, mem: &[[u64; 4]]) -> Vec<AluRow> {
+        self.prog
+            .iter()
+            .map(|p| {
+                AluRow::from_op(&AluOp {
+                    kind: p.kind,
+                    a: mem[p.a as usize],
+                    b: mem[p.b as usize],
+                })
+            })
+            .collect()
+    }
+
+    pub fn trace<F: Field>(&self, rows: &[AluRow], counts: &mut RangeCounts) -> RowMajorMatrix<F> {
+        let m = alu_trace::<F>(rows, counts);
+        assert_eq!(m.height(), padded(self.prog.len()));
+        let (h, w) = (m.height(), m.width());
+        let prog = self.prog_rows::<F>();
+        let mut v = Vec::with_capacity(h * (w + ALU_PROG_COLS));
+        for i in 0..h {
+            v.extend_from_slice(&m.values[i * w..(i + 1) * w]);
+            match prog.get(i) {
+                Some(p) => v.extend_from_slice(&p[3..]),
+                None => v.extend(std::iter::repeat_n(F::ZERO, ALU_PROG_COLS)),
+            }
+        }
+        RowMajorMatrix::new(v, w + ALU_PROG_COLS)
+    }
+}
diff --git a/crates/sherlock-lfr/src/testing.rs b/crates/sherlock-lfr/src/testing.rs
new file mode 100644
index 0000000..b6d0776
--- /dev/null
+++ b/crates/sherlock-lfr/src/testing.rs
@@ -0,0 +1,222 @@
+//! Prove-and-verify helpers for the increment tests, at the `L_Fr` domains (u = 5, 6, 7).
+
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use num_bigint::BigUint;
+use openvm_stark_backend::{
+    air_builders::symbolic::SymbolicConstraints,
+    codec::Encode,
+    interaction::debug::{generate_logical_interactions, LogicalInteractions},
+    interaction::LogUpSecurityParameters,
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    p3_field::{Field, PrimeField},
+    p3_matrix::dense::RowMajorMatrix,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, StarkEngine, SystemParams, WhirConfig, WhirParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    Bls12381FrPoseidonConfig, Bls12381FrPoseidonLfrCpuEngine, F,
+};
+
+use crate::range::{RangeCounts, RANGE_BUS, RANGE_SIZE};
+
+pub type SC = Bls12381FrPoseidonConfig;
+pub type Engine = Bls12381FrPoseidonLfrCpuEngine;
+
+/// Small Fr test set: UD, log blowup 1, `l_skip` 2, `n_stack` 14 (stacked height 2^16, so the
+/// 2^16-row range table fits), `w_stack` 128, `k_whir` 4, every grinding site on at a few bits.
+pub fn small_params(max_constraint_degree: usize) -> SystemParams {
+    small_params_n(max_constraint_degree, 14)
+}
+
+/// [`small_params`] at another `n_stack` (stacked height `2^(2 + n_stack)`), for tapes whose
+/// largest AIR exceeds `2^16` rows.
+pub fn small_params_n(max_constraint_degree: usize, n_stack: usize) -> SystemParams {
+    let (l_skip, k_whir, log_blowup) = (2, 4, 1);
+    let whir_params = WhirParams {
+        k: k_whir,
+        log_final_poly_len: (l_skip + n_stack) % k_whir,
+        query_phase_pow_bits: 6,
+        folding_pow_bits: 5,
+        mu_pow_bits: 4,
+        proximity: WhirProximityStrategy::UniqueDecoding,
+    };
+    SystemParams {
+        l_skip,
+        n_stack,
+        w_stack: 128,
+        log_blowup,
+        whir: WhirConfig::new(log_blowup, l_skip + n_stack, whir_params, 40),
+        logup: LogUpSecurityParameters {
+            max_interaction_count: 1 << 30,
+            log_max_message_length: 7,
+            pow_bits: 7,
+        },
+        max_constraint_degree,
+    }
+}
+
+/// Outcome of one prove-and-verify run.
+#[derive(Debug)]
+pub enum Outcome {
+    /// Proved and the stock verifier accepted: proof bytes, and the number of commitments of the
+    /// proof (`stacking_openings.len()`: common main, then each preprocessed or cached one).
+    Accepted { bytes: usize, commits: usize },
+    /// The stock verifier refused the proof.
+    VerifierRefused(String),
+    /// The prover stopped (panic) on the witness.
+    ProverRefused(String),
+}
+
+impl Outcome {
+    pub fn accepted(&self) -> bool {
+        matches!(self, Outcome::Accepted { .. })
+    }
+    /// The commitment count of an accepted proof.
+    pub fn commits(&self) -> Option<usize> {
+        match self {
+            Outcome::Accepted { commits, .. } => Some(*commits),
+            _ => None,
+        }
+    }
+}
+
+/// Keygen, prove and verify `airs` on `traces` (one per AIR, in order, no public values).
+pub fn prove_verify(
+    params: SystemParams,
+    airs: Vec<AirRef<SC>>,
+    traces: Vec<RowMajorMatrix<F>>,
+) -> Outcome {
+    let engine = Engine::new(params);
+    let (pk, vk) = engine.keygen(&airs);
+    prove_verify_keyed(&engine, &pk, &vk, traces)
+}
+
+/// The number of AIRs of `vk` with a preprocessed trace (each adds one commitment).
+pub fn preprocessed_airs(vk: &MultiStarkVerifyingKey<SC>) -> usize {
+    vk.inner
+        .per_air
+        .iter()
+        .filter(|a| a.preprocessed_data.is_some())
+        .count()
+}
+
+/// The `Range16` multiplicities that balance the range bus for the main traces of
+/// `airs[..n-1]` (the last AIR is `Range16`). A looked-up value at or above `2^16` is left
+/// out, so its bus does not balance.
+pub fn range_trace(
+    pk: &MultiStarkProvingKey<SC>,
+    airs: &[AirRef<SC>],
+    traces: &[RowMajorMatrix<F>],
+) -> RowMajorMatrix<F> {
+    let mut li = LogicalInteractions::<F>::default();
+    for (i, (air, t)) in airs.iter().zip(traces).enumerate() {
+        let sc = SymbolicConstraints::from(&pk.per_air[i].vk.symbolic_constraints);
+        let pre = air.preprocessed_trace();
+        let pre_view = pre.as_ref().map(|m| m.as_view());
+        generate_logical_interactions(i, &sc.interactions, &pre_view, &[t.as_view()], &[], &mut li);
+    }
+    let mut counts = RangeCounts::default();
+    if let Some(bus) = li.at_bus.get(&RANGE_BUS) {
+        for (fields, conns) in bus {
+            let v = fields[0].as_canonical_biguint();
+            if v < BigUint::from(RANGE_SIZE as u64) {
+                let idx = v.to_u64_digits().first().copied().unwrap_or(0) as usize;
+                let total: F = conns.iter().map(|(_, c)| *c).sum();
+                // Counts are small non-negative integers for an honest or tampered trace.
+                let n = total
+                    .as_canonical_biguint()
+                    .to_u64_digits()
+                    .first()
+                    .copied()
+                    .unwrap_or(0);
+                counts.0[idx] += n;
+            }
+        }
+    }
+    counts.trace()
+}
+
+/// Whether bus `bus` balances (every message's counts sum to 0) for `traces` of `airs` (one
+/// trace per AIR, in order). A diagnostic for negative controls: it shows which bus a tamper
+/// breaks.
+pub fn bus_balances(
+    params: SystemParams,
+    airs: &[AirRef<SC>],
+    traces: &[RowMajorMatrix<F>],
+    bus: u16,
+) -> bool {
+    let engine = Engine::new(params);
+    let (pk, _) = engine.keygen(airs);
+    let mut li = LogicalInteractions::<F>::default();
+    for (i, (air, t)) in airs.iter().zip(traces).enumerate() {
+        let sc = SymbolicConstraints::from(&pk.per_air[i].vk.symbolic_constraints);
+        let pre = air.preprocessed_trace();
+        let pre_view = pre.as_ref().map(|m| m.as_view());
+        generate_logical_interactions(i, &sc.interactions, &pre_view, &[t.as_view()], &[], &mut li);
+    }
+    li.at_bus.get(&bus).is_none_or(|m| {
+        m.values()
+            .all(|conns| conns.iter().map(|(_, c)| *c).sum::<F>().is_zero())
+    })
+}
+
+/// Keygen, fill the `Range16` table (last AIR), prove and verify.
+pub fn prove_verify_range(
+    params: SystemParams,
+    airs: Vec<AirRef<SC>>,
+    mut traces: Vec<RowMajorMatrix<F>>,
+) -> (Outcome, MultiStarkVerifyingKey<SC>) {
+    let engine = Engine::new(params);
+    let (pk, vk) = engine.keygen(&airs);
+    assert_eq!(traces.len() + 1, airs.len());
+    traces.push(range_trace(&pk, &airs, &traces));
+    (prove_verify_keyed(&engine, &pk, &vk, traces), vk)
+}
+
+/// Prove and verify under an existing key.
+pub fn prove_verify_keyed(
+    engine: &Engine,
+    pk: &MultiStarkProvingKey<SC>,
+    vk: &MultiStarkVerifyingKey<SC>,
+    traces: Vec<RowMajorMatrix<F>>,
+) -> Outcome {
+    let d_pk = engine.device().transport_pk_to_device(pk);
+    let res = catch_unwind(AssertUnwindSafe(|| {
+        let ctx = ProvingContext::new(
+            traces
+                .iter()
+                .enumerate()
+                .map(|(i, t)| {
+                    let cm = ColMajorMatrix::from_row_major(t);
+                    (
+                        i,
+                        AirProvingContext::simple_no_pis(
+                            engine.device().transport_matrix_to_device(&cm),
+                        ),
+                    )
+                })
+                .collect(),
+        );
+        engine.prove(&d_pk, ctx)
+    }));
+    let proof = match res {
+        Err(e) => {
+            let msg = e
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_default();
+            return Outcome::ProverRefused(msg);
+        }
+        Ok(Err(e)) => return Outcome::ProverRefused(format!("{e:?}")),
+        Ok(Ok(p)) => p,
+    };
+    match engine.verify(vk, &proof) {
+        Ok(()) => Outcome::Accepted {
+            bytes: proof.encode_to_vec().map(|b| b.len()).unwrap_or(0),
+            commits: proof.stacking_proof.stacking_openings.len(),
+        },
+        Err(e) => Outcome::VerifierRefused(format!("{e:?}")),
+    }
+}
diff --git a/crates/sherlock-lfr/src/transcript.rs b/crates/sherlock-lfr/src/transcript.rs
new file mode 100644
index 0000000..5778c5b
--- /dev/null
+++ b/crates/sherlock-lfr/src/transcript.rs
@@ -0,0 +1,143 @@
+//! I5: the transcript of `L` on the tape.
+//!
+//! [`TapeTranscript`] emits the tape ops of the stock `MultiFieldTranscript<BabyBear, Fr,
+//! MidnightPoseidonFr, 3, 2>` from the initial state `(0, 0, 2^64 + u 2^66)` (u = 3 for `L`):
+//! the overwrite duplex (an absorb replaces a state cell; a full block or a squeeze after an
+//! absorb permutes), observe buffering of 8 BabyBear words per Fr word (`Pack`), and 5 base-`p`
+//! digits per squeezed Fr word (`Split`). Every transition follows
+//! `stark-backend/src/transcript/{multi_field,duplex_sponge}.rs` line by line. The tape addresses
+//! of the state cells move; no op is needed for an overwrite.
+
+use openvm_stark_sdk::config::bls12381_fr_poseidon::cap_var;
+use p3_field::PrimeCharacteristicRing;
+
+use crate::tape::{Addr, Tape};
+
+const RATE: usize = 2;
+const OBS_PER_ELEM: usize = 8;
+const SAMPLES_PER_ELEM: usize = 5;
+
+/// One transcript event on the tape, in the order of the stock `FiatShamirTranscript` calls
+/// (`observe_ext` is 4 observes, `sample_ext` 4 samples, `check_witness` an observe and a
+/// sample).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TEv {
+    Obs(Addr),
+    Commit(Addr),
+    Sample(Addr),
+}
+
+#[derive(Clone, Debug)]
+pub struct TapeTranscript {
+    /// Every event, in order.
+    pub log: Vec<TEv>,
+    state: [Addr; 3],
+    absorb_idx: usize,
+    sample_idx: usize,
+    observe_buf: Vec<Addr>,
+    /// Pending digits, in pop order (the next digit is the last).
+    sample_buf: Vec<Addr>,
+}
+
+impl TapeTranscript {
+    pub fn new(tape: &mut Tape, u_transcript: u128) -> Self {
+        let zero = tape.fr_const(openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr::ZERO);
+        let cap = tape.fr_const(cap_var(u_transcript));
+        Self {
+            log: vec![],
+            state: [zero, zero, cap],
+            absorb_idx: 0,
+            sample_idx: 0,
+            observe_buf: vec![],
+            sample_buf: vec![],
+        }
+    }
+
+    fn permute(&mut self, tape: &mut Tape) {
+        self.state = tape.perm(self.state);
+        self.absorb_idx = 0;
+        self.sample_idx = RATE;
+    }
+
+    fn absorb(&mut self, tape: &mut Tape, x: Addr) {
+        self.state[self.absorb_idx] = x;
+        self.absorb_idx += 1;
+        if self.absorb_idx == RATE {
+            self.permute(tape);
+        }
+    }
+
+    fn squeeze(&mut self, tape: &mut Tape) -> Addr {
+        if self.absorb_idx != 0 || self.sample_idx == 0 {
+            self.permute(tape);
+        }
+        self.sample_idx -= 1;
+        self.state[self.sample_idx]
+    }
+
+    fn flush_observe_buf(&mut self, tape: &mut Tape) {
+        if !self.observe_buf.is_empty() {
+            let packed = tape.pack(&self.observe_buf);
+            self.absorb(tape, packed);
+            self.observe_buf.clear();
+        }
+    }
+
+    /// Observe one BabyBear word.
+    pub fn observe(&mut self, tape: &mut Tape, w: Addr) {
+        self.log.push(TEv::Obs(w));
+        self.sample_buf.clear();
+        self.observe_buf.push(w);
+        if self.observe_buf.len() == OBS_PER_ELEM {
+            let packed = tape.pack(&self.observe_buf);
+            self.absorb(tape, packed);
+            self.observe_buf.clear();
+        }
+    }
+
+    /// Observe an `EF4` value: its 4 coefficients in order.
+    pub fn observe_ext(&mut self, tape: &mut Tape, x: Addr) {
+        for w in tape.decompose(x) {
+            self.observe(tape, w);
+        }
+    }
+
+    /// Observe a commitment (one Fr word).
+    pub fn observe_commit(&mut self, tape: &mut Tape, d: Addr) {
+        self.log.push(TEv::Commit(d));
+        self.sample_buf.clear();
+        self.flush_observe_buf(tape);
+        self.absorb(tape, d);
+    }
+
+    /// Sample one BabyBear word.
+    pub fn sample(&mut self, tape: &mut Tape) -> Addr {
+        let a = self.sample_inner(tape);
+        self.log.push(TEv::Sample(a));
+        a
+    }
+
+    fn sample_inner(&mut self, tape: &mut Tape) -> Addr {
+        if let Some(v) = self.sample_buf.pop() {
+            return v;
+        }
+        self.flush_observe_buf(tape);
+        let sq = self.squeeze(tape);
+        let mut d = tape.split(sq).to_vec();
+        assert_eq!(d.len(), SAMPLES_PER_ELEM);
+        d.reverse();
+        self.sample_buf = d;
+        self.sample_buf.pop().expect("digits")
+    }
+
+    /// Sample an `EF4` value from 4 words (coefficient order).
+    pub fn sample_ext(&mut self, tape: &mut Tape) -> Addr {
+        let w = [
+            self.sample(tape),
+            self.sample(tape),
+            self.sample(tape),
+            self.sample(tape),
+        ];
+        tape.compose(w)
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i0_fixture.rs b/crates/sherlock-lfr/tests/i0_fixture.rs
new file mode 100644
index 0000000..ad703f1
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i0_fixture.rs
@@ -0,0 +1,39 @@
+//! I0 gate: the `L` fixture on disk decodes, the stock verifier accepts it, and a changed proof
+//! byte is refused. Needs the fixture (`cargo run --release --example l_fixture`); the test is
+//! ignored by default because it reads `~/.cache/e2-lfr/fixture`.
+
+#![allow(clippy::needless_range_loop)]
+
+use openvm_stark_backend::{codec::Decode, proof::Proof, StarkEngine};
+use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonCpuEngine;
+use sherlock_lfr::fixture::{self, l_ud, LSC};
+
+#[test]
+#[ignore = "needs the L fixture on disk"]
+fn i0_fixture_verifies_from_disk() {
+    let fx = fixture::load(&fixture::dir()).expect("load fixture");
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(l_ud(48));
+    engine
+        .verify(&fx.l_vk, &fx.l_proof)
+        .expect("L proof from disk verifies");
+    assert_eq!(fx.l_vk.inner.per_air.len(), 39);
+    // Byte flips at 8 spread positions: each is refused by the decoder or the verifier.
+    let b = &fx.l_proof_bytes;
+    let (mut dec, mut ver) = (0, 0);
+    for k in 0..8 {
+        let pos = 40 + k * (b.len() - 80) / 7;
+        let mut bad = b.clone();
+        bad[pos] ^= 0x01;
+        match Proof::<LSC>::decode_from_bytes(&bad) {
+            Err(_) => dec += 1,
+            Ok(p) => {
+                assert!(
+                    engine.verify(&fx.l_vk, &p).is_err(),
+                    "flip at {pos} accepted"
+                );
+                ver += 1;
+            }
+        }
+    }
+    println!("I0: L proof {} bytes verifies from disk; 8 of 8 byte flips refused ({dec} decoder, {ver} verifier)", b.len());
+}
diff --git a/crates/sherlock-lfr/tests/i2_alu.rs b/crates/sherlock-lfr/tests/i2_alu.rs
new file mode 100644
index 0000000..2f6721f
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i2_alu.rs
@@ -0,0 +1,197 @@
+//! I2 gate: `BbAlu` and `Range16` (BabyBear and `EF4` arithmetic emulated in Fr) prove and
+//! verify at the small Fr set with the stock verifier; the results equal p3 BabyBear and `EF4`;
+//! five invalid witnesses are refused.
+
+#![allow(clippy::needless_range_loop)]
+
+use std::sync::Arc;
+
+use openvm_stark_backend::AirRef;
+use p3_baby_bear::BabyBear;
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use sherlock_lfr::{
+    alu::{alu_trace, AluKind, AluOp, AluRow, BbAluAir, ALU_WIDTH},
+    bb::{from_ef4, to_ef4, P},
+    range::{Range16Air, RangeCounts},
+    testing::{prove_verify, small_params, Outcome, SC},
+};
+
+fn airs() -> Vec<AirRef<SC>> {
+    vec![Arc::new(BbAluAir), Arc::new(Range16Air)]
+}
+
+fn run(rows: &[AluRow]) -> Outcome {
+    let mut counts = RangeCounts::default();
+    let alu = alu_trace(rows, &mut counts);
+    prove_verify(small_params(3), airs(), vec![alu, counts.trace()])
+}
+
+fn ops(n: usize) -> Vec<AluOp> {
+    let mut rng = StdRng::seed_from_u64(0xe2_a1);
+    let mut v = vec![
+        // Edge cases: results p - 1 (the is_max branch), 0, and maximal inputs.
+        AluOp {
+            kind: AluKind::Add,
+            a: [P - 1, 0, 0, 0],
+            b: [0; 4],
+        },
+        AluOp {
+            kind: AluKind::Sub,
+            a: [0; 4],
+            b: [1, 0, 0, 0],
+        },
+        AluOp {
+            kind: AluKind::Add,
+            a: [P - 1; 4],
+            b: [1; 4],
+        },
+        AluOp {
+            kind: AluKind::Mul,
+            a: [P - 1; 4],
+            b: [P - 1; 4],
+        },
+        AluOp {
+            kind: AluKind::Sub,
+            a: [5; 4],
+            b: [5; 4],
+        },
+        AluOp {
+            kind: AluKind::Mul,
+            a: [0; 4],
+            b: [P - 1; 4],
+        },
+    ];
+    for i in 0..n {
+        let kind = [AluKind::Add, AluKind::Sub, AluKind::Mul][i % 3];
+        let bb_only = i % 4 == 0;
+        let mut g = || -> [u64; 4] {
+            std::array::from_fn(|k| {
+                if bb_only && k > 0 {
+                    0
+                } else {
+                    rng.random_range(0..P)
+                }
+            })
+        };
+        let (a, b) = (g(), g());
+        v.push(AluOp { kind, a, b });
+    }
+    v
+}
+
+#[test]
+fn i2_alu_results_equal_p3() {
+    for op in ops(3000) {
+        let (a, b) = (to_ef4(&op.a), to_ef4(&op.b));
+        let want = match op.kind {
+            AluKind::Add => a + b,
+            AluKind::Sub => a - b,
+            AluKind::Mul => a * b,
+        };
+        assert_eq!(op.result(), from_ef4(want), "{op:?}");
+        let row = AluRow::from_op(&op);
+        assert_eq!(row.c, op.result());
+        // BabyBear-only ops stay in the base field.
+        if op.a[1..] == [0; 3] && op.b[1..] == [0; 3] {
+            let (x, y) = (BabyBear::from_u64(op.a[0]), BabyBear::from_u64(op.b[0]));
+            let w = match op.kind {
+                AluKind::Add => x + y,
+                AluKind::Sub => x - y,
+                AluKind::Mul => x * y,
+            };
+            assert_eq!(from_ef4(to_ef4(&[0; 4]) + w)[0], op.result()[0]);
+            assert_eq!(op.result()[1..], [0; 3]);
+        }
+    }
+}
+
+#[test]
+fn i2_alu_honest_proves() {
+    let ops = ops(500);
+    let rows: Vec<AluRow> = ops.iter().map(AluRow::from_op).collect();
+    let out = run(&rows);
+    println!(
+        "I2 honest: {} ops ({} rows padded, {ALU_WIDTH} columns, 24 lookups per row): {out:?}",
+        rows.len(),
+        rows.len().next_power_of_two()
+    );
+    assert!(out.accepted(), "honest ALU trace refused: {out:?}");
+}
+
+/// The first mul row with `q_0 >= 1` and `c_0 + p < 2^31` (so `c_0 + p` has 16-bit limbs).
+fn pick(rows: &[AluRow]) -> usize {
+    rows.iter()
+        .position(|r| {
+            let q = r.ql[0][0] + (r.ql[0][1] << 16) + (r.ql[0][2] << 32);
+            r.sel[2] == 1 && q >= 1 && r.c[0] + P < (1 << 31) && r.hi[0] >= 1
+        })
+        .expect("a row for the negative controls")
+}
+
+fn set_c(r: &mut AluRow, k: usize, c: u64) {
+    r.c[k] = c;
+    r.lo[k] = c & 0xffff;
+    r.hi[k] = c >> 16;
+}
+
+fn set_q(r: &mut AluRow, k: usize, q: u64) {
+    r.ql[k] = [q & 0xffff, (q >> 16) & 0xffff, q >> 32];
+}
+
+fn q_of(r: &AluRow, k: usize) -> u64 {
+    r.ql[k][0] + (r.ql[k][1] << 16) + (r.ql[k][2] << 32)
+}
+
+#[test]
+fn i2_alu_negative_controls() {
+    let ops = ops(200);
+    let honest: Vec<AluRow> = ops.iter().map(AluRow::from_op).collect();
+    let i = pick(&honest);
+    let mut cases: Vec<(&str, Vec<AluRow>)> = vec![];
+
+    // 1. Non-canonical result c + p with q - 1: the integer identity holds, hi > 0x7800.
+    let mut r = honest.clone();
+    let (c, q) = (r[i].c[0], q_of(&r[i], 0));
+    set_c(&mut r[i], 0, c + P);
+    set_q(&mut r[i], 0, q - 1);
+    cases.push(("non-canonical c + p", r));
+
+    // 2. Wrong quotient q + 1.
+    let mut r = honest.clone();
+    set_q(&mut r[i], 0, q + 1);
+    cases.push(("wrong quotient", r));
+
+    // 3. Wrong result c + 1 (limbs consistent with it).
+    let mut r = honest.clone();
+    set_c(&mut r[i], 0, (c + 1) % P);
+    cases.push(("wrong result", r));
+
+    // 4. Limb out of range: lo + 2^16, hi - 1 (same c, so every identity holds).
+    let mut r = honest.clone();
+    r[i].lo[0] += 1 << 16;
+    r[i].hi[0] -= 1;
+    cases.push(("limb out of range", r));
+
+    // 5. The value p itself as a result: add(p - 1, 1) honestly gives q = 1, c = 0; the witness
+    // q = 0, c = p = 0x7800_0001 has 16-bit limbs (hi = 0x7800, lo = 1) and is refused only by
+    // the hi = 0x7800 -> lo = 0 rule.
+    let mut r = honest.clone();
+    r.push(AluRow::from_op(&AluOp {
+        kind: AluKind::Add,
+        a: [P - 1, 0, 0, 0],
+        b: [1, 0, 0, 0],
+    }));
+    let j = r.len() - 1;
+    assert_eq!((r[j].c[0], q_of(&r[j], 0)), (0, 1));
+    set_c(&mut r[j], 0, P);
+    set_q(&mut r[j], 0, 0);
+    assert_eq!((r[j].hi[0], r[j].lo[0]), (0x7800, 1));
+    cases.push(("c = p with 16-bit limbs", r));
+
+    for (name, rows) in cases {
+        let out = run(&rows);
+        println!("I2 negative {name}: {out:?}");
+        assert!(!out.accepted(), "{name} accepted");
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i3_poseidon.rs b/crates/sherlock-lfr/tests/i3_poseidon.rs
new file mode 100644
index 0000000..e4b9c8f
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i3_poseidon.rs
@@ -0,0 +1,115 @@
+//! I3 gate: the `PoseidonFr` AIR equals Midnight's permutation (midnight-circuits 7.3.0
+//! `permutation_cpu`, through `MidnightPoseidonFr`) and proves with the stock verifier; a changed
+//! output and a changed S-box cell are refused.
+
+#![allow(clippy::needless_range_loop)]
+
+use std::sync::Arc;
+
+use openvm_stark_backend::{p3_matrix::dense::RowMajorMatrix, p3_symmetric::Permutation, AirRef};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    cap_fixed, cap_var, Bls12381Fr, MidnightPoseidonFr,
+};
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use sherlock_lfr::{
+    poseidon::{
+        permute_trace, poseidon_row, poseidon_trace, PoseidonCallerAir, PoseidonFrAir,
+        CALLER_WIDTH, OUT, POSEIDON_WIDTH, SB,
+    },
+    testing::{prove_verify, small_params, Outcome, SC},
+};
+
+type Fr = Bls12381Fr;
+
+fn rand_fr(rng: &mut StdRng) -> Fr {
+    Fr::from_u64(rng.random::<u64>()) * Fr::from_u64(rng.random::<u64>())
+        + Fr::from_u64(rng.random::<u64>())
+}
+
+fn inputs() -> Vec<[Fr; 3]> {
+    let mut rng = StdRng::seed_from_u64(0xe2_a3);
+    let mut v = vec![
+        [Fr::ZERO; 3],
+        [Fr::ONE, Fr::TWO, Fr::from_u64(3)],
+        [-Fr::ONE; 3],
+        [Fr::ZERO, Fr::ZERO, cap_var(3)],
+        [Fr::ZERO, Fr::ZERO, cap_fixed(1, 36)],
+    ];
+    for _ in 0..59 {
+        v.push([rand_fr(&mut rng), rand_fr(&mut rng), rand_fr(&mut rng)]);
+    }
+    v
+}
+
+#[test]
+fn i3_poseidon_equals_midnight() {
+    let perm = MidnightPoseidonFr::new();
+    for inp in inputs() {
+        let mut want = inp;
+        perm.permute_mut(&mut want);
+        assert_eq!(permute_trace(inp).0, want);
+        let row = poseidon_row(inp, 1);
+        assert_eq!(row[OUT..OUT + 3], want);
+    }
+    assert_eq!(POSEIDON_WIDTH, 175);
+}
+
+fn caller_trace(ios: &[([Fr; 3], [Fr; 3])]) -> RowMajorMatrix<Fr> {
+    let h = ios.len().next_power_of_two().max(2);
+    let mut v = vec![Fr::ZERO; h * CALLER_WIDTH];
+    for (i, (a, b)) in ios.iter().enumerate() {
+        v[i * CALLER_WIDTH] = Fr::ONE;
+        v[i * CALLER_WIDTH + 1..i * CALLER_WIDTH + 4].copy_from_slice(a);
+        v[i * CALLER_WIDTH + 4..i * CALLER_WIDTH + 7].copy_from_slice(b);
+    }
+    RowMajorMatrix::new(v, CALLER_WIDTH)
+}
+
+fn airs() -> Vec<AirRef<SC>> {
+    vec![Arc::new(PoseidonFrAir), Arc::new(PoseidonCallerAir)]
+}
+
+fn run(rows: Vec<Vec<Fr>>, ios: &[([Fr; 3], [Fr; 3])]) -> Outcome {
+    prove_verify(
+        small_params(3),
+        airs(),
+        vec![poseidon_trace(rows), caller_trace(ios)],
+    )
+}
+
+#[test]
+fn i3_poseidon_proves_and_refuses() {
+    let ins = inputs();
+    let ios: Vec<([Fr; 3], [Fr; 3])> = ins.iter().map(|&a| (a, permute_trace(a).0)).collect();
+    let rows: Vec<Vec<Fr>> = ins.iter().map(|&a| poseidon_row(a, 1)).collect();
+    let out = run(rows.clone(), &ios);
+    println!(
+        "I3 honest: {} permutations, {POSEIDON_WIDTH} columns: {out:?}",
+        ins.len()
+    );
+    assert!(out.accepted(), "honest Poseidon trace refused: {out:?}");
+
+    // 1. Changed output in both the AIR row and the caller (the bus balances; the round
+    // constraints refuse).
+    let (mut r, mut io) = (rows.clone(), ios.clone());
+    r[7][OUT] += Fr::ONE;
+    io[7].1[0] += Fr::ONE;
+    let o1 = run(r, &io);
+    // 2. Changed output in the caller only (the bus refuses).
+    let mut io = ios.clone();
+    io[9].1[2] += Fr::ONE;
+    let o2 = run(rows.clone(), &io);
+    // 3. Changed S-box output cell y of a partial round.
+    let mut r = rows.clone();
+    r[11][SB + 2 * 40 + 1] += Fr::ONE;
+    let o3 = run(r, &ios);
+    for (name, o) in [
+        ("output in AIR and caller", o1),
+        ("output in caller only", o2),
+        ("partial S-box cell", o3),
+    ] {
+        println!("I3 negative {name}: {o:?}");
+        assert!(!o.accepted(), "{name} accepted");
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i4_tape.rs b/crates/sherlock-lfr/tests/i4_tape.rs
new file mode 100644
index 0000000..b6f1bda
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i4_tape.rs
@@ -0,0 +1,243 @@
+//! I4 gate: a fixed tape (Horner evaluation of an `EF4` polynomial, with a BabyBear constant)
+//! runs on `InputAir` + `BbAluProgAir` + `ProgramTable` + `Range16` over the write-once memory
+//! bus and proves with the stock verifier; a changed read value, a read of an unwritten address
+//! and a non-canonical input are refused. Program table (I5c): a changed program cell in an
+//! execution row and a forged write from padding rows are refused.
+
+#![allow(clippy::needless_range_loop)]
+
+use std::sync::Arc;
+
+use openvm_stark_backend::p3_matrix::dense::RowMajorMatrix;
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use sherlock_lfr::{
+    alu::{AluOp, AluRow, ALU_WIDTH},
+    bb::{from_ef4, to_ef4, Ef4, P},
+    machine::Machine,
+    program::PROG_BUS,
+    range::RangeCounts,
+    tape::{AluProg, BbAluProgAir, InputAir, InputProg, Op, Tape, ValKind, IN_WIDTH, MEM_BUS},
+    testing::{bus_balances, preprocessed_airs, prove_verify_range, small_params, Outcome},
+};
+
+const DEG: usize = 40;
+
+/// Horner: acc = c_DEG; acc = acc * x + c_i; then out = acc * 7 + x.
+fn horner_tape() -> (Tape, u32) {
+    let mut t = Tape::default();
+    let cs: Vec<u32> = (0..=DEG).map(|_| t.input(ValKind::Ef4)).collect();
+    let x = t.input(ValKind::Ef4);
+    let seven = t.constant(ValKind::Bb, [7, 0, 0, 0]);
+    let mut acc = cs[DEG];
+    for i in (0..DEG).rev() {
+        let m = t.mul(acc, x);
+        acc = t.add(m, cs[i]);
+    }
+    let m = t.mul(acc, seven);
+    let out = t.add(m, x);
+    let out = t.sub(out, seven);
+    (t, out)
+}
+
+fn inputs() -> Vec<[u64; 4]> {
+    let mut rng = StdRng::seed_from_u64(0xe2_a4);
+    (0..DEG + 2)
+        .map(|_| std::array::from_fn(|_| rng.random_range(0..P)))
+        .collect()
+}
+
+/// Values of the InputAir rows in program order (inputs and constants).
+fn input_rows(t: &Tape, mem: &[[u64; 4]], inp: &InputAir) -> Vec<[u64; 4]> {
+    let _ = t;
+    inp.prog.iter().map(|p| mem[p.addr as usize]).collect()
+}
+
+/// Prove the machine `m` (its key) on the given Input and ALU traces.
+fn run_traces(m: &Machine, ti: RowMajorMatrix<Fr>, ta: RowMajorMatrix<Fr>) -> Outcome {
+    let (o, vk) = prove_verify_range(small_params(3), m.airs(), vec![ti, ta, m.table().trace()]);
+    assert_eq!(
+        preprocessed_airs(&vk),
+        1,
+        "one preprocessed AIR (the program table)"
+    );
+    o
+}
+
+fn run(m: &Machine, in_vals: &[[u64; 4]], rows: &[AluRow]) -> Outcome {
+    let mut c = RangeCounts::default();
+    let ti = m.input.as_ref().unwrap().trace(in_vals, &mut c);
+    let ta = m.alu.as_ref().unwrap().trace(rows, &mut c);
+    run_traces(m, ti, ta)
+}
+
+#[test]
+fn i4_tape_executes_and_proves() {
+    let (t, out) = horner_tape();
+    let ins = inputs();
+    let mem = t.execute(&ins);
+    // Reference: p3 EF4 Horner.
+    let x = to_ef4(&ins[DEG + 1]);
+    let mut acc = to_ef4(&ins[DEG]);
+    for i in (0..DEG).rev() {
+        acc = acc * x + to_ef4(&ins[i]);
+    }
+    let seven = Ef4::from(p3_baby_bear::BabyBear::new(7));
+    assert_eq!(mem[out as usize], from_ef4(acc * seven + x - seven));
+
+    let m = Machine::new(&t);
+    let (inp, alu) = (m.input.clone().unwrap(), m.alu.clone().unwrap());
+    let in_vals = input_rows(&t, &mem, &inp);
+    let rows = alu.rows(&mem);
+    let o = run(&m, &in_vals, &rows);
+    println!(
+        "I4 honest: {} ops ({} inputs and constants, {} ALU rows), shape {:?}: {o:?}",
+        t.ops.len(),
+        inp.prog.len(),
+        rows.len(),
+        m.shape()
+    );
+    assert!(o.accepted(), "honest tape refused: {o:?}");
+    assert_eq!(o.commits(), Some(2), "commitments of the proof");
+
+    // 1. Changed read value: ALU row 5 uses a' = a + 1 (its own identities recomputed, so only
+    // the memory bus can refuse).
+    let mut r = rows.clone();
+    let p = &alu.prog[5];
+    let mut a = mem[p.a as usize];
+    a[0] = (a[0] + 1) % P;
+    r[5] = AluRow::from_op(&AluOp {
+        kind: p.kind,
+        a,
+        b: mem[p.b as usize],
+    });
+    let o1 = run(&m, &in_vals, &r);
+
+    // 2. A program that reads an address no op writes.
+    let mut prog = (*alu.prog).clone();
+    prog[3] = AluProg {
+        a: 100_000,
+        ..prog[3].clone()
+    };
+    let mut m2 = m.clone();
+    m2.alu = Some(BbAluProgAir {
+        prog: Arc::new(prog),
+    });
+    let o2 = run(&m2, &in_vals, &rows);
+
+    // 3. A non-canonical input coefficient v + p (< 2^31), used consistently by its readers.
+    let j = (0..DEG + 1)
+        .find(|&j| ins[j][0] + P < (1 << 31))
+        .expect("small coefficient");
+    let addr = inp.prog[j].addr;
+    let mut iv = in_vals.clone();
+    iv[j][0] += P;
+    let mut mem2 = mem.clone();
+    mem2[addr as usize][0] += P;
+    let r3: Vec<AluRow> = alu
+        .prog
+        .iter()
+        .map(|p| {
+            AluRow::from_op(&AluOp {
+                kind: p.kind,
+                a: mem2[p.a as usize],
+                b: mem2[p.b as usize],
+            })
+        })
+        .collect();
+    // Same results mod p, so every later value is unchanged.
+    for (x, y) in r3.iter().zip(&rows) {
+        assert_eq!(x.c, y.c);
+    }
+    let o3 = run(&m, &iv, &r3);
+
+    // 4. A changed program cell in an execution row, key unchanged: the result address of the
+    // last ALU row (read count 0, so the memory bus is unchanged; only the program bus refuses).
+    let last = alu
+        .prog
+        .iter()
+        .rposition(|p| p.mult == 0)
+        .expect("an unread result");
+    let mut c = RangeCounts::default();
+    let ti = inp.trace(&in_vals, &mut c);
+    let mut ta = alu.trace::<Fr>(&rows, &mut c);
+    let w = ta.width;
+    ta.values[last * w + ALU_WIDTH + 2] += Fr::from_u64(1000);
+    let t4 = vec![ti.clone(), ta.clone(), m.table().trace()];
+    let airs = m.airs();
+    assert!(bus_balances(small_params(3), &airs[..3], &t4, MEM_BUS));
+    assert!(!bus_balances(small_params(3), &airs[..3], &t4, PROG_BUS));
+    let o4 = run_traces(&m, ti, ta);
+
+    // 5. A forged write from two padding rows of InputAir, key unchanged: the constant 7 at
+    // address X (read k times) is read as 8. Padding row A writes (X, 8) with count k, padding
+    // row B takes (X, 7) with count -k, so the memory bus balances; the ALU rows are those of the
+    // tape with the constant 8. Only the program bus (padding rows must carry the nop row) can
+    // refuse.
+    let (x_addr, k) = inp
+        .prog
+        .iter()
+        .find(|p| p.konst == Some([7, 0, 0, 0]))
+        .map(|p| (p.addr, p.mult))
+        .expect("the constant 7");
+    let mut t8 = t.clone();
+    for op in &mut t8.ops {
+        if let Op::Const { val, out, .. } = op {
+            if *out == x_addr {
+                *val = [8, 0, 0, 0];
+            }
+        }
+    }
+    let mem8 = t8.execute(&ins);
+    assert_ne!(mem8[out as usize], mem[out as usize]);
+    let rows8 = alu.rows(&mem8);
+    let mut fprog = (*inp.prog).clone();
+    let extra = InputProg {
+        addr: x_addr,
+        mult: k,
+        bb: true,
+        konst: None,
+    };
+    fprog.push(extra.clone());
+    fprog.push(extra);
+    let forged = InputAir {
+        prog: Arc::new(fprog),
+    };
+    let mut fv = in_vals.clone();
+    fv.push([8, 0, 0, 0]);
+    fv.push([7, 0, 0, 0]);
+    let mut c = RangeCounts::default();
+    let mut ti = forged.trace::<Fr>(&fv, &mut c);
+    assert_eq!(
+        ti.values.len() / ti.width,
+        64,
+        "same height as the key's InputAir"
+    );
+    let w = ti.width;
+    let row_b = fv.len() - 1;
+    ti.values[row_b * w + IN_WIDTH + 1] = -Fr::from_u64(k);
+    let ta = alu.trace::<Fr>(&rows8, &mut c);
+    let t5 = vec![ti.clone(), ta.clone(), m.table().trace()];
+    let airs = m.airs();
+    assert!(
+        bus_balances(small_params(3), &airs[..3], &t5, MEM_BUS),
+        "the forge balances the memory bus"
+    );
+    assert!(
+        !bus_balances(small_params(3), &airs[..3], &t5, PROG_BUS),
+        "the forge breaks the program bus"
+    );
+    let o5 = run_traces(&m, ti, ta);
+
+    for (name, o) in [
+        ("changed read value", o1),
+        ("unwritten address", o2),
+        ("non-canonical input", o3),
+        ("changed program cell in an execution row", o4),
+        ("forged write from padding rows", o5),
+    ] {
+        println!("I4 negative {name}: {o:?}");
+        assert!(!o.accepted(), "{name} accepted");
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i5_l_transcript.rs b/crates/sherlock-lfr/tests/i5_l_transcript.rs
new file mode 100644
index 0000000..a8fa45d
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i5_l_transcript.rs
@@ -0,0 +1,126 @@
+//! I5b: the full transcript of the stock verifier on the real `L` proof, replayed on the tape.
+//!
+//! A recording wrapper around the stock `L` transcript logs every observe, commitment observe
+//! and sample while `verifier::verify` accepts the fixture. The log drives [`TapeTranscript`]
+//! (observed values as tape inputs); every sample on the tape equals the stock sample. The op
+//! counts of the `L` transcript are printed (MEASURED), and the tape proves on the machine AIRs
+//! with the stock verifier. Ignored by default: needs the fixture.
+
+use openvm_stark_backend::{verifier::verify, FiatShamirTranscript, StarkEngine};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::{
+        default_transcript, BabyBearBls12381PoseidonConfig, BabyBearBls12381PoseidonCpuEngine,
+        Bls12381Fr, Transcript,
+    },
+    bls12381_fr_poseidon::U_TRANSCRIPT,
+};
+use p3_baby_bear::BabyBear;
+use p3_field::PrimeField32;
+use sherlock_lfr::{
+    fixture::{self, l_ud},
+    machine::Machine,
+    tape::{Op, Tape, Val, ValKind},
+    testing::{preprocessed_airs, prove_verify_range, small_params},
+    transcript::TapeTranscript,
+};
+
+type Lsc = BabyBearBls12381PoseidonConfig;
+
+#[derive(Clone, Debug)]
+enum Ev {
+    Obs(BabyBear),
+    Commit(Bls12381Fr),
+    Sample(BabyBear),
+}
+
+#[derive(Clone)]
+struct Rec {
+    inner: Transcript,
+    log: std::sync::Arc<std::sync::Mutex<Vec<Ev>>>,
+}
+
+impl FiatShamirTranscript<Lsc> for Rec {
+    fn observe(&mut self, v: BabyBear) {
+        self.log.lock().unwrap().push(Ev::Obs(v));
+        FiatShamirTranscript::<Lsc>::observe(&mut self.inner, v);
+    }
+    fn sample(&mut self) -> BabyBear {
+        let v = FiatShamirTranscript::<Lsc>::sample(&mut self.inner);
+        self.log.lock().unwrap().push(Ev::Sample(v));
+        v
+    }
+    fn observe_commit(&mut self, d: [Bls12381Fr; 1]) {
+        self.log.lock().unwrap().push(Ev::Commit(d[0]));
+        FiatShamirTranscript::<Lsc>::observe_commit(&mut self.inner, d);
+    }
+}
+
+#[test]
+#[ignore = "needs the L fixture on disk"]
+fn i5_l_transcript_on_tape() {
+    let fx = fixture::load(&fixture::dir()).expect("fixture");
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(l_ud(48));
+    let mut rec = Rec {
+        inner: default_transcript(),
+        log: Default::default(),
+    };
+    verify(engine.config(), &fx.l_vk, &fx.l_proof, &mut rec).expect("L verifies");
+    let log = rec.log.lock().unwrap().clone();
+
+    let mut tape = Tape::default();
+    let mut tt = TapeTranscript::new(&mut tape, U_TRANSCRIPT);
+    let mut inputs = vec![];
+    let mut checks = vec![];
+    let (mut n_obs, mut n_commit, mut n_sample) = (0usize, 0usize, 0usize);
+    for e in &log {
+        match e {
+            Ev::Obs(v) => {
+                let a = tape.input(ValKind::Bb);
+                inputs.push(Val::Bb([v.as_canonical_u32() as u64, 0, 0, 0]));
+                tt.observe(&mut tape, a);
+                n_obs += 1;
+            }
+            Ev::Commit(d) => {
+                let a = tape.fr_input();
+                inputs.push(Val::Fr(*d));
+                tt.observe_commit(&mut tape, a);
+                n_commit += 1;
+            }
+            Ev::Sample(v) => {
+                checks.push((tt.sample(&mut tape), v.as_canonical_u32() as u64));
+                n_sample += 1;
+            }
+        }
+    }
+    let mem = tape.execute_vals(&inputs);
+    for (i, (a, want)) in checks.iter().enumerate() {
+        assert_eq!(mem[*a as usize].unwrap().bb()[0], *want, "sample {i}");
+    }
+    let count = |f: fn(&Op) -> bool| tape.ops.iter().filter(|o| f(o)).count();
+    let perms = count(|o| matches!(o, Op::Perm { .. }));
+    let packs = count(|o| matches!(o, Op::Pack { .. }));
+    let splits = count(|o| matches!(o, Op::Split { .. }));
+    println!(
+        "I5b L transcript: {} events: {n_obs} observes, {n_commit} commitment observes, {n_sample} samples; all samples equal on the tape; tape ops: {perms} Perm, {packs} Pack, {splits} Split; machine shape {:?}",
+        log.len(),
+        Machine::new(&tape).shape()
+    );
+    // Prove the transcript tape of the real L verification on the machine AIRs.
+    let m = Machine::new(&tape);
+    let t = std::time::Instant::now();
+    let (o, vk) = prove_verify_range(small_params(3), m.airs(), m.traces(&mem));
+    println!(
+        "I5b prove and verify {:.1}s: {o:?}; AIRs {:?}; AIRs with a preprocessed trace {}",
+        t.elapsed().as_secs_f64(),
+        m.names(),
+        preprocessed_airs(&vk)
+    );
+    assert!(o.accepted(), "L transcript tape refused: {o:?}");
+    // Owner ruling 2026-11-12: one shared program table, so 2 commitments.
+    assert_eq!(
+        preprocessed_airs(&vk),
+        1,
+        "only the program table is preprocessed"
+    );
+    assert_eq!(o.commits(), Some(2), "commitments of the L_Fr proof");
+}
diff --git a/crates/sherlock-lfr/tests/i5_transcript.rs b/crates/sherlock-lfr/tests/i5_transcript.rs
new file mode 100644
index 0000000..d0b74f2
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i5_transcript.rs
@@ -0,0 +1,209 @@
+//! I5 gate: the transcript of `L` on the tape. A random schedule of observes, commitment
+//! observes, samples and `EF4` observes and samples gives the same samples on the tape as the
+//! stock `L` transcript (`baby_bear_bls12381_poseidon::Transcript`, u = 3); the tape proves on the
+//! machine AIRs with the stock verifier; refused: the squeeze split witness of `x + r`, a changed
+//! digit, a changed packed word.
+
+#![allow(clippy::needless_range_loop)]
+
+use openvm_stark_backend::{p3_field::PrimeField, FiatShamirTranscript};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::{default_transcript, BabyBearBls12381PoseidonConfig, Bls12381Fr},
+    bls12381_fr_poseidon::U_TRANSCRIPT,
+};
+use p3_baby_bear::BabyBear;
+use p3_field::{BasedVectorSpace, Field, PrimeCharacteristicRing, PrimeField32};
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use sherlock_lfr::{
+    bb::{from_ef4, Ef4, P},
+    fr::{fr_from_big, split, split_consts},
+    machine::{Machine, SplitWitness},
+    tape::{Addr, Tape, Val, ValKind},
+    testing::{prove_verify_range, small_params},
+    transcript::TapeTranscript,
+};
+
+type Lsc = BabyBearBls12381PoseidonConfig;
+type Fr = Bls12381Fr;
+
+enum Step {
+    Obs(u64),
+    ObsExt([u64; 4]),
+    Commit(Fr),
+    Sample,
+    SampleExt,
+    /// Observe the last sampled word again (a read of a split digit).
+    ObsLastSample,
+}
+
+fn schedule(n: usize) -> Vec<Step> {
+    let mut rng = StdRng::seed_from_u64(0xe2_a5);
+    let mut v = vec![];
+    for _ in 0..n {
+        v.push(match rng.random_range(0..12) {
+            0..=3 => Step::Obs(rng.random_range(0..P)),
+            4 => Step::ObsExt(std::array::from_fn(|_| rng.random_range(0..P))),
+            5 => Step::Commit(
+                Fr::from_u64(rng.random()) * Fr::from_u64(rng.random())
+                    + Fr::from_u64(rng.random()),
+            ),
+            6..=8 => Step::Sample,
+            9 => Step::SampleExt,
+            10 => Step::ObsLastSample,
+            _ => Step::Obs(P - 1),
+        });
+    }
+    v
+}
+
+struct Built {
+    tape: Tape,
+    inputs: Vec<Val>,
+    /// (tape address, stock value) of every sample.
+    samples: Vec<(Addr, [u64; 4])>,
+}
+
+fn build(steps: &[Step]) -> Built {
+    let mut tape = Tape::default();
+    let mut tt = TapeTranscript::new(&mut tape, U_TRANSCRIPT);
+    let mut st = default_transcript();
+    let mut inputs = vec![];
+    let mut samples = vec![];
+    let mut last: Option<(Addr, u64)> = None;
+    for s in steps {
+        match s {
+            Step::Obs(w) => {
+                let a = tape.input(ValKind::Bb);
+                inputs.push(Val::Bb([*w, 0, 0, 0]));
+                tt.observe(&mut tape, a);
+                FiatShamirTranscript::<Lsc>::observe(&mut st, BabyBear::from_u64(*w));
+            }
+            Step::ObsExt(v) => {
+                let a = tape.input(ValKind::Ef4);
+                inputs.push(Val::Bb(*v));
+                tt.observe_ext(&mut tape, a);
+                let e = Ef4::from_basis_coefficients_fn(|i| BabyBear::from_u64(v[i]));
+                FiatShamirTranscript::<Lsc>::observe_ext(&mut st, e);
+            }
+            Step::Commit(d) => {
+                let a = tape.fr_input();
+                inputs.push(Val::Fr(*d));
+                tt.observe_commit(&mut tape, a);
+                FiatShamirTranscript::<Lsc>::observe_commit(&mut st, [*d]);
+            }
+            Step::Sample => {
+                let a = tt.sample(&mut tape);
+                let v = FiatShamirTranscript::<Lsc>::sample(&mut st).as_canonical_u32() as u64;
+                samples.push((a, [v, 0, 0, 0]));
+                last = Some((a, v));
+            }
+            Step::SampleExt => {
+                let a = tt.sample_ext(&mut tape);
+                let v = FiatShamirTranscript::<Lsc>::sample_ext(&mut st);
+                samples.push((a, from_ef4(v)));
+            }
+            Step::ObsLastSample => {
+                if let Some((a, v)) = last {
+                    tt.observe(&mut tape, a);
+                    FiatShamirTranscript::<Lsc>::observe(&mut st, BabyBear::from_u64(v));
+                }
+            }
+        }
+    }
+    // A final sample, so the schedule ends on a squeeze.
+    let a = tt.sample(&mut tape);
+    samples.push((
+        a,
+        [
+            FiatShamirTranscript::<Lsc>::sample(&mut st).as_canonical_u32() as u64,
+            0,
+            0,
+            0,
+        ],
+    ));
+    Built {
+        tape,
+        inputs,
+        samples,
+    }
+}
+
+#[test]
+fn i5_transcript_equals_stock_and_proves() {
+    let b = build(&schedule(400));
+    let mem = b.tape.execute_vals(&b.inputs);
+    for (i, (a, want)) in b.samples.iter().enumerate() {
+        assert_eq!(mem[*a as usize].unwrap().bb(), *want, "sample {i}");
+    }
+    let m = Machine::new(&b.tape);
+    println!(
+        "I5: {} samples equal the stock transcript; machine shape {:?}",
+        b.samples.len(),
+        m.shape()
+    );
+    let traces = m.traces(&mem);
+    let (o, _) = prove_verify_range(small_params(3), m.airs(), traces.clone());
+    println!("I5 honest: {o:?}");
+    assert!(o.accepted(), "honest transcript tape refused: {o:?}");
+    assert_eq!(o.commits(), Some(2), "commitments of the proof");
+
+    let names = m.names();
+    let si = names.iter().position(|n| *n == "Split").unwrap();
+    let pi = names.iter().position(|n| *n == "Pack").unwrap();
+    let split_air = m.split.as_ref().unwrap();
+    let reads = b.tape.reads();
+    // A split whose digits nobody reads, so only its own constraints can refuse a tamper.
+    let j = split_air
+        .prog
+        .iter()
+        .position(|p| p.mults == [0; 5])
+        .expect("an unread split");
+
+    // 1. The split witness of x + r: digits and high part of the integer x + r.
+    let mut ws = split_air.witnesses(&mem);
+    let x = ws[j].x;
+    let xr = x.as_canonical_biguint() + Fr::order();
+    let p = num_bigint::BigUint::from(P);
+    let mut v = xr.clone();
+    let d: [u64; 5] = std::array::from_fn(|_| {
+        let r = (&v % &p).to_u64_digits().first().copied().unwrap_or(0);
+        v /= &p;
+        r
+    });
+    let c = split_consts();
+    let low: num_bigint::BigUint = (0..5)
+        .map(|i| num_bigint::BigUint::from(d[i]) * &c.p_pow[i])
+        .sum();
+    assert_eq!(
+        fr_from_big(&(low % Fr::order()))
+            + fr_from_big(&(&v % Fr::order())) * fr_from_big(&c.p_pow[5]),
+        x,
+        "x + r split holds in Fr"
+    );
+    assert_ne!(d, split(x).0, "x + r gives other digits");
+    ws[j] = SplitWitness { x, d, h: v };
+    let mut t1 = traces.clone();
+    t1[si] = split_air.trace_from(&ws);
+    let (o1, _) = prove_verify_range(small_params(3), m.airs(), t1);
+
+    // 2. A changed digit (d_0 + 1), the other cells honest.
+    let mut ws = split_air.witnesses(&mem);
+    ws[j].d[0] = (ws[j].d[0] + 1) % P;
+    let mut t2 = traces.clone();
+    t2[si] = split_air.trace_from(&ws);
+    let (o2, _) = prove_verify_range(small_params(3), m.airs(), t2);
+
+    // 3. A changed packed word in the Pack row (cell 0 of row 0).
+    let mut t3 = traces.clone();
+    t3[pi].values[0] += Fr::ONE;
+    let (o3, _) = prove_verify_range(small_params(3), m.airs(), t3);
+    let _ = reads;
+    for (name, o) in [
+        ("split of x + r", o1),
+        ("changed digit", o2),
+        ("changed packed word", o3),
+    ] {
+        println!("I5 negative {name}: {o:?}");
+        assert!(!o.accepted(), "{name} accepted");
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i6_part1.rs b/crates/sherlock-lfr/tests/i6_part1.rs
new file mode 100644
index 0000000..5c1ae3b
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i6_part1.rs
@@ -0,0 +1,150 @@
+//! I6 gate: the tape generator, part 1 (shape pin, preamble, LogUp PoW, LogUp GKR, the GKR
+//! claim checks) on the real `L` proof. Every value the tape observes or samples equals the
+//! stock verifier's transcript record, in order, up to the sample of `mu` (step 4 of
+//! `batch_constraints.rs`, where I7 starts). No tape assertion fails. Op counts and the machine
+//! shape are printed (MEASURED); the tape proves on the machine with 2 commitments. Refused: a
+//! changed GKR layer claim and a changed LogUp PoW witness (by the stock verifier, by the
+//! plain-Rust tape run, and by the prover). Ignored by default: needs the fixture.
+
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use sherlock_lfr::{
+    bb::Ef4,
+    fixture::{self, LSC},
+    lverify::{gen_part1, Gen, LShape},
+    machine::Machine,
+    record::{stock_log, Ev},
+    tape::Op,
+    testing::{preprocessed_airs, prove_verify_range, small_params, Outcome},
+    transcript::TEv,
+};
+
+type LProof = openvm_stark_backend::proof::Proof<LSC>;
+
+fn build(
+    vk: &openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &LProof,
+) -> Gen {
+    let mut g = Gen::new();
+    gen_part1(&mut g, vk, shape, proof).expect("pinned shape");
+    g
+}
+
+fn prove(g: &Gen, mem: &[Option<sherlock_lfr::tape::Val>]) -> Outcome {
+    let m = Machine::new(&g.tape);
+    let (o, vk) = prove_verify_range(small_params(3), m.airs(), m.traces(mem));
+    assert_eq!(
+        preprocessed_airs(&vk),
+        1,
+        "only the program table is preprocessed"
+    );
+    o
+}
+
+#[test]
+#[ignore = "needs the L fixture on disk"]
+fn i6_part1_on_real_l() {
+    let fx = fixture::load(&fixture::dir()).expect("fixture");
+    let (log, ok) = stock_log(&fx.l_vk, &fx.l_proof);
+    assert!(ok, "stock verifier accepts L");
+    let shape = LShape::of(&fx.l_proof);
+    let g = build(&fx.l_vk, &shape, &fx.l_proof);
+    let part1 = gen_part1(&mut Gen::new(), &fx.l_vk, &shape, &fx.l_proof).unwrap();
+    println!(
+        "I6 L shape: {} AIRs, {} present, log heights {:?}; n_logup {}, GKR rounds {}, n_global {}",
+        shape.log_heights.len(),
+        shape.trace_order().len(),
+        shape.log_heights,
+        part1.n_logup,
+        part1.xi.len() - (part1.n_global - part1.n_logup),
+        part1.n_global
+    );
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed: {failed:?}");
+
+    // Every event equals the stock record, in order.
+    let bb = |a: u32| mem[a as usize].unwrap().bb();
+    let (mut n_obs, mut n_commit, mut n_sample) = (0, 0, 0);
+    assert!(g.tt.log.len() < log.len());
+    for (i, (t, s)) in g.tt.log.iter().zip(&log).enumerate() {
+        match (t, s) {
+            (TEv::Obs(a), Ev::Obs(v)) => {
+                assert_eq!(
+                    bb(*a),
+                    [v.as_canonical_u32() as u64, 0, 0, 0],
+                    "observe {i}"
+                );
+                n_obs += 1;
+            }
+            (TEv::Commit(a), Ev::Commit(v)) => {
+                assert_eq!(mem[*a as usize].unwrap().fr(), *v, "commit {i}");
+                n_commit += 1;
+            }
+            (TEv::Sample(a), Ev::Sample(v)) => {
+                assert_eq!(bb(*a), [v.as_canonical_u32() as u64, 0, 0, 0], "sample {i}");
+                n_sample += 1;
+            }
+            _ => panic!("event {i}: kind differs: tape {t:?}, stock {s:?}"),
+        }
+    }
+    // The next stock event is the first sample of mu (I7 starts there).
+    assert!(matches!(log[g.tt.log.len()], Ev::Sample(_)));
+
+    let count = |f: fn(&Op) -> bool| g.tape.ops.iter().filter(|o| f(o)).count();
+    let m = Machine::new(&g.tape);
+    println!(
+        "I6 part 1: {} events equal the stock record ({n_obs} observes, {n_commit} commitment observes, {n_sample} samples) of {} in one L verification; ops: {} total, {} Input, {} FrInput, {} Const/FrConst, {} Alu, {} Perm, {} Pack, {} Split, {} Compose, {} Decompose, {} AssertEq, {} LowBits; table rows {}; machine shape {:?}",
+        g.tt.log.len(),
+        log.len(),
+        g.tape.ops.len(),
+        count(|o| matches!(o, Op::Input { .. })),
+        count(|o| matches!(o, Op::FrInput { .. })),
+        count(|o| matches!(o, Op::Const { .. } | Op::FrConst { .. })),
+        count(|o| matches!(o, Op::Alu { .. })),
+        count(|o| matches!(o, Op::Perm { .. })),
+        count(|o| matches!(o, Op::Pack { .. })),
+        count(|o| matches!(o, Op::Split { .. })),
+        count(|o| matches!(o, Op::Compose { .. })),
+        count(|o| matches!(o, Op::Decompose { .. })),
+        count(|o| matches!(o, Op::AssertEq { .. })),
+        count(|o| matches!(o, Op::LowBits { .. })),
+        m.table().rows.len(),
+        m.shape()
+    );
+    let t = std::time::Instant::now();
+    let o = prove(&g, &mem);
+    println!(
+        "I6 prove and verify {:.1}s: {o:?}",
+        t.elapsed().as_secs_f64()
+    );
+    assert!(o.accepted(), "honest part 1 refused: {o:?}");
+    assert_eq!(o.commits(), Some(2));
+
+    // Negative controls: the same key (shape and vk), changed proof values.
+    let mut p1 = fx.l_proof.clone();
+    p1.gkr_proof.claims_per_layer[5].p_xi_0 += Ef4::ONE;
+    let mut p2 = fx.l_proof.clone();
+    p2.gkr_proof.logup_pow_witness += p3_baby_bear::BabyBear::ONE;
+    for (name, p) in [
+        ("changed GKR layer claim", p1),
+        ("changed LogUp PoW witness", p2),
+    ] {
+        let (_, stock_ok) = stock_log(&fx.l_vk, &p);
+        let gt = build(&fx.l_vk, &shape, &p);
+        assert_eq!(
+            format!("{:?}", gt.tape.ops),
+            format!("{:?}", g.tape.ops),
+            "same tape (the key)"
+        );
+        let (mem_t, failed_t) = gt.tape.execute_checked(&gt.inputs);
+        let o = prove(&gt, &mem_t);
+        println!(
+            "I6 negative {name}: stock verifier accepts {stock_ok}; tape assertions failed at {} ops (first {:?}); prover: {o:?}",
+            failed_t.len(),
+            failed_t.first()
+        );
+        assert!(!stock_ok);
+        assert!(!failed_t.is_empty());
+        assert!(!o.accepted(), "{name} accepted");
