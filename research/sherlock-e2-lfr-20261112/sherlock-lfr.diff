+[package]
+name = "sherlock-lfr"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+description = "Sherlock E2: the Fr recursion AIR set L_Fr that verifies one L proof"
+
+[dependencies]
+openvm-stark-backend = { workspace = true }
+openvm-stark-sdk = { workspace = true, features = ["cpu-backend", "bls12381-fr-poseidon"] }
+openvm-cpu-backend = { workspace = true }
+p3-baby-bear = { workspace = true }
+p3-field = { workspace = true }
+itertools = { workspace = true }
+num-bigint = { workspace = true }
+rand = { workspace = true, features = ["std", "std_rng"] }
+serde_json = { workspace = true }
+bitcode = { workspace = true }
+midnight-circuits = { version = "=7.3.0", default-features = false }
+# fixtures: the bench chain W1 -> node -> L (examples and tests)
+openvm-recursion-circuit = { workspace = true }
+openvm-poseidon2-air = { workspace = true }
+
+[features]
+default = ["parallel"]
+parallel = [
+  "openvm-stark-backend/parallel",
+  "openvm-stark-sdk/parallel",
+  "openvm-cpu-backend/parallel",
+  "openvm-recursion-circuit/parallel",
+  "openvm-poseidon2-air/parallel",
+]
diff --git a/crates/sherlock-lfr/examples/l_fixture.rs b/crates/sherlock-lfr/examples/l_fixture.rs
new file mode 100644
index 0000000..7191ea9
--- /dev/null
+++ b/crates/sherlock-lfr/examples/l_fixture.rs
@@ -0,0 +1,170 @@
+//! I0: make the real `L` proof (M7 `l_fr.rs` chain, OD-19 sets) and write it to the fixture
+//! directory with the `L` vk and the node vk. Then re-read the files and verify the proof from
+//! disk with the stock verifier. Prints one JSON object on stdout.
+//!
+//! Usage: `l_fixture` (directory `$E2_FIXTURE_DIR` or `~/.cache/e2-lfr/fixture`).
+
+use std::{sync::Arc, time::Instant};
+
+use openvm_cpu_backend::CpuBackend;
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{
+    AggregationSubCircuit, CachedTraceCtx, VerifierConfig, VerifierSubCircuit, VerifierTraceGen,
+};
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    p3_field::PrimeCharacteristicRing,
+    proof::Proof,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, StarkEngine,
+};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonCpuEngine,
+    baby_bear_poseidon2::{
+        default_duplex_sponge_recorder, BabyBearPoseidon2CpuEngine, DuplexSponge,
+        DuplexSpongeRecorder,
+    },
+    MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use serde_json::json;
+use sherlock_lfr::fixture::{self, internal_ud, l_ud, NodeSC, LSC};
+
+type F = BabyBear;
+type Eng = BabyBearPoseidon2CpuEngine<DuplexSponge>;
+type RootEng = BabyBearBls12381PoseidonCpuEngine;
+
+fn w1_proofs(n: usize, log_rows: usize) -> (MultiStarkVerifyingKey<NodeSC>, Vec<Proof<NodeSC>>) {
+    let mut rng = StdRng::seed_from_u64(0x5e7_10c);
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let airs: Vec<AirRef<NodeSC>> = vec![chip.air.clone()];
+    let engine = Eng::new(app_params_with_100_bits_security(
+        MAX_APP_LOG_STACKED_HEIGHT,
+    ));
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let mut proofs = vec![];
+    for _ in 0..n {
+        let inputs: Vec<[F; 16]> = (0..1usize << log_rows)
+            .map(|_| std::array::from_fn(|_| F::from_u32(rng.random::<u32>() % (1 << 30))))
+            .collect();
+        let trace = chip.generate_trace(inputs);
+        let cm = ColMajorMatrix::from_row_major(&trace);
+        let ctx = ProvingContext::new(vec![(
+            0,
+            AirProvingContext::simple_no_pis(engine.device().transport_matrix_to_device(&cm)),
+        )]);
+        let proof = engine.prove(&d_pk, ctx).expect("w1 prove");
+        engine.verify(&vk, &proof).expect("w1 verify");
+        proofs.push(proof);
+    }
+    (vk, proofs)
+}
+
+fn node_proof(
+    child_vk: &MultiStarkVerifyingKey<NodeSC>,
+    proofs: &[Proof<NodeSC>],
+) -> (MultiStarkVerifyingKey<NodeSC>, Proof<NodeSC>) {
+    let engine = Eng::new(internal_ud());
+    let circuit = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(
+        Arc::new(child_vk.clone()),
+        Default::default(),
+    );
+    let child_pcs = circuit.commit_child_vk(&engine, child_vk);
+    let airs = circuit.airs::<NodeSC>();
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctxs = circuit.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        child_vk,
+        CachedTraceCtx::PcsData(child_pcs),
+        proofs,
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    let proof = engine
+        .prove(
+            &d_pk,
+            ProvingContext::new(ctxs.into_iter().enumerate().collect()),
+        )
+        .expect("node prove");
+    engine.verify(&vk, &proof).expect("node verify");
+    (vk, proof)
+}
+
+fn main() {
+    let t0 = Instant::now();
+    let (w1_vk, proofs) = w1_proofs(2, 20);
+    let (node_vk, node_pf) = node_proof(&w1_vk, &proofs);
+    drop(proofs);
+    eprintln!("node proof done {:.1}s", t0.elapsed().as_secs_f64());
+    let node_vk = Arc::new(node_vk);
+
+    let engine = RootEng::new(l_ud(48));
+    let cfg = VerifierConfig {
+        has_cached: true,
+        ..Default::default()
+    };
+    let l = <VerifierSubCircuit<1> as VerifierTraceGen<CpuBackend<LSC>, LSC, ()>>::new(
+        node_vk.clone(),
+        cfg,
+    );
+    let airs = AggregationSubCircuit::airs::<LSC>(&l);
+    let (pk, l_vk) = engine.keygen(&airs);
+    let cached = CachedTraceCtx::PcsData(l.commit_child_vk(&engine, &node_vk));
+    let ctxs = l.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        &node_vk,
+        cached,
+        std::slice::from_ref(&node_pf),
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let t = Instant::now();
+    let l_proof = engine
+        .prove(
+            &d_pk,
+            ProvingContext::new(ctxs.into_iter().enumerate().collect()),
+        )
+        .expect("L prove");
+    let prove_s = t.elapsed().as_secs_f64();
+    engine.verify(&l_vk, &l_proof).expect("L verify");
+    eprintln!("L prove {prove_s:.1}s");
+
+    let d = fixture::dir();
+    let nbytes = fixture::write(&d, &l_vk, &l_proof, &node_vk).expect("write fixture");
+
+    // Re-read from disk and verify with the stock verifier.
+    let fx = fixture::load(&d).expect("load fixture");
+    let t = Instant::now();
+    let ok = engine.verify(&fx.l_vk, &fx.l_proof);
+    let verify_s = t.elapsed().as_secs_f64();
+    assert!(ok.is_ok(), "L proof from disk refused: {ok:?}");
+    let lh: Vec<Option<usize>> = fx
+        .l_proof
+        .trace_vdata
+        .iter()
+        .map(|v| v.as_ref().map(|v| v.log_height))
+        .collect();
+    let out = json!({
+        "dir": d.display().to_string(),
+        "l_proof_bytes": nbytes,
+        "l_vk_bytes": std::fs::metadata(d.join(fixture::L_VK)).map(|m| m.len()).unwrap_or(0),
+        "node_vk_bytes": std::fs::metadata(d.join(fixture::NODE_VK)).map(|m| m.len()).unwrap_or(0),
+        "l_num_airs": fx.l_vk.inner.per_air.len(),
+        "l_log_heights": lh,
+        "l_pre_hash": format!("{:?}", fx.l_vk.pre_hash),
+        "l_prove_s": prove_s,
+        "l_verify_from_disk_s": verify_s,
+        "verify_from_disk_ok": true,
+        "wall_s": t0.elapsed().as_secs_f64(),
+        "rayon_threads": std::env::var("RAYON_NUM_THREADS").ok(),
+    });
+    std::fs::write(
+        d.join(fixture::L_JSON),
+        serde_json::to_string_pretty(&out).unwrap(),
+    )
+    .expect("write json");
+    println!("{}", serde_json::to_string(&out).unwrap());
+}
diff --git a/crates/sherlock-lfr/src/alu.rs b/crates/sherlock-lfr/src/alu.rs
new file mode 100644
index 0000000..263ffa0
--- /dev/null
+++ b/crates/sherlock-lfr/src/alu.rs
@@ -0,0 +1,275 @@
+//! `BbAlu`: BabyBear and `EF4` add, sub and mul emulated in Fr, one op per row.
+//!
+//! Every value is a canonical BabyBear representative in `[0, p)` held in one Fr cell; an `EF4`
+//! value is 4 cells. A row computes `c = a op b` coefficient-wise as the Fr identity
+//!
+//! ```text
+//! e_k(a, b) = q_k * p + c_k,     q_k = l0 + 2^16 l1 + 2^32 l2,     c_k = lo + 2^16 hi
+//! ```
+//!
+//! with `e_k = a_k + b_k` (add), `a_k - b_k + p` (sub), or the `k`-th coefficient of the
+//! convolution of `a` and `b` reduced by `x^4 = 11` (mul). A BabyBear op is an `EF4` op whose
+//! inputs have zero coefficients 1 to 3.
+//!
+//! **Why the Fr identity is an integer identity.** For canonical inputs, `0 <= e_k < 34 p^2 <
+//! 2^68`. The 16-bit lookups give `q_k < 2^48` and `c_k < 2^32`, so `q_k p + c_k < 2^80`. Both
+//! sides are integers below the Fr modulus `r > 2^254`, so equality mod `r` is equality of
+//! integers. **Why `c_k` is canonical.** `lo`, `hi` and `0x7800 - hi` are each in `[0, 2^16)`,
+//! so `hi <= 0x7800`; and `hi = 0x7800` forces `lo = 0` (an is-zero gadget on `hi - 0x7800`).
+//! So `c_k <= 0x7800_0000 = p - 1`. With `c_k < p` and the integer identity, `c_k = e_k mod p`
+//! is unique; the quotient is then unique too.
+//!
+//! Columns per row (43): selectors `add, sub, mul`; `a[4], b[4], c[4]`; `q` limbs `[4][3]`;
+//! `lo[4], hi[4]`; `inv[4], is_max[4]`. 24 lookups on [`RANGE_BUS`] per row (count 1, so padding
+//! rows look up their zeros and `0x7800` too). Constraint degree 3.
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bb::{ef4_mul_unreduced, P, P_MINUS_1_HI, W},
+    range::{RangeCounts, RANGE_BUS},
+};
+
+pub const SEL_ADD: usize = 0;
+pub const SEL_SUB: usize = 1;
+pub const SEL_MUL: usize = 2;
+pub const A: usize = 3;
+pub const B: usize = A + 4;
+pub const C: usize = B + 4;
+pub const QL: usize = C + 4;
+pub const LO: usize = QL + 12;
+pub const HI: usize = LO + 4;
+pub const INV: usize = HI + 4;
+pub const IS_MAX: usize = INV + 4;
+pub const ALU_WIDTH: usize = IS_MAX + 4;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AluKind {
+    Add,
+    Sub,
+    Mul,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct AluOp {
+    pub kind: AluKind,
+    pub a: [u64; 4],
+    pub b: [u64; 4],
+}
+
+impl AluOp {
+    /// The unreduced integers `e_k`.
+    pub fn unreduced(&self) -> [u128; 4] {
+        match self.kind {
+            AluKind::Add => std::array::from_fn(|k| (self.a[k] + self.b[k]) as u128),
+            AluKind::Sub => std::array::from_fn(|k| (self.a[k] + P - self.b[k]) as u128),
+            AluKind::Mul => ef4_mul_unreduced(&self.a, &self.b),
+        }
+    }
+
+    pub fn result(&self) -> [u64; 4] {
+        let e = self.unreduced();
+        std::array::from_fn(|k| (e[k] % P as u128) as u64)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct BbAluAir;
+
+impl<F> BaseAir<F> for BbAluAir {
+    fn width(&self) -> usize {
+        ALU_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for BbAluAir {}
+impl<F> PartitionedBaseAir<F> for BbAluAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for BbAluAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x = |i: usize| -> AB::Expr { r[i].into() };
+        let c = AB::Expr::from_u64;
+        let (add, sub, mul) = (x(SEL_ADD), x(SEL_SUB), x(SEL_MUL));
+        builder.assert_bool(add.clone());
+        builder.assert_bool(sub.clone());
+        builder.assert_bool(mul.clone());
+        builder.assert_bool(add.clone() + sub.clone() + mul.clone());
+
+        let a: [AB::Expr; 4] = std::array::from_fn(|k| x(A + k));
+        let b: [AB::Expr; 4] = std::array::from_fn(|k| x(B + k));
+        for k in 0..4 {
+            // Convolution coefficient k, reduced by x^4 = W.
+            let mut conv = AB::Expr::ZERO;
+            for i in 0..4 {
+                for j in 0..4 {
+                    if i + j == k {
+                        conv += a[i].clone() * b[j].clone();
+                    } else if i + j == k + 4 {
+                        conv += a[i].clone() * b[j].clone() * c(W);
+                    }
+                }
+            }
+            let e = add.clone() * (a[k].clone() + b[k].clone())
+                + sub.clone() * (a[k].clone() - b[k].clone() + c(P))
+                + mul.clone() * conv;
+            let q = x(QL + 3 * k) + x(QL + 3 * k + 1) * c(1 << 16) + x(QL + 3 * k + 2) * c(1 << 32);
+            let ck = x(C + k);
+            builder.assert_eq(e, q * c(P) + ck.clone());
+            eval_canonical(builder, ck, x(LO + k), x(HI + k), x(INV + k), x(IS_MAX + k));
+            for l in 0..3 {
+                builder.push_interaction(RANGE_BUS, [x(QL + 3 * k + l)], AB::Expr::ONE, 1);
+            }
+        }
+    }
+}
+
+/// `c = lo + 2^16 hi` with `c < p`: `lo`, `hi` and `0x7800 - hi` are 16-bit lookups (count 1),
+/// `hi = 0x7800 -> lo = 0` through the is-zero gadget `is_max = 1 - (hi - 0x7800) inv`.
+pub fn eval_canonical<AB: InteractionBuilder>(
+    builder: &mut AB,
+    c: AB::Expr,
+    lo: AB::Expr,
+    hi: AB::Expr,
+    inv: AB::Expr,
+    is_max: AB::Expr,
+) {
+    let k = AB::Expr::from_u64;
+    builder.assert_eq(c, lo.clone() + hi.clone() * k(1 << 16));
+    let z = hi.clone() - k(P_MINUS_1_HI);
+    builder.assert_eq(is_max.clone(), AB::Expr::ONE - z.clone() * inv);
+    builder.assert_zero(z * is_max.clone());
+    builder.assert_zero(is_max * lo.clone());
+    builder.push_interaction(RANGE_BUS, [lo], AB::Expr::ONE, 1);
+    builder.push_interaction(RANGE_BUS, [hi.clone()], AB::Expr::ONE, 1);
+    builder.push_interaction(RANGE_BUS, [k(P_MINUS_1_HI) - hi], AB::Expr::ONE, 1);
+}
+
+/// Witness cells `(lo, hi, inv, is_max)` of the canonical gadget for an integer `c < 2^32`.
+pub fn canonical_cells<F: Field>(c: u64) -> [F; 4] {
+    let (lo, hi) = (c & 0xffff, c >> 16);
+    let z = F::from_u64(hi) - F::from_u64(P_MINUS_1_HI);
+    let (inv, is_max) = if z.is_zero() {
+        (F::ZERO, F::ONE)
+    } else {
+        (z.inverse(), F::ZERO)
+    };
+    [F::from_u64(lo), F::from_u64(hi), inv, is_max]
+}
+
+/// One ALU row as integers (before conversion to field cells). Tests change these to build
+/// invalid witnesses.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AluRow {
+    pub sel: [u64; 3],
+    pub a: [u64; 4],
+    pub b: [u64; 4],
+    pub c: [u64; 4],
+    pub ql: [[u64; 3]; 4],
+    pub lo: [u64; 4],
+    pub hi: [u64; 4],
+}
+
+impl AluRow {
+    pub fn padding() -> Self {
+        Self {
+            sel: [0; 3],
+            a: [0; 4],
+            b: [0; 4],
+            c: [0; 4],
+            ql: [[0; 3]; 4],
+            lo: [0; 4],
+            hi: [0; 4],
+        }
+    }
+
+    /// The honest row of an op.
+    pub fn from_op(op: &AluOp) -> Self {
+        let e = op.unreduced();
+        let mut row = Self::padding();
+        row.sel = match op.kind {
+            AluKind::Add => [1, 0, 0],
+            AluKind::Sub => [0, 1, 0],
+            AluKind::Mul => [0, 0, 1],
+        };
+        row.a = op.a;
+        row.b = op.b;
+        for k in 0..4 {
+            let q = (e[k] / P as u128) as u64;
+            let ck = (e[k] % P as u128) as u64;
+            row.c[k] = ck;
+            row.ql[k] = [q & 0xffff, (q >> 16) & 0xffff, q >> 32];
+            row.lo[k] = ck & 0xffff;
+            row.hi[k] = ck >> 16;
+        }
+        row
+    }
+
+    /// Cells of the row; `inv` and `is_max` are derived from `hi`. A limb that does not fit is
+    /// written as is (the lookup then fails).
+    pub fn cells<F: Field>(&self) -> Vec<F> {
+        let mut v = vec![F::ZERO; ALU_WIDTH];
+        let f = |x: u64| F::from_u64(x);
+        for i in 0..3 {
+            v[SEL_ADD + i] = f(self.sel[i]);
+        }
+        for k in 0..4 {
+            v[A + k] = f(self.a[k]);
+            v[B + k] = f(self.b[k]);
+            v[C + k] = f(self.c[k]);
+            for l in 0..3 {
+                v[QL + 3 * k + l] = f(self.ql[k][l]);
+            }
+            v[LO + k] = f(self.lo[k]);
+            v[HI + k] = f(self.hi[k]);
+            let z = f(self.hi[k]) - f(P_MINUS_1_HI);
+            if z.is_zero() {
+                v[IS_MAX + k] = F::ONE;
+            } else {
+                v[INV + k] = z.inverse();
+            }
+        }
+        v
+    }
+
+    /// The 24 range lookups of the row, in [`BbAluAir`] order. The values are field elements
+    /// mapped back to `u64` only when they fit, so a negative `0x7800 - hi` is reported as `None`.
+    pub fn lookups(&self) -> Vec<Option<u64>> {
+        let mut out = vec![];
+        for k in 0..4 {
+            out.push(Some(self.lo[k]));
+            out.push(Some(self.hi[k]));
+            out.push(P_MINUS_1_HI.checked_sub(self.hi[k]));
+            for l in 0..3 {
+                out.push(Some(self.ql[k][l]));
+            }
+        }
+        out
+    }
+}
+
+/// Trace of the ALU rows padded to a power of two (at least 2), and the range counts they need.
+/// A lookup value outside `[0, 2^16)` is not counted (so the bus does not balance).
+pub fn alu_trace<F: Field>(rows: &[AluRow], counts: &mut RangeCounts) -> RowMajorMatrix<F> {
+    let h = rows.len().next_power_of_two().max(2);
+    let pad = AluRow::padding();
+    let mut v = Vec::with_capacity(h * ALU_WIDTH);
+    for i in 0..h {
+        let row = rows.get(i).unwrap_or(&pad);
+        for x in row.lookups().into_iter().flatten() {
+            if (x as usize) < crate::range::RANGE_SIZE {
+                counts.add(x);
+            }
+        }
+        v.extend(row.cells::<F>());
+    }
+    let m = RowMajorMatrix::new(v, ALU_WIDTH);
+    debug_assert_eq!(m.height(), h);
+    m
+}
diff --git a/crates/sherlock-lfr/src/bb.rs b/crates/sherlock-lfr/src/bb.rs
new file mode 100644
index 0000000..8ba7af9
--- /dev/null
+++ b/crates/sherlock-lfr/src/bb.rs
@@ -0,0 +1,44 @@
+//! BabyBear and `EF4 = BabyBear[x] / (x^4 - 11)` as integers, for trace generation.
+//!
+//! In `L_Fr` a BabyBear value is one Fr cell that holds its canonical representative in `[0, p)`.
+//! An `EF4` value is 4 such cells (coefficients of `1, x, x^2, x^3`).
+
+use p3_baby_bear::BabyBear;
+use p3_field::{
+    extension::BinomialExtensionField, BasedVectorSpace, PrimeCharacteristicRing, PrimeField32,
+};
+
+/// The BabyBear modulus `p = 2^31 - 2^27 + 1`.
+pub const P: u64 = 2_013_265_921;
+/// `p - 1 = 0x7800_0000`: the high 16-bit limb of `p - 1` is `0x7800` and its low limb is 0.
+pub const P_MINUS_1_HI: u64 = 0x7800;
+/// `EF4` is `BabyBear[x] / (x^4 - W)`.
+pub const W: u64 = 11;
+
+pub type Ef4 = BinomialExtensionField<BabyBear, 4>;
+
+/// The integer convolution of `a * b` reduced by `x^4 = W`, before reduction mod p.
+/// Each entry is below `34 p^2 < 2^68`.
+pub fn ef4_mul_unreduced(a: &[u64; 4], b: &[u64; 4]) -> [u128; 4] {
+    let mut c = [0u128; 4];
+    for i in 0..4 {
+        for j in 0..4 {
+            let t = a[i] as u128 * b[j] as u128;
+            if i + j < 4 {
+                c[i + j] += t;
+            } else {
+                c[i + j - 4] += W as u128 * t;
+            }
+        }
+    }
+    c
+}
+
+pub fn to_ef4(a: &[u64; 4]) -> Ef4 {
+    Ef4::from_basis_coefficients_fn(|i| BabyBear::from_u64(a[i]))
+}
+
+pub fn from_ef4(a: Ef4) -> [u64; 4] {
+    let c: &[BabyBear] = a.as_basis_coefficients_slice();
+    std::array::from_fn(|i| c[i].as_canonical_u32() as u64)
+}
diff --git a/crates/sherlock-lfr/src/fixture.rs b/crates/sherlock-lfr/src/fixture.rs
new file mode 100644
index 0000000..7f267d7
--- /dev/null
+++ b/crates/sherlock-lfr/src/fixture.rs
@@ -0,0 +1,126 @@
+//! I0: the real `L` proof as a fixture on disk.
+//!
+//! The chain is M7's `l_fr.rs` unchanged: two W1 proofs (`Poseidon2SubAir`, app params, 2^20
+//! rows) -> node `VerifierSubCircuit::<2>` at the OD-19 internal set -> `L_cached`
+//! (`VerifierSubCircuit::<1>`, `has_cached = true`) at the OD-19 `L` set with the BabyBear-base,
+//! Midnight-Poseidon-Fr config (u = 1, 2, 3). The example `l_fixture` writes the files below;
+//! [`load`] reads them back.
+
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+use openvm_stark_backend::{
+    codec::{Decode, Encode},
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    SystemParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonConfig,
+    baby_bear_poseidon2::BabyBearPoseidon2Config, params_with_100_bits_security,
+};
+
+/// Config of `L` (BabyBear base, `EF4`, Midnight Poseidon over Fr, u = 1, 2, 3).
+pub type LSC = BabyBearBls12381PoseidonConfig;
+/// Config of the node below `L` (stock BabyBear Poseidon2).
+pub type NodeSC = BabyBearPoseidon2Config;
+
+pub const L_VK: &str = "l_vk.bitcode";
+pub const L_PROOF: &str = "l_proof.bin";
+pub const NODE_VK: &str = "node_vk.bitcode";
+pub const L_JSON: &str = "l_fixture.json";
+
+/// Fixture directory: `$E2_FIXTURE_DIR`, else `~/.cache/e2-lfr/fixture`.
+pub fn dir() -> PathBuf {
+    if let Ok(d) = std::env::var("E2_FIXTURE_DIR") {
+        return PathBuf::from(d);
+    }
+    let home = std::env::var("HOME").expect("HOME");
+    Path::new(&home).join(".cache/e2-lfr/fixture")
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn ud_params(
+    b: usize,
+    l_skip: usize,
+    n_stack: usize,
+    w_stack: usize,
+    mu: usize,
+    qpow: usize,
+    queries: &[usize],
+    logup: usize,
+) -> SystemParams {
+    let mut p = params_with_100_bits_security(
+        b,
+        l_skip,
+        n_stack,
+        w_stack,
+        0,
+        mu,
+        WhirProximityStrategy::UniqueDecoding,
+        4,
+        qpow,
+        4,
+    );
+    assert_eq!(p.whir.rounds.len(), queries.len(), "WHIR round count");
+    for (r, &q) in p.whir.rounds.iter_mut().zip(queries) {
+        r.num_queries = q;
+    }
+    p.logup.pow_bits = logup;
+    p
+}
+
+/// OD-19 internal set (UD-SIZING.md 5.1).
+pub fn internal_ud() -> SystemParams {
+    ud_params(3, 2, 17, 512, 9, 21, &[97, 82, 81], 18)
+}
+
+/// OD-19 `L` set (UD-SIZING.md 5.1) at a `w_stack` bound.
+pub fn l_ud(w_stack: usize) -> SystemParams {
+    ud_params(3, 2, 18, w_stack, 6, 20, &[98, 83, 82], 18)
+}
+
+/// The `L` fixture read from disk.
+pub struct LFixture {
+    pub l_vk: MultiStarkVerifyingKey<LSC>,
+    pub l_proof: Proof<LSC>,
+    pub l_proof_bytes: Vec<u8>,
+    pub node_vk: MultiStarkVerifyingKey<NodeSC>,
+}
+
+pub fn write(
+    d: &Path,
+    l_vk: &MultiStarkVerifyingKey<LSC>,
+    l_proof: &Proof<LSC>,
+    node_vk: &MultiStarkVerifyingKey<NodeSC>,
+) -> std::io::Result<usize> {
+    fs::create_dir_all(d)?;
+    let bytes = l_proof.encode_to_vec()?;
+    fs::write(d.join(L_PROOF), &bytes)?;
+    fs::write(
+        d.join(L_VK),
+        bitcode::serialize(l_vk).expect("vk serialize"),
+    )?;
+    fs::write(
+        d.join(NODE_VK),
+        bitcode::serialize(node_vk).expect("vk serialize"),
+    )?;
+    Ok(bytes.len())
+}
+
+pub fn load(d: &Path) -> std::io::Result<LFixture> {
+    let l_proof_bytes = fs::read(d.join(L_PROOF))?;
+    let l_proof = Proof::<LSC>::decode_from_bytes(&l_proof_bytes)?;
+    let l_vk = bitcode::deserialize(&fs::read(d.join(L_VK))?)
+        .map_err(|e| std::io::Error::other(format!("l_vk: {e}")))?;
+    let node_vk = bitcode::deserialize(&fs::read(d.join(NODE_VK))?)
+        .map_err(|e| std::io::Error::other(format!("node_vk: {e}")))?;
+    Ok(LFixture {
+        l_vk,
+        l_proof,
+        l_proof_bytes,
+        node_vk,
+    })
+}
diff --git a/crates/sherlock-lfr/src/fr.rs b/crates/sherlock-lfr/src/fr.rs
new file mode 100644
index 0000000..841a6cd
--- /dev/null
+++ b/crates/sherlock-lfr/src/fr.rs
@@ -0,0 +1,88 @@
+//! I5: Fr-word ops of the multi-field transcript of `L`.
+//!
+//! - **Pack**: `sum_i b_i 2^(31 i)` of 1 to 8 canonical BabyBear words (`pack_f_to_sf`).
+//! - **Split**: the 5 low base-`p` digits of a canonical Fr word `x` (`extract_samples`):
+//!   `x = sum_{i<5} d_i p^i + p^5 h` as integers, `d_i` canonical BabyBear.
+//!
+//! **Uniqueness of the split.** The AIR checks the identity in Fr, so a witness could represent
+//! `x + r` instead of `x`. It is refused by bounding the integer `T = low + p^5 h` (`low = sum
+//! d_i p^i < p^5`) below `r`: with `H = floor((r - 1) / p^5)` and `L = (r - 1) - p^5 H`, the AIR
+//! range-checks `h` and `H - h` to 112 bits (so `0 <= h <= H`, since `H < 2^101`), and when
+//! `h = H` it range-checks `L - low` to 160 bits (so `low <= L`). Then `T <= r - 1`, and `T = x
+//! mod r` with `0 <= x < r` gives `T = x`: the digits are the stock digits.
+
+use num_bigint::BigUint;
+use openvm_stark_backend::p3_field::{Field, PrimeCharacteristicRing, PrimeField};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+
+use crate::bb::P;
+
+/// Limbs of `h` and of `H - h` (16 bits each: 112 bits).
+pub const H_LIMBS: usize = 7;
+/// Limbs of `L - low` when `h = H` (160 bits).
+pub const V_LIMBS: usize = 10;
+
+pub fn fr_from_big(x: &BigUint) -> Fr {
+    Fr::from_biguint(x.clone()).expect("below r")
+}
+
+pub fn pack(words: &[u64]) -> Fr {
+    assert!(words.len() <= 8 && words.iter().all(|&w| w < P));
+    let base = Fr::from_u64(1 << 31);
+    words
+        .iter()
+        .rev()
+        .fold(Fr::ZERO, |acc, &w| acc * base + Fr::from_u64(w))
+}
+
+pub struct SplitConsts {
+    /// `p^i` for `i = 0..=5`.
+    pub p_pow: [BigUint; 6],
+    pub h_max: BigUint,
+    pub low_max: BigUint,
+}
+
+pub fn split_consts() -> SplitConsts {
+    let r = Fr::order();
+    let p = BigUint::from(P);
+    let p_pow: [BigUint; 6] = std::array::from_fn(|i| p.pow(i as u32));
+    let rm1 = &r - 1u32;
+    let h_max = &rm1 / &p_pow[5];
+    let low_max = &rm1 - &h_max * &p_pow[5];
+    assert!(h_max.bits() <= 16 * H_LIMBS as u64);
+    assert!(p_pow[5].bits() <= 16 * V_LIMBS as u64);
+    SplitConsts {
+        p_pow,
+        h_max,
+        low_max,
+    }
+}
+
+/// The stock digits and the high part `h`.
+pub fn split(x: Fr) -> ([u64; 5], BigUint) {
+    let p = BigUint::from(P);
+    let mut v = x.as_canonical_biguint();
+    let d = std::array::from_fn(|_| {
+        let r = (&v % &p).to_u64_digits().first().copied().unwrap_or(0);
+        v /= &p;
+        r
+    });
+    (d, v)
+}
+
+/// 16-bit limbs of `x` (little-endian), `n` of them; panics if `x` does not fit.
+pub fn limbs16(x: &BigUint, n: usize) -> Vec<u64> {
+    assert!(x.bits() <= 16 * n as u64, "value does not fit {n} limbs");
+    let mut v = x.clone();
+    (0..n)
+        .map(|_| {
+            let l = (&v & BigUint::from(0xffffu32))
+                .to_u64_digits()
+                .first()
+                .copied()
+                .unwrap_or(0);
+            v >>= 16u32;
+            l
+        })
+        .collect()
+}
