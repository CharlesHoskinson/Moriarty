+// ------------------------------------------------------------------------------------------
+// BitsAir: program [addr_x, addr_low, mult_low, n, active]; main [x, b[31], s[31], low].
+// `low = x mod 2^n` of a canonical BabyBear word `x` (`sample_bits`): `x = sum b_i 2^i` with
+// boolean `b_i` (31 bits: unique, as `x < p < 2^31 < r`); the mask `s` is boolean and
+// non-increasing with `sum s_i = n`, so `s_i = [i < n]`; `low = sum s_i b_i 2^i`.
+// ------------------------------------------------------------------------------------------
+
+pub const BITS_N: usize = 31;
+pub const BT_X: usize = 0;
+pub const BT_B: usize = 1;
+pub const BT_S: usize = BT_B + BITS_N;
+pub const BT_LOW: usize = BT_S + BITS_N;
+pub const BITS_WIDTH: usize = BT_LOW + 1;
+
+#[derive(Clone, Debug)]
+pub struct BitsProg {
+    pub x: Addr,
+    pub out: Addr,
+    pub mult: u64,
+    pub n: u32,
+}
+
+#[derive(Clone, Debug)]
+pub struct BitsAir {
+    pub prog: Arc<Vec<BitsProg>>,
+}
+air_boiler!(BitsAir, BITS_WIDTH, 5);
+
+/// Cells of one `BitsAir` row for the word `x` and bit count `n`.
+pub fn bits_cells(x: u64, n: u32) -> Vec<Fr> {
+    let mut r = vec![Fr::ZERO; BITS_WIDTH];
+    r[BT_X] = fu(x);
+    for i in 0..BITS_N {
+        r[BT_B + i] = fu((x >> i) & 1);
+        r[BT_S + i] = fu(((i as u32) < n) as u64);
+    }
+    r[BT_LOW] = fu(x & ((1u64 << n) - 1));
+    r
+}
+
+impl BitsAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.x as u64),
+                    fu(p.out as u64),
+                    fu(p.mult),
+                    fu(p.n as u64),
+                    Fr::ONE,
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 5, vec![Fr::ZERO; 5])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| bits_cells(get(mem, p.x).bb()[0], p.n))
+            .collect();
+        self.finish(rows_to_matrix(
+            rows,
+            self.prog.len(),
+            BITS_WIDTH,
+            bits_cells(0, 0),
+        ))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for BitsAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_BITS, BITS_WIDTH, 5);
+        let mut acc = AB::Expr::ZERO;
+        let mut low = AB::Expr::ZERO;
+        let mut sum_s = AB::Expr::ZERO;
+        for i in (0..BITS_N).rev() {
+            let (b, s) = (x[BT_B + i].clone(), x[BT_S + i].clone());
+            builder.assert_bool(b.clone());
+            builder.assert_bool(s.clone());
+            if i + 1 < BITS_N {
+                // s_{i+1} = 1 -> s_i = 1
+                builder.assert_zero(x[BT_S + i + 1].clone() * (AB::Expr::ONE - s.clone()));
+            }
+            acc = acc * AB::Expr::TWO + b.clone();
+            low = low * AB::Expr::TWO + s.clone() * b;
+            sum_s += s;
+        }
+        builder.assert_eq(x[BT_X].clone(), acc);
+        builder.assert_eq(x[BT_LOW].clone(), low);
+        builder.assert_eq(sum_s, p[3].clone());
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[0].clone(), &[x[BT_X].clone()]),
+            -p[4].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[1].clone(), &[x[BT_LOW].clone()]),
+            p[2].clone(),
+            1,
+        );
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// Machine
+// ------------------------------------------------------------------------------------------
+
+/// The AIRs of one tape, in the fixed order of the module comment.
+#[derive(Clone)]
+pub struct Machine {
+    pub input: Option<InputAir>,
+    pub fr_input: Option<FrInputAir>,
+    pub alu: Option<BbAluProgAir>,
+    pub poseidon: Option<PoseidonProgAir>,
+    pub pack: Option<PackAir>,
+    pub split: Option<SplitAir>,
+    pub reshape: Option<ReshapeAir>,
+    pub assert_eq: Option<AssertEqAir>,
+    pub bits: Option<BitsAir>,
+}
+
+fn some<T>(v: Vec<T>) -> Option<Arc<Vec<T>>> {
+    (!v.is_empty()).then(|| Arc::new(v))
+}
+
+impl Machine {
+    pub fn new(tape: &Tape) -> Self {
+        let reads = tape.reads();
+        let m = |a: &Addr| reads[*a as usize];
+        let (mut fr_in, mut perm, mut pack, mut split, mut reshape) =
+            (vec![], vec![], vec![], vec![], vec![]);
+        let mut inp = vec![];
+        let mut alu = vec![];
+        let (mut asserts, mut bits) = (vec![], vec![]);
+        for op in &tape.ops {
+            match op {
+                Op::Input { kind, out } => inp.push(crate::tape::InputProg {
+                    addr: *out,
+                    mult: m(out),
+                    bb: *kind == crate::tape::ValKind::Bb,
+                    konst: None,
+                }),
+                Op::Const { kind, val, out } => inp.push(crate::tape::InputProg {
+                    addr: *out,
+                    mult: m(out),
+                    bb: *kind == crate::tape::ValKind::Bb,
+                    konst: Some(*val),
+                }),
+                Op::Alu { kind, a, b, out } => alu.push(crate::tape::AluProg {
+                    kind: *kind,
+                    a: *a,
+                    b: *b,
+                    out: *out,
+                    mult: m(out),
+                }),
+                Op::FrInput { out } => fr_in.push(FrInputProg {
+                    addr: *out,
+                    mult: m(out),
+                    konst: None,
+                }),
+                Op::FrConst { val, out } => fr_in.push(FrInputProg {
+                    addr: *out,
+                    mult: m(out),
+                    konst: Some(*val),
+                }),
+                Op::Perm { ins, outs } => perm.push(PermProg {
+                    ins: *ins,
+                    outs: *outs,
+                    mults: outs.map(|a| m(&a)),
+                }),
+                Op::Pack { ins, out } => pack.push(PackProg {
+                    ins: ins.clone(),
+                    out: *out,
+                    mult: m(out),
+                }),
+                Op::Split { x, outs } => split.push(SplitProg {
+                    x: *x,
+                    outs: *outs,
+                    mults: outs.map(|a| m(&a)),
+                }),
+                Op::Compose { ins, out } => reshape.push(ReshapeProg {
+                    ef: *out,
+                    bb: *ins,
+                    compose: true,
+                    mult_ef: m(out),
+                    mult_bb: [0; 4],
+                }),
+                Op::Decompose { x, outs } => reshape.push(ReshapeProg {
+                    ef: *x,
+                    bb: *outs,
+                    compose: false,
+                    mult_ef: 0,
+                    mult_bb: outs.map(|a| m(&a)),
+                }),
+                Op::AssertEq { a, b } => asserts.push(AssertEqProg { a: *a, b: *b }),
+                Op::LowBits { x, n, out } => bits.push(BitsProg {
+                    x: *x,
+                    out: *out,
+                    mult: m(out),
+                    n: *n,
+                }),
+            }
+        }
+        Self {
+            input: some(inp).map(|prog| InputAir { prog }),
+            fr_input: some(fr_in).map(|prog| FrInputAir { prog }),
+            alu: some(alu).map(|prog| BbAluProgAir { prog }),
+            poseidon: some(perm).map(|prog| PoseidonProgAir { prog }),
+            pack: some(pack).map(|prog| PackAir { prog }),
+            split: some(split).map(|prog| SplitAir { prog }),
+            reshape: some(reshape).map(|prog| ReshapeAir { prog }),
+            assert_eq: some(asserts).map(|prog| AssertEqAir { prog }),
+            bits: some(bits).map(|prog| BitsAir { prog }),
+        }
+    }
+
+    /// The programs of the present AIRs, in [`Machine::airs`] order.
+    pub fn programs(&self) -> Vec<KindProgram> {
+        let mut v = vec![];
+        let mut push = |tag, rows| v.push(KindProgram { tag, rows });
+        if let Some(a) = &self.input {
+            push(TAG_INPUT, a.prog_rows());
+        }
+        if let Some(a) = &self.fr_input {
+            push(TAG_FR_INPUT, a.prog_rows());
+        }
+        if let Some(a) = &self.alu {
+            push(TAG_ALU, a.prog_rows());
+        }
+        if let Some(a) = &self.poseidon {
+            push(TAG_PERM, a.prog_rows());
+        }
+        if let Some(a) = &self.pack {
+            push(TAG_PACK, a.prog_rows());
+        }
+        if let Some(a) = &self.split {
+            push(TAG_SPLIT, a.prog_rows());
+        }
+        if let Some(a) = &self.reshape {
+            push(TAG_RESHAPE, a.prog_rows());
+        }
+        if let Some(a) = &self.assert_eq {
+            push(TAG_ASSERT_EQ, a.prog_rows());
+        }
+        if let Some(a) = &self.bits {
+            push(TAG_BITS, a.prog_rows());
+        }
+        v
+    }
+
+    /// The one program table of all present AIRs (the only preprocessed trace).
+    pub fn table(&self) -> ProgramTableAir {
+        ProgramTableAir::new(&self.programs())
+    }
+
+    /// AIRs in order: the execution AIRs, `ProgramTable`, `Range16` last.
+    pub fn airs(&self) -> Vec<AirRef<SC>> {
+        let mut v: Vec<AirRef<SC>> = vec![];
+        if let Some(a) = &self.input {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.fr_input {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.alu {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.poseidon {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.pack {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.split {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.reshape {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.assert_eq {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.bits {
+            v.push(Arc::new(a.clone()));
+        }
+        v.push(Arc::new(self.table()));
+        v.push(Arc::new(Range16Air));
+        v
+    }
+
+    /// AIR names in [`Machine::airs`] order.
+    pub fn names(&self) -> Vec<&'static str> {
+        let mut v = vec![];
+        for (present, n) in [
+            (self.input.is_some(), "Input"),
+            (self.fr_input.is_some(), "FrInput"),
+            (self.alu.is_some(), "BbAlu"),
+            (self.poseidon.is_some(), "PoseidonFr"),
+            (self.pack.is_some(), "Pack"),
+            (self.split.is_some(), "Split"),
+            (self.reshape.is_some(), "Reshape"),
+            (self.assert_eq.is_some(), "AssertEq"),
+            (self.bits.is_some(), "Bits"),
+        ] {
+            if present {
+                v.push(n);
+            }
+        }
+        v.push("ProgramTable");
+        v.push("Range16");
+        v
+    }
+
+    /// Honest main traces of every AIR except `Range16` (filled by
+    /// [`crate::testing::prove_verify_range`]).
+    pub fn traces(&self, mem: &[Option<Val>]) -> Vec<RowMajorMatrix<Fr>> {
+        let mut v = vec![];
+        let mut dummy = RangeCounts::default();
+        if let Some(a) = &self.input {
+            let vals: Vec<[u64; 4]> = a.prog.iter().map(|p| get(mem, p.addr).bb()).collect();
+            v.push(a.trace(&vals, &mut dummy));
+        }
+        if let Some(a) = &self.fr_input {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.alu {
+            let bb: Vec<[u64; 4]> = mem
+                .iter()
+                .map(|x| match x {
+                    Some(Val::Bb(b)) => *b,
+                    _ => [0; 4],
+                })
+                .collect();
+            v.push(a.trace(&a.rows(&bb), &mut dummy));
+        }
+        if let Some(a) = &self.poseidon {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.pack {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.split {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.reshape {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.assert_eq {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.bits {
+            v.push(a.trace(mem));
+        }
+        v.push(self.table().trace());
+        v
+    }
+
+    /// Rows and cells per AIR: (name, rows padded, main width with the program columns,
+    /// preprocessed width).
+    pub fn shape(&self) -> Vec<(&'static str, usize, usize, usize)> {
+        let mut v = vec![];
+        let mut push =
+            |n: &'static str, len: usize, w: usize, pw: usize| v.push((n, padded(len), w, pw));
+        if let Some(a) = &self.input {
+            push(
+                "Input",
+                a.prog.len(),
+                crate::tape::IN_WIDTH + crate::tape::IN_PRE_WIDTH,
+                0,
+            );
+        }
+        if let Some(a) = &self.fr_input {
+            push("FrInput", a.prog.len(), 1 + 4, 0);
+        }
+        if let Some(a) = &self.alu {
+            push(
+                "BbAlu",
+                a.prog.len(),
+                crate::alu::ALU_WIDTH + crate::tape::ALU_PROG_COLS,
+                0,
+            );
+        }
+        if let Some(a) = &self.poseidon {
+            push("PoseidonFr", a.prog.len(), POSEIDON_WIDTH + 10, 0);
+        }
+        if let Some(a) = &self.pack {
+            push("Pack", a.prog.len(), 9 + 18, 0);
+        }
+        if let Some(a) = &self.split {
+            push("Split", a.prog.len(), SPLIT_WIDTH + 12, 0);
+        }
+        if let Some(a) = &self.reshape {
+            push("Reshape", a.prog.len(), 4 + 12, 0);
+        }
+        if let Some(a) = &self.assert_eq {
+            push("AssertEq", a.prog.len(), 4 + 3, 0);
+        }
+        if let Some(a) = &self.bits {
+            push("Bits", a.prog.len(), BITS_WIDTH + 5, 0);
+        }
+        let t = self.table();
+        v.push((
+            "ProgramTable",
+            t.height(),
+            1,
+            crate::program::TABLE_PRE_WIDTH,
+        ));
+        v.push(("Range16", crate::range::RANGE_SIZE, 2, 0));
+        v
+    }
+}
diff --git a/crates/sherlock-lfr/src/poseidon.rs b/crates/sherlock-lfr/src/poseidon.rs
new file mode 100644
index 0000000..1a62a93
--- /dev/null
+++ b/crates/sherlock-lfr/src/poseidon.rs
@@ -0,0 +1,192 @@
+//! `PoseidonFr`: the Midnight Poseidon permutation over BLS12-381 Fr, one row per permutation.
+//!
+//! Permutation (midnight-circuits 7.3.0 constants, as `m7_bls_fr.rs` `reference_perm`): width 3,
+//! 68 rounds; round `r` adds `RC[r]`, applies `x^5` to all 3 cells in a full round (`r < 4` or
+//! `r >= 64`) and to cell 2 in a partial round, then multiplies by `MDS`.
+//!
+//! Row layout: `in[3]`, then per S-box (8 x 3 full + 60 partial = 84 S-boxes) the two cells
+//! `t = x^2` and `y = x^5 = t^2 x`, then `out[3]` and `mult`. The S-box input `x` and every state
+//! cell between S-boxes are linear expressions of earlier cells (no column), so each S-box costs 2
+//! columns and 2 constraints of degree at most 3. Width 3 + 168 + 3 + 1 = 175.
+//!
+//! The row receives `[in, out]` on [`POSEIDON_BUS`] with multiplicity `mult`: a caller sends the
+//! 6 words of each permutation it uses.
+
+use std::sync::OnceLock;
+
+use midnight_circuits::hash::poseidon::constants::PoseidonField;
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{Bls12381Fr, MidnightFq};
+
+type Fr = Bls12381Fr;
+
+pub const POSEIDON_BUS: BusIndex = 1;
+pub const ROUNDS: usize = 68;
+pub const SBOXES: usize = 8 * 3 + 60;
+pub const IN: usize = 0;
+pub const SB: usize = 3;
+pub const OUT: usize = SB + 2 * SBOXES;
+pub const MULT: usize = OUT + 3;
+pub const POSEIDON_WIDTH: usize = MULT + 1;
+
+pub fn is_full(r: usize) -> bool {
+    !(4..64).contains(&r)
+}
+
+pub struct Constants {
+    pub rc: [[Fr; 3]; ROUNDS],
+    pub mds: [[Fr; 3]; 3],
+}
+
+pub fn constants() -> &'static Constants {
+    static C: OnceLock<Constants> = OnceLock::new();
+    C.get_or_init(|| {
+        let rc = <MidnightFq as PoseidonField>::ROUND_CONSTANTS;
+        let mds = <MidnightFq as PoseidonField>::MDS;
+        assert_eq!(rc.len(), ROUNDS);
+        Constants {
+            rc: std::array::from_fn(|r| std::array::from_fn(|i| Fr::from_ff(rc[r][i]))),
+            mds: std::array::from_fn(|i| std::array::from_fn(|j| Fr::from_ff(mds[i][j]))),
+        }
+    })
+}
+
+/// The permutation with every S-box input, for trace generation: returns (out, sbox inputs).
+pub fn permute_trace(input: [Fr; 3]) -> ([Fr; 3], Vec<Fr>) {
+    let c = constants();
+    let mut s = input;
+    let mut xs = Vec::with_capacity(SBOXES);
+    for r in 0..ROUNDS {
+        for i in 0..3 {
+            s[i] += c.rc[r][i];
+        }
+        for i in 0..3 {
+            if is_full(r) || i == 2 {
+                xs.push(s[i]);
+                s[i] = s[i].square().square() * s[i];
+            }
+        }
+        let t = s;
+        for i in 0..3 {
+            s[i] = c.mds[i][0] * t[0] + c.mds[i][1] * t[1] + c.mds[i][2] * t[2];
+        }
+    }
+    (s, xs)
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PoseidonFrAir;
+
+impl<F> BaseAir<F> for PoseidonFrAir {
+    fn width(&self) -> usize {
+        POSEIDON_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for PoseidonFrAir {}
+impl<F> PartitionedBaseAir<F> for PoseidonFrAir {}
+
+/// The round constraints of one row: `in -> out` through the 84 S-box cells.
+pub fn eval_rounds<AB: InteractionBuilder<F = Fr>>(builder: &mut AB, x: &[AB::Expr]) {
+    let c = constants();
+    let k = |v: Fr| -> AB::Expr { AB::Expr::from(v) };
+    let mut s: [AB::Expr; 3] = std::array::from_fn(|i| x[IN + i].clone());
+    let mut sb = 0;
+    for r in 0..ROUNDS {
+        for i in 0..3 {
+            s[i] = s[i].clone() + k(c.rc[r][i]);
+        }
+        for i in 0..3 {
+            if is_full(r) || i == 2 {
+                let (t, y) = (x[SB + 2 * sb].clone(), x[SB + 2 * sb + 1].clone());
+                builder.assert_eq(t.clone(), s[i].clone() * s[i].clone());
+                builder.assert_eq(y.clone(), t.clone() * t * s[i].clone());
+                s[i] = y;
+                sb += 1;
+            }
+        }
+        let t = s.clone();
+        s = std::array::from_fn(|i| {
+            t[0].clone() * k(c.mds[i][0])
+                + t[1].clone() * k(c.mds[i][1])
+                + t[2].clone() * k(c.mds[i][2])
+        });
+    }
+    debug_assert_eq!(sb, SBOXES);
+    for i in 0..3 {
+        builder.assert_eq(x[OUT + i].clone(), s[i].clone());
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for PoseidonFrAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let row = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..POSEIDON_WIDTH).map(|i| row[i].into()).collect();
+        drop(row);
+        eval_rounds(builder, &x);
+        let msg: Vec<AB::Expr> = (0..3)
+            .map(|i| x[IN + i].clone())
+            .chain((0..3).map(|i| x[OUT + i].clone()))
+            .collect();
+        builder.push_interaction(POSEIDON_BUS, msg, -x[MULT].clone(), 1);
+    }
+}
+
+/// One honest row: the permutation of `input`, received `mult` times.
+pub fn poseidon_row(input: [Fr; 3], mult: u64) -> Vec<Fr> {
+    let (out, xs) = permute_trace(input);
+    let mut v = vec![Fr::ZERO; POSEIDON_WIDTH];
+    v[IN..IN + 3].copy_from_slice(&input);
+    for (j, xj) in xs.iter().enumerate() {
+        let t = xj.square();
+        v[SB + 2 * j] = t;
+        v[SB + 2 * j + 1] = t.square() * *xj;
+    }
+    v[OUT..OUT + 3].copy_from_slice(&out);
+    v[MULT] = Fr::from_u64(mult);
+    v
+}
+
+/// Trace of the given rows, padded to a power of two (at least 2) with the zero-state
+/// permutation at multiplicity 0.
+pub fn poseidon_trace(rows: Vec<Vec<Fr>>) -> RowMajorMatrix<Fr> {
+    let h = rows.len().next_power_of_two().max(2);
+    let pad = poseidon_row([Fr::ZERO; 3], 0);
+    let mut v = Vec::with_capacity(h * POSEIDON_WIDTH);
+    for i in 0..h {
+        v.extend_from_slice(rows.get(i).unwrap_or(&pad));
+    }
+    let m = RowMajorMatrix::new(v, POSEIDON_WIDTH);
+    debug_assert_eq!(m.height(), h);
+    m
+}
+
+/// Test caller: sends `[in, out]` on [`POSEIDON_BUS`] once per row with `is_real = 1`.
+/// Columns `[is_real, in[3], out[3]]`.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PoseidonCallerAir;
+
+pub const CALLER_WIDTH: usize = 7;
+
+impl<F> BaseAir<F> for PoseidonCallerAir {
+    fn width(&self) -> usize {
+        CALLER_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for PoseidonCallerAir {}
+impl<F> PartitionedBaseAir<F> for PoseidonCallerAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for PoseidonCallerAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let row = main.row_slice(0).expect("row");
+        builder.assert_bool(row[0]);
+        builder.push_interaction(POSEIDON_BUS, row[1..7].iter().copied(), row[0], 1);
+    }
+}
diff --git a/crates/sherlock-lfr/src/program.rs b/crates/sherlock-lfr/src/program.rs
new file mode 100644
index 0000000..1798e35
--- /dev/null
+++ b/crates/sherlock-lfr/src/program.rs
@@ -0,0 +1,152 @@
+//! The shared program table (owner ruling 2026-11-12): every program of every execution AIR is
+//! one preprocessed trace, so an `L_Fr` proof has 2 commitments (common main and this table).
+//!
+//! **Program bus.** Each execution AIR keeps its program columns (op kind, operand and result
+//! addresses, multiplicities, constants) in its main trace, after its other columns. Every row,
+//! padding included, receives `[tag, prog[0..k], 0 ..]` (length `1 + PROG_W`) on [`PROG_BUS`]
+//! with count 1. The table sends each program row with count 1 and, per AIR kind, one all-zero
+//! nop row `[tag, 0 ..]` with count `padded(n) - n` (the padding rows of that AIR).
+//!
+//! **Why this binds the program.** The table is preprocessed, so the key fixes the multiset of
+//! `(tag, program row)` with its counts. The bus balances only if the rows of each execution AIR
+//! carry exactly that multiset: every program row once, and the nop row on every other row. So
+//! the execution AIR height is pinned to `padded(n)` (as the old per-AIR preprocessed trace did),
+//! a padding row has all program cells zero (so no memory traffic), and the hard-coded tag stops
+//! one kind of AIR from taking another kind's row. Order inside an AIR is free: the write-once
+//! memory bus does not depend on it.
+
+use std::sync::Arc;
+
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, BaseAir, PairBuilder},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+
+use crate::tape::padded;
+
+pub const PROG_BUS: BusIndex = 3;
+/// Program cells per message (the widest program, `Pack`).
+pub const PROG_W: usize = 18;
+/// Preprocessed columns of the table: `tag, f[PROG_W], count`.
+pub const TABLE_PRE_WIDTH: usize = PROG_W + 2;
+
+pub const TAG_INPUT: u64 = 1;
+pub const TAG_FR_INPUT: u64 = 2;
+pub const TAG_ALU: u64 = 3;
+pub const TAG_PERM: u64 = 4;
+pub const TAG_PACK: u64 = 5;
+pub const TAG_SPLIT: u64 = 6;
+pub const TAG_RESHAPE: u64 = 7;
+pub const TAG_ASSERT_EQ: u64 = 8;
+pub const TAG_BITS: u64 = 9;
+
+/// `[tag, cols.., 0 ..]` of length `1 + PROG_W`.
+pub fn prog_msg<E: Clone + PrimeCharacteristicRing>(tag: u64, cols: &[E]) -> Vec<E> {
+    assert!(cols.len() <= PROG_W);
+    let mut m = vec![E::from_u64(tag)];
+    m.extend(cols.iter().cloned());
+    m.resize(1 + PROG_W, E::ZERO);
+    m
+}
+
+/// The receive of an execution row: its program cells, count 1 on every row.
+pub fn receive_prog<AB: InteractionBuilder>(builder: &mut AB, tag: u64, cols: &[AB::Expr]) {
+    builder.push_interaction(PROG_BUS, prog_msg(tag, cols), -AB::Expr::ONE, 1);
+}
+
+/// One kind's program: its tag, its rows (unpadded) and its row width.
+#[derive(Clone, Debug)]
+pub struct KindProgram {
+    pub tag: u64,
+    pub rows: Vec<Vec<Fr>>,
+}
+
+#[derive(Clone, Debug)]
+pub struct ProgramTableAir {
+    /// `(tag, cells (PROG_W), count)` per table row.
+    pub rows: Arc<Vec<(u64, Vec<Fr>, u64)>>,
+}
+
+impl ProgramTableAir {
+    pub fn new(kinds: &[KindProgram]) -> Self {
+        let mut rows = vec![];
+        for k in kinds {
+            let n = k.rows.len();
+            for r in &k.rows {
+                let mut c = r.clone();
+                assert!(c.len() <= PROG_W);
+                c.resize(PROG_W, Fr::ZERO);
+                rows.push((k.tag, c, 1));
+            }
+            if padded(n) > n {
+                rows.push((k.tag, vec![Fr::ZERO; PROG_W], (padded(n) - n) as u64));
+            }
+        }
+        Self {
+            rows: Arc::new(rows),
+        }
+    }
+
+    pub fn height(&self) -> usize {
+        padded(self.rows.len())
+    }
+
+    /// The main trace: one column of zeros.
+    pub fn trace(&self) -> RowMajorMatrix<Fr> {
+        RowMajorMatrix::new(vec![Fr::ZERO; self.height()], 1)
+    }
+}
+
+impl BaseAir<Fr> for ProgramTableAir {
+    fn width(&self) -> usize {
+        1
+    }
+    fn preprocessed_trace(&self) -> Option<RowMajorMatrix<Fr>> {
+        let h = self.height();
+        let mut v = vec![Fr::ZERO; h * TABLE_PRE_WIDTH];
+        for (i, (tag, cells, count)) in self.rows.iter().enumerate() {
+            let r = &mut v[i * TABLE_PRE_WIDTH..(i + 1) * TABLE_PRE_WIDTH];
+            r[0] = Fr::from_u64(*tag);
+            r[1..1 + PROG_W].copy_from_slice(cells);
+            r[1 + PROG_W] = Fr::from_u64(*count);
+        }
+        Some(RowMajorMatrix::new(v, TABLE_PRE_WIDTH))
+    }
+}
+impl BaseAirWithPublicValues<Fr> for ProgramTableAir {}
+impl PartitionedBaseAir<Fr> for ProgramTableAir {}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for ProgramTableAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..TABLE_PRE_WIDTH).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let z: AB::Expr = r[0].into();
+        drop(r);
+        builder.assert_zero(z);
+        builder.push_interaction(PROG_BUS, p[..1 + PROG_W].to_vec(), p[1 + PROG_W].clone(), 1);
+    }
+}
+
+/// Append the program columns `prog` (one row per program row, zeros on padding rows) to the
+/// main trace `main` (already padded).
+pub fn with_prog(main: RowMajorMatrix<Fr>, prog: &[Vec<Fr>], pw: usize) -> RowMajorMatrix<Fr> {
+    let (h, w) = (main.height(), main.width());
+    assert!(prog.len() <= h);
+    let mut v = Vec::with_capacity(h * (w + pw));
+    let zero = vec![Fr::ZERO; pw];
+    for i in 0..h {
+        v.extend_from_slice(&main.values[i * w..(i + 1) * w]);
+        let p = prog.get(i).unwrap_or(&zero);
+        assert_eq!(p.len(), pw);
+        v.extend_from_slice(p);
+    }
+    RowMajorMatrix::new(v, w + pw)
+}
diff --git a/crates/sherlock-lfr/src/range.rs b/crates/sherlock-lfr/src/range.rs
new file mode 100644
index 0000000..3d1a3b1
--- /dev/null
+++ b/crates/sherlock-lfr/src/range.rs
@@ -0,0 +1,78 @@
+//! `Range16`: the 16-bit lookup table, one row per value `0 .. 2^16`.
+//!
+//! Columns `[value, mult]`. `value` starts at 0, steps by 1 and ends at `2^16 - 1`; since a trace
+//! height is a power of two, the last-row constraint pins the height to `2^16`. The table receives
+//! `[value]` on [`RANGE_BUS`] with multiplicity `mult`.
+
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+/// Bus of 16-bit range lookups `[x]`.
+pub const RANGE_BUS: BusIndex = 0;
+pub const RANGE_BITS: usize = 16;
+pub const RANGE_SIZE: usize = 1 << RANGE_BITS;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Range16Air;
+
+impl<F> BaseAir<F> for Range16Air {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for Range16Air {}
+impl<F> PartitionedBaseAir<F> for Range16Air {}
+
+impl<AB: InteractionBuilder> Air<AB> for Range16Air {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let local = main.row_slice(0).expect("local row");
+        let next = main.row_slice(1).expect("next row");
+        let (value, mult) = (local[0], local[1]);
+        let next_value = next[0];
+        builder.when_first_row().assert_zero(value);
+        builder
+            .when_transition()
+            .assert_eq(next_value, value.into() + AB::Expr::ONE);
+        builder
+            .when_last_row()
+            .assert_eq(value, AB::Expr::from_u64((RANGE_SIZE - 1) as u64));
+        builder.push_interaction(RANGE_BUS, [value], -mult.into(), 1);
+    }
+}
+
+/// Multiplicity counter for the table.
+#[derive(Clone, Debug)]
+pub struct RangeCounts(pub Vec<u64>);
+
+impl Default for RangeCounts {
+    fn default() -> Self {
+        Self(vec![0; RANGE_SIZE])
+    }
+}
+
+impl RangeCounts {
+    /// Count one lookup of `x`. Panics if `x >= 2^16` (trace generation of a valid witness).
+    pub fn add(&mut self, x: u64) {
+        self.0[usize::try_from(x)
+            .ok()
+            .filter(|&v| v < RANGE_SIZE)
+            .expect("range value")] += 1;
+    }
+
+    pub fn trace<F: Field>(&self) -> RowMajorMatrix<F> {
+        let mut v = Vec::with_capacity(2 * RANGE_SIZE);
+        for (i, &m) in self.0.iter().enumerate() {
+            v.push(F::from_u64(i as u64));
+            v.push(F::from_u64(m));
+        }
+        let m = RowMajorMatrix::new(v, 2);
+        debug_assert_eq!(m.height(), RANGE_SIZE);
+        m
+    }
+}
