+//! The tape machine: every AIR that runs a [`Tape`], built from the tape (the key) and filled
+//! from its executed memory (the witness).
+//!
+//! AIRs (only those with at least one op are present; `Range16` is always last):
+//! `InputAir` (BabyBear and `EF4` inputs and constants), `FrInputAir`, `BbAluProgAir`,
+//! `PoseidonProgAir`, `PackAir`, `SplitAir`, `ReshapeAir`, `AssertEqAir`, `BitsAir`,
+//! `ProgramTableAir`, `Range16Air`. All
+//! talk over the write-once memory bus [`MEM_BUS`] and the 16-bit range bus. Each execution AIR
+//! keeps its program in main columns after its other columns and receives it on the program bus
+//! from the one `ProgramTableAir` (`crate::program`), the only preprocessed trace.
+
+use std::sync::Arc;
+
+use num_bigint::BigUint;
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    AirRef, BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+
+use crate::{
+    alu::{canonical_cells, eval_canonical},
+    fr::{fr_from_big, limbs16, split, split_consts, H_LIMBS, V_LIMBS},
+    poseidon::{eval_rounds, poseidon_row, IN, OUT, POSEIDON_WIDTH},
+    program::{
+        receive_prog, KindProgram, ProgramTableAir, TAG_ALU, TAG_ASSERT_EQ, TAG_BITS, TAG_FR_INPUT,
+        TAG_INPUT, TAG_PACK, TAG_PERM, TAG_RESHAPE, TAG_SPLIT,
+    },
+    range::{Range16Air, RangeCounts, RANGE_BUS},
+    tape::{padded, Addr, BbAluProgAir, InputAir, Op, Tape, Val, MEM_BUS},
+    testing::SC,
+};
+
+fn mem_msg<E: Clone + PrimeCharacteristicRing>(addr: E, v: &[E]) -> Vec<E> {
+    let mut m = vec![addr];
+    m.extend(v.iter().cloned());
+    while m.len() < 5 {
+        m.push(E::ZERO);
+    }
+    m
+}
+
+fn fu(x: u64) -> Fr {
+    Fr::from_u64(x)
+}
+
+fn get(mem: &[Option<Val>], a: Addr) -> Val {
+    mem[a as usize].expect("unwritten address")
+}
+
+macro_rules! air_boiler {
+    ($t:ty, $w:expr, $pw:expr) => {
+        impl BaseAir<Fr> for $t {
+            fn width(&self) -> usize {
+                $w + $pw
+            }
+        }
+        impl BaseAirWithPublicValues<Fr> for $t {}
+        impl PartitionedBaseAir<Fr> for $t {}
+        impl $t {
+            /// Main columns before the program columns.
+            pub const MAIN_WIDTH: usize = $w;
+            /// Program columns (after the main columns; received on the program bus).
+            pub const PROG_WIDTH: usize = $pw;
+            /// Program rows (unpadded), as sent by the program table.
+            pub fn prog_rows(&self) -> Vec<Vec<Fr>> {
+                let m = self.pre();
+                m.values[..self.prog.len() * $pw]
+                    .chunks($pw)
+                    .map(|c| c.to_vec())
+                    .collect()
+            }
+            fn finish(&self, main: RowMajorMatrix<Fr>) -> RowMajorMatrix<Fr> {
+                crate::program::with_prog(main, &self.prog_rows(), $pw)
+            }
+        }
+    };
+}
+
+/// The main row split into its main cells (`w`) and program cells (`pw`); the program cells are
+/// received on the program bus under `tag`.
+fn split_row<AB: InteractionBuilder>(
+    builder: &mut AB,
+    tag: u64,
+    w: usize,
+    pw: usize,
+) -> (Vec<AB::Expr>, Vec<AB::Expr>) {
+    let main = builder.main();
+    let r = main.row_slice(0).expect("row");
+    let all: Vec<AB::Expr> = (0..w + pw).map(|i| r[i].into()).collect();
+    drop(r);
+    let p = all[w..].to_vec();
+    receive_prog(builder, tag, &p);
+    (all[..w].to_vec(), p)
+}
+
+fn rows_to_matrix(rows: Vec<Vec<Fr>>, n: usize, w: usize, pad: Vec<Fr>) -> RowMajorMatrix<Fr> {
+    let h = padded(n);
+    let mut v = Vec::with_capacity(h * w);
+    for i in 0..h {
+        let r = rows.get(i).unwrap_or(&pad);
+        assert_eq!(r.len(), w);
+        v.extend_from_slice(r);
+    }
+    RowMajorMatrix::new(v, w)
+}
+
+// ------------------------------------------------------------------------------------------
+// FrInputAir: program (main, after the other columns) [addr, mult, is_const, k]; main [v].
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct FrInputProg {
+    pub addr: Addr,
+    pub mult: u64,
+    pub konst: Option<Fr>,
+}
+
+#[derive(Clone, Debug)]
+pub struct FrInputAir {
+    pub prog: Arc<Vec<FrInputProg>>,
+}
+air_boiler!(FrInputAir, 1, 4);
+
+impl FrInputAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.addr as u64),
+                    fu(p.mult),
+                    fu(p.konst.is_some() as u64),
+                    p.konst.unwrap_or(Fr::ZERO),
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 4, vec![Fr::ZERO; 4])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| vec![get(mem, p.addr).fr()])
+            .collect();
+        self.finish(rows_to_matrix(rows, self.prog.len(), 1, vec![Fr::ZERO]))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for FrInputAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_FR_INPUT, 1, 4);
+        let v = x[0].clone();
+        builder.assert_zero(p[2].clone() * (v.clone() - p[3].clone()));
+        builder.push_interaction(MEM_BUS, mem_msg(p[0].clone(), &[v]), p[1].clone(), 1);
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// PoseidonProgAir: program (main, after the other columns) [in_addr[3], out_addr[3], out_mult[3], active]; main = PoseidonFr row.
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct PermProg {
+    pub ins: [Addr; 3],
+    pub outs: [Addr; 3],
+    pub mults: [u64; 3],
+}
+
+#[derive(Clone, Debug)]
+pub struct PoseidonProgAir {
+    pub prog: Arc<Vec<PermProg>>,
+}
+air_boiler!(PoseidonProgAir, POSEIDON_WIDTH, 10);
+
+impl PoseidonProgAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r: Vec<Fr> = p.ins.iter().chain(&p.outs).map(|&a| fu(a as u64)).collect();
+                r.extend(p.mults.iter().map(|&m| fu(m)));
+                r.push(Fr::ONE);
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 10, vec![Fr::ZERO; 10])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| poseidon_row(p.ins.map(|a| get(mem, a).fr()), 0))
+            .collect();
+        self.finish(rows_to_matrix(
+            rows,
+            self.prog.len(),
+            POSEIDON_WIDTH,
+            poseidon_row([Fr::ZERO; 3], 0),
+        ))
+    }
+}
