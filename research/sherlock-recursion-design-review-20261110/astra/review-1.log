35:/-- The leaf statement `(prog_d, pre_d, post_d, h_pre, steps)` of the S-slot leaf (SRC-014). -/
36:structure Leaf (D : Type) where
37:  prog : D
38:  pre : D
39:  post : D
40:  hpre : Nat
41:  steps : Nat
42:  deriving DecidableEq, Repr
43:
44:variable {D : Type} [DecidableEq D]
45:
46:/-- The identity segment `(p, x, x, h, h)`: what a disabled slot contributes. -/
47:def ident (p x : D) (h : Nat) : Seg D := ⟨p, x, x, h, h⟩
48:
49:/-- `link a b` is defined iff the boundaries agree (design §3.6). -/
50:def link (a b : Seg D) : Option (Seg D) :=
51:  if a.prog = b.prog ∧ a.post = b.pre ∧ a.hi = b.lo then
52:    some ⟨a.prog, a.pre, b.post, a.lo, b.hi⟩
53:  else none
54:
55:/-- `link` lifted to optional operands; an undefined operand stays undefined. -/
56:def linkOpt : Option (Seg D) → Option (Seg D) → Option (Seg D)
57:  | some a, some b => link a b
58:  | _, _ => none
59:
60:/-- Left-to-right linkage of a non-empty segment sequence starting from `s`. -/
61:def linkFrom (s : Seg D) (l : List (Seg D)) : Option (Seg D) :=
62:  l.foldl (fun acc t ↦ linkOpt acc (some t)) (some s)
63:
64:/-- Left-to-right linkage of a segment sequence; the empty sequence has no statement. -/
65:def linkAll : List (Seg D) → Option (Seg D)
66:  | [] => none
67:  | s :: rest => linkFrom s rest
68:
69:/-- The segment a leaf certifies: `h_hi = h_pre + steps`. -/
70:def Leaf.seg (f : Leaf D) : Seg D := ⟨f.prog, f.pre, f.post, f.hpre, f.hpre + f.steps⟩
71:
72:/-- The certificate tree of the uniform three-slot node (`tree.md` F8). `off` is a disabled
73:slot; it is not a certificate (`stmt` refuses it) and only appears as a child. -/
74:inductive NodeCert (D : Type) where
75:  | off
76:  | node (left : NodeCert D) (leaf : Option (Leaf D)) (right : NodeCert D)
77:  deriving DecidableEq, Repr
78:
79:namespace NodeCert
80:
81:def isOff : NodeCert D → Bool
82:  | off => true
83:  | node _ _ _ => false
84:
85:/-- The leaf slot's contribution: nothing when disabled, the leaf segment when `1 ≤ steps ≤ S`,
86:refused otherwise. -/
87:def leafSlot (S : Nat) : Option (Leaf D) → Option (List (Seg D))
88:  | none => some []
89:  | some f => if 1 ≤ f.steps ∧ f.steps ≤ S then some [f.seg] else none
90:
91:/-- The node checker. A disabled self slot contributes nothing, a present one its own
92:statement (refused if it has none); the present contributions are linked in slot order
93:(left, leaf, right); an empty node has no statement. -/
94:def stmt (S : Nat) : NodeCert D → Option (Seg D)
95:  | off => none
96:  | node L f R =>
97:    match (if L.isOff then some [] else (L.stmt S).map ([·])), leafSlot S f,
98:        (if R.isOff then some [] else (R.stmt S).map ([·])) with
99:    | some ls, some fs, some rs => linkAll (ls ++ fs ++ rs)
100:    | _, _, _ => none
101:
102:/-- A self slot's contribution to its parent. -/
103:def slot (S : Nat) (c : NodeCert D) : Option (List (Seg D)) :=
104:  if c.isOff then some [] else (c.stmt S).map ([·])
105:
