380:impl Distribution<VerifierKey> for Standard {
381:    fn sample<R: Rng + ?Sized>(&self, rng: &mut R) -> VerifierKey {
382:        let size: u8 = rng.r#gen();
383:        let mut bytes = Vec::with_bounded_capacity(size as usize);
384:        rng.fill_bytes(&mut bytes);
385:        VerifierKey(Arc::new(Mutex::new(InnerVerifierKey::Uninitialized(bytes))))
386:    }
387:}
