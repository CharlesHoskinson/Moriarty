1316:    /// Constrain that Core selects `rule` on the pre carriers when `enable == 1`.
1317:    pub fn emit(
1318:        &mut self,
1319:        rule: RuleIdC,
1320:        inputs: &C6DispatchInputs,
1321:    ) -> Result<C6DispatchBlock, C6DispatchError> {
1322:        if !dispatch_supported(rule) {
1323:            return Err(C6DispatchError::Unsupported(rule));
1324:        }
1325:        Self::check_lengths(inputs)?;
1326:        let mut em = Em {
1327:            scope: self.scope.clone(),
1328:            next: self.next,
1329:            ins: Vec::new(),
1330:        };
1331:        em.cbool(inputs.enable.clone());
1332:        let facts = self.facts(&mut em, inputs)?;
1333:        let selected = Self::path(&mut em, &facts, rule)?;
1334:        em.gassert(inputs.enable.clone(), selected);
1335:        self.next = em.next;
1336:        Ok(C6DispatchBlock {
1337:            instructions: em.ins,
1338:        })
1339:    }
