175:/-- The premises of the composition theorems. Each field is a stated premise, not an axiom. -/
176:structure Premises (D : Type) where
177:  /-- Machine states of the general reference machine. -/
178:  State : Type
179:  /-- Committed programs. -/
180:  Prog : Type
181:  /-- Results read back by `acceptRun`. -/
182:  Result : Type
183:  /-- The reference machine's step relation, the program as parameter (SRC-017: one machine,
184:  every program). -/
185:  Step : Prog → State → State → Prop
186:  /-- Halted states. -/
187:  halted : State → Prop
188:  /-- The result of a halted state. -/
189:  result : State → Result
190:  /-- The state digest (Poseidon over the canonical carrier encoding). -/
191:  digest : State → D
192:  /-- The carrier domain: states with a canonical encoding, on which `digest` is injective. -/
193:  Carrier : State → Prop
194:  /-- The program digest `prog_d`. -/
195:  progDigest : Prog → D
196:  /-- Committed programs, on which `progDigest` is injective. -/
197:  Committed : Prog → Prop
198:  /-- The in-circuit leaf verifier accepts this leaf statement under the fixed leaf key. -/
199:  leafValid : Leaf D → Prop
200:  /-- Premise (collision resistance of the state digest on the carrier domain). -/
201:  digest_inj : ∀ s t, Carrier s → Carrier t → digest s = digest t → s = t
202:  /-- Premise (collision resistance of the program digest on committed programs). -/
203:  progDigest_inj : ∀ p q, Committed p → Committed q → progDigest p = progDigest q → p = q
204:  /-- Premise (leaf soundness, SAS O2 for the S-slot leaf, SVM-002), conditional as the mid-run
205:  leaf circuit enforces it: an accepted leaf statement names a committed program, and from every
206:  carrier state opening to `pre_d` there is a run of exactly `steps` machine steps to a carrier
207:  state opening to `post_d`. The leaf does not decode `pre_d` canonically (`decodeStep`, not
208:  `decodeCanonical`), so it does not assert that a carrier pre-state exists; the carrier property
209:  enters once, at genesis, and propagates (`sound_link`, `decider_pinning`). The former
210:  unconditional form implies this one (`leaf_sound_of_unconditional`). -/
211:  leaf_sound : ∀ f, leafValid f → ∃ p, Committed p ∧ progDigest p = f.prog ∧
212:    ∀ s, Carrier s → digest s = f.pre →
213:      ∃ t, Carrier t ∧ digest t = f.post ∧ Run (Step p) f.steps s t
214:
215:/-- Segment soundness, conditional on the pre-state (S5): for every committed program with
216:digest `s.prog` and every carrier state `a` opening to `s.pre`, a run of exactly `s.hi - s.lo`
217:steps from `a` to a carrier state opening to `s.post`. The decider discharges the condition at
218:genesis with the canonical initial state (`decider_pinning`). -/
219:def Sound (P : Premises D) (s : Seg D) : Prop :=
220:  s.lo ≤ s.hi ∧ ∀ p, P.Committed p → P.progDigest p = s.prog →
221:    ∀ a, P.Carrier a → P.digest a = s.pre →
222:      ∃ b, P.Carrier b ∧ P.digest b = s.post ∧ Run (P.Step p) (s.hi - s.lo) a b
223:
224:/-- The unconditional leaf premise of the first F21 draft (a carrier pre-state exists) implies the
225:conditional `Premises.leaf_sound`, given digest injectivity: the restatement only weakens the
226:premise. -/
1080:  (authenticated genesis, task 4.9); F21 takes `s₀` and `Carrier s₀` as hypotheses. -/
1081:
1082:/-- The decider's statement: a certified root that starts at genesis and whose final digest opens
1083:as a halted carrier state with result `r`. Each field is an obligation of the decider circuit
1084:(see the section note), not something F21 proves. -/
1085:structure Decided (P : Premises D) (S : Nat) (root : Seg D) (r : P.Result) : Prop where
1086:  cert : ∃ c, Certified S P.leafValid c root
1087:  genesis : root.lo = 0
1088:  halt : ∃ t, P.Carrier t ∧ P.digest t = root.post ∧ P.halted t ∧ P.result t = r
1089:
1090:/-- `acceptRun`'s reads: the root is pinned to the sealed program and initial state, and its
1091:`(h_hi, post_d)` are the published `(n_steps, fin_d)`. -/
1092:def AcceptRun (programD initD : D) (root : Seg D) (nSteps : Nat) (finD : D) : Prop :=
1093:  root.prog = programD ∧ root.pre = initD ∧ root.hi = nSteps ∧ root.post = finD
1094:
1095:/-- A root for another program is refused by `acceptRun`. -/
1096:theorem other_program_refused {programD initD : D} {root : Seg D} {nSteps : Nat} {finD : D}
1097:    (h : root.prog ≠ programD) : ¬ AcceptRun programD initD root nSteps finD :=
1098:  fun ha ↦ h ha.1
1099:
1100:/-- A root for another initial state is refused by `acceptRun`. -/
1101:theorem other_init_refused {programD initD : D} {root : Seg D} {nSteps : Nat} {finD : D}
1102:    (h : root.pre ≠ initD) : ¬ AcceptRun programD initD root nSteps finD :=
1103:  fun ha ↦ h ha.2.1
1104:
1105:/-- A root that does not start at genesis is never decided. -/
1106:theorem non_genesis_refused (P : Premises D) (S : Nat) (root : Seg D) (r : P.Result)
1107:    (h : root.lo ≠ 0) : ¬ Decided P S root r :=
1108:  fun hd ↦ h hd.genesis
1109:
1110:/-- **L6, decider pinning (conditional).** A decided root accepted by `acceptRun` for the sealed
1111:program `p` and a carrier state `s₀` opening to `initD` is a run of exactly `n_steps` steps of
1112:the general machine for `p` from `s₀` to a halted state whose digest is `fin_d` and whose result
1113:is `r`. `Carrier s₀` is the genesis condition that the conditional `Sound` propagates; that `s₀`
1114:is the canonical initial state of `p`, and every field of `Decided`, are the SRC-006/007 decider
1115:obligations listed above, outside F21. -/
1116:theorem decider_pinning (P : Premises D) (S : Nat) {root : Seg D} {r : P.Result}
1117:    (hd : Decided P S root r) {programD initD : D} {nSteps : Nat} {finD : D}
1118:    (ha : AcceptRun programD initD root nSteps finD) {p : P.Prog} (hp : P.Committed p)
1119:    (hpd : P.progDigest p = programD) {s₀ : P.State} (hs₀ : P.Carrier s₀)
1120:    (hd₀ : P.digest s₀ = initD) :
1121:    ∃ t, Run (P.Step p) nSteps s₀ t ∧ P.halted t ∧ P.result t = r ∧ P.digest t = finD := by
1122:  obtain ⟨c, hc⟩ := hd.cert
1123:  obtain ⟨hprog, hpre, hn, hfin⟩ := ha
1124:  obtain ⟨-, hsound⟩ := segment_sound P S c root hc
1125:  obtain ⟨b, hb, hdb, run⟩ := hsound p hp (hpd.trans hprog.symm) s₀ hs₀ (hd₀.trans hpre.symm)
1126:  obtain ⟨t, ht, hdt, hhalt, hr⟩ := hd.halt
1127:  have hbt : b = t := P.digest_inj b t hb ht (by rw [hdb, hdt])
1128:  subst hbt
1129:  refine ⟨b, ?_, hhalt, hr, hfin ▸ hdb⟩
1130:  rw [hd.genesis, Nat.sub_zero, hn] at run
1131:  exact run
1132:
1133:/-- The accepted result is the halted value of the unique trace: for a deterministic machine with
1134:terminal halted states, two decided roots for the same program and initial state publish the
1135:same `(n_steps, fin_d, result)` (replay and L-C). -/
1136:theorem result_unique (P : Premises D) (S₁ S₂ : Nat)
1137:    (det : ∀ p s t u, P.Step p s t → P.Step p s u → t = u)
1138:    (stuck : ∀ p t u, P.halted t → ¬ P.Step p t u)
1139:    {root₁ root₂ : Seg D} {r₁ r₂ : P.Result}
1140:    (hd₁ : Decided P S₁ root₁ r₁) (hd₂ : Decided P S₂ root₂ r₂)
1141:    {programD initD : D} {n₁ n₂ : Nat} {fin₁ fin₂ : D}
1142:    (ha₁ : AcceptRun programD initD root₁ n₁ fin₁) (ha₂ : AcceptRun programD initD root₂ n₂ fin₂)
1143:    {p : P.Prog} (hp : P.Committed p) (hpd : P.progDigest p = programD)
1144:    {s₀ : P.State} (hs₀ : P.Carrier s₀) (hd₀ : P.digest s₀ = initD) :
1145:    n₁ = n₂ ∧ fin₁ = fin₂ ∧ r₁ = r₂ := by
1146:  obtain ⟨t₁, run₁, halt₁, hr₁, hf₁⟩ := decider_pinning P S₁ hd₁ ha₁ hp hpd hs₀ hd₀
1147:  obtain ⟨t₂, run₂, halt₂, hr₂, hf₂⟩ := decider_pinning P S₂ hd₂ ha₂ hp hpd hs₀ hd₀
1148:  obtain ⟨hn, ht⟩ := Run.halt_unique (det p) (stuck p) run₁ halt₁ run₂ halt₂
1149:  subst ht
1150:  exact ⟨hn, hf₁ ▸ hf₂ ▸ rfl, hr₁ ▸ hr₂ ▸ rfl⟩
1151:
1152:/-- **L-C, statement independence from S.** The decider statement `(n_steps, fin_d, result)` of
1153:a program and initial state is the same at every S (here S₁ and S₂, e.g. 1 and 8). -/
1154:theorem statement_independent_of_S (P : Premises D) (S₁ S₂ : Nat)
1155:    (det : ∀ p s t u, P.Step p s t → P.Step p s u → t = u)
1156:    (stuck : ∀ p t u, P.halted t → ¬ P.Step p t u)
1157:    {root₁ root₂ : Seg D} {r₁ r₂ : P.Result}
1158:    (hd₁ : Decided P S₁ root₁ r₁) (hd₂ : Decided P S₂ root₂ r₂)
1159:    (hprog : root₁.prog = root₂.prog) (hpre : root₁.pre = root₂.pre)
1160:    {p : P.Prog} (hp : P.Committed p) (hpd : P.progDigest p = root₁.prog)
1161:    {s₀ : P.State} (hs₀ : P.Carrier s₀) (hd₀ : P.digest s₀ = root₁.pre) :
1162:    root₁.hi = root₂.hi ∧ root₁.post = root₂.post ∧ r₁ = r₂ :=
1163:  result_unique P S₁ S₂ det stuck hd₁ hd₂ ⟨rfl, rfl, rfl, rfl⟩ ⟨hprog.symm, hpre.symm, rfl, rfl⟩
1164:    hp hpd hs₀ hd₀
1165:
1166:/-! ## L5: height arithmetic without wrap -/
1167:
1168:/-- An alternative sufficient pair, not the circuit contract: `prev_h < 2^64 - S` with
1201:theorem src004_height_bridge (p S prevH steps h : Nat) (hp : 2 ^ 65 ≤ p)
1202:    (hprev : prevH < 2 ^ 64) (hsr : steps < 2 ^ 64) (hh : h < 2 ^ 64) (hs1 : 1 ≤ steps)
1203:    (hsS : steps ≤ S) (heq : (prevH + steps) % p = h) :
1204:    h = prevH + steps ∧ prevH + steps < 2 ^ 64 ∧ prevH < h ∧ h - prevH ≤ S := by
1205:  have e := field_eq_exact p prevH steps h hp hprev hsr heq
1206:  omega
1207:
1208:/-- Why `prev_h` itself needs the range check (Gemini IVC model, SRC-004 counterexample): without
1209:it a witness `prev_h = p - 1` makes the next field height `0`, which would set `is_genesis` mid
1210:chain; that witness is exactly one the `prev_h < 2^64` check refuses. -/
1211:theorem unchecked_prev_wraps_to_genesis (p : Nat) (hp : 2 ^ 65 ≤ p) :
1212:    ∃ prevH, prevH < p ∧ (prevH + 1) % p = 0 ∧ ¬ prevH < 2 ^ 64 :=
1213:  ⟨p - 1, by omega, by rw [show p - 1 + 1 = p by omega, Nat.mod_self], by omega⟩
1214:
1215:/-! ## L-D: genesis accumulator, SRC-005 realization (a)
1216:
1217:Lead decision 2026-11-09 (S1): at genesis both the previous-proof accumulator and the carried
1218:accumulator are scaled by the bit and collapsed to the trivial encoding before the fold, in
1219:circuit and off circuit. The algebra is stated at the encoding level: `accumulate` derives its
1220:challenge from the full encoding of every input (bases included), so a zero-scaled but
1221:uncollapsed input does not drop out of the fold. The first F21 draft's law
1222:`scale false a = zero` is retired; it fails in the encoding model `encModel`
1223:(`scale_false_law_fails`). Its replacement is the collapse-after-scale law
1224:`AccAlgebra.collapse_scale_false`. -/
1225:
1226:/-- The accumulator algebra as premises, at the encoding level. `trivial` is `trivial_acc`
1227:(identity base, scalar one, zero fixed scalars); `accumulate` is `Accumulator::accumulate`;
1228:`valid` is the final pairing check (`Accumulator::check`). No law lets an input drop out of
1229:`accumulate`. -/
1230:structure AccAlgebra (A : Type) where
1231:  trivial : A
1232:  accumulate : List A → A
1233:  scale : Bool → A → A
1234:  scale_true : ∀ a, scale true a = a
1235:  collapse : A → A
1236:  /-- Collapse after scale: a zero-scaled accumulator collapses to the trivial encoding, whatever
1237:  bases it was parsed with (`AssignedAccumulator::collapse` after `scale_by_bit`, SHKIVC05). -/
1238:  collapse_scale_false : ∀ a, collapse (scale false a) = trivial
1239:  valid : A → Prop
1240:  valid_collapse : ∀ a, valid (collapse a) ↔ valid a
1241:  valid_trivial : valid trivial
1242:  /-- Fold soundness and completeness (SRC-005/006 premise): the fold passes the pairing check iff
1243:  every input does. -/
1244:  valid_accumulate : ∀ l, valid (accumulate l) ↔ ∀ a ∈ l, valid a
1245:
1246:/-- The node fold of realization (a): the previous-proof and the carried accumulator, each
1247:scaled by `not_genesis` and collapsed, then the leaf accumulator; the result is collapsed. -/
1248:def AccAlgebra.nodeFold {A : Type} (alg : AccAlgebra A) (notGenesis : Bool)
1249:    (proofAcc carried leaf : A) : A :=
1250:  alg.collapse (alg.accumulate
1251:    [alg.collapse (alg.scale notGenesis proofAcc), alg.collapse (alg.scale notGenesis carried),
1252:      leaf])
1253:
1254:/-- **L-D, SRC-005 genesis (realization (a)).** At genesis (`not_genesis = 0`) both the
1255:previous-proof accumulator and the carried accumulator collapse to the trivial encoding before
1256:the fold. The folded accumulator therefore equals the fold of `[trivial, trivial, leaf]`: it does
1257:not depend on either witness-supplied accumulator (nor, therefore, does the fold challenge), and
1258:it passes the pairing check iff the leaf accumulator does, so no unauthenticated deferred
1259:obligation enters at genesis. Task 2.3 cites this lemma. -/
1260:theorem genesis_collapse_both {A : Type} (alg : AccAlgebra A) (proofAcc carried leaf : A) :
1261:    alg.nodeFold false proofAcc carried leaf =
1262:      alg.collapse (alg.accumulate [alg.trivial, alg.trivial, leaf]) ∧
1263:    (alg.valid (alg.nodeFold false proofAcc carried leaf) ↔ alg.valid leaf) := by
1264:  have h : alg.nodeFold false proofAcc carried leaf =
1265:      alg.collapse (alg.accumulate [alg.trivial, alg.trivial, leaf]) := by
1266:    simp only [AccAlgebra.nodeFold, alg.collapse_scale_false]
1267:  refine ⟨h, ?_⟩
1268:  rw [h, alg.valid_collapse, alg.valid_accumulate]
1269:  constructor
1270:  · intro hall
1271:    exact hall leaf (by simp)
1272:  · intro hl a ha
1273:    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
1274:    rcases ha with rfl | rfl | rfl
1275:    · exact alg.valid_trivial
1276:    · exact alg.valid_trivial
1277:    · exact hl
1278:
1279:/-- Genesis witness independence: two genesis nodes with the same leaf accumulator fold to the
1280:same accumulator, whatever previous-proof and carried accumulators the prover supplies. -/
1281:theorem genesis_witness_independent {A : Type} (alg : AccAlgebra A)
1282:    (proofAcc carried proofAcc' carried' leaf : A) :
1283:    alg.nodeFold false proofAcc carried leaf = alg.nodeFold false proofAcc' carried' leaf := by
1284:  rw [(genesis_collapse_both alg proofAcc carried leaf).1,
1285:    (genesis_collapse_both alg proofAcc' carried' leaf).1]
1286:
1287:/-- Off genesis (`not_genesis = 1`) the previous-proof and the carried accumulator are folded
1288:(collapsed, so with their canonical encodings), and the fold passes the pairing check iff all
1289:three inputs do. -/
1290:theorem non_genesis_keeps_both {A : Type} (alg : AccAlgebra A) (proofAcc carried leaf : A) :
1291:    alg.nodeFold true proofAcc carried leaf =
1292:      alg.collapse (alg.accumulate [alg.collapse proofAcc, alg.collapse carried, leaf]) ∧
1293:    (alg.valid (alg.nodeFold true proofAcc carried leaf) ↔
1294:      alg.valid proofAcc ∧ alg.valid carried ∧ alg.valid leaf) := by
1295:  have h : alg.nodeFold true proofAcc carried leaf =
1296:      alg.collapse (alg.accumulate [alg.collapse proofAcc, alg.collapse carried, leaf]) := by
1297:    simp only [AccAlgebra.nodeFold, alg.scale_true]
1298:  refine ⟨h, ?_⟩
1299:  rw [h, alg.valid_collapse, alg.valid_accumulate]
1300:  constructor
1301:  · intro hall
1302:    refine ⟨?_, ?_, hall leaf (by simp)⟩
1303:    · exact (alg.valid_collapse _).mp (hall _ (by simp))
1304:    · exact (alg.valid_collapse _).mp (hall _ (by simp))
1305:  · rintro ⟨hp, hc, hl⟩ a ha
1306:    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
1307:    rcases ha with rfl | rfl | rfl
1308:    · exact (alg.valid_collapse _).mpr hp
1309:    · exact (alg.valid_collapse _).mpr hc
1381:def linNode (S : Nat) (prev : LinStmt D) (f : Leaf D) : Option (LinStmt D) :=
1382:  if f.prog = prev.prog ∧ f.pre = prev.cur ∧ f.hpre = prev.h ∧ 1 ≤ f.steps ∧ f.steps ≤ S ∧
1383:      (prev.h = 0 → prev.cur = prev.init) then
1384:    some ⟨prev.prog, prev.init, f.post, prev.h + f.steps⟩
1385:  else none
1386:
1387:theorem linNode_eq_some {S : Nat} {prev st : LinStmt D} {f : Leaf D} :
1388:    linNode S prev f = some st ↔
1389:      (f.prog = prev.prog ∧ f.pre = prev.cur ∧ f.hpre = prev.h ∧ 1 ≤ f.steps ∧ f.steps ≤ S ∧
1390:        (prev.h = 0 → prev.cur = prev.init)) ∧
1391:      st = ⟨prev.prog, prev.init, f.post, prev.h + f.steps⟩ := by
1392:  unfold linNode
1393:  split
1394:  · rename_i hc
1395:    constructor
1396:    · intro h; cases h; exact ⟨hc, rfl⟩
1397:    · rintro ⟨-, rfl⟩; rfl
1398:  · rename_i hc
1399:    constructor
1400:    · intro h; cases h
1401:    · rintro ⟨h, -⟩; exact absurd h hc
1402:
1403:/-- An accepted linear node proof. The previous node proof is verified only off genesis: at
1404:`prev.h = 0` it is scaled away (`scale_by_bit` with `not_genesis`) and the previous statement is
1405:witness data; at `prev.h ≠ 0` the previous statement is that of an accepted node proof
1406:(the cryptographic premise of `AggregationAxioms.lean`). -/
1407:inductive LinCert (S : Nat) (leafValid : Leaf D → Prop) : LinStmt D → Prop where
1408:  | mk {prev st : LinStmt D} (f : Leaf D) :
1409:      (prev.h ≠ 0 → LinCert S leafValid prev) → leafValid f → linNode S prev f = some st →
1410:      LinCert S leafValid st
1411:
1412:/-- An accepted linear node statement has a positive height. -/

