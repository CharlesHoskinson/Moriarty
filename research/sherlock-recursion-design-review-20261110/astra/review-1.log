401:pub(crate) enum InnerVerifierKey {
402:    Uninitialized(Vec<u8>),
403:    Invalid(Vec<u8>),
404:    /// Parsed key alongside the original bytes it was decoded from, so that
405:    /// serialization stays a function of the value and does not change when a
406:    /// key is initialized in place (initialization is shared across clones via
407:    /// the `Arc<Mutex>`).
408:    Initialized(MidnightVK, Vec<u8>),
409:}
410:
411:impl Clone for VerifierKey {
412:    fn clone(&self) -> Self {
413:        Self(self.0.clone())
414:    }
415:}
416:
417:impl Deserializable for VerifierKey {
418:    fn deserialize(
419:        reader: &mut impl std::io::Read,
420:        recursion_depth: u32,
421:    ) -> Result<Self, std::io::Error> {
422:        const MAX_EXPECTED_SIZE: usize = 50_000;
423:        let buf = <Vec<u8> as Deserializable>::deserialize(reader, recursion_depth)?;
424:        if buf.len() > MAX_EXPECTED_SIZE {
425:            return Err(std::io::Error::new(
426:                std::io::ErrorKind::InvalidData,
427:                format!(
428:                    "Declared vk size {} exceeded permitted limit of {MAX_EXPECTED_SIZE}",
429:                    buf.len()
430:                ),
431:            ));
432:        }
433:        Ok(Self(Arc::new(Mutex::new(InnerVerifierKey::Uninitialized(
434:            buf,
435:        )))))
436:    }
437:}
