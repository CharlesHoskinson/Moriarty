129:fn dir_leaves(dir: PathBuf) -> Leaves {
130:    let vk = vk_from_bytes(&fs::read(dir.join("leaf.vk")).unwrap()).unwrap();
131:    let mut names: Vec<_> = fs::read_dir(&dir)
132:        .unwrap()
133:        .map(|e| e.unwrap().file_name().into_string().unwrap())
134:        .filter(|n| n.starts_with("step-"))
135:        .collect();
136:    names.sort();
137:    let steps = names
138:        .iter()
139:        .map(|n| {
140:            let d = dir.join(n);
141:            (
142:                read_fs(d.join("leaf.instance.json")),
143:                fs::read(d.join("leaf.proof")).unwrap(),
144:            )
145:        })
146:        .collect();
147:    let fin: Value = serde_json::from_slice(&fs::read(dir.join("final.json")).unwrap()).unwrap();
148:    Leaves {
149:        vk,
150:        steps,
151:        result: fin["result"].as_str().unwrap().parse().unwrap(),
152:        lanes_d: f_from_hex(fin["lanes_d"].as_str().unwrap()).unwrap(),
153:    }
154:}
