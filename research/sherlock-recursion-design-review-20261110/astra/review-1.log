389:impl From<MidnightVK> for VerifierKey {
390:    fn from(vk: MidnightVK) -> Self {
391:        let mut raw = Vec::new();
392:        vk.write(&mut raw, SerdeFormat::Processed)
393:            .expect("in-memory serialize");
394:        VerifierKey(Arc::new(Mutex::new(InnerVerifierKey::Initialized(vk, raw))))
395:    }
396:}
