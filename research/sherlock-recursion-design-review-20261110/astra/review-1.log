1838:            return Err(MalformedTransaction::MalformedContractDeploy(
1839:                MalformedContractDeploy::TooManyOperations {
1840:                    operations,
1841:                    limit: MAX_CONTRACT_OPERATIONS,
1842:                },
1843:            ));
1844:        }
1845:        self.initial_state.well_formed(self.address())?;
1846:
1847:        // Or we could change the types. Current (pre-this-ticket) ContractState could be renamed to
1848:        // `DeployContractState`, and the new version with `balance` could be called ContractState
1849:        // `ContractDeploy` would contain `DeployContractState`. Then, this check isn't required.
1850:        if self.initial_state.balance.iter().any(|bal| *bal.1 > 0) {
1851:            let mut err_data = std::collections::BTreeMap::new();
1852:            for val in self.initial_state.balance.clone().iter() {
1853:                err_data.insert(*val.0, *val.1);
1854:            }
1855:            return Err(MalformedTransaction::<D>::MalformedContractDeploy(
1856:                MalformedContractDeploy::NonZeroBalance(err_data),
1857:            ));
1858:        }
1859:        let rechecked_state = ChargedState::new((*self.initial_state.data.get()).clone());
1860:        if rechecked_state != self.initial_state.data {
1861:            return Err(MalformedTransaction::<D>::MalformedContractDeploy(
1862:                MalformedContractDeploy::IncorrectChargedState,
1863:            ));
1864:        }
1865:        ref_state.param_check(false, |params| {
1866:            let limit = params.limits.max_contract_metadata_size;
1867:            if let Err(e) = check_entry_point_metadata_sizes(&self.initial_state, limit) {
1868:                return Err(MalformedTransaction::MalformedContractDeploy(match e {
1869:                    MetadataSizeError::EntryPoint(entry_point, size) => {
1870:                        MalformedContractDeploy::MetadataTooLarge {
1871:                            entry_point,
1872:                            size,
1873:                            limit,
1874:                        }
1875:                    }
1876:                    MetadataSizeError::Authority(size) => {
1877:                        MalformedContractDeploy::AuthorityMetadataTooLarge { size, limit }
1878:                    }
1879:                }));
1880:            }
1881:            Ok(())
1882:        })?;
1883:        Ok(())
1884:    }
