556:        sections.prog_lanes..sections.prog_lanes + sections.pre_lanes,
557:    ));
558:    let pre_lanes_d = hash(&mut body, "prelanes", pre_carrier);
559:    let pre_dom = const_lane(&mut body, "pre.dom", dom("SHK_SD"));
560:    let pre_tag = const_lane(&mut body, "pre.tag", Fr::from(pre_outcome.tag));
561:    let pre_val = const_lane(&mut body, "pre.value", Fr::from(pre_outcome.value));
562:    let pre_d = hash(
563:        &mut body,
564:        "pre",
565:        vec![pre_dom, pre_tag, pre_val, pre_lanes_d],
566:    );
567:    let mut post_carrier = section(0..sections.prog_lanes);
568:    post_carrier.extend(section(sections.prog_lanes + sections.pre_lanes..total));
569:    let post_lanes_d = hash(&mut body, "postlanes", post_carrier);
570:    let post_dom = const_lane(&mut body, "post.dom", dom("SHK_SD"));
571:    let post_tag = const_lane(&mut body, "post.tag", Fr::from(post_outcome.tag));
572:    let post_val = const_lane(&mut body, "post.value", Fr::from(post_outcome.value));
573:    let post_d = hash(
574:        &mut body,
575:        "post",
576:        vec![post_dom, post_tag, post_val, post_lanes_d],
577:    );
578:    // Public lanes come after the body: the VM executes in order, so the
579:    // digests must be computed before the ConstrainEq that ties them.
580:    let mut head = body;
581:    let mut tail = Vec::new();
582:    for (i, digest) in [prog_d, pre_d, post_d].into_iter().enumerate() {
583:        let id = midnight_zkir_v3::Identifier(format!("%c6.public.digest.{i}"));
584:        tail.push(Instruction::PublicInput {
585:            guard: None,
586:            val_t: midnight_zkir_v3::ir_types::IrType::Native,
587:            output: id.clone(),
588:        });
589:        tail.push(Instruction::Impact {
590:            guard: Operand::Immediate(Fr::from(1u64)),
591:            inputs: vec![Operand::Variable(id.clone())],
592:        });
593:        tail.push(Instruction::ConstrainEq {
594:            a: Operand::Variable(id),
595:            b: digest,
596:        });
597:    }
598:    for (i, lane) in ["rule", "h"].into_iter().enumerate() {
599:        let id = midnight_zkir_v3::Identifier(format!("%c6.public.{lane}"));
600:        tail.push(Instruction::PublicInput {
601:            guard: None,
602:            val_t: midnight_zkir_v3::ir_types::IrType::Native,
603:            output: id.clone(),
604:        });
605:        tail.push(Instruction::Impact {
606:            guard: Operand::Immediate(Fr::from(1u64)),
607:            inputs: vec![Operand::Variable(id)],
608:        });
609:        let _ = i;
610:    }
611:    head.extend(tail);
612:    Ok(IrSource {
613:        version: ir.version.clone(),
614:        inputs: Vec::new(),
615:        outputs: Vec::new(),
616:        do_communications_commitment: false,
617:        instructions: std::sync::Arc::new(head),
618:    })
619:}
620:
802:pub fn prepare_digest_c6_child(
803:    ir: &IrSource,
804:    rule_id: &str,
805:    statement: &[u128],
806:    sections: DigestSections,
807:    pre_outcome: StateOutcome,
808:    post_outcome: StateOutcome,
809:    height: u64,
810:) -> Result<C6DigestPrepared, Error> {
811:    if rule_id.trim().is_empty() {
812:        return Err(error("sherlock-c6-child", "Empty C6 rule id."));
813:    }
814:    refuse_private_or_guarded(ir)?;
815:    let relation = c6_child_relation(ir, sections, pre_outcome, post_outcome)?;
816:    let digests = statement_digests(statement, sections, pre_outcome, post_outcome)?;
817:    let public_statement = [
818:        digests[0],
819:        digests[1],
820:        digests[2],
821:        rule_lane(rule_id),
822:        Fr::from(height),
823:    ];
824:    let base = prepare_c6_child(ir, rule_id, statement)?;
825:    // The digest relation, not the raw-lane relation, sets the circuit degree.
826:    let mut claim = base.claim;
827:    claim.circuit_k = relation.k();
828:    let binding = c6_child_binding(&claim)?;
829:    // The ZKIR circuit pushes the binding as its first public input (as
830:    // for A102), so the instance is the binding followed by the five lanes
831:    // the node consumes.
832:    let instance = std::iter::once(binding)
833:        .chain(public_statement.iter().copied())
834:        .collect();
835:    Ok(C6DigestPrepared {
836:        claim,
837:        binding,
838:        instance,
839:        public_statement,
840:        statement: statement.to_vec(),
841:        pre_outcome,
842:        post_outcome,
843:        ir: relation,
844:    })
845:}
846:
560:
561:        // 5. Fold, collapse, publish.
562:        let mut next = verifier.accumulate(l, &[proof_acc, prev_acc, leaf_acc])?;
563:        next.collapse(l, bls, scalar)?;
564:        verifier.constrain_as_public_input(l, &next)
565:    }
566:
567:    fn used_chips(&self) -> ZkStdLibArch {
568:        bls_arch(self.nr_cols)
569:    }
570:
571:    fn write_relation<W: io::Write>(&self, w: &mut W) -> io::Result<()> {
572:        w.write_all(MAGIC)?;
573:        w.write_all(&[self.nr_cols])?;
574:        w.write_all(&self.self_k.to_le_bytes())?;
575:        write_bytes(w, &vk_bytes(&self.leaf_vk))
576:    }
577:
578:    fn read_relation<R: io::Read>(r: &mut R) -> io::Result<Self> {
579:        let mut magic = [0u8; 8];
580:        r.read_exact(&mut magic)?;
581:        if &magic != MAGIC {
582:            return Err(io::Error::other("not a SHKIVC06 node relation"));
583:        }
584:        let mut b = [0u8; 1];
585:        r.read_exact(&mut b)?;
586:        let k = read_u32(r)?;
587:        let leaf = vk_from_bytes(&read_bytes(r, 1 << 20)?)?;
588:        Self::new(b[0], k, leaf)
589:    }
590:}
