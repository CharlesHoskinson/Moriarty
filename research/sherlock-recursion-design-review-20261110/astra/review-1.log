535:// Q-C: leaf workers ahead of the node chain under the 48 GB per-process and 100 GB aggregate
536:// caps (prover.md F11, §6b Q-C; design §3.5 lever 3, SRC-016 E11). One node chain, P leaf
537:// workers, memory in GB as recorded peaks. Admission reserves room for the node so the chain
538:// is never starved by look-ahead leaves.
539:module leaf_scheduler {
540:  const P: int        // leaf workers
541:  const N: int        // leaves (= chain nodes) of the run
542:  const LEAF_GB: int  // recorded leaf peak
543:  const NODE_GB: int  // recorded node peak
544:
545:  pure val PROC_CAP = 48
546:  pure val AGG_CAP = 100
547:  pure val IDX = 0.to(N - 1)
548:
549:  type Phase = Idle | Proving | Proved
550:  type Sched = { leaf: int -> Phase, node: int -> Phase }
551:  var w: Sched
552:
553:  pure def count(m: int -> Phase, ph: Phase): int = IDX.filter(i => m.get(i) == ph).size()
554:  pure def inflight(x: Sched): int = count(x.leaf, Proving) * LEAF_GB + count(x.node, Proving) * NODE_GB
555:  pure def nodeReserve(x: Sched): int = if (count(x.node, Proving) == 0 and count(x.node, Proved) < N) NODE_GB else 0
556:  pure def done(x: Sched): bool = count(x.node, Proved) == N
557:
558:  pure def canStartLeaf(x: Sched, i: int): bool = and {
559:    x.leaf.get(i) == Idle, count(x.leaf, Proving) < P, LEAF_GB <= PROC_CAP,
560:    inflight(x) + LEAF_GB + nodeReserve(x) <= AGG_CAP,
561:  }
562:  pure def canFinishLeaf(x: Sched, i: int): bool = x.leaf.get(i) == Proving
563:  pure def nodeReady(x: Sched, i: int): bool = and {
564:    x.node.get(i) == Idle, x.leaf.get(i) == Proved, i == 0 or x.node.get(i - 1) == Proved }
565:  pure def canStartNode(x: Sched, i: int): bool = and {
566:    nodeReady(x, i), count(x.node, Proving) == 0, NODE_GB <= PROC_CAP,
567:    inflight(x) + NODE_GB <= AGG_CAP,
568:  }
569:  pure def canFinishNode(x: Sched, i: int): bool = x.node.get(i) == Proving
570:  pure def someEnabled(x: Sched): bool = IDX.exists(i => or {
571:    canStartLeaf(x, i), canFinishLeaf(x, i), canStartNode(x, i), canFinishNode(x, i) })
572:
573:  action init = w' = { leaf: IDX.mapBy(_ => Idle), node: IDX.mapBy(_ => Idle) }
574:  action startLeaf(i: int): bool = all { canStartLeaf(w, i), w' = { ...w, leaf: w.leaf.set(i, Proving) } }
575:  action finishLeaf(i: int): bool = all { canFinishLeaf(w, i), w' = { ...w, leaf: w.leaf.set(i, Proved) } }
576:  action startNode(i: int): bool = all { canStartNode(w, i), w' = { ...w, node: w.node.set(i, Proving) } }
577:  action finishNode(i: int): bool = all { canFinishNode(w, i), w' = { ...w, node: w.node.set(i, Proved) } }
578:  action step = {
579:    nondet i = IDX.oneOf()
580:    any { startLeaf(i), finishLeaf(i), startNode(i), finishNode(i) }
581:  }
582:
583:  // Q-C properties
584:  pure def aggregateOk(x: Sched): bool = inflight(x) <= AGG_CAP
585:  pure def processOk(x: Sched): bool = and {
586:    count(x.leaf, Proving) == 0 or LEAF_GB <= PROC_CAP,
587:    count(x.node, Proving) == 0 or NODE_GB <= PROC_CAP,
588:    count(x.leaf, Proving) <= P, count(x.node, Proving) <= 1,
589:  }
590:  // node i never starts before leaf i is proved and node i-1 is proved
591:  pure def orderOk(x: Sched): bool = IDX.forall(i => x.node.get(i) == Idle or and {
592:    x.leaf.get(i) == Proved, i == 0 or x.node.get(i - 1) == Proved })
593:  // no deadlock: while the chain is unfinished some action is enabled
594:  pure def progressOk(x: Sched): bool = done(x) or someEnabled(x)
595:  // the node chain is never starved by look-ahead leaves
596:  pure def nodeAdmissible(x: Sched): bool = IDX.forall(i => not(nodeReady(x, i)) or canStartNode(x, i))
597:  pure def schedOk(x: Sched): bool = aggregateOk(x) and processOk(x) and orderOk(x) and progressOk(x) and nodeAdmissible(x)
598:
599:  val QC_aggregate = aggregateOk(w)
600:  val QC_process = processOk(w)
601:  val QC_order = orderOk(w)
602:  val QC_progress = progressOk(w)
603:  val QC_nodeAdmissible = nodeAdmissible(w)
604:  val QC_all = schedOk(w)
605:  val wAllFolded = done(w)
606:  val wParallelLeaves = count(w.leaf, Proving) >= 2
607:  val wNodeAndLeaves = count(w.node, Proving) == 1 and count(w.leaf, Proving) >= 1
608:}
