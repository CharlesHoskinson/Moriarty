54:        // Largest root of unity exponent of the Engine is `2^E::Fr::S`, so we can
55:        // only support FFTs of polynomials below degree `2^E::Fr::S`.
56:        assert!(k <= E::Fr::S);
57:        let n: u64 = 1 << k;
58:
59:        // Calculate g = [G1, [s] G1, [s^2] G1, ..., [s^(n-1)] G1] in parallel.
60:        let g1 = E::G1::generator();
61:        let s = <E::Fr>::random(rng);
62:
63:        let mut g = vec![E::G1::identity(); n as usize];
64:        parallelize(&mut g, |g, start| {
65:            let mut current_g: E::G1 = g1;
66:            current_g *= s.pow_vartime([start as u64]);
67:            for g in g.iter_mut() {
68:                *g = current_g;
69:                current_g *= s;
70:            }
71:        });
