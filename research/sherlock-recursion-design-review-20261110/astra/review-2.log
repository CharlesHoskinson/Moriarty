81:            for (idx, g) in g.iter_mut().enumerate() {
82:                let offset = start + idx;
83:                let root_pow = root.pow_vartime([offset as u64]);
84:                let scalar = multiplier * root_pow * (s - root_pow).invert().unwrap();
