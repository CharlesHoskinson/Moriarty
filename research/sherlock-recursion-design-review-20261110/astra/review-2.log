63:        ZkStdLibArch {
64:            poseidon: true,
65:            ..ZkStdLibArch::default()
66:        }
67:    }
68:    fn write_relation<W: io::Write>(&self, w: &mut W) -> io::Result<()> {
69:        w.write_all(b"SHKSTND1")
70:    }
