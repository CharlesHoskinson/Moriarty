75:        for _ in k..E::Fr::S {
76:            root = root.square();
77:        }
78:        let n_inv = E::Fr::from(n).invert().expect("inversion should be ok for n = 1<<k");
79:        let multiplier = (s.pow_vartime([n]) - E::Fr::ONE) * n_inv;
