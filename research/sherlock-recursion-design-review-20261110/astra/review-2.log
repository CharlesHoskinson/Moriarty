29:pub fn standin_body(prog_d: F, pre_d: F, rule: F, h_pre: F) -> F {
30:    poseidon(&[prog_d, pre_d, rule, h_pre])
31:}
32:
33:impl Relation for StandInLeaf {
34:    type Instance = Vec<F>;
35:    type Witness = StandInWitness;
36:    type Error = Error;
37:    fn format_instance(i: &Vec<F>) -> Result<Vec<F>, Error> {
38:        Ok(i.clone())
39:    }
40:    fn circuit(
41:        &self,
42:        std: &ZkStdLib,
43:        l: &mut impl Layouter<F>,
44:        _i: Value<Vec<F>>,
45:        w: Value<Vec<F>>,
46:    ) -> Result<(), Error> {
47:        let mut v: Vec<AssignedNative<F>> = Vec::new();
48:        // Lane 0 is the binding (unconstrained here), then the 5 statement lanes and the
49:        // step count (unconstrained here; a real leaf proves exactly that many steps).
50:        for i in 0..7 {
51:            let x: AssignedNative<F> = std.assign(l, w.as_ref().map(|w| w[i]))?;
52:            std.constrain_as_public_input(l, &x)?;
53:            v.push(x);
54:        }
55:        let body = std.poseidon(l, &[v[1].clone(), v[2].clone(), v[4].clone(), v[5].clone()])?;
56:        let d: AssignedNative<F> = std.assign_fixed(l, dom(DOM_STATE_D))?;
57:        let tag: AssignedNative<F> = std.assign(l, w.as_ref().map(|w| w[7]))?;
58:        let val: AssignedNative<F> = std.assign(l, w.as_ref().map(|w| w[8]))?;
59:        let post = std.poseidon(l, &[d, tag, val, body])?;
60:        std.assert_equal(l, &post, &v[3])
61:    }
