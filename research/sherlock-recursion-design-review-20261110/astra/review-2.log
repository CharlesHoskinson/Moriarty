235:pub struct ParamsVerifierKZG<E: MultiMillerLoop> {
236:    pub(crate) s_g2: E::G2,
237:    pub(crate) n_g2_prepared: E::G2Prepared,
238:    pub(crate) s_g2_prepared: E::G2Prepared,
239:}
240:
241:impl<E: MultiMillerLoop + Debug> ParamsVerifierKZG<E>
242:where
243:    E::G2: Curve + ProcessedSerdeObject,
244:{
245:    /// Returns \[τ\]₂, a commitment to τ in G2.
246:    pub fn s_g2(&self) -> E::G2 {
247:        self.s_g2
248:    }
249:
250:    /// Writes parameters to buffer
251:    pub fn write<W: io::Write>(&self, writer: &mut W, format: SerdeFormat) -> io::Result<()> {
252:        self.s_g2.write(writer, format)?;
253:        Ok(())
254:    }
255:
256:    /// Reads params from a buffer.
257:    pub fn read<R: io::Read>(reader: &mut R, format: SerdeFormat) -> io::Result<Self> {
258:        let s_g2 = E::G2::read(reader, format)?;
259:        let s_g2_prepared = E::G2Prepared::from(s_g2.into());
260:        let n_g2_prepared = E::G2Prepared::from(-E::G2Affine::generator());
261:
262:        Ok(Self {
263:            s_g2,
264:            n_g2_prepared,
265:            s_g2_prepared,
266:        })
267:    }
268:}
269:
270:impl<E: MultiMillerLoop + Debug> ParamsKZG<E> {
271:    /// Consume the prover parameters into verifier parameters. Need to specify
272:    /// the size of public inputs.
273:    pub fn verifier_params(&self) -> ParamsVerifierKZG<E> {
274:        let n_g2_prepared = E::G2Prepared::from((-self.g2).into());
275:        let s_g2_prepared = E::G2Prepared::from(self.s_g2.into());
276:        ParamsVerifierKZG {
277:            s_g2: self.s_g2,
278:            n_g2_prepared,
279:            s_g2_prepared,
280:        }
281:    }
