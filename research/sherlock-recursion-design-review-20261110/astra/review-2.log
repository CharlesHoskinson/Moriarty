72:        let mut b = [0u8; 8];
73:        r.read_exact(&mut b)?;
74:        if &b != b"SHKSTND1" {
75:            return Err(io::Error::other("not the stand-in leaf"));
76:        }
77:        Ok(StandInLeaf)
78:    }
