228:/// Count the rows of `relation` and break them down by gadget. Fails when the copy drifts
229:/// from the node circuit (the unmarked probe and the node disagree on rows).
230:pub fn node_row_breakdown(relation: &SherlockIvcRelation) -> io::Result<NodeRows> {
231:    let k = relation.self_k;
232:    let model = cost_model(relation, Some(k));
233:    let self_cs = node_cs(relation.nr_cols, k);
234:    let mut probe = NodeRowProbe {
235:        nr_cols: relation.nr_cols,
236:        leaf_vk: relation.leaf_vk.clone(),
237:        leaf_name: relation.leaf_name(),
238:        self_base_names: relation.self_base_names(),
239:        neutral: <AssignedAccumulator<S> as Instantiable<F>>::as_public_input(
240:            &relation.trivial_acc(),
241:        ),
242:        carry_lanes: relation.carry_scalar_lanes(),
243:        self_domain: EvaluationDomain::new(self_cs.degree() as u32, k),
244:        self_cs,
245:        measured: None,
246:    };
247:    let copy = cost_model(&probe, Some(k));
248:    if copy.rows != model.rows {
249:        return Err(io::Error::other(format!(
250:            "node row probe drifted from ivc.rs: probe {} rows, node {} rows",
251:            copy.rows, model.rows
252:        )));
253:    }
254:    let mut sections = Vec::new();
255:    for (index, name) in SECTIONS.iter().enumerate() {
256:        probe.measured = Some(index);
257:        sections.push((*name, cost_model(&probe, Some(k)).rows));
258:    }
259:    let spans: usize = sections.iter().map(|(_, r)| r).sum();
260:    Ok(NodeRows {
261:        k,
262:        model_k: model.k,
263:        rows: model.rows,
264:        table_rows: model.table_rows,
265:        unusable_rows: model.nb_unusable_rows,
266:        sections,
267:        other_rows: model.rows as i64 - spans as i64,
268:    })
