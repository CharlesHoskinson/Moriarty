 #[allow(dead_code)]
 fn _is_field<T: Field>() {}
 
+// ---------------------------------------------------------------- N1: the h_hi range table
+/// T10 (lead ruling on T7 pick 9): the 16-bit table of the N1 layer, `[value, mult]`, one row
+/// per value `0 .. 2^16` (the last-row constraint pins the height). It receives `[x]` on
+/// [`HHI_RANGE_BUS`] with multiplicity `mult`; the First statement AIR looks up each of the four
+/// `h_hi` limbs of every enabled row, so `h_hi = h_pre + steps` holds over the integers.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct HhiRangeAir;
+pub const HHI_RANGE_ROWS: usize = 1 << 16;
+
+impl<T> BaseAir<T> for HhiRangeAir {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for HhiRangeAir {}
+impl<T> PartitionedBaseAir<T> for HhiRangeAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for HhiRangeAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).expect("row"), main.row_slice(1).expect("next"));
+        let (v, m, nv): (AB::Expr, AB::Expr, AB::Expr) = (lr[0].clone().into(), lr[1].clone().into(), nr[0].clone().into());
+        drop((lr, nr));
+        builder.when_first_row().assert_zero(v.clone());
+        builder.when_transition().assert_eq(nv, v.clone() + AB::Expr::ONE);
+        builder.when_last_row().assert_eq(v.clone(), AB::Expr::from_u32((HHI_RANGE_ROWS - 1) as u32));
+        builder.push_interaction(HHI_RANGE_BUS, [v], -m, 1);
+    }
+}
+
+/// The [`HhiRangeAir`] trace for a First statement trace `tr`: one count per `h_hi` limb of each
+/// enabled row. A limb of 2^16 or more (no valid witness has one; a refusal case) is not
+/// counted, so the lookup is unbalanced.
+pub fn hhi_range_trace(tr: &RowMajorMatrix<F>) -> RowMajorMatrix<F> {
+    let c = Cols::new(&Kind::First);
+    assert_eq!(tr.width(), c.width, "a First statement trace");
+    let mut cnt = vec![0u32; HHI_RANGE_ROWS];
+    for r in 0..tr.height() {
+        let row = &tr.values[r * c.width..(r + 1) * c.width];
+        if row[c.valid] == F::ONE {
+            for i in 0..4 {
+                if let Some(x) = cnt.get_mut(row[c.hhi + i].as_canonical_u32() as usize) {
+                    *x += 1;
+                }
+            }
+        }
+    }
+    let v: Vec<F> = cnt.iter().enumerate().flat_map(|(i, &m)| [F::from_usize(i), F::from_u32(m)]).collect();
+    RowMajorMatrix::new(v, 2)
+}
