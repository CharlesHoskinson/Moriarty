+/// The `acceptRun` arguments of a run (`c_p`, `input_pub`, `outcome_pub`, `claim_pub`, the
+/// ledger `anchor`) and the private words the privacy scan forbids on the call vector and the
+/// ledger state: `prog_d` (its 8 words and `pack`), `r_P`, the three `R` operands
+/// (`anchor_d2` = the `SHK_PROGC` operand), `n_steps` and the `h_hi` limbs. Small words (below
+/// 2^16) are listed with `"small": true`: a hit there is judged by its lane (template lanes hold
+/// small constants).
+fn t10_args(run: &iface::Run, p: &sl::Program, w: &LWit, n3_env: &[F], anchor: Fr) -> Value {
+    let v = |i: usize| fr_dec(run.log[i].values.last().unwrap());
+    let prog_d = p.adm.prog_d();
+    let mut forbid = vec![json!({"label": "pack(prog_d)", "value": fr_dec(&fr::pack(&u64s(&prog_d)))})];
+    for (i, x) in prog_d.iter().enumerate() {
+        forbid.push(json!({"label": format!("prog_d[{i}]"), "value": x.as_canonical_u32().to_string()}));
+    }
+    forbid.push(json!({"label": "pack(r_P)", "value": fr_dec(&fr::pack(&u64s(&w.r_p)))}));
+    for i in 0..3 {
+        forbid.push(json!({"label": format!("R{i}.d2"), "value": fr_dec(&run.log[i].values[0])}));
+    }
+    let steps = n3_env[stmt::npv::H_HI] - n3_env[stmt::npv::H_LO];
+    forbid.push(json!({"label": "n_steps", "value": steps.as_canonical_u32().to_string(), "small": true}));
+    for i in 0..4 {
+        forbid.push(json!({"label": format!("h_hi[{i}]"), "value": n3_env[stmt::npv::H_HI + i].as_canonical_u32().to_string(), "small": true}));
+    }
+    for (i, x) in w.r_p.iter().enumerate() {
+        forbid.push(json!({"label": format!("r_P[{i}]"), "value": x.as_canonical_u32().to_string(), "small": true}));
+    }
+    json!({
+        "c_p": v(0), "input_pub": v(1), "outcome_pub": v(2), "claim_pub": v(3),
+        "anchor": v(iface::ANCHOR_IN), "anchor_d2": fr_dec(&anchor),
+        "prog_d": dhex(&prog_d),
+        "forbid": forbid,
+    })
