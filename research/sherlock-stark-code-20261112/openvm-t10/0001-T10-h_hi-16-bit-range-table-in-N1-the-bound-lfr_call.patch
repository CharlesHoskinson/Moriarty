+fn run_ops(prog_d: &Dg, w: &LWit) -> [Fr; 3] {
+    let ops = stmt::operands(prog_d, &w.r_p, &w.hdr);
+    std::array::from_fn(|k| fr::pack(&u64s(&ops[k])))
+}
+
+/// The T10 run: an ORD `acceptRun` call of `sherlock-ledger.compact` (the T10a `call_run` of
+/// `lfr_call`) bound to the root statement `env` (74 words of N3): head words from seed 11, `X`
+/// = the `L` cached commitment, the ENC-3 `layout_d`, mode 0; `R` with the real operands `ops` and
+/// the ledger anchor `anchor`; the 5-pair lane map; `PUB` entries on `PUB_LANES`. `lanes = None`
+/// gives the synthetic key lanes (seed 6) with the same mapped words.
+fn t10_run(env: &[u64], ops: [Fr; 3], anchor: Fr, keys: &iface::Keys, lanes: Option<Vec<Fr>>) -> iface::Run {
+    use rand::{rngs::StdRng, Rng, SeedableRng};
+    let d = Dims::FULL;
+    let mut rng = StdRng::seed_from_u64(11);
+    let mut head: Vec<u64> = (0..iface::STMT).map(|_| rng.random::<u64>() % 0x7800_0001).collect();
+    head[iface::X_WORD..iface::X_WORD + iface::LIMBS].copy_from_slice(&iface::limbs(keys.x));
+    head[iface::LAYOUT_WORD..iface::LAYOUT_WORD + 8].copy_from_slice(&keys.layout_d);
+    head[iface::MODE_WORD] = 0;
+    head[iface::J_WORDS..iface::J_WORDS + 4].fill(0);
+    head[iface::E_IN_WORD] = iface::ANCHOR_IN as u64;
+    head[iface::E_OUT_WORD] = iface::ANCHOR_IN as u64;
+    let tags = iface::anchor_tags(&head).unwrap();
+    let r = iface::reservation_full(&mut rng, tags, false, false, Some(anchor), Some(ops));
+    assert_eq!(env.len(), iface::ROOT_WORDS);
+    head[..iface::ROOT_WORDS].copy_from_slice(env);
+    let outs: Vec<Fr> = r.iter().map(|o| *o.entry().values.last().unwrap()).collect();
+    let e_in = iface::ANCHOR_IN as u64;
+    let lane_map: [(u64, u64); iface::LANE_PAIRS] =
+        [(iface::LANE_A_IN, e_in), (iface::LANE_CLAIM[0], 3), (iface::LANE_CLAIM[1], 3), (iface::LANE_OUTCOME, 2), (0, 0)];
+    let mut lanes = match lanes {
+        Some(v) => v,
+        None => {
+            let mut rng = StdRng::seed_from_u64(6);
+            let mut v: Vec<Fr> = (0..d.lanes())
+                .map(|i| {
+                    if i < 70 {
+                        let b: Vec<u8> = (0..31).map(|_| rng.random::<u8>()).collect();
+                        fr::fr_from_big(&num_bigint::BigUint::from_bytes_le(&b))
+                    } else {
+                        Fr::ZERO
+                    }
+                })
+                .collect();
+            for (l, c) in iface::tpl_ord() {
+                v[l] = c;
+            }
+            for &(l, e) in lane_map.iter().filter(|p| **p != (0, 0)) {
+                v[l as usize] = outs[e as usize];
+            }
+            v
+        }
+    };
+    assert_eq!(lanes.len(), d.lanes(), "call vector length");
+    for &(l, e) in lane_map.iter().filter(|p| **p != (0, 0)) {
+        assert_eq!(lanes[l as usize], outs[e as usize], "call vector lane {l} is not the output of R entry {e}");
+        lanes[l as usize] = Fr::ZERO;
+    }
+    let s: Vec<iface::OpIn> = PUB_LANES.iter().map(|&l| iface::OpIn::Pub { lane: l, v: lanes[l as usize] }).collect();
+    let plan = iface::plan(&d, &r, &s);
+    assert!(plan.spilled.is_empty());
+    iface::Run { dims: d, head, lanes, lane_map, log: plan.log, path_sibs: plan.sibs }
+}
