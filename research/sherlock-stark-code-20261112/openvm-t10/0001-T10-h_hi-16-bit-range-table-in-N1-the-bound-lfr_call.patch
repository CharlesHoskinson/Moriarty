-/// The T10a run: an ORD `acceptRun` call of `sherlock-ledger.compact`. Head of seed 11 with mode
-/// 0, `X` = the cached-trace commitment of this `L`, the ENC-3 `layout_d`; `R` with the ledger
-/// anchor; the 5-pair lane map (prologue read, `claim_pub` twice, `outcome_pub`, unused); `PUB`
-/// entries on `PUB_LANES`. `lanes = None` gives the synthetic key lanes (the same mapped words).
-fn call_run(d: &Dims, keys: &Keys, lanes: Option<Vec<Fr>>) -> Run {
-    let mut rng = StdRng::seed_from_u64(11);
-    let mut head: Vec<u64> = (0..iface::STMT).map(|_| rng.random::<u64>() % 0x7800_0001).collect();
-    head[iface::X_WORD..iface::X_WORD + iface::LIMBS].copy_from_slice(&iface::limbs(keys.x));
-    head[iface::LAYOUT_WORD..iface::LAYOUT_WORD + 8].copy_from_slice(&keys.layout_d);
-    head[iface::MODE_WORD] = 0;
-    // ORD: j = k = 0 (anchor_tags requires 16-bit limbs).
-    head[iface::J_WORDS..iface::J_WORDS + 4].fill(0);
-    head[iface::E_IN_WORD] = iface::ANCHOR_IN as u64;
-    head[iface::E_OUT_WORD] = iface::ANCHOR_IN as u64;
-    let tags = iface::anchor_tags(&head).unwrap();
-    let r = iface::reservation_with(&mut rng, tags, false, false, Some(Fr::from_u64(ANCHOR_D2)));
-    let outs: Vec<Fr> = r.iter().map(|o| *o.entry().values.last().unwrap()).collect();
-    let e_in = iface::ANCHOR_IN as u64;
-    let lane_map: [(u64, u64); iface::LANE_PAIRS] = [
-        (iface::LANE_A_IN, e_in),
-        (iface::LANE_CLAIM[0], 3),
-        (iface::LANE_CLAIM[1], 3),
-        (iface::LANE_OUTCOME, 2),
-        (0, 0),
-    ];
-    let mut lanes = match lanes {
-        Some(v) => v,
-        None => {
-            let mut v = synthetic_lanes(d);
-            for (l, c) in iface::tpl_ord() {
-                v[l] = c;
-            }
-            for &(l, e) in lane_map.iter().filter(|p| **p != (0, 0)) {
-                v[l as usize] = outs[e as usize];
-            }
-            v
-        }
-    };
-    assert_eq!(lanes.len(), d.lanes(), "call vector length");
-    // The mapped lanes of the vector are the R outputs (else the call args or the deployed anchor
-    // are not this run's); in the L words they hold zero limbs, the decoder writes them back.
-    for &(l, e) in lane_map.iter().filter(|p| **p != (0, 0)) {
-        assert_eq!(lanes[l as usize], outs[e as usize], "call vector lane {l} is not the output of R entry {e}");
-        lanes[l as usize] = Fr::ZERO;
-    }
-    let s: Vec<OpIn> = PUB_LANES.iter().map(|&l| OpIn::Pub { lane: l, v: lanes[l as usize] }).collect();
-    let plan = iface::plan(d, &r, &s);
-    assert!(plan.spilled.is_empty());
-    Run { dims: *d, head, lanes, lane_map, log: plan.log, path_sibs: plan.sibs }
-}
