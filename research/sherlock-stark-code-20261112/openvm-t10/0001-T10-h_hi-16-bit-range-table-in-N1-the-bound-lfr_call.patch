+    let (prog, vec_path, out_path) = match mode {
+        "key" => (which(a.get(4)), None, dir.join("lfr-call.json")),
+        "args" => (which(a.get(4)), a.get(5).cloned(), dir.join("args.json")),
+        "call" => (which(a.get(6)), Some(a[4].clone()), PathBuf::from(&a[5])),
+        m => panic!("t10 mode {m}: key, args or call"),
+    };
+    let mut k = keys();
+    let p = sl::program_of(k.key_root, prog);
+    let w = lwit(&p);
+    // The ledger's program (`SHERLOCK_LEDGER_PROG`, default the run's own): a run of B against the
+    // anchor of A must be refused by the `L_Fr` tape (`gen_ops_check`, A_0 = C_P).
+    let ledger_prog = std::env::var("SHERLOCK_LEDGER_PROG").ok().map(|s| which(Some(&s))).unwrap_or(prog);
+    let anchor = ledger_anchor_d2(&sl::program_of(k.key_root, ledger_prog), &w);
+    let prog_d = p.adm.prog_d();
+    let ops = run_ops(&prog_d, &w);
+    let lk = l_key(&k.n3.vk, &k.table.keys_d(), &mut k.log);
+    let l_pin: Fr = lk.l.commit_child_vk(&lk.engine, &k.n3.vk).commitment[0];
+    let keys = iface::Keys { x: l_pin, layout_d: iface::layout_d() };
+    let lanes = vec_path.as_deref().map(read_vector);
+    if mode == "args" {
+        // The R outputs and the decode do not need the proofs: the N3 envelope of the run is the
+        // SEG statement the tree carries (computed by proving app to N3 here once, to be exact).
+        let (n3_p, _) = prove_to_n3(&k, &p);
+        let env = &n3_p.public_values[0][..stmt::npv::ENV];
+        let run = t10_run(&u64s(env), ops, anchor, &keys, lanes.clone());
+        let pw = native_lfr_words(&run);
+        let st = iface::decode_with(&Dims::FULL, &keys, &pw, Some(&run.path_sibs)).expect("native decode of the run");
+        assert_eq!(st, run.statement(), "native decode equals the run statement");
+        if let Some(v) = &lanes {
+            assert_eq!(&st, v, "decoded statement equals the call vector");
+            println!("T10ARGS the vector decodes to itself");
+        }
+        let args = t10_args(&run, &p, &w, env, anchor);
+        fs::write(&out_path, serde_json::to_vec_pretty(&args).unwrap()).unwrap();
+        println!("T10ARGS {args}");
+        return;
+    }
+    let tp = Instant::now();
+    let (n3_p, steps) = prove_to_n3(&k, &p);
+    let tree_s = tp.elapsed().as_secs_f64();
+    let env = &n3_p.public_values[0][..stmt::npv::ENV];
+    assert_eq!(stmt::dig(env, stmt::npv::PROG_D), prog_d, "N3 statement carries prog_d");
+    let run = t10_run(&u64s(env), ops, anchor, &keys, lanes);
+    let words = run.words();
+    let t = Instant::now();
+    let (lp, r) = lk.prove_try(&k.n3.vk, &n3_p, &w, &words, false);
+    let l_s = t.elapsed().as_secs_f64();
+    r.expect("L verify");
+    let lp = lp.unwrap();
+    let (_, ok) = stock_log(&lk.vk, &lp);
+    assert!(ok, "stock verifier accepts L");
+    // L_Fr: gen_verifier_full, gen_r_check, then gen_ops_check (the operand tie and A_0 = C_P).
+    let (g, lw, mem) = match lfr_gen(&lk.vk, &lp, l_pin) {
+        Ok(x) => x,
+        Err(e) => {
+            println!("T10REFUSED {}", json!({"program": format!("{prog:?}"), "ledger_program": format!("{ledger_prog:?}"),
+                "refused_at": "L_Fr tape (gen_r_check, gen_ops_check)", "why": e, "wall_s": t0.elapsed().as_secs_f64()}));
+            std::process::exit(3);
+        }
+    };
+    let m = Machine::new(&g.tape);
+    let pw = m.public_values(&mem).concat();
+    assert_eq!(pw.len(), lw.len());
+    let dec = iface::decode_with(&Dims::FULL, &keys, &pw, Some(&run.path_sibs)).expect("decode");
+    assert_eq!(dec, run.statement(), "decoded statement equals the call vector");
+    let lfr = Engine::new(frozen::LFR.params());
+    let fairs = m.airs();
+    let pk_path = dir.join("lfr_pk.bitcode");
+    let t = Instant::now();
+    let fpk: MultiStarkProvingKey<sherlock_wrap_export::SC> = if mode == "key" {
+        let (fpk, _) = kg(&frozen::LFR, &lfr, &fairs, "L_Fr", &mut k.log);
+        fs::write(&pk_path, bitcode::serialize(&fpk).unwrap()).unwrap();
+        fpk
+    } else {
+        bitcode::deserialize(&fs::read(&pk_path).unwrap()).expect("L_Fr pk cache")
+    };
+    let keygen_s = t.elapsed().as_secs_f64();
+    let fvk = fpk.get_vk();
+    let mut traces = m.traces(&mem);
+    traces.push(range_trace(&fpk, &fairs, &traces));
+    let mut pis = m.public_values(&mem);
+    pis.resize(traces.len(), vec![]);
+    let d_fpk = lfr.device().transport_pk_to_device(&fpk);
+    let ctx = ProvingContext::new(
+        traces
+            .iter()
+            .enumerate()
+            .map(|(i, t)| (i, AirProvingContext::simple(lfr.device().transport_matrix_to_device(&ColMajorMatrix::from_row_major(t)), pis[i].clone())))
+            .collect(),
+    );
+    drop(traces);
+    let t = Instant::now();
+    let proof = lfr.prove(&d_fpk, ctx).expect("L_Fr prove");
+    let lfr_s = t.elapsed().as_secs_f64();
+    let mut doc = export("lfr-call", lfr.config(), &fvk, &proof);
+    assert!(doc["stock_verdict"].as_bool().unwrap(), "stock verifier refuses the L_Fr proof");
+    doc["decode"] = json!({
+        "dims": {"b": Dims::FULL.b, "v": Dims::FULL.v, "p": Dims::FULL.p, "l_tx": Dims::FULL.l_tx},
+        "keys": {"x": sherlock_wrap_export::hex_be(&keys.x), "layout_d": keys.layout_d.to_vec()},
+        "cases": [],
+    });
+    doc["path_sibs"] = json!(run.path_sibs.iter().map(|v| v.iter().map(sherlock_wrap_export::hex_be).collect::<Vec<_>>()).collect::<Vec<_>>());
+    fs::write(&out_path, serde_json::to_vec(&doc).unwrap()).unwrap();
+    let pv_hex: Vec<String> = pw.iter().map(sherlock_wrap_export::hex_be).collect();
+    fs::write(out_path.with_extension("pv.json"), serde_json::to_vec(&pv_hex).unwrap()).unwrap();
+    if mode == "key" {
+        fs::write(dir.join("keys.json"), serde_json::to_string_pretty(&json!({"keys": k.log})).unwrap()).unwrap();
+        let args = t10_args(&run, &p, &w, env, anchor);
+        fs::write(dir.join("args-key.json"), serde_json::to_vec_pretty(&args).unwrap()).unwrap();
+    }
+    println!(
+        "T10CALL {}",
+        json!({
+            "mode": mode, "program": format!("{prog:?}"), "file": out_path.display().to_string(),
+            "prog_d": dhex(&prog_d), "key_root": dhex(&k.key_root), "keys_d": dhex(&k.table.keys_d()),
+            "l_pre_hash": format!("{:?}", lk.vk.pre_hash), "lfr_pre_hash": format!("{:?}", fvk.pre_hash),
+            "x": sherlock_wrap_export::hex_be(&keys.x), "anchor_d2": fr_dec(&anchor),
+            "lfr_public_words": pw.len(), "lfr_airs": fvk.inner.per_air.len(), "proved_steps": steps,
+            "lfr_widths": sw(&proof), "l_heights": height_check(&frozen::L, &heights(&lp)),
+            "lfr_heights": height_check(&frozen::LFR, &heights(&proof)),
+            "tree_s": tree_s, "l_prove_s": l_s, "lfr_keygen_or_load_s": keygen_s, "lfr_prove_s": lfr_s,
+            "wall_s": t0.elapsed().as_secs_f64(),
+        })
+    );
+}
