-/// The `L_Fr` public words of `L` words under a bench pre-hash (the decoder does not verify the
-/// proof): 8 BabyBear words per Fr, base 2^31.
-fn pack_words(w: &[u64]) -> Vec<Fr> {
-    let mut out = vec![Fr::from_u64(0x5e7_ca11)];
-    for c in w.chunks(8) {
-        let mut b = BigUint::from(0u32);
-        for (k, &x) in c.iter().enumerate() {
-            b += BigUint::from(x) << (31 * k);
-        }
-        out.push(fr_from_big(&b));
-    }
-    out
-}
