+/// App, leaf, N1 (binary over the shards), N2, N3 of program `p` (chip set 0); the N3 proof and
+/// the proved steps.
+fn prove_to_n3(k: &Keys, p: &sl::Program) -> (Proof<NodeSC>, u32) {
+    let sets = vec![0usize; sl::shards(p).len()];
+    let (app_p, _) = k.app_proofs(p, &sets);
+    let steps: u32 = app_p.iter().map(|q| q.public_values[0][slice_core::pv::STEPS].as_canonical_u32()).sum();
+    let leaf_p: Vec<_> = app_p.iter().map(|q| k.leaf[0].prove(&k.app[0].vk, std::slice::from_ref(q), &Wit::Leaf)).collect();
+    let n1 = k.n1[0].prove(&k.leaf[0].vk, &leaf_p, &k.first_wit(p, &sets));
+    let n2 = k.n2.prove(&k.n1[0].vk, std::slice::from_ref(&n1), &k.node_wit(&k.table.node[0]));
+    let n3 = k.n3.prove(&k.n2.vk, std::slice::from_ref(&n2), &k.node_wit(&k.table.node[1]));
+    (n3, steps)
+}
+
+/// The `L_Fr` public words of a run without a proof (the decoder does not verify the proof):
+/// a stand-in pre-hash, then the `L` words packed 8 per Fr, base 2^31.
+fn native_lfr_words(run: &iface::Run) -> Vec<Fr> {
+    let mut out = vec![Fr::from_u64(0x5e7_ca11)];
+    for c in run.words().chunks(8) {
+        out.push(fr::pack(c));
+    }
+    out
+}
