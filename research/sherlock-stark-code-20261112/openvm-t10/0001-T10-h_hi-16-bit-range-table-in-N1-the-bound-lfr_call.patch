+fn ledger_anchor_d2(p: &sl::Program, w: &LWit) -> Fr {
+    let r_l: [u64; 8] = u64s(&w.r_p).try_into().unwrap();
+    let pl: [u64; 8] = u64s(&p.adm.prog_d()).try_into().unwrap();
+    iface::anchor_d2(&r_l, &pl)
