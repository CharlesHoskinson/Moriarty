+/// T7c child-meta mode: the cached DAG trace of `child_vk` with the meta rows of every child
+/// AIR appended (then the end row), at the fixed `height`, committed. Its commitment is the `X`
+/// of `L`: it fixes the child constraint DAG and every per-AIR value that the proof-shape AIR
+/// reads, so the `L` key does not depend on the child key.
+pub fn commit_child_vk_meta<E>(
+    engine: &E,
+    child_vk: &MultiStarkVerifyingKey<BabyBearPoseidon2Config>,
+    height: usize,
+) -> CommittedTraceData<E::PB>
+where
+    E: StarkEngine,
+    E::SC: StarkProtocolConfig<F = F>,
+{
+    let cached_trace_record = expr_eval::build_cached_trace_record(child_vk, true);
+    let cached_trace = expr_eval::generate_symbolic_expr_cached_trace_meta(&cached_trace_record, child_vk, height);
+    let cached_trace = ColMajorMatrix::from_row_major(&cached_trace);
+    let cached_trace = engine.device().transport_matrix_to_device(&cached_trace);
+    let (commitment, data) = engine.device().commit(&[&cached_trace]).unwrap();
+    CommittedTraceData {
+        commitment,
+        data: Arc::new(data),
+        trace: cached_trace,
+    }
+}
+
+/// T7c: rows of the cached DAG trace of `child_vk` (DAG rows plus meta rows), the least fixed
+/// height a child-meta `L` needs.
+pub fn meta_cached_rows(child_vk: &MultiStarkVerifyingKey<BabyBearPoseidon2Config>) -> usize {
+    expr_eval::build_cached_trace_record(child_vk, true).records.len() + 3 * child_vk.inner.per_air.len() + 1
+}
