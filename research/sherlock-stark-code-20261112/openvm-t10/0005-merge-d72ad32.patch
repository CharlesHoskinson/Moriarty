+/// T7c: per-AIR widths of the universal `L` (and the check that it is one key over N3 and the
+/// path C leaf layer), of N3, of the leaf layers.
+fn shape_mode(out: &PathBuf) {
+    let mut k = keys();
+    let mut lg = vec![];
+    let lk = l_key(&k, &mut lg);
+    k.log.extend(lg);
+    println!("T7CSHAPE == L (universal)");
+    let l = per_air(&lk.vk, &lk.airs);
+    println!("T7CSHAPE == N3");
+    let n3 = per_air(&k.n3.vk, &k.n3.airs);
+    println!("T7CSHAPE == leaf set 0");
+    let lf = per_air(&k.leaf[0].vk, &k.leaf[0].airs);
+    println!("T7CSHAPE == path C leaf layer set 0");
+    let lc = per_air(&k.pc.leaf[0].vk, &k.pc.leaf[0].airs);
+    println!("T7CSHAPE == path C app set 0");
+    let ac = per_air(&k.pc.app[0].vk, &k.pc.app[0].airs);
+    let doc = json!({"L": l, "N3": n3, "leaf0": lf, "pathc_leaf0": lc, "pathc_app0": ac,
+        "meta": {"cached_rows": k.pc.meta_rows, "height": k.pc.meta_h}, "keys": k.log});
+    fs::write(out.join("shape.json"), serde_json::to_string_pretty(&doc).unwrap()).unwrap();
+}
