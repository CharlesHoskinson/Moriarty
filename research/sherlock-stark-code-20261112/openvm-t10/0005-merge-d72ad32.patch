+pub mod s8;
+
+/// Slots per shard of the CORE module at `module_path` (8 under [`s8`], else 4).
+pub const fn slots(module_path: &str) -> usize {
+    let b = module_path.as_bytes();
+    let mut i = 0;
+    while i + 4 <= b.len() {
+        if b[i] == b':' && b[i + 1] == b':' && b[i + 2] == b's' && b[i + 3] == b'8' {
+            return 8;
+        }
+        i += 1;
+    }
+    4
+}
