+/// The low 64 bits of the canonical representative of `x` in `[0, p)`. For a field with
+/// `p < 2^64` this is `as_canonical_u64()`.
+#[inline]
+pub fn canonical_low_u64<F: PrimeField>(x: &F) -> u64 {
+    x.as_canonical_biguint().iter_u64_digits().next().unwrap_or(0)
+}
+
+/// `2^bits < p`, exactly. `F::bits()` is the bit length `b` of `p`, so `2^(b-1) <= p < 2^b`;
+/// `p` is an odd prime, so `p != 2^(b-1)`, and `2^bits < p` holds if and only if `bits < b`.
+#[inline]
+pub fn pow2_below_order<F: PrimeField>(bits: usize) -> bool {
+    bits < F::bits()
+}
+
+/// Number of proof-of-work candidates: `p` when `p < 2^64`, otherwise `2^64 - 1`.
+#[inline]
+pub fn grind_candidate_count<F: PrimeField>() -> u64 {
+    let order = F::order();
+    if order.bits() <= 64 {
+        order.iter_u64_digits().next().unwrap_or(0)
+    } else {
+        u64::MAX
+    }
+}
