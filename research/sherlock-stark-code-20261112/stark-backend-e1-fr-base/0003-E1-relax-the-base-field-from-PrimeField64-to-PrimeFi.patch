 /// it without restating the formula.
 #[doc(hidden)]
 pub fn base_field_order<SC: StarkProtocolConfig>() -> f64 {
-    SC::F::ORDER_U64 as f64
+    // Exact for a field below 2^53 (BabyBear). For a larger field (BLS12-381 Fr) it is `p`
+    // rounded to an f64, so `log2` is exact to about 2^-52 relative.
+    SC::F::order()
+        .to_u64_digits()
+        .iter()
+        .rev()
+        .fold(0.0f64, |acc, &d| acc * 18_446_744_073_709_551_616.0 + d as f64)
 }
 
