+/// Negative controls: a changed public value, and single-byte changes spread over the encoded
+/// proof, are each refused (by the decoder or by the verifier).
+#[test]
+fn e1_fr_negative_controls() {
+    let fib = FibFixture::new(0, 1, 1 << 9);
+    let engine = Bls12381FrPoseidonCpuEngine::new(small_params());
+    let (vk, proof) = fib.keygen_and_prove(&engine);
+    let config = engine.config();
+    let mut ts = config.transcript();
+    verify(config, &vk, &proof, &mut ts).unwrap();
+
+    // Changed public values (each of the three, by +1).
+    for i in 0..3 {
+        let mut bad = Proof::<SC>::decode_from_bytes(&proof.encode_to_vec().unwrap()).unwrap();
+        bad.public_values[0][i] += F::ONE;
+        let mut ts = config.transcript();
+        assert!(
+            verify(config, &vk, &bad, &mut ts).is_err(),
+            "public value {i} change accepted"
+        );
+    }
+
+    // Single-byte changes at evenly spaced positions.
+    let bytes = proof.encode_to_vec().unwrap();
+    let n = 256usize.min(bytes.len());
+    let (mut dec_refused, mut ver_refused) = (0usize, 0usize);
+    for k in 0..n {
+        let pos = k * bytes.len() / n;
+        let mut b = bytes.clone();
+        b[pos] ^= 0x01;
+        match Proof::<SC>::decode_from_bytes(&b) {
+            Err(_) => dec_refused += 1,
+            Ok(bad) => {
+                let mut ts = config.transcript();
+                assert!(
+                    verify(config, &vk, &bad, &mut ts).is_err(),
+                    "byte {pos} change accepted"
+                );
+                ver_refused += 1;
+            }
+        }
+    }
+    println!(
+        "E1_FR negative: {n} byte flips of {} bytes: decode refused {dec_refused}, verify \
+         refused {ver_refused}; 3 of 3 public-value changes refused",
+        bytes.len()
+    );
+    assert_eq!(dec_refused + ver_refused, n);
+
+    // A transcript at another use code refuses the proof (the domain is bound).
+    let other = Transcript::new(MidnightPoseidonFr::new(), 5);
+    let mut ts = other;
+    assert!(verify(config, &vk, &proof, &mut ts).is_err());
+}
