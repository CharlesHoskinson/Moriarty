+//! BLS12-381 Fr base-field STARK configuration with Midnight Poseidon (Sherlock E1, `L_Fr`).
+//!
+//! The base field is BLS12-381 Fr ([`Bls12381Fr`]) and the challenge field is the base field
+//! itself (`EF = F`, degree 1). Digests are one Fr element. Every hash is the Midnight Poseidon
+//! permutation over Fr (width 3, rate 2) of [`MidnightPoseidonFr`], with the PROPOSAL section 3.6
+//! domain rules applied to native Fr words:
+//!
+//! - **Merkle leaf (`u_leaf`, default u = 1)**: Midnight's fixed-length sponge over the leaf's
+//!   `l = w` Fr values (no packing): state `(0, 0, l + u * 2^66)`; each block of 2 values is
+//!   added into `(r_0, r_1)` (a last block of 1 adds only `r_0`), one permutation per block;
+//!   output `r_0`.
+//! - **Merkle node (`u_node`, default u = 2)**: the same sponge with `l = 2`: state
+//!   `(left, right, 2 + u * 2^66)`, one permutation, output `r_0`.
+//! - **Transcript (`u_transcript`, default u = 3)**: the stock overwrite duplex
+//!   ([`DuplexSponge`]) over Fr, width 3, rate 2, one Fr word per cell (no packing, no digit
+//!   split), with the initial state `(0, 0, 2^64 + u * 2^66)`. A commitment observe absorbs the
+//!   one digest element. Every transition is stock.
+//!
+//! The use codes are fields of [`FrDomains`], so a later OD-18 ruling (a separate tag for the
+//! `L_Fr` hashes) changes constants, not code. [`FrDomains::default`] is u = 1, 2, 3.
+
+use std::io::{self, Read, Write};
+
+use num_bigint::BigUint;
+use openvm_stark_backend::{
+    codec::{DecodableConfig, EncodableConfig},
+    hasher::MerkleHasher,
+    p3_symmetric::Permutation,
+    prover::{Coordinator, CpuColMajorBackend, ReferenceDevice},
+    transcript::duplex_sponge::DuplexSponge,
+    FiatShamirTranscript, StarkEngine, StarkProtocolConfig, SystemParams,
+};
+use p3_field::{Field, PrimeCharacteristicRing};
+
+pub use super::baby_bear_bls12381_poseidon::{
+    cap_fixed, cap_var, Bls12381Fr, MidnightFq, MidnightPoseidonFr, FR_RATE, U_LEAF, U_NODE,
+    U_TRANSCRIPT, WIDTH,
+};
+
+pub type F = Bls12381Fr;
+pub type EF = Bls12381Fr;
+pub const D_EF: usize = 1;
+pub const DIGEST_WIDTH: usize = 1;
+pub type Digest = [F; DIGEST_WIDTH];
+type SC = Bls12381FrPoseidonConfig;
+
+/// Use codes of the three hash domains (PROPOSAL 3.6). Default u = 1 (leaf), 2 (node),
+/// 3 (transcript).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FrDomains {
+    pub u_leaf: u128,
+    pub u_node: u128,
+    pub u_transcript: u128,
+}
+
+impl Default for FrDomains {
+    fn default() -> Self {
+        Self {
+            u_leaf: U_LEAF,
+            u_node: U_NODE,
+            u_transcript: U_TRANSCRIPT,
+        }
+    }
+}
+
+/// Merkle hasher over native Fr leaves: leaf hash `u_leaf`, node hash `u_node`.
+#[derive(Clone, Debug)]
+pub struct FrMerkleHasher {
+    perm: MidnightPoseidonFr,
+    domains: FrDomains,
+}
+
+impl FrMerkleHasher {
+    pub fn new(perm: MidnightPoseidonFr, domains: FrDomains) -> Self {
+        Self { perm, domains }
+    }
+
+    pub fn perm(&self) -> &MidnightPoseidonFr {
+        &self.perm
+    }
+
+    pub fn domains(&self) -> FrDomains {
+        self.domains
+    }
+}
+
+impl MerkleHasher for FrMerkleHasher {
+    type F = F;
+    type Digest = Digest;
+
+    #[inline]
+    fn hash_slice(&self, vals: &[F]) -> Digest {
+        let mut state = [
+            F::ZERO,
+            F::ZERO,
+            cap_fixed(self.domains.u_leaf, vals.len() as u128),
+        ];
+        for block in vals.chunks(FR_RATE) {
+            for (s, x) in state.iter_mut().zip(block) {
+                *s += *x;
+            }
+            self.perm.permute_mut(&mut state);
+        }
+        [state[0]]
+    }
+
+    #[inline]
+    fn compress(&self, left: Digest, right: Digest) -> Digest {
+        let mut state = [left[0], right[0], cap_fixed(self.domains.u_node, 2)];
+        self.perm.permute_mut(&mut state);
+        [state[0]]
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Bls12381FrPoseidonConfig {
+    params: SystemParams,
+    hasher: FrMerkleHasher,
+}
+
+impl Bls12381FrPoseidonConfig {
+    pub fn new(params: SystemParams, perm: MidnightPoseidonFr, domains: FrDomains) -> Self {
+        Self {
+            params,
+            hasher: FrMerkleHasher::new(perm, domains),
+        }
+    }
+
+    pub fn default_from_params(params: SystemParams) -> Self {
+        Self::new(params, MidnightPoseidonFr::new(), FrDomains::default())
+    }
+
+    pub fn domains(&self) -> FrDomains {
+        self.hasher.domains
+    }
+
+    /// The initial transcript of this configuration.
+    pub fn transcript(&self) -> Transcript {
+        Transcript::new(self.hasher.perm.clone(), self.hasher.domains.u_transcript)
+    }
+}
+
+impl StarkProtocolConfig for Bls12381FrPoseidonConfig {
+    type F = F;
+    type EF = EF;
+    type Digest = Digest;
+    type Hasher = FrMerkleHasher;
+
+    fn params(&self) -> &SystemParams {
+        &self.params
+    }
+
+    fn hasher(&self) -> &Self::Hasher {
+        &self.hasher
+    }
+}
+
+/// 32 big-endian bytes of the canonical value.
+pub fn encode_fr<W: Write>(val: &F, writer: &mut W) -> io::Result<()> {
+    let mut buf = val.to_canonical_bytes();
+    buf.reverse();
+    writer.write_all(&buf)
+}
+
+/// Reads 32 big-endian bytes and refuses a value at or above the modulus.
+pub fn decode_fr<R: Read>(reader: &mut R) -> io::Result<F> {
+    let mut buf = [0u8; 32];
+    reader.read_exact(&mut buf)?;
+    if BigUint::from_bytes_be(&buf) >= F::order() {
+        return Err(io::Error::other(
+            "non-canonical BLS12-381 Fr element >= modulus",
+        ));
+    }
+    buf.reverse();
+    F::from_canonical_bytes(buf).ok_or_else(|| io::Error::other("invalid BLS12-381 Fr element"))
+}
+
+impl EncodableConfig for Bls12381FrPoseidonConfig {
+    fn encode_base_field<W: Write>(val: &F, writer: &mut W) -> io::Result<()> {
+        encode_fr(val, writer)
+    }
+
+    fn encode_extension_field<W: Write>(val: &EF, writer: &mut W) -> io::Result<()> {
+        encode_fr(val, writer)
+    }
+
+    fn encode_digest<W: Write>(digest: &Digest, writer: &mut W) -> io::Result<()> {
+        for val in digest {
+            encode_fr(val, writer)?;
+        }
+        Ok(())
+    }
+}
+
+impl DecodableConfig for Bls12381FrPoseidonConfig {
+    fn decode_base_field<R: Read>(reader: &mut R) -> io::Result<F> {
+        decode_fr(reader)
+    }
+
+    fn decode_extension_field<R: Read>(reader: &mut R) -> io::Result<EF> {
+        decode_fr(reader)
+    }
+
+    fn decode_digest<R: Read>(reader: &mut R) -> io::Result<Digest> {
+        let mut result = Digest::default();
+        for val in &mut result {
+            *val = decode_fr(reader)?;
+        }
+        Ok(result)
+    }
+}
+
+/// The stock overwrite duplex over Fr with Midnight's permutation.
+pub type FrSponge = DuplexSponge<F, MidnightPoseidonFr, WIDTH, FR_RATE>;
+
+/// Native Fr transcript: the stock overwrite duplex from `(0, 0, 2^64 + u * 2^66)`.
+#[derive(Clone, Debug)]
+pub struct Transcript(pub FrSponge);
+
+impl Transcript {
+    /// The initial sponge state `(0, 0, 2^64 + u * 2^66)`.
+    pub fn initial_state(u_transcript: u128) -> [F; WIDTH] {
+        [F::ZERO, F::ZERO, cap_var(u_transcript)]
+    }
+
+    pub fn new(perm: MidnightPoseidonFr, u_transcript: u128) -> Self {
+        Self(FrSponge::new_with_state(
+            perm,
+            Self::initial_state(u_transcript),
+        ))
+    }
+
+    pub fn sponge(&self) -> &FrSponge {
+        &self.0
+    }
+}
+
+impl From<MidnightPoseidonFr> for Transcript {
+    /// The transcript at the default use code (u = 3).
+    fn from(perm: MidnightPoseidonFr) -> Self {
+        Self::new(perm, U_TRANSCRIPT)
+    }
+}
+
+impl FiatShamirTranscript<SC> for Transcript {
+    #[inline]
+    fn observe(&mut self, value: F) {
+        self.0.absorb(value);
+    }
+
+    #[inline]
+    fn sample(&mut self) -> F {
+        self.0.squeeze()
+    }
+
+    #[inline]
+    fn observe_commit(&mut self, digest: Digest) {
+        for x in digest {
+            self.0.absorb(x);
+        }
+    }
+}
+
+/// The transcript at the default use code (u = 3).
+pub fn default_transcript() -> Transcript {
+    Transcript::from(MidnightPoseidonFr::new())
+}
+
+/// Reference (column-major) engine at the default domains.
+pub struct Bls12381FrPoseidonRefEngine {
+    device: ReferenceDevice<SC>,
+}
+
+impl StarkEngine for Bls12381FrPoseidonRefEngine {
+    type SC = SC;
+    type PB = CpuColMajorBackend<SC>;
+    type PD = ReferenceDevice<SC>;
+    type TS = Transcript;
+
+    fn new(params: SystemParams) -> Self {
+        Self {
+            device: ReferenceDevice::new(SC::default_from_params(params)),
+        }
+    }
+
+    fn config(&self) -> &SC {
+        self.device.config()
+    }
+
+    fn device(&self) -> &Self::PD {
+        &self.device
+    }
+
+    fn initial_transcript(&self) -> Self::TS {
+        self.config().transcript()
+    }
+
+    fn prover_from_transcript(
+        &self,
+        transcript: Transcript,
+    ) -> Coordinator<Self::SC, Self::PB, Self::PD, Self::TS> {
+        Coordinator::new(CpuColMajorBackend::new(), self.device.clone(), transcript)
+    }
+}
+
