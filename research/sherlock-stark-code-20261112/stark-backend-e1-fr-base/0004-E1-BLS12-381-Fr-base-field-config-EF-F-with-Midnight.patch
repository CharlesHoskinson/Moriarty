+#[test]
+fn e1_codec_canonical() {
+    use openvm_stark_sdk::config::bls12381_fr_poseidon::{decode_fr, encode_fr};
+    let x = -F::ONE;
+    let mut buf = Vec::new();
+    encode_fr(&x, &mut buf).unwrap();
+    assert_eq!(buf.len(), 32);
+    assert_eq!(decode_fr(&mut &buf[..]).unwrap(), x);
+    // r itself (x + 1 as an integer) is refused.
+    let mut r_be = F::order().to_bytes_be();
+    while r_be.len() < 32 {
+        r_be.insert(0, 0);
+    }
+    assert!(decode_fr(&mut &r_be[..]).is_err());
+    assert!(decode_fr(&mut &[0xffu8; 32][..]).is_err());
+}
