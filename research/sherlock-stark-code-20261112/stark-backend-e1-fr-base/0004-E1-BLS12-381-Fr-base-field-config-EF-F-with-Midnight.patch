+//! Sherlock E1: the stark-backend at a BLS12-381 Fr base field (`EF = F`).
+//!
+//! - Field facts that the sampling and grinding argument uses.
+//! - The hash-domain rules of PROPOSAL 3.6 on native Fr words (u = 1, 2, 3).
+//! - A small AIR proved and verified end to end at the Fr base on both CPU engines, with
+//!   negative controls: single-byte proof changes and a changed public value are refused.
+//! - The D3 soundness terms at the `L_Fr` parameters, with the field order and the challenge
+//!   field size taken from the configuration, against RESULTS.md (M7) section 2b.2.
+//!
+//! Run: `cargo test -p openvm-stark-sdk --release --features bls12381-fr-poseidon --test e1_fr`.
+#![cfg(feature = "bls12381-fr-poseidon")]
+
+use openvm_stark_backend::{
+    codec::{Decode, Encode},
+    hasher::MerkleHasher,
+    interaction::LogUpSecurityParameters,
+    p3_symmetric::Permutation,
+    proof::Proof,
+    soundness::{base_field_order, challenge_field_bits, SoundnessCalculator},
+    test_utils::{FibFixture, InteractionsFixture11, TestFixture},
+    transcript::{canonical_low_u64, grind_candidate_count, pow2_below_order},
+    verifier::verify,
+    FiatShamirTranscript, StarkEngine, StarkProtocolConfig, SystemParams, WhirConfig, WhirParams,
+    WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::fixed_len_hash,
+    bls12381_fr_poseidon::{
+        cap_fixed, cap_var, default_transcript, Bls12381FrPoseidonConfig,
+        Bls12381FrPoseidonCpuEngine, Bls12381FrPoseidonRefEngine, FrDomains, FrMerkleHasher,
+        MidnightPoseidonFr, Transcript, EF, F,
+    },
+    params_with_100_bits_security,
+};
+use p3_baby_bear::BabyBear;
+use p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};
+
+type SC = Bls12381FrPoseidonConfig;
+
+// ---------------------------------------------------------------------------------------------
+// Field facts
+// ---------------------------------------------------------------------------------------------
+
+#[test]
+fn e1_field_facts() {
+    let r = F::order();
+    assert_eq!(F::bits(), 255);
+    // r = 1 mod 2^32: so for every bits < 32 exactly one residue mod 2^bits is heavy.
+    assert_eq!(&r % (1u64 << 32), 1u64.into());
+    assert_eq!(<F as TwoAdicField>::TWO_ADICITY, 32);
+    // EF = F, degree 1.
+    assert_eq!(<SC as StarkProtocolConfig>::D_EF, 1);
+    let _: EF = F::ONE;
+    // The order checks are exact.
+    assert!(pow2_below_order::<F>(254));
+    assert!(!pow2_below_order::<F>(255));
+    assert!(pow2_below_order::<BabyBear>(30));
+    assert!(!pow2_below_order::<BabyBear>(31));
+    // Grinding candidates.
+    assert_eq!(grind_candidate_count::<F>(), u64::MAX);
+    assert_eq!(grind_candidate_count::<BabyBear>(), 0x7800_0001);
+    // canonical_low_u64 against the canonical big integer.
+    let x = -F::ONE; // r - 1
+    assert_eq!(canonical_low_u64(&x), 0xffff_ffff_0000_0000);
+    let y = F::from_u64(0x1234_5678_9abc_def0);
+    assert_eq!(canonical_low_u64(&y), 0x1234_5678_9abc_def0);
+    let z = F::from_u128((1u128 << 64) + 5);
+    assert_eq!(canonical_low_u64(&z), 5);
+    let b = BabyBear::from_u32(0x7800_0000);
+    assert_eq!(canonical_low_u64(&b), 0x7800_0000);
+    // Order and challenge-field size come from the configuration.
+    let log2_r = base_field_order::<SC>().log2();
+    assert!((log2_r - 254.857_089_413_047_2).abs() < 1e-9, "{log2_r}");
+    assert_eq!(challenge_field_bits::<SC>(), log2_r);
+}
+
+/// The heavy residue of `sample_bits` is 0 only, with weight `(c + 1) / r` against `c / r`,
+/// `c = floor(r / 2^bits)`: so the bias is below `2^(bits - 254)`. Here: the empirical counts
+/// of 2^16 four-bit samples from the Fr transcript are within 5 sigma of uniform.
+#[test]
+fn e1_sample_bits_counts() {
+    for bits in [1usize, 4, 20, 31] {
+        let c = F::order() >> bits;
+        assert_eq!(
+            &F::order() - (&c << bits),
+            1u64.into(),
+            "r mod 2^{bits} = 1"
+        );
+    }
+    let mut ts = default_transcript();
+    let n = 1usize << 16;
+    let mut counts = [0usize; 16];
+    for i in 0..n {
+        if i % 3 == 0 {
+            FiatShamirTranscript::<SC>::observe(&mut ts, F::from_usize(i));
+        }
+        let v = FiatShamirTranscript::<SC>::sample_bits(&mut ts, 4);
+        assert!(v < 16);
+        counts[v as usize] += 1;
+    }
+    let mean = n as f64 / 16.0;
+    let sd = (n as f64 * (1.0 / 16.0) * (15.0 / 16.0)).sqrt();
+    for (v, c) in counts.iter().enumerate() {
+        assert!(((*c as f64) - mean).abs() < 5.0 * sd, "value {v}: {c}");
+    }
+}
