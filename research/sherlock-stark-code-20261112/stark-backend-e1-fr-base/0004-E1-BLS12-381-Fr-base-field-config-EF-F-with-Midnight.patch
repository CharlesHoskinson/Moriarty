+#[test]
+fn e1_hash_domains() {
+    let perm = MidnightPoseidonFr::new();
+    let d = FrDomains::default();
+    assert_eq!((d.u_leaf, d.u_node, d.u_transcript), (1, 2, 3));
+    let h = FrMerkleHasher::new(perm.clone(), d);
+    // Leaf: Midnight's fixed-length sponge with u = 1 and l = w, for w = 1 .. 9.
+    for w in 1..=9usize {
+        let vals: Vec<F> = (0..w).map(|i| F::from_u64(1000 + i as u64)).collect();
+        assert_eq!(
+            h.hash_slice(&vals)[0],
+            fixed_len_hash(&perm, 1, &vals),
+            "w {w}"
+        );
+        // Hand-rolled: state (0, 0, w + 2^66), add blocks of 2, permute per block.
+        let mut s = [F::ZERO, F::ZERO, F::from_u128(w as u128 + (1u128 << 66))];
+        for blk in vals.chunks(2) {
+            s[0] += blk[0];
+            if blk.len() == 2 {
+                s[1] += blk[1];
+            }
+            perm.permute_mut(&mut s);
+        }
+        assert_eq!(h.hash_slice(&vals)[0], s[0]);
+    }
+    // A leaf of length 2 and a node over the same two values differ (distinct capacities).
+    let (a, b) = (F::from_u64(7), F::from_u64(9));
+    assert_eq!(h.compress([a], [b])[0], fixed_len_hash(&perm, 2, &[a, b]));
+    assert_ne!(h.compress([a], [b]), h.hash_slice(&[a, b]));
+    assert_eq!(cap_fixed(2, 2), F::from_u128(2 + (2u128 << 66)));
+    // Transcript: state (0, 0, 2^64 + 3 * 2^66); the first squeeze permutes it and returns s_1.
+    assert_eq!(cap_var(3), F::from_u128((1u128 << 64) + (3u128 << 66)));
+    let mut ts = default_transcript();
+    assert_eq!(*ts.sponge().state(), Transcript::initial_state(3));
+    let mut s = Transcript::initial_state(3);
+    perm.permute_mut(&mut s);
+    assert_eq!(FiatShamirTranscript::<SC>::sample(&mut ts), s[1]);
+    assert_eq!(FiatShamirTranscript::<SC>::sample(&mut ts), s[0]);
+    // Observe overwrites s_0, s_1 and permutes at the second word.
+    let mut ts = default_transcript();
+    FiatShamirTranscript::<SC>::observe(&mut ts, a);
+    FiatShamirTranscript::<SC>::observe_commit(&mut ts, [b]);
+    let mut s = Transcript::initial_state(3);
+    s[0] = a;
+    s[1] = b;
+    perm.permute_mut(&mut s);
+    assert_eq!(*ts.sponge().state(), s);
+    assert_eq!(FiatShamirTranscript::<SC>::sample(&mut ts), s[1]);
+}
