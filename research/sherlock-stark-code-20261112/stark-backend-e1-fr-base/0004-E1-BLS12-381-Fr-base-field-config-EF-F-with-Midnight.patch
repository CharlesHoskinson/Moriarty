+fn prove_verify<E: StarkEngine<SC = SC>, Fx: TestFixture<SC>>(
+    params: SystemParams,
+    fx: &Fx,
+) -> (
+    openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<SC>,
+    Proof<SC>,
+) {
+    let engine = E::new(params);
+    let (vk, proof) = fx.keygen_and_prove(&engine);
+    let mut ts = engine.config().transcript();
+    verify(engine.config(), &vk, &proof, &mut ts).expect("Fr proof verifies");
+    // Codec round trip is exact.
+    let bytes = proof.encode_to_vec().unwrap();
+    let back = Proof::<SC>::decode_from_bytes(&bytes).unwrap();
+    assert_eq!(back.encode_to_vec().unwrap(), bytes);
+    (vk, proof)
+}
+
+#[test]
+fn e1_fr_fib_ref_and_cpu() {
+    let fib = FibFixture::new(0, 1, 1 << 9);
+    let (_, p_ref) = prove_verify::<Bls12381FrPoseidonRefEngine, _>(small_params(), &fib);
+    let (_, p_cpu) = prove_verify::<Bls12381FrPoseidonCpuEngine, _>(small_params(), &fib);
+    // The public value f_n is the Fibonacci number computed in Fr.
+    assert_eq!(p_ref.public_values[0].len(), 3);
+    let len = p_ref.encode_to_vec().unwrap().len();
+    println!("E1_FR fib proof bytes {len}");
+    // Both engines give the same proof (deterministic prover; grinding may pick different
+    // witnesses under several threads, so compare only when single-threaded).
+    if std::env::var("RAYON_NUM_THREADS").as_deref() == Ok("1") {
+        assert_eq!(
+            p_ref.encode_to_vec().unwrap(),
+            p_cpu.encode_to_vec().unwrap()
+        );
+    }
+}
