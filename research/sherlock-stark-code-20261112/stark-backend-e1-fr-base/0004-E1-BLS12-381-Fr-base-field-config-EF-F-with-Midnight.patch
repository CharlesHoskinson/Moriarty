+/// The `L_Fr` parameter set of M7 `m7_fr_d3.rs` (`mk`): UD, `l_skip` 2, `n_stack` 18, `k_whir`
+/// 4, max constraint degree 4, every PoW 0 except the query PoW.
+fn lfr_params(b: usize, w: usize, q: &[usize], qpow: usize) -> (SystemParams, ()) {
+    let mut p = params_with_100_bits_security(
+        b,
+        2,
+        18,
+        w,
+        0,
+        0,
+        WhirProximityStrategy::UniqueDecoding,
+        4,
+        qpow,
+        4,
+    );
+    for (r, &n) in p.whir.rounds.iter_mut().zip(q) {
+        r.num_queries = n;
+    }
+    p.logup.pow_bits = 0;
+    (p, ())
+}
+
+fn n_logup_bound(l_skip: usize, num_airs: usize, ipa: usize, h: usize, mic: usize) -> usize {
+    let field_bound = (mic as f64).log2().ceil() as usize - l_skip;
+    let param_bound =
+        (num_airs as f64).log2().ceil() as usize + (ipa as f64).log2().ceil() as usize + h - l_skip;
+    field_bound.min(param_bound)
+}
