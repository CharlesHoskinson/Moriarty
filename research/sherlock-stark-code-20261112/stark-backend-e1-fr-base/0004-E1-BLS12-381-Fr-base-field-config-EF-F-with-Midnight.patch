+/// Grinding at 12 bits finds a witness that the verifier check accepts, and the check refuses
+/// the next witness when it does not also meet the target.
+#[test]
+fn e1_grind() {
+    let ts = default_transcript();
+    let mut p = ts.clone();
+    let w = FiatShamirTranscript::<SC>::grind(&mut p, 12);
+    let mut v = ts.clone();
+    assert!(FiatShamirTranscript::<SC>::check_witness(&mut v, 12, w));
+    let mut tries = 0;
+    let mut bad = w + F::ONE;
+    loop {
+        let mut v = ts.clone();
+        if !FiatShamirTranscript::<SC>::check_witness(&mut v, 12, bad) {
+            break;
+        }
+        bad += F::ONE;
+        tries += 1;
+        assert!(tries < 100);
+    }
+}
