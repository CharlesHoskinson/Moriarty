-/// The seal of `L` (X10 and FP-3 fact 1 check (i)): receives `(prog_d, post_d)`, opens `post_d`
-/// as `P2(SHK_SD2, header 41 words)`, checks the seal predicates (a terminal `outcome_tag`,
-/// `deps_d = EMPTY_DEPS`; SEG and `h_lo = 0` are key constants of the root statement), and
-/// exposes the three `R` operand digests (24 public values after the FP-3 table).
+/// T7c: the `key_root` inclusion path of the path C DAG key leaf. Row `r` (level `r`) receives
+/// the node `cur` (row 0: the leaf digest of the root statement's call; row `r`: the digest of
+/// row `r - 1`'s call) when `rcv`, and, when `en`, sends `P2(DOM_KEYNODE, l, r)` of `cur` and
+/// the sibling `sib` (`b` 1: `cur` is the right child). The row that receives and does not send
+/// is the root: it sends `cur` on [`KR_BUS`], and the seal receives it as `key_root` on path C.
+/// `rcv` of the next row is `en` (one chain, an enable prefix), row 0 sends when it receives
+/// (depth at least 1), the last row does not send. All zero on the full tree.
+pub struct KeyPathAir;
+const KP_EN: usize = 0;
+const KP_RCV: usize = 1;
+const KP_B: usize = 2;
+const KP_LVL: usize = 3;
+const KP_CUR: usize = 4;
+const KP_SIB: usize = 12;
+const KP_W: usize = 20;
+
+impl<T> BaseAir<T> for KeyPathAir {
+    fn width(&self) -> usize {
+        KP_W
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for KeyPathAir {}
+impl<T> PartitionedBaseAir<T> for KeyPathAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for KeyPathAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).expect("row"), main.row_slice(1).expect("next"));
+        let l: Vec<AB::Expr> = (0..KP_W).map(|i| lr[i].clone().into()).collect();
+        let n: Vec<AB::Expr> = (0..KP_W).map(|i| nr[i].clone().into()).collect();
+        drop((lr, nr));
+        let one = AB::Expr::ONE;
+        let (en, rcv, b) = (l[KP_EN].clone(), l[KP_RCV].clone(), l[KP_B].clone());
+        builder.assert_bool(en.clone());
+        builder.assert_bool(rcv.clone());
+        builder.assert_bool(b.clone());
+        builder.assert_zero(en.clone() * (one.clone() - rcv.clone()));
+        builder.when_first_row().assert_zero(l[KP_LVL].clone());
+        builder.when_first_row().assert_eq(en.clone(), rcv.clone());
+        builder.when_transition().assert_eq(n[KP_LVL].clone(), l[KP_LVL].clone() + one.clone());
+        builder.when_transition().assert_eq(n[KP_RCV].clone(), en.clone());
+        builder.when_last_row().assert_zero(en.clone());
+        let cur: Vec<AB::Expr> = (0..D).map(|i| l[KP_CUR + i].clone()).collect();
+        let sib: Vec<AB::Expr> = (0..D).map(|i| l[KP_SIB + i].clone()).collect();
+        let s0 = AB::Expr::from_u32(seq::of(seq::KD_LEAF, 0));
+        let mut o = vec![s0.clone() + l[KP_LVL].clone()];
+        o.extend(cur.iter().cloned());
+        PermutationCheckBus::new(PORT_OUT).receive(builder, o, rcv.clone());
+        let mut ws: Vec<AB::Expr> = (0..D).map(|i| cur[i].clone() + b.clone() * (sib[i].clone() - cur[i].clone())).collect();
+        ws.extend((0..D).map(|i| sib[i].clone() + b.clone() * (cur[i].clone() - sib[i].clone())));
+        call_send(builder, s0 + l[KP_LVL].clone() + one, DOM_KEYNODE, ws, en.clone());
+        PermutationCheckBus::new(KR_BUS).send(builder, cur, rcv - en);
+    }
+}
