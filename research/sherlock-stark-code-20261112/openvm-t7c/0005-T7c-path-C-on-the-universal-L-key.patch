+/// Requester side of one call without the digest receive (the digest goes to another AIR).
+fn call_send<AB: InteractionBuilder>(builder: &mut AB, seq: AB::Expr, tag: u32, words: Vec<AB::Expr>, mult: AB::Expr) {
+    let len = words.len() + 1;
+    let mut w = vec![AB::Expr::from_u32(tag)];
+    w.extend(words);
+    while w.len() % 8 != 0 {
+        w.push(AB::Expr::ZERO);
+    }
+    for (k, b) in w.chunks(8).enumerate() {
+        let mut m = vec![seq.clone(), AB::Expr::from_usize(k), AB::Expr::from_usize(len)];
+        m.extend(b.iter().cloned());
+        PermutationCheckBus::new(PORT_IN).send(builder, m, mult.clone());
+    }
+}
