+/// The [`KeyPathAir`] trace of a leaf digest and its path (`None`: the full tree, all zero but
+/// the level counter), and the node calls.
+pub fn key_path_trace(leaf: Option<(&Digest, &[(bool, Digest)])>) -> (RowMajorMatrix<F>, Vec<Call>) {
+    let mut v = vec![F::ZERO; KP_H * KP_W];
+    let mut calls = vec![];
+    for r in 0..KP_H {
+        v[r * KP_W + KP_LVL] = F::from_usize(r);
+    }
+    if let Some((leaf, path)) = leaf {
+        assert!(!path.is_empty() && path.len() < KP_H);
+        let mut cur = *leaf;
+        for r in 0..=path.len() {
+            let row = &mut v[r * KP_W..(r + 1) * KP_W];
+            row[KP_RCV] = F::ONE;
+            row[KP_CUR..KP_CUR + D].copy_from_slice(&cur);
+            if let Some(&(b, sib)) = path.get(r) {
+                row[KP_EN] = F::ONE;
+                row[KP_B] = F::from_bool(b);
+                row[KP_SIB..KP_SIB + D].copy_from_slice(&sib);
+                let (ll, rr) = if b { (sib, cur) } else { (cur, sib) };
+                calls.push(Call { seq: seq::of(seq::KD_LEAF, 0) + r as u32 + 1, tag: DOM_KEYNODE, words: cat(&[&ll, &rr]) });
+                cur = key_node(&ll, &rr);
+            }
+        }
+    }
+    (RowMajorMatrix::new(v, KP_W), calls)
+}
