From 3607e9544307e878f01d14cba9e51ca4e577c4e2 Mon Sep 17 00:00:00 2001
From: Charles Hoskinson <charles.hoskinson@gmail.com>
Date: Sat, 14 Nov 2026 04:01:56 -0700
Subject: [PATCH 6/6] recursion: stock last-row expression without child-meta
 (T7c)

Outside child-meta mode, ProofShapeAir keeps the stock form
sorted_idx - (n - 1) of the last-row condition, so the leaf-layer,
N1, N2, N3 and FV keys are byte-identical to T7 (MEASURED: t7_chain
shape keygen against the T7 chain.json pre-hashes). acb741e wrote it
as sorted_idx + 1 - n, the same polynomial in another symbolic form.
---
 crates/recursion/src/proof_shape/proof_shape/air.rs | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/crates/recursion/src/proof_shape/proof_shape/air.rs b/crates/recursion/src/proof_shape/proof_shape/air.rs
index 8ae6311..e2e1e28 100644
--- a/crates/recursion/src/proof_shape/proof_shape/air.rs
+++ b/crates/recursion/src/proof_shape/proof_shape/air.rs
@@ -976,9 +976,13 @@ where
         builder.assert_bool(local.is_last);
         builder.when(local.is_last).assert_zero(local.is_valid);
         builder.when(next.is_last).assert_one(local.is_valid);
-        builder
-            .when(local.sorted_idx + AB::F::ONE - num_airs.clone())
-            .assert_zero(next.is_last);
+        // the stock expression without meta (keys of every other layer byte-identical to T7)
+        let not_last_idx: AB::Expr = if self.meta_bus.is_some() {
+            local.sorted_idx + AB::F::ONE - num_airs.clone()
+        } else {
+            local.sorted_idx - AB::F::from_usize(self.per_air.len() - 1)
+        };
+        builder.when(not_last_idx).assert_zero(next.is_last);
 
         builder.when(local.is_last).assert_one(or(
             next.is_first,
