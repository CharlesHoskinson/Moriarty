+/// T7c child-meta mode: [`generate_symbolic_expr_cached_trace`] with the meta rows of the child
+/// key after the DAG rows, at the fixed `height`. A meta row has the invalid flag point (no DAG
+/// node) and `is_constraint = 1`; it carries `(air_idx, group, attrs[3], fanout,
+/// constraint_idx)` = `(i, g, the 5 values of group g of AIR i)`; the end row is
+/// `(num_airs, TERM, 0, ..)`.
+pub(crate) fn generate_symbolic_expr_cached_trace_meta(
+    cached_trace_record: &CachedTraceRecord,
+    child_vk: &MultiStarkVerifyingKey<BabyBearPoseidon2Config>,
+    height: usize,
+) -> RowMajorMatrix<F> {
+    use crate::proof_shape::proof_shape::air::meta;
+    let base = generate_symbolic_expr_cached_trace(cached_trace_record);
+    let cached_width = CachedSymbolicExpressionColumns::<F>::width();
+    let n = child_vk.inner.per_air.len();
+    let dag_rows = cached_trace_record.records.len();
+    let rows = dag_rows + 3 * n + 1;
+    assert!(height.is_power_of_two() && rows <= height, "T7c meta: {rows} cached rows over the fixed height {height}");
+    let mut v = F::zero_vec(cached_width * height);
+    v[..dag_rows * cached_width].copy_from_slice(&base.values[..dag_rows * cached_width]);
+    let mut r = dag_rows;
+    let mut put = |r: usize, air: usize, g: usize, vals: [F; meta::VALS]| {
+        let cols: &mut CachedSymbolicExpressionColumns<F> = v[r * cached_width..(r + 1) * cached_width].borrow_mut();
+        cols.air_idx = F::from_usize(air);
+        cols.node_or_interaction_idx = F::from_usize(g);
+        cols.attrs = [vals[0], vals[1], vals[2]];
+        cols.fanout = vals[3];
+        cols.constraint_idx = vals[4];
+        cols.is_constraint = F::ONE;
+    };
+    for i in 0..n {
+        let m = crate::proof_shape::proof_shape::trace::meta_row(child_vk, i, crate::proof_shape::proof_shape::trace::meta_gcsi(child_vk, i));
+        for (g, cols) in meta::GROUPS.iter().enumerate() {
+            put(r, i, g, cols.map(|c| c.map_or(F::ZERO, |c| m[c])));
+            r += 1;
+        }
+    }
+    put(r, n, meta::TERM, [F::ZERO; meta::VALS]);
+    RowMajorMatrix::new(v, cached_width)
+}
