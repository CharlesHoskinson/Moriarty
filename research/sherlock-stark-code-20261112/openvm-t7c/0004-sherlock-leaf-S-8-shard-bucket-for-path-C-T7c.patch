diff --git a/crates/sherlock-leaf/src/lib.rs b/crates/sherlock-leaf/src/lib.rs
index 9dd6422..4bbbdf0 100644
--- a/crates/sherlock-leaf/src/lib.rs
+++ b/crates/sherlock-leaf/src/lib.rs
@@ -14,3 +14,19 @@ pub mod rom;
 pub mod leaf;
 pub mod kits;
 pub mod ext;
+
+/// T7c (path C, the one-leaf Compact call): the S = 8 shard bucket ([`s8`]).
+pub mod s8;
+
+/// Slots per shard of the CORE module at `module_path` (8 under [`s8`], else 4).
+pub const fn slots(module_path: &str) -> usize {
+    let b = module_path.as_bytes();
+    let mut i = 0;
+    while i + 4 <= b.len() {
+        if b[i] == b':' && b[i + 1] == b':' && b[i + 2] == b's' && b[i + 3] == b'8' {
+            return 8;
+        }
+        i += 1;
+    }
+    4
+}
diff --git a/crates/sherlock-leaf/src/s8/mod.rs b/crates/sherlock-leaf/src/s8/mod.rs
new file mode 100644
index 0000000..f6e39ce
