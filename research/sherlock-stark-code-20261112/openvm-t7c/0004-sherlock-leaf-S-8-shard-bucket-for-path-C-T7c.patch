+++ b/crates/sherlock-leaf/src/s8/mod.rs
@@ -0,0 +1,8 @@
+//! T7c (path C, the one-leaf Compact call): the S = 8 shard bucket. The same `core.rs` and
+//! `leaf.rs` compiled a second time, with [`crate::slots`] = 8 (CORE height 16); the other AIRs
+//! are shared. `entry x;` (5 steps) is one shard here, two at S = 4.
+
+#[path = "../core.rs"]
+pub mod core;
+#[path = "../leaf.rs"]
+pub mod leaf;
