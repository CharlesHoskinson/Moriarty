From f143943fa660909f97ff682e7126cf5fed14df91 Mon Sep 17 00:00:00 2001
From: Charles Hoskinson <charles.hoskinson@gmail.com>
Date: Fri, 13 Nov 2026 19:27:00 -0700
Subject: [PATCH 5/6] T6: SHK_RULES tag 64 (58 to 62 are the ENC-5 parts by the
 T9 lead ruling, 63 is left for SHK_SHAPE)

---
 crates/sherlock-leaf/src/enc.rs | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/crates/sherlock-leaf/src/enc.rs b/crates/sherlock-leaf/src/enc.rs
index 970815f..df02671 100644
--- a/crates/sherlock-leaf/src/enc.rs
+++ b/crates/sherlock-leaf/src/enc.rs
@@ -31,9 +31,10 @@ pub const DOM_TASKS: u32 = 38;
 pub const DOM_ROMLEAF: u32 = 39;
 pub const DOM_ROMNODE: u32 = 40;
 pub const DOM_PLAN: u32 = 41;
-/// PICK: `dom("SHK_RULES")` has no code in FP-4; 58 is the next free code (FP-4: later digests
-/// take the next free codes in registry order, 45 to 57 are the type and name digests).
-pub const SHK_RULES: u32 = 58;
+/// PICK: `dom("SHK_RULES")` has no code in FP-4. FP-9.5 holds 45 to 57, the T9 lead ruling
+/// gives 58 to 62 to the ENC-5 parts and the next code after 62 to `SHK_SHAPE`, so the slice
+/// takes 64 (FP-4: later digests take the next free codes in registry order).
+pub const SHK_RULES: u32 = 64;
 /// PICK: body schema id of the slice body (476 words).
 pub const SCHEMA_ID: u32 = 1;
 
