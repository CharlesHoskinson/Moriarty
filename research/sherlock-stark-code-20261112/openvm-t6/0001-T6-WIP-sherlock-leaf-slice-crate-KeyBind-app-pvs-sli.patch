+/// T6: `trace` of a leaf layer whose app children have public values `app_pvs` (one vector per
+/// child proof); the values fill the extra columns of [`KeyBindAir::with_app_pvs`].
+pub fn trace_app(app_pvs: &[Vec<F>], child: VkCommit) -> (RowMajorMatrix<F>, Vec<F>) {
+    let n = app_pvs[0].len();
+    let (t, pvs) = trace(&Role::Leaf, app_pvs, child);
+    let h = t.height();
+    let w = WIDTH + n;
+    let mut v = vec![F::ZERO; h * w];
+    for r in 0..h {
+        v[r * w..r * w + WIDTH].copy_from_slice(&t.values[r * WIDTH..(r + 1) * WIDTH]);
