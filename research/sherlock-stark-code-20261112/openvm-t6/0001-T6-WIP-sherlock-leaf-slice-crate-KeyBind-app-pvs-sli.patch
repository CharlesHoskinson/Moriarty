new file mode 100644
index 0000000..5142a61
--- /dev/null
+++ b/crates/sherlock-leaf/src/dec.rs
@@ -0,0 +1,119 @@
+//! DEC (V.5, DEC-001 and DEC-004 over the subset rows): the table of the idle row and the five
+//! rules of the V.1 program.
+//!
+//! Message (FP-1 bus 6, T5 section 3.5 choice C3-2): `dec_key = class: tag(7)`, `rule_lane =
+//! class` (O3-1 (a)), `microplan_id`, `write_set_id` and `n_f = 3` flag bits. PICK (O3-2 open):
+//! `microplan_id = write_set_id = class`; the flags are the charges of the rule: `fuel`
+//! (remaining work -1, consumed work +1), `helper_work` +1 and `reference_cursor` +1, read from
+//! the V.1 reference run (RESULTS V.1, writes per step).
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{bus, enc::F};
+
+/// Subset rules in CORE selector order: (name, class = T5 3.4 ordinal, flags fuel/hw/rc).
+pub const RULES: [(&str, u32, [u32; 3]); 5] = [
+    ("BHelperEnvGetEntry", 89, [1, 1, 0]),
+    ("BHelperEnvGetEmpty", 12, [1, 1, 0]),
+    ("BHelperEnvGetFailure", 10, [1, 1, 0]),
+    ("KMachineEvalVariableAbsent", 67, [1, 0, 1]),
+    ("KAdminPublishError", 1, [0, 0, 0]),
+];
+pub const R_ENTRY: usize = 0;
+pub const R_EMPTY: usize = 1;
+pub const R_FAILURE: usize = 2;
+pub const R_ABSENT: usize = 3;
+pub const R_PUBLISH: usize = 4;
+pub const NF: usize = 3;
+/// Message words: key, lane, microplan, write set, flags.
+pub const MSG: usize = 4 + NF;
+/// Table height: idle + 5 rules + 2 padding rows (off the bus).
+pub const HEIGHT: usize = 8;
+
+/// Row `j` of the table: (class, flags); row 0 is idle.
+pub fn row(j: usize) -> (u32, [u32; 3]) {
+    match j {
+        0 => (0, [0; 3]),
+        1..=5 => (RULES[j - 1].1, RULES[j - 1].2),
+        _ => (0, [0; 3]),
+    }
+}
+
+/// The DEC message of `(class, flags)`.
+pub fn msg(class: u32, f: [u32; 3]) -> [u32; MSG] {
+    [class, class, class, class, f[0], f[1], f[2]]
+}
+
+/// Columns: one-hot row index `e[8]`, `mult`.
+pub const C_E: usize = 0;
+pub const C_MULT: usize = HEIGHT;
+pub const WIDTH: usize = HEIGHT + 1;
+
+pub struct DecAir;
+
+impl<T> BaseAir<T> for DecAir {
+    fn width(&self) -> usize {
+        WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for DecAir {}
+impl<T> PartitionedBaseAir<T> for DecAir {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for DecAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let e = |j: usize| -> AB::Expr { l[C_E + j].into() };
+        let mut sum = AB::Expr::ZERO;
+        for j in 0..HEIGHT {
+            builder.assert_bool(e(j));
+            sum += e(j);
+        }
+        builder.assert_one(sum);
+        builder.when_first_row().assert_one(e(0));
+        for j in 0..HEIGHT - 1 {
+            builder.when_transition().assert_eq(n[C_E + j + 1].into(), e(j));
+        }
+        // Padding rows are off the bus.
+        builder.assert_zero((e(6) + e(7)) * l[C_MULT].into());
+        let m: Vec<AB::Expr> = (0..MSG)
+            .map(|k| {
+                (0..HEIGHT).fold(AB::Expr::ZERO, |a, j| {
+                    let (c, f) = row(j);
+                    a + e(j) * AB::Expr::from_u32(msg(c, f)[k])
+                })
+            })
+            .collect();
+        bus::lookup(bus::DEC).add_key_with_lookups(builder, m, l[C_MULT]);
+    }
+}
+
+/// DEC trace with the lookup count of each row (`counts[j]` for table row `j`).
+pub fn trace(counts: [u32; HEIGHT]) -> RowMajorMatrix<F> {
+    let mut v = vec![F::ZERO; HEIGHT * WIDTH];
+    for j in 0..HEIGHT {
+        v[j * WIDTH + C_E + j] = F::ONE;
+        v[j * WIDTH + C_MULT] = F::from_u32(counts[j]);
+    }
+    RowMajorMatrix::new(v, WIDTH)
+}
+
+/// Table row of a CORE selector (`None` for idle).
+pub fn table_row(sel: Option<usize>) -> usize {
+    sel.map(|r| r + 1).unwrap_or(0)
+}
+
+#[allow(dead_code)]
+fn _h(m: &RowMajorMatrix<F>) -> usize {
+    m.height()
+}
diff --git a/crates/sherlock-leaf/src/enc.rs b/crates/sherlock-leaf/src/enc.rs
new file mode 100644
index 0000000..970815f
