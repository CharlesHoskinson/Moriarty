@@ -0,0 +1,182 @@
+//! SG-2 and SG-3 on real proofs at the app set.
+//!
+//! - Positive: real proof by the stark-backend prover, the stock verifier accepts, and the debug
+//!   constraint checker passes.
+//! - Negative: the debug checker names the failing constraint or bus; a proof made with the
+//!   debug checker off (and `SB_MUTANT_PROVER` set, so a nonzero LogUp root does not stop the
+//!   prover) is refused by the stock verifier; the weakened control AIR set gives a proof of the
+//!   same witness that the stock verifier accepts. A prover panic or error earns no credit.
+
+use std::time::Instant;
+
+use openvm_cpu_backend::CpuBackend;
+use openvm_stark_backend::{
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    p3_matrix::dense::RowMajorMatrix,
+    proof::Proof,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, StarkEngine,
+};
+use openvm_stark_sdk::config::baby_bear_poseidon2::{BabyBearPoseidon2Config, BabyBearPoseidon2CpuEngine, DuplexSponge};
+use serde_json::{json, Value};
+use sherlock_lfr::frozen;
+
+use crate::enc::F;
+
+pub type SC = BabyBearPoseidon2Config;
+pub type Eng = BabyBearPoseidon2CpuEngine<DuplexSponge>;
+
+pub fn engine() -> Eng {
+    Eng::new(frozen::APP.params())
+}
+
+/// One AIR's trace and public values.
+pub struct Tr {
+    pub m: RowMajorMatrix<F>,
+    pub pvs: Vec<F>,
+}
+
+impl Tr {
+    pub fn new(m: RowMajorMatrix<F>) -> Self {
+        Self { m, pvs: vec![] }
+    }
+}
+
+/// A keyed AIR set: every AIR required (SG-1), checked against the app set bounds (SG-4).
+pub struct Keyed {
+    pub airs: Vec<AirRef<SC>>,
+    pub pk: MultiStarkProvingKey<SC>,
+    pub vk: MultiStarkVerifyingKey<SC>,
+    pub shape: Value,
+}
+
+pub fn key(eng: &Eng, airs: Vec<AirRef<SC>>) -> Result<Keyed, String> {
+    frozen::check_params(&frozen::APP, eng.params()).map_err(|e| format!("{e}"))?;
+    let (pk, vk) = frozen::keygen_required(eng, &airs);
+    let s = frozen::check_vk(&frozen::APP, &vk).map_err(|e| format!("{e}"))?;
+    let per: Vec<Value> = vk
+        .inner
+        .per_air
+        .iter()
+        .zip(&airs)
+        .map(|(a, air)| {
+            json!({
+                "air": air.name(),
+                "columns": a.params.width.total_width(),
+                "constraints": a.symbolic_constraints.constraints.constraint_idx.len(),
+                "interactions": a.symbolic_constraints.interactions.len(), "degree": a.max_constraint_degree,
+                "public_values": a.params.num_public_values,
+                "required": a.is_required,
+            })
+        })
+        .collect();
+    let opt: Vec<usize> = vk.inner.per_air.iter().enumerate().filter(|(_, a)| !a.is_required).map(|(i, _)| i).collect();
+    if !opt.is_empty() {
+        return Err(format!("SG-1: optional AIRs {opt:?}"));
+    }
+    let shape = json!({
+        "airs": s.airs, "columns": s.columns, "max_constraints": s.max_constraints,
+        "max_interactions": s.max_interactions, "max_degree": s.max_degree,
+        "public_values": s.public_values, "per_air": per,
+    });
+    Ok(Keyed { airs, pk, vk, shape })
+}
+
+fn ctx(eng: &Eng, trs: &[Tr]) -> ProvingContext<CpuBackend<SC>> {
+    ProvingContext::new(
+        trs.iter()
+            .enumerate()
+            .map(|(i, t)| {
+                let cm = ColMajorMatrix::from_row_major(&t.m);
+                (i, AirProvingContext::simple(eng.device().transport_matrix_to_device(&cm), t.pvs.clone()))
+            })
+            .collect(),
+    )
+}
+
+pub fn guard<T>(f: impl FnOnce() -> Result<T, String>) -> Result<T, String> {
+    let prev = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let r = match std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)) {
+        Ok(r) => r,
+        Err(e) => Err(format!(
+            "panic: {}",
+            e.downcast_ref::<String>()
+                .cloned()
+                .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_default()
+        )),
+    };
+    std::panic::set_hook(prev);
+    r
+}
+
+/// The debug checker verdict: `Ok` when every constraint and bus holds, else its message.
+pub fn debug(eng: &Eng, k: &Keyed, trs: &[Tr]) -> Result<(), String> {
+    let c = ctx(eng, trs);
+    guard(|| {
+        eng.debug(&k.airs, &c);
+        Ok(())
+    })
+    .map_err(|e| e.chars().take(600).collect())
+}
+
+/// Prove (with or without the mutant switch) and verify with the stock verifier.
+pub fn prove(eng: &Eng, k: &Keyed, trs: &[Tr], mutant: bool) -> (Result<Proof<SC>, String>, Result<(), String>, f64) {
+    let t = Instant::now();
+    let d_pk = eng.device().transport_pk_to_device(&k.pk);
+    let c = ctx(eng, trs);
+    if mutant {
+        std::env::set_var("SB_MUTANT_PROVER", "1");
+    }
+    let p = guard(|| eng.prove(&d_pk, c).map_err(|e| format!("prove: {e:?}")));
+    std::env::remove_var("SB_MUTANT_PROVER");
+    let secs = t.elapsed().as_secs_f64();
+    match p {
+        Ok(p) => {
+            let v = eng.verify(&k.vk, &p).map_err(|e| format!("{e:?}"));
+            (Ok(p), v, secs)
+        }
+        Err(e) => (Err(e), Err("no proof".into()), secs),
+    }
+}
+
+/// SG-2 record of a positive; `pass` only when debug, prove and verify all succeed.
+pub fn positive(eng: &Eng, k: &Keyed, name: &str, trs: &[Tr]) -> Value {
+    let d = debug(eng, k, trs);
+    let (p, v, secs) = prove(eng, k, trs, false);
+    let heights: Vec<usize> = trs.iter().map(|t| t.m.height()).collect();
+    let pass = d.is_ok() && p.is_ok() && v.is_ok();
+    json!({
+        "case": name, "kind": "positive", "pass": pass,
+        "debug": fmt(&d), "prove": p.as_ref().map(|_| "ok".to_string()).unwrap_or_else(|e| e.clone()),
+        "verify": fmt(&v), "prove_seconds": secs, "heights": heights,
+    })
+}
+
+/// SG-3 record of a mutant: the correct key `k` and the weakened control key `weak`.
+pub fn negative(eng: &Eng, k: &Keyed, weak: &Keyed, name: &str, trs: &[Tr]) -> Value {
+    let d = debug(eng, k, trs);
+    let (p, v, _) = prove(eng, k, trs, true);
+    let (pw, vw, _) = prove(eng, weak, trs, false);
+    let dw = debug(eng, weak, trs);
+    let refused = p.is_ok() && v.is_err();
+    let control = pw.is_ok() && vw.is_ok();
+    let pass = d.is_err() && refused && control;
+    json!({
+        "case": name, "kind": "mutant", "pass": pass,
+        "debug": fmt(&d),
+        "prove": p.as_ref().map(|_| "proof made".to_string()).unwrap_or_else(|e| e.clone()),
+        "stock_verifier": fmt(&v),
+        "weak_control": {"debug": fmt(&dw), "prove": pw.as_ref().map(|_| "proof made".to_string()).unwrap_or_else(|e| e.clone()), "stock_verifier": fmt(&vw)},
+    })
+}
+
+fn fmt(r: &Result<(), String>) -> String {
+    match r {
+        Ok(()) => "accepts".into(),
+        Err(e) => format!("refuses: {}", e.chars().take(300).collect::<String>()),
+    }
+}
+
+use openvm_stark_backend::p3_matrix::Matrix;
diff --git a/crates/sherlock-leaf/src/kits.rs b/crates/sherlock-leaf/src/kits.rs
new file mode 100644
index 0000000..a63f4dd
--- /dev/null
+++ b/crates/sherlock-leaf/src/kits.rs
@@ -0,0 +1,225 @@
+//! Kit-level AIR sets of the slice gates (V.2, V.3, V.6): small requester AIRs that drive one
+//! kit on its own bus or port, proved with the stock prover at the app set.
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    interaction::{InteractionBuilder, LookupBus},
+    p3_air::{Air, AirBuilder, AirBuilderWithPublicValues, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bus::{self, seq},
+    enc::{Digest, D, F},
+    mem::{self, Window, NA, W_REC},
+};
+
+pub mod weak {
+    /// RangeProbe: the port limbs are copies of the source lane.
+    pub const RANGE_COPY: u64 = 1 << 32;
+    /// RangeProbe: limb 0 is looked up in the RANGE table.
+    pub const RANGE_LIMB0: u64 = 1 << 33;
+}
+
+// ---------------------------------------------------------------- RANGE port probe (V.3)
+/// One row per checked lane: `src[8]` (the typed lane, 4 or 8 limbs used), `lim[8]` (the port
+/// limbs), `n8` (1 for a `u128` lane, 0 for `u64`), `act`.
+pub struct RangeProbe {
+    pub weak: u64,
+}
+pub const RP_SRC: usize = 0;
+pub const RP_LIM: usize = 8;
+pub const RP_N8: usize = 16;
+pub const RP_ACT: usize = 17;
+pub const RP_WIDTH: usize = 18;
+
+impl<T> BaseAir<T> for RangeProbe {
+    fn width(&self) -> usize {
+        RP_WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for RangeProbe {}
+impl<T> PartitionedBaseAir<T> for RangeProbe {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for RangeProbe {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let lr = main.row_slice(0).unwrap();
+        let l: &[AB::Var] = (*lr).borrow();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        builder.assert_bool(c(RP_ACT));
+        builder.assert_bool(c(RP_N8));
+        let range = bus::range();
+        for i in 0..8 {
+            if self.weak & weak::RANGE_COPY == 0 {
+                builder.assert_eq(c(RP_LIM + i), c(RP_SRC + i));
+            }
+            let cnt = if i < 4 { c(RP_ACT) } else { c(RP_ACT) * c(RP_N8) };
+            if i == 0 && self.weak & weak::RANGE_LIMB0 != 0 {
+                continue;
+            }
+            range.range_check(c(RP_LIM + i), 16).eval(builder, cnt);
+        }
+        // a u64 lane has zero upper limbs
+        for i in 4..8 {
+            builder.assert_zero((AB::Expr::ONE - c(RP_N8)) * c(RP_SRC + i));
+        }
+    }
+}
+
+/// RangeProbe rows `(src limbs, port limbs, is u128)` at height 8, and the range counts (with
+/// `skip0`, limb 0 is not counted: the witness of the weakened control).
+pub fn range_probe(rows: &[([u32; 8], [u32; 8], bool)], skip0: bool, add: &mut dyn FnMut(u32, usize)) -> RowMajorMatrix<F> {
+    let h = 8;
+    let mut v = vec![F::ZERO; h * RP_WIDTH];
+    for (r, (src, lim, n8)) in rows.iter().enumerate() {
+        let row = &mut v[r * RP_WIDTH..(r + 1) * RP_WIDTH];
+        for i in 0..8 {
+            row[RP_SRC + i] = F::from_u32(src[i]);
+            row[RP_LIM + i] = F::from_u32(lim[i]);
+            if (i < 4 || *n8) && !(i == 0 && skip0) {
+                add(lim[i], 16);
+            }
+        }
+        row[RP_N8] = F::from_bool(*n8);
+        row[RP_ACT] = F::ONE;
+    }
+    RowMajorMatrix::new(v, RP_WIDTH)
+}
+
+// ---------------------------------------------------------------- BUS probe (V.2)
+/// A requester on chip id `id` (one row, one request of the message `[x, 1]`), and an optional
+/// provider of the same message: the provider exists only in the weakened control (a chip
+/// assigned to a reserved id).
+pub struct BusProbe {
+    pub index: u16,
+    pub provider: bool,
+}
+
+impl<T> BaseAir<T> for BusProbe {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for BusProbe {}
+impl<T> PartitionedBaseAir<T> for BusProbe {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for BusProbe {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let lr = main.row_slice(0).unwrap();
+        let l: &[AB::Var] = (*lr).borrow();
+        builder.assert_bool(l[1]);
+        let b = LookupBus::new(self.index);
+        if self.provider {
+            b.add_key_with_lookups(builder, [l[0].into(), AB::Expr::ONE], l[1]);
+        } else {
+            b.lookup_key(builder, [l[0].into(), AB::Expr::ONE], l[1]);
+        }
+    }
+}
+
+pub fn bus_probe(x: u32) -> RowMajorMatrix<F> {
+    let mut v = vec![F::ZERO; 4];
+    v[0] = F::from_u32(x);
+    v[1] = F::ONE;
+    RowMajorMatrix::new(v, 2)
+}
+
+// ---------------------------------------------------------------- MEM driver (V.6)
+/// The CORE side of the MEM window in a kit test: one row per append receives `(kind, addr,
+/// rec)` on the MEM bus; the first row receives the pre and post tokens whose values are the
+/// public values `[len_pre (5), root (8), tail_pre (8), len_post (5), tail_post (8)]`.
+pub struct MemDriver {
+    pub weak: u64,
+}
+pub const MD_ACT: usize = 0;
+pub const MD_F0: usize = 1;
+pub const MD_KIND: usize = 2;
+pub const MD_ADDR: usize = 3;
+pub const MD_REC: usize = MD_ADDR + NA;
+pub const MD_WIDTH: usize = MD_REC + W_REC;
+pub const MD_PVS: usize = 2 * NA + 3 * D;
+
+impl<T> BaseAir<T> for MemDriver {
+    fn width(&self) -> usize {
+        MD_WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for MemDriver {
+    fn num_public_values(&self) -> usize {
+        MD_PVS
+    }
+}
+impl<T> PartitionedBaseAir<T> for MemDriver {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder + AirBuilderWithPublicValues> Air<AB> for MemDriver {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let pv: Vec<AB::Expr> = builder.public_values().iter().map(|&x| x.into()).collect();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        builder.assert_bool(c(MD_ACT));
+        builder.when_first_row().assert_one(c(MD_F0));
+        builder.when_transition().assert_zero(n[MD_F0].into());
+        let mut m = vec![c(MD_KIND)];
+        m.extend((0..NA + W_REC).map(|k| c(MD_ADDR + k)));
+        bus::mem_bus().receive(builder, m, c(MD_ACT));
+        let root = NA;
+        for (s, lo, to) in [(seq::TOKEN_PRE, 0, NA + D), (seq::TOKEN_POST, NA + 2 * D, 2 * NA + 2 * D)] {
+            let mut m = vec![AB::Expr::from_u32(s)];
+            m.extend((0..NA).map(|k| pv[lo + k].clone()));
+            m.extend((0..D).map(|k| pv[root + k].clone()));
+            let tail = self.weak & mem::weak::MEM_TOKEN_TAIL == 0;
+            m.extend((0..D).map(|k| if tail { pv[to + k].clone() } else { AB::Expr::ZERO }));
+            bus::perm(bus::PORT_MEM_TOKEN).receive(builder, m, c(MD_F0));
+        }
+    }
+}
+
+/// MemDriver trace (height 8) for the records `recs` at addresses `addrs`, with public values
+/// `(len_pre, root, tail_pre, len_post, tail_post)`.
+pub fn mem_driver(
+    recs: &[mem::Rec],
+    addrs: &[u128],
+    len_pre: u128,
+    root: &Digest,
+    tail_pre: &Digest,
+    len_post: u128,
+    tail_post: &Digest,
+) -> (RowMajorMatrix<F>, Vec<F>) {
+    let h = 8;
+    let mut v = vec![F::ZERO; h * MD_WIDTH];
+    v[MD_F0] = F::ONE;
+    for (r, (rec, &a)) in recs.iter().zip(addrs).enumerate() {
+        let row = &mut v[r * MD_WIDTH..(r + 1) * MD_WIDTH];
+        row[MD_ACT] = F::ONE;
+        row[MD_KIND] = F::from_u32(rec.kind);
+        row[MD_ADDR..MD_ADDR + NA].copy_from_slice(&mem::addr_limbs(a));
+        row[MD_REC..MD_REC + W_REC].copy_from_slice(&rec.rec);
+    }
+    let mut pvs = mem::addr_limbs(len_pre).to_vec();
+    pvs.extend_from_slice(root);
+    pvs.extend_from_slice(tail_pre);
+    pvs.extend(mem::addr_limbs(len_post));
+    pvs.extend_from_slice(tail_post);
+    (RowMajorMatrix::new(v, MD_WIDTH), pvs)
+}
+
+/// Default window of the kit test: three appends at `len_pre`.
+pub fn window(len_pre: u128, n: usize) -> Window {
+    let recs = (0..n)
+        .map(|i| mem::Rec { kind: 1 + (i as u32 % 4), rec: std::array::from_fn(|k| F::from_usize(100 * i + k)) })
+        .collect();
+    Window { len_pre, root: crate::enc::d_empty(), tail_pre: crate::enc::d_empty(), appends: recs }
+}
+
+#[allow(dead_code)]
+fn _h(m: &RowMajorMatrix<F>) -> usize {
+    m.height()
+}
