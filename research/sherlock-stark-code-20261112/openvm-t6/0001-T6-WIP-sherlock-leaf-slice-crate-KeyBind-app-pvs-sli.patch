+//! V.9: the slice leaf shard. The V.1 program `entry x;` from the Moriarty reference run
+//! (`slice_v1.json`, test `slice_v1_candidates`), its ROM, its admission and its shards, and the
+//! AIR list of one fixed-shape leaf shard with every trace at its fixed height.
+
+use std::{collections::BTreeMap, sync::Arc};
+
+use openvm_circuit_primitives::var_range::{VariableRangeCheckerAir, VariableRangeCheckerChip};
+use openvm_stark_backend::{p3_field::PrimeCharacteristicRing, AirRef};
+use serde_json::Value;
+
+use crate::{
+    bus,
+    core::{self, CoreAir, Opts, ShardIn, ROMW, S},
+    dec::{self, DecAir, R_ABSENT, R_EMPTY, R_ENTRY, R_FAILURE, R_PUBLISH},
+    enc::*,
+    harness::{Tr, SC},
+    mem::{self, MemAir, Window},
+    rom::{self, Open, RomAir},
+    sponge::{self, hash2_trace, sponge_trace, Call, Hash2Air, SpongeAir, H2},
+};
+
+/// Fixed heights of the shape (SG-4): CORE, DEC, RANGE, SPONGE, HASH2, ROM, MEM.
+pub const H_SPONGE: usize = 512;
+pub const H_HASH2: usize = 128;
+pub const NAMES: [&str; 7] = ["CORE", "DEC", "RANGE", "SPONGE", "HASH2", "ROM", "MEM"];
+pub const A_CORE: usize = 0;
+pub const A_DEC: usize = 1;
+pub const A_RANGE: usize = 2;
+pub const A_SPONGE: usize = 3;
+pub const A_HASH2: usize = 4;
+pub const A_ROM: usize = 5;
+pub const A_MEM: usize = 6;
+
+pub fn airs(weak: u64) -> Vec<AirRef<SC>> {
+    vec![
+        Arc::new(CoreAir::new(weak)),
+        Arc::new(DecAir),
+        Arc::new(VariableRangeCheckerAir::new(bus::range())),
+        Arc::new(SpongeAir::new(weak)),
+        Arc::new(Hash2Air { weak }),
+        Arc::new(RomAir { weak }),
+        Arc::new(MemAir { weak }),
+    ]
+}
+
+// ---------------------------------------------------------------- the reference run
+pub fn slice_json() -> Value {
+    let p = std::env::var("T6_SLICE_JSON").unwrap_or_else(|_| {
+        format!("{}/.cache/t6/out/slice_v1.json", std::env::var("HOME").unwrap())
+    });
+    serde_json::from_str(&std::fs::read_to_string(&p).unwrap_or_else(|e| panic!("{p}: {e}"))).unwrap()
+}
+
+fn run_of(j: &Value) -> &Value {
+    j["runs"].as_array().unwrap().iter().find(|r| r["name"] == "unbound").expect("run `unbound`")
+}
+
+fn num(v: &Value) -> u128 {
+    v.as_str().map(|s| s.parse().unwrap()).unwrap_or_else(|| v.as_u64().unwrap() as u128)
+}
+
+/// FP-9.2 rows of the program (tables 0, 1, 9, 11, 12, 21 of the run).
+pub fn rom_rows(run: &Value) -> Vec<RomRow> {
+    use Ty::*;
+    let t: BTreeMap<u32, Vec<Ty>> = BTreeMap::from([
+        (0, vec![Tag(4), U64, U64, U64, U64, U64, U64]),
+        (1, vec![Bit, U64, U64, U64]),
+        (9, vec![U64, Bit, U64, U64, U64, U64, U64]),
+        (11, vec![U64, U64, U64, U64, U64]),
+        (12, vec![U64, U64]),
+    ]);
+    let mut out = vec![];
+    for (k, rows) in run["rom_rows"].as_object().unwrap() {
+        let Ok(tbl) = k.parse::<u32>() else { continue };
+        for (i, row) in rows.as_array().unwrap().iter().enumerate() {
+            let lanes: Vec<u128> = row.as_array().unwrap().iter().map(num).collect();
+            let mut w: Vec<F> = vec![];
+            if tbl == 21 {
+                // name_d = P2(DOM_NAME, len: u32, bytes) (T5 C2-3), one byte per word.
+                let mut x = limbs_u128(lanes.len() as u128, 2);
+                x.extend(lanes.iter().map(|&b| F::from_u64(b as u64)));
+                w.extend(p2(52, &x));
+            } else {
+                let tys = t.get(&tbl).unwrap_or_else(|| panic!("ROM table {tbl} not typed in the slice"));
+                assert_eq!(tys.len(), lanes.len(), "table {tbl}");
+                for (ty, &x) in tys.iter().zip(&lanes) {
+                    w.extend(ty.enc(x));
+                }
+                if tbl == 9 {
+                    // PICK (AD-14 normal form waits on T5 5.5): builtin ty_d = P2(DOM_TY, row).
+                    w.extend(p2(45, &[F::from_usize(i)]));
+                }
+            }
+            assert!(w.len() <= W_ROM);
+            let mut rec = [F::ZERO; W_ROM];
+            rec[..w.len()].copy_from_slice(&w);
+            out.push(RomRow { tbl, row: i as u64, rec });
+        }
+    }
+    out
+}
+
+/// PICKs of the slice admission: versions 1, a test-only seeded salt `[1..8]`, `plan_d` of an
+/// empty plan, `key_root` given by the caller (a stand-in before V.10).
+pub fn admission(run: &Value, prog_root: Digest, key_root: Digest) -> Admission {
+    Admission {
+        prog_root,
+        layout_version: 1,
+        profile_id: 1,
+        entry_kind: 0,
+        entry_a: run["rom_rows"]["entry"].as_u64().unwrap(),
+        in_ty: [F::ZERO; D],
+        plan_d: plan_d_empty(),
+        key_root,
+        machine_version: 1,
+        salt: [1, 2, 3, 4, 5, 6, 7, 8],
+        val_d: val_none(),
+        fuel: num(&run["fuel"]),
+        stack_limit: num(&run["stack"]) as u64,
+    }
+}
+
+/// A body + header from the reference lanes of one state.
+pub fn state_of(lanes: &Value, adm: &Admission) -> State {
+    let lay = Layout::new();
+    let rf: Vec<u128> = lanes["root_frames"].as_array().unwrap().iter().map(num).collect();
+    let hl: Vec<u128> = lanes["helper"].as_array().unwrap().iter().map(num).collect();
+    let rs: Vec<u128> = lanes["result"].as_array().unwrap().iter().map(num).collect();
+    assert!(lanes["tasks"].as_array().unwrap().is_empty(), "slice: no task");
+    assert_eq!(rf.len(), 48, "slice: no frame");
+    let mut b = vec![F::ZERO; BODY_WORDS];
+    let mut put = |name: &str, v: u128| {
+        let f = lay.field(name);
+        b[f.off..f.off + f.ty.words()].copy_from_slice(&f.ty.enc(v));
+    };
+    for i in 0..17 {
+        put(&format!("ctl.{i}"), rf[2 + i]);
+    }
+    for (l, _) in reg_lanes() {
+        put(&format!("reg.{l}"), rf[l]);
+    }
+    put("frm.count", rf[47]);
+    for (i, &x) in hl.iter().enumerate() {
+        put(&format!("hlp.{i}"), x);
+    }
+    for (i, &x) in rs.iter().enumerate() {
+        put(&format!("res.{i}"), x);
+    }
+    let mut dg = |name: &str, d: Digest| {
+        let at = lay.at(name);
+        b[at..at + D].copy_from_slice(&d);
+    };
+    dg("frm.below", empty_frames());
+    dg("tsk.below", empty_tasks());
+    dg("mem.root", mem_root0());
+    dg("mem.tail", mem_tail0());
+    dg("prog_root", adm.prog_root);
+    dg("prog_d", adm.prog_d());
+    let mut op = [F::ZERO; D];
+    op[0] = F::from_u64(rf[24] as u64);
+    State {
+        hdr: Header {
+            outcome_tag: F::from_u64(rf[23] as u64),
+            outcome_payload: op,
+            input_d: adm.input_d(),
+            deps_d: empty_deps(),
+            view_root: view_none(),
+        },
+        body: b,
+    }
+}
+
+fn rule_of(name: &str) -> usize {
+    match name {
+        "BHelperEnvGetEntry" => R_ENTRY,
+        "BHelperEnvGetEmpty" => R_EMPTY,
+        "BHelperEnvGetFailure" => R_FAILURE,
+        "KMachineEvalVariableAbsent" => R_ABSENT,
+        "KAdminPublishError" => R_PUBLISH,
+        r => panic!("rule {r} not in the slice subset"),
+    }
+}
+
+/// The whole slice program: ROM, admission, the reference states and rules.
+pub struct Program {
+    pub rom: Vec<RomRow>,
+    pub adm: Admission,
+    pub states: Vec<State>,
+    pub rules: Vec<usize>,
+}
+
+pub fn program(key_root: Digest) -> Program {
+    let j = slice_json();
+    let run = run_of(&j);
+    let rom = rom_rows(run);
+    let (root, _) = rom_tree(&rom);
+    let adm = admission(run, root, key_root);
+    let steps = run["steps"].as_array().unwrap();
+    let mut states: Vec<State> = steps.iter().map(|s| state_of(&s["lanes_before"], &adm)).collect();
+    states.push(state_of(&steps.last().unwrap()["lanes_after"], &adm));
+    let rules = steps.iter().map(|s| rule_of(s["rule"].as_str().unwrap())).collect();
+    Program { rom, adm, states, rules }
+}
+
+/// The shards of the run at S slots each (the last one padded with disabled slots).
+pub fn shards(p: &Program) -> Vec<ShardIn> {
+    let expr0 = p.rom.iter().find(|r| r.tbl == 0 && r.row == p.adm.entry_a).unwrap();
+    let mut rr = [F::ZERO; ROMW];
+    rr.copy_from_slice(&expr0.rec[..ROMW]);
+    let mut out = vec![];
+    let mut i = 0;
+    while i < p.rules.len() {
+        let n = (p.rules.len() - i).min(S);
+        let mut states: Vec<State> = p.states[i..=i + n].to_vec();
+        let mut sel: Vec<Option<usize>> = p.rules[i..i + n].iter().map(|&r| Some(r)).collect();
+        while sel.len() < S {
+            sel.push(None);
+            states.push(states.last().unwrap().clone());
+        }
+        out.push(ShardIn { states, sel, h_pre: i as u64, adm: p.adm.clone(), rom: rr, nrom: 1 });
+        i += n;
+    }
+    out
+}
+
+/// Assembly knobs beyond the CORE ones.
+#[derive(Default)]
+pub struct Build {
+    pub core: Opts,
+    /// Override of the MEM window (default: no append at the shard's pre memory).
+    pub window: Option<Window>,
+    /// Patch of the sponge rows (row index, output state).
+    pub sponge_patch: Option<sponge::RowPatch>,
+    /// HASH2 tag word override for rows with this tag: (tag, t2).
+    pub h2_t2: Option<(u32, u32)>,
+}
+
+/// The seven traces of one shard at the fixed heights.
+pub fn traces(p: &Program, sh: &ShardIn, b: &Build) -> Vec<Tr> {
+    let lay = Layout::new();
+    let co = core::trace(sh, &b.core);
+    let reads: u32 = sh.sel.iter().filter(|s| matches!(s, Some(r) if *r == R_ENTRY || *r == R_ABSENT)).count() as u32;
+    let mut extra_reads = 0;
+    for &(_, r) in &b.core.extra_sel {
+        if r == R_ENTRY || r == R_ABSENT {
+            extra_reads += 1;
+        }
+    }
+    let expr0 = p.rom.iter().find(|r| r.tbl == 0 && r.row == sh.adm.entry_a).unwrap().clone();
+    let (rom_m, mut h2, mut calls_rom, root) = rom::trace(&p.rom, &[Open { row: expr0, mult: reads + extra_reads }]);
+    assert_eq!(root, sh.states[0].body[lay.at("prog_root")..lay.at("prog_root") + D]);
+    let s0 = &sh.states[0].body;
+    let w = b.window.clone().unwrap_or_else(|| Window {
+        len_pre: (0..5).map(|k| (s0[lay.at("mem.len") + k].as_canonical_u32() as u128) << (16 * k)).sum(),
+        root: s0[lay.at("mem.root")..lay.at("mem.root") + D].try_into().unwrap(),
+        tail_pre: s0[lay.at("mem.tail")..lay.at("mem.tail") + D].try_into().unwrap(),
+        appends: vec![],
+    });
+    let chip = VariableRangeCheckerChip::new(bus::range());
+    let (mem_m, h2m, calls_mem) = mem::trace(&w, &mut |v, bits| chip.add_count(v, bits));
+    h2.extend(h2m);
+    // HASH2: one row per distinct (tag, x, y).
+    let mut merged: Vec<H2> = vec![];
+    for h in h2 {
+        if let Some(m) = merged.iter_mut().find(|m| m.tag == h.tag && m.x == h.x && m.y == h.y) {
+            m.mult += h.mult;
+        } else {
+            merged.push(h);
+        }
+    }
+    if let Some((tag, t2)) = b.h2_t2 {
+        for m in merged.iter_mut().filter(|m| m.tag == tag) {
+            m.t2 = Some(t2);
+        }
+    }
+    let (h2_m, calls_h2) = hash2_trace(&merged, H_HASH2);
+    let mut calls: Vec<Call> = co.calls.clone();
+    calls.append(&mut calls_rom);
+    calls.extend(calls_mem);
+    calls.extend(calls_h2);
+    let sp = sponge_trace(&calls, H_SPONGE, b.sponge_patch.as_ref());
+    for &(v, bits) in &co.range {
+        chip.add_count(v, bits);
+    }
+    let rg = chip.generate_trace();
+    let dm = dec::trace(co.dec);
+    vec![
+        Tr { m: co.m, pvs: co.pvs },
+        Tr::new(dm),
+        Tr::new(rg),
+        Tr::new(sp),
+        Tr::new(h2_m),
+        Tr::new(rom_m),
+        Tr::new(mem_m),
+    ]
+}
+
+/// Sponge rows the shard needs (for the shape record).
+pub fn sponge_rows(calls: &[Call]) -> usize {
+    sponge::rows_of(calls)
+}
+
+use openvm_stark_backend::p3_field::PrimeField32;
