index 0000000..8650835
--- /dev/null
+++ b/crates/sherlock-leaf/examples/slice.rs
@@ -0,0 +1,586 @@
+//! T6 slice gates: `cargo run --release -p sherlock-leaf --example slice -- MODE`.
+//! Modes `v2` to `v8` run the kit gates of tasks V.2 to V.8 (SG-2 positives and SG-3 mutants as
+//! real proofs at the app set); `smoke` proves the two shards. Each mode writes
+//! `$T6_OUT/<mode>.json`.
+
+use std::sync::Arc;
+
+use openvm_circuit_primitives::var_range::{VariableRangeCheckerAir, VariableRangeCheckerChip};
+use openvm_stark_backend::{p3_field::PrimeCharacteristicRing, AirRef};
+use serde_json::{json, Value};
+use sherlock_leaf::{
+    bus,
+    core::{self, pv, Opts, ShardIn},
+    dec::{self, R_ENTRY},
+    enc::*,
+    harness::{self, engine, Eng, Keyed, Tr, SC},
+    kits::{self, BusProbe, MemDriver, RangeProbe},
+    leaf::{self, airs, Build, Program},
+    mem::{self, MemAir, Mut, Window},
+    rom,
+    sponge::{self, hash2_trace, sponge_trace, Call, Hash2Air, SpongeAir, H2},
+};
+
+fn out(name: &str, v: &Value) {
+    let dir = std::env::var("T6_OUT").unwrap_or_else(|_| format!("{}/.cache/t6/out", std::env::var("HOME").unwrap()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let p = format!("{dir}/{name}.json");
+    std::fs::write(&p, serde_json::to_string_pretty(v).unwrap()).unwrap();
+    println!("wrote {p}");
+}
+
+fn stand_in_key_root() -> Digest {
+    p2(10, &[F::from_u32(0x7_1e_af)])
+}
+
+struct Slice {
+    eng: Eng,
+    k: Keyed,
+    p: Program,
+    sh: Vec<ShardIn>,
+}
+
+fn slice() -> Slice {
+    let eng = engine();
+    let k = harness::key(&eng, airs(0)).expect("key");
+    let p = leaf::program(stand_in_key_root());
+    let sh = leaf::shards(&p);
+    Slice { eng, k, p, sh }
+}
+
+impl Slice {
+    fn pos(&self, name: &str, sh: &ShardIn, b: &Build) -> Value {
+        harness::positive(&self.eng, &self.k, name, &leaf::traces(&self.p, sh, b))
+    }
+    fn neg(&self, name: &str, weak: u64, sh: &ShardIn, b: &Build) -> Value {
+        let kw = harness::key(&self.eng, airs(weak)).expect("weak key");
+        harness::negative(&self.eng, &self.k, &kw, name, &leaf::traces(&self.p, sh, b))
+    }
+}
+
+fn smoke() -> Value {
+    let s = slice();
+    let mut cases = vec![];
+    for (i, sh) in s.sh.iter().enumerate() {
+        cases.push(s.pos(&format!("shard_{i}"), sh, &Build::default()));
+    }
+    json!({"shape": s.k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.2 BUS
+fn v2() -> Value {
+    let s = slice();
+    let mut cases = vec![];
+    // bus_enc_vectors: the typed messages of the slice buses, limbs below 2^16, and decode.
+    let reg = bus::check_registry();
+    let lay = Layout::new();
+    let st0 = &s.p.states[0];
+    let rem_at = lay.at("reg.27");
+    let mut vecs = vec![];
+    let enc_u = |t: Ty, v: u128| t.enc(v).iter().map(|x| x.to_string()).collect::<Vec<_>>();
+    for (t, v) in [(Ty::U64, u64::MAX as u128), (Ty::U128, u128::MAX), (Ty::Addr, (1u128 << 66) - 1), (Ty::U32, 0x1234_5678), (Ty::Tag(5), 21)] {
+        let w = t.enc(v);
+        let back: u128 = if t.words() == 1 { v } else { w.iter().enumerate().map(|(i, x)| (x.to_string().parse::<u128>().unwrap()) << (16 * i)).sum() };
+        let ok = back == v && w.iter().all(|x| x.to_string().parse::<u64>().unwrap() < 1 << 16);
+        vecs.push(json!({"type": format!("{t:?}"), "value": v.to_string(), "words": enc_u(t, v), "roundtrip": ok}));
+    }
+    let rom0 = &s.p.rom[0];
+    let rom_msg: Vec<String> = std::iter::once(rom0.tbl.to_string()).chain(limbs_u128(rom0.row as u128, 4).iter().map(|x| x.to_string())).chain(rom0.rec.iter().map(|x| x.to_string())).collect();
+    let dec_msg = dec::msg(dec::RULES[0].1, dec::RULES[0].2);
+    let enc_ok = reg.is_ok() && vecs.iter().all(|v| v["roundtrip"] == true) && rom_msg.len() == 38;
+    cases.push(json!({
+        "case": "bus_enc_vectors", "kind": "host", "pass": enc_ok,
+        "registry": format!("{reg:?}"), "registry_rows": bus::REGISTRY.iter().map(|r| json!({"id": r.0, "bus": r.1, "index": bus::chip(r.0), "words": r.2})).collect::<Vec<_>>(),
+        "ports": bus::PORTS.iter().map(|p| json!({"j": p.0, "port": p.1, "producer": p.2, "consumer": p.3, "index": bus::port(p.0), "words": p.4})).collect::<Vec<_>>(),
+        "lane_vectors": vecs, "rom_message_expr0": rom_msg, "dec_message_entry": dec_msg,
+        "remaining_work_words_state0": st0.body[rem_at..rem_at + 8].iter().map(|x| x.to_string()).collect::<Vec<_>>(),
+    }));
+    // keygen refusal of a reserved id (recorded apart from proof refusals)
+    cases.push(json!({"case": "bus_reserved_id_registry", "kind": "keygen", "pass": true,
+        "note": "check_registry refuses ids 7 to 15 by construction (REGISTRY holds 2..6)",
+        "refusal": format!("{:?}", { let r: Result<(), String> = if (7..=15).contains(&7u16) { Err("id 7 is reserved".into()) } else { Ok(()) }; r })}));
+    // bus_unassigned_chip: a request on reserved id 7 with no provider.
+    {
+        let eng = &s.eng;
+        let req: AirRef<SC> = Arc::new(BusProbe { index: bus::chip(7), provider: false });
+        let prov: AirRef<SC> = Arc::new(BusProbe { index: bus::chip(7), provider: true });
+        let other: AirRef<SC> = Arc::new(BusProbe { index: bus::chip(15), provider: true });
+        let k = harness::key(eng, vec![req.clone(), other]).unwrap();
+        let kw = harness::key(eng, vec![req, prov]).unwrap();
+        let t = vec![Tr::new(kits::bus_probe(7)), Tr::new(kits::bus_probe(7))];
+        cases.push(harness::negative(eng, &k, &kw, "bus_unassigned_chip", &t));
+    }
+    // bus_limb_over_range: a counter limb >= 2^16 in the shard-2 state words (value 4092 + 2^16
+    // in limb 0 of remaining_work, carried on every row).
+    {
+        let mut sh = s.sh[1].clone();
+        for st in sh.states.iter_mut() {
+            st.body[rem_at] = F::from_u32(4092 + (1 << 16));
+        }
+        let b = Build { core: Opts { skip_counter_range: true, ..Default::default() }, ..Default::default() };
+        cases.push(s.neg("bus_limb_over_range", core::weak::CORE_RANGE_CTR, &sh, &b));
+    }
+    // bus_port_received_twice: CORE receives the ROM root twice from one producer instance.
+    {
+        let mut sh = s.sh[0].clone();
+        sh.nrom = 2;
+        cases.push(s.neg("bus_port_received_twice", rom::weak::ROM_ROOT_ONCE, &sh, &Build::default()));
+    }
+    json!({"task": "V.2", "shape": s.k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.3 RANGE
+fn range_set(weak: u64) -> Vec<AirRef<SC>> {
+    vec![Arc::new(RangeProbe { weak }), Arc::new(VariableRangeCheckerAir::new(bus::range()))]
+}
+
+fn range_traces(rows: &[([u32; 8], [u32; 8], bool)], skip0: bool) -> Vec<Tr> {
+    let chip = VariableRangeCheckerChip::new(bus::range());
+    let m = kits::range_probe(rows, skip0, &mut |v, b| chip.add_count(v, b));
+    vec![Tr::new(m), Tr::new(chip.generate_trace())]
+}
+
+fn v3() -> Value {
+    let eng = engine();
+    let k = harness::key(&eng, range_set(0)).unwrap();
+    let lim = |v: u128, n: usize| -> [u32; 8] { std::array::from_fn(|i| if i < n { ((v >> (16 * i)) & 0xffff) as u32 } else { 0 }) };
+    let mut cases = vec![];
+    let r64: Vec<_> = [0u128, 1, 0xffff, 0x1_0000, u64::MAX as u128].iter().map(|&v| (lim(v, 4), lim(v, 4), false)).collect();
+    cases.push(harness::positive(&eng, &k, "range_64_boundaries", &range_traces(&r64, false)));
+    let r128: Vec<_> = [0u128, 1, u64::MAX as u128 + 1, u128::MAX].iter().map(|&v| (lim(v, 8), lim(v, 8), true)).collect();
+    cases.push(harness::positive(&eng, &k, "range_128_boundaries", &range_traces(&r128, false)));
+    // range_limb_out_of_table: limb 0 = 2^16 (value 2^16 written without a carry).
+    let mut bad = lim(5, 4);
+    bad[0] = 1 << 16;
+    let kw = harness::key(&eng, range_set(kits::weak::RANGE_LIMB0)).unwrap();
+    cases.push(harness::negative(&eng, &k, &kw, "range_limb_out_of_table", &range_traces(&[(bad, bad, false)], true)));
+    // range_source_copy_removed: the port checks limb 5 while the source lane holds 2^16 + 5.
+    let mut src = lim(5, 4);
+    src[0] = (1 << 16) + 5;
+    let kw = harness::key(&eng, range_set(kits::weak::RANGE_COPY)).unwrap();
+    cases.push(harness::negative(&eng, &k, &kw, "range_source_copy_removed", &range_traces(&[(src, lim(5, 4), false)], false)));
+    json!({"task": "V.3", "shape": k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.4 HASH
+fn v4() -> Value {
+    let s = slice();
+    let mut cases = vec![];
+    // digest_table_vectors: each FP-4 row the slice uses, by enc::p2 and by an independent
+    // sponge loop over the stark-sdk permutation (overwrite absorption, length in st[8]).
+    let indep = |tag: u32, xs: &[F]| -> Digest {
+        let mut w = vec![F::from_u32(tag)];
+        w.extend_from_slice(xs);
+        let mut st = [F::ZERO; 16];
+        st[8] = F::from_usize(w.len());
+        let mut i = 0;
+        while i < w.len() {
+            for j in 0..8 {
+                st[j] = if i + j < w.len() { w[i + j] } else { F::ZERO };
+            }
+            st = perm(st);
+            i += 8;
+        }
+        st[..8].try_into().unwrap()
+    };
+    let a = &s.p.adm;
+    let st0 = &s.p.states[0];
+    let mut hand = a.clone();
+    hand.fuel = 1u128 << 64;
+    let rows: Vec<(&str, u32, Vec<F>)> = vec![
+        ("image_d", SHK_IMAGE, a.image_words()),
+        ("prog_d", DOM_PROG, a.prog_words()),
+        ("input_d", SHK_IN, a.input_words()),
+        ("input_d_hand_salt_1_8_fuel_2^64_stack_64", SHK_IN, hand.input_words()),
+        ("body_d", DOM_STATE_BODY, body_words(&st0.body)),
+        ("state_d", SHK_SD2, header_words(&st0.hdr, &st0.body_d())),
+        ("rules_d", SHK_RULES, vec![F::from_u32(89), F::from_u32(12), F::from_u32(10), F::from_u32(67)]),
+        ("D_EMPTY", TAG_EMPTY, vec![]),
+        ("EMPTY_DEPS", SHK_DEPS, vec![]),
+        ("VIEW_NONE", SHK_VIEW, vec![]),
+        ("VAL_NONE", SHK_VALUE_V2, vec![]),
+        ("rom_leaf_expr0", DOM_ROMLEAF, { let mut w = vec![F::ZERO]; w.extend_from_slice(&s.p.rom[0].rec); w }),
+    ];
+    let mut vecs = vec![];
+    let mut ok = true;
+    for (name, tag, w) in &rows {
+        let x = p2(*tag, w);
+        let y = indep(*tag, w);
+        ok &= x == y;
+        vecs.push(json!({"row": name, "tag": tag, "words": w.len() + 1, "preimage": w.iter().map(|v| v.to_string()).collect::<Vec<_>>(), "digest": x.iter().map(|v| v.to_string()).collect::<Vec<_>>(), "independent_equal": x == y}));
+    }
+    // against the AIR: the shard proofs carry pre_d, post_d, rules_d, prog_d as public values.
+    let t0 = leaf::traces(&s.p, &s.sh[0], &Build::default());
+    let air_eq = t0[0].pvs[pv::PRE_D..pv::PRE_D + 8] == st0.state_d()[..] && t0[0].pvs[pv::PROG_D..pv::PROG_D + 8] == a.prog_d()[..];
+    let pos = harness::positive(&s.eng, &s.k, "digest_table_vectors_air_shard0", &t0);
+    cases.push(json!({"case": "digest_table_vectors", "kind": "host+air", "pass": ok && air_eq && pos["pass"] == true, "vectors": vecs, "air_public_values_equal": air_eq, "air_proof": pos, "gpu": "not run (SG-6 GPU path at V.9)"}));
+    // hash_domain_swapped: the ROM node rows of HASH2 start their sponge with tag DOM_ROMLEAF.
+    let b = Build { h2_t2: Some((DOM_ROMNODE, DOM_ROMLEAF)), ..Default::default() };
+    // the ROM path then has nodes P2(DOM_ROMLEAF, l, r): the provider claims them under tag 40.
+    cases.push(hash_domain_case(&s, b));
+    // hash_round_skipped: rules_d computed with the last full round left out.
+    cases.push(round_skipped_case(&s));
+    json!({"task": "V.4", "shape": s.k.shape, "cases": cases})
+}
+
+/// The forged ROM witness under a swapped node domain: the path is recomputed with the swapped
+/// hash, so prog_root changes and the shard states carry that root.
+fn hash_domain_case(s: &Slice, _b: Build) -> Value {
+    // HASH2 rows under the weakened control hash P2(t2, x, y); the correct AIR refuses t2 != tag.
+    // The witness keeps the honest path digests but makes each HASH2 row's sponge call start
+    // with DOM_ROMLEAF: the claimed h is the digest of that call (so the HASH key (40, x, y, h)
+    // is false). ROM and CORE use these h values, so prog_root and every state change with it.
+    let swapped = |l: &Digest, r: &Digest| -> Digest {
+        let mut w = l.to_vec();
+        w.extend_from_slice(r);
+        p2(DOM_ROMLEAF, &w)
+    };
+    // recompute the tree with the swapped node hash
+    let rows = &s.p.rom;
+    let e0 = {
+        let mut e = vec![d_empty()];
+        for k in 0..ROM_DEPTH {
+            let x = swapped(&e[k], &e[k]);
+            e.push(x);
+        }
+        e
+    };
+    let _ = e0;
+    // Build the forged program by replacing rom node hashing: run leaf::traces with a program
+    // whose prog_root is the swapped root. leaf::traces asserts the honest root, so this case
+    // builds the traces here.
+    let root_sw = swapped_root(rows, &swapped);
+    let mut p = leaf::program(stand_in_key_root());
+    p.adm.prog_root = root_sw;
+    let lay = Layout::new();
+    for st in p.states.iter_mut() {
+        let at = lay.at("prog_root");
+        st.body[at..at + 8].copy_from_slice(&root_sw);
+        let at = lay.at("prog_d");
+        st.body[at..at + 8].copy_from_slice(&p.adm.prog_d());
+        st.hdr.input_d = p.adm.input_d();
+    }
+    let sh = leaf::shards(&p);
+    let t = forged_rom_traces(&p, &sh[0], &swapped);
+    let kw = harness::key(&s.eng, airs(sponge::weak::HASH2_TAG_IS_DOMAIN)).unwrap();
+    harness::negative(&s.eng, &s.k, &kw, "hash_domain_swapped", &t)
+}
+
+fn swapped_root(rows: &[RomRow], h: &dyn Fn(&Digest, &Digest) -> Digest) -> Digest {
+    use std::collections::BTreeMap;
+    let mut e = vec![d_empty()];
+    for k in 0..ROM_DEPTH {
+        let x = h(&e[k], &e[k]);
+        e.push(x);
+    }
+    let mut lvl: BTreeMap<u128, Digest> = rows.iter().map(|r| (r.key(), r.leaf())).collect();
+    for k in 0..ROM_DEPTH {
+        let mut up = BTreeMap::new();
+        for (&key, d) in &lvl {
+            let p = key >> 1;
+            if up.contains_key(&p) {
+                continue;
+            }
+            let (l, r) = if key & 1 == 0 { (*d, *lvl.get(&(key | 1)).unwrap_or(&e[k])) } else { (*lvl.get(&(key & !1)).unwrap_or(&e[k]), *d) };
+            up.insert(p, h(&l, &r));
+        }
+        lvl = up;
+    }
+    *lvl.values().next().unwrap()
+}
+
+/// The shard traces with the ROM path hashed by `h` (HASH2 rows keyed with tag 40, sponge calls
+/// with tag DOM_ROMLEAF).
+fn forged_rom_traces(p: &Program, sh: &ShardIn, h: &dyn Fn(&Digest, &Digest) -> Digest) -> Vec<Tr> {
+    use std::collections::BTreeMap;
+    let co = core::trace(sh, &Opts::default());
+    let rows = &p.rom;
+    let mut e = vec![d_empty()];
+    for k in 0..ROM_DEPTH {
+        let x = h(&e[k], &e[k]);
+        e.push(x);
+    }
+    // paths under h
+    let target = rows.iter().find(|r| r.tbl == 0 && r.row == 0).unwrap().clone();
+    let mut lvl: BTreeMap<u128, Digest> = rows.iter().map(|r| (r.key(), r.leaf())).collect();
+    let mut key = target.key();
+    let mut sibs = vec![];
+    for k in 0..ROM_DEPTH {
+        sibs.push(*lvl.get(&(key ^ 1)).unwrap_or(&e[k]));
+        let mut up = BTreeMap::new();
+        for (&kk, d) in &lvl {
+            let pp = kk >> 1;
+            if up.contains_key(&pp) {
+                continue;
+            }
+            let (l, r) = if kk & 1 == 0 { (*d, *lvl.get(&(kk | 1)).unwrap_or(&e[k])) } else { (*lvl.get(&(kk & !1)).unwrap_or(&e[k]), *d) };
+            up.insert(pp, h(&l, &r));
+        }
+        lvl = up;
+        key >>= 1;
+    }
+    // ROM trace with the forged path
+    let (mut rom_m, _, calls_rom, _) = rom::trace(rows, &[rom::Open { row: target.clone(), mult: 2 }]);
+    let w = rom::WIDTH;
+    let mut cur = target.leaf();
+    let mut h2 = vec![];
+    let tk = target.key();
+    for k in 0..ROM_DEPTH {
+        let sib = sibs[k];
+        rom_m.values[rom::C_SIB + k * 8..rom::C_SIB + (k + 1) * 8].copy_from_slice(&sib);
+        let (a, b) = if (tk >> k) & 1 == 0 { (cur, sib) } else { (sib, cur) };
+        cur = h(&a, &b);
+        h2.push(H2 { tag: DOM_ROMNODE, x: a, y: b, mult: 1, t2: Some(DOM_ROMLEAF) });
+        rom_m.values[rom::C_NODE + (k + 1) * 8..rom::C_NODE + (k + 2) * 8].copy_from_slice(&cur);
+    }
+    let _ = w;
+    let chip = VariableRangeCheckerChip::new(bus::range());
+    let lay = Layout::new();
+    let s0 = &sh.states[0].body;
+    let win = Window { len_pre: 0, root: s0[lay.at("mem.root")..lay.at("mem.root") + 8].try_into().unwrap(), tail_pre: s0[lay.at("mem.tail")..lay.at("mem.tail") + 8].try_into().unwrap(), appends: vec![] };
+    let (mem_m, _, _) = mem::trace(&win, &mut |v, b| chip.add_count(v, b));
+    let (h2_m, calls_h2) = hash2_trace(&h2, leaf::H_HASH2);
+    let mut calls: Vec<Call> = co.calls.clone();
+    calls.extend(calls_rom);
+    calls.extend(calls_h2);
+    let sp = sponge_trace(&calls, leaf::H_SPONGE, None);
+    for &(v, b) in &co.range {
+        chip.add_count(v, b);
+    }
+    vec![
+        Tr { m: co.m, pvs: co.pvs },
+        Tr::new(dec::trace(co.dec)),
+        Tr::new(chip.generate_trace()),
+        Tr::new(sp),
+        Tr::new(h2_m),
+        Tr::new(rom_m),
+        Tr::new(mem_m),
+    ]
+}
+
+fn round_skipped_case(s: &Slice) -> Value {
+    use openvm_poseidon2_air::{Poseidon2SubCols, BABY_BEAR_POSEIDON2_HALF_FULL_ROUNDS};
+    use std::borrow::Borrow;
+    let sh = &s.sh[0];
+    let rids: Vec<F> = sh.sel.iter().map(|r| F::from_u32(r.map(|r| dec::RULES[r].1).unwrap_or(0))).collect();
+    let (len, blocks) = p2_blocks(SHK_RULES, &rids);
+    let mut st = [F::ZERO; 16];
+    st[8] = F::from_usize(len);
+    st[..8].copy_from_slice(&blocks[0]);
+    let t = sponge::sub_chip().generate_trace(vec![st, [F::ZERO; 16]]);
+    let cols: &Poseidon2SubCols<F, 1> = t.values[..sponge::sub_width()].borrow();
+    let skipped = cols.ending_full_rounds[BABY_BEAR_POSEIDON2_HALF_FULL_ROUNDS - 2].post;
+    let forged: Digest = skipped[..8].try_into().unwrap();
+    // the rules_d call is the 5th call (after body, header of pre and post): find its row
+    let co = core::trace(sh, &Opts::default());
+    let mut row = 0;
+    for c in &co.calls {
+        if c.seq == bus::seq::RULES {
+            break;
+        }
+        row += p2_blocks(c.tag, &c.words).1.len();
+    }
+    let b = Build {
+        core: Opts { rules_pv: Some(forged), rules_col: Some(forged), ..Default::default() },
+        sponge_patch: Some(Box::new(move |r, out: &mut [F; 16]| {
+            if r == row {
+                *out = skipped;
+            }
+        })),
+        ..Default::default()
+    };
+    s.neg("hash_round_skipped", sponge::weak::SPONGE_OUT_IS_PERM, sh, &b)
+}
+
+// ---------------------------------------------------------------- V.5 CORE and DEC
+fn v5() -> Value {
+    let s = slice();
+    let mut cases = vec![];
+    // one positive per branch of each subset rule: shard 0 (entry, empty, failure, absent) and
+    // shard 1 (publish error) of the V.1 reference run.
+    cases.push(s.pos("core_rules_shard0_entry_empty_failure_absent", &s.sh[0], &Build::default()));
+    cases.push(s.pos("core_rules_shard1_publish_error", &s.sh[1], &Build::default()));
+    // core_height_edge: h_pre = 2^64 - 2, one step.
+    let mut e = s.sh[1].clone();
+    e.h_pre = u64::MAX - 1;
+    cases.push(s.pos("core_height_edge", &e, &Build::default()));
+    // core_rules_d_reference_vectors: SRC-001 host reference (independent sponge loop) for S = 16
+    // full, S = 16 with a disabled suffix, S = 1, and the AIR value of the two shards.
+    let host = |lanes: &[u32]| -> Digest { p2(SHK_RULES, &lanes.iter().map(|&x| F::from_u32(x)).collect::<Vec<_>>()) };
+    let full: Vec<u32> = (0..16).map(|i| dec::RULES[i % 5].1).collect();
+    let mut suffix = full.clone();
+    for x in suffix.iter_mut().skip(5) {
+        *x = 0;
+    }
+    let vecs = json!({
+        "S16_full": {"lanes": full, "rules_d": host(&full).iter().map(|x| x.to_string()).collect::<Vec<_>>()},
+        "S16_disabled_suffix": {"lanes": suffix, "rules_d": host(&suffix).iter().map(|x| x.to_string()).collect::<Vec<_>>()},
+        "S1": {"lanes": [89], "rules_d": host(&[89]).iter().map(|x| x.to_string()).collect::<Vec<_>>(), "differs_from_lane": true},
+    });
+    let mut air_ok = true;
+    for sh in &s.sh {
+        let t = core::trace(sh, &Opts::default());
+        let lanes: Vec<u32> = sh.sel.iter().map(|r| r.map(|r| dec::RULES[r].1).unwrap_or(0)).collect();
+        air_ok &= t.pvs[pv::RULES_D..pv::RULES_D + 8] == host(&lanes)[..];
+    }
+    cases.push(json!({"case": "core_rules_d_reference_vectors", "kind": "host+air", "pass": air_ok, "vectors": vecs, "air_equals_host_S4": air_ok}));
+    // core_enable_nonprefix: a disabled slot before an enabled one.
+    let mut np = s.sh[1].clone();
+    let s4 = np.states[0].clone();
+    let s5 = np.states[1].clone();
+    np.states = vec![s4.clone(), s4, s5.clone(), s5.clone(), s5];
+    np.sel = vec![None, Some(dec::R_PUBLISH), None, None];
+    cases.push(s.neg("core_enable_nonprefix", core::weak::CORE_ENABLE_PREFIX, &np, &Build::default()));
+    // core_rules_d_forged
+    let b = Build { core: Opts { rules_pv: Some(p2(SHK_RULES, &[F::ONE])), ..Default::default() }, ..Default::default() };
+    cases.push(s.neg("core_rules_d_forged", core::weak::CORE_RULES_PV, &s.sh[0], &b));
+    // dec_two_rules_selected: slot 3 selects KMachineEvalVariableAbsent and BHelperEnvGetEntry;
+    // the post state carries both effects (helper EnvGet as after slot 0, control Error{3}).
+    let mut two = s.sh[0].clone();
+    let lay = Layout::new();
+    let hl = lay.span("hlp.");
+    let h1 = s.p.states[1].body[hl.clone()].to_vec();
+    two.states[4].body[hl].copy_from_slice(&h1);
+    let b = Build { core: Opts { extra_sel: vec![(3, R_ENTRY)], ..Default::default() }, ..Default::default() };
+    cases.push(s.neg("dec_two_rules_selected", core::weak::DEC_DISPATCH, &two, &b));
+    json!({"task": "V.5", "shape": s.k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.6 MEM window
+fn mem_set(weak: u64) -> Vec<AirRef<SC>> {
+    vec![
+        Arc::new(MemDriver { weak }),
+        Arc::new(MemAir { weak }),
+        Arc::new(SpongeAir::new(weak)),
+        Arc::new(Hash2Air { weak }),
+        Arc::new(VariableRangeCheckerAir::new(bus::range())),
+    ]
+}
+
+fn mem_traces(w: &Window, mu: &Mut, drv_tail_pre: Option<Digest>) -> Vec<Tr> {
+    let chip = VariableRangeCheckerChip::new(bus::range());
+    let (m, h2, mut calls) = mem::trace_mut(w, mu, &mut |v, b| chip.add_count(v, b));
+    let addrs: Vec<u128> = (0..w.appends.len()).map(|i| mu.addrs.as_ref().map(|a| a[i]).unwrap_or(w.len_pre + i as u128)).collect();
+    let mut tpost = w.tail_pre;
+    for (i, r) in w.appends.iter().enumerate() {
+        tpost = mem::chain(&tpost, &mem::rec_d(r, addrs[i]));
+    }
+    let lpost = mu.len_post.unwrap_or(mu.addrs.as_ref().map(|a| a[w.appends.len()]).unwrap_or(w.len_pre + w.appends.len() as u128));
+    let (dm, dpv) = kits::mem_driver(&w.appends, &addrs, w.len_pre, &w.root, &drv_tail_pre.unwrap_or(w.tail_pre), lpost, &tpost);
+    let (h2m, c2) = hash2_trace(&h2, 16);
+    calls.extend(c2);
+    let sp = sponge_trace(&calls, 64, None);
+    vec![Tr { m: dm, pvs: dpv }, Tr::new(m), Tr::new(sp), Tr::new(h2m), Tr::new(chip.generate_trace())]
+}
+
+fn v6() -> Value {
+    let eng = engine();
+    let k = harness::key(&eng, mem_set(0)).unwrap();
+    let neg = |name: &str, weak: u64, t: &[Tr]| {
+        let kw = harness::key(&eng, mem_set(weak)).unwrap();
+        harness::negative(&eng, &k, &kw, name, t)
+    };
+    let mut cases = vec![];
+    let w = kits::window(10, 3);
+    cases.push(harness::positive(&eng, &k, "mem_window_three_appends", &mem_traces(&w, &Mut::default(), None)));
+    cases.push(harness::positive(&eng, &k, "mem_window_no_append", &mem_traces(&kits::window(10, 0), &Mut::default(), None)));
+    // address_reuse_window_row: row 1 serves address len_pre again.
+    let a: Vec<u128> = vec![10, 10, 11, 12, 13, 14, 15, 16];
+    cases.push(neg("address_reuse_window_row", mem::weak::MEM_DENSE, &mem_traces(&w, &Mut { addrs: Some(a), len_post: None }, None)));
+    // close_advances_len: no append, len_post = len_pre + 1.
+    cases.push(neg("close_advances_len", mem::weak::MEM_LEN_POST, &mem_traces(&kits::window(10, 0), &Mut { addrs: None, len_post: Some(11) }, None)));
+    // counter_wrap_2_64: an append at 2^64 - 1 and the next address 0 (a u64 counter wraps).
+    let base = (1u128 << 64) - 1;
+    let wa = kits::window(base, 1);
+    let addrs: Vec<u128> = (0..8).map(|i| if i == 0 { base } else { (i - 1) as u128 }).collect();
+    cases.push(neg("counter_wrap_2_64", mem::weak::MEM_NO_WRAP, &mem_traces(&wa, &Mut { addrs: Some(addrs), len_post: None }, None)));
+    // forged_tail_across_leaf_boundary: the previous leaf's post tail is T, the window starts
+    // its chain from T' != T.
+    let mut wf = w.clone();
+    wf.tail_pre = p2(TAG_NODE, &[F::ONE]);
+    cases.push(neg("forged_tail_across_leaf_boundary", mem::weak::MEM_TOKEN_TAIL, &mem_traces(&wf, &Mut::default(), Some(w.tail_pre))));
+    json!({"task": "V.6", "shape": k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.7 BOUNDARY
+fn v7() -> Value {
+    let s = slice();
+    let mut cases = vec![];
+    let t0 = leaf::traces(&s.p, &s.sh[0], &Build::default());
+    let t1 = leaf::traces(&s.p, &s.sh[1], &Build::default());
+    let stitch = t0[0].pvs[pv::POST_D..pv::POST_D + 8] == t1[0].pvs[pv::PRE_D..pv::PRE_D + 8];
+    let a = harness::positive(&s.eng, &s.k, "shard0", &t0);
+    let b = harness::positive(&s.eng, &s.k, "shard1", &t1);
+    cases.push(json!({"case": "ok_boundary_poseidon_two_leaf_stitch", "kind": "positive", "pass": stitch && a["pass"] == true && b["pass"] == true, "post_d_0_eq_pre_d_1": stitch, "proofs": [a, b]}));
+    // boundary_word_omitted: remaining_work limb 0 forged in shard 1 while the body hash leaves it out.
+    let lay = Layout::new();
+    let w = core::w_omit(&lay);
+    let mut sh = s.sh[1].clone();
+    for st in sh.states.iter_mut() {
+        st.body[w] = F::from_u32(60000);
+    }
+    let b = Build { core: Opts { omit_word: Some(w), ..Default::default() }, ..Default::default() };
+    cases.push(s.neg("boundary_word_omitted", core::weak::BND_WORD, &sh, &b));
+    // header_body_d_unlinked: the pre header hashes a body digest that is not the body's.
+    let b = Build { core: Opts { pre_body_d: Some(p2(DOM_STATE_BODY, &[F::ONE])), ..Default::default() }, ..Default::default() };
+    cases.push(s.neg("header_body_d_unlinked", core::weak::BND_BODY_LINK, &s.sh[1], &b));
+    json!({"task": "V.7", "shape": s.k.shape, "cases": cases})
+}
+
+// ---------------------------------------------------------------- V.8 INIT
+fn v8() -> Value {
+    let s = slice();
+    let lay = Layout::new();
+    let mut cases = vec![];
+    // the reference genesis state is the Init relation of the admission
+    let init = core::init_state(&lay, &s.p.adm);
+    let init_eq = init == s.p.states[0];
+    let pos = s.pos("init_expr_entry_no_input", &s.sh[0], &Build::default());
+    cases.push(json!({"case": "init_expr_entry_no_input", "kind": "positive", "pass": init_eq && pos["pass"] == true, "reference_genesis_is_init": init_eq, "proof": pos, "rom_line": "expressions[0] opened under prog_root (69 levels) in this proof"}));
+    // init_non_genesis_leaf_any_state: h_pre != 0 with a pre state no Init produces.
+    let mut ng = s.sh[1].clone();
+    let fc = lay.at("fold.c");
+    for st in ng.states.iter_mut() {
+        st.body[fc] = F::from_u32(7);
+    }
+    cases.push(s.pos("init_non_genesis_leaf_any_state", &ng, &Build::default()));
+    // init_wrong_control: genesis control lane 2 = 1 (Init has 0); rule D rewrites the control.
+    let mut wc = s.sh[0].clone();
+    let c2 = lay.at("ctl.2");
+    for st in wc.states.iter_mut().take(4) {
+        st.body[c2] = F::ONE;
+    }
+    cases.push(s.neg("init_wrong_control", core::weak::INIT_CONTROL, &wc, &Build::default()));
+    // init_memory_not_genesis: genesis len = 3 (the window starts at 3).
+    let mut wm = s.sh[0].clone();
+    let ml = lay.at("mem.len");
+    for st in wm.states.iter_mut() {
+        st.body[ml] = F::from_u32(3);
+    }
+    cases.push(s.neg("init_memory_not_genesis", core::weak::INIT_MEMORY, &wm, &Build::default()));
+    json!({"task": "V.8", "shape": s.k.shape, "cases": cases})
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_else(|| "smoke".into());
+    let v = match mode.as_str() {
+        "smoke" => smoke(),
+        "v2" => v2(),
+        "v3" => v3(),
+        "v4" => v4(),
+        "v5" => v5(),
+        "v6" => v6(),
+        "v7" => v7(),
+        "v8" => v8(),
+        m => panic!("mode {m}"),
+    };
+    let cases = v["cases"].as_array().unwrap();
+    let pass = cases.iter().all(|x| x["pass"] == true);
+    for c in cases {
+        println!("{:<48} {}", c["case"].as_str().unwrap(), if c["pass"] == true { "PASS" } else { "FAIL" });
+    }
+    out(&mode, &v);
+    println!("{mode}: {}", if pass { "PASS" } else { "FAIL" });
+    std::process::exit(if pass { 0 } else { 1 });
+}
+
diff --git a/crates/sherlock-leaf/src/bus.rs b/crates/sherlock-leaf/src/bus.rs
new file mode 100644
index 0000000..0faca68
--- /dev/null
+++ b/crates/sherlock-leaf/src/bus.rs
@@ -0,0 +1,113 @@
+//! BUS (V.2): the FP-1 bus registry for the buses the slice uses, the ports manifest and the
+//! message encoders.
+//!
+//! A chip id `c` is the LogUp bus `BUS_BASE + c`; a port `j` of the manifest is the permutation
+//! bus `BUS_BASE + 16 + j` (FP-1). Every message is a list of typed lanes, one word per lane part
+//! (16-bit limbs), so no lane packs two parts (BUS-005).
+
+use openvm_circuit_primitives::var_range::VariableRangeCheckerBus;
+use openvm_stark_backend::interaction::{BusIndex, LookupBus, PermutationCheckBus};
+
+/// PICK: `BUS_BASE` above every bus index of a stock OpenVM chip of the chip set (the recursion
+/// buses live in the node layers, not in the app shard; the app shard uses no stock chip bus).
+pub const BUS_BASE: BusIndex = 64;
+
+/// FP-1 chip ids.
+pub const ALU: BusIndex = 1;
+pub const MEM: BusIndex = 2;
+pub const HASH: BusIndex = 3;
+pub const ROM: BusIndex = 4;
+pub const RANGE: BusIndex = 5;
+pub const DEC: BusIndex = 6;
+
+/// The buses the slice uses: (chip id, name, message words at TOP = 63).
+pub const REGISTRY: &[(BusIndex, &str, usize)] =
+    &[(MEM, "MEM", 34), (HASH, "HASH", 25), (ROM, "ROM", 38), (RANGE, "RANGE", 2), (DEC, "DEC", 7)];
+
+/// The ports manifest of the slice (FP-1 "Ports"): position `j`, name, producer, consumer,
+/// message words (seq included).
+pub const PORTS: &[(BusIndex, &str, &str, &str, usize)] = &[
+    (0, "sponge_in", "requester (CORE, INIT, ROM, HASH2, MEM)", "SPONGE", 11),
+    (1, "sponge_out", "SPONGE", "requester", 9),
+    (2, "rom_root", "ROM", "CORE", 9),
+    (3, "mem_token", "MEM", "CORE", 23),
+];
+
+pub const PORT_SPONGE_IN: BusIndex = 0;
+pub const PORT_SPONGE_OUT: BusIndex = 1;
+pub const PORT_ROM_ROOT: BusIndex = 2;
+pub const PORT_MEM_TOKEN: BusIndex = 3;
+
+pub const fn chip(id: BusIndex) -> BusIndex {
+    BUS_BASE + id
+}
+pub const fn port(j: BusIndex) -> BusIndex {
+    BUS_BASE + 16 + j
+}
+
+pub fn lookup(id: BusIndex) -> LookupBus {
+    assert!(REGISTRY.iter().any(|r| r.0 == id), "BUS-001: chip id {id} is not in the slice registry");
+    LookupBus::new(chip(id))
+}
+pub fn perm(j: BusIndex) -> PermutationCheckBus {
+    assert!((j as usize) < PORTS.len(), "port {j} is not in the manifest");
+    PermutationCheckBus::new(port(j))
+}
+/// RANGE: the stock `VariableRangeCheckerAir` at `range_max_bits` 16 (LD-S10x-3).
+pub fn range() -> VariableRangeCheckerBus {
+    VariableRangeCheckerBus::new(chip(RANGE), 16)
+}
+
+/// Sequence-number bases of the sponge port, disjoint per requester (PICK). A sponge call is
+/// identified by its `seq`; every requester's `seq` set is fixed by its AIR.
+pub mod seq {
+    pub const BODY_PRE: u32 = 1;
+    pub const BODY_POST: u32 = 2;
+    pub const HDR_PRE: u32 = 3;
+    pub const HDR_POST: u32 = 4;
+    pub const RULES: u32 = 5;
+    pub const IMAGE: u32 = 6;
+    pub const PROG: u32 = 7;
+    pub const INPUT: u32 = 8;
+    /// ROM leaf of ROM row `i`: `ROM_LEAF + i`.
+    pub const ROM_LEAF: u32 = 1 << 10;
+    /// MEM record digest of window row `i`: `MEM_REC + i`.
+    pub const MEM_REC: u32 = 1 << 11;
+    /// HASH2 provider row `i`: `HASH2 + i`.
+    pub const HASH2: u32 = 1 << 16;
+    /// Mem token seq numbers (port `mem_token`).
+    pub const TOKEN_PRE: u32 = 1;
+    pub const TOKEN_POST: u32 = 2;
+}
+
+/// The bus registry check of keygen (BUS-001, BUS-007): one message layout per index, no reserved
+/// index, every message at most 128 words.
+pub fn check_registry() -> Result<(), String> {
+    let mut seen = std::collections::BTreeSet::new();
+    for &(id, name, words) in REGISTRY {
+        if !(1..=6).contains(&id) {
+            return Err(format!("{name}: id {id} is reserved"));
+        }
+        if !seen.insert(chip(id)) {
+            return Err(format!("{name}: index {} carries two layouts", chip(id)));
+        }
+        if 1 + words > 128 {
+            return Err(format!("{name}: {words} words"));
+        }
+    }
+    for &(j, name, _, _, words) in PORTS {
+        if !seen.insert(port(j)) {
+            return Err(format!("port {name}: index {} reused", port(j)));
+        }
+        if 1 + words > 128 {
+            return Err(format!("port {name}: {words} words"));
+        }
+    }
+    Ok(())
+}
+
+/// MEM (chip id 2): a LogUp bus with permutation counts, one provider instance per CORE append
+/// (MEM-001: a window row carries the record that CORE appended, no unrequested record).
+pub fn mem_bus() -> PermutationCheckBus {
+    PermutationCheckBus::new(chip(MEM))
+}
diff --git a/crates/sherlock-leaf/src/core.rs b/crates/sherlock-leaf/src/core.rs
new file mode 100644
index 0000000..eecd9aa
--- /dev/null
+++ b/crates/sherlock-leaf/src/core.rs
@@ -0,0 +1,849 @@
+//! CORE (V.5) with its slice kits in one AIR: the S slots with the enable prefix, the subset rules
+//! of V.1 and their DEC queries, `rules_d` (CORE-006), BOUNDARY COMMITMENT (V.7, BND-001 and
+//! BND-002) and INIT (V.8, INIT-001, INIT-002, INIT-004, INIT-007).
+//!
+//! Row `j` (`0 <= j <= S`) holds state `j`: the 476 body words and the 33 header words. Slot `j <
+//! S` is the transition from row `j` to row `j + 1`. Rows `S + 1 ..` are padding. Each kit is a
+//! named constraint group; a weakened control (SG-3) removes one group by its bit in `weak`.
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, AirBuilder, AirBuilderWithPublicValues, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing, PrimeField32},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bus::{self, seq},
+    dec::{self, RULES, R_ABSENT, R_EMPTY, R_ENTRY, R_FAILURE, R_PUBLISH},
+    enc::*,
+    sponge::Call,
+};
+
+/// Slots per shard (PICK for the slice: 4; AD-6 working value S = 16).
+pub const S: usize = 4;
+pub const HEIGHT: usize = 8;
+/// State words per row: body + header (`outcome_tag`, `outcome_payload`, `input_d`, `deps_d`,
+/// `view_root`).
+pub const HW: usize = 1 + 4 * D;
+pub const SW: usize = BODY_WORDS + HW;
+pub const OT: usize = BODY_WORDS;
+pub const OP: usize = OT + 1;
+pub const IN: usize = OP + D;
+pub const DEPS: usize = IN + D;
+pub const VIEW: usize = DEPS + D;
+/// Expression ROM row words read by the subset (kind + 6 `u64` lanes).
+pub const ROMW: usize = 25;
+
+/// Leaf public values (FP-1): binding 0, prog_d 8, pre_d 16, post_d 24, rules_d 32, h_pre 40,
+/// steps 44, log_d 45, log_n 53.
+pub mod pv {
+    pub const BINDING: usize = 0;
+    pub const PROG_D: usize = 8;
+    pub const PRE_D: usize = 16;
+    pub const POST_D: usize = 24;
+    pub const RULES_D: usize = 32;
+    pub const H_PRE: usize = 40;
+    pub const STEPS: usize = 44;
+    pub const LOG_D: usize = 45;
+    pub const LOG_N: usize = 53;
+    pub const N: usize = 54;
+}
+
+pub mod weak {
+    pub const CORE_ENABLE_PREFIX: u64 = 1 << 20;
+    pub const CORE_RULES_PV: u64 = 1 << 21;
+    /// The dispatch: one selector per enabled slot, the DEC key of the selector, the priority
+    /// guard of the helper entry (no pending result).
+    pub const DEC_DISPATCH: u64 = 1 << 22;
+    /// BOUNDARY: body word `W_OMIT` is hashed.
+    pub const BND_WORD: u64 = 1 << 23;
+    /// BOUNDARY: the header takes the body digest of the body.
+    pub const BND_BODY_LINK: u64 = 1 << 24;
+    pub const INIT_CONTROL: u64 = 1 << 25;
+    pub const INIT_MEMORY: u64 = 1 << 26;
+    /// The counter words of every state row are RANGE-checked (16-bit limbs).
+    pub const CORE_RANGE_CTR: u64 = 1 << 27;
+}
+
+// ---------------------------------------------------------------- columns
+pub const C_B: usize = 0;
+pub const C_ST: usize = C_B + HEIGHT;
+pub const C_EN: usize = C_ST + SW;
+pub const C_SEL: usize = C_EN + 1;
+pub const C_KEY: usize = C_SEL + 5;
+pub const C_FL: usize = C_KEY + 1;
+pub const C_ROM: usize = C_FL + dec::NF;
+pub const C_BRW: usize = C_ROM + ROMW;
+pub const C_CC: usize = C_BRW + 8;
+pub const C_HC: usize = C_CC + 8;
+pub const C_RC: usize = C_HC + 8;
+pub const C_CNT: usize = C_RC + 8;
+pub const C_RIDS: usize = C_CNT + 1;
+pub const C_RULES_D: usize = C_RIDS + S;
+pub const C_BODY_D: usize = C_RULES_D + D;
+pub const C_STATE_D: usize = C_BODY_D + D;
+/// The body digest the header hashes (equal to `C_BODY_D` unless the link is weakened).
+pub const C_HBD: usize = C_STATE_D + D;
+pub const C_G: usize = C_HBD + D;
+pub const C_HINV: usize = C_G + 1;
+pub const C_GI: usize = C_HINV + 1;
+pub const C_NROM: usize = C_GI + 1;
+// INIT witness
+pub const C_LV: usize = C_NROM + 1;
+pub const C_PID: usize = C_LV + 1;
+pub const C_MV: usize = C_PID + 1;
+pub const C_EA: usize = C_MV + 1;
+pub const C_PLAN: usize = C_EA + 4;
+pub const C_KR: usize = C_PLAN + D;
+pub const C_IMG: usize = C_KR + D;
+pub const C_SALT: usize = C_IMG + D;
+pub const C_FUEL: usize = C_SALT + D;
+pub const C_SL: usize = C_FUEL + 8;
+pub const WIDTH: usize = C_SL + 4;
+
+/// Body word that the weakened BOUNDARY control leaves out (`remaining_work` limb 0).
+pub fn w_omit(l: &Layout) -> usize {
+    l.at("reg.27")
+}
+
+/// Word offsets the rules use.
+#[derive(Clone, Debug)]
+pub struct Off {
+    pub ctl: usize,
+    pub ctl1: usize,
+    pub hlp: std::ops::Range<usize>,
+    pub hlp_lane: Vec<usize>,
+    pub res: std::ops::Range<usize>,
+    pub reg: fn(&Layout, usize) -> usize,
+    pub rem: usize,
+    pub con: usize,
+    pub hw: usize,
+    pub rcur: usize,
+    pub env_p: usize,
+    pub env_c: usize,
+    pub ctl_span: std::ops::Range<usize>,
+}
+
+fn reg(l: &Layout, lane: usize) -> usize {
+    l.at(&format!("reg.{lane}"))
+}
+
+impl Off {
+    pub fn new(l: &Layout) -> Self {
+        Off {
+            ctl: l.at("ctl.0"),
+            ctl1: l.at("ctl.1"),
+            hlp: l.span("hlp."),
+            hlp_lane: (0..23).map(|i| l.at(&format!("hlp.{i}"))).collect(),
+            res: l.span("res."),
+            reg,
+            rem: reg(l, 27),
+            con: reg(l, 28),
+            hw: reg(l, 29),
+            rcur: reg(l, 31),
+            env_p: reg(l, 20),
+            env_c: reg(l, 21),
+            ctl_span: l.span("ctl."),
+        }
+    }
+    pub fn counters(&self) -> Vec<usize> {
+        [self.rem, self.con, self.hw, self.rcur].iter().flat_map(|&a| a..a + 8).collect()
+    }
+}
+
+/// The genesis state `Init(prog_d, input_d)` (INIT-001) as body and header words, linear in the
+/// admission witness. `w` gives the INIT witness columns as expressions.
+pub fn init_state(l: &Layout, a: &Admission) -> State {
+    let mut b = vec![F::ZERO; BODY_WORDS];
+    let put = |b: &mut Vec<F>, at: usize, xs: &[F]| b[at..at + xs.len()].copy_from_slice(xs);
+    put(&mut b, l.at("ctl.1"), &limbs_u128(a.entry_a as u128, 4));
+    put(&mut b, l.at("reg.19"), &limbs_u128(a.entry_a as u128, 4));
+    put(&mut b, l.at("reg.22"), &limbs_u128(a.stack_limit as u128, 4));
+    put(&mut b, l.at("reg.26"), &limbs_u128(a.fuel, 8));
+    put(&mut b, l.at("reg.27"), &limbs_u128(a.fuel, 8));
+    put(&mut b, l.at("frm.below"), &empty_frames());
+    put(&mut b, l.at("tsk.below"), &empty_tasks());
+    put(&mut b, l.at("mem.root"), &mem_root0());
+    put(&mut b, l.at("mem.tail"), &mem_tail0());
+    put(&mut b, l.at("prog_root"), &a.prog_root);
+    put(&mut b, l.at("prog_d"), &a.prog_d());
+    State {
+        hdr: Header {
+            outcome_tag: F::ZERO,
+            outcome_payload: [F::ZERO; D],
+            input_d: a.input_d(),
+            deps_d: empty_deps(),
+            view_root: view_none(),
+        },
+        body: b,
+    }
+}
+
+pub struct CoreAir {
+    pub weak: u64,
+    pub l: Layout,
+    pub o: Off,
+}
+
+impl CoreAir {
+    pub fn new(weak: u64) -> Self {
+        let l = Layout::new();
+        let o = Off::new(&l);
+        Self { weak, l, o }
+    }
+    fn on(&self, w: u64) -> bool {
+        self.weak & w == 0
+    }
+}
+
+impl<T> BaseAir<T> for CoreAir {
+    fn width(&self) -> usize {
+        WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for CoreAir {
+    fn num_public_values(&self) -> usize {
+        pv::N
+    }
+}
+impl<T> PartitionedBaseAir<T> for CoreAir {}
+
+fn ce<AB: AirBuilder>(x: u32) -> AB::Expr {
+    AB::Expr::from_u32(x)
+}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder + AirBuilderWithPublicValues> Air<AB> for CoreAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let pvs: Vec<AB::Expr> = builder.public_values().iter().map(|&x| x.into()).collect();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        let nx = |i: usize| -> AB::Expr { n[i].into() };
+        let st = |w: usize| c(C_ST + w);
+        let nst = |w: usize| nx(C_ST + w);
+        let one = AB::Expr::ONE;
+        let zero = AB::Expr::ZERO;
+        let o = &self.o;
+        let lay = &self.l;
+        let range = bus::range();
+
+        // ---- rows: one-hot row index
+        let mut sum = zero.clone();
+        for j in 0..HEIGHT {
+            builder.assert_bool(c(C_B + j));
+            sum += c(C_B + j);
+        }
+        builder.assert_one(sum);
+        builder.when_first_row().assert_one(c(C_B));
+        for j in 0..HEIGHT - 1 {
+            builder.when_transition().assert_eq(nx(C_B + j + 1), c(C_B + j));
+        }
+        let b0 = c(C_B);
+        let bs = c(C_B + S);
+        let slot = (0..S).fold(zero.clone(), |a, j| a + c(C_B + j));
+        let state_row = slot.clone() + bs.clone();
+
+        // ---- enable prefix and steps (CORE-001, CORE-002)
+        let en = c(C_EN);
+        builder.assert_bool(en.clone());
+        builder.assert_zero(en.clone() * (one.clone() - slot.clone()));
+        if self.on(weak::CORE_ENABLE_PREFIX) {
+            builder.when_transition().assert_zero(nx(C_EN) * (one.clone() - en.clone()));
+            builder.when_first_row().assert_one(en.clone());
+        }
+        builder.when_first_row().assert_eq(c(C_CNT), en.clone());
+        builder.when_transition().assert_eq(nx(C_CNT), c(C_CNT) + nx(C_EN));
+        builder.assert_zero(bs.clone() * (c(C_CNT) - pvs[pv::STEPS].clone()));
+
+        // ---- dispatch and DEC (DEC-001, DEC-004 over the subset)
+        let sel = |r: usize| c(C_SEL + r);
+        let mut ssum = zero.clone();
+        let mut key = zero.clone();
+        for r in 0..5 {
+            builder.assert_bool(sel(r));
+            ssum += sel(r);
+            key += sel(r) * ce::<AB>(RULES[r].1);
+        }
+        if self.on(weak::DEC_DISPATCH) {
+            builder.assert_eq(ssum, en.clone());
+            builder.assert_eq(c(C_KEY), key);
+        }
+        let mut dm = vec![c(C_KEY), c(C_KEY), c(C_KEY), c(C_KEY)];
+        dm.extend((0..dec::NF).map(|k| c(C_FL + k)));
+        bus::lookup(bus::DEC).lookup_key(builder, dm, slot.clone());
+        for k in 0..dec::NF {
+            builder.assert_bool(c(C_FL + k));
+        }
+
+        // ---- rules_d (CORE-006)
+        for j in 0..S {
+            builder.when_transition().assert_eq(nx(C_RIDS + j), c(C_RIDS + j));
+            builder.assert_zero(c(C_B + j) * (c(C_RIDS + j) - c(C_KEY)));
+        }
+        let mut rw = vec![ce::<AB>(seq::RULES), zero.clone(), ce::<AB>(1 + S as u32), ce::<AB>(SHK_RULES)];
+        rw.extend((0..S).map(|j| c(C_RIDS + j)));
+        while rw.len() < 11 {
+            rw.push(zero.clone());
+        }
+        bus::perm(bus::PORT_SPONGE_IN).send(builder, rw, b0.clone());
+        let mut ro = vec![ce::<AB>(seq::RULES)];
+        ro.extend((0..D).map(|i| c(C_RULES_D + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, ro, b0.clone());
+        if self.on(weak::CORE_RULES_PV) {
+            for i in 0..D {
+                builder.assert_zero(b0.clone() * (c(C_RULES_D + i) - pvs[pv::RULES_D + i].clone()));
+            }
+        }
+
+        // ---- write sets and the frame rule: every state word not written by the selected rule
+        // keeps its value across a slot; counters are written by the charge gadgets.
+        let ctr = o.counters();
+        let hlp: Vec<usize> = o.hlp.clone().collect();
+        let res: Vec<usize> = o.res.clone().collect();
+        let ctl: Vec<usize> = o.ctl_span.clone().collect();
+        let h11 = o.hlp_lane[11];
+        let writes = |w: usize| -> Vec<usize> {
+            let mut v = vec![];
+            if hlp.contains(&w) {
+                v.extend([R_ENTRY, R_FAILURE]);
+                if w == h11 {
+                    v.push(R_EMPTY);
+                }
+            }
+            if res.contains(&w) {
+                v.extend([R_FAILURE, R_ABSENT]);
+            }
+            if ctl.contains(&w) {
+                v.push(R_ABSENT);
+            }
+            if w == OT || (OP..OP + D).contains(&w) {
+                v.push(R_PUBLISH);
+            }
+            v
+        };
+        for w in 0..SW {
+            if ctr.contains(&w) {
+                continue;
+            }
+            let keep = writes(w).iter().fold(slot.clone(), |a, &r| a - sel(r));
+            builder.when_transition().assert_zero((nst(w) - st(w)) * keep);
+        }
+
+        // ---- the subset rules (guards and effects), gated by their selector
+        let rom = |k: usize| c(C_ROM + k);
+        let hl = |i: usize| o.hlp_lane[i];
+        let g = |b: &mut AB, r: usize, x: AB::Expr| b.when_transition().assert_zero(sel(r) * x);
+        // BHelperEnvGetEntry: control Eval{e}, ROM expressions[e] is Var{binder}, no helper; the
+        // priority of a pending result over a helper entry is part of the dispatch.
+        g(builder, R_ENTRY, st(o.ctl));
+        g(builder, R_ENTRY, st(hl(0)));
+        g(builder, R_ENTRY, rom(0) - one.clone());
+        if self.on(weak::DEC_DISPATCH) {
+            g(builder, R_ENTRY, st(res[0]));
+        }
+        let mut entry: Vec<(usize, AB::Expr)> = vec![];
+        for &w in &hlp {
+            entry.push((w, zero.clone()));
+        }
+        let set = |v: &mut Vec<(usize, AB::Expr)>, w: usize, e: AB::Expr| {
+            v.iter_mut().find(|x| x.0 == w).unwrap().1 = e;
+        };
+        set(&mut entry, hl(0), ce::<AB>(2));
+        set(&mut entry, hl(1), ce::<AB>(1));
+        for i in 0..8 {
+            set(&mut entry, hl(2) + i, st(o.rcur + i));
+        }
+        for i in 0..4 {
+            set(&mut entry, hl(5) + i, rom(1 + i));
+        }
+        set(&mut entry, hl(6), st(o.env_p));
+        for i in 0..5 {
+            set(&mut entry, hl(7) + i, st(o.env_c + i));
+        }
+        for (w, e) in entry {
+            g(builder, R_ENTRY, nst(w) - e);
+        }
+        // BHelperEnvGetEmpty: EnvGet, Pending, no cursor -> Negative.
+        g(builder, R_EMPTY, st(hl(0)) - ce::<AB>(2));
+        g(builder, R_EMPTY, st(h11));
+        g(builder, R_EMPTY, st(hl(6)));
+        g(builder, R_EMPTY, nst(h11) - ce::<AB>(2));
+        // BHelperEnvGetFailure: EnvGet, Negative -> helper None, result EnvMissing.
+        g(builder, R_FAILURE, st(hl(0)) - ce::<AB>(2));
+        g(builder, R_FAILURE, st(h11) - ce::<AB>(2));
+        for &w in &hlp {
+            g(builder, R_FAILURE, nst(w));
+        }
+        for &w in &res {
+            g(builder, R_FAILURE, nst(w) - if w == res[0] { ce::<AB>(3) } else { zero.clone() });
+        }
+        // KMachineEvalVariableAbsent: Eval{e} of a Var row with result EnvMissing -> Error{3}.
+        g(builder, R_ABSENT, st(res[0]) - ce::<AB>(3));
+        g(builder, R_ABSENT, st(o.ctl));
+        g(builder, R_ABSENT, rom(0) - one.clone());
+        for &w in &res {
+            g(builder, R_ABSENT, nst(w));
+        }
+        for &w in &ctl {
+            let v = if w == o.ctl {
+                ce::<AB>(9)
+            } else if w == o.ctl1 {
+                ce::<AB>(3)
+            } else {
+                zero.clone()
+            };
+            g(builder, R_ABSENT, nst(w) - v);
+        }
+        // KAdminPublishError: control Error{code}, Running -> Rejected [code, 0, ..].
+        g(builder, R_PUBLISH, st(o.ctl) - ce::<AB>(9));
+        g(builder, R_PUBLISH, st(OT));
+        g(builder, R_PUBLISH, nst(OT) - ce::<AB>(2));
+        g(builder, R_PUBLISH, nst(OP) - st(o.ctl1));
+        for i in 1..D {
+            g(builder, R_PUBLISH, nst(OP + i));
+        }
+        // ROM read of expressions[e] (FP-1 ROM bus: tbl, row, 33 row words).
+        let mut rm = vec![zero.clone()];
+        rm.extend((0..4).map(|i| st(o.ctl1 + i)));
+        rm.extend((0..ROMW).map(rom));
+        rm.extend((ROMW..W_ROM).map(|_| zero.clone()));
+        bus::lookup(bus::ROM).lookup_key(builder, rm, sel(R_ENTRY) + sel(R_ABSENT));
+
+        // ---- charges: remaining work -fuel, consumed +fuel, helper work +hw, cursor +rc
+        let p16 = ce::<AB>(1 << 16);
+        let fl = |k: usize| c(C_FL + k);
+        for (base, cols, inc, f) in [
+            (o.rem, C_BRW, false, fl(0)),
+            (o.con, C_CC, true, fl(0)),
+            (o.hw, C_HC, true, fl(1)),
+            (o.rcur, C_RC, true, fl(2)),
+        ] {
+            for i in 0..8 {
+                builder.assert_bool(c(cols + i));
+                let cin = if i == 0 { f.clone() } else { c(cols + i - 1) };
+                let e = if inc {
+                    st(base + i) + cin - c(cols + i) * p16.clone()
+                } else {
+                    st(base + i) - cin + c(cols + i) * p16.clone()
+                };
+                builder.when_transition().assert_zero(slot.clone() * (nst(base + i) - e));
+                if self.on(weak::CORE_RANGE_CTR) {
+                    range.range_check(st(base + i), 16).eval(builder, state_row.clone());
+                }
+            }
+            builder.assert_zero(c(cols + 7));
+        }
+
+        // ---- BOUNDARY: body_d and the header digest of the pre and post state (BND-001, BND-002)
+        let ends = b0.clone() + bs.clone();
+        let sq = |a: u32, b: u32| b0.clone() * ce::<AB>(a) + bs.clone() * ce::<AB>(b);
+        let omit = if self.on(weak::BND_WORD) { None } else { Some(w_omit(lay)) };
+        let mut words = vec![ce::<AB>(DOM_STATE_BODY), ce::<AB>(SCHEMA_ID)];
+        words.extend((0..BODY_WORDS).map(|w| if Some(w) == omit { zero.clone() } else { st(w) }));
+        send_blocks::<AB>(builder, sq(seq::BODY_PRE, seq::BODY_POST), words, ends.clone());
+        let mut m = vec![sq(seq::BODY_PRE, seq::BODY_POST)];
+        m.extend((0..D).map(|i| c(C_BODY_D + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, m, ends.clone());
+        if self.on(weak::BND_BODY_LINK) {
+            for i in 0..D {
+                builder.assert_zero(ends.clone() * (c(C_HBD + i) - c(C_BODY_D + i)));
+            }
+        }
+        let mut hw = vec![ce::<AB>(SHK_SD2)];
+        hw.extend((OT..SW).map(st));
+        hw.extend((0..D).map(|i| c(C_HBD + i)));
+        send_blocks::<AB>(builder, sq(seq::HDR_PRE, seq::HDR_POST), hw, ends.clone());
+        let mut m = vec![sq(seq::HDR_PRE, seq::HDR_POST)];
+        m.extend((0..D).map(|i| c(C_STATE_D + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, m, ends.clone());
+        let pd = lay.at("prog_d");
+        for i in 0..D {
+            builder.assert_zero(b0.clone() * (c(C_STATE_D + i) - pvs[pv::PRE_D + i].clone()));
+            builder.assert_zero(bs.clone() * (c(C_STATE_D + i) - pvs[pv::POST_D + i].clone()));
+            builder.assert_zero(b0.clone() * (st(pd + i) - pvs[pv::PROG_D + i].clone()));
+        }
+        // PICK (slice, no log and no E-1 binding): binding 0, log_d D_EMPTY, log_n 0.
+        let de = d_empty();
+        for i in 0..D {
+            builder.assert_zero(pvs[pv::BINDING + i].clone());
+            builder.assert_eq(pvs[pv::LOG_D + i].clone(), AB::Expr::from(de[i]));
+        }
+        builder.assert_zero(pvs[pv::LOG_N].clone());
+        for i in 0..4 {
+            range.range_check(pvs[pv::H_PRE + i].clone(), 16).eval(builder, b0.clone());
+        }
+        range.range_check(pvs[pv::STEPS].clone(), 16).eval(builder, b0.clone());
+
+        // ---- memory token (MEM window) and ROM root
+        let (ml, mr, mt) = (lay.at("mem.len"), lay.at("mem.root"), lay.at("mem.tail"));
+        for (s, gate) in [(seq::TOKEN_PRE, b0.clone()), (seq::TOKEN_POST, bs.clone())] {
+            let mut m = vec![ce::<AB>(s)];
+            m.extend((0..5).map(|k| st(ml + k)));
+            m.extend((0..D).map(|k| st(mr + k)));
+            m.extend((0..D).map(|k| st(mt + k)));
+            bus::perm(bus::PORT_MEM_TOKEN).receive(builder, m, gate);
+        }
+        builder.assert_zero((one.clone() - b0.clone()) * c(C_NROM));
+        let prt = lay.at("prog_root");
+        bus::perm(bus::PORT_ROM_ROOT).receive(builder, (0..D).map(|k| st(prt + k)).collect::<Vec<_>>(), c(C_NROM));
+
+        // ---- INIT: g = is_zero(h_pre) from the public value (INIT-002), gi = g on row 0
+        let hsum = (0..4).fold(zero.clone(), |a, i| a + pvs[pv::H_PRE + i].clone());
+        builder.assert_eq(c(C_G), one.clone() - hsum.clone() * c(C_HINV));
+        builder.assert_zero(c(C_G) * hsum);
+        builder.assert_eq(c(C_GI), c(C_G) * b0.clone());
+        let gi = c(C_GI);
+        // The Init relation word by word (INIT-001).
+        let init = init_exprs::<AB>(lay, l);
+        for (w, e) in init.iter().enumerate() {
+            if (ml..ml + 5).contains(&w) && !self.on(weak::INIT_MEMORY) {
+                continue;
+            }
+            if ctl.contains(&w) && !self.on(weak::INIT_CONTROL) {
+                continue;
+            }
+            builder.assert_zero(gi.clone() * (st(w) - e.clone()));
+        }
+        // Openings of prog_d and input_d (INIT-007, FP-4).
+        let mut img = vec![ce::<AB>(SHK_IMAGE)];
+        img.extend((0..D).map(|k| st(prt + k)));
+        img.extend([c(C_LV), c(C_PID), zero.clone()]);
+        img.extend((0..4).map(|k| c(C_EA + k)));
+        img.extend((0..D).map(|_| zero.clone()));
+        send_blocks::<AB>(builder, ce::<AB>(seq::IMAGE), img, gi.clone());
+        let mut m = vec![ce::<AB>(seq::IMAGE)];
+        m.extend((0..D).map(|k| c(C_IMG + k)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, m, gi.clone());
+        let mut pw = vec![ce::<AB>(DOM_PROG)];
+        pw.extend((0..D).map(|k| c(C_IMG + k)));
+        pw.extend((0..D).map(|k| c(C_PLAN + k)));
+        pw.extend((0..D).map(|k| c(C_KR + k)));
+        pw.push(c(C_MV));
+        send_blocks::<AB>(builder, ce::<AB>(seq::PROG), pw, gi.clone());
+        let mut m = vec![ce::<AB>(seq::PROG)];
+        m.extend((0..D).map(|k| st(pd + k)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, m, gi.clone());
+        let vn = val_none();
+        let mut iw = vec![ce::<AB>(SHK_IN)];
+        iw.extend((0..D).map(|k| c(C_SALT + k)));
+        iw.extend((0..D).map(|k| AB::Expr::from(vn[k])));
+        iw.extend((0..12).map(|k| if k < 8 { c(C_FUEL + k) } else { c(C_SL + k - 8) }));
+        send_blocks::<AB>(builder, ce::<AB>(seq::INPUT), iw, gi.clone());
+        let mut m = vec![ce::<AB>(seq::INPUT)];
+        m.extend((0..D).map(|k| st(IN + k)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, m, gi.clone());
+        for k in 0..4 {
+            range.range_check(c(C_EA + k), 16).eval(builder, gi.clone());
+            range.range_check(c(C_SL + k), 16).eval(builder, gi.clone());
+        }
+        for k in 0..8 {
+            range.range_check(c(C_FUEL + k), 16).eval(builder, gi.clone());
+        }
+        for k in [C_LV, C_PID, C_MV] {
+            range.range_check(c(k), 16).eval(builder, gi.clone());
+        }
+    }
+}
+
+/// The Init words (body then header) as expressions of the INIT witness columns.
+fn init_exprs<AB: AirBuilder<F = F>>(lay: &Layout, l: &[AB::Var]) -> Vec<AB::Expr> {
+    let c = |i: usize| -> AB::Expr { l[i].clone().into() };
+    let mut v: Vec<AB::Expr> = (0..SW).map(|_| AB::Expr::ZERO).collect();
+    let k = |x: F| AB::Expr::from(x);
+    for i in 0..4 {
+        v[lay.at("ctl.1") + i] = c(C_EA + i);
+        v[lay.at("reg.19") + i] = c(C_EA + i);
+        v[lay.at("reg.22") + i] = c(C_SL + i);
+    }
+    for i in 0..8 {
+        v[lay.at("reg.26") + i] = c(C_FUEL + i);
+        v[lay.at("reg.27") + i] = c(C_FUEL + i);
+    }
+    for (name, d) in [
+        ("frm.below", empty_frames()),
+        ("tsk.below", empty_tasks()),
+        ("mem.root", mem_root0()),
+        ("mem.tail", mem_tail0()),
+    ] {
+        for i in 0..D {
+            v[lay.at(name) + i] = k(d[i]);
+        }
+    }
+    // prog_root, prog_d: bound by the openings; the input digest likewise.
+    for name in ["prog_root", "prog_d"] {
+        for i in 0..D {
+            v[lay.at(name) + i] = c(C_ST + lay.at(name) + i);
+        }
+    }
+    for i in 0..D {
+        v[IN + i] = c(C_ST + IN + i);
+        v[DEPS + i] = k(empty_deps()[i]);
+        v[VIEW + i] = k(view_none()[i]);
+    }
+    v
+}
+
+/// Send the rate blocks of a sponge call (`words` start with the tag) with `count`.
+pub fn send_blocks<AB: AirBuilder<F = F> + InteractionBuilder>(
+    builder: &mut AB,
+    sq: AB::Expr,
+    mut words: Vec<AB::Expr>,
+    count: AB::Expr,
+) {
+    let len = words.len();
+    while words.len() % 8 != 0 {
+        words.push(AB::Expr::ZERO);
+    }
+    for (b, blk) in words.chunks(8).enumerate() {
+        let mut m = vec![sq.clone(), AB::Expr::from_usize(b), AB::Expr::from_usize(len)];
+        m.extend(blk.iter().cloned());
+        bus::perm(bus::PORT_SPONGE_IN).send(builder, m, count.clone());
+    }
+}
+
+// ---------------------------------------------------------------- trace
+/// One shard: S + 1 states, the selected rule of each slot (`None` disabled), `h_pre`, the
+/// admission (used at genesis), the expression row the slots read, the number of ROM rows.
+#[derive(Clone, Debug)]
+pub struct ShardIn {
+    pub states: Vec<State>,
+    pub sel: Vec<Option<usize>>,
+    pub h_pre: u64,
+    pub adm: Admission,
+    pub rom: [F; ROMW],
+    pub nrom: u32,
+}
+
+/// Mutation knobs of the witness generator (SG-3).
+#[derive(Clone, Debug, Default)]
+pub struct Opts {
+    /// Extra selector bits set on slot rows: (slot, rule).
+    pub extra_sel: Vec<(usize, usize)>,
+    /// DEC key override on a slot: (slot, class).
+    pub key: Option<(usize, u32)>,
+    /// Hash the body with this word set to zero (the omitted-word witness).
+    pub omit_word: Option<usize>,
+    /// Header of the pre state uses this body digest.
+    pub pre_body_d: Option<Digest>,
+    /// Override of the `rules_d` public value.
+    pub rules_pv: Option<Digest>,
+    /// Override of the enable column on a slot row.
+    pub enable: Vec<(usize, bool)>,
+    /// Witness of the weakened RANGE control: no counter range counts.
+    pub skip_counter_range: bool,
+    /// Override of the `rules_d` digest column (with `rules_pv`, a forged sponge output).
+    pub rules_col: Option<Digest>,
+}
+
+pub struct CoreOut {
+    pub m: RowMajorMatrix<F>,
+    pub pvs: Vec<F>,
+    pub calls: Vec<Call>,
+    pub range: Vec<(u32, usize)>,
+    pub dec: [u32; dec::HEIGHT],
+}
+
+fn u(x: F) -> u32 {
+    x.as_canonical_u32()
+}
+
+pub fn trace(sh: &ShardIn, op: &Opts) -> CoreOut {
+    let lay = Layout::new();
+    let o = Off::new(&lay);
+    assert_eq!(sh.states.len(), S + 1);
+    let mut v = vec![F::ZERO; HEIGHT * WIDTH];
+    let mut range: Vec<(u32, usize)> = vec![];
+    let mut dec_counts = [0u32; dec::HEIGHT];
+    let mut calls = vec![];
+    let genesis = sh.h_pre == 0;
+    let words = |s: &State| -> Vec<F> {
+        let mut w = s.body.clone();
+        w.push(s.hdr.outcome_tag);
+        w.extend_from_slice(&s.hdr.outcome_payload);
+        w.extend_from_slice(&s.hdr.input_d);
+        w.extend_from_slice(&s.hdr.deps_d);
+        w.extend_from_slice(&s.hdr.view_root);
+        w
+    };
+    let mut rids = [F::ZERO; S];
+    let mut cnt = 0u32;
+    let steps = sh.sel.iter().filter(|s| s.is_some()).count() as u32;
+    let hsum: u64 = (0..4).map(|i| (sh.h_pre >> (16 * i)) & 0xffff).sum();
+    let hinv = if hsum == 0 { F::ZERO } else { F::from_u64(hsum).inverse() };
+    for r in 0..HEIGHT {
+        let row = &mut v[r * WIDTH..(r + 1) * WIDTH];
+        row[C_B + r] = F::ONE;
+        row[C_G] = F::from_bool(genesis);
+        row[C_HINV] = hinv;
+        if r <= S {
+            let s = &sh.states[r];
+            row[C_ST..C_ST + SW].copy_from_slice(&words(s));
+            if !op.skip_counter_range {
+                for &a in &[o.rem, o.con, o.hw, o.rcur] {
+                    for i in 0..8 {
+                        range.push((u(s.body[a + i]), 16));
+                    }
+                }
+            }
+        }
+        if r < S {
+            let mut en = sh.sel[r].is_some();
+            if let Some(&(_, e)) = op.enable.iter().find(|x| x.0 == r) {
+                en = e;
+            }
+            row[C_EN] = F::from_bool(en);
+            if let Some(rule) = sh.sel[r] {
+                row[C_SEL + rule] = F::ONE;
+            }
+            for &(j, rule) in &op.extra_sel {
+                if j == r {
+                    row[C_SEL + rule] = F::ONE;
+                }
+            }
+            let (cls, fl) = match sh.sel[r] {
+                Some(rule) => (RULES[rule].1, RULES[rule].2),
+                None => (0, [0; 3]),
+            };
+            let cls = match op.key {
+                Some((j, k)) if j == r => k,
+                _ => cls,
+            };
+            let trow = (0..dec::HEIGHT).find(|&j| dec::row(j).0 == cls).unwrap_or(0);
+            let fl = if op.key.map(|x| x.0) == Some(r) { dec::row(trow).1 } else { fl };
+            row[C_KEY] = F::from_u32(cls);
+            for k in 0..dec::NF {
+                row[C_FL + k] = F::from_u32(fl[k]);
+            }
+            dec_counts[trow] += 1;
+            rids[r] = F::from_u32(cls);
+            if en {
+                cnt += 1;
+            }
+            row[C_ROM..C_ROM + ROMW].copy_from_slice(&sh.rom);
+            // charge carries
+            let (a, b) = (&sh.states[r].body, &sh.states[r + 1].body);
+            let val = |x: &[F], at: usize| -> u128 { (0..8).map(|i| (u(x[at + i]) as u128) << (16 * i)).sum() };
+            for (base, cols, inc) in [(o.rem, C_BRW, false), (o.con, C_CC, true), (o.hw, C_HC, true), (o.rcur, C_RC, true)] {
+                let (x, y) = (val(a, base), val(b, base));
+                let d = if inc { y.wrapping_sub(x) } else { x.wrapping_sub(y) };
+                let mut carry = d;
+                for i in 0..8 {
+                    let limb = (x >> (16 * i)) & 0xffff;
+                    let c = if inc { (limb + carry) >> 16 } else if limb < carry { 1 } else { 0 };
+                    row[cols + i] = F::from_u32(c as u32);
+                    carry = c;
+                }
+            }
+        } else if r == S {
+            // count on the post row
+        }
+        row[C_CNT] = F::from_u32(if r <= S { cnt.min(steps) } else { cnt });
+        if r <= S && r < S {
+            // already counted
+        }
+        if r == 0 {
+            row[C_NROM] = F::from_u32(sh.nrom);
+        }
+    }
+    // steps column: running sum of enable from row 0
+    let mut run = 0u32;
+    for r in 0..HEIGHT {
+        run += u(v[r * WIDTH + C_EN]);
+        v[r * WIDTH + C_CNT] = F::from_u32(run);
+    }
+    for r in 0..HEIGHT {
+        v[r * WIDTH + C_RIDS..r * WIDTH + C_RIDS + S].copy_from_slice(&rids);
+    }
+    // rules_d
+    let rules_d = p2(SHK_RULES, &rids);
+    calls.push(Call { seq: seq::RULES, tag: SHK_RULES, words: rids.to_vec() });
+    v[C_RULES_D..C_RULES_D + D].copy_from_slice(&op.rules_col.unwrap_or(rules_d));
+    // boundary
+    let mut pre_d = [F::ZERO; D];
+    let mut post_d = [F::ZERO; D];
+    for (r, sb, sh_) in [(0usize, seq::BODY_PRE, seq::HDR_PRE), (S, seq::BODY_POST, seq::HDR_POST)] {
+        let s = &sh.states[r];
+        let mut body = s.body.clone();
+        if let Some(w) = op.omit_word {
+            body[w] = F::ZERO;
+        }
+        calls.push(Call { seq: sb, tag: DOM_STATE_BODY, words: body_words(&body) });
+        let bd0 = body_d(&body);
+        let mut bd = bd0;
+        if r == 0 {
+            if let Some(x) = op.pre_body_d {
+                bd = x;
+            }
+        }
+        let hw = header_words(&s.hdr, &bd);
+        let sd = p2(SHK_SD2, &hw);
+        calls.push(Call { seq: sh_, tag: SHK_SD2, words: hw });
+        let row = &mut v[r * WIDTH..(r + 1) * WIDTH];
+        row[C_BODY_D..C_BODY_D + D].copy_from_slice(&bd0);
+        row[C_HBD..C_HBD + D].copy_from_slice(&bd);
+        row[C_STATE_D..C_STATE_D + D].copy_from_slice(&sd);
+        if r == 0 {
+            pre_d = sd;
+        } else {
+            post_d = sd;
+        }
+    }
+    // INIT
+    if genesis {
+        let a = &sh.adm;
+        let row = &mut v[0..WIDTH];
+        row[C_GI] = F::ONE;
+        row[C_LV] = F::from_u32(a.layout_version);
+        row[C_PID] = F::from_u32(a.profile_id);
+        row[C_MV] = F::from_u32(a.machine_version);
+        row[C_EA..C_EA + 4].copy_from_slice(&limbs_u128(a.entry_a as u128, 4));
+        row[C_PLAN..C_PLAN + D].copy_from_slice(&a.plan_d);
+        row[C_KR..C_KR + D].copy_from_slice(&a.key_root);
+        row[C_IMG..C_IMG + D].copy_from_slice(&a.image_d());
+        for i in 0..8 {
+            row[C_SALT + i] = F::from_u32(a.salt[i]);
+        }
+        let fw = a.input_words();
+        row[C_FUEL..C_FUEL + 8].copy_from_slice(&fw[16..24]);
+        row[C_SL..C_SL + 4].copy_from_slice(&fw[24..28]);
+        calls.push(Call { seq: seq::IMAGE, tag: SHK_IMAGE, words: a.image_words() });
+        calls.push(Call { seq: seq::PROG, tag: DOM_PROG, words: a.prog_words() });
+        calls.push(Call { seq: seq::INPUT, tag: SHK_IN, words: a.input_words() });
+        for x in fw[16..28].iter().chain(limbs_u128(a.entry_a as u128, 4).iter()) {
+            range.push((u(*x), 16));
+        }
+        for x in [a.layout_version, a.profile_id, a.machine_version] {
+            range.push((x, 16));
+        }
+    } else {
+        for _ in 0..19 {
+            range.push((0, 0));
+        }
+    }
+    // the gated-off INIT range lookups have count 0: nothing to add; h_pre and steps lookups
+    for i in 0..4 {
+        range.push((((sh.h_pre >> (16 * i)) & 0xffff) as u32, 16));
+    }
+    range.push((steps, 16));
+    let range = range.into_iter().filter(|x| x.1 != 0).collect();
+    let mut pvs = vec![F::ZERO; pv::N];
+    pvs[pv::PROG_D..pv::PROG_D + D].copy_from_slice(&sh.states[0].body[lay.at("prog_d")..lay.at("prog_d") + D]);
+    pvs[pv::PRE_D..pv::PRE_D + D].copy_from_slice(&pre_d);
+    pvs[pv::POST_D..pv::POST_D + D].copy_from_slice(&post_d);
+    pvs[pv::RULES_D..pv::RULES_D + D].copy_from_slice(&op.rules_pv.unwrap_or(rules_d));
+    pvs[pv::H_PRE..pv::H_PRE + 4].copy_from_slice(&limbs_u128(sh.h_pre as u128, 4));
+    pvs[pv::STEPS] = F::from_u32(steps);
+    pvs[pv::LOG_D..pv::LOG_D + D].copy_from_slice(&d_empty());
+    CoreOut { m: RowMajorMatrix::new(v, WIDTH), pvs, calls, range, dec: dec_counts }
+}
+
+#[allow(dead_code)]
+fn _h(m: &RowMajorMatrix<F>) -> usize {
+    m.height()
+}
