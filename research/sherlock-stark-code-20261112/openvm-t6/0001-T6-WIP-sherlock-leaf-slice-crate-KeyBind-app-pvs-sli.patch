+//! Sherlock T6: the modular-leaf vertical slice (`openspec/changes/sherlock-modular-leaf-20261111`
+//! group V in Moriarty) as STARK AIRs over BabyBear.
+
+#![allow(clippy::needless_range_loop)] // index loops mirror the column layouts
+
+pub mod bus;
+pub mod enc;
+pub mod harness;
+pub mod sponge;
+pub mod core;
+pub mod dec;
+pub mod mem;
+pub mod rom;
+pub mod leaf;
+pub mod kits;
diff --git a/crates/sherlock-leaf/src/mem.rs b/crates/sherlock-leaf/src/mem.rs
new file mode 100644
index 0000000..02a2465
--- /dev/null
+++ b/crates/sherlock-leaf/src/mem.rs
@@ -0,0 +1,329 @@
+//! MEM window (V.6; MEM-001 to MEM-003, MEM-006 at W = 1; the tail opening of MBK-002): dense
+//! append from `len_pre`, the append chain `tail`, and the memory token `[len, root, tail]`
+//! carried through with no flush (`root` unchanged).
+//!
+//! Row `i` of the window serves address `len_pre + i`; active rows are a prefix and the last row
+//! is inactive (MEM-006, `8 W + 7 - r_pre` with `W = 1` bounded here by the 8-row window). An
+//! active row provides `(kind, addr, rec)` on the MEM bus once (permutation with CORE), hashes
+//! the record `rd = P2(DOM_MEMREC, kind, addr, rec)` and advances `tail' = P2(TAG_NODE, tail,
+//! rd)` (PICK: the append chain form; MBK-002 names the tail opening, not its hash form). The
+//! first row sends the pre and post tokens to CORE on port `mem_token`.
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bus::{self, seq},
+    enc::{p2, Digest, DOM_MEMREC, D, F, TAG_NODE},
+    sponge::{Call, H2},
+};
+
+/// Record lanes `W_rec` (FP-1 MEM message: kind, addr, 28 record lanes).
+pub const W_REC: usize = 28;
+pub const HEIGHT: usize = 8;
+pub const NA: usize = 5;
+
+pub mod weak {
+    /// Row `i + 1` serves address `addr_i + 1`.
+    pub const MEM_DENSE: u64 = 1 << 12;
+    /// `len_post` is the address of the first inactive row.
+    pub const MEM_LEN_POST: u64 = 1 << 13;
+    /// The top address limb takes the carry (the address does not wrap at 2^64).
+    pub const MEM_NO_WRAP: u64 = 1 << 14;
+    /// The token carries `tail`.
+    pub const MEM_TOKEN_TAIL: u64 = 1 << 15;
+}
+
+pub const C_ACT: usize = 0;
+pub const C_F0: usize = 1;
+pub const C_RC: usize = 2;
+pub const C_KIND: usize = 3;
+pub const C_ADDR: usize = 4;
+pub const C_CARRY: usize = C_ADDR + NA;
+pub const C_REC: usize = C_CARRY + NA;
+pub const C_RD: usize = C_REC + W_REC;
+pub const C_TIN: usize = C_RD + D;
+pub const C_TOUT: usize = C_TIN + D;
+pub const C_LPRE: usize = C_TOUT + D;
+pub const C_LPOST: usize = C_LPRE + NA;
+pub const C_ROOT: usize = C_LPOST + NA;
+pub const C_TPRE: usize = C_ROOT + D;
+pub const C_TPOST: usize = C_TPRE + D;
+pub const WIDTH: usize = C_TPOST + D;
+
+pub struct MemAir {
+    pub weak: u64,
+}
+
+impl<T> BaseAir<T> for MemAir {
+    fn width(&self) -> usize {
+        WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for MemAir {}
+impl<T> PartitionedBaseAir<T> for MemAir {}
+
+/// Top address limb width at TOP = 63 (FP-1 `addr`).
+pub const TOP_BITS: usize = 2;
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for MemAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        let nx = |i: usize| -> AB::Expr { n[i].into() };
+        let act = c(C_ACT);
+        let one = AB::Expr::ONE;
+        builder.assert_bool(act.clone());
+        builder.assert_bool(c(C_F0));
+        builder.when_first_row().assert_one(c(C_F0));
+        builder.when_transition().assert_zero(nx(C_F0));
+        builder.when_first_row().assert_zero(c(C_RC));
+        builder.when_transition().assert_eq(nx(C_RC), c(C_RC) + one.clone());
+        // Active prefix; the last row is inactive (MEM-006).
+        builder.when_transition().assert_zero(nx(C_ACT) * (one.clone() - act.clone()));
+        builder.when_last_row().assert_zero(act.clone());
+        // Token fields are the same on every row.
+        for i in C_LPRE..WIDTH {
+            builder.when_transition().assert_eq(nx(i), c(i));
+        }
+        // Dense addresses: row 0 at len_pre, row i+1 at addr_i + 1 (limb carries, no wrap).
+        let range = bus::range();
+        for k in 0..NA {
+            builder.when_first_row().assert_eq(c(C_ADDR + k), c(C_LPRE + k));
+            builder.assert_bool(c(C_CARRY + k));
+            let bits = if k == NA - 1 { TOP_BITS } else { 16 };
+            range.range_check(c(C_ADDR + k), bits).eval(builder, one.clone());
+            range.range_check(c(C_LPOST + k), bits).eval(builder, c(C_F0));
+        }
+        if self.weak & weak::MEM_DENSE == 0 {
+            for k in 0..NA {
+                // The weakened control types the window address as u64 (no carry into the top limb).
+                if k == NA - 1 && self.weak & weak::MEM_NO_WRAP != 0 {
+                    continue;
+                }
+                let cin = if k == 0 { one.clone() } else { c(C_CARRY + k - 1) };
+                builder.when_transition().assert_eq(
+                    nx(C_ADDR + k),
+                    c(C_ADDR + k) + cin - c(C_CARRY + k) * AB::Expr::from_u32(1 << 16),
+                );
+            }
+        }
+        if self.weak & weak::MEM_NO_WRAP == 0 {
+            builder.when_transition().assert_zero(c(C_CARRY + NA - 1));
+        }
+        // The first inactive row fixes len_post and tail_post.
+        let close = act.clone() - nx(C_ACT);
+        if self.weak & weak::MEM_LEN_POST == 0 {
+            for k in 0..NA {
+                builder.when_transition().assert_zero(close.clone() * (nx(C_ADDR + k) - c(C_LPOST + k)));
+                builder.when_first_row().assert_zero((one.clone() - act.clone()) * (c(C_ADDR + k) - c(C_LPOST + k)));
+            }
+        }
+        for i in 0..D {
+            builder.when_transition().assert_zero(close.clone() * (nx(C_TIN + i) - c(C_TPOST + i)));
+            builder.when_first_row().assert_zero((one.clone() - act.clone()) * (c(C_TIN + i) - c(C_TPOST + i)));
+            builder.when_first_row().assert_eq(c(C_TIN + i), c(C_TPRE + i));
+            // The chain: the next row starts from this row's tail.
+            builder.when_transition().assert_zero(act.clone() * (nx(C_TIN + i) - c(C_TOUT + i)));
+        }
+        // kind in 1..=4 on active rows.
+        range.range_check(act.clone() * (c(C_KIND) - one.clone()), 2).eval(builder, one.clone());
+        // Record digest and the append chain.
+        let sq = c(C_RC) + AB::Expr::from_u32(seq::MEM_REC);
+        let mut words: Vec<AB::Expr> = vec![AB::Expr::from_u32(DOM_MEMREC), c(C_KIND)];
+        words.extend((0..NA).map(|k| c(C_ADDR + k)));
+        words.extend((0..W_REC).map(|k| c(C_REC + k)));
+        let len = words.len();
+        while words.len() % 8 != 0 {
+            words.push(AB::Expr::ZERO);
+        }
+        for (b, blk) in words.chunks(8).enumerate() {
+            let mut m = vec![sq.clone(), AB::Expr::from_usize(b), AB::Expr::from_usize(len)];
+            m.extend(blk.iter().cloned());
+            bus::perm(bus::PORT_SPONGE_IN).send(builder, m, act.clone());
+        }
+        let mut o = vec![sq];
+        o.extend((0..D).map(|i| c(C_RD + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, o, act.clone());
+        let mut h = vec![AB::Expr::from_u32(TAG_NODE)];
+        h.extend((0..D).map(|i| c(C_TIN + i)));
+        h.extend((0..D).map(|i| c(C_RD + i)));
+        h.extend((0..D).map(|i| c(C_TOUT + i)));
+        bus::lookup(bus::HASH).lookup_key(builder, h, act.clone());
+        // MEM bus: one provider instance per CORE append.
+        let mut m = vec![c(C_KIND)];
+        m.extend((0..NA + W_REC).map(|k| c(C_ADDR + k)));
+        bus::mem_bus().send(builder, m, act.clone());
+        // Tokens.
+        let tail_ok = self.weak & weak::MEM_TOKEN_TAIL == 0;
+        for (s, lo, to) in [(seq::TOKEN_PRE, C_LPRE, C_TPRE), (seq::TOKEN_POST, C_LPOST, C_TPOST)] {
+            let mut m = vec![AB::Expr::from_u32(s)];
+            m.extend((0..NA).map(|k| c(lo + k)));
+            m.extend((0..D).map(|k| c(C_ROOT + k)));
+            m.extend((0..D).map(|k| if tail_ok { c(to + k) } else { AB::Expr::ZERO }));
+            bus::perm(bus::PORT_MEM_TOKEN).send(builder, m, c(C_F0));
+        }
+    }
+}
+
+/// One appended record.
+#[derive(Clone, Debug)]
+pub struct Rec {
+    pub kind: u32,
+    pub rec: [F; W_REC],
+}
+
+/// Window input: `len_pre`, `root`, `tail_pre`, appends.
+#[derive(Clone, Debug)]
+pub struct Window {
+    pub len_pre: u128,
+    pub root: Digest,
+    pub tail_pre: Digest,
+    pub appends: Vec<Rec>,
+}
+
+pub fn addr_limbs(a: u128) -> [F; NA] {
+    std::array::from_fn(|k| F::from_u64(((a >> (16 * k)) & 0xffff) as u64))
+}
+
+/// Post token `(len_post, tail_post)` of a window.
+pub fn post(w: &Window) -> (u128, Digest) {
+    let mut t = w.tail_pre;
+    for (i, r) in w.appends.iter().enumerate() {
+        t = chain(&t, &rec_d(r, w.len_pre + i as u128));
+    }
+    (w.len_pre + w.appends.len() as u128, t)
+}
+
+pub fn rec_words(r: &Rec, addr: u128) -> Vec<F> {
+    let mut v = vec![F::from_u32(r.kind)];
+    v.extend(addr_limbs(addr));
+    v.extend_from_slice(&r.rec);
+    v
+}
+pub fn rec_d(r: &Rec, addr: u128) -> Digest {
+    p2(DOM_MEMREC, &rec_words(r, addr))
+}
+pub fn chain(t: &Digest, rd: &Digest) -> Digest {
+    let mut w = t.to_vec();
+    w.extend_from_slice(rd);
+    p2(TAG_NODE, &w)
+}
+
+/// Mutations of the window witness (SG-3): per-row addresses, `len_post`.
+#[derive(Clone, Debug, Default)]
+pub struct Mut {
+    pub addrs: Option<Vec<u128>>,
+    pub len_post: Option<u128>,
+}
+
+/// MEM trace, its HASH2 rows and sponge calls. `range` receives the range counts.
+pub fn trace(w: &Window, range: &mut dyn FnMut(u32, usize)) -> (RowMajorMatrix<F>, Vec<H2>, Vec<Call>) {
+    trace_mut(w, &Mut::default(), range)
+}
+
+pub fn trace_mut(w: &Window, mu: &Mut, range: &mut dyn FnMut(u32, usize)) -> (RowMajorMatrix<F>, Vec<H2>, Vec<Call>) {
+    assert!(w.appends.len() < HEIGHT, "MEM-006: {} appends in a window of {HEIGHT}", w.appends.len());
+    let addr_of = |r: usize| -> u128 {
+        mu.addrs.as_ref().map(|a| a[r]).unwrap_or(w.len_pre + r as u128)
+    };
+    let mut tpost = w.tail_pre;
+    for (i, r) in w.appends.iter().enumerate() {
+        tpost = chain(&tpost, &rec_d(r, addr_of(i)));
+    }
+    let lpost = mu.len_post.unwrap_or(addr_of(w.appends.len()));
+    let mut v = vec![F::ZERO; HEIGHT * WIDTH];
+    let mut h2 = vec![];
+    let mut calls = vec![];
+    let mut tin = w.tail_pre;
+    for r in 0..HEIGHT {
+        let row = &mut v[r * WIDTH..(r + 1) * WIDTH];
+        let addr = addr_of(r);
+        row[C_F0] = F::from_bool(r == 0);
+        row[C_RC] = F::from_usize(r);
+        let al = addr_limbs(addr);
+        row[C_ADDR..C_ADDR + NA].copy_from_slice(&al);
+        // carries of addr + 1
+        let mut carry = 1u128;
+        for k in 0..NA {
+            let limb = (addr >> (16 * k)) & 0xffff;
+            let c = if limb + carry >= 1 << 16 { 1 } else { 0 };
+            row[C_CARRY + k] = F::from_u32(c as u32);
+            carry = c;
+        }
+        if r + 1 < HEIGHT && mu.addrs.is_some() {
+            // carries that reach the given next address (the top carry may wrap)
+            let next = addr_of(r + 1);
+            let mut cin = 1i128;
+            for k in 0..NA {
+                let a = ((addr >> (16 * k)) & 0xffff) as i128;
+                let b = ((next >> (16 * k)) & 0xffff) as i128;
+                let c = if a + cin - b == 1 << 16 { 1 } else { 0 };
+                row[C_CARRY + k] = F::from_u32(c as u32);
+                cin = c;
+            }
+        }
+        for k in 0..NA {
+            range(al[k].as_canonical_u32_(), if k == NA - 1 { TOP_BITS } else { 16 });
+        }
+        row[C_TIN..C_TIN + D].copy_from_slice(&tin);
+        if let Some(rec) = w.appends.get(r) {
+            row[C_ACT] = F::ONE;
+            row[C_KIND] = F::from_u32(rec.kind);
+            row[C_REC..C_REC + W_REC].copy_from_slice(&rec.rec);
+            let rd = rec_d(rec, addr);
+            calls.push(Call { seq: seq::MEM_REC + r as u32, tag: DOM_MEMREC, words: rec_words(rec, addr)[..].to_vec() });
+            let tout = chain(&tin, &rd);
+            h2.push(H2 { tag: TAG_NODE, x: tin, y: rd, mult: 1, t2: None });
+            row[C_RD..C_RD + D].copy_from_slice(&rd);
+            row[C_TOUT..C_TOUT + D].copy_from_slice(&tout);
+            range(rec.kind - 1, 2);
+            tin = tout;
+        } else {
+            range(0, 2);
+        }
+        row[C_LPRE..C_LPRE + NA].copy_from_slice(&addr_limbs(w.len_pre));
+        row[C_LPOST..C_LPOST + NA].copy_from_slice(&addr_limbs(lpost));
+        row[C_ROOT..C_ROOT + D].copy_from_slice(&w.root);
+        row[C_TPRE..C_TPRE + D].copy_from_slice(&w.tail_pre);
+        row[C_TPOST..C_TPOST + D].copy_from_slice(&tpost);
+    }
+    for k in 0..NA {
+        range(addr_limbs(lpost)[k].as_canonical_u32_(), if k == NA - 1 { TOP_BITS } else { 16 });
+    }
+    (RowMajorMatrix::new(v, WIDTH), h2, calls)
+}
+
+/// The token message `(seq, len, root, tail)` CORE receives.
+pub fn token(s: u32, len: u128, root: &Digest, tail: &Digest) -> Vec<F> {
+    let mut m = vec![F::from_u32(s)];
+    m.extend(addr_limbs(len));
+    m.extend_from_slice(root);
+    m.extend_from_slice(tail);
+    m
+}
+
+trait Canon {
+    fn as_canonical_u32_(&self) -> u32;
+}
+impl Canon for F {
+    fn as_canonical_u32_(&self) -> u32 {
+        use openvm_stark_backend::p3_field::PrimeField32;
+        self.as_canonical_u32()
+    }
+}
+
+#[allow(dead_code)]
+fn _h(m: &RowMajorMatrix<F>) -> usize {
+    m.height()
+}
diff --git a/crates/sherlock-leaf/src/rom.rs b/crates/sherlock-leaf/src/rom.rs
new file mode 100644
index 0000000..87652d2
--- /dev/null
+++ b/crates/sherlock-leaf/src/rom.rs
@@ -0,0 +1,167 @@
+//! ROM line (V.8, PAGE-004 over the rows of the V.1 program): each active row opens one ROM row
+//! `(tbl, row, rec)` under `prog_root` with its 69-level path, and provides it on the ROM bus.
+//!
+//! The leaf is `P2(DOM_ROMLEAF, tbl, rec)` through the sponge; each level is one HASH bus lookup
+//! `(DOM_ROMNODE, l, r, parent)`; the root goes to CORE on port `rom_root`. `tbl` and `row` are
+//! separate typed lanes recomposed from the 69 path bits (FP-1, BUS-005).
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bus::{self, seq},
+    enc::{node, rom_tree, Digest, RomRow, DOM_ROMLEAF, DOM_ROMNODE, D, F, ROM_DEPTH, W_ROM},
+    sponge::{Call, H2},
+};
+
+pub mod weak {
+    /// The path bits recompose the `row` lane.
+    pub const ROM_BITS_ARE_ROW: u64 = 1 << 8;
+    /// The root is sent once per active row (a port producer instance has one consumer).
+    pub const ROM_ROOT_ONCE: u64 = 1 << 9;
+}
+
+pub const C_ACT: usize = 0;
+pub const C_RC: usize = 1;
+pub const C_MULT: usize = 2;
+pub const C_TBL: usize = 3;
+pub const C_ROW: usize = 4;
+pub const C_REC: usize = C_ROW + 4;
+pub const C_BITS: usize = C_REC + W_ROM;
+pub const C_SIB: usize = C_BITS + ROM_DEPTH;
+pub const C_NODE: usize = C_SIB + ROM_DEPTH * D;
+pub const WIDTH: usize = C_NODE + (ROM_DEPTH + 1) * D;
+pub const HEIGHT: usize = 2;
+
+pub struct RomAir {
+    pub weak: u64,
+}
+
+impl<T> BaseAir<T> for RomAir {
+    fn width(&self) -> usize {
+        WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for RomAir {}
+impl<T> PartitionedBaseAir<T> for RomAir {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for RomAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        let act = c(C_ACT);
+        builder.assert_bool(act.clone());
+        builder.assert_zero(c(C_MULT) * (AB::Expr::ONE - act.clone()));
+        builder.when_first_row().assert_zero(c(C_RC));
+        builder.when_transition().assert_eq(n[C_RC].into(), c(C_RC) + AB::Expr::ONE);
+        for i in 0..ROM_DEPTH {
+            builder.assert_bool(c(C_BITS + i));
+        }
+        let pow = |k: usize| AB::Expr::from_u32(1 << k);
+        if self.weak & weak::ROM_BITS_ARE_ROW == 0 {
+            for k in 0..4 {
+                let s = (0..16).fold(AB::Expr::ZERO, |a, i| a + c(C_BITS + 16 * k + i) * pow(i));
+                builder.assert_eq(c(C_ROW + k), s);
+            }
+        }
+        let t = (0..5).fold(AB::Expr::ZERO, |a, i| a + c(C_BITS + 64 + i) * pow(i));
+        builder.assert_eq(c(C_TBL), t);
+        // Leaf through the sponge.
+        let sq = c(C_RC) + AB::Expr::from_u32(seq::ROM_LEAF);
+        let mut words: Vec<AB::Expr> = vec![AB::Expr::from_u32(DOM_ROMLEAF), c(C_TBL)];
+        words.extend((0..W_ROM).map(|i| c(C_REC + i)));
+        let len = words.len();
+        while words.len() % 8 != 0 {
+            words.push(AB::Expr::ZERO);
+        }
+        for (b, blk) in words.chunks(8).enumerate() {
+            let mut m = vec![sq.clone(), AB::Expr::from_usize(b), AB::Expr::from_usize(len)];
+            m.extend(blk.iter().cloned());
+            bus::perm(bus::PORT_SPONGE_IN).send(builder, m, act.clone());
+        }
+        let mut o = vec![sq];
+        o.extend((0..D).map(|i| c(C_NODE + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, o, act.clone());
+        // Levels.
+        for k in 0..ROM_DEPTH {
+            let b = c(C_BITS + k);
+            let mut m = vec![AB::Expr::from_u32(DOM_ROMNODE)];
+            let cur = |i: usize| c(C_NODE + k * D + i);
+            let sib = |i: usize| c(C_SIB + k * D + i);
+            m.extend((0..D).map(|i| cur(i) + b.clone() * (sib(i) - cur(i))));
+            m.extend((0..D).map(|i| sib(i) + b.clone() * (cur(i) - sib(i))));
+            m.extend((0..D).map(|i| c(C_NODE + (k + 1) * D + i)));
+            bus::lookup(bus::HASH).lookup_key(builder, m, act.clone());
+        }
+        let root: Vec<AB::Expr> = (0..D).map(|i| c(C_NODE + ROM_DEPTH * D + i)).collect();
+        let rc = if self.weak & weak::ROM_ROOT_ONCE == 0 { act.clone() } else { act.clone() + act.clone() };
+        bus::perm(bus::PORT_ROM_ROOT).send(builder, root, rc);
+        let mut key = vec![c(C_TBL)];
+        key.extend((0..4 + W_ROM).map(|i| c(C_ROW + i)));
+        bus::lookup(bus::ROM).add_key_with_lookups(builder, key, c(C_MULT));
+    }
+}
+
+/// One opened ROM row with its lookup count.
+pub struct Open {
+    pub row: RomRow,
+    pub mult: u32,
+}
+
+/// ROM trace of the opened rows of `all` (the program's ROM): the trace, the HASH2 rows and the
+/// sponge calls it needs, and the root.
+pub fn trace(all: &[RomRow], open: &[Open]) -> (RowMajorMatrix<F>, Vec<H2>, Vec<Call>, Digest) {
+    let (root, paths) = rom_tree(all);
+    assert!(open.len() <= HEIGHT);
+    let mut v = vec![F::ZERO; HEIGHT * WIDTH];
+    let mut h2 = vec![];
+    let mut calls = vec![];
+    for r in 0..HEIGHT {
+        let row = &mut v[r * WIDTH..(r + 1) * WIDTH];
+        row[C_RC] = F::from_usize(r);
+        let Some(o) = open.get(r) else { continue };
+        let i = all.iter().position(|x| x.key() == o.row.key()).expect("ROM row in the program");
+        let rr = &all[i];
+        row[C_ACT] = F::ONE;
+        row[C_MULT] = F::from_u32(o.mult);
+        row[C_TBL] = F::from_u32(rr.tbl);
+        for k in 0..4 {
+            row[C_ROW + k] = F::from_u64((rr.row >> (16 * k)) & 0xffff);
+        }
+        row[C_REC..C_REC + W_ROM].copy_from_slice(&rr.rec);
+        let key = rr.key();
+        for k in 0..ROM_DEPTH {
+            row[C_BITS + k] = F::from_bool((key >> k) & 1 == 1);
+        }
+        let mut cur = rr.leaf();
+        let mut w = vec![F::from_u32(rr.tbl)];
+        w.extend_from_slice(&rr.rec);
+        calls.push(Call { seq: seq::ROM_LEAF + r as u32, tag: DOM_ROMLEAF, words: w });
+        row[C_NODE..C_NODE + D].copy_from_slice(&cur);
+        for k in 0..ROM_DEPTH {
+            let sib = paths[i][k];
+            row[C_SIB + k * D..C_SIB + (k + 1) * D].copy_from_slice(&sib);
+            let (a, b) = if (key >> k) & 1 == 0 { (cur, sib) } else { (sib, cur) };
+            cur = node(&a, &b);
+            h2.push(H2 { tag: DOM_ROMNODE, x: a, y: b, mult: 1, t2: None });
+            row[C_NODE + (k + 1) * D..C_NODE + (k + 2) * D].copy_from_slice(&cur);
+        }
+        assert_eq!(cur, root);
+    }
+    (RowMajorMatrix::new(v, WIDTH), h2, calls, root)
+}
+
+#[allow(dead_code)]
+fn _h(m: &RowMajorMatrix<F>) -> usize {
+    m.height()
+}
diff --git a/crates/sherlock-leaf/src/sponge.rs b/crates/sherlock-leaf/src/sponge.rs
new file mode 100644
index 0000000..79627aa
--- /dev/null
+++ b/crates/sherlock-leaf/src/sponge.rs
@@ -0,0 +1,324 @@
+//! HASH (V.4): the whole-sponge slot `SPONGE` (one Poseidon2 permutation per row, `P2` of FP-4)
+//! and the two-input provider `HASH2` of the FP-1 HASH bus `(tag, x, y, h)`.
+//!
+//! SPONGE rows of one call are consecutive: the first row starts the state `[b_0, len, 0..]`, a
+//! later row overwrites the rate with its block and keeps the capacity of the previous output,
+//! and the last row sends the digest. A requester sends each block `(seq, blk, len, b[8])` once
+//! on port `sponge_in` and receives `(seq, h[8])` once on port `sponge_out` (HSH-003).
+
+use std::{borrow::Borrow, sync::Arc};
+
+use openvm_poseidon2_air::{
+    Poseidon2Config, Poseidon2SubAir, Poseidon2SubChip, Poseidon2SubCols, BABY_BEAR_POSEIDON2_HALF_FULL_ROUNDS,
+};
+use openvm_stark_backend::{
+    air_builders::sub::SubAirBuilder,
+    interaction::InteractionBuilder,
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::{
+    bus::{self, seq},
+    enc::{p2_blocks, perm, Digest, F, D},
+};
+
+pub type Sub = Poseidon2SubAir<F, 1>;
+
+pub fn sub_chip() -> Poseidon2SubChip<F, 1> {
+    Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants)
+}
+
+pub fn sub_width() -> usize {
+    <Sub as BaseAir<F>>::width(&sub_chip().air)
+}
+
+/// Weakened controls of SPONGE (SG-3): each bit removes one named constraint.
+pub mod weak {
+    /// The output columns equal the last full round of the permutation.
+    pub const SPONGE_OUT_IS_PERM: u64 = 1 << 0;
+    /// HASH2: the first block word equals the tag lane of the HASH message.
+    pub const HASH2_TAG_IS_DOMAIN: u64 = 1 << 1;
+}
+
+// ---------------------------------------------------------------- SPONGE
+/// Columns after the sub-AIR: `act`, `first`, `last`, `seq`, `blk`, `len`, `out[16]`.
+pub const S_ACT: usize = 0;
+pub const S_FIRST: usize = 1;
+pub const S_LAST: usize = 2;
+pub const S_SEQ: usize = 3;
+pub const S_BLK: usize = 4;
+pub const S_LEN: usize = 5;
+pub const S_OUT: usize = 6;
+pub const S_EXTRA: usize = S_OUT + 16;
+
+pub struct SpongeAir {
+    pub sub: Arc<Sub>,
+    pub weak: u64,
+}
+
+impl SpongeAir {
+    pub fn new(weak: u64) -> Self {
+        Self { sub: sub_chip().air, weak }
+    }
+}
+
+impl<T> BaseAir<T> for SpongeAir {
+    fn width(&self) -> usize {
+        sub_width() + S_EXTRA
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for SpongeAir {}
+impl<T> PartitionedBaseAir<T> for SpongeAir {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for SpongeAir {
+    fn eval(&self, builder: &mut AB) {
+        let w = sub_width();
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let ls: &Poseidon2SubCols<AB::Var, 1> = l[..w].borrow();
+        let ns: &Poseidon2SubCols<AB::Var, 1> = n[..w].borrow();
+        let x = |r: &[AB::Var], c: usize| -> AB::Expr { r[w + c].into() };
+        let post = ls.ending_full_rounds[BABY_BEAR_POSEIDON2_HALF_FULL_ROUNDS - 1].post;
+        let inputs = ls.inputs;
+        let n_inputs = ns.inputs;
+
+        let mut sb = SubAirBuilder::<AB, Sub, AB::F>::new(builder, 0..w);
+        self.sub.eval(&mut sb);
+
+        let (act, first, last) = (x(l, S_ACT), x(l, S_FIRST), x(l, S_LAST));
+        for b in [&act, &first, &last] {
+            builder.assert_bool(b.clone());
+        }
+        builder.assert_zero(first.clone() * (AB::Expr::ONE - act.clone()));
+        builder.assert_zero(last.clone() * (AB::Expr::ONE - act.clone()));
+        // First row of a call: block 0, capacity [len, 0, ..].
+        builder.assert_zero(first.clone() * x(l, S_BLK));
+        builder.assert_zero(first.clone() * (inputs[8].into() - x(l, S_LEN)));
+        for i in 9..16 {
+            builder.assert_zero(first.clone() * inputs[i].into());
+        }
+        // Output columns are the permutation output.
+        if self.weak & weak::SPONGE_OUT_IS_PERM == 0 {
+            for i in 0..16 {
+                builder.assert_eq(x(l, S_OUT + i), post[i].into());
+            }
+        }
+        // A call continues until its last row: (act - last) on this row = (act - first) on the
+        // next; a continuation keeps seq and len, advances blk and takes the capacity.
+        let cont: AB::Expr = x(n, S_ACT) - x(n, S_FIRST);
+        builder.when_transition().assert_eq(act.clone() - last.clone(), cont.clone());
+        let mut t = builder.when_transition();
+        t.assert_zero(cont.clone() * (x(n, S_SEQ) - x(l, S_SEQ)));
+        t.assert_zero(cont.clone() * (x(n, S_LEN) - x(l, S_LEN)));
+        t.assert_zero(cont.clone() * (x(n, S_BLK) - x(l, S_BLK) - AB::Expr::ONE));
+        for i in 8..16 {
+            t.assert_zero(cont.clone() * (n_inputs[i].into() - x(l, S_OUT + i)));
+        }
+        builder.when_first_row().assert_eq(x(l, S_ACT), x(l, S_FIRST));
+        builder.when_last_row().assert_eq(x(l, S_ACT), x(l, S_LAST));
+
+        let mut msg = vec![x(l, S_SEQ), x(l, S_BLK), x(l, S_LEN)];
+        msg.extend((0..8).map(|i| inputs[i].into()));
+        bus::perm(bus::PORT_SPONGE_IN).receive(builder, msg, act.clone());
+        let mut out = vec![x(l, S_SEQ)];
+        out.extend((0..8).map(|i| x(l, S_OUT + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).send(builder, out, last);
+    }
+}
+
+/// One sponge call: `seq`, tag and words (the digest is `P2(tag, words)`).
+#[derive(Clone, Debug)]
+pub struct Call {
+    pub seq: u32,
+    pub tag: u32,
+    pub words: Vec<F>,
+}
+
+/// Mutation of one sponge row (SG-3): row index and new output state.
+pub type RowPatch = Box<dyn Fn(usize, &mut [F; 16])>;
+
+/// The SPONGE trace of `calls` at `height` rows (fixed by the shape).
+pub fn sponge_trace(calls: &[Call], height: usize, patch: Option<&RowPatch>) -> RowMajorMatrix<F> {
+    let w = sub_width();
+    let width = w + S_EXTRA;
+    let mut inputs: Vec<[F; 16]> = vec![];
+    let mut extra: Vec<[F; S_EXTRA]> = vec![];
+    for c in calls {
+        let (len, blocks) = p2_blocks(c.tag, &c.words);
+        let mut st = [F::ZERO; 16];
+        st[8] = F::from_usize(len);
+        let nb = blocks.len();
+        for (k, b) in blocks.iter().enumerate() {
+            st[..8].copy_from_slice(b);
+            inputs.push(st);
+            let mut out = perm(st);
+            if let Some(p) = patch {
+                p(inputs.len() - 1, &mut out);
+            }
+            let mut e = [F::ZERO; S_EXTRA];
+            e[S_ACT] = F::ONE;
+            e[S_FIRST] = F::from_bool(k == 0);
+            e[S_LAST] = F::from_bool(k + 1 == nb);
+            e[S_SEQ] = F::from_u32(c.seq);
+            e[S_BLK] = F::from_usize(k);
+            e[S_LEN] = F::from_usize(len);
+            e[S_OUT..S_OUT + 16].copy_from_slice(&out);
+            extra.push(e);
+            st = out;
+        }
+    }
+    assert!(inputs.len() <= height, "SPONGE: {} rows over the shape height {height}", inputs.len());
+    while inputs.len() < height {
+        inputs.push([F::ZERO; 16]);
+        let mut e = [F::ZERO; S_EXTRA];
+        e[S_OUT..S_OUT + 16].copy_from_slice(&perm([F::ZERO; 16]));
+        extra.push(e);
+    }
+    let sub = sub_chip().generate_trace(inputs);
+    let mut v = Vec::with_capacity(height * width);
+    for r in 0..height {
+        v.extend_from_slice(&sub.values[r * w..(r + 1) * w]);
+        v.extend_from_slice(&extra[r]);
+    }
+    RowMajorMatrix::new(v, width)
+}
+
+/// Rows a list of calls takes.
+pub fn rows_of(calls: &[Call]) -> usize {
+    calls.iter().map(|c| p2_blocks(c.tag, &c.words).1.len()).sum()
+}
+
+/// Requester side: the port messages of one call (blocks sent, digest received), as constant
+/// field vectors (used by trace-side checks only; AIRs build them from columns).
+pub fn digest_of(c: &Call) -> Digest {
+    crate::enc::p2(c.tag, &c.words)
+}
+
+// ---------------------------------------------------------------- HASH2
+/// Columns: `act`, `tag`, `t2` (the first block word), `x[8]`, `y[8]`, `h[8]`, `mult`, `rc`.
+pub const H_ACT: usize = 0;
+pub const H_TAG: usize = 1;
+pub const H_T2: usize = 2;
+pub const H_X: usize = 3;
+pub const H_Y: usize = H_X + D;
+pub const H_H: usize = H_Y + D;
+pub const H_MULT: usize = H_H + D;
+pub const H_RC: usize = H_MULT + 1;
+pub const H_WIDTH: usize = H_RC + 1;
+
+/// The two-input provider of the HASH bus: one row per distinct `(tag, x, y)`, each row one
+/// 17-word sponge call with `seq = HASH2 + row`.
+pub struct Hash2Air {
+    pub weak: u64,
+}
+
+impl<T> BaseAir<T> for Hash2Air {
+    fn width(&self) -> usize {
+        H_WIDTH
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for Hash2Air {}
+impl<T> PartitionedBaseAir<T> for Hash2Air {}
+
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for Hash2Air {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        let act = c(H_ACT);
+        builder.assert_bool(act.clone());
+        builder.assert_zero(c(H_MULT) * (AB::Expr::ONE - act.clone()));
+        builder.when_first_row().assert_zero(c(H_RC));
+        builder.when_transition().assert_eq(n[H_RC].into(), c(H_RC) + AB::Expr::ONE);
+        if self.weak & weak::HASH2_TAG_IS_DOMAIN == 0 {
+            builder.assert_zero(act.clone() * (c(H_T2) - c(H_TAG)));
+        }
+        let sq = c(H_RC) + AB::Expr::from_u32(seq::HASH2);
+        let len = AB::Expr::from_u32(17);
+        let words: Vec<AB::Expr> = std::iter::once(c(H_T2))
+            .chain((0..D).map(|i| c(H_X + i)))
+            .chain((0..D).map(|i| c(H_Y + i)))
+            .chain((0..7).map(|_| AB::Expr::ZERO))
+            .collect();
+        for blk in 0..3 {
+            let mut m = vec![sq.clone(), AB::Expr::from_usize(blk), len.clone()];
+            m.extend(words[8 * blk..8 * blk + 8].iter().cloned());
+            bus::perm(bus::PORT_SPONGE_IN).send(builder, m, act.clone());
+        }
+        let mut o = vec![sq];
+        o.extend((0..D).map(|i| c(H_H + i)));
+        bus::perm(bus::PORT_SPONGE_OUT).receive(builder, o, act.clone());
+        let mut key = vec![c(H_TAG)];
+        key.extend((0..3 * D).map(|i| c(H_X + i)));
+        bus::lookup(bus::HASH).add_key_with_lookups(builder, key, c(H_MULT));
+    }
+}
+
+/// One HASH bus entry `(tag, x, y)` with its lookup count.
+#[derive(Clone, Debug)]
+pub struct H2 {
+    pub tag: u32,
+    pub x: Digest,
+    pub y: Digest,
+    pub mult: u32,
+    /// SG-3 only: the tag word the sponge call starts with (the tag otherwise).
+    pub t2: Option<u32>,
+}
+
+/// HASH2 trace at `height` rows and the sponge calls it makes.
+pub fn hash2_trace(rows: &[H2], height: usize) -> (RowMajorMatrix<F>, Vec<Call>) {
+    assert!(rows.len() <= height, "HASH2: {} rows over {height}", rows.len());
+    let mut v = vec![F::ZERO; height * H_WIDTH];
+    let mut calls = vec![];
+    for r in 0..height {
+        let row = &mut v[r * H_WIDTH..(r + 1) * H_WIDTH];
+        row[H_RC] = F::from_usize(r);
+        if let Some(h) = rows.get(r) {
+            let t2 = h.t2.unwrap_or(h.tag);
+            let mut words = h.x.to_vec();
+            words.extend_from_slice(&h.y);
+            let call = Call { seq: seq::HASH2 + r as u32, tag: t2, words };
+            let d = digest_of(&call);
+            calls.push(call);
+            row[H_ACT] = F::ONE;
+            row[H_TAG] = F::from_u32(h.tag);
+            row[H_T2] = F::from_u32(t2);
+            row[H_X..H_X + D].copy_from_slice(&h.x);
+            row[H_Y..H_Y + D].copy_from_slice(&h.y);
+            row[H_H..H_H + D].copy_from_slice(&d);
+            row[H_MULT] = F::from_u32(h.mult);
+        }
+    }
+    (RowMajorMatrix::new(v, H_WIDTH), calls)
+}
+
+/// The constant 1 field element (re-export for AIR code that names the field).
+pub fn one() -> F {
+    F::ONE
+}
+
+#[allow(dead_code)]
+fn _field_is_bb<T: Field>() {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The sub-AIR constants (`Poseidon2Config::default`) are the stark-sdk permutation.
+    #[test]
+    fn sub_air_is_stark_sdk_perm() {
+        let st: [F; 16] = std::array::from_fn(|i| F::from_usize(i * 7 + 1));
+        let t = sub_chip().generate_trace(vec![st, [F::ZERO; 16]]);
+        let w = sub_width();
+        let cols: &Poseidon2SubCols<F, 1> = t.values[..w].borrow();
+        let post = cols.ending_full_rounds[BABY_BEAR_POSEIDON2_HALF_FULL_ROUNDS - 1].post;
+        assert_eq!(post, perm(st));
+    }
+}
diff --git a/crates/sherlock-lfr/src/keybind.rs b/crates/sherlock-lfr/src/keybind.rs
index 2bb63be..fb9c76d 100644
