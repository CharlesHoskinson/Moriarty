+++ b/crates/sherlock-leaf/src/enc.rs
@@ -0,0 +1,484 @@
+//! FP-1 word types, the FP-4 `P2` reference, the tag codes and the slice state layout.
+//!
+//! Sources: `FD/ARCHITECTURE.md` section 1.11 (FP-1 types, FP-4 digest table, FP-5 header) and
+//! `research/sherlock-tested-design-20261113/T5-SCHEMAS.md` section 1.6 with Appendix A (the
+//! 476-word body at `ridx = u64`, with O-3 and O-5 applied). Values that no source fixes are
+//! slice-local picks; each is named `PICK` in a comment and listed in the T6 RESULTS record.
+
+use openvm_stark_backend::{p3_field::PrimeCharacteristicRing, p3_symmetric::Permutation};
+use openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;
+use p3_baby_bear::BabyBear;
+
+pub type F = BabyBear;
+/// Digest width.
+pub const D: usize = 8;
+pub type Digest = [F; D];
+
+// ---------------------------------------------------------------- FP-4 tag codes
+pub const TAG_EMPTY: u32 = 1;
+pub const TAG_NODE: u32 = 3;
+pub const DOM_PROG: u32 = 5;
+pub const SHK_IMAGE: u32 = 12;
+pub const SHK_VALUE_V2: u32 = 13;
+pub const SHK_IN: u32 = 15;
+pub const SHK_VIEW: u32 = 26;
+pub const SHK_DEPS: u32 = 28;
+pub const SHK_SD2: u32 = 29;
+pub const DOM_STATE_BODY: u32 = 30;
+pub const DOM_MEMREC: u32 = 33;
+pub const DOM_FRAMES: u32 = 37;
+pub const DOM_TASKS: u32 = 38;
+pub const DOM_ROMLEAF: u32 = 39;
+pub const DOM_ROMNODE: u32 = 40;
+pub const DOM_PLAN: u32 = 41;
+/// PICK: `dom("SHK_RULES")` has no code in FP-4; 58 is the next free code (FP-4: later digests
+/// take the next free codes in registry order, 45 to 57 are the type and name digests).
+pub const SHK_RULES: u32 = 58;
+/// PICK: body schema id of the slice body (476 words).
+pub const SCHEMA_ID: u32 = 1;
+
+/// `P2(tag, xs)`: Poseidon2 over BabyBear, width 16, rate 8, the tag word first, the total
+/// length in the first capacity word, the last rate block padded with zeros (overwrite).
+pub fn p2(tag: u32, xs: &[F]) -> Digest {
+    let (len, blocks) = p2_blocks(tag, xs);
+    let mut st = [F::ZERO; 16];
+    st[8] = F::from_u32(len as u32);
+    for b in &blocks {
+        st[..8].copy_from_slice(b);
+        poseidon2_perm().permute_mut(&mut st);
+    }
+    st[..8].try_into().unwrap()
+}
+
+/// The rate blocks of `P2(tag, xs)` and the total length `1 + |xs|`.
+pub fn p2_blocks(tag: u32, xs: &[F]) -> (usize, Vec<[F; 8]>) {
+    let mut w = vec![F::from_u32(tag)];
+    w.extend_from_slice(xs);
+    let blocks = w
+        .chunks(8)
+        .map(|c| std::array::from_fn(|i| if i < c.len() { c[i] } else { F::ZERO }))
+        .collect();
+    (w.len(), blocks)
+}
+
+/// The permutation of the sponge: full state in, full state out.
+pub fn perm(st: [F; 16]) -> [F; 16] {
+    let mut s = st;
+    poseidon2_perm().permute_mut(&mut s);
+    s
+}
+
+pub fn fu(x: u64) -> F {
+    F::from_u64(x)
+}
+
+pub fn digest_u32(d: &Digest) -> [u32; 8] {
+    use openvm_stark_backend::p3_field::PrimeField32;
+    d.map(|x| x.as_canonical_u32())
+}
+
+// ---------------------------------------------------------------- FP-1 types
+/// FP-1 word types. `Addr` is 5 limbs at TOP = 63 with the top limb below 2^2.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ty {
+    Bit,
+    Tag(u8),
+    U16,
+    U32,
+    U64,
+    Addr,
+    U128,
+    Digest,
+}
+
+impl Ty {
+    pub fn words(self) -> usize {
+        match self {
+            Ty::Bit | Ty::Tag(_) | Ty::U16 => 1,
+            Ty::U32 => 2,
+            Ty::U64 => 4,
+            Ty::Addr => 5,
+            Ty::U128 | Ty::Digest => 8,
+        }
+    }
+    /// Bit width of each word (the RANGE width of the limb), `None` for a digest word.
+    pub fn limb_bits(self, i: usize) -> Option<usize> {
+        match self {
+            Ty::Bit => Some(1),
+            Ty::Tag(w) => Some(w as usize),
+            Ty::U16 | Ty::U32 | Ty::U64 | Ty::U128 => Some(16),
+            Ty::Addr => Some(if i == 4 { 2 } else { 16 }),
+            Ty::Digest => None,
+        }
+    }
+    /// The words of `v` (16-bit little-endian limbs; one word for the 1-word types).
+    pub fn enc(self, v: u128) -> Vec<F> {
+        match self {
+            Ty::Bit | Ty::Tag(_) | Ty::U16 => vec![F::from_u128(v)],
+            Ty::Digest => panic!("digest lane from an integer"),
+            t => (0..t.words()).map(|i| F::from_u64(((v >> (16 * i)) & 0xffff) as u64)).collect(),
+        }
+    }
+}
+
+/// u128 from 16-bit limbs.
+pub fn limbs_u128(v: u128, n: usize) -> Vec<F> {
+    (0..n).map(|i| F::from_u64(((v >> (16 * i)) & 0xffff) as u64)).collect()
+}
+
+// ---------------------------------------------------------------- the state body (476 words)
+use Ty::*;
+
+/// Control lanes 0..16 (T5 Appendix A, control table; `ridx = u64`: lanes 1, 9, 13, 14).
+pub const CTL: [Ty; 17] =
+    [Tag(4), U64, Addr, Addr, Addr, Addr, Addr, Addr, Addr, U64, Addr, Bit, Addr, U64, U64, Bit, Addr];
+/// Top frame lanes 0..12 (`ridx = u64`: lanes 1, 5, 8, 9, 12).
+pub const FRM: [Ty; 13] = [Tag(4), U64, Addr, Addr, Addr, U64, Addr, Addr, U64, U64, Bit, Addr, U64];
+/// Top task lanes 0..6 (`ridx = u64`: lane 1).
+pub const TSK: [Ty; 7] = [Tag(2), U64, Addr, Tag(1), Addr, Tag(1), U32];
+/// Helper lanes 0..22 (`ridx = u64`: lanes 12, 17, 19, 21).
+pub const HLP: [Ty; 23] = [
+    Tag(4), Tag(5), U128, Bit, U32, Addr, Addr, Addr, Addr, Addr, Addr, Addr, U64, Addr, U128, Addr, U128,
+    U64, Addr, U64, Tag(2), U64, Tag(2),
+];
+/// Result lanes 0..3.
+pub const RES: [Ty; 4] = [Tag(5), Addr, Addr, Addr];
+
+/// Register lanes of the image (19..46 without the outcome lanes 23..25, which O-3 moves to the
+/// header), with their types.
+pub fn reg_lanes() -> Vec<(usize, Ty)> {
+    let mut v = vec![(19, U64), (20, Bit), (21, Addr), (22, U64)];
+    for l in 26..=31 {
+        v.push((l, U128));
+    }
+    for l in 32..=45 {
+        v.push((l, Addr));
+    }
+    v.push((46, U128));
+    v
+}
+
+/// One field of the body in keyed order.
+#[derive(Clone, Debug)]
+pub struct Field {
+    pub name: String,
+    pub ty: Ty,
+    pub off: usize,
+}
+
+/// The slice body layout: control, registers, frame stack cells, task stack cells, helper,
+/// result, memory, program, fold cells (T5 section 1.6 with O-3 and O-5).
+#[derive(Clone, Debug)]
+pub struct Layout {
+    pub fields: Vec<Field>,
+    pub words: usize,
+}
+
+impl Layout {
+    pub fn new() -> Self {
+        let mut f: Vec<(String, Ty)> = vec![];
+        for (i, t) in CTL.iter().enumerate() {
+            f.push((format!("ctl.{i}"), *t));
+        }
+        for (l, t) in reg_lanes() {
+            f.push((format!("reg.{l}"), t));
+        }
+        f.push(("frm.count".into(), U64));
+        f.push(("frm.below".into(), Digest));
+        for (i, t) in FRM.iter().enumerate() {
+            f.push((format!("frm.{i}"), *t));
+        }
+        f.push(("tsk.count".into(), U64));
+        f.push(("tsk.below".into(), Digest));
+        for (i, t) in TSK.iter().enumerate() {
+            f.push((format!("tsk.{i}"), *t));
+        }
+        for (i, t) in HLP.iter().enumerate() {
+            f.push((format!("hlp.{i}"), *t));
+        }
+        for (i, t) in RES.iter().enumerate() {
+            f.push((format!("res.{i}"), *t));
+        }
+        f.push(("mem.len".into(), Addr));
+        f.push(("mem.root".into(), Digest));
+        f.push(("mem.tail".into(), Digest));
+        f.push(("prog_root".into(), Digest));
+        f.push(("prog_d".into(), Digest));
+        // O-5 fold cells (ESTIMATE types of the T5 draft).
+        f.push(("fold.cursor".into(), U32));
+        f.push(("fold.m".into(), U32));
+        f.push(("fold.acc".into(), Digest));
+        f.push(("fold.ty_d".into(), Digest));
+        f.push(("fold.c".into(), U32));
+        let mut off = 0;
+        let fields = f
+            .into_iter()
+            .map(|(name, ty)| {
+                let x = Field { name, ty, off };
+                off += ty.words();
+                x
+            })
+            .collect();
+        Layout { fields, words: off }
+    }
+    pub fn field(&self, name: &str) -> &Field {
+        self.fields.iter().find(|f| f.name == name).unwrap_or_else(|| panic!("field {name}"))
+    }
+    /// Word offset of `name`.
+    pub fn at(&self, name: &str) -> usize {
+        self.field(name).off
+    }
+    /// Word range of every field whose name starts with `prefix`.
+    pub fn span(&self, prefix: &str) -> std::ops::Range<usize> {
+        let v: Vec<&Field> = self.fields.iter().filter(|f| f.name.starts_with(prefix)).collect();
+        let a = v.first().unwrap().off;
+        let b = v.last().map(|f| f.off + f.ty.words()).unwrap();
+        a..b
+    }
+}
+
+impl Default for Layout {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+pub const BODY_WORDS: usize = 476;
+
+// ---------------------------------------------------------------- header and digests
+/// The FP-5 header words other than `body_d`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Header {
+    pub outcome_tag: F,
+    pub outcome_payload: Digest,
+    pub input_d: Digest,
+    pub deps_d: Digest,
+    pub view_root: Digest,
+}
+
+/// One persistent state: header words and the body.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct State {
+    pub hdr: Header,
+    pub body: Vec<F>,
+}
+
+pub fn body_words(body: &[F]) -> Vec<F> {
+    let mut w = vec![F::from_u32(SCHEMA_ID)];
+    w.extend_from_slice(body);
+    w
+}
+
+pub fn body_d(body: &[F]) -> Digest {
+    p2(DOM_STATE_BODY, &body_words(body))
+}
+
+pub fn header_words(h: &Header, bd: &Digest) -> Vec<F> {
+    let mut w = vec![h.outcome_tag];
+    w.extend_from_slice(&h.outcome_payload);
+    w.extend_from_slice(&h.input_d);
+    w.extend_from_slice(&h.deps_d);
+    w.extend_from_slice(&h.view_root);
+    w.extend_from_slice(bd);
+    w
+}
+
+impl State {
+    pub fn body_d(&self) -> Digest {
+        body_d(&self.body)
+    }
+    pub fn state_d(&self) -> Digest {
+        p2(SHK_SD2, &header_words(&self.hdr, &self.body_d()))
+    }
+}
+
+/// Tag-only constants (FP-4 "Constants").
+pub fn d_empty() -> Digest {
+    p2(TAG_EMPTY, &[])
+}
+pub fn empty_deps() -> Digest {
+    p2(SHK_DEPS, &[])
+}
+pub fn view_none() -> Digest {
+    p2(SHK_VIEW, &[])
+}
+pub fn val_none() -> Digest {
+    p2(SHK_VALUE_V2, &[])
+}
+/// PICK (ENC-4 open): the empty frame and task stack heads are the tag-only hashes of the
+/// FrameChain (37) and TaskChain (38) codes.
+pub fn empty_frames() -> Digest {
+    p2(DOM_FRAMES, &[])
+}
+pub fn empty_tasks() -> Digest {
+    p2(DOM_TASKS, &[])
+}
+/// PICK (INIT-004 empty arena): genesis memory root and tail are `D_EMPTY`.
+pub fn mem_root0() -> Digest {
+    d_empty()
+}
+pub fn mem_tail0() -> Digest {
+    d_empty()
+}
+/// PICK (ENC-5 open): the plan digest of a program with no plan nodes is `P2(DOM_PLAN)`.
+pub fn plan_d_empty() -> Digest {
+    p2(DOM_PLAN, &[])
+}
+
+/// INIT witness: the program image and the input (FP-4 rows `image_d`, `prog_d`, `input_d`).
+#[derive(Clone, Debug)]
+pub struct Admission {
+    pub prog_root: Digest,
+    pub layout_version: u32,
+    pub profile_id: u32,
+    pub entry_kind: u32,
+    pub entry_a: u64,
+    pub in_ty: Digest,
+    pub plan_d: Digest,
+    pub key_root: Digest,
+    pub machine_version: u32,
+    pub salt: [u32; 8],
+    pub val_d: Digest,
+    pub fuel: u128,
+    pub stack_limit: u64,
+}
+
+impl Admission {
+    pub fn image_words(&self) -> Vec<F> {
+        let mut w = self.prog_root.to_vec();
+        w.push(F::from_u32(self.layout_version));
+        w.push(F::from_u32(self.profile_id));
+        w.push(F::from_u32(self.entry_kind));
+        w.extend(limbs_u128(self.entry_a as u128, 4));
+        w.extend_from_slice(&self.in_ty);
+        w
+    }
+    pub fn image_d(&self) -> Digest {
+        p2(SHK_IMAGE, &self.image_words())
+    }
+    pub fn prog_words(&self) -> Vec<F> {
+        let mut w = self.image_d().to_vec();
+        w.extend_from_slice(&self.plan_d);
+        w.extend_from_slice(&self.key_root);
+        w.push(F::from_u32(self.machine_version));
+        w
+    }
+    pub fn prog_d(&self) -> Digest {
+        p2(DOM_PROG, &self.prog_words())
+    }
+    pub fn input_words(&self) -> Vec<F> {
+        let mut w: Vec<F> = self.salt.iter().map(|&x| F::from_u32(x)).collect();
+        w.extend_from_slice(&self.val_d);
+        w.extend(limbs_u128(self.fuel & u64::MAX as u128, 4));
+        w.extend(limbs_u128(self.fuel >> 64, 4));
+        w.extend(limbs_u128(self.stack_limit as u128, 4));
+        w
+    }
+    pub fn input_d(&self) -> Digest {
+        p2(SHK_IN, &self.input_words())
+    }
+}
+
+// ---------------------------------------------------------------- ROM rows and tree
+/// ROM row width `W_rom` (FP-9.2).
+pub const W_ROM: usize = 33;
+/// ROM tree depth over `(tbl, row)`: `D_tbl` 5 + `D_row` 64 (PICK: a binary sparse tree keyed by
+/// `tbl * 2^64 + row`, leaf level 0 is bit 0 of `row`).
+pub const ROM_DEPTH: usize = 69;
+
+/// One ROM row: table, row index and the 33 row words.
+#[derive(Clone, Debug)]
+pub struct RomRow {
+    pub tbl: u32,
+    pub row: u64,
+    pub rec: [F; W_ROM],
+}
+
+impl RomRow {
+    pub fn leaf(&self) -> Digest {
+        let mut w = vec![F::from_u32(self.tbl)];
+        w.extend_from_slice(&self.rec);
+        p2(DOM_ROMLEAF, &w)
+    }
+    pub fn key(&self) -> u128 {
+        ((self.tbl as u128) << 64) | self.row as u128
+    }
+}
+
+/// PICK: the empty subtree digests: level 0 `D_EMPTY`, level `k + 1` `P2(DOM_ROMNODE, e_k, e_k)`.
+pub fn rom_empty() -> Vec<Digest> {
+    let mut e = vec![d_empty()];
+    for k in 0..ROM_DEPTH {
+        let mut w = e[k].to_vec();
+        w.extend_from_slice(&e[k]);
+        e.push(p2(DOM_ROMNODE, &w));
+    }
+    e
+}
+
+pub fn node(l: &Digest, r: &Digest) -> Digest {
+    let mut w = l.to_vec();
+    w.extend_from_slice(r);
+    p2(DOM_ROMNODE, &w)
+}
+
+/// The ROM tree over `rows`: root and, for each row, its sibling path (leaf level first).
+pub fn rom_tree(rows: &[RomRow]) -> (Digest, Vec<Vec<Digest>>) {
+    use std::collections::BTreeMap;
+    let e = rom_empty();
+    let mut lvl: BTreeMap<u128, Digest> = rows.iter().map(|r| (r.key(), r.leaf())).collect();
+    let mut paths: Vec<Vec<Digest>> = vec![vec![]; rows.len()];
+    let mut keys: Vec<u128> = rows.iter().map(|r| r.key()).collect();
+    for k in 0..ROM_DEPTH {
+        for (i, key) in keys.iter().enumerate() {
+            let sib = lvl.get(&(key ^ 1)).copied().unwrap_or(e[k]);
+            paths[i].push(sib);
+        }
+        let mut up: BTreeMap<u128, Digest> = BTreeMap::new();
+        for (&key, d) in &lvl {
+            let p = key >> 1;
+            if up.contains_key(&p) {
+                continue;
+            }
+            let (l, r) = if key & 1 == 0 {
+                (*d, lvl.get(&(key | 1)).copied().unwrap_or(e[k]))
+            } else {
+                (lvl.get(&(key & !1)).copied().unwrap_or(e[k]), *d)
+            };
+            up.insert(p, node(&l, &r));
+        }
+        lvl = up;
+        for key in keys.iter_mut() {
+            *key >>= 1;
+        }
+    }
+    (*lvl.values().next().unwrap_or(&e[ROM_DEPTH]), paths)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn layout_is_476_words() {
+        assert_eq!(Layout::new().words, BODY_WORDS);
+    }
+
+    #[test]
+    fn rom_path_recomputes_root() {
+        let rec = |k: u32| std::array::from_fn(|i| F::from_u32(if i == 0 { k } else { 0 }));
+        let rows = vec![
+            RomRow { tbl: 0, row: 0, rec: rec(1) },
+            RomRow { tbl: 0, row: 1, rec: rec(2) },
+            RomRow { tbl: 21, row: 0, rec: rec(3) },
+        ];
+        let (root, paths) = rom_tree(&rows);
+        for (r, p) in rows.iter().zip(&paths) {
+            let mut cur = r.leaf();
+            for (k, sib) in p.iter().enumerate() {
+                cur = if (r.key() >> k) & 1 == 0 { node(&cur, sib) } else { node(sib, &cur) };
+            }
+            assert_eq!(cur, root);
+        }
+    }
+}
