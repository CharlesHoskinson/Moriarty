+// ------------------------------------------------------------------ the slice app
+/// The slice app key (`sherlock_leaf::harness::key`: every AIR required, SG-1; inside the app
+/// set, SG-4), with its record in `log`.
+fn app_key(log: &mut Vec<Value>) -> (sh::Eng, sh::Keyed) {
+    let eng = sh::engine();
+    let k = sh::key(&eng, sl::airs(0)).expect("slice app key (SG-1, SG-4)");
+    let mut v = vk_json(&k.vk);
+    v["key"] = json!("app (slice leaf shard)");
+    v["set"] = json!(frozen::APP.name);
+    v["g1"] = json!("accepted");
+    v["per_air"] = k.shape["per_air"].clone();
+    log.push(v);
+    (eng, k)
+}
+
+/// The traces of the V.1 run under `key_root`, one shard per entry.
+fn slice_traces(kr: &[F; 8]) -> Vec<Vec<sh::Tr>> {
+    let p = sl::program(*kr);
+    sl::shards(&p).iter().map(|s| sl::traces(&p, s, &sl::Build::default())).collect()
+}
+
+/// The proving context of the app traces, leaving out AIR `skip`.
+fn app_ctx(eng: &sh::Eng, trs: &[sh::Tr], skip: Option<usize>) -> ProvingContext<CpuBackend<NodeSC>> {
+    ProvingContext::new(
+        trs.iter()
+            .enumerate()
+            .filter(|(i, _)| Some(*i) != skip)
+            .map(|(i, t)| {
+                let cm = ColMajorMatrix::from_row_major(&t.m);
+                (i, AirProvingContext::simple(eng.device().transport_matrix_to_device(&cm), t.pvs.clone()))
+            })
+            .collect(),
+    )
+}
+
+/// Statement words of a slice app proof (CORE public values) for the run record.
+fn statement(p: &Proof<NodeSC>) -> Value {
+    let v = &p.public_values[keybind::APP_PV_AIR];
+    let w = |a: usize, n: usize| v[a..a + n].iter().map(|x| x.as_canonical_u32()).collect::<Vec<_>>();
+    use slice_core::pv;
+    json!({"prog_d": w(pv::PROG_D, 8), "pre_d": w(pv::PRE_D, 8), "post_d": w(pv::POST_D, 8),
+        "rules_d": w(pv::RULES_D, 8), "h_pre": w(pv::H_PRE, 4), "steps": w(pv::STEPS, 1)})
+}
+
+/// Every trace height of `p` equals the keyed fixed height of the shard shape.
+fn fixed_heights(k: &sh::Keyed, p: &Proof<NodeSC>) -> (bool, Vec<Option<usize>>) {
+    let want: Vec<Option<usize>> = sl::HEIGHTS.iter().map(|h| Some(h.trailing_zeros() as usize)).collect();
+    let got = heights(p);
+    (k.airs.len() == want.len() && want == got, got)
+}
