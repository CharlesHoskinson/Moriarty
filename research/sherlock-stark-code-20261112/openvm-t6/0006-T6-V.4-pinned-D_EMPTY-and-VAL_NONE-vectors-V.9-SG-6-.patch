@@ -0,0 +1,97 @@
+//! T6 SG-6: seconds per proved step of the slice leaf shard on the GPU (`--features cuda`,
+//! `BabyBearPoseidon2GpuEngine`) and on the CPU, same frozen app set, same AIRs, same traces.
+//! Each engine keys the shard with every AIR required, proves both shards of the V.1 run
+//! `T6_REPS` times (default 4; rep 0 is the warm-up, the median is over the rest), and the stock
+//! CPU verifier accepts the first proof of each shard. Writes `$T6_OUT/sg6.json`.
+//!
+//! usage: cargo run --release -p sherlock-leaf [--features cuda] --example sg6
+
+use std::time::Instant;
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    p3_field::{PrimeCharacteristicRing, PrimeField32},
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    StarkEngine,
+};
+use serde_json::{json, Value};
+use sherlock_leaf::{
+    core::pv,
+    enc::{p2, F},
+    harness::{self, SC},
+    leaf::{self, airs, Build},
+};
+use sherlock_lfr::frozen;
+
+fn median(v: &[f64]) -> f64 {
+    let mut s = v.to_vec();
+    s.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    s[s.len() / 2]
+}
+
+fn run<E: StarkEngine<SC = SC>>(label: &str, cpu_vk: &MultiStarkVerifyingKey<SC>) -> Value {
+    let reps: usize = std::env::var("T6_REPS").ok().and_then(|v| v.parse().ok()).unwrap_or(4);
+    let engine = E::new(frozen::APP.params());
+    let a = airs(0);
+    let t = Instant::now();
+    let (pk, vk) = frozen::keygen_required(&engine, &a);
+    let keygen_s = t.elapsed().as_secs_f64();
+    assert_eq!(vk.pre_hash, cpu_vk.pre_hash, "{label}: the engine keys the same app vk");
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let p = leaf::program(p2(10, &[F::from_u32(0x7_1e_af)]));
+    let shards = leaf::shards(&p);
+    let cpu = harness::engine();
+    let mut out = vec![];
+    let mut total_med = 0.0;
+    let mut steps = 0u32;
+    for (si, sh) in shards.iter().enumerate() {
+        let trs = leaf::traces(&p, sh, &Build::default());
+        let cm: Vec<(ColMajorMatrix<F>, Vec<F>)> = trs.iter().map(|t| (ColMajorMatrix::from_row_major(&t.m), t.pvs.clone())).collect();
+        let mut prove_s = vec![];
+        let mut transport_s = vec![];
+        let mut verified = false;
+        for rep in 0..reps {
+            let t = Instant::now();
+            let ctx = ProvingContext::new(
+                cm.iter()
+                    .enumerate()
+                    .map(|(i, (m, pvs))| (i, AirProvingContext::simple(engine.device().transport_matrix_to_device(m), pvs.clone())))
+                    .collect(),
+            );
+            transport_s.push(t.elapsed().as_secs_f64());
+            let t = Instant::now();
+            let proof = engine.prove(&d_pk, ctx).expect("prove");
+            prove_s.push(t.elapsed().as_secs_f64());
+            if rep == 0 {
+                cpu.verify(cpu_vk, &proof).unwrap_or_else(|e| panic!("{label} shard {si}: stock CPU verifier: {e:?}"));
+                verified = true;
+                steps += proof.public_values[0][pv::STEPS].as_canonical_u32();
+            }
+        }
+        let timed = if prove_s.len() > 1 { &prove_s[1..] } else { &prove_s[..] };
+        let med = median(timed);
+        total_med += med;
+        out.push(json!({"shard": si, "prove_s": prove_s, "transport_s": transport_s, "median_s": med, "stock_cpu_verifier": verified}));
+    }
+    json!({"backend": label, "keygen_s": keygen_s, "shards": out, "proved_steps": steps,
+        "slots": shards.len() * sherlock_leaf::core::S,
+        "s_per_proved_step": total_med / steps as f64,
+        "s_per_slot": total_med / (shards.len() * sherlock_leaf::core::S) as f64})
+}
+
+fn main() {
+    let cpu = harness::engine();
+    let k = harness::key(&cpu, airs(0)).expect("slice app key");
+    let mut rows = vec![run::<harness::Eng>("CPU (openvm-cpu-backend)", &k.vk)];
+    #[cfg(feature = "cuda")]
+    rows.push(run::<openvm_cuda_backend::BabyBearPoseidon2GpuEngine>("GPU (openvm-cuda-backend)", &k.vk));
+    let gpu = rows.iter().any(|r| r["backend"].as_str().unwrap().starts_with("GPU"));
+    for r in &rows {
+        println!("SG6 {} s_per_proved_step {:.4} s_per_slot {:.4}", r["backend"], r["s_per_proved_step"].as_f64().unwrap(), r["s_per_slot"].as_f64().unwrap());
+    }
+    let v = json!({"task": "V.9 SG-6", "shape": k.shape, "rows": rows, "gpu": gpu});
+    let dir = std::env::var("T6_OUT").unwrap_or_else(|_| format!("{}/.cache/t6/out", std::env::var("HOME").unwrap()));
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(format!("{dir}/sg6.json"), serde_json::to_string_pretty(&v).unwrap()).unwrap();
+    println!("SG6 gpu={gpu}");
+}
