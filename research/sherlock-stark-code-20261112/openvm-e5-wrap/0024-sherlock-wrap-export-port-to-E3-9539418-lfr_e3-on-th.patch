+/// The verdict of the stock lane-map step alone on the words `w` (lanes, pairs, entry offsets).
+fn lane_map_ok(d: &Dims, w: &[u64]) -> bool {
+    let lanes: Vec<Fr> = (0..d.lanes())
+        .map(|i| iface::dec(&w[d.call_at() + LIMBS * i..][..LIMBS]).unwrap())
+        .collect();
+    let vs: Vec<Fr> = (0..d.v)
+        .map(|j| iface::dec(&w[d.values_at() + LIMBS * j..][..LIMBS]).unwrap())
+        .collect();
+    let mut off = 0;
+    let offs: Vec<(u64, u64, usize)> = (0..d.b)
+        .map(|i| {
+            let (op, param) = (w[STMT + 2 * i], w[STMT + 2 * i + 1]);
+            let o = off;
+            off += iface::vals(op, param);
+            (op, param, o)
+        })
+        .collect();
+    let pairs: Vec<(u64, u64)> = (0..LANE_PAIRS)
+        .map(|k| (w[LANE_MAP + 2 * k], w[LANE_MAP + 2 * k + 1]))
+        .collect();
+    iface::apply_lane_map(lanes, &pairs, &offs, &vs).is_ok()
+}
+
+/// Value offsets of the entries.
+fn offsets(d: &Dims, w: &[u64]) -> Vec<usize> {
+    let mut off = 0;
+    (0..d.b)
+        .map(|i| {
+            let o = off;
+            off += iface::vals(w[STMT + 2 * i], w[STMT + 2 * i + 1]);
+            o
+        })
+        .collect()
+}
+
 fn decode_cases(d: &Dims, pw: &[Fr]) -> Value {
     let n = d.words();
     let w = unpack_words(pw, n);
@@ -127,6 +167,110 @@ fn decode_cases(d: &Dims, pw: &[Fr]) -> Value {
     let mut t = w.clone();
     t[LANE_MAP + 1] = pub_i as u64;
     cases.push(case("lane_map_not_digest", d, repack(pre, &t)));
+    // 9539418: R, the anchor rule, the claim_pub inputs and the native replay.
+    let offs = offsets(d, &w);
+    let val_at = |j: usize| d.values_at() + LIMBS * j;
+    let mut t = w.clone();
+    t[MODE_WORD] = 2;
+    cases.push(case("mode_2", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[J_WORDS] = 1 << 16;
+    cases.push(case("jk_not_u16", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[MODE_WORD] = 1; // a chunk with j = 0
+    cases.push(case("chunk_j_0", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[E_IN_WORD] = 5;
+    cases.push(case("anchor_word_e_in", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[STMT + 1] = 1; // entry 0 DIGEST(LOCK), not DIGEST(PROGC)
+    cases.push(case("r_entry_0_tag", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[val_at(6)] ^= 1; // first SPONGE(3) input is not the PROGC output
+    cases.push(case("claim_pub_input_changed", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[val_at(11)] ^= 1; // output of entry 4 (the a_in anchor DIGEST), mapped to LANE_A_IN
+    cases.push(case("r_anchor_output_changed", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[val_at(9)] ^= 1; // output of entry 3, SPONGE(3), mapped to the claim_pub lanes
+    cases.push(case("r_sponge3_output_changed", d, repack(pre, &t)));
+    // The all-entries log is R then PUB entries. A tail of other ops: the last 14 PUB entries
+    // (14 values) become PERM, SPONGE(5), DIGEST(SHK_REG) (6 + 6 + 2 values), honest replays,
+    // then NOPs. Their lanes are no longer read by a PUB; the decode stays ok.
+    let n_ent = (0..d.b).filter(|&i| w[STMT + 2 * i] != NOP).count();
+    let first = n_ent - 14;
+    assert!((first..n_ent).all(|i| w[STMT + 2 * i] == PUB));
+    let mut tb = w.clone();
+    let x = |k: u64| Fr::from_u64(0x7a11 + k);
+    let pin = [x(1), x(2), x(3)];
+    let pout = iface::perm(pin);
+    let sin: Vec<Fr> = (4..9).map(x).collect();
+    let sout = iface::sponge_u(0, &sin);
+    let dx = x(9);
+    let dout = iface::digest(4, dx);
+    let mut vals: Vec<Fr> = pin.to_vec();
+    vals.extend(pout);
+    vals.extend(&sin);
+    vals.push(sout);
+    vals.extend([dx, dout]);
+    assert_eq!(vals.len(), 14);
+    let o0 = offs[first];
+    for (k, v) in vals.iter().enumerate() {
+        tb[val_at(o0 + k)..][..LIMBS].copy_from_slice(&iface::limbs(*v));
+    }
+    let tail = [(PERM, 0u64), (SPONGE, 5), (DIGEST, 4)];
+    for i in first..n_ent {
+        let (op, param) = tail.get(i - first).copied().unwrap_or((NOP, 0));
+        tb[STMT + 2 * i] = op;
+        tb[STMT + 2 * i + 1] = param;
+    }
+    let (e_perm, e_sp5, e_dig) = (first, first + 1, first + 2);
+    let tail_case = |name: &str, t: &[u64]| {
+        let mut c = case(name, d, repack(pre, t));
+        c["tail"] = json!([e_perm, e_sp5, e_dig]);
+        c
+    };
+    cases.push(tail_case("tail_honest", &tb));
+    // Native replay outside R and outside the lane map: stock refuses; the wrap does not replay
+    // these entries (open item, E3 J6 in the wrap).
+    for (name, at) in [("open_replay_perm", o0 + 5), ("open_replay_sponge", o0 + 11), ("open_replay_digest", o0 + 13)] {
+        let mut t = tb.clone();
+        t[val_at(at)] ^= 1;
+        cases.push(tail_case(name, &t));
+    }
+    // Lane map at 9539418: DIGEST or SPONGE(3) only.
+    let mut t = tb.clone();
+    t[LANE_MAP + 1] = e_sp5 as u64;
+    cases.push(tail_case("lane_map_sponge_not_3", &t));
+    let mut t = tb.clone();
+    t[LANE_MAP + 1] = e_perm as u64;
+    cases.push(tail_case("lane_map_perm", &t));
+    // A mapped DIGEST outside R (tag SHK_REG): accepted; its output is the lane; replayed.
+    let mut t = tb.clone();
+    t[LANE_MAP + 1] = e_dig as u64;
+    cases.push(tail_case("lane_map_digest_reg", &t));
+    t[val_at(o0 + 13)] ^= 1;
+    cases.push(tail_case("lane_map_digest_reg_output_changed", &t));
+    let mut t = w.clone();
+    t[LANE_MAP] = (1 << 16) + LANE_A_IN;
+    cases.push(case("lane_map_not_u16", d, repack(pre, &t)));
+    let mut t = w.clone();
+    t[LANE_MAP + 2] = LANE_A_IN; // pair 1 writes lane LANE_A_IN again (nonzero output)
+    cases.push(case("lane_map_twice", d, repack(pre, &t)));
+    // A lane mapped twice whose first output is 0 (lane e3-lanemap finding 2a). The whole
+    // decoder refuses at the replay of entry 4; the lane-map step alone refuses the second pair.
+    let mut t = w.clone();
+    for k in 0..LIMBS {
+        t[val_at(11) + k] = 0;
+    }
+    t[LANE_MAP + 2] = LANE_A_IN;
+    let mut c = case("lane_map_twice_zero_output", d, repack(pre, &t));
+    c["lane_map_ok"] = json!(lane_map_ok(d, &t));
+    assert_eq!(c["lane_map_ok"], json!(false));
+    let mut t0 = t.clone();
+    t0[LANE_MAP + 2] = w[LANE_MAP + 2];
+    assert!(lane_map_ok(d, &t0), "the same words with one pair per lane pass the lane-map step");
+    cases.push(c);
     let mut hi = pw.to_vec();
     hi[3] += fr_of(&(BigUint::from(1u32) << 250));
     cases.push(case("packed_high_bits", d, hi));
@@ -142,7 +286,7 @@ fn main() {
         format!("{}/.cache/e5-wrap/fixtures", std::env::var("HOME").unwrap())
     }));
     let fx = PathBuf::from(std::env::var("E3_FIXTURE_DIR").unwrap_or_else(|_| {
-        format!("{}/.cache/e3-iface/fixture", std::env::var("HOME").unwrap())
