     let pre = Fr::from_u64(0xe5c0de);
     let honest = pack(pre, &w);
-    let s = iface::decode(&d, &honest).expect("honest ENC vector decodes");
+    assert_eq!(iface::decode(&d, &honest), Err("R entry 1".to_string()), "the ENC-2 log is not an R log");
+    let s = lane_map_step(&d, &honest).unwrap().expect("the honest lane map applies");
     let c_p = iface::dec(&encs[0][11..20]).unwrap();
     let input_pub = iface::dec(&encs[5][11..20]).unwrap();
     assert_eq!(s[2], c_p);
