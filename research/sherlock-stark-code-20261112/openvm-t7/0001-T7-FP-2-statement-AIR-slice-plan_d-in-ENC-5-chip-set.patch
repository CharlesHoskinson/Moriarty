+// ---------------------------------------------------------------- Rust reference
+/// `P2(tag, xs)` of FP-4 (overwrite absorption, the length `1 + |xs|` in the first capacity word).
+pub fn p2(tag: u32, xs: &[F]) -> Digest {
+    let mut w = vec![F::from_u32(tag)];
+    w.extend_from_slice(xs);
+    let mut st = [F::ZERO; 16];
+    st[8] = F::from_usize(w.len());
+    for b in w.chunks(8) {
+        for i in 0..8 {
+            st[i] = if i < b.len() { b[i] } else { F::ZERO };
+        }
+        poseidon2_perm().permute_mut(&mut st);
+    }
+    st[..8].try_into().unwrap()
+}
+
+pub fn cat(xs: &[&[F]]) -> Vec<F> {
+    xs.iter().flat_map(|x| x.iter().copied()).collect()
+}
+
+pub fn d_empty() -> Digest {
+    p2(TAG_EMPTY, &[])
+}
+pub fn empty_deps() -> Digest {
+    p2(SHK_DEPS, &[])
+}
+
+/// A key commitment as a parent sees it: the commitment of the cached DAG trace in the layer
+/// that verifies the key, and the key pre-hash.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct Vkc {
+    pub cc: Digest,
+    pub pre: Digest,
+}
+
+impl Vkc {
+    pub fn words(&self) -> Vec<F> {
+        cat(&[&self.cc, &self.pre])
+    }
+}
+
+/// The `key_root` leaf of one chip set (T7 LEAD: the O10 leaf `P2(DOM_KEYTRIPLE, set_id, pre_app,
+/// pre_leaf, pre_ifl)` with the cached halves `cc_app` (the app DAG in the leaf layer) and
+/// `cc_leaf` (the leaf-layer DAG in N1) appended; 42 words with the tag).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct KeyTriple {
+    pub set_id: u32,
+    pub pre_app: Digest,
+    pub pre_leaf: Digest,
+    pub pre_ifl: Digest,
+    pub cc_app: Digest,
+    pub cc_leaf: Digest,
+}
+
+impl KeyTriple {
+    pub fn words(&self) -> Vec<F> {
+        let mut w = vec![F::from_u32(self.set_id)];
+        w.extend(cat(&[&self.pre_app, &self.pre_leaf, &self.pre_ifl, &self.cc_app, &self.cc_leaf]));
+        w
+    }
+    pub fn leaf(&self) -> Digest {
+        p2(DOM_KEYTRIPLE, &self.words())
+    }
+}
+
+pub fn key_node(l: &Digest, r: &Digest) -> Digest {
+    p2(DOM_KEYNODE, &cat(&[l, r]))
+}
+
+/// The O10 key tree: binary, `P2(DOM_KEYNODE, l, r)` nodes, leaves padded with `P2(TAG_EMPTY)`
+/// to a power of two of at least 2. Depth at most `D_KEY`.
+pub struct KeyTree {
+    pub leaves: Vec<Digest>,
+}
+
+impl KeyTree {
+    fn padded(&self) -> Vec<Digest> {
+        let n = self.leaves.len().next_power_of_two().max(2);
+        assert!(n <= 1 << D_KEY);
+        let mut v = self.leaves.clone();
+        v.resize(n, p2(TAG_EMPTY, &[]));
+        v
+    }
+    pub fn root(&self) -> Digest {
+        let mut lv = self.padded();
+        while lv.len() > 1 {
+            lv = lv.chunks(2).map(|c| key_node(&c[0], &c[1])).collect();
+        }
+        lv[0]
+    }
+    /// Path of leaf `i`: `(bit, sibling)` per level, leaf level first (`bit` 1: the node is the
+    /// right child).
+    pub fn path(&self, i: usize) -> Vec<(bool, Digest)> {
+        let mut lv = self.padded();
+        let mut idx = i;
+        let mut out = vec![];
+        while lv.len() > 1 {
+            out.push((idx & 1 == 1, lv[idx ^ 1]));
+            lv = lv.chunks(2).map(|c| key_node(&c[0], &c[1])).collect();
+            idx >>= 1;
+        }
+        out
+    }
+}
+
+pub fn path_root(leaf: &Digest, path: &[(bool, Digest)]) -> Digest {
+    path.iter().fold(*leaf, |cur, (b, s)| if *b { key_node(s, &cur) } else { key_node(&cur, s) })
+}
+
+/// The universal key table under `keys_d` (T7 LEAD): 4 node rows and 4 foreign (FV unit) rows of
+/// `(cc, pre)`; an unused row is zero.
+#[derive(Clone, Debug, PartialEq, Eq, Default)]
+pub struct UKeys {
+    pub node: Vec<Vkc>,
+    pub foreign: Vec<Vkc>,
+}
+
+impl UKeys {
+    pub fn rows(&self) -> Vec<Vkc> {
+        assert!(self.node.len() <= UROWS && self.foreign.len() <= UROWS);
+        let mut v = self.node.clone();
+        v.resize(UROWS, Vkc::default());
+        let mut f = self.foreign.clone();
+        f.resize(UROWS, Vkc::default());
+        v.extend(f);
+        v
+    }
+    pub fn half(rows: &[Vkc]) -> Digest {
+        p2(DOM_UKEYS, &rows.iter().flat_map(|r| r.words()).collect::<Vec<_>>())
+    }
+    pub fn keys_d(&self) -> Digest {
+        let r = self.rows();
+        p2(DOM_UKEYS, &cat(&[&Self::half(&r[..UROWS]), &Self::half(&r[UROWS..])]))
+    }
+    /// Index (into [`Self::rows`]) of `v` among the node rows (`foreign` false) or the foreign
+    /// rows.
+    pub fn index(&self, v: &Vkc, foreign: bool) -> Option<usize> {
+        let r = self.rows();
+        let (a, b) = if foreign { (UROWS, 2 * UROWS) } else { (0, UROWS) };
+        (a..b).find(|&i| r[i] == *v && *v != Vkc::default())
+    }
+}
+
+/// FP-2 log merge with the neutral `(D_EMPTY, 0)`.
+pub fn log_merge(a: (Digest, u32), b: (Digest, u32)) -> (Digest, u32) {
+    if a.1 == 0 {
+        b
+    } else if b.1 == 0 {
+        a
+    } else {
+        (p2(TAG_NODE, &cat(&[&a.0, &b.0])), a.1 + b.1)
+    }
+}
+
+fn u(x: F) -> u64 {
+    x.as_canonical_u32() as u64
+}
+
+/// `h_pre + steps` as 4 limbs of 16 bits (and the carries).
+pub fn h_hi(h_pre: &[F], steps: F) -> ([F; 4], [F; 4]) {
+    let mut lim = [F::ZERO; 4];
+    let mut cry = [F::ZERO; 4];
+    let mut c = u(steps);
+    for i in 0..4 {
+        let s = u(h_pre[i]) + c;
+        lim[i] = F::from_u64(s & 0xffff);
+        c = s >> 16;
+        cry[i] = F::from_u64(c);
+    }
+    assert_eq!(c, 0, "h_pre + steps wraps 2^64");
+    (lim, cry)
+}
+
+/// The SEG envelope of a LEAF child (74 words; `keys_d` given by the caller).
+pub fn seg_of_leaf(lv: &[F], key_root: &Digest, keys_d: &Digest) -> Vec<F> {
+    assert_eq!(lv.len(), lpv::N);
+    let mut w = vec![F::ZERO; npv::ENV];
+    w[npv::TAG] = F::from_u32(STMT_SEG);
+    w[npv::PROG_D..npv::PROG_D + D].copy_from_slice(&lv[lpv::PROG_D..lpv::PROG_D + D]);
+    w[npv::PRE_D..npv::PRE_D + D].copy_from_slice(&lv[lpv::PRE_D..lpv::PRE_D + D]);
+    w[npv::POST_D..npv::POST_D + D].copy_from_slice(&lv[lpv::POST_D..lpv::POST_D + D]);
+    w[npv::H_LO..npv::H_LO + 4].copy_from_slice(&lv[lpv::H_PRE..lpv::H_PRE + 4]);
+    let (hh, _) = h_hi(&lv[lpv::H_PRE..lpv::H_PRE + 4], lv[lpv::STEPS]);
+    w[npv::H_HI..npv::H_HI + 4].copy_from_slice(&hh);
+    w[npv::KEY_ROOT..npv::KEY_ROOT + D].copy_from_slice(key_root);
+    w[npv::LOG_D..npv::LOG_D + D].copy_from_slice(&lv[lpv::LOG_D..lpv::LOG_D + D]);
+    w[npv::LOG_N] = lv[lpv::LOG_N];
+    w[npv::KEYS_D..npv::KEYS_D + D].copy_from_slice(keys_d);
+    w
+}
+
+/// The node relation on two envelopes (slot 1 `None`: disabled). `Err` names the broken rule.
+pub fn merge(s0: &[F], s1: Option<&[F]>) -> Result<Vec<F>, String> {
+    let Some(s1) = s1 else { return Ok(s0[..npv::ENV].to_vec()) };
+    let r = |s: &[F], a: usize, n: usize| s[a..a + n].to_vec();
+    let seg = F::from_u32(STMT_SEG);
+    if s0[npv::TAG] != seg || s1[npv::TAG] != seg {
+        return Err("merge: a slot is not SEG".into());
+    }
+    for (name, a, n) in [
+        ("prog_d", npv::PROG_D, D),
+        ("key_root", npv::KEY_ROOT, D),
+        ("reg_root", npv::REG_ROOT, D),
+        ("shape_d", npv::SHAPE_D, D),
+        ("keys_d", npv::KEYS_D, D),
+    ] {
+        if r(s0, a, n) != r(s1, a, n) {
+            return Err(format!("merge: {name} differs"));
+        }
+    }
+    if r(s0, npv::POST_D, D) != r(s1, npv::PRE_D, D) {
+        return Err("merge: post_d of slot 0 is not pre_d of slot 1".into());
+    }
+    if r(s0, npv::H_HI, 4) != r(s1, npv::H_LO, 4) {
+        return Err("merge: h_hi of slot 0 is not h_lo of slot 1".into());
+    }
+    let mut o = s0[..npv::ENV].to_vec();
+    o[npv::POST_D..npv::POST_D + D].copy_from_slice(&s1[npv::POST_D..npv::POST_D + D]);
+    o[npv::H_HI..npv::H_HI + 4].copy_from_slice(&s1[npv::H_HI..npv::H_HI + 4]);
+    let d = |s: &[F]| -> (Digest, u32) {
+        (s[npv::LOG_D..npv::LOG_D + D].try_into().unwrap(), s[npv::LOG_N].as_canonical_u32())
+    };
+    let (ld, ln) = log_merge(d(s0), d(s1));
+    o[npv::LOG_D..npv::LOG_D + D].copy_from_slice(&ld);
+    o[npv::LOG_N] = F::from_u32(ln);
+    Ok(o)
+}
+
+/// `outcome_d` from the header's `outcome_tag` (1 Halted, 2 Rejected, 3 Exhausted; kind = tag - 1,
+/// T7 PICK from the reference machine lane 23) and payload (FP-4).
+pub fn outcome_d(tag: F, payload: &[F]) -> Digest {
+    let mut w = vec![F::from_u32(2), tag - F::ONE];
+    w.extend_from_slice(payload);
+    p2(SHK_OUTCOME_V2, &w)
+}
+
+/// The three `R` operand digests of a SEG root (FP-3 fact 1 check (i)): `P2(DOM_PROGC, r_P,
+/// prog_d)`, `input_d`, `P2(DOM_OUTHIDE, input_d, outcome_d)`, from the opened header `hdr`
+/// (`outcome_tag, payload 8, input_d 8, deps_d 8, view_root 8, body_d 8`).
+pub fn operands(prog_d: &Digest, r_p: &Digest, hdr: &[F]) -> [Digest; 3] {
+    assert_eq!(hdr.len(), HDR);
+    let input_d: Digest = hdr[9..17].try_into().unwrap();
+    let od = outcome_d(hdr[0], &hdr[1..9]);
+    [p2(DOM_PROGC, &cat(&[r_p, prog_d])), input_d, p2(DOM_OUTHIDE, &cat(&[&input_d, &od]))]
+}
+
+// ---------------------------------------------------------------- the sponge
+/// One `P2` call of a requester: sequence number, tag, words.
+#[derive(Clone, Debug)]
+pub struct Call {
+    pub seq: u32,
+    pub tag: u32,
+    pub words: Vec<F>,
+}
+
+fn blocks(tag: u32, words: &[F]) -> (usize, Vec<[F; 8]>) {
+    let mut w = vec![F::from_u32(tag)];
+    w.extend_from_slice(words);
+    let b = w.chunks(8).map(|c| std::array::from_fn(|i| if i < c.len() { c[i] } else { F::ZERO })).collect();
+    (w.len(), b)
+}
+
+/// Columns of [`PermSpongeAir`]: `act`, `first`, `last`, `seq`, `blk`, `len`, `in[16]`, `out[16]`.
+const S_ACT: usize = 0;
+const S_FIRST: usize = 1;
+const S_LAST: usize = 2;
+const S_SEQ: usize = 3;
+const S_BLK: usize = 4;
+const S_LEN: usize = 5;
+const S_IN: usize = 6;
+const S_OUT: usize = 22;
+const S_W: usize = 38;
+
+/// The sponge of the statement AIRs: one permutation per row, looked up on the verifier
+/// sub-circuit's Poseidon2 permute bus. Rows of one call are consecutive; the first row starts
+/// the state `[b_0, len, 0..]`, a later row overwrites the rate and keeps the capacity, the last
+/// row sends the digest. A requester sends `(seq, blk, len, b[8])` per block on [`PORT_IN`] and
+/// receives `(seq, h[8])` on [`PORT_OUT`] (the slice HASH ports, HSH-003).
+pub struct PermSpongeAir {
+    pub perm: Poseidon2PermuteBus,
+    pub height: usize,
+}
+
+impl<T> BaseAir<T> for PermSpongeAir {
+    fn width(&self) -> usize {
+        S_W
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for PermSpongeAir {}
+impl<T> PartitionedBaseAir<T> for PermSpongeAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for PermSpongeAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: Vec<AB::Expr> = (0..S_W).map(|i| lr[i].clone().into()).collect();
+        let n: Vec<AB::Expr> = (0..S_W).map(|i| nr[i].clone().into()).collect();
+        drop((lr, nr));
+        let one = AB::Expr::ONE;
+        let (act, first, last) = (l[S_ACT].clone(), l[S_FIRST].clone(), l[S_LAST].clone());
+        for b in [&act, &first, &last] {
+            builder.assert_bool(b.clone());
+        }
+        builder.assert_zero(first.clone() * (one.clone() - act.clone()));
+        builder.assert_zero(last.clone() * (one.clone() - act.clone()));
+        builder.assert_zero(first.clone() * l[S_BLK].clone());
+        builder.assert_zero(first.clone() * (l[S_IN + 8].clone() - l[S_LEN].clone()));
+        for i in 9..16 {
+            builder.assert_zero(first.clone() * l[S_IN + i].clone());
+        }
+        let cont = n[S_ACT].clone() - n[S_FIRST].clone();
+        builder.when_transition().assert_eq(act.clone() - last.clone(), cont.clone());
+        {
+            let mut t = builder.when_transition();
+            t.assert_zero(cont.clone() * (n[S_SEQ].clone() - l[S_SEQ].clone()));
+            t.assert_zero(cont.clone() * (n[S_LEN].clone() - l[S_LEN].clone()));
+            t.assert_zero(cont.clone() * (n[S_BLK].clone() - l[S_BLK].clone() - one.clone()));
+            for i in 8..16 {
+                t.assert_zero(cont.clone() * (n[S_IN + i].clone() - l[S_OUT + i].clone()));
+            }
+        }
+        builder.when_first_row().assert_eq(act.clone(), first.clone());
+        builder.when_last_row().assert_eq(act.clone(), last.clone());
+        self.perm.lookup_key(
+            builder,
+            Poseidon2PermuteMessage {
+                input: std::array::from_fn(|i| l[S_IN + i].clone()),
+                output: std::array::from_fn(|i| l[S_OUT + i].clone()),
+            },
+            act.clone(),
+        );
+        let mut msg = vec![l[S_SEQ].clone(), l[S_BLK].clone(), l[S_LEN].clone()];
+        msg.extend((0..8).map(|i| l[S_IN + i].clone()));
+        PermutationCheckBus::new(PORT_IN).receive(builder, msg, act);
+        let mut out = vec![l[S_SEQ].clone()];
+        out.extend((0..8).map(|i| l[S_OUT + i].clone()));
+        PermutationCheckBus::new(PORT_OUT).send(builder, out, last);
+    }
+}
+
+/// The sponge trace of `calls` at `height` rows and the permutation inputs it looks up.
+pub fn sponge_trace(calls: &[Call], height: usize) -> (RowMajorMatrix<F>, Vec<[F; 16]>) {
+    let mut v = vec![F::ZERO; height * S_W];
+    let mut ins = vec![];
+    let mut r = 0;
+    for c in calls {
+        let (len, bs) = blocks(c.tag, &c.words);
+        let mut st = [F::ZERO; 16];
+        st[8] = F::from_usize(len);
+        for (k, b) in bs.iter().enumerate() {
+            st[..8].copy_from_slice(b);
+            assert!(r < height, "sponge: over the shape height {height}");
+            let row = &mut v[r * S_W..(r + 1) * S_W];
+            let mut out = st;
+            poseidon2_perm().permute_mut(&mut out);
+            row[S_ACT] = F::ONE;
+            row[S_FIRST] = F::from_bool(k == 0);
+            row[S_LAST] = F::from_bool(k + 1 == bs.len());
+            row[S_SEQ] = F::from_u32(c.seq);
+            row[S_BLK] = F::from_usize(k);
+            row[S_LEN] = F::from_usize(len);
+            row[S_IN..S_IN + 16].copy_from_slice(&st);
+            row[S_OUT..S_OUT + 16].copy_from_slice(&out);
+            ins.push(st);
+            st = out;
+            r += 1;
+        }
+    }
+    (RowMajorMatrix::new(v, S_W), ins)
+}
+
+/// Requester side of one call in an AIR: send the blocks and receive the digest, each with
+/// multiplicity `mult`.
+fn call<AB: InteractionBuilder>(
+    builder: &mut AB,
+    seq: AB::Expr,
+    tag: u32,
+    words: Vec<AB::Expr>,
+    out: &[AB::Expr],
+    mult: AB::Expr,
+) {
+    let len = words.len() + 1;
+    let mut w = vec![AB::Expr::from_u32(tag)];
+    w.extend(words);
+    while w.len() % 8 != 0 {
+        w.push(AB::Expr::ZERO);
+    }
+    for (k, b) in w.chunks(8).enumerate() {
+        let mut m = vec![seq.clone(), AB::Expr::from_usize(k), AB::Expr::from_usize(len)];
+        m.extend(b.iter().cloned());
+        PermutationCheckBus::new(PORT_IN).send(builder, m, mult.clone());
+    }
+    let mut o = vec![seq];
+    o.extend(out.iter().cloned());
+    PermutationCheckBus::new(PORT_OUT).receive(builder, o, mult);
+}
+
+/// Sequence numbers: call `id` of statement row `idx` is `1 + id + 32 idx`.
+pub mod seq {
+    pub const PROG: u32 = 0;
+    pub const KEYLEAF: u32 = 1;
+    pub const PATH: u32 = 2; // .. 2 + D_KEY
+    pub const LOG: u32 = 20;
+    pub const CNODE: u32 = 21;
+    pub const CFOR: u32 = 22;
+    pub const KEYSD: u32 = 23;
+    pub const HEADER: u32 = 24;
+    pub const OUTCOME: u32 = 25;
+    pub const OPC: u32 = 26;
+    pub const OPO: u32 = 27;
+    pub fn of(id: u32, idx: usize) -> u32 {
+        1 + id + 32 * idx as u32
+    }
+}
