index 0000000..ead7274
--- /dev/null
+++ b/crates/sherlock-lfr/src/stmt.rs
@@ -0,0 +1,1412 @@
+//! T7: the FP-2 node statement and the general key route, in place of the withdrawn `KeyBind`
+//! pvs chain (owner ruling O10, 2026-11-13).
+//!
+//! One statement AIR [`StmtAir`] sits at AIR index 0 of every recursion layer (leaf layer, N1,
+//! N2, N3, FV unit, `L`). It is the receiver of the continuations sends of the verifier
+//! sub-circuit (per child proof: every public value of the child's AIR 0, the cached commitment
+//! of the child's constraint-evaluation AIR, the child key pre-hash). Its kind is a constant of
+//! the AIR, but the key route carries no per-key slot: every key below `L` is checked through a
+//! commitment in the statement.
+//!
+//! - **Leaf layer** ([`Kind::Leaf`]): exposes the 54 leaf public values and the app pre-hash
+//!   (62 words, [`lpv`]).
+//! - **First node, N1** ([`Kind::First`]): per LEAF child, opens `prog_d = P2(DOM_PROG, image_d,
+//!   plan_d, key_root, machine_version)`, computes the key leaf
+//!   `P2(DOM_KEYTRIPLE, set_id, pre_app, pre_leaf, pre_ifl, cc_app, cc_leaf)` (the O10 leaf with
+//!   the two cached halves appended, T7 LEAD) from the received child pre-hash (`pre_leaf`) and
+//!   cached commitment (`cc_app`), and proves its inclusion in `key_root` by a path of at most
+//!   `D_KEY` levels (`P2(DOM_KEYNODE, l, r)`, enable prefix). Its own key commitment `vkc`
+//!   (`cc_leaf`, `pre_ifl`) comes from the opened leaf.
+//! - **Universal node** ([`Kind::Node`], N2 and N3) and **FV unit** ([`Kind::Fv`]): open
+//!   `keys_d = P2(DOM_UKEYS, c_node, c_foreign)`, `c_node` and `c_foreign` each `P2(DOM_UKEYS,`
+//!   4 rows of `(cc, pre)`), and take their own `vkc` from one row (node rows for a node, foreign
+//!   rows for an FV unit). Every enabled child has the output `keys_d`.
+//! - Every node checks each enabled NODE child: received cached commitment and pre-hash equal
+//!   the child's `vkc`. So the DAG a layer verified is checked one layer up, against a key
+//!   commitment that `key_root` (per program) or `keys_d` (universal) holds.
+//! - **`L`** ([`Kind::Root`]): one N3 child; its pre-hash and `keys_d` are key constants, its
+//!   `vkc` is checked as above (the `L` cached commitment is pinned by `L_Fr`). `L` exposes the
+//!   74-word root statement (FP-3 words 0 to 73), opens the `post_d` header (X10, one 42-word
+//!   `P2`), checks the seal predicates on a SEG root (`h_lo = 0`, a terminal outcome,
+//!   `deps_d = EMPTY_DEPS`), and computes the three `R` operand digests
+//!   `P2(DOM_PROGC, r_P, prog_d)`, `input_d`, `P2(DOM_OUTHIDE, input_d, outcome_d)`, which
+//!   [`RootOpsAir`] exposes after the FP-3 table (24 words) for the `L_Fr` comparison.
+//!
+//! Node relation (T7 subset of NODE-001, NODE-004, NODE-009): two enabled SEG children merge
+//! (equal `prog_d`, `key_root`, `reg_root`, `shape_d`; `post_d` of slot 0 = `pre_d` of slot 1;
+//! `h_hi` of slot 0 = `h_lo` of slot 1); one enabled child passes through (any tag); the log
+//! merge of FP-2. A LEAF child counts as the SEG `(prog_d, pre_d, post_d, h_pre, h_pre + steps)`.
+//! Hashing goes through [`PermSpongeAir`], whose rows look up the verifier sub-circuit's
+//! Poseidon2 permute bus (the permutation inputs are external inputs of its trace generation).
+
+
+use openvm_recursion_circuit::{
+    bus::{
+        CachedCommitBus, CachedCommitBusMessage, Poseidon2PermuteBus, Poseidon2PermuteMessage,
+        PreHashBus, PreHashMessage, PublicValuesBus, PublicValuesBusMessage,
+    },
+    system::BusInventory,
+};
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder, PermutationCheckBus},
+    p3_air::{Air, AirBuilder, AirBuilderWithPublicValues, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing, PrimeField32},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    p3_symmetric::Permutation,
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;
+use p3_baby_bear::BabyBear;
+
+pub type F = BabyBear;
+pub const D: usize = 8;
+pub type Digest = [F; D];
+
+// ---------------------------------------------------------------- FP-4 tag codes
+pub const TAG_EMPTY: u32 = 1;
+pub const TAG_NODE: u32 = 3;
+pub const DOM_PROG: u32 = 5;
+pub const DOM_PROGC: u32 = 6;
+pub const DOM_KEYTRIPLE: u32 = 8;
+pub const DOM_KEYNODE: u32 = 10;
+pub const SHK_OUTCOME_V2: u32 = 14;
+pub const SHK_DEPS: u32 = 28;
+pub const SHK_SD2: u32 = 29;
+pub const DOM_OUTHIDE: u32 = 31;
+pub const DOM_UKEYS: u32 = 32;
+/// FP-2 statement tags.
+pub const STMT_SEG: u32 = 1;
+pub const STMT_FV: u32 = 5;
