+            let xs: Vec<u64> = (0..n as u64).map(|i| (i * 2654435761) % crate::bb::P).collect();
+            let a = p2(DOM_PROGC, &xs.iter().map(|&x| F::from_u64(x)).collect::<Vec<_>>());
+            assert_eq!(a.map(|x| x.as_canonical_u32() as u64), crate::iface::p2(DOM_PROGC as u64, &xs));
+        }
+    }
+
+    /// The `ANCHOR_D2` seam: `anchor_d2(r_L, prog_d)` is the packed `C_P` operand that `L`
+    /// computes for the same `prog_d` and blinding.
+    #[test]
+    fn anchor_d2_is_the_progc_operand() {
+        let r: [u64; 8] = std::array::from_fn(|i| 1000 + i as u64);
+        let pd: [u64; 8] = std::array::from_fn(|i| 77 * (i as u64 + 1));
+        let hdr: Vec<F> = (0..HDR).map(|i| F::from_usize(i + 1)).collect();
+        let ops = operands(&pd.map(F::from_u64), &r.map(F::from_u64), &hdr);
+        let want = crate::fr::pack(&ops[0].map(|x| x.as_canonical_u32() as u64));
+        assert_eq!(crate::iface::anchor_d2(&r, &pd), want);
+        let mut pd2 = pd;
+        pd2[0] += 1;
+        assert_ne!(crate::iface::anchor_d2(&r, &pd2), want, "wrong_prog_d changes the anchor");
+    }
+}
