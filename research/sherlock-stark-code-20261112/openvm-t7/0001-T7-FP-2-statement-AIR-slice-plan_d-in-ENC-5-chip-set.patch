+pub const KB_AIR_ID: usize = 0;
+pub const CE_AIR_ID: usize = 1;
+/// Most levels of the `key_root` path (FP-2 `D_key`).
+pub const D_KEY: usize = 16;
+/// Rows of each half of the universal key table (`c_node`, `c_foreign`).
+pub const UROWS: usize = 4;
+/// Header words of `state_d` after the tag (FP-5).
+pub const HDR: usize = 41;
+/// T7 buses: sponge ports and the `L` operand words (above the `L` interface buses 900 to 903).
+pub const PORT_IN: BusIndex = 960;
+pub const PORT_OUT: BusIndex = 961;
+pub const OPS_BUS: BusIndex = 962;
