+//! T7: the stand-in extension AIR of chip set 1 (PICK). Two columns at a fixed height of 8: a bit
+//! `b` and `c = 3 b`. It has no interaction, so a shard of chip set 1 proves the same statement as
+//! a shard of chip set 0 under a different app key (another key triple under one `key_root`).
+
+use std::borrow::Borrow;
+
+use openvm_stark_backend::{
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use crate::enc::F;
+
+pub const HEIGHT: usize = 8;
+
+pub struct ExtAir;
+
+impl<T> BaseAir<T> for ExtAir {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for ExtAir {}
+impl<T> PartitionedBaseAir<T> for ExtAir {}
+
+impl<AB: AirBuilder> Air<AB> for ExtAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let l = main.row_slice(0).expect("row");
+        let l: &[AB::Var] = (*l).borrow();
+        let (b, c): (AB::Expr, AB::Expr) = (l[0].clone().into(), l[1].clone().into());
+        builder.assert_bool(b.clone());
+        builder.assert_eq(c, b * AB::Expr::from_u32(3));
+    }
+}
+
+pub fn trace() -> RowMajorMatrix<F> {
+    let mut v = vec![F::ZERO; 2 * HEIGHT];
+    v[0] = F::ONE;
+    v[1] = F::from_u32(3);
+    RowMajorMatrix::new(v, 2)
+}
