+/// Node statement: the FP-2 envelope (74 words) and the key commitment `vkc` of the node's own
+/// key (16 words, T7 LEAD).
+pub mod npv {
+    pub const TAG: usize = 0;
+    pub const PROG_D: usize = 1;
+    pub const PRE_D: usize = 9;
+    pub const POST_D: usize = 17;
+    pub const H_LO: usize = 25;
+    pub const H_HI: usize = 29;
+    pub const FV_STATE: usize = 1;
+    pub const KEY_ROOT: usize = 33;
+    pub const REG_ROOT: usize = 41;
+    pub const SHAPE_D: usize = 49;
+    pub const LOG_D: usize = 57;
+    pub const LOG_N: usize = 65;
+    pub const KEYS_D: usize = 66;
