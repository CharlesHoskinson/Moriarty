+/// T7: the three `R` operand digests that the root statement AIR of `L` computes (`ops`, the 24
+/// `L` words after the FP-3 table: `P2(DOM_PROGC, r_P, prog_d)`, `input_d`, `P2(DOM_OUTHIDE,
+/// input_d, outcome_d)`) are the logged inputs of the `R` entries `DIGEST(SHK_PROGC)`,
+/// `DIGEST(SHK_INPUT)`, `DIGEST(SHK_OUTCOME)`: `pack(op_k)` (8 words, base `2^31`) equals the
+/// Fr value of the 9 limbs of value slot `R_OFF[k]`. The words are not exposed by `L_Fr`.
+pub fn gen_ops_check(g: &mut Gen, l_pub: &[Addr], ops: &[Addr]) {
+    use crate::iface::{Dims, LIMBS, LIMB_BITS, R_OFF};
+    let d = Dims::FULL;
+    assert_eq!(l_pub.len(), d.words());
+    assert_eq!(ops.len(), 24);
+    let limb = |j: usize, t: usize| l_pub[d.values_at() + LIMBS * j + t];
+    for k in 0..3 {
+        let j = R_OFF[k];
+        let mut acc = g.tape.pack(&[limb(j, LIMBS - 1)]);
+        for t in (0..LIMBS - 1).rev() {
+            for _ in 0..LIMB_BITS {
+                acc = g.tape.fr_add(acc, acc);
+            }
+            let l = g.tape.pack(&[limb(j, t)]);
+            acc = g.tape.fr_add(acc, l);
+        }
+        let op = g.tape.pack(&ops[8 * k..8 * k + 8]);
+        g.assert_eq(op, acc);
+    }
+}
