+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Leaf,
+    First,
+    Node,
+    Fv,
+    /// `L`: the N3 pre-hash and `keys_d` as key constants.
+    Root { n3_pre: [u32; 8], keys_d: [u32; 8] },
+}
+
+/// Column offsets (0 where a kind has no such column).
+#[derive(Clone, Debug, Default)]
+pub struct Cols {
+    pub idx: usize,
+    pub valid: usize,
+    pub cw: usize,
+    pub ncw: usize,
+    pub cc: usize,
+    pub pre: usize,
+    // First: prog_d opening, key leaf, path, h_hi
+    pub img: usize,
+    pub plan: usize,
+    pub kr: usize,
+    pub mv: usize,
+    pub set: usize,
+    pub pifl: usize,
+    pub ccl: usize,
+    pub kl: usize,
+    /// per level: en, b, ve, sib 8, ll 8, rr 8, hd 8, cur 8 (cur = the node after this level)
+    pub path: usize,
+    pub hhi: usize,
+    pub cry: usize,
+    // log merge (row 0)
+    pub za: usize,
+    pub ia: usize,
+    pub zb: usize,
+    pub ib: usize,
+    pub both: usize,
+    pub nb: usize,
+    pub db: usize,
+    pub logh: usize,
+    // universal table (Node, Fv)
+    pub tbl: usize,
+    pub sel: usize,
+    pub cn: usize,
+    pub cf: usize,
+    pub kd: usize,
+    pub fvs: usize,
+    // Root
+    pub hdr: usize,
+    pub outd: usize,
+    pub rp: usize,
+    pub opc: usize,
+    pub opo: usize,
+    pub width: usize,
+}
+
+pub const PL: usize = 43;
+const P_EN: usize = 0;
+const P_B: usize = 1;
+const P_VE: usize = 2;
+const P_SIB: usize = 3;
+const P_LL: usize = 11;
+const P_RR: usize = 19;
+const P_HD: usize = 27;
+const P_CUR: usize = 35;
+
+impl Cols {
+    pub fn new(kind: &Kind) -> Self {
+        let mut c = Cols::default();
+        let mut w = 0usize;
+        let mut take = |n: usize| {
+            let a = w;
+            w += n;
+            a
+        };
+        c.idx = take(1);
+        c.valid = take(1);
+        c.ncw = match kind {
+            Kind::Leaf => lpv::LEAF,
+            Kind::First => lpv::N,
+            _ => npv::N,
+        };
+        c.cw = take(c.ncw);
+        if *kind != Kind::Leaf {
+            c.cc = take(D);
+        }
+        c.pre = take(D);
+        match kind {
+            Kind::Leaf => {}
+            Kind::First => {
+                c.img = take(D);
+                c.plan = take(D);
+                c.kr = take(D);
+                c.mv = take(1);
+                c.set = take(1);
+                c.pifl = take(D);
+                c.ccl = take(D);
+                c.kl = take(D);
+                c.path = take(PL * D_KEY);
+                c.hhi = take(4);
+                c.cry = take(4);
+            }
+            Kind::Node | Kind::Fv => {
+                c.tbl = take(2 * UROWS * 2 * D);
+                c.sel = take(2 * UROWS);
+                c.cn = take(D);
+                c.cf = take(D);
+                c.kd = take(D);
+                // Node and Fv share one layout (one AIR shape, so a node verifies either child)
+                c.fvs = take(D);
+            }
+            Kind::Root { .. } => {
+                c.hdr = take(HDR);
+                c.outd = take(D);
+                c.rp = take(D);
+                c.opc = take(D);
+                c.opo = take(D);
+            }
+        }
+        if matches!(kind, Kind::First | Kind::Node | Kind::Fv) {
+            c.za = take(1);
+            c.ia = take(1);
+            c.zb = take(1);
+            c.ib = take(1);
+            c.both = take(1);
+            c.nb = take(1);
+            c.db = take(D);
+            c.logh = take(D);
+        }
+        c.width = w;
+        c
+    }
+}
+
+pub struct StmtAir {
+    pub kind: Kind,
+    pub cols: Cols,
+    pub public_values_bus: PublicValuesBus,
+    pub cached_commit_bus: CachedCommitBus,
+    pub pre_hash_bus: PreHashBus,
+}
+
+impl StmtAir {
+    pub fn new(kind: Kind, inv: &BusInventory) -> Self {
+        let cols = Cols::new(&kind);
+        Self {
+            kind,
+            cols,
+            public_values_bus: inv.public_values_bus,
+            cached_commit_bus: inv.cached_commit_bus,
+            pre_hash_bus: inv.pre_hash_bus,
+        }
+    }
+    pub fn num_pvs(kind: &Kind) -> usize {
+        match kind {
+            Kind::Leaf => lpv::N,
+            Kind::Root { .. } => npv::ENV,
+            _ => npv::N,
+        }
+    }
+}
+
+impl<T> BaseAir<T> for StmtAir {
+    fn width(&self) -> usize {
+        self.cols.width
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for StmtAir {
+    fn num_public_values(&self) -> usize {
+        Self::num_pvs(&self.kind)
+    }
+}
+impl<T> PartitionedBaseAir<T> for StmtAir {}
+
+fn k<AB: AirBuilder>(v: u32) -> AB::Expr {
+    AB::Expr::from_u32(v)
+}
+
+impl<AB: AirBuilder + InteractionBuilder + AirBuilderWithPublicValues> Air<AB> for StmtAir {
+    fn eval(&self, builder: &mut AB) {
+        let c = &self.cols;
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).expect("row"), main.row_slice(1).expect("next"));
+        let l: Vec<AB::Expr> = (0..c.width).map(|i| lr[i].clone().into()).collect();
+        let n: Vec<AB::Expr> = (0..c.width).map(|i| nr[i].clone().into()).collect();
+        drop((lr, nr));
+        let pv: Vec<AB::Expr> = builder.public_values().iter().map(|&x| x.into()).collect();
+        let one = AB::Expr::ONE;
+        let zero = AB::Expr::ZERO;
+        let valid = l[c.valid].clone();
+        let first = builder.is_first_row();
+
+        // Rows: is_valid boolean, first row valid, valid rows first, proof_idx 0, 1, ...
+        builder.assert_bool(valid.clone());
+        builder.when_first_row().assert_one(valid.clone());
+        builder.when_transition().assert_bool(valid.clone() - n[c.valid].clone());
+        builder.when_first_row().assert_zero(l[c.idx].clone());
+        builder.when_transition().assert_zero(n[c.valid].clone() * (l[c.idx].clone() + one.clone() - n[c.idx].clone()));
+        // Reference every own public value (FP8 15.1: the parent receives a child public value
+        // only when the child DAG uses it). Vacuous: `valid` is a bit.
+        let all_pv = pv.iter().fold(zero.clone(), |a, x| a + x.clone());
+        builder.assert_zero(valid.clone() * (one.clone() - valid.clone()) * all_pv);
+
+        let cw = |r: &[AB::Expr], i: usize| r[c.cw + i].clone();
+        let idx = l[c.idx].clone();
+        let sq = |id: u32| AB::Expr::from_u32(seq::of(id, 0)) + idx.clone() * k::<AB>(32);
+
+        // ---- receives (continuations sends of the verifier sub-circuit)
+        let app_air = 0u32;
+        for i in 0..c.ncw {
+            self.public_values_bus.receive(
+                builder,
+                l[c.idx].clone(),
+                PublicValuesBusMessage { air_idx: k::<AB>(if self.kind == Kind::Leaf { app_air } else { KB_AIR_ID as u32 }), pv_idx: k::<AB>(i as u32), value: cw(&l, i) },
+                valid.clone(),
+            );
+        }
+        if self.kind != Kind::Leaf {
+            self.cached_commit_bus.receive(
+                builder,
+                l[c.idx].clone(),
+                CachedCommitBusMessage {
+                    air_idx: k::<AB>(CE_AIR_ID as u32),
+                    cached_idx: zero.clone(),
+                    global_cached_idx: zero.clone(),
+                    cached_commit: std::array::from_fn(|i| l[c.cc + i].clone()),
+                },
+                valid.clone(),
+            );
+        }
+        self.pre_hash_bus.receive(
+            builder,
+            l[c.idx].clone(),
+            PreHashMessage { vk_pre_hash: std::array::from_fn(|i| l[c.pre + i].clone()) },
+            valid.clone(),
+        );
+
+        let rng = |r: &[AB::Expr], a: usize, m: usize| -> Vec<AB::Expr> { (0..m).map(|i| r[a + i].clone()).collect() };
+
+        if self.kind == Kind::Leaf {
+            for i in 0..lpv::LEAF {
+                builder.when_first_row().assert_eq(pv[i].clone(), cw(&l, i));
+            }
+            for i in 0..D {
+                builder.when_first_row().assert_eq(pv[lpv::PRE_APP + i].clone(), l[c.pre + i].clone());
+            }
+            // leaf<1>: one child
+            builder.when_first_row().assert_zero(n[c.valid].clone());
+            return;
+        }
+
+        // ---- NODE children: received key = the child's own key commitment
+        if self.kind != Kind::First {
+            for i in 0..D {
+                builder.assert_zero(valid.clone() * (l[c.cc + i].clone() - cw(&l, npv::VKC_CC + i)));
+                builder.assert_zero(valid.clone() * (l[c.pre + i].clone() - cw(&l, npv::VKC_PRE + i)));
+            }
+        }
+
+        // ---- the child envelope (74 words) of a row
+        let env = |r: &[AB::Expr]| -> Vec<AB::Expr> {
+            match self.kind {
+                Kind::First => {
+                    let mut e = vec![zero.clone(); npv::ENV];
+                    e[npv::TAG] = k::<AB>(STMT_SEG);
+                    for i in 0..D {
+                        e[npv::PROG_D + i] = r[c.cw + lpv::PROG_D + i].clone();
+                        e[npv::PRE_D + i] = r[c.cw + lpv::PRE_D + i].clone();
+                        e[npv::POST_D + i] = r[c.cw + lpv::POST_D + i].clone();
+                        e[npv::KEY_ROOT + i] = r[c.kr + i].clone();
+                        e[npv::LOG_D + i] = r[c.cw + lpv::LOG_D + i].clone();
+                    }
+                    for i in 0..4 {
+                        e[npv::H_LO + i] = r[c.cw + lpv::H_PRE + i].clone();
+                        e[npv::H_HI + i] = r[c.hhi + i].clone();
+                    }
+                    e[npv::LOG_N] = r[c.cw + lpv::LOG_N].clone();
+                    // keys_d: the output word (a free witness of N1, checked one layer up)
+                    for i in 0..D {
+                        e[npv::KEYS_D + i] = pv[npv::KEYS_D + i].clone();
+                    }
+                    e
+                }
+                _ => rng(r, c.cw, npv::ENV),
+            }
+        };
+
+        // ---- First: prog_d opening, key leaf, path, h_hi
+        if self.kind == Kind::First {
+            let mut wds = rng(&l, c.img, D);
+            wds.extend(rng(&l, c.plan, D));
+            wds.extend(rng(&l, c.kr, D));
+            wds.push(l[c.mv].clone());
+            call(builder, sq(seq::PROG), DOM_PROG, wds, &rng(&l, c.cw + lpv::PROG_D, D), valid.clone());
+            let mut wds = vec![l[c.set].clone()];
+            wds.extend(rng(&l, c.cw + lpv::PRE_APP, D));
+            wds.extend(rng(&l, c.pre, D));
+            wds.extend(rng(&l, c.pifl, D));
+            wds.extend(rng(&l, c.cc, D));
+            wds.extend(rng(&l, c.ccl, D));
+            call(builder, sq(seq::KEYLEAF), DOM_KEYTRIPLE, wds, &rng(&l, c.kl, D), valid.clone());
+            let mut cur = rng(&l, c.kl, D);
+            for lv in 0..D_KEY {
+                let p = c.path + PL * lv;
+                let (en, b, ve) = (l[p + P_EN].clone(), l[p + P_B].clone(), l[p + P_VE].clone());
+                builder.assert_bool(en.clone());
+                builder.assert_bool(b.clone());
+                builder.assert_eq(ve.clone(), valid.clone() * en.clone());
+                if lv == 0 {
+                    builder.assert_eq(en.clone(), valid.clone());
+                } else {
+                    builder.assert_zero(en.clone() * (one.clone() - l[c.path + PL * (lv - 1) + P_EN].clone()));
+                }
+                let mut ws = vec![];
+                for i in 0..D {
+                    let sib = l[p + P_SIB + i].clone();
+                    builder.assert_eq(l[p + P_LL + i].clone(), cur[i].clone() + b.clone() * (sib.clone() - cur[i].clone()));
+                    builder.assert_eq(l[p + P_RR + i].clone(), sib.clone() + b.clone() * (cur[i].clone() - sib.clone()));
+                    ws.push(l[p + P_LL + i].clone());
+                }
+                for i in 0..D {
+                    ws.push(l[p + P_RR + i].clone());
+                }
+                call(builder, sq(seq::PATH + lv as u32), DOM_KEYNODE, ws, &rng(&l, p + P_HD, D), ve.clone());
+                for i in 0..D {
+                    builder.assert_eq(
+                        l[p + P_CUR + i].clone(),
+                        cur[i].clone() + en.clone() * (l[p + P_HD + i].clone() - cur[i].clone()),
+                    );
+                }
+                cur = rng(&l, p + P_CUR, D);
+            }
+            for i in 0..D {
+                builder.assert_zero(valid.clone() * (cur[i].clone() - l[c.kr + i].clone()));
+            }
+            // h_hi = h_pre + steps, 16-bit limbs with boolean carries, no wrap at 2^64.
+            let two16 = k::<AB>(1 << 16);
+            for i in 0..4 {
+                let cin = if i == 0 { cw(&l, lpv::STEPS) } else { l[c.cry + i - 1].clone() };
+                builder.assert_bool(l[c.cry + i].clone());
+                builder.assert_eq(l[c.hhi + i].clone() + two16.clone() * l[c.cry + i].clone(), cw(&l, lpv::H_PRE + i) + cin);
+            }
+            builder.assert_zero(l[c.cry + 3].clone());
+        }
+
+        // ---- Node, Fv: the universal key table under keys_d, and the own vkc
+        if matches!(self.kind, Kind::Node | Kind::Fv) {
+            let half = 2 * UROWS * D;
+            call(builder, AB::Expr::from_u32(seq::of(seq::CNODE, 0)), DOM_UKEYS, rng(&l, c.tbl, half), &rng(&l, c.cn, D), first.clone());
+            call(builder, AB::Expr::from_u32(seq::of(seq::CFOR, 0)), DOM_UKEYS, rng(&l, c.tbl + half, half), &rng(&l, c.cf, D), first.clone());
+            let mut wds = rng(&l, c.cn, D);
+            wds.extend(rng(&l, c.cf, D));
+            call(builder, AB::Expr::from_u32(seq::of(seq::KEYSD, 0)), DOM_UKEYS, wds, &rng(&l, c.kd, D), first.clone());
+            let mut s = zero.clone();
+            for i in 0..2 * UROWS {
+                builder.assert_bool(l[c.sel + i].clone());
+                s += l[c.sel + i].clone();
+                let allowed = if self.kind == Kind::Node { i < UROWS } else { i >= UROWS };
+                if !allowed {
+                    builder.assert_zero(l[c.sel + i].clone());
+                }
+            }
+            builder.when_first_row().assert_one(s);
+            for j in 0..2 * D {
+                let v = (0..2 * UROWS).fold(zero.clone(), |a, i| a + l[c.sel + i].clone() * l[c.tbl + 2 * D * i + j].clone());
+                builder.when_first_row().assert_eq(pv[npv::VKC_CC + j].clone(), v);
+            }
+            for i in 0..D {
+                builder.when_first_row().assert_eq(pv[npv::KEYS_D + i].clone(), l[c.kd + i].clone());
+                // every enabled child has the output keys_d
+                builder.assert_zero(valid.clone() * (cw(&l, npv::KEYS_D + i) - pv[npv::KEYS_D + i].clone()));
+            }
+        }
+
+        // ---- one-child kinds
+        if matches!(self.kind, Kind::Fv | Kind::Root { .. }) {
+            builder.when_first_row().assert_zero(n[c.valid].clone());
+        }
+
+        // ---- the output statement (row 0, slot 1 = the next row)
+        let e0 = env(&l);
+        let e1 = env(&n);
+        let en1 = n[c.valid].clone();
+        let merges = matches!(self.kind, Kind::First | Kind::Node);
+        if merges {
+            let mut fr = builder.when_first_row();
+            // binary merge: both SEG, equal prog_d, key_root, reg_root, shape_d, keys_d; the
+            // stitch; the interval.
+            fr.assert_zero(en1.clone() * (e0[npv::TAG].clone() - k::<AB>(STMT_SEG)));
+            fr.assert_zero(en1.clone() * (e1[npv::TAG].clone() - k::<AB>(STMT_SEG)));
+            for a in [npv::PROG_D, npv::KEY_ROOT, npv::REG_ROOT, npv::SHAPE_D, npv::KEYS_D] {
+                for i in 0..D {
+                    fr.assert_zero(en1.clone() * (e0[a + i].clone() - e1[a + i].clone()));
+                }
+            }
+            for i in 0..D {
+                fr.assert_zero(en1.clone() * (e0[npv::POST_D + i].clone() - e1[npv::PRE_D + i].clone()));
+            }
+            for i in 0..4 {
+                fr.assert_zero(en1.clone() * (e0[npv::H_HI + i].clone() - e1[npv::H_LO + i].clone()));
+            }
+            // outputs: slot 0 words, post_d and h_hi from slot 1 when it is on
+            for i in 0..npv::ENV {
+                if (npv::LOG_D..npv::LOG_N + 1).contains(&i) || (npv::KEYS_D..npv::ENV).contains(&i) {
+                    continue;
+                }
+                let from1 = (npv::POST_D..npv::POST_D + D).contains(&i) || (npv::H_HI..npv::H_HI + 4).contains(&i);
+                let v = if from1 { e0[i].clone() + en1.clone() * (e1[i].clone() - e0[i].clone()) } else { e0[i].clone() };
+                fr.assert_eq(pv[i].clone(), v);
+            }
+        }
+        if matches!(self.kind, Kind::First | Kind::Node | Kind::Fv) {
+            let mut fr = builder.when_first_row();
+            // log merge with the neutral (D_EMPTY, 0); an FV unit has the same columns and calls
+            // (one AIR shape with a node) and one child, so `both` is 0 there.
+            let de = d_empty();
+            let na = e0[npv::LOG_N].clone();
+            let (za, ia, zb, ib, both, nb) = (l[c.za].clone(), l[c.ia].clone(), l[c.zb].clone(), l[c.ib].clone(), l[c.both].clone(), l[c.nb].clone());
+            fr.assert_eq(nb.clone(), en1.clone() * e1[npv::LOG_N].clone());
+            for i in 0..D {
+                fr.assert_eq(
+                    l[c.db + i].clone(),
+                    en1.clone() * e1[npv::LOG_D + i].clone() + (one.clone() - en1.clone()) * AB::Expr::from_u32(de[i].as_canonical_u32()),
+                );
+            }
+            fr.assert_eq(na.clone() * ia, one.clone() - za.clone());
+            fr.assert_zero(na.clone() * za.clone());
+            fr.assert_eq(nb.clone() * ib, one.clone() - zb.clone());
+            fr.assert_zero(nb.clone() * zb.clone());
+            fr.assert_eq(both.clone(), (one.clone() - za.clone()) * (one.clone() - zb.clone()));
+            for i in 0..D {
+                let da = e0[npv::LOG_D + i].clone();
+                let v = za.clone() * l[c.db + i].clone()
+                    + (one.clone() - za.clone()) * (zb.clone() * da + (one.clone() - zb.clone()) * l[c.logh + i].clone());
+                if merges {
+                    fr.assert_eq(pv[npv::LOG_D + i].clone(), v);
+                }
+            }
+            if merges {
+                fr.assert_eq(pv[npv::LOG_N].clone(), na + nb);
+            }
+            let mut wds = rng(&e0, npv::LOG_D, D);
+            wds.extend(rng(&l, c.db, D));
+            call(builder, AB::Expr::from_u32(seq::of(seq::LOG, 0)), TAG_NODE, wds, &rng(&l, c.logh, D), first.clone() * both);
+        }
+
+        match &self.kind {
+            Kind::First => {
+                // own vkc from the opened key leaf; slot 1 opens the same leaf-layer key
+                for i in 0..D {
+                    builder.when_first_row().assert_eq(pv[npv::VKC_CC + i].clone(), l[c.ccl + i].clone());
+                    builder.when_first_row().assert_eq(pv[npv::VKC_PRE + i].clone(), l[c.pifl + i].clone());
+                    builder.when_first_row().assert_zero(en1.clone() * (n[c.ccl + i].clone() - l[c.ccl + i].clone()));
+                    builder.when_first_row().assert_zero(en1.clone() * (n[c.pifl + i].clone() - l[c.pifl + i].clone()));
+                }
+            }
+            Kind::Fv => {
+                // FV-WORK (T7 stand-in): output FV(fv_state_d) with the child's key_root,
+                // reg_root, shape_d and log
+                let mut fr = builder.when_first_row();
+                for i in 0..npv::KEYS_D {
+                    let v = if i == npv::TAG {
+                        k::<AB>(STMT_FV)
+                    } else if (npv::FV_STATE..npv::FV_STATE + D).contains(&i) {
+                        l[c.fvs + i - npv::FV_STATE].clone()
+                    } else if i < npv::KEY_ROOT {
+                        zero.clone()
+                    } else {
+                        e0[i].clone()
+                    };
+                    fr.assert_eq(pv[i].clone(), v);
+                }
+            }
+            Kind::Root { n3_pre, keys_d } => {
+                let mut fr = builder.when_first_row();
+                for i in 0..npv::ENV {
+                    fr.assert_eq(pv[i].clone(), e0[i].clone());
+                }
+                for i in 0..D {
+                    fr.assert_eq(l[c.pre + i].clone(), k::<AB>(n3_pre[i]));
+                    fr.assert_eq(e0[npv::KEYS_D + i].clone(), k::<AB>(keys_d[i]));
+                }
+                // seal predicates on the SEG root
+                fr.assert_eq(e0[npv::TAG].clone(), k::<AB>(STMT_SEG));
+                for i in 0..4 {
+                    fr.assert_zero(e0[npv::H_LO + i].clone());
+                }
+                let t = l[c.hdr].clone();
+                fr.assert_zero((t.clone() - one.clone()) * (t.clone() - k::<AB>(2)) * (t.clone() - k::<AB>(3)));
+                let ed = empty_deps();
+                for i in 0..D {
+                    fr.assert_eq(l[c.hdr + 17 + i].clone(), AB::Expr::from_u32(ed[i].as_canonical_u32()));
+                }
+                // X10: the header opening of post_d
+                call(builder, AB::Expr::from_u32(seq::of(seq::HEADER, 0)), SHK_SD2, rng(&l, c.hdr, HDR), &rng(&e0, npv::POST_D, D), first.clone());
+                let mut wds = vec![k::<AB>(2), t - one.clone()];
+                wds.extend(rng(&l, c.hdr + 1, D));
+                call(builder, AB::Expr::from_u32(seq::of(seq::OUTCOME, 0)), SHK_OUTCOME_V2, wds, &rng(&l, c.outd, D), first.clone());
+                let mut wds = rng(&l, c.rp, D);
+                wds.extend(rng(&e0, npv::PROG_D, D));
+                call(builder, AB::Expr::from_u32(seq::of(seq::OPC, 0)), DOM_PROGC, wds, &rng(&l, c.opc, D), first.clone());
+                let mut wds = rng(&l, c.hdr + 9, D);
+                wds.extend(rng(&l, c.outd, D));
+                call(builder, AB::Expr::from_u32(seq::of(seq::OPO, 0)), DOM_OUTHIDE, wds, &rng(&l, c.opo, D), first.clone());
+                let mut m = rng(&l, c.opc, D);
+                m.extend(rng(&l, c.hdr + 9, D));
+                m.extend(rng(&l, c.opo, D));
+                PermutationCheckBus::new(OPS_BUS).send(builder, m, first);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// The 24 operand words of `L` after the FP-3 table (for the `L_Fr` comparison with the logged
+/// operands of `R`), received from the root statement AIR.
+pub struct RootOpsAir;
+pub const OPS_WORDS: usize = 3 * D;
+
+impl<T> BaseAir<T> for RootOpsAir {
+    fn width(&self) -> usize {
+        OPS_WORDS
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for RootOpsAir {
+    fn num_public_values(&self) -> usize {
+        OPS_WORDS
+    }
+}
+impl<T> PartitionedBaseAir<T> for RootOpsAir {}
+impl<AB: AirBuilder + InteractionBuilder + AirBuilderWithPublicValues> Air<AB> for RootOpsAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let lr = main.row_slice(0).expect("row");
+        let l: Vec<AB::Expr> = (0..OPS_WORDS).map(|i| lr[i].clone().into()).collect();
+        drop(lr);
+        let pv: Vec<AB::Expr> = builder.public_values().iter().map(|&x| x.into()).collect();
+        let first = builder.is_first_row();
+        for i in 0..OPS_WORDS {
+            builder.when_first_row().assert_eq(pv[i].clone(), l[i].clone());
+        }
+        PermutationCheckBus::new(OPS_BUS).receive(builder, l, first);
+    }
+}
+
+pub fn root_ops_trace(ops: &[Digest; 3]) -> (RowMajorMatrix<F>, Vec<F>) {
+    let w: Vec<F> = ops.iter().flat_map(|d| d.iter().copied()).collect();
+    let mut v = w.clone();
+    v.extend(vec![F::ZERO; OPS_WORDS]);
+    (RowMajorMatrix::new(v, OPS_WORDS), w)
+}
+
+// ---------------------------------------------------------------- trace generation
+/// One child proof as the statement AIR receives it.
+#[derive(Clone, Debug)]
+pub struct Child {
+    pub pvs: Vec<F>,
+    pub cc: Digest,
+    pub pre: Digest,
+}
+
+/// The witness of a First (N1) row: the `prog_d` preimage, the key leaf and its path.
+#[derive(Clone, Debug)]
+pub struct FirstWit {
+    pub image_d: Digest,
+    pub plan_d: Digest,
+    pub key_root: Digest,
+    pub mv: F,
+    pub set_id: u32,
+    pub pre_ifl: Digest,
+    pub cc_leaf: Digest,
+    pub path: Vec<(bool, Digest)>,
+}
+
+#[derive(Clone, Debug)]
+pub enum Wit {
+    Leaf,
+    /// per child, and the output `keys_d` word
+    First(Vec<FirstWit>, Digest),
+    Node { tbl: UKeys, sel: usize },
+    Fv { tbl: UKeys, sel: usize, fv_state: Digest },
+    Root { hdr: Vec<F>, r_p: Digest },
+}
+
+/// The trace (2 rows), the public values (the Rust reference of the statement) and the sponge
+/// calls of one statement AIR. `tamper` changes the public values after they are computed
+/// (refusal cases).
+pub fn trace(kind: &Kind, kids: &[Child], wit: &Wit) -> (RowMajorMatrix<F>, Vec<F>, Vec<Call>) {
+    let c = Cols::new(kind);
+    assert!(!kids.is_empty() && kids.len() <= 2);
+    let h = 2;
+    let mut t = vec![F::ZERO; h * c.width];
+    let mut calls = vec![];
+    let fd = |d: &Digest| d.to_vec();
+    let mut envs: Vec<Vec<F>> = vec![];
+    for (r, kid) in kids.iter().enumerate() {
+        let row = &mut t[r * c.width..(r + 1) * c.width];
+        row[c.idx] = F::from_usize(r);
+        row[c.valid] = F::ONE;
+        assert_eq!(kid.pvs.len(), c.ncw.max(if *kind == Kind::Leaf { lpv::LEAF } else { 0 }), "child public values");
+        row[c.cw..c.cw + c.ncw].copy_from_slice(&kid.pvs[..c.ncw]);
+        if *kind != Kind::Leaf {
+            row[c.cc..c.cc + D].copy_from_slice(&kid.cc);
+        }
+        row[c.pre..c.pre + D].copy_from_slice(&kid.pre);
+        let sqr = |id: u32| seq::of(id, r);
+        match (kind, wit) {
+            (Kind::First, Wit::First(ws, keys_d)) => {
+                let w = &ws[r];
+                row[c.img..c.img + D].copy_from_slice(&w.image_d);
+                row[c.plan..c.plan + D].copy_from_slice(&w.plan_d);
+                row[c.kr..c.kr + D].copy_from_slice(&w.key_root);
+                row[c.mv] = w.mv;
+                calls.push(Call { seq: sqr(seq::PROG), tag: DOM_PROG, words: cat(&[&w.image_d, &w.plan_d, &w.key_root, &[w.mv]]) });
+                row[c.set] = F::from_u32(w.set_id);
+                row[c.pifl..c.pifl + D].copy_from_slice(&w.pre_ifl);
+                row[c.ccl..c.ccl + D].copy_from_slice(&w.cc_leaf);
+                let kt = KeyTriple {
+                    set_id: w.set_id,
+                    pre_app: kid.pvs[lpv::PRE_APP..lpv::PRE_APP + D].try_into().unwrap(),
+                    pre_leaf: kid.pre,
+                    pre_ifl: w.pre_ifl,
+                    cc_app: kid.cc,
+                    cc_leaf: w.cc_leaf,
+                };
+                let kl = kt.leaf();
+                row[c.kl..c.kl + D].copy_from_slice(&kl);
+                calls.push(Call { seq: sqr(seq::KEYLEAF), tag: DOM_KEYTRIPLE, words: kt.words() });
+                assert!(w.path.len() <= D_KEY);
+                let mut cur = kl;
+                for lv in 0..D_KEY {
+                    let p = c.path + PL * lv;
+                    if let Some(&(b, sib)) = w.path.get(lv) {
+                        let (ll, rr) = if b { (sib, cur) } else { (cur, sib) };
+                        let hd = key_node(&ll, &rr);
+                        row[p + P_EN] = F::ONE;
+                        row[p + P_B] = F::from_bool(b);
+                        row[p + P_VE] = F::ONE;
+                        row[p + P_SIB..p + P_SIB + D].copy_from_slice(&sib);
+                        row[p + P_LL..p + P_LL + D].copy_from_slice(&ll);
+                        row[p + P_RR..p + P_RR + D].copy_from_slice(&rr);
+                        row[p + P_HD..p + P_HD + D].copy_from_slice(&hd);
+                        calls.push(Call { seq: sqr(seq::PATH + lv as u32), tag: DOM_KEYNODE, words: cat(&[&ll, &rr]) });
+                        cur = hd;
+                    } else {
+                        // disabled level: ll = cur, rr = sib = 0 (b = 0)
+                        row[p + P_LL..p + P_LL + D].copy_from_slice(&cur);
+                    }
+                    row[p + P_CUR..p + P_CUR + D].copy_from_slice(&cur);
+                }
+                let (hh, cry) = h_hi(&kid.pvs[lpv::H_PRE..lpv::H_PRE + 4], kid.pvs[lpv::STEPS]);
+                row[c.hhi..c.hhi + 4].copy_from_slice(&hh);
+                row[c.cry..c.cry + 4].copy_from_slice(&cry);
+                envs.push(seg_of_leaf(&kid.pvs, &w.key_root, keys_d));
+            }
+            (Kind::Leaf, _) => {}
+            _ => envs.push(kid.pvs[..npv::ENV].to_vec()),
+        }
+    }
+    let mut pvs = vec![F::ZERO; StmtAir::num_pvs(kind)];
+    match (kind, wit) {
+        (Kind::Leaf, _) => {
+            pvs[..lpv::LEAF].copy_from_slice(&kids[0].pvs[..lpv::LEAF]);
+            pvs[lpv::PRE_APP..].copy_from_slice(&kids[0].pre);
+            assert_eq!(kids.len(), 1);
+        }
+        _ => {}
+    }
+    // universal table rows
+    let table = |t: &mut [F], tbl: &UKeys, sel: usize, calls: &mut Vec<Call>| -> (Vkc, Digest) {
+        let rows = tbl.rows();
+        for r in 0..h {
+            let row = &mut t[r * c.width..(r + 1) * c.width];
+            for (i, v) in rows.iter().enumerate() {
+                row[c.tbl + 2 * D * i..c.tbl + 2 * D * i + D].copy_from_slice(&v.cc);
+                row[c.tbl + 2 * D * i + D..c.tbl + 2 * D * (i + 1)].copy_from_slice(&v.pre);
+            }
+            row[c.sel + sel] = F::ONE;
+            let cn = UKeys::half(&rows[..UROWS]);
+            let cf = UKeys::half(&rows[UROWS..]);
+            row[c.cn..c.cn + D].copy_from_slice(&cn);
+            row[c.cf..c.cf + D].copy_from_slice(&cf);
+            row[c.kd..c.kd + D].copy_from_slice(&tbl.keys_d());
+        }
+        let w = |rs: &[Vkc]| rs.iter().flat_map(|r| r.words()).collect::<Vec<_>>();
+        let cn = UKeys::half(&rows[..UROWS]);
+        let cf = UKeys::half(&rows[UROWS..]);
+        calls.push(Call { seq: seq::of(seq::CNODE, 0), tag: DOM_UKEYS, words: w(&rows[..UROWS]) });
+        calls.push(Call { seq: seq::of(seq::CFOR, 0), tag: DOM_UKEYS, words: w(&rows[UROWS..]) });
+        calls.push(Call { seq: seq::of(seq::KEYSD, 0), tag: DOM_UKEYS, words: cat(&[&cn, &cf]) });
+        (rows[sel], tbl.keys_d())
+    };
+    match (kind, wit) {
+        (Kind::First, Wit::First(ws, _)) | (Kind::First, Wit::First(ws, _)) if !envs.is_empty() => {
+            let out = merge(&envs[0], envs.get(1).map(|v| v.as_slice())).expect("node relation (First)");
+            pvs[..npv::ENV].copy_from_slice(&out);
+            pvs[npv::VKC_CC..npv::VKC_CC + D].copy_from_slice(&ws[0].cc_leaf);
+            pvs[npv::VKC_PRE..npv::VKC_PRE + D].copy_from_slice(&ws[0].pre_ifl);
+        }
+        (Kind::Node, Wit::Node { tbl, sel }) => {
+            let (v, kd) = table(&mut t, tbl, *sel, &mut calls);
+            let out = merge(&envs[0], envs.get(1).map(|v| v.as_slice())).expect("node relation (Node)");
+            pvs[..npv::ENV].copy_from_slice(&out);
+            pvs[npv::KEYS_D..npv::KEYS_D + D].copy_from_slice(&kd);
+            pvs[npv::VKC_CC..npv::N].copy_from_slice(&v.words());
+        }
+        (Kind::Fv, Wit::Fv { tbl, sel, fv_state }) => {
+            let (v, kd) = table(&mut t, tbl, *sel, &mut calls);
+            assert_eq!(kids.len(), 1);
+            let row = &mut t[..c.width];
+            row[c.fvs..c.fvs + D].copy_from_slice(fv_state);
+            pvs[npv::TAG] = F::from_u32(STMT_FV);
+            pvs[npv::FV_STATE..npv::FV_STATE + D].copy_from_slice(fv_state);
+            pvs[npv::KEY_ROOT..npv::KEYS_D].copy_from_slice(&envs[0][npv::KEY_ROOT..npv::KEYS_D]);
+            pvs[npv::KEYS_D..npv::KEYS_D + D].copy_from_slice(&kd);
+            pvs[npv::VKC_CC..npv::N].copy_from_slice(&v.words());
+        }
+        (Kind::Root { .. }, Wit::Root { hdr, r_p }) => {
+            assert_eq!(kids.len(), 1);
+            pvs.copy_from_slice(&envs[0]);
+            let e = &envs[0];
+            let prog_d: Digest = e[npv::PROG_D..npv::PROG_D + D].try_into().unwrap();
+            let ops = operands(&prog_d, r_p, hdr);
+            let od = outcome_d(hdr[0], &hdr[1..9]);
+            let row = &mut t[..c.width];
+            row[c.hdr..c.hdr + HDR].copy_from_slice(hdr);
+            row[c.outd..c.outd + D].copy_from_slice(&od);
+            row[c.rp..c.rp + D].copy_from_slice(r_p);
+            row[c.opc..c.opc + D].copy_from_slice(&ops[0]);
+            row[c.opo..c.opo + D].copy_from_slice(&ops[2]);
+            calls.push(Call { seq: seq::of(seq::HEADER, 0), tag: SHK_SD2, words: hdr.clone() });
+            let mut wo = vec![F::from_u32(2), hdr[0] - F::ONE];
+            wo.extend_from_slice(&hdr[1..9]);
+            calls.push(Call { seq: seq::of(seq::OUTCOME, 0), tag: SHK_OUTCOME_V2, words: wo });
+            calls.push(Call { seq: seq::of(seq::OPC, 0), tag: DOM_PROGC, words: cat(&[r_p, &prog_d]) });
+            calls.push(Call { seq: seq::of(seq::OPO, 0), tag: DOM_OUTHIDE, words: cat(&[&ops[1], &od]) });
+        }
+        (Kind::Leaf, _) => {}
+        (k, _) => panic!("statement witness does not fit kind {k:?}"),
+    }
+    // log merge columns (row 0)
+    if matches!(kind, Kind::First | Kind::Node | Kind::Fv) {
+        let e0 = &envs[0];
+        let de = d_empty();
+        let (db, nb) = match envs.get(1) {
+            Some(e1) => (e1[npv::LOG_D..npv::LOG_D + D].to_vec(), e1[npv::LOG_N]),
+            None => (de.to_vec(), F::ZERO),
+        };
+        let na = e0[npv::LOG_N];
+        let row = &mut t[..c.width];
+        row[c.za] = F::from_bool(na == F::ZERO);
+        row[c.ia] = if na == F::ZERO { F::ZERO } else { na.inverse() };
+        row[c.zb] = F::from_bool(nb == F::ZERO);
+        row[c.ib] = if nb == F::ZERO { F::ZERO } else { nb.inverse() };
+        let both = na != F::ZERO && nb != F::ZERO;
+        row[c.both] = F::from_bool(both);
+        row[c.nb] = nb;
+        row[c.db..c.db + D].copy_from_slice(&db);
+        let da: Digest = e0[npv::LOG_D..npv::LOG_D + D].try_into().unwrap();
+        let dbd: Digest = db.clone().try_into().unwrap();
+        let lh = key_node_tag(TAG_NODE, &da, &dbd);
+        if both {
+            row[c.logh..c.logh + D].copy_from_slice(&lh);
+            calls.push(Call { seq: seq::of(seq::LOG, 0), tag: TAG_NODE, words: cat(&[&da, &dbd]) });
+        }
+        let _ = fd;
+    }
+    for r in kids.len()..h {
+        t[r * c.width + c.idx] = F::from_usize(r);
+    }
+    (RowMajorMatrix::new(t, c.width), pvs, calls)
+}
+
+fn key_node_tag(tag: u32, l: &Digest, r: &Digest) -> Digest {
+    p2(tag, &cat(&[l, r]))
+}
+
+/// Sponge heights of the statement kinds (fixed per layer shape).
+pub fn sponge_height(kind: &Kind) -> usize {
+    match kind {
+        Kind::Leaf => 0,
+        Kind::First => 128,
+        Kind::Node | Kind::Fv => 32,
+        Kind::Root { .. } => 16,
+    }
+}
+
+/// Read a digest from public values.
+pub fn dig(v: &[F], a: usize) -> Digest {
+    v[a..a + D].try_into().unwrap()
+}
+
+pub fn digest_u32(d: &Digest) -> [u32; 8] {
+    d.map(|x| x.as_canonical_u32())
+}
