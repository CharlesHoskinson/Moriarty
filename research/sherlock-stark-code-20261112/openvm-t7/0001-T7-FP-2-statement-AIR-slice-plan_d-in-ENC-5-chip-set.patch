+/// `r_L`. T10 passes it to [`reservation_with`].
+pub fn anchor_d2(r_l: &[u64; 8], prog_d_ledger: &[u64; 8]) -> Fr {
+    use crate::stmt::{p2, DOM_PROGC, F};
