+/// T7: the programs of the slice. `A` is `entry x;` (the V.1 program). `B` is `entry y;`: the
+/// same reference run with the name row `names[0]` = `"y"`, so a different `prog_root`, `image_d`
+/// and `prog_d`. The run lanes name a variable by its ROM row index (`names` row 0 in both), never
+/// by its bytes, so the reference states of `A` are the states of `B` (DERIVED by code reading of
+/// the run record: no lane of `slice_v1.json` holds a name byte).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Prog {
+    A,
+    B,
+}
+
+impl Prog {
+    pub fn source(self) -> &'static str {
+        match self {
+            Prog::A => "language \"moriarty-sherlock-nominal/1\"; program P { entry x; }",
+            Prog::B => "language \"moriarty-sherlock-nominal/1\"; program P { entry y; }",
+        }
+    }
+}
+
+pub fn program_of(key_root: Digest, which: Prog) -> Program {
+    let mut j = slice_json();
+    if which == Prog::B {
+        let run = j["runs"].as_array_mut().unwrap().iter_mut().find(|r| r["name"] == "unbound").unwrap();
+        assert_eq!(run["rom_rows"]["21"], serde_json::json!([["120"]]), "names[0] of `entry x;`");
+        run["rom_rows"]["21"] = serde_json::json!([["121"]]);
+    }
     let run = run_of(&j);
     let rom = rom_rows(run);
     let (root, _) = rom_tree(&rom);
