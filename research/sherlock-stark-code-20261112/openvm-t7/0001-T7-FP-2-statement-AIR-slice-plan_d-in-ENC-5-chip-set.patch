+/// T7 (ENC-5, T9 `enc45`): the static plan of the slice programs. PICKs: no instruction table
+/// (an interpreted program); the menu holds chip set 0 (the seven slice AIRs) and chip set 1 (the
+/// seven plus `EXT`), one shape each at the fixed heights of [`HEIGHTS`] (listed in chip-code
+/// order: CPU = CORE, RANGE, POSEIDON2 = SPONGE, DEC, HASH2, ROM, MEM, EXT), node arity 2; the
+/// general policy with cut rule 0, the per-rule maximum of the five subset rule classes (one CORE
+/// slot each) and the padded shard counts 1, 2, 4; the layout `R` of an ORD `acceptRun`
+/// (`DIGEST` 0, 2, 3, `SPONGE(3)`, the anchor `DIGEST` 0) with the text's fill orders; no
+/// discharge, tier E or GP-3 shape.
+pub fn slice_plan() -> sherlock_lfr::enc45::Plan {
+    use sherlock_lfr::enc45::*;
+    let code = |n: &str| CHIPS.iter().position(|c| *c == n).unwrap() as u16 + 1;
+    let set0: Vec<u16> = ["CPU", "RANGE", "POSEIDON2", "DEC", "HASH2", "ROM", "MEM"].iter().map(|n| code(n)).collect();
+    let mut set1 = set0.clone();
+    set1.push(code("EXT"));
+    // heights in chip-code order: CORE 3, RANGE 17, SPONGE 9, DEC 3, HASH2 7, ROM 1, MEM 3 (log2)
+    let lh = |i: usize| HEIGHTS[i].trailing_zeros() as u8;
+    let h0 = vec![lh(A_CORE), lh(A_RANGE), lh(A_SPONGE), lh(A_DEC), lh(A_HASH2), lh(A_ROM), lh(A_MEM)];
+    let mut h1 = h0.clone();
+    h1.push(crate::ext::HEIGHT.trailing_zeros() as u8);
+    let core = code("CPU");
+    Plan {
+        itab: Itab { entries: vec![] },
+        menu: Menu {
+            chip_sets: vec![set0, set1],
+            shapes: vec![Shape { chip_set: 0, log_heights: h0 }, Shape { chip_set: 1, log_heights: h1 }],
+            node_arity: 2,
+        },
+        policy: Policy::General {
+            cut_rule: 0,
+            rule_max: [1u8, 10, 12, 67, 89].iter().map(|&r| (r, core, 1)).collect(),
+            pad: vec![1, 2, 4],
+        },
+        layout: Layout { r: vec![(8, 0), (8, 2), (8, 3), (3, 3), (8, 0)], fill_limits: vec![2, 3, 1], fill_ops: vec![4, 2, 5] },
+        place: Place { discharge: 0, discharge_shape: 0, tier_e: vec![], gp3: vec![] },
+    }
+}
+
+/// `plan_d` of [`slice_plan`] (ENC-5, 42 words with the tag).
+pub fn slice_plan_d() -> Digest {
+    let o = slice_plan().words().expect("slice plan words");
+    o.plan_d.map(F::from_u32)
+}
+
+/// T7 chip set 1 (PICK): the slice AIRs plus [`crate::ext::ExtAir`], a stand-in for a chip-set
+/// extension (FIELD-EMU in the Compact menu). A shard of chip set 1 proves the same steps.
+pub fn airs_set(set: u32, weak: u64) -> Vec<AirRef<SC>> {
+    let mut v = airs(weak);
+    if set == 1 {
+        v.push(Arc::new(crate::ext::ExtAir));
+    }
+    v
+}
+
+/// The traces of one shard under chip set `set`.
+pub fn traces_set(p: &Program, sh: &ShardIn, b: &Build, set: u32) -> Vec<Tr> {
+    let mut v = traces(p, sh, b);
+    if set == 1 {
+        v.push(Tr::new(crate::ext::trace()));
+    }
+    v
+}
