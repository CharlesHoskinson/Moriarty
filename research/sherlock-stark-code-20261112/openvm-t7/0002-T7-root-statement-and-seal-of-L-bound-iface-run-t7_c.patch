-/// The 24 operand words of `L` after the FP-3 table (for the `L_Fr` comparison with the logged
-/// operands of `R`), received from the root statement AIR.
-pub struct RootOpsAir;
-pub const OPS_WORDS: usize = 3 * D;
 
-impl<T> BaseAir<T> for RootOpsAir {
-    fn width(&self) -> usize {
-        OPS_WORDS
+// ---------------------------------------------------------------- `L`: root statement and seal
+/// The child words that `L` takes as key constants rather than columns: the tag (SEG), `h_lo`
+/// (0), `keys_d` and the child `vkc` pre-hash (N3). `root_map()[i]` is the column offset (after
+/// `valid`) of child word `i`, or `None` for a constant.
+pub fn root_map() -> Vec<Option<usize>> {
+    let konst = |i: usize| {
+        i == npv::TAG
+            || (npv::H_LO..npv::H_LO + 4).contains(&i)
+            || (npv::KEYS_D..npv::KEYS_D + D).contains(&i)
+            || (npv::VKC_PRE..npv::VKC_PRE + D).contains(&i)
+    };
+    let mut k = 0;
+    (0..npv::N)
+        .map(|i| {
+            if konst(i) {
+                None
+            } else {
+                k += 1;
+                Some(k - 1)
+            }
+        })
+        .collect()
+}
+
+fn root_const(i: usize, n3_pre: &[u32; 8], keys_d: &[u32; 8]) -> u32 {
+    if i == npv::TAG {
+        STMT_SEG
+    } else if (npv::H_LO..npv::H_LO + 4).contains(&i) {
+        0
+    } else if (npv::KEYS_D..npv::KEYS_D + D).contains(&i) {
+        keys_d[i - npv::KEYS_D]
+    } else {
+        n3_pre[i - npv::VKC_PRE]
     }
 }
