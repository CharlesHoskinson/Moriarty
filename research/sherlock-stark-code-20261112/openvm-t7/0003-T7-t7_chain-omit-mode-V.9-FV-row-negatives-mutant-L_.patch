+fn air_idx<SC: StarkProtocolConfig>(airs: &[AirRef<SC>], name: &str) -> usize {
+    let v: Vec<usize> = airs.iter().enumerate().filter(|(_, a)| a.name().contains(name)).map(|(i, _)| i).collect();
+    assert_eq!(v.len(), 1, "AIR {name}: {:?}", airs.iter().map(|a| a.name()).collect::<Vec<_>>());
+    v[0]
+}
+
+/// `p` with AIR `i` left out (no trace data, no public values).
+fn strip<SC: StarkProtocolConfig>(p: &Proof<SC>, i: usize) -> Proof<SC> {
+    let mut q = p.clone();
+    q.trace_vdata[i] = None;
+    q.public_values[i] = vec![];
+    q
+}
