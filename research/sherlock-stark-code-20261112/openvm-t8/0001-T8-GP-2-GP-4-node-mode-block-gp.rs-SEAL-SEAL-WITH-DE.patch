+// ------------------------------------------------------------------ T8: X7 / N-6 probe
+/// Per-AIR shape of a key against a bound set: every violation, not only the first.
+fn violations<SC: StarkProtocolConfig>(set: &FrozenSet, vk: &MultiStarkVerifyingKey<SC>, names: &[String]) -> Value {
+    let b = &set.bounds;
+    let s = frozen::shape(vk);
+    let mut v = vec![];
+    if s.airs > b.max_airs {
+        v.push(json!({"what": "airs", "got": s.airs, "bound": b.max_airs}));
+    }
+    if s.columns > b.max_columns {
+        v.push(json!({"what": "columns", "got": s.columns, "bound": b.max_columns}));
+    }
+    let mut per = vec![];
+    for (i, a) in vk.inner.per_air.iter().enumerate() {
+        let c = a.symbolic_constraints.constraints.constraint_idx.len();
+        let n = a.symbolic_constraints.interactions.len();
+        let d = a.max_constraint_degree as usize;
+        let w = a.params.width.total_width();
+        let name = names.get(i).cloned().unwrap_or_default();
+        if c > b.max_constraints_per_air {
+            v.push(json!({"what": "constraints", "air": i, "name": name, "got": c, "bound": b.max_constraints_per_air}));
+        }
+        if n > b.max_interactions_per_air {
+            v.push(json!({"what": "interactions", "air": i, "name": name, "got": n, "bound": b.max_interactions_per_air}));
+        }
+        if d > b.max_constraint_degree {
+            v.push(json!({"what": "degree", "air": i, "name": name, "got": d, "bound": b.max_constraint_degree}));
+        }
+        per.push(json!({"air": i, "name": name, "width": w, "constraints": c, "interactions": n, "degree": d}));
+    }
+    json!({"set": set.name, "shape": shape_json(&s), "violations": v, "per_air": per})
+}
+
+/// X7 (N-6 option (a)): the MERGE-WORK node = the universal node (statement AIR, verifier
+/// sub-circuit of two children, sponge) with the inline kernel instantiated from the same leaf
+/// kit AIRs as the app key of chip set 0 (one encoding of the machine relation). Keygen only:
+/// the shape against the internal set decides whether MERGE-WORK fits the node.
+fn x7_probe(out: &PathBuf) {
+    let mut log = vec![];
+    let eng = sh::engine();
+    let app = sh::key(&eng, sl::airs_set(0, 0)).expect("slice app key");
+    let leaf = layer::<1>(&frozen::LEAF_AGG, &app.vk, Kind::Leaf, "leaf<1> chip set 0", &mut log);
+    let n1 = layer::<2>(&frozen::INTERNAL, &leaf.vk, Kind::First, "N1<2> over leaf set 0", &mut log);
+    let n2 = layer::<2>(&frozen::INTERNAL, &n1.vk, Kind::Node, "N2<2> over N1", &mut log);
+    let mut res = vec![];
+    for (label, child) in [("MERGE-WORK node over N1 (N2 position)", &n1.vk), ("MERGE-WORK node over N2 (N3 position)", &n2.vk)] {
+        let engine = Eng::new(frozen::INTERNAL.params());
+        let circuit = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(Arc::new(child.clone()), cfg());
+        let inv = circuit.bus_inventory();
+        let perm = inv.poseidon2_permute_bus;
+        let mut airs: Vec<AirRef<NodeSC>> = vec![Arc::new(StmtAir::new(Kind::Node, inv))];
+        airs.extend(circuit.airs::<NodeSC>());
+        let base = airs.len() + 1;
+        airs.push(Arc::new(PermSpongeAir { perm, height: stmt::sponge_height(&Kind::Node) }));
+        let kernel = sl::airs_set(0, 0);
+        let nk = kernel.len();
+        airs.extend(kernel);
+        let names: Vec<String> = airs.iter().map(|a| a.name()).collect();
+        let (_pk, vk) = frozen::keygen_set(&frozen::INTERNAL, &engine, &airs);
+        let r = violations(&frozen::INTERNAL, &vk, &names);
+        let plain = violations(&frozen::INTERNAL, &n2.vk, &[]);
+        println!(
+            "T8X7 \"{label}\" airs {} columns {} (node alone {} / {}; kernel {} AIRs from index {}) violations {}",
+            r["shape"]["airs"], r["shape"]["columns"], plain["shape"]["airs"], plain["shape"]["columns"], nk, base,
+            r["violations"]
+        );
+        res.push(json!({"key": label, "kernel_airs": nk, "kernel_from": base, "with_kernel": r, "node_alone": plain["shape"]}));
+    }
+    let app_v = violations(&frozen::INTERNAL, &app.vk, &sl::airs_set(0, 0).iter().map(|a| a.name()).collect::<Vec<_>>());
+    println!("T8X7 \"app chip set 0 kernel alone against the internal bounds\" violations {}", app_v["violations"]);
+    let rec = json!({"x7": res, "app_kernel_vs_internal": app_v, "keys": log});
+    fs::write(out.join("x7probe.json"), serde_json::to_string_pretty(&rec).unwrap()).unwrap();
+}
