+//! T8: the GP-2 and GP-4 node modes of the universal node (`Kind::Node`), as a block of the
+//! statement AIR (`stmt.rs` calls [`eval`] and [`fill`]).
+//!
+//! Modes (one-hot `m`, first row only; NodeMode numbers of the `shape_d` preimage in brackets):
+//! - MERGE [0]: the T7 relation (binary SEG merge, unary pass-through), unchanged.
+//! - SEAL [2] `SEG -> SET`: `h_lo = 0`; `post_d` opened as `P2(SHK_SD2, header)`; terminal
+//!   `outcome_tag` in {1, 2, 3}; `deps_d = EMPTY_DEPS`; `outcome_d`, `claim_d =
+//!   P2(SHK_RUN, 1, prog_d, input_d, outcome_d)`, `set_root = P2(SHK_SET_LEAF, claim_d, h_hi)`.
+//!   Slot 1 is off: the admission premise (ADMIT-WORK) is NODE INTEGRATION group 5 work.
+//! - SEAL-WITH-DEPS [3] `SEG + DL -> SET`: the SEAL checks with `deps_d = DL.chain_d` in place
+//!   of `EMPTY_DEPS`; the DL cover is present; the input link when `DL.in_link` is not
+//!   `NO_INPUT_LINK`: `input_d` re-hashed from `(salt, val_d, fuel_lo, fuel_hi, stack_limit)`,
+//!   `in_link = P2(SHK_RUN, 1, prog', input', outcome')`, `outcome' = P2(SHK_OUTCOME_V2, 2, 0,
+//!   val_d)` (the producer Halted with the consumer's input value); output
+//!   `DEP(claim_d, h_hi, cover, in_link)`.
+//! - DL-STEP [4] `SET or SUB (slot 0) + DL or off (slot 1) -> DL` (slot order swapped against the
+//!   relation table: slot 0 is the one slot that is always on): the premise element (absent DL
+//!   only; `prem_root = x`), the input-link element (`in_link` absent and the chain empty; the
+//!   head claim of `x` becomes the link) or the chain element (`chain' = P2(SHK_DEPS, chain,
+//!   c)`); link and chain elements join `R` into the cover (`R` if absent, else `JOIN(cov, R)`).
+//!   The head opening takes a `LEAF(c, n)` or `DEP(c, n, cov, link)` form only.
+//! - DESCEND [5] `SET or SUB -> SUB`: one opening of `x` as `JOIN(l, r)` (left or right) or
+//!   `DEP(c, n, cov, link)` (to `cov`).
+//! - JOIN [6] `SET + SET -> SET`: `P2(SHK_SET_JOIN, l, r)`.
+//!
+//! Every mode outputs `key_root` and `reg_root` of slot 0 and `shape_d =
+//! P2(SHK_SHAPE, T_NODE, mode, slot_bits, key_sel_0, key_sel_1, shape_0, shape_1, work_kind,
+//! work_steps, out_a, out_b)` (GP-4 hook); a disabled slot has `SHAPE_OFF`.
+
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::AirBuilder,
+    p3_field::{Field, PrimeCharacteristicRing, PrimeField32},
+};
+
+use crate::stmt::{call, cat, npv, p2, seq, Call, Digest, F, D, HDR, SHK_DEPS, SHK_OUTCOME_V2, SHK_SD2, STMT_SEG};
+
+// ---------------------------------------------------------------- FP-4 codes (ARCHITECTURE 1.11)
+pub const SHK_IN: u32 = 15;
+pub const SHK_RUN: u32 = 16;
+pub const SHK_CLAIM: u32 = 17;
+pub const SHK_SET_LEAF: u32 = 18;
+pub const SHK_SET_DEP: u32 = 19;
+pub const SHK_SET_JOIN: u32 = 20;
+pub const SHK_SET_FOREIGN: u32 = 21;
+pub const SHK_SET_ADM: u32 = 22;
+/// T9 lead ruling: the next code after the ENC-5 parts (58 to 62).
+pub const SHK_SHAPE: u32 = 63;
+pub const STMT_SET: u32 = 2;
+pub const STMT_SUB: u32 = 3;
+pub const STMT_DL: u32 = 4;
+/// Node types of the `shape_d` preimage (T8 LEAD).
+pub const T_NODE: u32 = 1;
+pub const T_LEAF: u32 = 2;
+pub const T_FOREIGN: u32 = 3;
+pub const T_OFF: u32 = 4;
+/// Key kind numbers of `key_sel` (0 off).
+pub const KSEL_LEAF: u32 = 1;
+pub const KSEL_NODE: u32 = 2;
+
+pub fn empty_deps() -> Digest {
+    p2(SHK_DEPS, &[])
+}
+pub fn no_input_link() -> Digest {
+    p2(SHK_RUN, &[])
+}
+pub fn no_premise() -> Digest {
+    p2(SHK_SET_ADM, &[])
+}
+pub fn shape_off() -> Digest {
+    p2(SHK_SHAPE, &[F::from_u32(T_OFF), F::ZERO])
+}
+/// The absent cover of a DL (T8 LEAD): the zero digest.
+pub const ABSENT: Digest = [F::ZERO; D];
+
+/// Mode bits (column order).
+pub mod m {
+    pub const MERGE: usize = 0;
+    pub const SEAL: usize = 1;
+    pub const SEALD: usize = 2;
+    pub const DL_PREM: usize = 3;
+    pub const DL_LINK_LEAF: usize = 4;
+    pub const DL_LINK_DEP: usize = 5;
+    pub const DL_CHAIN_LEAF: usize = 6;
+    pub const DL_CHAIN_DEP: usize = 7;
+    pub const DESC_JL: usize = 8;
+    pub const DESC_JR: usize = 9;
+    pub const DESC_DEP: usize = 10;
+    pub const JOIN: usize = 11;
+    pub const N: usize = 12;
+    /// NodeMode number of each bit (ARCHITECTURE NODE INTEGRATION `NodeMode` order).
+    pub const CODE: [u32; N] = [0, 2, 3, 4, 4, 4, 4, 4, 5, 5, 5, 6];
+}
+
+/// Call ids of the block (row 0 of a Node; ids 0 to 19 are free in a Node).
+mod id {
+    pub const SD2: u32 = 0;
+    pub const OUT: u32 = 1;
+    pub const RUN: u32 = 2;
+    pub const IN: u32 = 3;
+    pub const OUT2: u32 = 4;
+    pub const RUN2: u32 = 5;
+    pub const LEAF: u32 = 6;
+    pub const DEP: u32 = 7;
+    pub const JOIN: u32 = 8;
+    pub const DEPS: u32 = 9;
+    pub const SHAPE: u32 = 10;
+}
+
+/// Column offsets of the block.
+#[derive(Clone, Debug, Default)]
+pub struct GpCols {
+    pub m: usize,
+    pub sub0: usize,
+    pub x: usize,
+    pub hdr: usize,
+    pub od: usize,
+    pub cl: usize,
+    pub lk: usize,
+    pub inp: usize,
+    pub pp: usize,
+    pub pi: usize,
+    pub po: usize,
+    pub lc: usize,
+    pub ln: usize,
+    pub lo: usize,
+    pub dc: usize,
+    pub dn: usize,
+    pub dcov: usize,
+    pub dlink: usize,
+    pub dout: usize,
+    pub jl: usize,
+    pub jr: usize,
+    pub jo: usize,
+    pub dhc: usize,
+    pub chout: usize,
+    pub pch: usize,
+    pub pcov: usize,
+    pub plink: usize,
+    pub pprem: usize,
+    pub ca: usize,
+    pub cinv: usize,
+    pub jdl: usize,
+    pub dcinv: usize,
+    pub hc: usize,
+    pub tt: usize,
+    pub en1: usize,
+    pub sh1: usize,
+    pub oa: usize,
+    pub ob: usize,
+    pub width: usize,
+}
+
+/// Words of the input preimage: salt 8, `val_d` 8, `fuel_lo` 4, `fuel_hi` 4, `stack_limit` 4.
+pub const INP: usize = 28;
+
+impl GpCols {
+    pub fn new(base: usize) -> Self {
+        let mut w = base;
+        let mut t = |n: usize| {
+            let a = w;
+            w += n;
+            a
+        };
+        let mut c = GpCols::default();
+        c.m = t(m::N);
+        c.sub0 = t(1);
+        c.x = t(D);
+        c.hdr = t(HDR);
+        c.od = t(D);
+        c.cl = t(D);
+        c.lk = t(1);
+        c.inp = t(INP);
+        c.pp = t(D);
+        c.pi = t(D);
+        c.po = t(D);
+        c.lc = t(D);
+        c.ln = t(4);
+        c.lo = t(D);
+        c.dc = t(D);
+        c.dn = t(4);
+        c.dcov = t(D);
+        c.dlink = t(D);
+        c.dout = t(D);
+        c.jl = t(D);
+        c.jr = t(D);
+        c.jo = t(D);
+        c.dhc = t(D);
+        c.chout = t(D);
+        c.pch = t(D);
+        c.pcov = t(D);
+        c.plink = t(D);
+        c.pprem = t(D);
+        c.ca = t(1);
+        c.cinv = t(1);
+        c.jdl = t(1);
+        c.dcinv = t(1);
+        c.hc = t(D);
+        c.tt = t(1);
+        c.en1 = t(1);
+        c.sh1 = t(D);
+        c.oa = t(D);
+        c.ob = t(D);
+        c.width = w - base;
+        c
+    }
+}
+
+fn k<AB: AirBuilder>(v: u32) -> AB::Expr {
+    AB::Expr::from_u32(v)
+}
+fn kd<AB: AirBuilder>(d: &Digest) -> Vec<AB::Expr> {
+    d.iter().map(|x| AB::Expr::from_u32(x.as_canonical_u32())).collect()
+}
+
+fn eqv<AB: AirBuilder>(fr: &mut openvm_stark_backend::p3_air::FilteredAirBuilder<'_, AB>, gate: &AB::Expr, a: &[AB::Expr], b: &[AB::Expr]) {
+    for (x, y) in a.iter().zip(b) {
+        fr.assert_zero(gate.clone() * (x.clone() - y.clone()));
+    }
+}
+fn mux<AB: AirBuilder>(
+    fr: &mut openvm_stark_backend::p3_air::FilteredAirBuilder<'_, AB>,
+    l: &[AB::Expr],
+    en1: &AB::Expr,
+    at: usize,
+    from1: Vec<AB::Expr>,
+    konst: &Digest,
+) {
+    let kk = kd::<AB>(konst);
+    for i in 0..D {
+        fr.assert_eq(l[at + i].clone(), en1.clone() * from1[i].clone() + (AB::Expr::ONE - en1.clone()) * kk[i].clone());
+    }
+}
+
+/// The constraints of the block. `node`: the kind is `Node` (else `Fv`: every mode bit is 0).
+/// `l`, `n`: rows 0 and 1; `e0`, `e1`: the child envelopes (74 words); `en1`: slot 1 on;
+/// `pv`: the public values. Returns the MERGE bit (the T7 merge constraints are gated by it).
+#[allow(clippy::too_many_arguments)]
+pub fn eval<AB: AirBuilder + InteractionBuilder>(
+    builder: &mut AB,
+    g: &GpCols,
+    node: bool,
+    l: &[AB::Expr],
+    n: &[AB::Expr],
+    e0: &[AB::Expr],
+    e1: &[AB::Expr],
+    en1: AB::Expr,
+    pv: &[AB::Expr],
+) -> AB::Expr {
+    let one = AB::Expr::ONE;
+    let zero = AB::Expr::ZERO;
+    let col = |a: usize, len: usize| -> Vec<AB::Expr> { (0..len).map(|i| l[a + i].clone()).collect() };
+    let mb = |i: usize| l[g.m + i].clone();
+    let sq = |i: u32| AB::Expr::from_u32(seq::of(i, 0));
+
+    // mode bits: boolean, zero on every row but the first, sum 1 (Node) or 0 (Fv)
+    let mut sum = zero.clone();
+    for i in 0..m::N {
+        builder.assert_bool(mb(i));
+        builder.when_transition().assert_zero(n[g.m + i].clone());
+        sum += mb(i);
+    }
+    if node {
+        builder.when_first_row().assert_one(sum.clone());
+    } else {
+        builder.assert_zero(sum.clone());
+    }
+    let s = |is: &[usize]| is.iter().fold(zero.clone(), |a, &i| a + mb(i));
+    let seal = s(&[m::SEAL, m::SEALD]);
+    let dl_link = s(&[m::DL_LINK_LEAF, m::DL_LINK_DEP]);
+    let dl_chain = s(&[m::DL_CHAIN_LEAF, m::DL_CHAIN_DEP]);
+    let dl_lc = dl_link.clone() + dl_chain.clone();
+    let dl = dl_lc.clone() + mb(m::DL_PREM);
+    let desc = s(&[m::DESC_JL, m::DESC_JR, m::DESC_DEP]);
+    let head_leaf = s(&[m::DL_LINK_LEAF, m::DL_CHAIN_LEAF]);
+    let head_dep = s(&[m::DL_LINK_DEP, m::DL_CHAIN_DEP]);
+    let lk = l[g.lk].clone();
+    let ca = l[g.ca].clone();
+    builder.assert_bool(lk.clone());
+    builder.assert_bool(ca.clone());
+    builder.assert_bool(l[g.sub0].clone());
+    builder.assert_zero(lk.clone() * (one.clone() - mb(m::SEALD)));
+
+    let pay = |e: &[AB::Expr], off: usize| -> Vec<AB::Expr> { (0..D).map(|i| e[1 + off + i].clone()).collect() };
+    let r_root = pay(e0, 0);
+    let mut fr = builder.when_first_row();
+    // ---- slot 1 copies and the muxed previous DL
+    fr.assert_eq(l[g.en1].clone(), en1.clone());
+    let e1d = |off: usize| pay(e1, off);
+    mux::<AB>(&mut fr, &l, &en1, g.pch, e1d(0), &empty_deps());
+    mux::<AB>(&mut fr, &l, &en1, g.pcov, e1d(8), &ABSENT);
+    mux::<AB>(&mut fr, &l, &en1, g.plink, e1d(16), &no_input_link());
+    mux::<AB>(&mut fr, &l, &en1, g.pprem, e1d(24), &no_premise());
+    // ---- x: set_root of a SET slot 0, sub_root of a SUB slot 0
+    let x = col(g.x, D);
+    let sub0 = l[g.sub0].clone();
+    for i in 0..D {
+        fr.assert_eq(x[i].clone(), r_root[i].clone() + sub0.clone() * (e0[9 + i].clone() - r_root[i].clone()));
+    }
+    let ds = dl.clone() + desc.clone();
+    fr.assert_zero(ds.clone() * (e0[npv::TAG].clone() - k::<AB>(STMT_SET) - sub0.clone()));
+    // slot 1 rules per mode
+    fr.assert_zero((seal.clone() - mb(m::SEALD) + mb(m::DL_PREM) + desc.clone()) * en1.clone());
+    fr.assert_zero((mb(m::SEALD) + mb(m::JOIN)) * (one.clone() - en1.clone()));
+    fr.assert_zero(mb(m::SEALD) * (e1[npv::TAG].clone() - k::<AB>(STMT_DL)));
+    fr.assert_zero(dl.clone() * en1.clone() * (e1[npv::TAG].clone() - k::<AB>(STMT_DL)));
+    fr.assert_zero(mb(m::JOIN) * (e0[npv::TAG].clone() - k::<AB>(STMT_SET)));
+    fr.assert_zero(mb(m::JOIN) * (e1[npv::TAG].clone() - k::<AB>(STMT_SET)));
+    // every enabled child has the output reg_root
+    for i in 0..D {
+        fr.assert_zero(en1.clone() * (e0[npv::REG_ROOT + i].clone() - e1[npv::REG_ROOT + i].clone()));
+    }
+
+    // ---- SEAL and SEAL-WITH-DEPS
+    let hdr = col(g.hdr, HDR);
+    fr.assert_zero(seal.clone() * (e0[npv::TAG].clone() - k::<AB>(STMT_SEG)));
+    for i in 0..4 {
+        fr.assert_zero(seal.clone() * e0[npv::H_LO + i].clone());
+    }
+    let t = hdr[0].clone();
+    fr.assert_eq(l[g.tt].clone(), (t.clone() - one.clone()) * (t.clone() - k::<AB>(2)));
+    fr.assert_zero(seal.clone() * l[g.tt].clone() * (t.clone() - k::<AB>(3)));
+    let deps = hdr[17..25].to_vec();
+    eqv::<AB>(&mut fr, &mb(m::SEAL), &deps, &kd::<AB>(&empty_deps()));
+    eqv::<AB>(&mut fr, &mb(m::SEALD), &deps, &col(g.pch, D));
+    let sumv = |v: Vec<AB::Expr>| v.into_iter().fold(zero.clone(), |a, b| a + b);
+    fr.assert_zero(mb(m::SEALD) * (l[g.dcinv].clone() * sumv(col(g.pcov, D)) - one.clone()));
+    // no link: in_link is NO_INPUT_LINK
+    eqv::<AB>(&mut fr, &(mb(m::SEALD) * (one.clone() - lk.clone())), &col(g.plink, D), &kd::<AB>(&no_input_link()));
+    drop(fr);
+    let post: Vec<AB::Expr> = (0..D).map(|i| e0[npv::POST_D + i].clone()).collect();
+    call(builder, sq(id::SD2), SHK_SD2, hdr.clone(), &post, seal.clone());
+    let mut ow = vec![k::<AB>(2), t.clone() - one.clone()];
+    ow.extend(hdr[1..9].iter().cloned());
+    call(builder, sq(id::OUT), SHK_OUTCOME_V2, ow, &col(g.od, D), seal.clone());
+    let mut rw = vec![one.clone()];
+    rw.extend((0..D).map(|i| e0[npv::PROG_D + i].clone()));
+    rw.extend(hdr[9..17].iter().cloned());
+    rw.extend(col(g.od, D));
+    call(builder, sq(id::RUN), SHK_RUN, rw, &col(g.cl, D), seal.clone());
+    // the input link: input_d re-hash, the Halted wrapper of val_d, the producer claim
+    call(builder, sq(id::IN), SHK_IN, col(g.inp, INP), &hdr[9..17], lk.clone());
+    let mut hw = vec![k::<AB>(2), zero.clone()];
+    hw.extend(col(g.inp + 8, D));
+    call(builder, sq(id::OUT2), SHK_OUTCOME_V2, hw, &col(g.po, D), lk.clone());
+    let mut pw = vec![one.clone()];
+    pw.extend(col(g.pp, D));
+    pw.extend(col(g.pi, D));
+    pw.extend(col(g.po, D));
+    call(builder, sq(id::RUN2), SHK_RUN, pw, &col(g.plink, D), lk.clone());
+
+    // ---- the LEAF, DEP, JOIN and DEPS hash slots
+    let mut fr = builder.when_first_row();
+    let h_hi: Vec<AB::Expr> = (0..4).map(|i| e0[npv::H_HI + i].clone()).collect();
+    eqv::<AB>(&mut fr, &mb(m::SEAL), &col(g.lc, D), &col(g.cl, D));
+    eqv::<AB>(&mut fr, &mb(m::SEAL), &col(g.ln, 4), &h_hi);
+    eqv::<AB>(&mut fr, &head_leaf, &col(g.lo, D), &x);
+    eqv::<AB>(&mut fr, &head_leaf, &col(g.hc, D), &col(g.lc, D));
+    eqv::<AB>(&mut fr, &mb(m::SEALD), &col(g.dc, D), &col(g.cl, D));
+    eqv::<AB>(&mut fr, &mb(m::SEALD), &col(g.dn, 4), &h_hi);
+    eqv::<AB>(&mut fr, &mb(m::SEALD), &col(g.dcov, D), &col(g.pcov, D));
+    eqv::<AB>(&mut fr, &mb(m::SEALD), &col(g.dlink, D), &col(g.plink, D));
+    let dep_open = head_dep.clone() + mb(m::DESC_DEP);
+    eqv::<AB>(&mut fr, &dep_open, &col(g.dout, D), &x);
+    eqv::<AB>(&mut fr, &head_dep, &col(g.hc, D), &col(g.dc, D));
+    // JOIN slot: JOIN mode, DESCEND of a JOIN, the cover join of a DL element
+    eqv::<AB>(&mut fr, &mb(m::JOIN), &col(g.jl, D), &r_root);
+    eqv::<AB>(&mut fr, &mb(m::JOIN), &col(g.jr, D), &e1d(0));
+    eqv::<AB>(&mut fr, &s(&[m::DESC_JL, m::DESC_JR]), &col(g.jo, D), &x);
+    eqv::<AB>(&mut fr, &l[g.jdl].clone(), &col(g.jl, D), &col(g.pcov, D));
+    eqv::<AB>(&mut fr, &l[g.jdl].clone(), &col(g.jr, D), &r_root);
+    fr.assert_eq(l[g.jdl].clone(), dl_lc.clone() * (one.clone() - ca.clone()));
+    // ca = 1: the previous cover is absent (zero); ca = 0: it is present (non-zero sum)
+    for i in 0..D {
+        fr.assert_zero(ca.clone() * l[g.pcov + i].clone());
+    }
+    fr.assert_zero(l[g.jdl].clone() * (l[g.cinv].clone() * sumv(col(g.pcov, D)) - one.clone()));
+    // DEPS slot: the chain element
+    eqv::<AB>(&mut fr, &dl_chain, &col(g.dhc, D), &col(g.hc, D));
+    // link element: no earlier link, empty chain
+    eqv::<AB>(&mut fr, &dl_link, &col(g.plink, D), &kd::<AB>(&no_input_link()));
+    eqv::<AB>(&mut fr, &dl_link, &col(g.pch, D), &kd::<AB>(&empty_deps()));
+    drop(fr);
+    let mut lw = col(g.lc, D);
+    lw.extend(col(g.ln, 4));
+    call(builder, sq(id::LEAF), SHK_SET_LEAF, lw, &col(g.lo, D), mb(m::SEAL) + head_leaf.clone());
+    let mut dw = col(g.dc, D);
+    dw.extend(col(g.dn, 4));
+    dw.extend(col(g.dcov, D));
+    dw.extend(col(g.dlink, D));
+    call(builder, sq(id::DEP), SHK_SET_DEP, dw, &col(g.dout, D), mb(m::SEALD) + dep_open.clone());
+    let mut jw = col(g.jl, D);
+    jw.extend(col(g.jr, D));
+    call(builder, sq(id::JOIN), SHK_SET_JOIN, jw, &col(g.jo, D), mb(m::JOIN) + s(&[m::DESC_JL, m::DESC_JR]) + l[g.jdl].clone());
+    let mut cw = col(g.pch, D);
+    cw.extend(col(g.dhc, D));
+    call(builder, sq(id::DEPS), SHK_DEPS, cw, &col(g.chout, D), dl_chain.clone());
+
+    // ---- the output statement of every mode but MERGE (TAG and the 32 payload words)
+    let mut fr = builder.when_first_row();
+    let zd = vec![zero.clone(); D];
+    let cover_out: Vec<AB::Expr> = (0..D).map(|i| ca.clone() * r_root[i].clone() + (one.clone() - ca.clone()) * l[g.jo + i].clone()).collect();
+    let outs: Vec<(AB::Expr, u32, [Vec<AB::Expr>; 4])> = vec![
+        (mb(m::SEAL), STMT_SET, [col(g.lo, D), zd.clone(), zd.clone(), zd.clone()]),
+        (mb(m::SEALD), STMT_SET, [col(g.dout, D), zd.clone(), zd.clone(), zd.clone()]),
+        (mb(m::DL_PREM), STMT_DL, [kd::<AB>(&empty_deps()), zd.clone(), kd::<AB>(&no_input_link()), x.clone()]),
+        (dl_link.clone(), STMT_DL, [col(g.pch, D), cover_out.clone(), col(g.hc, D), col(g.pprem, D)]),
+        (dl_chain.clone(), STMT_DL, [col(g.chout, D), cover_out.clone(), col(g.plink, D), col(g.pprem, D)]),
+        (mb(m::DESC_JL), STMT_SUB, [r_root.clone(), col(g.jl, D), zd.clone(), zd.clone()]),
+        (mb(m::DESC_JR), STMT_SUB, [r_root.clone(), col(g.jr, D), zd.clone(), zd.clone()]),
+        (mb(m::DESC_DEP), STMT_SUB, [r_root.clone(), col(g.dcov, D), zd.clone(), zd.clone()]),
+        (mb(m::JOIN), STMT_SET, [col(g.jo, D), zd.clone(), zd.clone(), zd.clone()]),
+    ];
+    for (gate, tag, ws) in &outs {
+        fr.assert_zero(gate.clone() * (pv[npv::TAG].clone() - k::<AB>(*tag)));
+        for (q, w) in ws.iter().enumerate() {
+            for i in 0..D {
+                fr.assert_zero(gate.clone() * (pv[1 + 8 * q + i].clone() - w[i].clone()));
+            }
+        }
+    }
+    // key_root and reg_root of slot 0 (MERGE has its own rule)
+    let nm = one.clone() - mb(m::MERGE);
+    if node {
+        for i in 0..D {
+            fr.assert_zero(nm.clone() * (pv[npv::KEY_ROOT + i].clone() - e0[npv::KEY_ROOT + i].clone()));
+            fr.assert_zero(nm.clone() * (pv[npv::REG_ROOT + i].clone() - e0[npv::REG_ROOT + i].clone()));
+        }
+    }
+    // ---- shape_d
+    let off = kd::<AB>(&shape_off());
+    for i in 0..D {
+        fr.assert_eq(l[g.sh1 + i].clone(), en1.clone() * e1[npv::SHAPE_D + i].clone() + (one.clone() - en1.clone()) * off[i].clone());
+    }
+    // out_a, out_b: (h_lo, h_hi) for a SEG output (MERGE), the first two payload digests else
+    // (a SET output has out_b = 0)
+    let oa = col(g.oa, D);
+    let ob = col(g.ob, D);
+    for i in 0..D {
+        let (a, b) = if i < 4 { (pv[npv::H_LO + i].clone(), pv[npv::H_HI + i].clone()) } else { (zero.clone(), zero.clone()) };
+        fr.assert_zero(mb(m::MERGE) * (oa[i].clone() - a));
+        fr.assert_zero(mb(m::MERGE) * (ob[i].clone() - b));
+        fr.assert_zero(nm.clone() * (oa[i].clone() - pv[1 + i].clone()));
+        let set_out = s(&[m::SEAL, m::SEALD, m::JOIN]);
+        fr.assert_zero(set_out.clone() * ob[i].clone());
+        fr.assert_zero((dl.clone() + desc.clone()) * (ob[i].clone() - pv[9 + i].clone()));
+    }
+    drop(fr);
+    let code = (0..m::N).fold(zero.clone(), |a, i| a + mb(i) * k::<AB>(m::CODE[i]));
+    let mut sw = vec![k::<AB>(T_NODE), code, one.clone() + k::<AB>(2) * l[g.en1].clone(), k::<AB>(KSEL_NODE), k::<AB>(KSEL_NODE) * l[g.en1].clone()];
+    sw.extend((0..D).map(|i| e0[npv::SHAPE_D + i].clone()));
+    sw.extend(col(g.sh1, D));
+    sw.push(zero.clone());
+    sw.push(zero.clone());
+    sw.extend(oa);
+    sw.extend(ob);
+    let shape_out: Vec<AB::Expr> = (0..D).map(|i| pv[npv::SHAPE_D + i].clone()).collect();
+    call(builder, sq(id::SHAPE), SHK_SHAPE, sw, &shape_out, sum);
+    mb(m::MERGE)
+}
+
+// ---------------------------------------------------------------- witness and the Rust reference
+/// The opening of `x` (slot 0's set root or sub root) that a mode uses.
+#[derive(Clone, Debug)]
+pub enum Open {
+    None,
+    Leaf { c: Digest, n: [F; 4] },
+    Dep { c: Digest, n: [F; 4], cov: Digest, link: Digest },
+    Join { l: Digest, r: Digest },
+}
+
+/// The input-link witness of SEAL-WITH-DEPS.
+#[derive(Clone, Debug)]
+pub struct Link {
+    /// salt 8, `val_d` 8, `fuel_lo` 4, `fuel_hi` 4, `stack_limit` 4
+    pub inp: Vec<F>,
+    pub prog: Digest,
+    pub input: Digest,
+    pub outcome: Digest,
+}
+
+#[derive(Clone, Debug)]
+pub struct GpWit {
+    pub mode: usize,
+    /// the 41 header words of `post_d` (seal modes)
+    pub hdr: Vec<F>,
+    pub open: Open,
+    pub link: Option<Link>,
+}
+
+impl GpWit {
+    pub fn merge() -> Self {
+        GpWit { mode: m::MERGE, hdr: vec![F::ZERO; HDR], open: Open::None, link: None }
+    }
+}
+
+fn dg(v: &[F], a: usize) -> Digest {
+    v[a..a + D].try_into().unwrap()
+}
+fn pay(e: &[F], off: usize) -> Digest {
+    dg(e, 1 + off)
+}
+pub fn outcome_d(hdr: &[F]) -> Digest {
+    let mut w = vec![F::from_u32(2), hdr[0] - F::ONE];
+    w.extend_from_slice(&hdr[1..9]);
+    p2(SHK_OUTCOME_V2, &w)
+}
+pub fn claim_d(prog: &Digest, input: &Digest, outcome: &Digest) -> Digest {
+    p2(SHK_RUN, &cat(&[&[F::ONE], prog, input, outcome]))
+}
+pub fn halted(val_d: &Digest) -> Digest {
+    p2(SHK_OUTCOME_V2, &cat(&[&[F::from_u32(2), F::ZERO], val_d]))
+}
+pub fn set_leaf(c: &Digest, n: &[F]) -> Digest {
+    p2(SHK_SET_LEAF, &cat(&[c, n]))
+}
+pub fn set_dep(c: &Digest, n: &[F], cov: &Digest, link: &Digest) -> Digest {
+    p2(SHK_SET_DEP, &cat(&[c, n, cov, link]))
+}
+pub fn set_join(l: &Digest, r: &Digest) -> Digest {
+    p2(SHK_SET_JOIN, &cat(&[l, r]))
+}
+pub fn deps_step(ch: &Digest, c: &Digest) -> Digest {
+    p2(SHK_DEPS, &cat(&[ch, c]))
+}
+
+/// Fill the block of row 0 and push its calls; returns the output words 0 to 32 (TAG and the
+/// payload) of a non-MERGE mode (`None` for MERGE: the T7 merge output stands), and the
+/// `shape_d` given the full output envelope `out` (computed by the caller after the payload).
+pub fn fill(row: &mut [F], g: &GpCols, e0: &[F], e1: Option<&[F]>, w: &GpWit, calls: &mut Vec<Call>) -> Option<Vec<F>> {
+    let put = |row: &mut [F], at: usize, v: &[F]| row[at..at + v.len()].copy_from_slice(v);
+    let sqr = |i: u32| seq::of(i, 0);
+    row[g.m + w.mode] = F::ONE;
+    let en1 = e1.is_some();
+    row[g.en1] = F::from_bool(en1);
+    let e1d = |off: usize, k: Digest| e1.map(|e| pay(e, off)).unwrap_or(k);
+    let (pch, pcov, plink, pprem) = (e1d(0, empty_deps()), e1d(8, ABSENT), e1d(16, no_input_link()), e1d(24, no_premise()));
+    put(row, g.pch, &pch);
+    put(row, g.pcov, &pcov);
+    put(row, g.plink, &plink);
+    put(row, g.pprem, &pprem);
+    let r = pay(e0, 0);
+    let sub0 = e0[npv::TAG] == F::from_u32(STMT_SUB);
+    row[g.sub0] = F::from_bool(sub0);
+    let x = if sub0 { pay(e0, 8) } else { r };
+    put(row, g.x, &x);
+    let hdr = &w.hdr;
+    put(row, g.hdr, hdr);
+    let t = hdr[0];
+    row[g.tt] = (t - F::ONE) * (t - F::from_u32(2));
+    let h_hi: Vec<F> = e0[npv::H_HI..npv::H_HI + 4].to_vec();
+    let mut out = vec![F::ZERO; 33];
+    let ca = pcov == ABSENT;
+    let is = |ms: &[usize]| ms.contains(&w.mode);
+    if is(&[m::SEAL, m::SEALD]) {
+        calls.push(Call { seq: sqr(id::SD2), tag: SHK_SD2, words: hdr.clone() });
+        let od = outcome_d(hdr);
+        let mut ow = vec![F::from_u32(2), t - F::ONE];
+        ow.extend_from_slice(&hdr[1..9]);
+        calls.push(Call { seq: sqr(id::OUT), tag: SHK_OUTCOME_V2, words: ow });
+        put(row, g.od, &od);
+        let input: Digest = dg(hdr, 9);
+        let cl = claim_d(&dg(e0, npv::PROG_D), &input, &od);
+        calls.push(Call { seq: sqr(id::RUN), tag: SHK_RUN, words: cat(&[&[F::ONE], &dg(e0, npv::PROG_D), &input, &od]) });
+        put(row, g.cl, &cl);
+        if w.mode == m::SEAL {
+            put(row, g.lc, &cl);
+            put(row, g.ln, &h_hi);
+            let lo = set_leaf(&cl, &h_hi);
+            put(row, g.lo, &lo);
+            calls.push(Call { seq: sqr(id::LEAF), tag: SHK_SET_LEAF, words: cat(&[&cl, &h_hi]) });
+            out[0] = F::from_u32(STMT_SET);
+            out[1..9].copy_from_slice(&lo);
+        } else {
+            let s: F = pcov.iter().copied().sum();
+            row[g.dcinv] = if s == F::ZERO { F::ZERO } else { s.inverse() };
+            put(row, g.dc, &cl);
+            put(row, g.dn, &h_hi);
+            put(row, g.dcov, &pcov);
+            put(row, g.dlink, &plink);
+            let d = set_dep(&cl, &h_hi, &pcov, &plink);
+            put(row, g.dout, &d);
+            calls.push(Call { seq: sqr(id::DEP), tag: SHK_SET_DEP, words: cat(&[&cl, &h_hi, &pcov, &plink]) });
+            if let Some(lw) = &w.link {
+                row[g.lk] = F::ONE;
+                put(row, g.inp, &lw.inp);
+                calls.push(Call { seq: sqr(id::IN), tag: SHK_IN, words: lw.inp.clone() });
+                let val: Digest = dg(&lw.inp, 8);
+                let po = lw.outcome;
+                put(row, g.po, &po);
+                calls.push(Call { seq: sqr(id::OUT2), tag: SHK_OUTCOME_V2, words: cat(&[&[F::from_u32(2), F::ZERO], &val]) });
+                put(row, g.pp, &lw.prog);
+                put(row, g.pi, &lw.input);
+                calls.push(Call { seq: sqr(id::RUN2), tag: SHK_RUN, words: cat(&[&[F::ONE], &lw.prog, &lw.input, &po]) });
+            }
+            out[0] = F::from_u32(STMT_SET);
+            out[1..9].copy_from_slice(&d);
+        }
+    }
+    // head opening and the DESCEND openings
+    let mut hc = [F::ZERO; D];
+    match &w.open {
+        Open::Leaf { c, n } => {
+            put(row, g.lc, c);
+            put(row, g.ln, n);
+            put(row, g.lo, &set_leaf(c, n));
+            calls.push(Call { seq: sqr(id::LEAF), tag: SHK_SET_LEAF, words: cat(&[c, n]) });
+            hc = *c;
+        }
+        Open::Dep { c, n, cov, link } => {
+            put(row, g.dc, c);
+            put(row, g.dn, n);
+            put(row, g.dcov, cov);
+            put(row, g.dlink, link);
+            put(row, g.dout, &set_dep(c, n, cov, link));
+            calls.push(Call { seq: sqr(id::DEP), tag: SHK_SET_DEP, words: cat(&[c, n, cov, link]) });
+            hc = *c;
+        }
+        Open::Join { l, r: rr } => {
+            put(row, g.jl, l);
+            put(row, g.jr, rr);
+            put(row, g.jo, &set_join(l, rr));
+            calls.push(Call { seq: sqr(id::JOIN), tag: SHK_SET_JOIN, words: cat(&[l, rr]) });
+        }
+        Open::None => {}
+    }
+    put(row, g.hc, &hc);
+    let lc_modes = [m::DL_LINK_LEAF, m::DL_LINK_DEP, m::DL_CHAIN_LEAF, m::DL_CHAIN_DEP];
+    if is(&lc_modes) {
+        row[g.ca] = F::from_bool(ca);
+        let cover = if ca {
+            r
+        } else {
+            let s: F = pcov.iter().copied().sum();
+            row[g.cinv] = if s == F::ZERO { F::ZERO } else { s.inverse() };
+            row[g.jdl] = F::ONE;
+            put(row, g.jl, &pcov);
+            put(row, g.jr, &r);
+            let j = set_join(&pcov, &r);
+            put(row, g.jo, &j);
+            calls.push(Call { seq: sqr(id::JOIN), tag: SHK_SET_JOIN, words: cat(&[&pcov, &r]) });
+            j
+        };
+        out[0] = F::from_u32(STMT_DL);
+        out[9..17].copy_from_slice(&cover);
+        out[25..33].copy_from_slice(&pprem);
+        if is(&[m::DL_LINK_LEAF, m::DL_LINK_DEP]) {
+            out[1..9].copy_from_slice(&pch);
+            out[17..25].copy_from_slice(&hc);
+        } else {
+            put(row, g.dhc, &hc);
+            let ch = deps_step(&pch, &hc);
+            put(row, g.chout, &ch);
+            calls.push(Call { seq: sqr(id::DEPS), tag: SHK_DEPS, words: cat(&[&pch, &hc]) });
+            out[1..9].copy_from_slice(&ch);
+            out[17..25].copy_from_slice(&plink);
+        }
+    }
+    match w.mode {
+        m::DL_PREM => {
+            out[0] = F::from_u32(STMT_DL);
+            out[1..9].copy_from_slice(&empty_deps());
+            out[17..25].copy_from_slice(&no_input_link());
+            out[25..33].copy_from_slice(&x);
+        }
+        m::DESC_JL | m::DESC_JR | m::DESC_DEP => {
+            out[0] = F::from_u32(STMT_SUB);
+            out[1..9].copy_from_slice(&r);
+            let to = match (&w.open, w.mode) {
+                (Open::Join { l, .. }, m::DESC_JL) => *l,
+                (Open::Join { r: rr, .. }, m::DESC_JR) => *rr,
+                (Open::Dep { cov, .. }, m::DESC_DEP) => *cov,
+                _ => panic!("DESCEND: opening does not fit the mode"),
+            };
+            out[9..17].copy_from_slice(&to);
+        }
+        m::JOIN => {
+            let rr = pay(e1.expect("JOIN: slot 1"), 0);
+            put(row, g.jl, &r);
+            put(row, g.jr, &rr);
+            let j = set_join(&r, &rr);
+            put(row, g.jo, &j);
+            calls.push(Call { seq: sqr(id::JOIN), tag: SHK_SET_JOIN, words: cat(&[&r, &rr]) });
+            out[0] = F::from_u32(STMT_SET);
+            out[1..9].copy_from_slice(&j);
+        }
+        _ => {}
+    }
+    let sh1 = e1.map(|e| dg(e, npv::SHAPE_D)).unwrap_or(shape_off());
+    put(row, g.sh1, &sh1);
+    if w.mode == m::MERGE {
+        None
+    } else {
+        Some(out)
+    }
+}
+
+/// `shape_d` of the output envelope `env` (74 words) for mode bit `mode`; fills `out_a`, `out_b`
+/// and pushes the call.
+pub fn shape(row: &mut [F], g: &GpCols, mode: usize, e0: &[F], e1: Option<&[F]>, env: &[F], calls: &mut Vec<Call>) -> Digest {
+    let mut oa = [F::ZERO; D];
+    let mut ob = [F::ZERO; D];
+    if mode == m::MERGE {
+        oa[..4].copy_from_slice(&env[npv::H_LO..npv::H_LO + 4]);
+        ob[..4].copy_from_slice(&env[npv::H_HI..npv::H_HI + 4]);
+    } else {
+        oa.copy_from_slice(&env[1..9]);
+        if !matches!(mode, m::SEAL | m::SEALD | m::JOIN) {
+            ob.copy_from_slice(&env[9..17]);
+        }
+    }
+    row[g.oa..g.oa + D].copy_from_slice(&oa);
+    row[g.ob..g.ob + D].copy_from_slice(&ob);
+    let en1 = e1.is_some();
+    let sh1 = e1.map(|e| dg(e, npv::SHAPE_D)).unwrap_or(shape_off());
+    let mut w = vec![
+        F::from_u32(T_NODE),
+        F::from_u32(m::CODE[mode]),
+        F::from_u32(1 + 2 * en1 as u32),
+        F::from_u32(KSEL_NODE),
+        F::from_u32(KSEL_NODE * en1 as u32),
+    ];
+    w.extend_from_slice(&dg(e0, npv::SHAPE_D));
+    w.extend_from_slice(&sh1);
+    w.push(F::ZERO);
+    w.push(F::ZERO);
+    w.extend_from_slice(&oa);
+    w.extend_from_slice(&ob);
+    let d = p2(SHK_SHAPE, &w);
+    calls.push(Call { seq: seq::of(id::SHAPE, 0), tag: SHK_SHAPE, words: w });
+    d
+}
