+// ------------------------------------------------------------------ T8: GP-2 / GP-4 node modes
+use sherlock_lfr::gp::{self, m as gm, GpWit, Link, Open};
+
+impl Keys {
+    /// The N3 SEG root of program `p` (2 shards, leaf, N1 binary, N2 unary, N3 unary).
+    fn seg_root(&self, p: &sl::Program) -> Proof<NodeSC> {
+        let sets = vec![0usize; sl::shards(p).len()];
+        let (app_p, _) = self.app_proofs(p, &sets);
+        let leaf_p: Vec<_> = app_p.iter().map(|q| self.leaf[0].prove(&self.app[0].vk, std::slice::from_ref(q), &Wit::Leaf)).collect();
+        let n1 = self.n1[0].prove(&self.leaf[0].vk, &leaf_p, &self.first_wit(p, &sets));
+        let n2 = self.n2.prove(&self.n1[0].vk, std::slice::from_ref(&n1), &self.node_wit(&self.table.node[0]));
+        self.n3.prove(&self.n2.vk, std::slice::from_ref(&n2), &self.node_wit(&self.table.node[1]))
+    }
+    /// A node over N3 children (the fixed point: the N3 key, the N3-over-N3 row) in mode `w`.
+    fn over3(&self, kids: &[Proof<NodeSC>], w: GpWit, tamper: Option<&dyn Fn(&mut Vec<F>)>, mutant: bool) -> (Option<Proof<NodeSC>>, Result<(), String>) {
+        let wit = Wit::NodeGp { tbl: self.table.clone(), sel: 3, gp: w };
+        self.n3.prove_try(&self.n3.vk, kids, &wit, tamper, mutant)
+    }
+}
+
+fn gw(mode: usize, open: Open) -> GpWit {
+    GpWit { mode, hdr: vec![F::ZERO; stmt::HDR], open, link: None }
+}
+fn pvd(p: &Proof<NodeSC>, a: usize) -> Dg {
+    stmt::dig(&p.public_values[0], a)
+}
+fn hh(p: &Proof<NodeSC>) -> [F; 4] {
+    p.public_values[0][stmt::npv::H_HI..stmt::npv::H_HI + 4].try_into().unwrap()
+}
+
+/// X12 on real proofs: SEAL, JOIN, DESCEND, DL-STEP and SEAL-WITH-DEPS in the universal node
+/// over N3 roots of programs A and B, with the named refusals of the GP-2 hook.
+fn gp2(out: &PathBuf) {
+    let t0 = Instant::now();
+    let mut cases = Cases(vec![]);
+    let k = keys();
+    let pa = sl::program_of(k.key_root, sl::Prog::A);
+    let pb = sl::program_of(k.key_root, sl::Prog::B);
+    let a3 = k.seg_root(&pa);
+    let b3 = k.seg_root(&pb);
+    let (ha, hb) = (hdr_of(&pa), hdr_of(&pb));
+    let seal_w = |h: &Vec<F>| GpWit { mode: gm::SEAL, hdr: h.clone(), open: Open::None, link: None };
+    let claim = |p: &sl::Program, h: &[F]| gp::claim_d(&p.adm.prog_d(), &stmt::dig(h, 9), &gp::outcome_d(h));
+    let (ca, cb) = (claim(&pa, &ha), claim(&pb, &hb));
+    let mut stmts = vec![];
+    let mut keep = |name: &str, p: &Proof<NodeSC>, stmts: &mut Vec<Value>| stmts.push(json!({"name": name, "statement": statement(p)}));
+
+    // ---- SEAL: SEG -> SET LEAF(claim_d, n_steps)
+    let (sa, r) = k.over3(std::slice::from_ref(&a3), seal_w(&ha), None, false);
+    cases.rec("pos_gp2_seal_A", true, r, "SEAL of program A's N3 SEG root (h_lo 0, terminal Rejected, deps EMPTY)");
+    let (sb, r) = k.over3(std::slice::from_ref(&b3), seal_w(&hb), None, false);
+    cases.rec("pos_gp2_seal_B", true, r, "SEAL of program B");
+    let (sa, sb) = (sa.expect("seal A"), sb.expect("seal B"));
+    let (la, lb) = (pvd(&sa, 1), pvd(&sb, 1));
+    assert_eq!(la, gp::set_leaf(&ca, &hh(&a3)), "SET LEAF of A");
+    keep("seal_A", &sa, &mut stmts);
+    let mut wt = seal_w(&ha);
+    wt.hdr[0] = F::ZERO;
+    let (_, r) = k.over3(std::slice::from_ref(&a3), wt, None, true);
+    cases.rec("claim_consume_unsealed_segment", false, r, "SEAL of a Running header (outcome_tag 0)");
+    let mut wt = seal_w(&ha);
+    wt.hdr[17] += F::ONE;
+    let (_, r) = k.over3(std::slice::from_ref(&a3), wt, None, true);
+    cases.rec("seal_header_not_post_d", false, r, "SEAL with a deps_d word changed against post_d");
+    let (_, r) = k.over3(std::slice::from_ref(&a3), seal_w(&ha), Some(&|v: &mut Vec<F>| v[1 + 8] += F::ONE), true);
+    cases.rec("claim_nsteps_forged_in_set_leaf", false, r, "SEAL output word after set_root changed (payload must be zero)");
+    let (_, r) = k.over3(std::slice::from_ref(&a3), seal_w(&ha), Some(&|v: &mut Vec<F>| v[1] += F::ONE), true);
+    cases.rec("claim_swap_outcome", false, r, "SEAL output set_root word changed (another claim or n_steps)");
+
+    // ---- JOIN: SET + SET -> SET
+    let (j, r) = k.over3(&[sa.clone(), sb.clone()], gw(gm::JOIN, Open::None), None, false);
+    cases.rec("pos_gp2_join_A_B", true, r, "JOIN(LEAF(A), LEAF(B))");
+    let j = j.expect("join");
+    let jr = pvd(&j, 1);
+    assert_eq!(jr, gp::set_join(&la, &lb));
+    let (_, r) = k.over3(&[sa.clone(), a3.clone()], gw(gm::JOIN, Open::None), None, true);
+    cases.rec("join_set_with_segment_refused", false, r, "JOIN of a SET and a SEG");
+
+    // ---- DESCEND: JOIN root -> SUB(J, LA) and SUB(J, LB)
+    let jo = Open::Join { l: la, r: lb };
+    let (dl_a, r) = k.over3(std::slice::from_ref(&j), gw(gm::DESC_JL, jo.clone()), None, false);
+    cases.rec("pos_gp2_descend_join_left", true, r, "DESCEND left from JOIN(A, B): SUB(J, LEAF(A))");
+    let (dr_b, r) = k.over3(std::slice::from_ref(&j), gw(gm::DESC_JR, jo.clone()), None, false);
+    cases.rec("pos_gp2_descend_join_right", true, r, "DESCEND right: SUB(J, LEAF(B))");
+    let (sub_a, sub_b) = (dl_a.expect("desc l"), dr_b.expect("desc r"));
+    let (_, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DESC_JL, Open::Join { l: la, r: lb }), None, true);
+    cases.rec("claim_descend_wrong_domain", false, r, "a LEAF root opened as a JOIN");
+    let (_, r) = k.over3(std::slice::from_ref(&j), gw(gm::DESC_JL, Open::Join { l: lb, r: la }), None, true);
+    cases.rec("claim_sub_root_unrelated", false, r, "DESCEND with a JOIN preimage other than the root's");
+
+    // ---- DL-STEP: chain element (head claim of SUB(J, LA)), link element, premise element
+    let (dlc, r) = k.over3(std::slice::from_ref(&sub_a), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, false);
+    cases.rec("pos_gp2_claim_from_join_left", true, r, "DL-STEP chain element: claim A from SUB(J, LEAF(A)), cover J");
+    let dlc = dlc.expect("dl chain");
+    assert_eq!(pvd(&dlc, 1), gp::deps_step(&gp::empty_deps(), &ca), "chain_d");
+    assert_eq!(pvd(&dlc, 9), jr, "cover = J");
+    let (dlc2, r) = k.over3(&[sub_b.clone(), dlc.clone()], gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: cb, n: hh(&b3) }), None, false);
+    cases.rec("pos_gp2_chain_two_elements", true, r, "DL-STEP over a DL: chain [A, B], cover JOIN(J, J)");
+    if let Some(d2) = &dlc2 {
+        assert_eq!(pvd(d2, 1), gp::deps_step(&gp::deps_step(&gp::empty_deps(), &ca), &cb));
+        assert_eq!(pvd(d2, 9), gp::set_join(&jr, &jr));
+    }
+    let (dla, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, false);
+    cases.rec("pos_gp2_claim_from_own_seal", true, r, "DL-STEP chain element from A's own sealed SET (zero DESCEND steps)");
+    let (dlr, r) = k.over3(&[sa.clone(), dla.clone().expect("dl own")], gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, false);
+    cases.rec("pos_gp2_repeated_consumption", true, r, "the same claim twice: chain [A, A] (node relation)");
+    let _ = dlr;
+    let (_, r) = k.over3(std::slice::from_ref(&j), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, true);
+    cases.rec("claim_head_of_join", false, r, "a JOIN root offered as if it had a head claim");
+    let (_, r) = k.over3(std::slice::from_ref(&a3), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, true);
+    cases.rec("claim_consume_segment_as_set", false, r, "DL-STEP over a SEG root (a segment never consumed)");
+    let (_, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: cb, n: hh(&a3) }), None, true);
+    cases.rec("claim_wrong_set_root", false, r, "head claim B offered from LEAF(A)");
+    let (_, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), Some(&|v: &mut Vec<F>| v[1] += F::ONE), true);
+    cases.rec("claim_chain_reordered", false, r, "chain_d output word changed");
+    if let Some(d2) = &dlc2 {
+        // drop a dependency: the two-element DL with the first element left out of the chain
+        let (_, r) = k.over3(&[sub_b.clone(), dlc.clone()], gw(gm::DL_CHAIN_LEAF, Open::Leaf { c: cb, n: hh(&b3) }), Some(&|v: &mut Vec<F>| {
+            let c: Dg = gp::deps_step(&gp::empty_deps(), &stmt::dig(v, 1));
+            let _ = c;
+            let one = gp::deps_step(&gp::empty_deps(), &gp::empty_deps());
+            v[1..9].copy_from_slice(&one);
+        }), true);
+        cases.rec("claim_drop_dependency", false, r, "DL output chain without the earlier element");
+        let _ = d2;
+    }
+    // link element: the head claim of A as the input link
+    let (dll, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DL_LINK_LEAF, Open::Leaf { c: ca, n: hh(&a3) }), None, false);
+    cases.rec("pos_gp2_dl_link_element", true, r, "DL-STEP input-link element: in_link = claim A, cover LEAF(A)");
+    let dll = dll.expect("dl link");
+    let (_, r) = k.over3(&[sb.clone(), dlc.clone()], gw(gm::DL_LINK_LEAF, Open::Leaf { c: cb, n: hh(&b3) }), None, true);
+    cases.rec("claim_link_after_chain_refused", false, r, "input-link element after a chain element");
+    let (dlp, r) = k.over3(std::slice::from_ref(&sa), gw(gm::DL_PREM, Open::None), None, false);
+    cases.rec("pos_gp2_dl_premise_element", true, r, "DL-STEP premise element (prem_root = x; chain, cover, link unchanged)");
+    let (_, r) = k.over3(&[sa.clone(), dlc.clone()], gw(gm::DL_PREM, Open::None), None, true);
+    cases.rec("claim_premise_after_element", false, r, "premise element after another element");
+
+    // ---- SEAL-WITH-DEPS: consumer B
+    let sd = |link: Option<Link>| GpWit { mode: gm::SEALD, hdr: hb.clone(), open: Open::None, link };
+    let (_, r) = k.over3(&[b3.clone(), dlc.clone()], sd(None), None, true);
+    cases.rec("claim_seal_undischarged_deps", false, r, "B (deps_d EMPTY) sealed with a DL whose chain is [A]");
+    if let Some(dp) = &dlp {
+        let (_, r) = k.over3(&[b3.clone(), dp.clone()], sd(None), None, true);
+        cases.rec("probe_seal_deps_premise_only", false, r, "SEAL-WITH-DEPS from a premise-only DL (cover absent)");
+    }
+    // the input link to A: A is Rejected, so no Halted wrapper opens to its outcome
+    let inb = pb.adm.input_words();
+    let val: Dg = stmt::dig(&inb, 8);
+    let ina: Dg = stmt::dig(&ha, 9);
+    let (_, r) = k.over3(&[b3.clone(), dll.clone()], sd(Some(Link { inp: inb.clone(), prog: pa.adm.prog_d(), input: ina, outcome: gp::halted(&val) })), None, true);
+    cases.rec("claim_input_link_rejected_producer", false, r, "B linked to A, A's claim re-hashed with a Halted outcome it does not have");
+    let (_, r) = k.over3(&[b3.clone(), dll.clone()], sd(Some(Link { inp: inb.clone(), prog: pa.adm.prog_d(), input: ina, outcome: gp::outcome_d(&ha) })), None, true);
+    cases.rec("claim_rejected_as_value", false, r, "B linked to A with A's true (Rejected) outcome: not the Halted wrapper of B's val_d");
+    let (_, r) = k.over3(&[b3.clone(), dll.clone()], sd(None), None, true);
+    cases.rec("claim_skip_value_opening", false, r, "B with a link DL sealed without the link check (lk = 0)");
+    let mut inx = inb.clone();
+    inx[8] += F::ONE;
+    let (_, r) = k.over3(&[b3.clone(), dll.clone()], sd(Some(Link { inp: inx, prog: pa.adm.prog_d(), input: ina, outcome: gp::halted(&val) })), None, true);
+    cases.rec("claim_input_link_value_mismatch", false, r, "input_d re-hashed from another val_d");
+    let (_, r) = k.over3(&[b3.clone()], seal_w(&hb), Some(&|v: &mut Vec<F>| v[stmt::npv::SHAPE_D] += F::ONE), true);
+    cases.rec("graph_shape_word_forged", false, r, "SEAL output shape_d changed");
+    let (_, r) = k.over3(&[b3.clone()], seal_w(&hb), Some(&|v: &mut Vec<F>| v[stmt::npv::KEY_ROOT] += F::ONE), true);
+    cases.rec("node_key_root_forged", false, r, "SEAL output key_root changed");
+
+    // ---- the T7 MERGE relation still holds in the universal node, and GP-4 shapes differ by mode
+    let sh = |p: &Proof<NodeSC>| dhex(&pvd(p, stmt::npv::SHAPE_D));
+    let shapes = json!({"seg_A": sh(&a3), "seal_A": sh(&sa), "join": sh(&j), "sub_A": sh(&sub_a), "dl_chain": sh(&dlc), "shape_off": dhex(&gp::shape_off())});
+    let distinct = {
+        let v: Vec<String> = ["seg_A", "seal_A", "join", "sub_A", "dl_chain"].iter().map(|n| shapes[*n].as_str().unwrap().to_string()).collect();
+        let mut u = v.clone();
+        u.sort();
+        u.dedup();
+        u.len() == v.len()
+    };
+    cases.rec("pos_gp4_shape_bound_per_mode", if distinct { true } else { false }, if distinct { Ok(()) } else { Err("two modes share a shape_d".into()) }, "shape_d differs for SEG, SEAL, JOIN, SUB and DL outputs");
+    keep("join", &j, &mut stmts);
+    keep("dl_chain", &dlc, &mut stmts);
+    let all = cases.0.iter().all(|c| c["pass"].as_bool().unwrap());
+    fs::write(out.join("gp2.json"), serde_json::to_string_pretty(&json!({"all_pass": all, "cases": cases.0, "statements": stmts, "shapes": shapes, "keys": k.log,
+        "key_root": dhex(&k.key_root), "keys_d": dhex(&k.table.keys_d()), "wall_s": t0.elapsed().as_secs_f64()})).unwrap()).unwrap();
+    println!("T8GP2 all_pass={all} cases={}", cases.0.len());
+    assert!(all, "a T8 GP-2 case did not behave as expected");
+}
