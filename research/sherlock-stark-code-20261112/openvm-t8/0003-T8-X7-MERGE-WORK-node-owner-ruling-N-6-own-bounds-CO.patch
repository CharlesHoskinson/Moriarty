+/// Run `f` with the bus offset `off` (restored after).
+pub fn with_off<T>(off: BusIndex, f: impl FnOnce() -> T) -> T {
+    let prev = OFF.with(|o| o.replace(off));
+    let r = f();
+    OFF.with(|o| o.set(prev));
+    r
+}
+pub fn chip(id: BusIndex) -> BusIndex {
+    BUS_BASE + OFF.with(|o| o.get()) + id
+}
+pub fn port(j: BusIndex) -> BusIndex {
