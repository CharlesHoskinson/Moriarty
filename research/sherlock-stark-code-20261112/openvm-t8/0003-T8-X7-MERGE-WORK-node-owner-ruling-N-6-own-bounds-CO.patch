+/// T8 (X7, owner ruling N-6 "own bounds"): the inline kernel of a MERGE-WORK node. Chip set 0
+/// with CORE split in two ([`CoreAir::split`] and [`crate::core::FrameAir`]); the same kit
+/// functions as the leaf, and the same traces (FRAME copies the CORE rows).
+pub fn airs_kernel(weak: u64) -> Vec<AirRef<SC>> {
+    let off = crate::bus::KERNEL_OFF;
+    crate::bus::with_off(off, || {
+        vec![
+            Arc::new(Rebus { inner: CoreAir::split(weak), off }) as AirRef<SC>,
+            Arc::new(Rebus { inner: crate::core::FrameAir::new(), off }),
+            Arc::new(Rebus { inner: DecAir, off }),
+            Arc::new(Rebus { inner: VariableRangeCheckerAir::new(bus::range()), off }),
+            Arc::new(Rebus { inner: SpongeAir::new(weak), off }),
+            Arc::new(Rebus { inner: Hash2Air { weak }, off }),
+            Arc::new(Rebus { inner: RomAir { weak }, off }),
+            Arc::new(Rebus { inner: MemAir { weak }, off }),
+        ]
+    })
+}
+
+/// A kit AIR with its buses moved by `off` (T8, X7): the same AIR and the same constraints, the
+/// bus indices of the kit helpers read the offset while it is evaluated.
+pub struct Rebus<A> {
+    pub inner: A,
+    pub off: u16,
+}
+impl<T, A: BaseAir<T>> BaseAir<T> for Rebus<A> {
+    fn width(&self) -> usize {
+        self.inner.width()
+    }
+}
+impl<T, A: BaseAirWithPublicValues<T>> BaseAirWithPublicValues<T> for Rebus<A> {
+    fn num_public_values(&self) -> usize {
+        self.inner.num_public_values()
+    }
+}
+impl<T, A: PartitionedBaseAir<T>> PartitionedBaseAir<T> for Rebus<A> {}
+impl<AB: AirBuilder, A: Air<AB>> Air<AB> for Rebus<A> {
+    fn eval(&self, builder: &mut AB) {
+        crate::bus::with_off(self.off, || self.inner.eval(builder))
+    }
+}
