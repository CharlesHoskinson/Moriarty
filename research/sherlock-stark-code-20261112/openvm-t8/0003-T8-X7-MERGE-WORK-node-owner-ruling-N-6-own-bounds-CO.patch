+/// FRAME columns of a CORE row: the one-hot row index, the state words, the five selectors.
+pub const FRAME_W: usize = HEIGHT + SW + 5;
+pub fn frame_col(i: usize) -> usize {
+    if i < HEIGHT {
+        C_B + i
+    } else if i < HEIGHT + SW {
+        C_ST + i - HEIGHT
+    } else {
+        C_SEL + i - HEIGHT - SW
+    }
+}
+
+/// The frame rule of CORE (one function for the whole CORE and for [`FrameAir`]).
+pub fn frame_rule<AB: AirBuilder>(
+    builder: &mut AB,
+    o: &Off,
+    st: &dyn Fn(usize) -> AB::Expr,
+    nst: &dyn Fn(usize) -> AB::Expr,
+    sel: &dyn Fn(usize) -> AB::Expr,
+    slot: AB::Expr,
+) {
+    let ctr = o.counters();
+    let hlp: Vec<usize> = o.hlp.clone().collect();
+    let res: Vec<usize> = o.res.clone().collect();
+    let ctl: Vec<usize> = o.ctl_span.clone().collect();
+    let h11 = o.hlp_lane[11];
+    let writes = |w: usize| -> Vec<usize> {
+        let mut v = vec![];
+        if hlp.contains(&w) {
+            v.extend([R_ENTRY, R_FAILURE]);
+            if w == h11 {
+                v.push(R_EMPTY);
+            }
+        }
+        if res.contains(&w) {
+            v.extend([R_FAILURE, R_ABSENT]);
+        }
+        if ctl.contains(&w) {
+            v.push(R_ABSENT);
+        }
+        if w == OT || (OP..OP + D).contains(&w) {
+            v.push(R_PUBLISH);
+        }
+        v
+    };
+    for w in 0..SW {
+        if ctr.contains(&w) {
+            continue;
+        }
+        let keep = writes(w).iter().fold(slot.clone(), |a, &r| a - sel(r));
+        builder.when_transition().assert_zero((nst(w) - st(w)) * keep);
+    }
+}
+
+/// Send one CORE row to FRAME in chunks of [`bus::FRAME_CHUNK`] words (count 1 on every row).
+pub fn send_frame<AB: AirBuilder<F = F> + InteractionBuilder>(builder: &mut AB, row: &[AB::Expr]) {
+    for (k, ch) in row.chunks(bus::FRAME_CHUNK).enumerate() {
+        let mut m = vec![AB::Expr::from_usize(k)];
+        m.extend(ch.iter().cloned());
+        bus::perm(bus::PORT_FRAME).send(builder, m, AB::Expr::ONE);
+    }
+}
+
+/// FRAME (T8, X7): the frame rule of CORE in its own AIR, so each half of the split CORE stays
+/// at or under 1,000 constraints. Columns are [`frame_col`] of the CORE row; the one-hot row
+/// index has the CORE rules, so the multiset match of `core_frame` pairs row `j` with row `j`.
+pub struct FrameAir {
+    pub o: Off,
+}
+impl FrameAir {
+    pub fn new() -> Self {
+        Self { o: Off::new(&Layout::new()) }
+    }
+}
+impl<T> BaseAir<T> for FrameAir {
+    fn width(&self) -> usize {
+        FRAME_W
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for FrameAir {}
+impl<T> PartitionedBaseAir<T> for FrameAir {}
+impl<AB: AirBuilder<F = F> + InteractionBuilder> Air<AB> for FrameAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (lr, nr) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &[AB::Var] = (*lr).borrow();
+        let n: &[AB::Var] = (*nr).borrow();
+        let c = |i: usize| -> AB::Expr { l[i].into() };
+        let nx = |i: usize| -> AB::Expr { n[i].into() };
+        let mut sum = AB::Expr::ZERO;
+        for j in 0..HEIGHT {
+            builder.assert_bool(c(j));
+            sum += c(j);
+        }
+        builder.assert_one(sum);
+        builder.when_first_row().assert_one(c(0));
+        for j in 0..HEIGHT - 1 {
+            builder.when_transition().assert_eq(nx(j + 1), c(j));
+        }
+        let slot = (0..S).fold(AB::Expr::ZERO, |a, j| a + c(j));
+        let st = |w: usize| c(HEIGHT + w);
+        let nst = |w: usize| nx(HEIGHT + w);
+        let sel = |r: usize| c(HEIGHT + SW + r);
+        frame_rule::<AB>(builder, &self.o, &st, &nst, &sel, slot);
+        let row: Vec<AB::Expr> = (0..FRAME_W).map(c).collect();
+        for (k, ch) in row.chunks(bus::FRAME_CHUNK).enumerate() {
+            let mut m = vec![AB::Expr::from_usize(k)];
+            m.extend(ch.iter().cloned());
+            bus::perm(bus::PORT_FRAME).receive(builder, m, AB::Expr::ONE);
+        }
+    }
+}
+
+/// FRAME trace from the CORE trace.
+pub fn frame_trace(core: &RowMajorMatrix<F>) -> RowMajorMatrix<F> {
+    let h = core.height();
+    let mut v = vec![F::ZERO; h * FRAME_W];
+    for r in 0..h {
+        for i in 0..FRAME_W {
+            v[r * FRAME_W + i] = core.values[r * WIDTH + frame_col(i)];
+        }
+    }
+    RowMajorMatrix::new(v, FRAME_W)
+}
