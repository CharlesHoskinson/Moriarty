+// ------------------------------------------------------------------ T8: X7 MERGE-WORK (N-6)
+/// The MERGE-WORK key over N3 children: the Work statement AIR, the verifier sub-circuit, the
+/// sponge, and the inline kernel (`sl::airs_kernel`, CORE split in two). Own set
+/// `frozen::MERGE_WORK` (owner ruling N-6 "own bounds", 2026-11-14).
+fn work_layer(child: &MultiStarkVerifyingKey<NodeSC>, log: &mut Vec<Value>) -> (Layer<2>, Value) {
+    let set = &frozen::MERGE_WORK;
+    let engine = Eng::new(set.params());
+    let circuit = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(Arc::new(child.clone()), cfg());
+    let inv = circuit.bus_inventory();
+    let perm = inv.poseidon2_permute_bus;
+    let mut airs: Vec<AirRef<NodeSC>> = vec![Arc::new(StmtAir::new(Kind::Work, inv))];
+    airs.extend(circuit.airs::<NodeSC>());
+    airs.push(Arc::new(PermSpongeAir { perm, height: stmt::sponge_height(&Kind::Work) }));
+    let node_airs = airs.len();
+    airs.extend(sl::airs_kernel(0));
+    let names: Vec<String> = airs.iter().map(|a| a.name()).collect();
+    // probe first (shape against the own bounds), then the checked keygen
+    let (_pk, vk0) = frozen::keygen_set(set, &engine, &airs);
+    let viol = violations(set, &vk0, &names);
+    let buses = |r: std::ops::Range<usize>| -> std::collections::BTreeSet<u16> {
+        r.flat_map(|i| vk0.inner.per_air[i].symbolic_constraints.interactions.iter().map(|x| x.bus_index).collect::<Vec<_>>()).collect()
+    };
+    let (bn, bk) = (buses(0..node_airs), buses(node_airs..airs.len()));
+    let shared: Vec<u16> = bn.intersection(&bk).copied().collect();
+    let probe = json!({"violations": viol, "node_airs": node_airs, "kernel_airs": airs.len() - node_airs,
+        "node_buses": bn.iter().collect::<Vec<_>>(), "kernel_buses": bk.iter().collect::<Vec<_>>(), "shared_buses": shared});
+    println!("T8X7PROBE {}", probe);
+    assert_eq!(shared, vec![stmt::STEP_PV_BUS], "only step_pv joins the node and the kernel");
+    assert_eq!(sl::bus_port_step_pv(), stmt::STEP_PV_BUS);
+    let (pk, vk) = kg(set, &engine, &airs, "MERGE-WORK<2> over N3", log);
+    (Layer { circuit, kind: Kind::Work, engine, pk, vk, airs, perm }, probe)
+}
+
+impl Keys {
+    /// The N3 SEG proof of the shards `shs` of `p` (each shard: leaf, N1 unary; then N2, N3).
+    fn seg_of(&self, p: &sl::Program, shs: &[slice_core::ShardIn]) -> Proof<NodeSC> {
+        let leaf_p: Vec<_> = shs
+            .iter()
+            .map(|s| {
+                let tr = sl::traces_set(p, s, &sl::Build::default(), 0);
+                let (pf, v, _) = sh::prove(&self.eng, &self.app[0], &tr, false);
+                v.expect("app shard");
+                self.leaf[0].prove(&self.app[0].vk, std::slice::from_ref(&pf.unwrap()), &Wit::Leaf)
+            })
+            .collect();
+        let sets = vec![0usize; shs.len()];
+        let n1 = self.n1[0].prove(&self.leaf[0].vk, &leaf_p, &self.first_wit(p, &sets));
+        let n2 = self.n2.prove(&self.n1[0].vk, std::slice::from_ref(&n1), &self.node_wit(&self.table.node[0]));
+        self.n3.prove(&self.n2.vk, std::slice::from_ref(&n2), &self.node_wit(&self.table.node[1]))
+    }
+}
+
+/// Prove a MERGE-WORK node: the node contexts, then the kernel traces (`ktamper` edits them).
+fn work_try(
+    w: &Layer<2>,
+    child_vk: &MultiStarkVerifyingKey<NodeSC>,
+    kids: &[Proof<NodeSC>],
+    wit: &Wit,
+    kernel: &[sh::Tr],
+    tamper: Option<&dyn Fn(&mut Vec<F>)>,
+    mutant: bool,
+) -> (Option<Proof<NodeSC>>, Result<(), String>) {
+    let mut ctxs = match guard(|| Ok(w.ctxs(child_vk, kids, wit, tamper))) {
+        Ok(c) => c,
+        Err(e) => return (None, Err(format!("trace generation: {e}"))),
+    };
+    let dev = w.engine.device();
+    for t in kernel {
+        ctxs.push(AirProvingContext::simple(dev.transport_matrix_to_device(&ColMajorMatrix::from_row_major(&t.m)), t.pvs.clone()));
+    }
+    let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());
+    if std::env::var("T7_DEBUG").is_ok() {
+        let _ = guard(|| {
+            w.engine.debug(&w.airs, &ctx);
+            Ok(())
+        })
+        .map_err(|e| eprintln!("T7_DEBUG: {}", e.chars().take(600).collect::<String>()));
+    }
+    let d_pk = w.engine.device().transport_pk_to_device(&w.pk);
+    if mutant {
+        std::env::set_var("SB_MUTANT_PROVER", "1");
+    }
+    let p = guard(|| w.engine.prove(&d_pk, ctx).map_err(|e| format!("prove: {e:?}")));
+    std::env::remove_var("SB_MUTANT_PROVER");
+    match p {
+        Ok(p) => {
+            let r = w.engine.verify(&w.vk, &p).map_err(|e| format!("{e:?}"));
+            (Some(p), r)
+        }
+        Err(e) => (None, Err(e)),
+    }
+}
