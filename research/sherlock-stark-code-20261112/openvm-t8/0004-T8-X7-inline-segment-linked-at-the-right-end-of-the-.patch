+++ b/crates/sherlock-wrap-export/examples/common/work.rs
@@ -0,0 +1,21 @@
+//! T8 (X7, owner ruling N-6 "own bounds"): the MERGE-WORK key, shared by `t7_chain` and `t8_gp`
+//! so that every run keys the same universal key set (the MERGE-WORK row is in `keys_d`).
+use super::*;
+
+/// The MERGE-WORK key over N3 children: the Work statement AIR, the verifier sub-circuit, the
+/// sponge, and the inline kernel (`sl::airs_kernel`, CORE split in two). Own set
+/// `frozen::MERGE_WORK`. Returns the layer and the number of node AIRs (before the kernel).
+pub(crate) fn work_key(child: &MultiStarkVerifyingKey<NodeSC>, log: &mut Vec<Value>) -> (Layer<2>, usize) {
+    let set = &frozen::MERGE_WORK;
+    let engine = Eng::new(set.params());
+    let circuit = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(Arc::new(child.clone()), cfg());
+    let inv = circuit.bus_inventory();
+    let perm = inv.poseidon2_permute_bus;
+    let mut airs: Vec<AirRef<NodeSC>> = vec![Arc::new(StmtAir::new(Kind::Work, inv))];
+    airs.extend(circuit.airs::<NodeSC>());
+    airs.push(Arc::new(PermSpongeAir { perm, height: stmt::sponge_height(&Kind::Work) }));
+    let node_airs = airs.len();
+    airs.extend(sl::airs_kernel(0));
+    let (pk, vk) = kg(set, &engine, &airs, "MERGE-WORK<2> over N3", log);
+    (Layer { circuit, kind: Kind::Work, engine, pk, vk, airs, perm }, node_airs)
+}
