+// ------------------------------------------------------------------ main
+fn w1_prove(engine: &Eng, pk: &MultiStarkProvingKey<SC>, vk: &MultiStarkVerifyingKey<SC>, chip: &Poseidon2SubChip<F, 1>, log_rows: usize) -> Proof<SC> {
+    let mut rng = StdRng::seed_from_u64(0x5e7_10c);
+    let d_pk = engine.device().transport_pk_to_device(pk);
+    let inputs: Vec<[F; 16]> = (0..1usize << log_rows)
+        .map(|_| std::array::from_fn(|_| F::from_u32(rng.random::<u32>() % (1 << 30)))).collect();
+    let trace = chip.generate_trace(inputs);
+    let ctx = ProvingContext::new(vec![(0, AirProvingContext::simple_no_pis(
+        engine.device().transport_matrix_to_device(&ColMajorMatrix::from_row_major(&trace))))]);
+    let proof = engine.prove(&d_pk, ctx).expect("w1 prove");
+    engine.verify(vk, &proof).expect("w1 verify");
+    proof
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let out = PathBuf::from(&a[1]);
+    let prove_h: usize = a[2].parse().unwrap();
+    let prove_kinds: Vec<String> = if a[3] == "none" { vec![] } else { a[3].split(',').map(String::from).collect() };
+    let app_rows: usize = a[4].parse().unwrap();
+    fs::create_dir_all(&out).unwrap();
+    let t0 = Instant::now();
+    let mut keys: Vec<Value> = vec![];
+    let mut wide = frozen::INTERNAL.clone();
+    wide.bounds.max_columns = 3300; // AFK pick of X14 (d), FOR OWNER CONFIRMATION
+    wide.name = "internal_cols3300";
+
+    // chain ladder, keys only (as fp8_keyset fixpoint): app -> leaf -> N1 -> N2 -> N3 -> N3 fixed point
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let fapp = Eng::new(frozen::APP.params());
+    let w1: Vec<AirRef<SC>> = vec![chip.air.clone()];
+    let (app_pk, app_vk) = kg_strict(&frozen::APP, &fapp, &w1, "app");
+    let lc = agg_key::<1>(&frozen::LEAF_AGG, &app_vk, Role::Leaf, "leaf<1>");
+    let c1 = agg_key::<2>(&frozen::INTERNAL, &lc.vk, Role::N1, "N1<2>");
+    let c2 = agg_key::<2>(&frozen::INTERNAL, &c1.vk, Role::N2, "N2<2>");
+    let c3 = agg_key::<2>(&frozen::INTERNAL, &c2.vk, Role::N3, "N3<2> over N2");
+    let n3_vk = c3.vk.clone();
+    {
+        let c4 = agg_key::<2>(&frozen::INTERNAL, &n3_vk, Role::N3, "N3<2> over N3");
+        assert_eq!(c4.vk.pre_hash, n3_vk.pre_hash, "N3 fixed point");
+    }
+    eprintln!("ladder keyed {:.1}s", t0.elapsed().as_secs_f64());
+    let n3_rec = json!({"pre_hash": format!("{:?}", n3_vk.pre_hash), "shape": shape_json(&frozen::shape(&n3_vk))});
+
+    // base unit (no work AIRs): KeyBind(N3) + VerifierSubCircuit<1> over N3
+    let unit_engine = Eng::new(frozen::INTERNAL.params());
+    let ucirc = circuit::<1>(&n3_vk);
+    let role = Role::N3; // FOR OWNER CONFIRMATION
+    {
+        let airs = layer_airs(&ucirc, &role, vec![]);
+        let (_, vk, verdict, s) = kg(&frozen::INTERNAL, &unit_engine, &airs);
+        check_layout(&vk);
+        let mut r = key_record("base unit: KeyBind(N3) + VerifierSubCircuit<1> over N3", &frozen::INTERNAL, &verdict, &vk, s);
+        r["file"] = json!("unit_base_vk.json");
+        fs::write(out.join("unit_base_vk.json"), serde_json::to_vec(&vk).unwrap()).unwrap();
+        keys.push(r);
+    }
+
+    // the two unit keys (no sink): strict INTERNAL, then the 3,300-column copy
+    let mut unit_pre = std::collections::BTreeMap::new();
+    for kind in ["add", "dbl"] {
+        let (work, _, names) = g1_chain(kind, 4, false);
+        let airs = layer_airs(&ucirc, &role, work);
+        let (_, vk, verdict, s) = kg(&frozen::INTERNAL, &unit_engine, &airs);
+        check_layout(&vk);
+        let nw = names.len();
+        let per_work: Vec<Value> = vk.inner.per_air[vk.inner.per_air.len() - nw..].iter().zip(&names).map(|(p, n)| json!({
+            "name": n, "columns": p.params.width.total_width(), "interactions": p.symbolic_constraints.interactions.len(),
+            "constraints": p.symbolic_constraints.constraints.constraint_idx.len(), "degree": p.max_constraint_degree})).collect();
+        let file = format!("unit_{kind}_vk.json");
+        fs::write(out.join(&file), serde_json::to_vec(&vk).unwrap()).unwrap();
+        let mut r = key_record(&format!("unit {kind}"), &frozen::INTERNAL, &verdict, &vk, s);
+        r["file"] = json!(file);
+        r["work_airs"] = json!(per_work);
+        keys.push(r);
+        eprintln!("unit {kind} INTERNAL: {verdict}");
+        if verdict != "accepted" {
+            let (_, vk2, verdict2, s2) = kg(&wide, &unit_engine, &airs);
+            assert_eq!(vk2.pre_hash, vk.pre_hash, "same key under both bound sets");
+            let mut r = key_record(&format!("unit {kind}"), &wide, &verdict2, &vk2, s2);
+            r["file"] = json!(format!("unit_{kind}_vk.json"));
+            keys.push(r);
+            eprintln!("unit {kind} cols3300: {verdict2}");
+        }
+        unit_pre.insert(kind, vk.pre_hash);
+    }
+    let mut doc = json!({"keys": keys, "n3": n3_rec, "role": "N3 (FOR OWNER CONFIRMATION)",
+                         "unit_pre_hash_equals_n3": unit_pre.values().any(|p| *p == n3_vk.pre_hash)});
+    fs::write(out.join("gen.json"), serde_json::to_string_pretty(&doc).unwrap()).unwrap();
+    eprintln!("keys done {:.1}s", t0.elapsed().as_secs_f64());
+
+    // proving: one real N3 proof (app -> leaf -> N1 -> N2 -> N3), then the unit harness key(s)
+    let mut proves = vec![];
+    if !prove_kinds.is_empty() {
+        let t = Instant::now();
+        let app_p = w1_prove(&fapp, &app_pk, &app_vk, &chip, app_rows);
+        drop(app_pk);
+        let pr = |l: &dyn Fn() -> (Proof<SC>, Result<(), String>, f64)| {
+            let (p, r, _) = l();
+            r.expect("bound verify");
