+        let leaf_p = pr(&|| bound_prove(&lc.circuit, &lc.role, &lc.engine, &lc.pk, &lc.vk, &app_vk, std::slice::from_ref(&app_p), vec![]));
+        let n1_p = pr(&|| bound_prove(&c1.circuit, &c1.role, &c1.engine, &c1.pk, &c1.vk, &lc.vk, &[leaf_p.clone(), leaf_p.clone()], vec![]));
+        let n2_p = pr(&|| bound_prove(&c2.circuit, &c2.role, &c2.engine, &c2.pk, &c2.vk, &c1.vk, &[n1_p.clone(), n1_p.clone()], vec![]));
+        let n3_p = pr(&|| bound_prove(&c3.circuit, &c3.role, &c3.engine, &c3.pk, &c3.vk, &c2.vk, &[n2_p.clone(), n2_p.clone()], vec![]));
+        let child_s = t.elapsed().as_secs_f64();
+        eprintln!("N3 child proof {child_s:.1}s");
+        for kind in &prove_kinds {
+            let (work, traces, names) = g1_chain(kind, prove_h, true);
+            let airs = layer_airs(&ucirc, &role, work);
+            let (hpk, hvk, verdict, s) = kg(&wide, &unit_engine, &airs);
+            let unit_strict = unit_pre[kind.as_str()];
+            let (proof, r, prove_s) = bound_prove(&ucirc, &role, &unit_engine, &hpk, &hvk, &n3_vk, std::slice::from_ref(&n3_p), traces);
+            let hs = heights(&proof);
+            let rec = json!({
+                "key": format!("unit {kind} + sink (harness, proving run only)"), "names_work": names,
+                "set": wide.name, "g1": verdict, "keygen_s": s, "pre_hash": format!("{:?}", hvk.pre_hash),
+                "differs_from_unit_key": hvk.pre_hash != unit_strict,
+                "shape": shape_json(&frozen::shape(&hvk)), "log_rows": prove_h, "app_log_rows": app_rows,
+                "child_chain_prove_s": child_s,
+                "prove_s": prove_s, "verify": match &r { Ok(_) => "verified".to_string(), Err(e) => format!("REJECTED: {e}") },
+                "log_heights": hs, "height_check_internal": height_check(&frozen::INTERNAL, &hs),
+                "stacked_widths": proof.stacking_proof.stacking_openings.iter().map(|v| v.len()).collect::<Vec<_>>(),
+                "kb_depth": proof.public_values[keybind::KB_AIR_ID][keybind::PV_DEPTH].as_canonical_u32(),
+                "kb_flag": proof.public_values[keybind::KB_AIR_ID][keybind::PV_FLAG].as_canonical_u32(),
+            });
+            eprintln!("prove {kind}: {}", rec["verify"]);
+            proves.push(rec);
+            doc["proves"] = json!(proves);
+            fs::write(out.join("gen.json"), serde_json::to_string_pretty(&doc).unwrap()).unwrap();
+        }
+    }
+    doc["wall_s"] = json!(t0.elapsed().as_secs_f64());
+    fs::write(out.join("gen.json"), serde_json::to_string_pretty(&doc).unwrap()).unwrap();
+    eprintln!("done {:.1}s", t0.elapsed().as_secs_f64());
+}
