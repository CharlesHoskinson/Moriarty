+//! Sherlock FP-8 (loop item FP8): the two FV (fixed-base / G1) unit node keys, step 2 of 2.
+//!
+//! Step 1 (`stark-bench-ovm/examples/fp8_units_gen.rs`) keys the units (KeyBind `Role::N3` +
+//! `VerifierSubCircuit<1>` over N3 + the G1 work AIRs) and writes each vk as JSON with its G1
+//! verdicts. It lives there because only that crate has the mod-builder dependency (adding it here
+//! changes `Cargo.lock`). This step loads each vk, checks the JSON round trip and the pre-hash,
+//! re-runs the G1 key check with the `sherlock_lfr::frozen` crate (INTERNAL, and the 3,300-column
+//! copy, FOR OWNER CONFIRMATION), and records the vk bitcode bytes and sha256.
+//!
+//! usage: fp8_units DIR   (reads DIR/gen.json and DIR/*_vk.json, writes DIR/units.json)
+use std::{fs, path::PathBuf};
+
+use openvm_stark_backend::keygen::types::MultiStarkVerifyingKey;
+use serde_json::{json, Value};
+use sherlock_lfr::{fixture::NodeSC, frozen};
+
+fn sha256_hex(b: &[u8]) -> String {
+    use std::process::{Command, Stdio};
+    let mut c = Command::new("sha256sum").stdin(Stdio::piped()).stdout(Stdio::piped()).spawn().expect("sha256sum");
+    std::io::Write::write_all(c.stdin.as_mut().unwrap(), b).unwrap();
+    let o = c.wait_with_output().unwrap();
+    String::from_utf8(o.stdout).unwrap().split_whitespace().next().unwrap().to_string()
+}
+
+fn verdict(r: Result<frozen::KeyShape, frozen::G1Error>) -> String {
+    match r {
+        Ok(_) => "accepted".into(),
+        Err(e) => format!("REFUSED: {e:?}"),
+    }
+}
+
+fn main() {
+    let dir = PathBuf::from(std::env::args().nth(1).expect("DIR"));
+    let mut gen: Value = serde_json::from_slice(&fs::read(dir.join("gen.json")).unwrap()).unwrap();
+    let mut wide = frozen::INTERNAL.bounds;
+    wide.max_columns = 3300;
+    let mut out = vec![];
+    let mut seen = std::collections::BTreeSet::new();
+    for k in gen["keys"].as_array().unwrap().clone() {
+        let file = k["file"].as_str().unwrap().to_string();
+        if !seen.insert(file.clone()) {
+            continue;
+        }
+        let raw = fs::read(dir.join(&file)).unwrap();
+        let vk: MultiStarkVerifyingKey<NodeSC> = serde_json::from_slice(&raw).unwrap();
+        let back: Value = serde_json::to_value(&vk).unwrap();
+        let orig: Value = serde_json::from_slice(&raw).unwrap();
+        assert_eq!(back, orig, "{file}: vk JSON round trip");
+        let pre = format!("{:?}", vk.pre_hash);
+        assert_eq!(pre, k["pre_hash"].as_str().unwrap(), "{file}: pre-hash");
+        let bytes = bitcode::serialize(&vk).expect("vk bitcode");
+        let s = frozen::shape(&vk);
+        out.push(json!({
+            "key": k["key"], "file": file,
+            "airs": s.airs, "columns": s.columns, "max_interactions_per_air": s.max_interactions,
+            "max_constraints_per_air": s.max_constraints, "max_constraint_degree": s.max_degree,
+            "total_constraints": s.total_constraints, "total_interactions": s.total_interactions,
+            "public_values": s.public_values,
+            "pre_hash": pre, "vk_bitcode_bytes": bytes.len(), "vk_bitcode_sha256": sha256_hex(&bytes),
+            "g1_internal": verdict(frozen::check_vk(&frozen::INTERNAL, &vk)),
+            "g1_internal_cols3300": verdict(frozen::check_vk_bounds(&frozen::INTERNAL, &wide, &vk)),
+            "work_airs": k.get("work_airs").cloned().unwrap_or(Value::Null),
+        }));
+        println!("FP8UNIT {} airs={} cols={} maxint={} deg={} bytes={} g1={} g1_3300={}",
+            k["key"], s.airs, s.columns, s.max_interactions, s.max_degree, bytes.len(),
+            out.last().unwrap()["g1_internal"], out.last().unwrap()["g1_internal_cols3300"]);
+    }
+    gen["units"] = json!(out);
+    gen["labels"] = json!("every key quantity, verdict, time and height MEASURED; role N3 and the 3,300-column bound FOR OWNER CONFIRMATION");
+    fs::write(dir.join("units.json"), serde_json::to_string_pretty(&gen).unwrap()).unwrap();
+}
