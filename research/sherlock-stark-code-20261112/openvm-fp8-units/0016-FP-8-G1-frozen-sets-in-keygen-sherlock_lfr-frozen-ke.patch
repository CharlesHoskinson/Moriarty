+//! FP-8 G1: the frozen sets are the ones every keygen call site uses, and keygen refuses a key
+//! with another parameter set or outside the bounds.
+use std::sync::Arc;
+
+use openvm_cpu_backend::CpuBackend;
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{AggregationSubCircuit, VerifierSubCircuit, VerifierTraceGen};
+use openvm_stark_backend::{AirRef, StarkEngine, WhirProximityStrategy};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_poseidon2::{BabyBearPoseidon2CpuEngine, DuplexSponge},
+    params_with_100_bits_security, MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use sherlock_lfr::{
+    fixture::{internal_ud, l_ud, ud_params, NodeSC},
+    frozen::{self, Bounds, G1Error},
+    testing::lfr_params,
+};
+
+type Eng = BabyBearPoseidon2CpuEngine<DuplexSponge>;
+
+fn w1() -> Vec<AirRef<NodeSC>> {
+    let chip = Poseidon2SubChip::<BabyBear, 1>::new(Poseidon2Config::<BabyBear>::default().constants);
+    vec![chip.air.clone()]
+}
+
+#[test]
+fn g1_sets_equal_the_pre_fp8_formulas() {
+    // The internal, L and L_Fr sets keep the exact params of E2 to E6 (no key change from G1 there).
+    assert_eq!(internal_ud(), ud_params(3, 2, 17, 512, 9, 21, &[97, 82, 81], 18));
+    assert_eq!(l_ud(48), ud_params(3, 2, 18, 48, 6, 20, &[98, 83, 82], 18));
+    let mut p = params_with_100_bits_security(3, 2, 18, 48, 0, 0, WhirProximityStrategy::UniqueDecoding, 4, 20, 4);
+    for (r, n) in p.whir.rounds.iter_mut().zip([98, 83, 82]) {
+        r.num_queries = n;
+    }
+    p.logup.pow_bits = 0;
+    assert_eq!(lfr_params(), p);
+    for s in frozen::ALL {
+        frozen::check_params(s, &s.params()).unwrap();
+    }
+}
+
+#[test]
+fn g1_app_set_differs_from_stock() {
+    let stock = app_params_with_100_bits_security(MAX_APP_LOG_STACKED_HEIGHT);
+    // The stock set already has the frozen vector 193/88/81/81 (derived at query PoW 20); it
+    // differs in the query PoW only (20 against the OD-4 value 21).
+    let e = frozen::check_params(&frozen::APP, &stock).unwrap_err();
+    assert_eq!(e, G1Error::Params { set: "app", field: "query_pow" });
+    let q: Vec<usize> = stock.whir.rounds.iter().map(|r| r.num_queries).collect();
+    assert_eq!(stock.whir.query_phase_pow_bits, 20);
+    assert_eq!(q, frozen::APP.queries);
+    // The stock derivation at query PoW 21 gives a smaller vector, which G1 refuses.
+    let p21 = params_with_100_bits_security(1, 4, 20, 2048, 5, 15, WhirProximityStrategy::UniqueDecoding, 3, 21, 4);
+    let e = frozen::check_params(&frozen::APP, &p21).unwrap_err();
+    assert!(matches!(e, G1Error::QueryVector { .. }), "{e:?}");
+    eprintln!("G1 stock derivation at query PoW 21: {e:?}");
+}
+
+#[test]
+fn g1_refuses_changed_parameters() {
+    let base = frozen::INTERNAL.params();
+    let mut p = base.clone();
+    p.whir.rounds[1].num_queries -= 1;
+    assert!(matches!(frozen::check_params(&frozen::INTERNAL, &p), Err(G1Error::QueryVector { .. })));
+    let mut p = base.clone();
+    p.whir.query_phase_pow_bits = 20;
+    assert_eq!(frozen::check_params(&frozen::INTERNAL, &p), Err(G1Error::Params { set: "internal", field: "query_pow" }));
+    let mut p = base.clone();
+    p.logup.pow_bits = 17;
+    assert_eq!(frozen::check_params(&frozen::INTERNAL, &p), Err(G1Error::Params { set: "internal", field: "logup_pow" }));
+    let mut p = base.clone();
+    p.whir.mu_pow_bits = 8;
+    assert_eq!(frozen::check_params(&frozen::INTERNAL, &p), Err(G1Error::Params { set: "internal", field: "mu_pow" }));
+    let mut p = frozen::LEAF_AGG.params();
+    p.logup.pow_bits = 0;
+    assert_eq!(frozen::check_params(&frozen::LEAF_AGG, &p), Err(G1Error::Params { set: "leaf_agg", field: "logup_pow" }));
+    // keygen_checked refuses an engine on the stock app set.
+    let stock = Eng::new(app_params_with_100_bits_security(MAX_APP_LOG_STACKED_HEIGHT));
+    assert_eq!(
+        frozen::keygen_checked(&frozen::APP, &stock, &w1()).err(),
+        Some(G1Error::Params { set: "app", field: "query_pow" })
+    );
+}
+
+#[test]
+fn g1_refuses_keys_outside_the_bounds() {
+    let app = Eng::new(frozen::APP.params());
+    let (_, app_vk, s) = frozen::keygen_checked(&frozen::APP, &app, &w1()).unwrap();
+    assert_eq!((s.airs, s.columns), (1, 299));
+    let tight = |f: &dyn Fn(&mut Bounds)| {
+        let mut b = frozen::APP.bounds;
+        f(&mut b);
+        frozen::check_vk_bounds(&frozen::APP, &b, &app_vk)
+    };
+    assert!(matches!(tight(&|b| b.max_columns = 298), Err(G1Error::Columns { got: 299, .. })));
+    assert!(matches!(tight(&|b| b.max_constraints_per_air = 281), Err(G1Error::Constraints { got: 282, .. })));
+    assert!(matches!(tight(&|b| b.max_airs = 0), Err(G1Error::Airs { .. })));
+    // A node: its largest AIR has 77 interactions; inside 200 (and the old 100), refused at 76.
+    let eng = Eng::new(frozen::INTERNAL.params());
+    let c = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(
+        Arc::new(app_vk),
+        Default::default(),
+    );
+    let (_, node_vk, s) = frozen::keygen_checked(&frozen::INTERNAL, &eng, &AggregationSubCircuit::airs::<NodeSC>(&c)).unwrap();
+    assert!(s.max_interactions <= 200 && s.airs <= 64 && s.columns <= 3000);
+    let mut b = frozen::INTERNAL.bounds;
+    b.max_interactions_per_air = s.max_interactions - 1;
+    assert!(matches!(frozen::check_vk_bounds(&frozen::INTERNAL, &b, &node_vk), Err(G1Error::Interactions { .. })));
+    // Heights: a proof with an AIR at 2^20 is outside the internal bound 2^19.
+    assert!(matches!(frozen::check_heights(&frozen::INTERNAL, &[Some(19), Some(20)]), Err(G1Error::Height { got: 20, .. })));
+    assert_eq!(frozen::check_heights(&frozen::INTERNAL, &[Some(19), None]), Ok(19));
+}
diff --git a/crates/sherlock-wrap-export/examples/fp8_d3.rs b/crates/sherlock-wrap-export/examples/fp8_d3.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e2d6acdc84a6ad39ee1074d2d0b7714af4d12b9d
--- /dev/null
+++ b/crates/sherlock-wrap-export/examples/fp8_d3.rs
@@ -0,0 +1,135 @@
+//! Sherlock FP-8 item 4: D3 (the stock stark-backend `SoundnessCalculator`, one OOD sample) on
+//! every STARK key of the FP-8 key set, at three shapes:
+//! - `measured`: the key's AIR count, columns, constraints, degree; the measured largest trace
+//!   height and stacked width of its proof (from `chain.json`);
+//! - `vk`: `calculate_from_vk` (the key's own verifier-side bounds);
+//! - `bounds`: the frozen set's shape bounds (`sherlock_lfr::frozen`).
+//! Gate: every term at least 100 bits, every grindable term (LogUp, `mu`, folding, query) at
+//! least 101 bits.
+//! usage: fp8_d3 <chain dir> [extra node vk bitcode files ...]
+use std::{fs, path::PathBuf};
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    soundness::{base_field_order, challenge_field_bits, SoundnessCalculator},
+    StarkProtocolConfig,
+};
+use serde_json::{json, Value};
+use sherlock_lfr::{
+    fixture::{NodeSC, LSC},
+    frozen::{self, FrozenSet},
+};
+use sherlock_wrap_export::SC as FrSC;
+
+fn log2c(x: usize) -> usize {
+    if x <= 1 {
+        0
+    } else {
+        (usize::BITS - (x - 1).leading_zeros()) as usize
+    }
+}
+
+fn n_logup(l_skip: usize, mic: usize, airs: usize, ipa: usize, h: usize) -> usize {
+    let a = if mic == 0 { 0 } else { log2c(mic).saturating_sub(l_skip) };
+    let b = if airs == 0 || ipa == 0 { 0 } else { (log2c(airs) + log2c(ipa) + h).saturating_sub(l_skip) };
+    a.min(b)
+}
+
+fn terms(s: &SoundnessCalculator) -> Value {
+    let w = &s.whir_details;
+    let t = [
+        ("logup", s.logup_bits, true),
+        ("gkr_sumcheck", s.gkr_sumcheck_bits, false),
+        ("gkr_batching", s.gkr_batching_bits, false),
+        ("zerocheck", s.zerocheck_sumcheck_bits, false),
+        ("constraint_batching", s.constraint_batching_bits, false),
+        ("stacked", s.stacked_reduction_bits, false),
+        ("mu", w.mu_batching_bits, true),
+        ("fold", w.fold_rbr_bits, true),
+        ("query", w.query_bits, true),
+        ("shift", w.shift_rbr_bits, false),
+        ("gamma", w.gamma_batching_bits, false),
+        ("ood", w.ood_rbr_bits, false),
+    ];
+    let (wn, wb) = t.iter().fold(("", f64::INFINITY), |a, x| if x.1 < a.1 { (x.0, x.1) } else { a });
+    let pass = t.iter().all(|x| x.1 >= 100.0) && t.iter().filter(|x| x.2).all(|x| x.1 >= 101.0);
+    let mut m = serde_json::Map::new();
+    for (n, b, _) in t {
+        m.insert(n.into(), json!((b * 10000.0).round() / 10000.0));
+    }
+    m.insert("weakest".into(), json!(format!("{wn} {wb:.4}")));
+    m.insert("total".into(), json!((s.total_bits * 10000.0).round() / 10000.0));
+    m.insert("gate".into(), json!(if pass { "PASS" } else { "FAIL" }));
+    Value::Object(m)
+}
+
+fn d3<SC: StarkProtocolConfig>(
+    name: &str,
+    set: &FrozenSet,
+    vk: &MultiStarkVerifyingKey<SC>,
+    log_heights: Option<&Value>,
+    stacked: Option<&Value>,
+) -> Value {
+    let p = &vk.inner.params;
+    let sh = frozen::shape(vk);
+    let (bo, cb) = (base_field_order::<SC>(), challenge_field_bits::<SC>());
+    let mic = p.logup.max_interaction_count as usize;
+    let mut out = json!({"key": name, "set": set.name, "pre_hash": format!("{:?}", vk.pre_hash),
+        "airs": sh.airs, "columns": sh.columns, "max_constraints": sh.max_constraints,
+        "max_interactions": sh.max_interactions, "degree": p.max_constraint_degree,
+        "vk": terms(&SoundnessCalculator::calculate_from_vk(vk))});
+    if let (Some(h), Some(sw)) = (log_heights, stacked) {
+        let h = h.as_array().unwrap().iter().filter_map(|x| x.as_u64()).max().unwrap() as usize;
+        let w: usize = sw.as_array().unwrap().iter().map(|x| x.as_u64().unwrap() as usize).sum();
+        let s = SoundnessCalculator::calculate(
+            p, bo, cb, sh.max_constraints, sh.airs, p.max_constraint_degree, h, sh.columns, w,
+            n_logup(p.l_skip, mic, sh.airs, sh.max_interactions, h),
+        );
+        out["measured"] = terms(&s);
+        out["measured_shape"] = json!({"max_log_height": h, "stacked_columns": w});
+    }
+    let b = &set.bounds;
+    let s = SoundnessCalculator::calculate(
+        p, bo, cb, b.max_constraints_per_air, b.max_airs, p.max_constraint_degree,
+        b.max_log_height.min(p.log_stacked_height()), b.max_columns, p.w_stack,
+        n_logup(p.l_skip, mic, b.max_airs, b.max_interactions_per_air, b.max_log_height.min(p.log_stacked_height())),
+    );
+    out["bounds"] = terms(&s);
+    println!("FP8D3 {name}: measured {} | vk {} | bounds {}",
+        out.get("measured").map(|m| format!("{} {}", m["weakest"], m["gate"])).unwrap_or("-".into()),
+        format!("{} {}", out["vk"]["weakest"], out["vk"]["gate"]),
+        format!("{} {}", out["bounds"]["weakest"], out["bounds"]["gate"]));
+    out
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let d = PathBuf::from(&a[1]);
+    let chain: Value = serde_json::from_slice(&fs::read(d.join("chain.json")).unwrap()).unwrap();
+    let rd = |f: &str| fs::read(d.join(f)).unwrap();
+    let app: MultiStarkVerifyingKey<NodeSC> = bitcode::deserialize(&rd("app_vk.bitcode")).unwrap();
+    let leaf: MultiStarkVerifyingKey<NodeSC> = bitcode::deserialize(&rd("leaf_vk.bitcode")).unwrap();
+    let node: MultiStarkVerifyingKey<NodeSC> = bitcode::deserialize(&rd("node_vk.bitcode")).unwrap();
+    let l: MultiStarkVerifyingKey<LSC> = bitcode::deserialize(&rd("l_vk.bitcode")).unwrap();
+    let fx: Value = serde_json::from_slice(&rd("lfr-fp8.json")).unwrap();
+    let lfr: MultiStarkVerifyingKey<FrSC> = serde_json::from_value(fx["vk"].clone()).unwrap();
+    let sw = &chain["stacked_widths"];
+    let mut res = vec![
+        d3("app", &frozen::APP, &app, Some(&chain["app_log_heights"]), sw.get("app")),
+        d3("leaf<1>", &frozen::LEAF_AGG, &leaf, Some(&chain["leaf_log_heights"]), sw.get("leaf")),
+        d3("node1<2> (over leaf)", &frozen::INTERNAL, &bitcode::deserialize::<MultiStarkVerifyingKey<NodeSC>>(&rd("node1_vk.bitcode")).unwrap(), Some(&chain["node1_log_heights"]), sw.get("node1")),
+        d3("node2<2>", &frozen::INTERNAL, &bitcode::deserialize::<MultiStarkVerifyingKey<NodeSC>>(&rd("node2_vk.bitcode")).unwrap(), None, None),
+        d3("node3<2> (internal-recursive, fixed point)", &frozen::INTERNAL, &node, Some(&chain["node_log_heights"]), sw.get("node")),
+        d3("L_iface", &frozen::L, &l, Some(&chain["l_log_heights"]), Some(&chain["l_stacked_widths"])),
+        d3("L_Fr", &frozen::LFR, &lfr, Some(&json!([chain["heights"]["L_Fr"]["max_log_height"]])), Some(&chain["lfr_stacked_widths"])),
+    ];
+    for f in a.iter().skip(2) {
+        let vk: MultiStarkVerifyingKey<NodeSC> = bitcode::deserialize(&fs::read(f).unwrap()).unwrap();
+        res.push(d3(f, &frozen::INTERNAL, &vk, None, None));
+    }
+    fs::write(d.join("d3.json"), serde_json::to_string_pretty(&res).unwrap()).unwrap();
+    let all = res.iter().all(|r| {
+        ["measured", "vk", "bounds"].iter().all(|k| r.get(*k).map(|m| m["gate"] == "PASS").unwrap_or(true))
+    });
+    println!("FP8D3 all gates: {}", if all { "PASS" } else { "FAIL" });
+}
