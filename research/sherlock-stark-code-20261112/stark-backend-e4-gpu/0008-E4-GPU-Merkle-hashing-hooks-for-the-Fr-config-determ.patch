+/// Sherlock E4: the GPU hooks of [`FrMerkleHasher`] (Midnight Poseidon over Fr in `mori-gpu`).
+#[cfg(feature = "gpu")]
+pub mod gpu {
+    use std::sync::OnceLock;
+
+    use midnight_circuits::hash::poseidon::constants::PoseidonField;
+    use mori_gpu::poseidon::Constants;
+
+    use super::{Digest, MidnightFq, F};
+
+    /// Below this many rows the CPU hashes (launch and copy cost dominate).
+    pub const MIN_ROWS: usize = 1 << 12;
+
+    /// The constant table of the kernel: the round constants and the MDS matrix of
+    /// midnight-circuits, then the sparse partial-round table derived from them here.
+    pub fn constants() -> &'static Constants {
+        static C: OnceLock<Constants> = OnceLock::new();
+        C.get_or_init(|| {
+            let mut v: Vec<MidnightFq> =
+                MidnightFq::ROUND_CONSTANTS.iter().flatten().copied().collect();
+            v.extend(MidnightFq::MDS.iter().flatten().copied());
+            v.extend(sparse_partial().into_iter().map(F::to_ff));
+            assert_eq!(v.len(), mori_gpu::poseidon::NCONST);
+            Constants(v)
+        })
+    }
+
+    /// Sparse partial rounds (Poseidon paper, appendix B) in coordinates `t = (s2, s0, s1)`
+    /// (the S-box cell first). Partial round `k` (round `r = 4 + k` of the unskipped
+    /// permutation: S-box on `s2`, then `s = M s + RC[r + 1]`) becomes
+    /// `u = M''_k S(u) + k_k e_0` with `M''_k = [[a, v0, v1], [w0, 1, 0], [w1, 0, 1]]`.
+    /// `A_k = M M'_{k - 1}` (`M'_0 = I`) is split as `M'_k M''_k`, `M'_k = diag(1, Â_k)`,
+    /// and `M'_k` moves into the next round. The constants of `t1, t2` are carried
+    /// (`S` leaves them alone): the true state is the computed one plus `e`, `e_0 = 0`.
+    /// After the last round the state is `M'_60 u + e`. Returns 60 x (a, v0, v1, w0, w1, k),
+    /// then `Â_60` row-major and `(e_1, e_2)`.
+    fn sparse_partial() -> Vec<F> {
+        use p3_field::{Field, PrimeCharacteristicRing};
+        const P: [usize; 3] = [2, 0, 1];
+        let rc: Vec<[F; 3]> = MidnightFq::ROUND_CONSTANTS
+            .iter()
+            .map(|r| [0, 1, 2].map(|i| F::from_ff(r[P[i]])))
+            .collect();
+        let m: [[F; 3]; 3] =
+            [0, 1, 2].map(|i| [0, 1, 2].map(|j| F::from_ff(MidnightFq::MDS[P[i]][P[j]])));
+        let mul = |x: &[[F; 3]; 3], y: &[[F; 3]; 3]| -> [[F; 3]; 3] {
+            [0, 1, 2].map(|i| {
+                [0, 1, 2].map(|j| (0..3).fold(F::ZERO, |acc, l| acc + x[i][l] * y[l][j]))
+            })
+        };
+        let mut out = Vec::new();
+        let mut e = [F::ZERO; 3];
+        let mut a = m;
+        let mut last = [[F::ZERO; 2]; 2];
+        for k in 0..60 {
+            let r = 4 + k;
+            let c: [F; 3] = [0, 1, 2]
+                .map(|i| (0..3).fold(rc[r + 1][i], |acc, j| acc + m[i][j] * e[j]));
+            e = [F::ZERO, c[1], c[2]];
+            let ah = [[a[1][1], a[1][2]], [a[2][1], a[2][2]]];
+            let det_inv = (ah[0][0] * ah[1][1] - ah[0][1] * ah[1][0]).inverse();
+            let inv = [
+                [ah[1][1] * det_inv, -ah[0][1] * det_inv],
+                [-ah[1][0] * det_inv, ah[0][0] * det_inv],
+            ];
+            let w = [
+                inv[0][0] * a[1][0] + inv[0][1] * a[2][0],
+                inv[1][0] * a[1][0] + inv[1][1] * a[2][0],
+            ];
+            out.extend([a[0][0], a[0][1], a[0][2], w[0], w[1], c[0]]);
+            let mprime = [
+                [F::ONE, F::ZERO, F::ZERO],
+                [F::ZERO, ah[0][0], ah[0][1]],
+                [F::ZERO, ah[1][0], ah[1][1]],
+            ];
+            a = mul(&m, &mprime);
+            last = ah;
+        }
+        out.extend([last[0][0], last[0][1], last[1][0], last[1][1], e[1], e[2]]);
+        out
+    }
+
+    pub fn as_ff(v: &[F]) -> &[MidnightFq] {
+        // SAFETY: Bls12381Fr is repr(transparent) over MidnightFq.
+        unsafe { std::slice::from_raw_parts(v.as_ptr().cast(), v.len()) }
+    }
+
+    pub fn digests(v: Vec<MidnightFq>) -> Vec<Digest> {
+        v.into_iter().map(|x| [F::from_ff(x)]).collect()
+    }
 }
 
