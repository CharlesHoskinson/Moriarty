diff --git a/crates/stark-backend/src/transcript/traits.rs b/crates/stark-backend/src/transcript/traits.rs
index be8d729..57715c4 100644
--- a/crates/stark-backend/src/transcript/traits.rs
+++ b/crates/stark-backend/src/transcript/traits.rs
@@ -91,11 +91,27 @@ where
             return SC::F::ZERO;
