+
+    #[cfg(feature = "gpu")]
+    fn has_batch(&self) -> bool {
+        mori_gpu::info().is_some()
+    }
+
+    #[cfg(feature = "gpu")]
+    fn hash_rows(&self, vals: &[F], width: usize) -> Option<Vec<Digest>> {
+        if vals.len() / width.max(1) < gpu::MIN_ROWS {
+            return None;
+        }
+        let cap = cap_fixed(self.domains.u_leaf, width as u128).to_ff();
+        let out = mori_gpu::poseidon::hash_rows(gpu::constants(), gpu::as_ff(vals), width, cap)?;
+        Some(gpu::digests(out))
+    }
+
+    #[cfg(feature = "gpu")]
+    fn encode_hash_rows(
+        &self,
+        coeffs: &[F],
+        height: usize,
+        width: usize,
+        log_n: usize,
+    ) -> Option<(Vec<F>, Vec<Digest>)> {
+        if (1usize << log_n) < gpu::MIN_ROWS || std::env::var("E4_GPU_ENCODE").as_deref() == Ok("0") {
+            return None;
+        }
+        let cap = cap_fixed(self.domains.u_leaf, width as u128).to_ff();
+        let (rm, dg) = mori_gpu::poseidon::encode_hash_rows(
+            gpu::constants(),
+            gpu::as_ff(coeffs),
+            height,
+            width,
+            log_n as u32,
+            cap,
+        )?;
+        // SAFETY: Bls12381Fr is repr(transparent) over MidnightFq.
+        let rm: Vec<F> = unsafe {
+            let mut rm = std::mem::ManuallyDrop::new(rm);
+            Vec::from_raw_parts(rm.as_mut_ptr().cast(), rm.len(), rm.capacity())
+        };
+        Some((rm, gpu::digests(dg)))
+    }
+
+    #[cfg(feature = "gpu")]
+    fn digest_layers(&self, leaves: &[Digest], rows_per_query: usize) -> Option<Vec<Vec<Digest>>> {
+        if leaves.len() < gpu::MIN_ROWS {
+            return None;
+        }
+        let cap = cap_fixed(self.domains.u_node, 2).to_ff();
+        // SAFETY: Digest = [Bls12381Fr; 1], and Bls12381Fr is repr(transparent) over MidnightFq.
+        let flat: &[F] = unsafe { std::slice::from_raw_parts(leaves.as_ptr().cast(), leaves.len()) };
+        let layers =
+            mori_gpu::poseidon::digest_layers(gpu::constants(), gpu::as_ff(flat), rows_per_query, cap)?;
+        Some(layers.into_iter().map(gpu::digests).collect())
+    }
+}
