-        let witness = (0..grind_candidate_count::<SC::F>())
-            .into_par_iter()
-            .map(PrimeCharacteristicRing::from_u64)
-            .find_any(|witness| self.clone().check_witness(bits, *witness))
-            .expect("failed to find PoW witness");
+        // Sherlock E4: the smallest witness (`find_first`), so a proof is a function of its
+        // inputs at any thread count and a GPU path can be checked byte for byte (`find_any`
+        // returned whichever thread finished first: two 20-thread proofs differed, MEASURED).
+        // Searched in ordered chunks: the first chunk with a witness gives the smallest one,
+        // with no thread scanning far past it (a single `find_first` over the whole range was
+        // 2 to 5 times slower, MEASURED in E4).
+        const CHUNK: u64 = 1 << 16;
+        let end = grind_candidate_count::<SC::F>();
+        let mut start = 0u64;
+        let witness = loop {
+            assert!(start < end, "failed to find PoW witness");
+            let stop = start.saturating_add(CHUNK).min(end);
+            if let Some(w) = (start..stop)
+                .into_par_iter()
+                .map(PrimeCharacteristicRing::from_u64)
+                .find_first(|witness| self.clone().check_witness(bits, *witness))
+            {
+                break w;
+            }
+            start = stop;
+        };
         assert!(self.check_witness(bits, witness));
         witness
     }
