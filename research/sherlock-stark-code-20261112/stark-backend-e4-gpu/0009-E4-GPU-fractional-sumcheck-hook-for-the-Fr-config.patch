+    /// The fractional sumcheck on the GPU (mori-gpu `frac`); layers below `MIN_ROWS` points
+    /// stay on the CPU. `E4_GPU_FRAC=0` turns it off.
+    pub struct FracGpu;
+
+    impl FracGkrAccel<F> for FracGpu {
+        fn build_tree(&self, tree: &mut [Frac<F>], total_rounds: usize) -> bool {
+            if (1usize << total_rounds) < MIN_ROWS {
+                return false;
+            }
+            // SAFETY: Frac is repr(C) (p, q) and F is repr(transparent) over MidnightFq.
+            let flat: &mut [MidnightFq] = unsafe {
+                std::slice::from_raw_parts_mut(tree.as_mut_ptr().cast(), 2 * tree.len())
+            };
+            let ok = mori_gpu::frac::build_tree(flat, total_rounds);
+            static ONCE: std::sync::Once = std::sync::Once::new();
+            if ok {
+                ONCE.call_once(|| {
+                    eprintln!("mori-gpu: fractional sumcheck on the GPU, 2^{total_rounds} leaves")
+                });
+            }
+            ok
+        }
+
+        fn layer_sumcheck(
+            &self,
+            segment: &[Frac<F>],
+            eq: &[F],
+            lambda: F,
+            round: &mut dyn FnMut([F; 3]) -> F,
+        ) -> Option<[F; 4]> {
+            if eq.len() < MIN_ROWS {
+                return None;
+            }
+            // SAFETY: as in build_tree.
+            let seg: &[MidnightFq] =
+                unsafe { std::slice::from_raw_parts(segment.as_ptr().cast(), 2 * segment.len()) };
+            let mut cb = |s: [MidnightFq; 3]| round(s.map(F::from_ff)).to_ff();
+            mori_gpu::frac::layer_sumcheck(seg, as_ff(eq), lambda.to_ff(), &mut cb)
+                .map(|c| c.map(F::from_ff))
+        }
+    }
+
     pub fn as_ff(v: &[F]) -> &[MidnightFq] {
         // SAFETY: Bls12381Fr is repr(transparent) over MidnightFq.
         unsafe { std::slice::from_raw_parts(v.as_ptr().cast(), v.len()) }
@@ -346,6 +389,13 @@ impl StarkProtocolConfig for Bls12381FrPoseidonConfig {
     fn hasher(&self) -> &Self::Hasher {
         &self.hasher
     }
+
+    #[cfg(feature = "gpu")]
+    fn frac_gkr_accel(
+    ) -> Option<&'static dyn openvm_stark_backend::prover::fractional_sumcheck_gkr::FracGkrAccel<EF>>
+    {
+        mori_gpu::frac::enabled().then_some(&gpu::FracGpu as _)
+    }
 }
 
