+/// Accelerator of [`fractional_sumcheck`] ([`StarkProtocolConfig::frac_gkr_accel`]). Each
+/// method may decline (`false` / `None`) before it changes anything; the CPU code then runs.
+pub trait FracGkrAccel<EF>: Sync {
+    /// Fills the internal nodes `tree[1..2^total_rounds]` of the segment tree from the leaves
+    /// `tree[2^total_rounds..]` (node `k` is node `2k` plus node `2k + 1`).
+    fn build_tree(&self, tree: &mut [Frac<EF>], total_rounds: usize) -> bool;
+
+    /// The `n = log2(eq.len())` batched sumcheck rounds of one GKR layer, as the CPU loop of
+    /// [`fractional_sumcheck`]: `segment` is the layer (`2 eq.len()` fractions), `eq` the
+    /// evaluations of `eq(xi, .)`. `round` gets the round polynomial at `1, 2, 3` and returns
+    /// the challenge. Returns `(p_0, q_0, p_1, q_1)` at the folded point. It may return `None`
+    /// only before the first call of `round`.
+    fn layer_sumcheck(
+        &self,
+        segment: &[Frac<EF>],
+        eq: &[EF],
+        lambda: EF,
+        round: &mut dyn FnMut([EF; 3]) -> EF,
+    ) -> Option<[EF; 4]>;
+}
+
 /// Runs the fractional sumcheck protocol using GKR layered circuit.
 ///
 /// # Arguments
