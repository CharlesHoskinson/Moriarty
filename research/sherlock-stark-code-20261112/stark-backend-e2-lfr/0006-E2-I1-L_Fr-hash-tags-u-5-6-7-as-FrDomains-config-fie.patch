+/// `L_Fr` Merkle leaf use code (E2 plan D-3; LEAD, OD-18).
+pub const U_LFR_LEAF: u128 = 5;
+/// `L_Fr` Merkle node use code (E2 plan D-3; LEAD, OD-18).
+pub const U_LFR_NODE: u128 = 6;
+/// `L_Fr` transcript use code (E2 plan D-3; LEAD, OD-18).
+pub const U_LFR_TRANSCRIPT: u128 = 7;
+
+impl FrDomains {
+    /// The domain set of the `L_Fr` proof's own hashes: u = 5 (leaf), 6 (node), 7 (transcript).
+    pub const fn l_fr() -> Self {
+        Self {
+            u_leaf: U_LFR_LEAF,
+            u_node: U_LFR_NODE,
+            u_transcript: U_LFR_TRANSCRIPT,
+        }
+    }
+}
+
+/// A domain set fixed at the type level, so an engine's `new(params)` picks its use codes.
+pub trait DomainSet: Send + Sync + 'static {
+    const DOMAINS: FrDomains;
+}
+
+/// u = 1, 2, 3 ([`FrDomains::default`]).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultDomains;
+impl DomainSet for DefaultDomains {
+    const DOMAINS: FrDomains = FrDomains {
+        u_leaf: U_LEAF,
+        u_node: U_NODE,
+        u_transcript: U_TRANSCRIPT,
+    };
+}
+
+/// u = 5, 6, 7 ([`FrDomains::l_fr`]).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct LfrDomains;
+impl DomainSet for LfrDomains {
+    const DOMAINS: FrDomains = FrDomains::l_fr();
+}
