+//! Sherlock E2 increment I1: the `L_Fr` hash tags (plan D-3, LEAD pending OD-18).
+//!
+//! The `L_Fr` proof's own Merkle leaf, node and transcript use the codes u = 5, 6, 7, distinct
+//! from `L`'s u = 1, 2, 3 and from u = 0 and u = 4 (PROPOSAL 3.6). A proof made at one domain set
+//! is refused by a verifier at the other, in both directions, and each of the three codes is
+//! bound on its own.
+//!
+//! Run: `cargo test -p openvm-stark-sdk --release --features bls12381-fr-poseidon --test e2_domains`.
+#![cfg(feature = "bls12381-fr-poseidon")]
+
+use openvm_stark_backend::{
+    interaction::LogUpSecurityParameters,
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    test_utils::{FibFixture, InteractionsFixture11, TestFixture},
+    verifier::verify,
+    StarkEngine, SystemParams, WhirConfig, WhirParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    cap_fixed, cap_var, Bls12381FrPoseidonConfig, Bls12381FrPoseidonCpuEngine,
+    Bls12381FrPoseidonLfrCpuEngine, Bls12381FrPoseidonLfrRefEngine, DefaultDomains, DomainSet,
+    FrDomains, LfrDomains, MidnightPoseidonFr, U_LFR_LEAF, U_LFR_NODE, U_LFR_TRANSCRIPT,
+};
+
+type SC = Bls12381FrPoseidonConfig;
+
+fn small_params() -> SystemParams {
+    let (l_skip, n_stack, k_whir, log_blowup) = (2, 8, 4, 1);
+    let whir_params = WhirParams {
+        k: k_whir,
+        log_final_poly_len: (l_skip + n_stack) % k_whir,
+        query_phase_pow_bits: 6,
+        folding_pow_bits: 5,
+        mu_pow_bits: 4,
+        proximity: WhirProximityStrategy::UniqueDecoding,
+    };
+    SystemParams {
+        l_skip,
+        n_stack,
+        w_stack: 64,
+        log_blowup,
+        whir: WhirConfig::new(log_blowup, l_skip + n_stack, whir_params, 40),
+        logup: LogUpSecurityParameters {
+            max_interaction_count: 1 << 30,
+            log_max_message_length: 7,
+            pow_bits: 7,
+        },
+        max_constraint_degree: 3,
+    }
+}
+
+fn verifies(d: FrDomains, vk: &MultiStarkVerifyingKey<SC>, proof: &Proof<SC>) -> bool {
+    let config = SC::new(small_params(), MidnightPoseidonFr::new(), d);
+    let mut ts = config.transcript();
+    verify(&config, vk, proof, &mut ts).is_ok()
+}
+
+#[test]
+fn e2_lfr_domain_codes() {
+    let l = FrDomains::l_fr();
+    let d = FrDomains::default();
+    assert_eq!((l.u_leaf, l.u_node, l.u_transcript), (5, 6, 7));
+    assert_eq!((U_LFR_LEAF, U_LFR_NODE, U_LFR_TRANSCRIPT), (5, 6, 7));
+    assert_eq!(LfrDomains::DOMAINS, l);
+    assert_eq!(DefaultDomains::DOMAINS, d);
+    // Every L_Fr code differs from every PROPOSAL 3.6 code (u = 0 to 4) and from each other.
+    let lfr = [l.u_leaf, l.u_node, l.u_transcript];
+    for (i, u) in lfr.iter().enumerate() {
+        assert!(!(0..=4).contains(u), "L_Fr code {u} is a PROPOSAL 3.6 code");
+        for v in &lfr[i + 1..] {
+            assert_ne!(u, v);
+        }
+    }
+    // Initial capacities: every fixed length below 2^64 and the transcript give distinct cells.
+    for len in [1u128, 2, 18, 36, 1 << 20] {
+        for u in 0..=4u128 {
+            assert_ne!(cap_fixed(l.u_leaf, len), cap_fixed(u, len));
+            assert_ne!(cap_fixed(l.u_node, len), cap_fixed(u, len));
+            assert_ne!(cap_fixed(l.u_leaf, len), cap_var(u));
+        }
+    }
+    for u in 0..=4u128 {
+        assert_ne!(cap_var(l.u_transcript), cap_var(u));
+    }
+    // The engines at the L_Fr set carry the L_Fr domains.
+    let e = Bls12381FrPoseidonLfrCpuEngine::new(small_params());
+    assert_eq!(e.config().domains(), l);
+    let r = Bls12381FrPoseidonLfrRefEngine::new(small_params());
+    assert_eq!(r.config().domains(), l);
+    let b = Bls12381FrPoseidonCpuEngine::new(small_params());
+    assert_eq!(b.config().domains(), d);
+}
+
+#[test]
+fn e2_lfr_domains_bound_both_directions() {
+    let l = FrDomains::l_fr();
+    let d = FrDomains::default();
+    let fib = FibFixture::new(0, 1, 1 << 9);
+
+    let e_l = Bls12381FrPoseidonLfrCpuEngine::new(small_params());
+    let (vk_l, pf_l) = fib.keygen_and_prove(&e_l);
+    let e_d = Bls12381FrPoseidonCpuEngine::new(small_params());
+    let (vk_d, pf_d) = fib.keygen_and_prove(&e_d);
+
+    // Each proof verifies at its own domain set.
+    assert!(
+        verifies(l, &vk_l, &pf_l),
+        "L_Fr-domain proof refused at L_Fr domains"
+    );
+    assert!(
+        verifies(d, &vk_d, &pf_d),
+        "default-domain proof refused at default domains"
+    );
+    // Each is refused at the other set.
+    assert!(
+        !verifies(d, &vk_l, &pf_l),
+        "L_Fr-domain proof accepted at default domains"
+    );
+    assert!(
+        !verifies(l, &vk_d, &pf_d),
+        "default-domain proof accepted at L_Fr domains"
+    );
+
+    // Each code is bound on its own: change one code of the L_Fr set, keep the other two.
+    for (name, one) in [
+        (
+            "leaf",
+            FrDomains {
+                u_leaf: d.u_leaf,
+                ..l
+            },
+        ),
+        (
+            "node",
+            FrDomains {
+                u_node: d.u_node,
+                ..l
+            },
+        ),
+        (
+            "transcript",
+            FrDomains {
+                u_transcript: d.u_transcript,
+                ..l
+            },
+        ),
+    ] {
+        assert!(
+            !verifies(one, &vk_l, &pf_l),
+            "L_Fr proof accepted with the {name} code at u = 1..3"
+        );
+    }
+    println!("E2_I1: L_Fr-domain and default-domain Fib proofs each refused at the other set; leaf, node and transcript codes each bound");
+}
+
+#[test]
+fn e2_lfr_domains_interactions() {
+    // A LogUp fixture at the L_Fr domains, both engines.
+    let fx = InteractionsFixture11;
+    let e = Bls12381FrPoseidonLfrCpuEngine::new(small_params());
+    let (vk, pf) = fx.keygen_and_prove(&e);
+    assert!(verifies(FrDomains::l_fr(), &vk, &pf));
+    assert!(!verifies(FrDomains::default(), &vk, &pf));
+    let r = Bls12381FrPoseidonLfrRefEngine::new(small_params());
+    let (vk, pf) = fx.keygen_and_prove(&r);
+    assert!(verifies(FrDomains::l_fr(), &vk, &pf));
+}
