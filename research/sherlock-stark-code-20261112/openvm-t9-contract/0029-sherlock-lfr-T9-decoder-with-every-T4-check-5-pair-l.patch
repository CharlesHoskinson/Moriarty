+/// Lane of the `popeq` read of the anchor cell (`a_in`).
+pub const LANE_POPEQ: usize = 10;
+/// Lane of the anchor write value of a chunk (`a_out`).
+pub const LANE_A_OUT: usize = 20;
+
+fn neg(x: u64) -> Fr {
+    Fr::ZERO - Fr::from_u64(x)
+}
+
+/// The prologue template lanes of every entry (`dup 0`; `idx` cell 0 uncached; `popeq`).
+pub fn tpl_ord() -> Vec<(usize, Fr)> {
+    let c = Fr::from_u64;
+    vec![(2, c(0x30)), (3, c(0x50)), (4, c(1)), (5, c(1)), (6, c(0)), (7, c(0x0c)), (8, c(1)), (9, neg(2))]
+}
+
+/// The template lanes of a chunk's anchor write (`push` key cell 0; `push` value; `ins`).
+pub fn tpl_chunk() -> Vec<(usize, Fr)> {
+    let c = Fr::from_u64;
+    vec![
+        (11, c(0x10)),
+        (12, c(1)),
+        (13, c(1)),
+        (14, c(1)),
+        (15, c(0)),
+        (16, c(0x11)),
+        (17, c(1)),
+        (18, c(1)),
+        (19, neg(2)),
+        (21, c(0x91)),
+    ]
+}
+
+/// The `acceptRun` lanes of `claim_pub` (twice) and `outcome_pub` with the prologue (MEASURED
+/// from the compiled ledger contract): an ordinary call; a chunk's lanes move by the 11 lanes of
+/// the anchor write (test data of the bench `L`).
+pub const LANE_CLAIM: [u64; 2] = [20, 34];
+pub const LANE_OUTCOME: u64 = 39;
+/// The `openClaim` lanes: `set_pub`, `claim_pub` twice, `outcome_pub` (MEASURED).
+pub const OPEN_SET: u64 = 20;
+pub const OPEN_CLAIM: [u64; 2] = [35, 49];
+pub const OPEN_OUTCOME: u64 = 54;
+
+/// `DOM_LAYOUT` (ENC-3, FP-4 code 11) and the measured ledger layout of PR 7.2.
+pub const DOM_LAYOUT: u64 = 11;
+pub const LAYOUT_DOMAIN: &str = "midnight:binding-input[v1]";
+
+/// ENC-3: `layout_d = P2(DOM_LAYOUT, dom_len: u16, domain bytes (one byte per word), offset:
+/// u32)`, owner rulings P-3, P-4; `offset = dom_len + 32` (two 16-bit limbs low first).
+pub fn layout_d_of(domain: &[u8]) -> [u64; 8] {
+    let off = domain.len() as u64 + 32;
+    let mut xs = vec![domain.len() as u64];
+    xs.extend(domain.iter().map(|&b| b as u64));
+    xs.extend([off & 0xffff, off >> 16]);
+    p2(DOM_LAYOUT, &xs)
+}
+
+pub fn layout_d() -> [u64; 8] {
+    layout_d_of(LAYOUT_DOMAIN.as_bytes())
+}
+
+/// Key constants of the decoder (wrap key constants): `X` (the cached-trace commitment of `L`
