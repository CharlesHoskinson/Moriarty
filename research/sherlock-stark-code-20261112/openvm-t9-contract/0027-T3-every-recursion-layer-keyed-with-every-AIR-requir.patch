+/// Keygen with every AIR required (no proof may leave an AIR out); the same as upstream
+/// `continuations::prover::keygen_all_required`, without the continuations dependency.
+pub fn keygen_required<E: StarkEngine>(
+    engine: &E,
+    airs: &[AirRef<E::SC>],
+) -> (MultiStarkProvingKey<E::SC>, MultiStarkVerifyingKey<E::SC>) {
