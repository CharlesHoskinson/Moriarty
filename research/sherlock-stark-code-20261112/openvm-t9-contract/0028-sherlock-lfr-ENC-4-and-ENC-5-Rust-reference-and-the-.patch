+++ b/crates/sherlock-lfr/src/enc45.rs
@@ -0,0 +1,1284 @@
+//! Sherlock ENC-4 and ENC-5: the typed BabyBear layouts of the stack records, `StackStep` and
+//! `StackCells` (kit STACKS), and the canonical word lists of the static plan behind `plan_d`.
+//!
+//! Sources (Moriarty worktree `t9-contract`):
+//! - `research/sherlock-enc-fp3-20261112/RESULTS.md` section 4 (owner rulings P-5: `DOM_PLAN` = 41;
+//!   P-6: `op` codes 0 none, 1 push, 2 pop, `count: u64`; P-3: `P2` is the overwrite sponge).
+//! - `research/sherlock-tested-design-20261113/T5-SCHEMAS.md` section 1.3, 1.6 and Appendix A
+//!   (owner SIGNED 2026-11-13): frame record 13 lanes, task record 7 lanes, widest-lane rule,
+//!   `ridx = u64` (AD-12, FP-9.2), so frame 52 words and task 19 words.
+//! - `research/sherlock-final-design-20261111/ARCHITECTURE.md` 1.6 (the shard plan and `plan_d`),
+//!   1.11 FP-1 (word types), FP-4 (tag codes), FP-9.1 (`RefC` with `Input` = 2), kit STACKS.
+//! - `research/sherlock-processor-final-20261111/PROPOSAL.md` 4.2 (what `sherlock plan` makes).
+//!
+//! Word types (FP-1, I-1 and I-2 FROZEN): `bit` 1, `tag(w)` 1, `u16` 1, `u32` 2, `u64` 4,
+//! `addr` 5 (TOP = 63, top limb below 4), `u128` 8, `digest` 8. Multi-limb integers are 16-bit
+//! limbs, little-endian (limb 0 least significant). Every encoder here refuses a value outside
+//! its type range; nothing is reduced mod p.
+//!
+//! Choices that no text fixes are marked `LEAD` in the comments; each is listed in the T9 report.
+
+use openvm_stark_backend::p3_symmetric::Permutation;
+use openvm_stark_sdk::config::baby_bear_poseidon2::{
+    poseidon2_compress_with_capacity, poseidon2_perm,
+};
+use p3_baby_bear::BabyBear;
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use serde_json::{json, Value};
+
+/// The BabyBear modulus.
+pub const P: u32 = 2_013_265_921;
+
+// ---------------------------------------------------------------------------------------------
+// Errors
+// ---------------------------------------------------------------------------------------------
+
+/// A refusal of an encoder: a value outside its type range, a broken padding or framing rule.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct EncError(pub String);
+
+impl std::fmt::Display for EncError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+impl std::error::Error for EncError {}
+
+pub type Res<T> = Result<T, EncError>;
+
+fn refuse<T>(msg: impl Into<String>) -> Res<T> {
+    Err(EncError(msg.into()))
+}
+
+// ---------------------------------------------------------------------------------------------
+// FP-1 word types
+// ---------------------------------------------------------------------------------------------
+
+/// TOP of AD-1 (owner ruling, I-2 FROZEN).
+pub const TOP: u32 = 63;
+/// `addr` limbs: `ceil((TOP + 3) / 16)` = 5.
+pub const ADDR_LIMBS: usize = (TOP as usize + 3).div_ceil(16);
+/// The bound of the top `addr` limb: `2^(TOP + 3 - 16 (n_a - 1))` = 4.
+pub const ADDR_TOP_BOUND: u32 = 1 << (TOP + 3 - 16 * (ADDR_LIMBS as u32 - 1));
+
+/// One FP-1 type. `Digest` is handled by [`digest_words`]; the integer types by [`Ty::enc`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ty {
+    Bit,
+    /// `tag(w)`, `1 <= w <= 16`: one word below `2^w`.
+    Tag(u32),
+    U16,
+    U32,
+    U64,
+    Addr,
+    U128,
+    Digest,
+}
+
+impl Ty {
+    pub fn words(self) -> usize {
+        match self {
+            Ty::Bit | Ty::Tag(_) | Ty::U16 => 1,
+            Ty::U32 => 2,
+            Ty::U64 => 4,
+            Ty::Addr => ADDR_LIMBS,
+            Ty::U128 | Ty::Digest => 8,
+        }
+    }
+
+    pub fn name(self) -> String {
+        match self {
+            Ty::Bit => "bit".into(),
+            Ty::Tag(w) => format!("tag({w})"),
+            Ty::U16 => "u16".into(),
+            Ty::U32 => "u32".into(),
+            Ty::U64 => "u64".into(),
+            Ty::Addr => "addr".into(),
+            Ty::U128 => "u128".into(),
+            Ty::Digest => "digest".into(),
+        }
+    }
+
+    /// The exclusive bound of an integer type (`None` for `u128`, whose bound is `2^128`).
+    fn bound(self) -> Option<u128> {
+        match self {
+            Ty::Bit => Some(2),
+            Ty::Tag(w) => Some(1u128 << w),
+            Ty::U16 => Some(1 << 16),
+            Ty::U32 => Some(1 << 32),
+            Ty::U64 => Some(1 << 64),
+            Ty::Addr => Some(1 << (TOP + 3)),
+            Ty::U128 => None,
+            Ty::Digest => Some(0),
+        }
+    }
+
+    /// The words of the integer `v` of this type, or a refusal if `v` is out of range.
+    pub fn enc(self, what: &str, v: u128) -> Res<Vec<u32>> {
+        if let Ty::Tag(w) = self {
+            assert!((1..=16).contains(&w), "tag width {w}");
+        }
+        if self == Ty::Digest {
+            return refuse(format!("{what}: a digest is not an integer"));
+        }
+        if let Some(b) = self.bound() {
+            if v >= b {
+                return refuse(format!("{what}: {v} out of range of {}", self.name()));
+            }
+        }
+        Ok(match self {
+            Ty::Bit | Ty::Tag(_) | Ty::U16 => vec![v as u32],
+            _ => (0..self.words()).map(|i| ((v >> (16 * i)) & 0xffff) as u32).collect(),
+        })
+    }
+}
+
+/// A `digest` lane: 8 words, each canonical (below p). A non-canonical word is refused: the
+/// permutation would otherwise reduce it and two word lists would alias.
+pub fn digest_words(what: &str, d: &[u32; 8]) -> Res<Vec<u32>> {
+    if let Some(w) = d.iter().find(|w| **w >= P) {
+        return refuse(format!("{what}: digest word {w} not canonical"));
+    }
+    Ok(d.to_vec())
+}
+
+/// Checks that every word of a list is canonical (below p).
+pub fn canonical(what: &str, ws: &[u32]) -> Res<()> {
+    match ws.iter().find(|w| **w >= P) {
+        Some(w) => refuse(format!("{what}: word {w} not canonical")),
+        None => Ok(()),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// P2 (FP-4 form, owner-confirmed absorption P-3) on two paths
+// ---------------------------------------------------------------------------------------------
+
+/// `P2(tag, xs)` by the overwrite sponge: `state[8] = 1 + l`, each block of 8 words of
+/// `[tag, xs..]` (last zero padded) overwrites `state[0..8]`, one Poseidon2-16 permutation per
+/// block, output `state[0..8]`.
+pub fn p2_overwrite(tag: u32, xs: &[u32]) -> [u32; 8] {
+    let mut words = vec![tag];
+    words.extend_from_slice(xs);
+    let mut st = [BabyBear::ZERO; 16];
+    st[8] = BabyBear::from_u32(words.len() as u32);
+    for blk in words.chunks(8) {
+        for i in 0..8 {
+            st[i] = BabyBear::from_u32(*blk.get(i).unwrap_or(&0));
+        }
+        poseidon2_perm().permute_mut(&mut st);
+    }
+    std::array::from_fn(|i| st[i].as_canonical_u32())
+}
+
+/// The same hash as a chain of the stock `poseidon2_compress_with_capacity(block, cap)`, with
+/// `cap_0 = [1 + l, 0, ..]` and the capacity half carried between calls.
+pub fn p2_compress(tag: u32, xs: &[u32]) -> [u32; 8] {
+    let mut words = vec![tag];
+    words.extend_from_slice(xs);
+    let mut cap = [BabyBear::ZERO; 8];
+    cap[0] = BabyBear::from_u32(words.len() as u32);
+    let mut out = [BabyBear::ZERO; 8];
+    for blk in words.chunks(8) {
+        let left: [BabyBear; 8] =
+            std::array::from_fn(|i| BabyBear::from_u32(*blk.get(i).unwrap_or(&0)));
+        let (o, c) = poseidon2_compress_with_capacity(left, cap);
+        out = o;
+        cap = c;
+    }
+    out.map(|x| x.as_canonical_u32())
+}
+
+/// `P2(tag, xs)`: refuses a non-canonical word, computes both paths and asserts equality.
+pub fn p2(tag: u32, xs: &[u32]) -> Res<[u32; 8]> {
+    canonical("P2 input", xs)?;
+    let a = p2_overwrite(tag, xs);
+    let b = p2_compress(tag, xs);
+    assert_eq!(a, b, "P2 two paths disagree, tag {tag}");
+    Ok(a)
+}
+
+/// Permutations of one `P2` over `l` words after the tag: `ceil((1 + l) / 8)`.
+pub fn p2_perms(l: usize) -> usize {
+    (1 + l).div_ceil(8)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Tag codes (FP-4)
+// ---------------------------------------------------------------------------------------------
+
+/// `DOM_STATE_BODY` (FP-4), for reference: the HASH registry entry `StateBody` already has it.
+pub const DOM_STATE_BODY: u32 = 30;
+/// The HASH registry `MemRec, MemPad, MemEmpty, MemNode, FrameChain, TaskChain, StateBody,
+/// RomLeaf, RomNode` (kit HASH, `HashDomain`) takes 33 to 40 in registry order, `StateBody`
+/// skipped (it has 30): DERIVED, and consistent with `DOM_MEMREC` 33, `DOM_ROMLEAF` 39,
+/// `DOM_ROMNODE` 40 of FP-4.
+pub const DOM_MEMREC: u32 = 33;
+pub const DOM_MEMPAD: u32 = 34;
+pub const DOM_MEMEMPTY: u32 = 35;
+pub const DOM_MEMNODE: u32 = 36;
+pub const DOM_FRAMECHAIN: u32 = 37;
+pub const DOM_TASKCHAIN: u32 = 38;
+pub const DOM_ROMLEAF: u32 = 39;
+pub const DOM_ROMNODE: u32 = 40;
+/// `DOM_PLAN` = 41 (owner ruling P-5).
+pub const DOM_PLAN: u32 = 41;
+/// LEAD (ENC-5): the five part digests of `plan_d` take the next free codes after the T5 codes
+/// 42 to 57, in the order of `plan_d` (FP-4 rule "every later Sherlock digest takes the next
+/// free codes"); one tag per part so no two part lists share a domain with each other or with
+/// `plan_d`.
+pub const DOM_PLAN_ITAB: u32 = 58;
+pub const DOM_PLAN_MENU: u32 = 59;
+pub const DOM_PLAN_POLICY: u32 = 60;
+pub const DOM_PLAN_LAYOUT: u32 = 61;
+pub const DOM_PLAN_PLACE: u32 = 62;
+/// The version word of `plan_d` (ARCHITECTURE 1.6: `1: u16`).
+pub const PLAN_VERSION: u32 = 1;
+
+// =============================================================================================
+// ENC-4: the stack records
+// =============================================================================================
+
+/// `ridx`, the ROM row index type: `u64` (AD-12, `D_row` = 64, FP-9.2, signed).
+pub const RIDX: Ty = Ty::U64;
+
+/// Frame record lane types (T5 Appendix A frame table at `ridx = u64`: lanes 1, 5, 8, 9, 12
+/// widen from `u32` to `u64`). 52 words, DERIVED.
+pub const FRAME_TYPES: [Ty; 13] = [
+    Ty::Tag(4), // 0 kind, 10 kinds 0..9
+    RIDX,       // 1
+    Ty::Addr,   // 2
+    Ty::Addr,   // 3
+    Ty::Addr,   // 4
+    RIDX,       // 5
+    Ty::Addr,   // 6
+    Ty::Addr,   // 7
+    RIDX,       // 8
+    RIDX,       // 9
+    Ty::Bit,    // 10
+    Ty::Addr,   // 11
+    RIDX,       // 12
+];
+
+/// Task record lane types (T5 Appendix A task table at `ridx = u64`: lane 1 widens to `u64`).
+/// LEAD: lane 3 is `tag(2)`, not the table's `tag(1)`: it carries `EqualTask.right.tag` and
+/// `PairTask.arg.tag`, and the signed `RefC` tag is `rtag: tag(2)` with `Input` = 2 (FP-9.1,
+/// O1-1 (a)); the widest-lane rule then gives `tag(2)`. No word count changes. 19 words, DERIVED.
+pub const TASK_TYPES: [Ty; 7] = [
+    Ty::Tag(2), // 0 kind, 3 kinds 0..2
+    RIDX,       // 1
+    Ty::Addr,   // 2
+    Ty::Tag(2), // 3
+    Ty::Addr,   // 4
+    Ty::Tag(1), // 5
+    Ty::U32,    // 6
+];
+
+/// Lanes used by each frame kind (the reference `encode_frame`, `hm/c6_phys.rs:670-783`): every
+/// lane at or above this count is padding and must be zero (T5 1.4 padding rule; the reference
+/// decode `zero(S, l, used, FRAME_LANES)`).
+pub const FRAME_USED: [usize; 10] = [6, 6, 5, 3, 6, 6, 9, 5, 4, 13];
+/// Lanes used by each task kind (`encode_task_record`, `hm/c6_phys_helper.rs:988-1016`).
+pub const TASK_USED: [usize; 3] = [5, 7, 5];
+
+pub const FRAME_KIND_NAMES: [&str; 10] = [
+    "LetF",
+    "LeftF",
+    "RightF",
+    "UnaryF",
+    "IfF",
+    "MatchF",
+    "ArgsF",
+    "ReturnF",
+    "ScopeF",
+    "ConstructorFieldsF",
+];
+pub const TASK_KIND_NAMES: [&str; 3] = ["ValidateTask", "EqualTask", "PairTask"];
+
+pub fn type_words(tys: &[Ty]) -> usize {
+    tys.iter().map(|t| t.words()).sum()
+}
+
+/// The typed words of a reference lane image (`[u128; n]`, the reference lane form): kind in
+/// range of its enumeration, every lane in range of its lane type, every unused lane zero.
+fn encode_lanes(
+    rec: &str,
+    tys: &[Ty],
+    used: &[usize],
+    names: &[&str],
+    lanes: &[u128],
+) -> Res<Vec<u32>> {
+    if lanes.len() != tys.len() {
+        return refuse(format!("{rec}: {} lanes, expected {}", lanes.len(), tys.len()));
+    }
+    let kind = lanes[0];
+    if kind >= used.len() as u128 {
+        return refuse(format!("{rec}: kind {kind} out of 0..{}", used.len()));
+    }
+    let k = kind as usize;
+    if let Some(l) = (used[k]..lanes.len()).find(|&l| lanes[l] != 0) {
+        return refuse(format!("{rec} {}: padding lane {l} non-zero", names[k]));
+    }
+    let mut out = Vec::with_capacity(type_words(tys));
+    for (l, (ty, v)) in tys.iter().zip(lanes).enumerate() {
+        out.extend(ty.enc(&format!("{rec} lane {l}"), *v)?);
+    }
+    Ok(out)
+}
+
+/// The typed words of a reference frame lane image (13 lanes).
+pub fn encode_frame_lanes(lanes: &[u128]) -> Res<Vec<u32>> {
+    encode_lanes("frame", &FRAME_TYPES, &FRAME_USED, &FRAME_KIND_NAMES, lanes)
+}
+
+/// The typed words of a reference task lane image (7 lanes).
+pub fn encode_task_lanes(lanes: &[u128]) -> Res<Vec<u32>> {
+    encode_lanes("task", &TASK_TYPES, &TASK_USED, &TASK_KIND_NAMES, lanes)
+}
+
+/// `RefC = (rtag, idx)` (FP-9.1): `Const(i)` 0 with `i: ridx`, `Data(i)` 1 and `Input(i)` 2 with
+/// `i: addr`. Raw integers, so that an out-of-range value can be offered and refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RefC {
+    pub rtag: u128,
+    pub idx: u128,
+}
+
+impl RefC {
+    pub fn konst(i: u128) -> Self {
+        RefC { rtag: 0, idx: i }
+    }
+    pub fn data(i: u128) -> Self {
+        RefC { rtag: 1, idx: i }
+    }
+    pub fn input(i: u128) -> Self {
+        RefC { rtag: 2, idx: i }
+    }
+    fn check(&self, what: &str) -> Res<()> {
+        let idx_ty = match self.rtag {
+            0 => RIDX,
+            1 | 2 => Ty::Addr,
+            t => return refuse(format!("{what}: rtag {t} out of 0..=2")),
+        };
+        idx_ty.enc(&format!("{what}.idx"), self.idx).map(|_| ())
+    }
+    fn put(&self, o: &mut [u128], at: usize) {
+        o[at] = self.rtag;
+        o[at + 1] = self.idx;
+    }
+}
+
+/// `EnvRootC = Option<addr>`: `(present: bit, at: addr)`.
+pub type Env = Option<u128>;
+
+fn put_env(what: &str, o: &mut [u128], at: usize, e: Env) -> Res<()> {
+    if let Some(a) = e {
+        Ty::Addr.enc(what, a)?;
+        o[at] = 1;
+        o[at + 1] = a;
+    }
+    Ok(())
+}
+
+/// A program slice (`start: ridx, len: ridx`, C2-6) or a heap slice of `value_slots`
+/// (`start: addr`, `len: u32`, T5 Appendix A "SliceC len is u32").
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Slice {
+    pub start: u128,
+    pub len: u128,
+}
+
+fn put_slice(what: &str, o: &mut [u128], at: usize, s: Slice, heap: bool) -> Res<()> {
+    let (ts, tl) = if heap { (Ty::Addr, Ty::U32) } else { (RIDX, RIDX) };
+    ts.enc(&format!("{what}.start"), s.start)?;
+    tl.enc(&format!("{what}.len"), s.len)?;
+    o[at] = s.start;
+    o[at + 1] = s.len;
+    Ok(())
+}
+
+fn field(ty: Ty, what: &str, v: u128) -> Res<u128> {
+    ty.enc(what, v)?;
+    Ok(v)
+}
+
+/// `BinaryOp` has 7 values (0 Add .. 6 Branch, `hm/c6_phys.rs:364-373`), carried as `tag(3)`.
+fn binop(what: &str, v: u128) -> Res<u128> {
+    field(Ty::Tag(3), what, v)?;
+    if v >= 7 {
+        return refuse(format!("{what}: BinaryOp {v} out of 0..7"));
+    }
+    Ok(v)
+}
+
+/// The frame record (`FrameRowC`, `hm/shared.rs:867-927`), with the field types of T5 Appendix A
+/// at `ridx = u64`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Frame {
+    LetF { binder: u128, body: u128, saved_env: Env, origin: u128 },
+    LeftF { op: u128, right: u128, saved_env: Env, origin: u128 },
+    RightF { op: u128, left: RefC, origin: u128 },
+    UnaryF { op: u128, origin: u128 },
+    IfF { then_expr: u128, else_expr: u128, saved_env: Env, origin: u128 },
+    MatchF { arms: Slice, saved_env: Env, origin: u128 },
+    ArgsF { function_name: u128, completed: Slice, rest: Slice, saved_env: Env, origin: u128 },
+    ReturnF { return_type: u128, saved_env: Env, origin: u128 },
+    ScopeF { saved_env: Env, origin: u128 },
+    ConstructorFieldsF {
+        type_id: u128,
+        ctor_id: u128,
+        index: u128,
+        field_type: u128,
+        checked: u128,
+        completed: Slice,
+        rest: Slice,
+        saved_env: Env,
+        origin: u128,
+    },
+}
+
+impl Frame {
+    /// The reference lane image (the lane map of `encode_frame`), each field checked against its
+    /// own type first.
+    pub fn lanes(&self) -> Res<[u128; 13]> {
+        use Frame as F;
+        let mut o = [0u128; 13];
+        let r = RIDX;
+        match *self {
+            F::LetF { binder, body, saved_env, origin } => {
+                o[1] = field(r, "LetF.binder", binder)?;
+                o[2] = field(r, "LetF.body", body)?;
+                put_env("LetF.saved_env", &mut o, 3, saved_env)?;
+                o[5] = field(r, "LetF.origin", origin)?;
+            }
+            F::LeftF { op, right, saved_env, origin } => {
+                o[0] = 1;
+                o[1] = binop("LeftF.op", op)?;
+                o[2] = field(r, "LeftF.right", right)?;
+                put_env("LeftF.saved_env", &mut o, 3, saved_env)?;
+                o[5] = field(r, "LeftF.origin", origin)?;
+            }
+            F::RightF { op, left, origin } => {
+                o[0] = 2;
+                o[1] = binop("RightF.op", op)?;
+                left.check("RightF.left")?;
+                left.put(&mut o, 2);
+                o[4] = field(r, "RightF.origin", origin)?;
+            }
+            F::UnaryF { op, origin } => {
+                o[0] = 3;
+                o[1] = field(Ty::Tag(1), "UnaryF.op", op)?;
+                o[2] = field(r, "UnaryF.origin", origin)?;
+            }
+            F::IfF { then_expr, else_expr, saved_env, origin } => {
+                o[0] = 4;
+                o[1] = field(r, "IfF.then_expr", then_expr)?;
+                o[2] = field(r, "IfF.else_expr", else_expr)?;
+                put_env("IfF.saved_env", &mut o, 3, saved_env)?;
+                o[5] = field(r, "IfF.origin", origin)?;
+            }
+            F::MatchF { arms, saved_env, origin } => {
+                o[0] = 5;
+                put_slice("MatchF.arms", &mut o, 1, arms, false)?;
+                put_env("MatchF.saved_env", &mut o, 3, saved_env)?;
+                o[5] = field(r, "MatchF.origin", origin)?;
+            }
+            F::ArgsF { function_name, completed, rest, saved_env, origin } => {
+                o[0] = 6;
+                o[1] = field(r, "ArgsF.function_name", function_name)?;
+                put_slice("ArgsF.completed", &mut o, 2, completed, true)?;
+                put_slice("ArgsF.rest", &mut o, 4, rest, false)?;
+                put_env("ArgsF.saved_env", &mut o, 6, saved_env)?;
+                o[8] = field(r, "ArgsF.origin", origin)?;
+            }
+            F::ReturnF { return_type, saved_env, origin } => {
+                o[0] = 7;
+                o[1] = field(r, "ReturnF.return_type", return_type)?;
+                put_env("ReturnF.saved_env", &mut o, 2, saved_env)?;
+                o[4] = field(r, "ReturnF.origin", origin)?;
+            }
+            F::ScopeF { saved_env, origin } => {
+                o[0] = 8;
+                put_env("ScopeF.saved_env", &mut o, 1, saved_env)?;
+                o[3] = field(r, "ScopeF.origin", origin)?;
+            }
+            F::ConstructorFieldsF {
+                type_id,
+                ctor_id,
+                index,
+                field_type,
+                checked,
+                completed,
+                rest,
+                saved_env,
+                origin,
+            } => {
+                o[0] = 9;
+                o[1] = field(r, "ConstructorFieldsF.type_id", type_id)?;
+                o[2] = field(r, "ConstructorFieldsF.ctor_id", ctor_id)?;
+                // a field index below `max_arity`: u32 (T5 Appendix A)
+                o[3] = field(Ty::U32, "ConstructorFieldsF.index", index)?;
+                o[4] = field(r, "ConstructorFieldsF.field_type", field_type)?;
+                o[5] = field(Ty::Bit, "ConstructorFieldsF.checked", checked)?;
+                put_slice("ConstructorFieldsF.completed", &mut o, 6, completed, true)?;
+                put_slice("ConstructorFieldsF.rest", &mut o, 8, rest, false)?;
+                put_env("ConstructorFieldsF.saved_env", &mut o, 10, saved_env)?;
+                o[12] = field(r, "ConstructorFieldsF.origin", origin)?;
+            }
+        }
+        Ok(o)
+    }
+}
+
+/// `TaskVisitC`: 0 `Unvisited`, 1 `Fields` (`hm/shared.rs:395-398`), `tag(1)`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Task {
+    ValidateTask { r: RefC, visit: u128, cursor: u128 },
+    EqualTask { left: RefC, right: RefC, visit: u128, cursor: u128 },
+    PairTask { binder: u128, sort: u128, arg: RefC },
+}
+
+impl Task {
+    /// The reference lane image (the lane map of `encode_task_record`).
+    pub fn lanes(&self) -> Res<[u128; 7]> {
+        let mut o = [0u128; 7];
+        match *self {
+            Task::ValidateTask { r, visit, cursor } => {
+                r.check("ValidateTask.r")?;
+                r.put(&mut o, 1);
+                o[3] = field(Ty::Tag(1), "ValidateTask.visit", visit)?;
+                // a cursor below `max_arity`: u32
+                o[4] = field(Ty::U32, "ValidateTask.cursor", cursor)?;
+            }
+            Task::EqualTask { left, right, visit, cursor } => {
+                o[0] = 1;
+                left.check("EqualTask.left")?;
+                left.put(&mut o, 1);
+                right.check("EqualTask.right")?;
+                right.put(&mut o, 3);
+                o[5] = field(Ty::Tag(1), "EqualTask.visit", visit)?;
+                o[6] = field(Ty::U32, "EqualTask.cursor", cursor)?;
+            }
+            Task::PairTask { binder, sort, arg } => {
+                o[0] = 2;
+                o[1] = field(RIDX, "PairTask.binder", binder)?;
+                o[2] = field(RIDX, "PairTask.sort", sort)?;
+                arg.check("PairTask.arg")?;
+                arg.put(&mut o, 3);
+            }
+        }
+        Ok(o)
+    }
+}
