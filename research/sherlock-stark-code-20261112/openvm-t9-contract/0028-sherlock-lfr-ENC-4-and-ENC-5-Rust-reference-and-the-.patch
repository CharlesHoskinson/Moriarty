+#[test]
+fn t9_enc4_refusals() {
+    use Frame as F;
+    let bad = |r: Result<Vec<u32>, EncError>| assert!(r.is_err(), "accepted: {r:?}");
+    // lane level: each lane type refuses its first value out of range
+    let mut l = Frame::LetF { binder: 1, body: 2, saved_env: Some(3), origin: 4 }.lanes().unwrap();
+    assert!(encode_frame_lanes(&l).is_ok());
+    for (lane, v) in [(0usize, 10u128), (1, 1 << 64), (4, 1 << 66), (5, 1 << 64)] {
+        let mut m = l;
+        m[lane] = v;
+        bad(encode_frame_lanes(&m));
+    }
+    l[6] = 1; // padding lane of LetF (uses lanes 0..6)
+    bad(encode_frame_lanes(&l));
+    let mut cf = frames()[9].lanes().unwrap();
+    cf[10] = 2; // bit lane
+    bad(encode_frame_lanes(&cf));
+    cf[10] = 1;
+    cf[11] = 1 << 66; // addr top limb 4
+    bad(encode_frame_lanes(&cf));
+    let mut tl = tasks()[1].lanes().unwrap();
+    assert!(encode_task_lanes(&tl).is_ok());
+    for (lane, v) in [(0usize, 3u128), (3, 4), (5, 2), (6, 1 << 32)] {
+        let mut m = tl;
+        m[lane] = v;
+        bad(encode_task_lanes(&m));
+    }
+    tl[0] = 0; // ValidateTask uses lanes 0..5: lanes 5, 6 must be zero
+    bad(encode_task_lanes(&tl));
+    // field level
+    bad(F::LeftF { op: 7, right: 0, saved_env: None, origin: 0 }.words());
+    bad(F::UnaryF { op: 2, origin: 0 }.words());
+    bad(F::RightF { op: 0, left: RefC { rtag: 3, idx: 0 }, origin: 0 }.words());
+    bad(F::RightF { op: 0, left: RefC::konst(1 << 64), origin: 0 }.words());
+    bad(F::RightF { op: 0, left: RefC::data(1 << 66), origin: 0 }.words());
+    assert!(F::RightF { op: 0, left: RefC::data(AMAX), origin: 0 }.words().is_ok());
+    let cfi = |index| F::ConstructorFieldsF {
+        type_id: 0,
+        ctor_id: 0,
+        index,
+        field_type: 0,
+        checked: 0,
+        completed: Slice { start: 0, len: 0 },
+        rest: Slice { start: 0, len: 0 },
+        saved_env: None,
+        origin: 0,
+    };
+    bad(cfi(1 << 32).words());
+    bad(F::ArgsF {
+        function_name: 0,
+        completed: Slice { start: 0, len: 1 << 32 },
+        rest: Slice { start: 0, len: 0 },
+        saved_env: None,
+        origin: 0,
+    }
+    .words());
+    bad(Task::ValidateTask { r: RefC::konst(0), visit: 2, cursor: 0 }.words());
+    bad(Task::PairTask { binder: 1 << 64, sort: 0, arg: RefC::konst(0) }.words());
+    // StackStep
+    let f = frames()[0];
+    bad(StackStep::<Frame> { rw: 0, rw_top: None, op: 3, new_top: None }.words());
+    bad(StackStep::<Frame> { rw: 2, rw_top: None, op: 0, new_top: None }.words());
+    bad(StackStep { rw: 0, rw_top: Some(f), op: 0, new_top: None }.words());
+    bad(StackStep::<Frame> { rw: 0, rw_top: None, op: OP_PUSH, new_top: None }.words());
+    bad(StackStep { rw: 0, rw_top: None, op: OP_POP, new_top: Some(f) }.words());
+    // StackCells
+    let e = empty_below::<Frame>();
+    bad(StackCells { count: 1 << 64, below: [1; 8], top: Some(f) }.words());
+    bad(StackCells { count: 0, below: e, top: Some(f) }.words());
+    bad(StackCells::<Frame> { count: 1, below: e, top: None }.words());
+    bad(StackCells { count: 1, below: [0; 8], top: Some(f) }.words()); // stack_count_one_below_nonempty
+    bad(StackCells::<Frame> { count: 0, below: [0; 8], top: None }.words()); // below not EMPTY
+    bad(StackCells { count: 2, below: [P, 0, 0, 0, 0, 0, 0, 0], top: Some(f) }.words());
+    assert!(h_chain(1, &[P, 0, 0, 0, 0, 0, 0, 0], &f).is_err());
+    // a changed word changes the digest
+    let d = h_chain(1, &e, &f).unwrap();
+    assert_ne!(d, h_chain(2, &e, &f).unwrap(), "depth is bound (stack_count_unchecked)");
+    let f2 = F::LetF { binder: 3, body: 5, saved_env: Some(A65), origin: 10 };
+    assert_ne!(d, h_chain(1, &e, &f2).unwrap(), "record is bound");
+    let mut e2 = e;
+    e2[7] ^= 1;
+    assert_ne!(d, h_chain(1, &e2, &f).unwrap(), "predecessor is bound");
+    // frame and task domains differ (stack_frame_task_domain_swapped)
+    let mut xs = Ty::U64.enc("c", 1).unwrap();
+    xs.extend(e);
+    xs.extend(f.words().unwrap());
+    assert_ne!(p2(DOM_FRAMECHAIN, &xs).unwrap(), p2(DOM_TASKCHAIN, &xs).unwrap());
+    assert_ne!(empty_below::<Frame>(), empty_below::<Task>());
+}
