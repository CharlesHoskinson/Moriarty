+//! `sherlock plan` (T9, ENC-5): reads a plan JSON and prints the five canonical word lists, their
+//! `P2` digests and `plan_d = P2(DOM_PLAN = 41, 1: u16, itab_d, menu_d, policy_d, layout_rule_d,
+//! place_d)` as one JSON object. The format and every LEAD pick are in `sherlock_lfr::enc45`.
+//!
+//! Usage: `sherlock_plan [plan.json]` (default: the bench sample `examples/plan.json`).
+
+use sherlock_lfr::enc45::{plan_from_json, plan_report};
+
+fn main() {
+    let text = match std::env::args().nth(1) {
+        Some(p) => std::fs::read_to_string(&p).unwrap_or_else(|e| panic!("read {p}: {e}")),
+        None => include_str!("plan.json").to_string(),
+    };
+    let v: serde_json::Value = serde_json::from_str(&text).expect("plan JSON");
+    match plan_from_json(&v).and_then(|p| p.words()) {
+        Ok(out) => println!("{}", serde_json::to_string_pretty(&plan_report(&out)).unwrap()),
+        Err(e) => {
+            eprintln!("sherlock plan: refused: {e}");
+            std::process::exit(2);
+        }
+    }
+}
diff --git a/crates/sherlock-lfr/src/enc45.rs b/crates/sherlock-lfr/src/enc45.rs
