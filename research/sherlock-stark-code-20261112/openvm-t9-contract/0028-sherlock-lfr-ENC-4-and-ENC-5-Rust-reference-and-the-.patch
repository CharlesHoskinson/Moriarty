+#[test]
+fn t9_enc5_refusals() {
+    let base = plan();
+    let d0 = base.words().unwrap().plan_d;
+    let bad = |p: Plan, why: &str| assert!(p.words().is_err(), "accepted: {why}");
+    let mut p = base.clone();
+    p.itab.entries[0].rows[1][2] = P;
+    bad(p, "itab word not canonical");
+    let mut p = base.clone();
+    p.itab.entries[0].rows[1].push(0);
+    bad(p, "itab row width");
+    let mut p = base.clone();
+    p.itab.entries.swap(0, 1);
+    bad(p, "itab entries unsorted");
+    let mut p = base.clone();
+    p.menu.node_arity = 5;
+    bad(p, "node arity 5");
+    let mut p = base.clone();
+    p.menu.shapes[0].log_heights[0] = 32;
+    bad(p, "log_h over tag(5)");
+    let mut p = base.clone();
+    p.menu.shapes[0].log_heights.pop();
+    bad(p, "heights length");
+    let mut p = base.clone();
+    p.menu.shapes.swap(0, 1);
+    bad(p, "shapes unsorted");
+    let mut p = base.clone();
+    p.menu.chip_sets[0].swap(0, 1);
+    bad(p, "chip set unsorted");
+    let mut p = base.clone();
+    p.menu.chip_sets[0].push(10);
+    bad(p, "unknown chip");
+    let mut p = base.clone();
+    p.policy = Policy::Compact { cut_len: 4096, pad: vec![1, 4, 2] };
+    bad(p, "pad unsorted");
+    let mut p = base.clone();
+    p.policy = Policy::Compact { cut_len: 4096, pad: vec![0, 1] };
+    bad(p, "pad 0");
+    let mut p = base.clone();
+    p.policy = Policy::General { cut_rule: 0, rule_max: vec![(121, 1, 5)], pad: vec![1] };
+    bad(p, "rule class 121");
+    let mut p = base.clone();
+    p.policy = Policy::General { cut_rule: 0, rule_max: vec![(2, 1, 5), (1, 1, 5)], pad: vec![1] };
+    bad(p, "rule max unsorted");
+    let mut p = base.clone();
+    p.layout.r[0] = (0, 0);
+    bad(p, "NOP in R");
+    let mut p = base.clone();
+    p.layout.r[1] = (8, 6);
+    bad(p, "DIGEST tag index 6");
+    let mut p = base.clone();
+    p.layout.fill_ops = vec![4, 4];
+    bad(p, "fill op repeated");
+    let mut p = base.clone();
+    p.layout.fill_ops.push(8);
+    bad(p, "DIGEST is not deferrable");
+    let mut p = base.clone();
+    p.place.tier_e = vec![2];
+    bad(p, "tier E shape not in menu");
+    let mut p = base.clone();
+    p.place.discharge_shape = 2;
+    bad(p, "discharge shape not in menu");
+    let mut p = base.clone();
+    p.place.discharge = 3;
+    bad(p, "discharge code 3");
+    // a General policy encodes and differs
+    let mut p = base.clone();
+    p.policy = Policy::General { cut_rule: 0, rule_max: vec![(1, 1, 5), (1, 3, 7)], pad: vec![1, 2] };
+    assert_ne!(p.words().unwrap().plan_d, d0);
+    // a changed word changes the part digest and plan_d
+    let mut p = base.clone();
+    p.itab.entries[1].rows[0][3] += 1;
+    let o = p.words().unwrap();
+    let b = base.words().unwrap();
+    assert_ne!(o.parts[0].3, b.parts[0].3);
+    assert_eq!(o.parts[1..], b.parts[1..]);
+    assert_ne!(o.plan_d, d0);
+    let mut p = base.clone();
+    p.place.gp3 = vec![0];
+    assert_ne!(p.words().unwrap().plan_d, d0);
+    // JSON refusals
+    let mut v: serde_json::Value =
+        serde_json::from_str(include_str!("../examples/plan.json")).unwrap();
+    v["menu"]["chip_sets"][0][0] = "GPU".into();
+    assert!(plan_from_json(&v).is_err());
+}
