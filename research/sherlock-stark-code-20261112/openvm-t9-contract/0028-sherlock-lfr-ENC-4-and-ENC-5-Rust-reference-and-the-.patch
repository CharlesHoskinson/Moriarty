@@ -0,0 +1,437 @@
+//! T9 ENC-4 and ENC-5 vectors on the Rust reference (`sherlock_lfr::enc45`).
+//!
+//! ENC-4: the typed words of the frame record (13 lanes, 52 words) and the task record (7 lanes,
+//! 19 words) at `ridx = u64`, `StackStep` and `StackCells`, `EMPTY_F`, `EMPTY_T` and the
+//! `H_chain` spills of a push sequence. ENC-5: the five word lists of the bench plan
+//! (`examples/plan.json`), their digests and `plan_d`. Every `P2` runs on two paths (overwrite
+//! sponge and a chain of `poseidon2_compress_with_capacity`, asserted equal in `enc45::p2`), and
+//! is checked once more against `iface::p2`. `PIN` holds the outputs (MEASURED); every output is
+//! pinned. `ENC45_PRINT=1` prints `VEC name = value` for each.
+
+use sherlock_lfr::{enc45::*, iface};
+
+fn words(ws: &[u32]) -> String {
+    format!("{ws:?}")
+}
+
+struct Out(Vec<(String, String)>);
+impl Out {
+    fn put(&mut self, k: &str, v: String) {
+        self.0.push((k.to_string(), v));
+    }
+}
+
+fn p2_3(tag: u32, xs: &[u32]) -> [u32; 8] {
+    let d = p2(tag, xs).unwrap();
+    let xs64: Vec<u64> = xs.iter().map(|x| *x as u64).collect();
+    assert_eq!(iface::p2(tag as u64, &xs64).map(|x| x as u32), d, "iface::p2 third path");
+    d
+}
+
+const A65: u128 = (1 << 65) + 1;
+const RMAX: u128 = u64::MAX as u128;
+const AMAX: u128 = (1 << 66) - 1;
+
+/// One sample per frame kind; values exercise every limb (u64 max, addr max, 2^65 + 1).
+fn frames() -> Vec<Frame> {
+    use Frame as F;
+    vec![
+        F::LetF { binder: 3, body: 5, saved_env: Some(A65), origin: 9 },
+        F::LeftF { op: 6, right: RMAX, saved_env: None, origin: 0x0001_0002_0003_0004 },
+        F::RightF { op: 2, left: RefC::data(AMAX), origin: 11 },
+        F::UnaryF { op: 1, origin: 12 },
+        F::IfF { then_expr: 13, else_expr: 14, saved_env: Some(15), origin: 16 },
+        F::MatchF { arms: Slice { start: 17, len: 3 }, saved_env: Some(18), origin: 19 },
+        F::ArgsF {
+            function_name: 20,
+            completed: Slice { start: A65, len: 2 },
+            rest: Slice { start: 21, len: 4 },
+            saved_env: Some(22),
+            origin: 23,
+        },
+        F::ReturnF { return_type: 24, saved_env: Some(25), origin: 26 },
+        F::ScopeF { saved_env: None, origin: 27 },
+        F::ConstructorFieldsF {
+            type_id: 28,
+            ctor_id: 29,
+            index: u32::MAX as u128,
+            field_type: 30,
+            checked: 1,
+            completed: Slice { start: 31, len: 1 },
+            rest: Slice { start: 32, len: 2 },
+            saved_env: Some(AMAX),
+            origin: RMAX,
+        },
+    ]
+}
+
+fn tasks() -> Vec<Task> {
+    vec![
+        Task::ValidateTask { r: RefC::konst(RMAX), visit: 1, cursor: 3 },
+        Task::EqualTask { left: RefC::data(A65), right: RefC::input(7), visit: 0, cursor: 2 },
+        Task::PairTask { binder: 4, sort: 5, arg: RefC::data(6) },
+    ]
+}
+
+fn push<R: StackRec>(r: R) -> StackStep<R> {
+    StackStep { rw: 0, rw_top: None, op: OP_PUSH, new_top: Some(r) }
+}
+
+fn plan() -> Plan {
+    let v: serde_json::Value = serde_json::from_str(include_str!("../examples/plan.json")).unwrap();
+    plan_from_json(&v).unwrap()
+}
+
+fn compute() -> Out {
+    let mut o = Out(vec![]);
+    // FP-1 bus_enc_vectors (limb sanity)
+    o.put("fp1.u64(2^64-1)", words(&Ty::U64.enc("x", RMAX).unwrap()));
+    o.put("fp1.u64(0x0001000200030004)", words(&Ty::U64.enc("x", 0x0001_0002_0003_0004).unwrap()));
+    o.put("fp1.addr(2^65+1)", words(&Ty::Addr.enc("x", A65).unwrap()));
+    o.put("fp1.u128(2^127)", words(&Ty::U128.enc("x", 1 << 127).unwrap()));
+
+    // ENC-4 widths (DERIVED)
+    o.put("enc4.frame.n_words", type_words(&FRAME_TYPES).to_string());
+    o.put("enc4.task.n_words", type_words(&TASK_TYPES).to_string());
+
+    // records
+    for (k, f) in frames().iter().enumerate() {
+        let w = f.words().unwrap();
+        assert_eq!(w.len(), 52);
+        o.put(&format!("enc4.frame[{k}].{}", FRAME_KIND_NAMES[k]), words(&w));
+    }
+    for (k, t) in tasks().iter().enumerate() {
+        let w = t.words().unwrap();
+        assert_eq!(w.len(), 19);
+        o.put(&format!("enc4.task[{k}].{}", TASK_KIND_NAMES[k]), words(&w));
+    }
+
+    // EMPTY constants
+    let ef = empty_below::<Frame>();
+    let et = empty_below::<Task>();
+    assert_eq!(ef, p2_3(DOM_FRAMECHAIN, &[]));
+    assert_eq!(et, p2_3(DOM_TASKCHAIN, &[]));
+    o.put("enc4.EMPTY_F", words(&ef));
+    o.put("enc4.EMPTY_T", words(&et));
+
+    // frame stack: push f0, f1, f2; then pop
+    let fs = frames();
+    let mut st = RefStack::<Frame>::default();
+    let c0 = st.cells().unwrap();
+    assert_eq!(c0.words().unwrap().len(), 64);
+    o.put("enc4.frames.cells(0)", words(&c0.words().unwrap()));
+    let s0 = push(fs[0]);
+    o.put("enc4.frames.step.push(f0)", words(&s0.words().unwrap()));
+    assert_eq!(s0.words().unwrap().len(), 106);
+    assert_eq!(st.apply(&s0).unwrap(), Hashed::None, "push at count 0 does not hash");
+    for (k, f) in fs.iter().enumerate().take(3).skip(1) {
+        let pre = st.cells().unwrap();
+        let h = st.apply(&push(*f)).unwrap();
+        let post = st.cells().unwrap();
+        // the protocol's spill equals the recomputed abstraction chainD
+        assert_eq!(h, Hashed::Spill(post.below));
+        let direct = h_chain(pre.count, &pre.below, pre.top.as_ref().unwrap()).unwrap();
+        let mut xs = Ty::U64.enc("c", pre.count).unwrap();
+        xs.extend(pre.below);
+        xs.extend(pre.top.as_ref().unwrap().words().unwrap());
+        assert_eq!(xs.len() + 1, 65);
+        assert_eq!(p2_perms(xs.len()), 9);
+        assert_eq!(direct, p2_3(DOM_FRAMECHAIN, &xs));
+        o.put(&format!("enc4.frames.below(count={})", k + 1), words(&post.below));
+    }
+    let c3 = st.cells().unwrap();
+    o.put("enc4.frames.cells(3)", words(&c3.words().unwrap()));
+    let pre_below = c3.below;
+    let h = st.apply(&StackStep { rw: 0, rw_top: None, op: OP_POP, new_top: None }).unwrap();
+    assert_eq!(h, Hashed::Restore(pre_below));
+    let c2 = st.cells().unwrap();
+    o.put("enc4.frames.cells(2)", words(&c2.words().unwrap()));
+
+    // task stack: push t0, push t2, then rewrite-then-push (the spill hashes rw_top)
+    let ts = tasks();
+    let mut tk = RefStack::<Task>::default();
+    tk.apply(&push(ts[0])).unwrap();
+    tk.apply(&push(ts[2])).unwrap();
+    let pre = tk.cells().unwrap();
+    o.put("enc4.tasks.below(count=2)", words(&pre.below));
+    let rw_top = Task::PairTask { binder: 4, sort: 5, arg: RefC::data(8) };
+    let step = StackStep { rw: 1, rw_top: Some(rw_top), op: OP_PUSH, new_top: Some(ts[1]) };
+    let sw = step.words().unwrap();
+    assert_eq!(sw.len(), 40);
+    o.put("enc4.tasks.step.rw_push", words(&sw));
+    let h = tk.apply(&step).unwrap();
+    let post = tk.cells().unwrap();
+    let want = h_chain(2, &pre.below, &rw_top).unwrap();
+    assert_eq!(h, Hashed::Spill(want));
+    assert_eq!(post.below, want);
+    // mutant stack_compound_spills_unrewritten_top: the old top gives another digest
+    assert_ne!(want, h_chain(2, &pre.below, pre.top.as_ref().unwrap()).unwrap());
+    let mut xs = Ty::U64.enc("c", 2).unwrap();
+    xs.extend(pre.below);
+    xs.extend(rw_top.words().unwrap());
+    assert_eq!(xs.len() + 1, 32);
+    assert_eq!(p2_perms(xs.len()), 4);
+    assert_eq!(want, p2_3(DOM_TASKCHAIN, &xs));
+    o.put("enc4.tasks.below(count=3,rw_push)", words(&post.below));
+    let cw = post.words().unwrap();
+    assert_eq!(cw.len(), 31);
+    o.put("enc4.tasks.cells(3)", words(&cw));
+
+    // ENC-5
+    let out = plan().words().unwrap();
+    for (name, tag, ws, d) in &out.parts {
+        assert_eq!(*d, p2_3(*tag, ws));
+        o.put(&format!("enc5.{name}.tag"), tag.to_string());
+        o.put(&format!("enc5.{name}.words"), words(ws));
+        o.put(&format!("enc5.{name}_d"), words(d));
+    }
+    assert_eq!(out.plan_words.len(), 41);
+    assert_eq!(out.plan_d, p2_3(DOM_PLAN, &out.plan_words));
+    o.put("enc5.plan.words", words(&out.plan_words));
+    o.put("enc5.plan_d", words(&out.plan_d));
+    o
+}
