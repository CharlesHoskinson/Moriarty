+#[test]
+fn t9_enc45_vectors() {
+    let o = compute();
+    if std::env::var("ENC45_PRINT").is_ok() {
+        for (k, v) in &o.0 {
+            println!("VEC {k} = {v}");
+        }
+    }
+    for (k, v) in PIN {
+        let got = o.0.iter().find(|(a, _)| a == k).unwrap_or_else(|| panic!("missing {k}"));
+        assert_eq!(&got.1, v, "vector {k}");
+    }
+    assert_eq!(PIN.len(), o.0.len(), "every vector pinned");
+}
