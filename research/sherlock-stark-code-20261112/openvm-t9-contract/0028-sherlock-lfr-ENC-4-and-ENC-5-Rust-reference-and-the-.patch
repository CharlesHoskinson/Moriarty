+/// A stack record kind: the frame or the task record.
+pub trait StackRec: Clone + std::fmt::Debug {
+    /// The chain domain of the stack (`FrameChain` or `TaskChain`).
+    const DOM: u32;
+    /// The record width in words.
+    const WORDS: usize;
+    const NAME: &'static str;
+    fn words(&self) -> Res<Vec<u32>>;
+}
+
+impl StackRec for Frame {
+    const DOM: u32 = DOM_FRAMECHAIN;
+    const WORDS: usize = 52;
+    const NAME: &'static str = "frame";
+    fn words(&self) -> Res<Vec<u32>> {
+        encode_frame_lanes(&self.lanes()?)
+    }
+}
+
+impl StackRec for Task {
+    const DOM: u32 = DOM_TASKCHAIN;
+    const WORDS: usize = 19;
+    const NAME: &'static str = "task";
+    fn words(&self) -> Res<Vec<u32>> {
+        encode_task_lanes(&self.lanes()?)
+    }
+}
+
+fn rec_or_zero<R: StackRec>(r: &Option<R>) -> Res<Vec<u32>> {
+    match r {
+        Some(r) => r.words(),
+        None => Ok(vec![0; R::WORDS]),
+    }
+}
+
+/// `StackStep` op codes (owner ruling P-6).
+pub const OP_NONE: u128 = 0;
+pub const OP_PUSH: u128 = 1;
+pub const OP_POP: u128 = 2;
+
+/// `StackStep(stack) = [rw: bit, rw_top: Rec, op: tag(2), new_top: Rec]` (RESULTS section 4),
+/// `2 + 2 |Rec|` words: frame 106, task 40 (DERIVED).
+#[derive(Clone, Debug)]
+pub struct StackStep<R: StackRec> {
+    pub rw: u128,
+    pub rw_top: Option<R>,
+    pub op: u128,
+    pub new_top: Option<R>,
+}
+
+impl<R: StackRec> StackStep<R> {
+    /// The words of the step. Range: `rw` a bit, `op` in `{0, 1, 2}` (tag(2) alone would admit
+    /// 3). LEAD (padding rule, as FP-9.1 for records): `rw_top` is present exactly when `rw = 1`
+    /// and `new_top` exactly when `op = push`; an absent record is `|Rec|` zero words.
+    pub fn words(&self) -> Res<Vec<u32>> {
+        let what = format!("StackStep({})", R::NAME);
+        let mut o = Ty::Bit.enc(&format!("{what}.rw"), self.rw)?;
+        if (self.rw == 1) != self.rw_top.is_some() {
+            return refuse(format!("{what}: rw_top present iff rw = 1"));
+        }
+        o.extend(rec_or_zero(&self.rw_top)?);
+        o.extend(Ty::Tag(2).enc(&format!("{what}.op"), self.op)?);
+        if self.op > OP_POP {
+            return refuse(format!("{what}: op {} out of 0..=2", self.op));
+        }
+        if (self.op == OP_PUSH) != self.new_top.is_some() {
+            return refuse(format!("{what}: new_top present iff op = push"));
+        }
+        o.extend(rec_or_zero(&self.new_top)?);
+        debug_assert_eq!(o.len(), 2 + 2 * R::WORDS);
+        Ok(o)
+    }
+}
+
+/// `EMPTY_F` / `EMPTY_T`: the `below` of a stack with at most one record. LEAD: the tag-only
+/// hash of the chain domain, `P2(DOM_FRAMECHAIN)` / `P2(DOM_TASKCHAIN)`, as every FP-4 constant
+/// (`D_EMPTY = P2(TAG_EMPTY)`, ...): non-zero, and its preimage length 1 differs from every
+/// `H_chain` preimage, so under premise A5 it is outside the range of `H_chain` (the kit STACKS
+/// premise "EMPTY outside its range").
+pub fn empty_below<R: StackRec>() -> [u32; 8] {
+    p2(R::DOM, &[]).expect("tag-only P2")
+}
+
+/// `H_chain(count, below, top) = P2(DOM, count: u64, below: digest, top: Rec)` (kit STACKS
+/// chain; the domain is the `P2` tag word, the FP-4 form of the capacity domain word of the kit
+/// text). Frame 65 words with the tag, 9 permutations; task 32 words, 4 permutations (DERIVED).
+pub fn h_chain<R: StackRec>(count: u128, below: &[u32; 8], top: &R) -> Res<[u32; 8]> {
+    let mut xs = Ty::U64.enc("H_chain.count", count)?;
+    xs.extend(digest_words("H_chain.below", below)?);
+    xs.extend(top.words()?);
+    p2(R::DOM, &xs)
+}
+
+/// `StackCells(stack) = [count: u64, below: digest, top: Rec]`, `12 + |Rec|` words: frame 64,
+/// task 31 (DERIVED; T5 1.6). These cells are body words of `body_d` (FP-9.1); they have no
+/// digest of their own.
+#[derive(Clone, Debug)]
+pub struct StackCells<R: StackRec> {
+    pub count: u128,
+    pub below: [u32; 8],
+    pub top: Option<R>,
+}
+
+impl<R: StackRec> StackCells<R> {
+    /// The words, with the kit STACKS cell invariants: `count = 0` gives a zero top and
+    /// `below = EMPTY`; `count >= 1` has a top; `count = 1` has `below = EMPTY`.
+    pub fn words(&self) -> Res<Vec<u32>> {
+        let what = format!("StackCells({})", R::NAME);
+        let mut o = Ty::U64.enc(&format!("{what}.count"), self.count)?;
+        o.extend(digest_words(&format!("{what}.below"), &self.below)?);
+        if (self.count == 0) == self.top.is_some() {
+            return refuse(format!("{what}: top present iff count >= 1"));
+        }
+        if self.count <= 1 && self.below != empty_below::<R>() {
+            return refuse(format!("{what}: below != EMPTY at count {}", self.count));
+        }
+        o.extend(rec_or_zero(&self.top)?);
+        debug_assert_eq!(o.len(), 12 + R::WORDS);
+        Ok(o)
+    }
+}
+
+/// The reference stack: the list of the reference machine, bottom first. [`RefStack::cells`]
+/// is the cached-top abstraction of kit STACKS: `below = chainD(rest)`,
+/// `chainD([]) = EMPTY`, `chainD(x :: l) = H_chain(|l| + 1, chainD(l), x)`.
+#[derive(Clone, Debug)]
+pub struct RefStack<R: StackRec> {
+    pub items: Vec<R>,
+}
+
+impl<R: StackRec> Default for RefStack<R> {
+    fn default() -> Self {
+        RefStack { items: vec![] }
+    }
+}
+
+/// What one step hashed: the spill or restore digest, if any (at most one per step).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Hashed {
+    None,
+    Spill([u32; 8]),
+    Restore([u32; 8]),
+}
+
+impl<R: StackRec> RefStack<R> {
+    pub fn cells(&self) -> Res<StackCells<R>> {
+        let n = self.items.len();
+        let mut below = empty_below::<R>();
+        for (i, x) in self.items.iter().take(n.saturating_sub(1)).enumerate() {
+            below = h_chain(i as u128 + 1, &below, x)?;
+        }
+        Ok(StackCells { count: n as u128, below, top: self.items.last().cloned() })
+    }
+
+    /// Applies one compound step by the list function of the reference (`owner_runtime.rs:
+    /// 3566-3577`): the rewrite of the top (no-op on an empty list), then none, push or pop (pop
+    /// of an empty list is a no-op). Also computes the protocol's own hash for the step from the
+    /// pre cells (`below' = H_chain(count, below, top*)` for a push at `count >= 1`; the restore
+    /// opening of `below` for a pop at `count >= 2`), so that callers can compare the protocol
+    /// with the recomputed abstraction.
+    pub fn apply(&mut self, st: &StackStep<R>) -> Res<Hashed> {
+        st.words()?;
+        let pre = self.cells()?;
+        if st.rw == 1 {
+            if let (Some(t), Some(new)) = (self.items.last_mut(), st.rw_top.as_ref()) {
+                *t = new.clone();
+            }
+        }
+        let top_star = self.items.last().cloned();
+        let h = match st.op {
+            OP_PUSH => {
+                let h = match (&top_star, pre.count) {
+                    (Some(t), c) if c >= 1 => Hashed::Spill(h_chain(c, &pre.below, t)?),
+                    _ => Hashed::None,
+                };
+                self.items.push(st.new_top.clone().expect("checked"));
+                h
+            }
+            OP_POP => {
+                self.items.pop();
+                if pre.count >= 2 { Hashed::Restore(pre.below) } else { Hashed::None }
+            }
+            _ => Hashed::None,
+        };
+        Ok(h)
+    }
+}
+
+// =============================================================================================
+// ENC-5: the static plan and `plan_d`
+// =============================================================================================
+
+/// LEAD: chip codes of the shape menu, in the order ARCHITECTURE 1.6 names the Compact chips
+/// (base: CPU, ALU, range, Poseidon2, SHA2, log writer; then FIELD-EMU, POSEIDON-FR-EMU,
+/// JUBJUB-EMU). Code 0 is not a chip. The interpreted machine's AIRs (CORE, MEM, ...) have no
+/// code yet: no text lists the general-program chip sets.
+pub const CHIPS: [&str; 9] = [
+    "CPU",
+    "ALU",
+    "RANGE",
+    "POSEIDON2",
+    "SHA2",
+    "LOG",
+    "FIELD_EMU",
+    "POSEIDON_FR_EMU",
+    "JUBJUB_EMU",
+];
+
+/// Log operation codes (ARCHITECTURE 1.8 table; ENC-2): 0 NOP .. 8 DIGEST.
+pub const LOG_OPS: [&str; 9] =
+    ["NOP", "PERM", "H2", "SPONGE", "PATH", "ECMUL", "ECMULG", "PUB", "DIGEST"];
+/// Capacity limits `(B, V, P, E)` (ARCHITECTURE 1.8), codes 0..3 in that order (LEAD).
+pub const LIMITS: [&str; 4] = ["B", "V", "P", "E"];
+/// Discharge placement codes (LEAD): 0 no discharge shard; 1 one DISCHARGE node over the
+/// run's root statement; 2 the root and every consumed claim with fanout or across runs
+/// (PROPOSAL 4.2 item 5 names "claims with fanout, cross-run claims").
+pub const DISCHARGE: [&str; 3] = ["none", "root", "root_and_claims"];
+
+fn len_word(ty: Ty, what: &str, n: usize) -> Res<Vec<u32>> {
+    ty.enc(&format!("{what} length"), n as u128)
+}
+
+fn strictly_ascending<T: PartialOrd + std::fmt::Debug>(what: &str, xs: &[T]) -> Res<()> {
+    match xs.windows(2).find(|w| w[0] >= w[1]) {
+        Some(w) => refuse(format!("{what}: not strictly ascending at {:?}, {:?}", w[0], w[1])),
+        None => Ok(()),
+    }
+}
+
+/// Part 1: the straight-line instruction table of each entry as a preprocessed trace
+/// (ARCHITECTURE 1.6 item (1)). LEAD: no text gives the row format of `R_SL_*`, so the table is
+/// carried as the trace itself: per entry the entry's ROM row index (`entry_a: u64`, as in
+/// `image_d`), the height, the width and the row-major words. LEAD: `itab_d` is the `P2` of
+/// this word list, not the stark-backend preprocessed commitment (that commitment is a key
+/// commitment under `key_root`, and 1.6 says each part digest is a `P2`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Itab {
+    pub entries: Vec<ItabEntry>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ItabEntry {
+    pub entry: u64,
+    pub width: u32,
+    /// `height` rows of `width` canonical words.
+    pub rows: Vec<Vec<u32>>,
+}
+
+impl Itab {
+    /// `[n: u32, per entry (ascending by entry): entry: u64, height: u32, width: u32,
+    /// words: height * width]`.
+    pub fn words(&self) -> Res<Vec<u32>> {
+        let es: Vec<u64> = self.entries.iter().map(|e| e.entry).collect();
+        strictly_ascending("itab entries", &es)?;
+        let mut o = len_word(Ty::U32, "itab", self.entries.len())?;
+        for e in &self.entries {
+            if e.width == 0 {
+                return refuse(format!("itab entry {}: width 0", e.entry));
+            }
+            o.extend(Ty::U64.enc("itab entry", e.entry as u128)?);
+            o.extend(len_word(Ty::U32, "itab height", e.rows.len())?);
+            o.extend(Ty::U32.enc("itab width", e.width as u128)?);
+            for (i, r) in e.rows.iter().enumerate() {
+                if r.len() != e.width as usize {
+                    return refuse(format!("itab entry {} row {i}: width {}", e.entry, r.len()));
+                }
+                canonical(&format!("itab entry {} row {i}", e.entry), r)?;
+                o.extend_from_slice(r);
+            }
+        }
+        Ok(o)
+    }
+}
+
+/// Part 2: the shape menu (ARCHITECTURE 1.6 item (2); PROPOSAL 4.2 item 2: a shape is
+/// `(chip set, area bucket)`; modular-leaf design 5: the shape fixes the chip set, the AIR list
+/// in order and the height of every AIR).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Menu {
+    /// Each chip set: chip codes (1-based into [`CHIPS`]), strictly ascending = the AIR order.
+    pub chip_sets: Vec<Vec<u16>>,
+    pub shapes: Vec<Shape>,
+    /// The node arity, `2..=4` (LD-S10x-2: at most 4).
+    pub node_arity: u16,
+}
+
+/// One area bucket of one chip set: the log2 trace height of each AIR of the chip set, in the
+/// chip set's order. LEAD: heights as `log_h: tag(5)` (powers of two, as every shard height).
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Shape {
+    pub chip_set: u16,
+    pub log_heights: Vec<u8>,
+}
+
+impl Menu {
+    /// `[n_sets: u16, per set: n: u16, chips: u16 .., n_shapes: u16, per shape: chip_set: u16,
+    /// log_h: tag(5) per AIR, node_arity: u16]`. Shapes strictly ascending by
+    /// `(chip_set, log_heights)`, so the list is canonical and shape indices are stable.
+    pub fn words(&self) -> Res<Vec<u32>> {
+        if self.chip_sets.is_empty() || self.shapes.is_empty() {
+            return refuse("menu: no chip set or no shape");
+        }
+        let mut o = len_word(Ty::U16, "chip sets", self.chip_sets.len())?;
+        for (i, cs) in self.chip_sets.iter().enumerate() {
+            if cs.is_empty() {
+                return refuse(format!("chip set {i}: empty"));
+            }
+            strictly_ascending(&format!("chip set {i}"), cs)?;
+            if let Some(c) = cs.iter().find(|c| **c == 0 || **c as usize > CHIPS.len()) {
+                return refuse(format!("chip set {i}: unknown chip code {c}"));
+            }
+            o.extend(len_word(Ty::U16, "chip set", cs.len())?);
+            o.extend(cs.iter().map(|c| *c as u32));
+        }
+        strictly_ascending("shapes", &self.shapes)?;
+        o.extend(len_word(Ty::U16, "shapes", self.shapes.len())?);
+        for (j, s) in self.shapes.iter().enumerate() {
+            let cs = self
+                .chip_sets
+                .get(s.chip_set as usize)
+                .ok_or_else(|| EncError(format!("shape {j}: chip set {} absent", s.chip_set)))?;
+            if s.log_heights.len() != cs.len() {
+                return refuse(format!("shape {j}: {} heights for {} AIRs", s.log_heights.len(), cs.len()));
+            }
+            o.extend(Ty::U16.enc("shape chip_set", s.chip_set as u128)?);
+            for h in &s.log_heights {
+                o.extend(Ty::Tag(5).enc(&format!("shape {j} log_h"), *h as u128)?);
+            }
+        }
+        if !(2..=4).contains(&self.node_arity) {
+            return refuse(format!("node arity {} out of 2..=4", self.node_arity));
+        }
+        o.extend(Ty::U16.enc("node arity", self.node_arity as u128)?);
+        Ok(o)
+    }
+}
+
+/// Part 3: the scheduling policy (ARCHITECTURE 1.6 item (3)).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Policy {
+    /// Stage 1 Compact: the cut points follow from `N_e` alone. LEAD: one parameter
+    /// `cut_len: u64`, the cut points are `{k cut_len : 0 < k cut_len < N_e}`.
+    Compact { cut_len: u64, pad: Vec<u32> },
+    /// General programs: the cut rule (LEAD: code 0 = "a leaf ends at the last step whose
+    /// metered rows fit its shape", the only rule the text names), the per-rule maximum table
+    /// (rule class `tag(7)` 1..=120 of FP-9.3, resource = chip code `u16`, maximum rows `u32`),
+    /// strictly ascending by `(rule, chip)`.
+    General { cut_rule: u8, rule_max: Vec<(u8, u16, u32)>, pad: Vec<u32> },
+}
+
+impl Policy {
+    /// Compact: `[0: tag(1), cut_len: u64, pad]`; General: `[1: tag(1), cut_rule: tag(2),
+    /// n: u32, (rule: tag(7), chip: u16, max: u32) .., pad]`; `pad = [n: u16, counts: u32 ..]`,
+    /// the admitted padded shard counts, strictly ascending, each at least 1.
+    pub fn words(&self) -> Res<Vec<u32>> {
+        let pad = |o: &mut Vec<u32>, p: &[u32]| -> Res<()> {
+            if p.is_empty() || p[0] == 0 {
+                return refuse("padding list empty or holds 0");
+            }
+            strictly_ascending("padding list", p)?;
+            o.extend(len_word(Ty::U16, "padding list", p.len())?);
+            for c in p {
+                o.extend(Ty::U32.enc("pad count", *c as u128)?);
+            }
+            Ok(())
+        };
+        let mut o = vec![];
+        match self {
+            Policy::Compact { cut_len, pad: p } => {
+                if *cut_len == 0 {
+                    return refuse("cut_len 0");
+                }
+                o.push(0);
+                o.extend(Ty::U64.enc("cut_len", *cut_len as u128)?);
+                pad(&mut o, p)?;
+            }
+            Policy::General { cut_rule, rule_max, pad: p } => {
+                o.push(1);
+                if *cut_rule != 0 {
+                    return refuse(format!("cut rule {cut_rule}: only 0 is defined"));
+                }
+                o.extend(Ty::Tag(2).enc("cut_rule", *cut_rule as u128)?);
+                let keys: Vec<(u8, u16)> = rule_max.iter().map(|r| (r.0, r.1)).collect();
+                strictly_ascending("rule maximum table", &keys)?;
+                o.extend(len_word(Ty::U32, "rule maximum table", rule_max.len())?);
+                for (rule, chip, max) in rule_max {
+                    if !(1..=120).contains(rule) {
+                        return refuse(format!("rule class {rule} out of 1..=120"));
+                    }
+                    if *chip == 0 || *chip as usize > CHIPS.len() {
+                        return refuse(format!("rule max: unknown chip code {chip}"));
+                    }
+                    o.extend(Ty::Tag(7).enc("rule", *rule as u128)?);
+                    o.extend(Ty::U16.enc("chip", *chip as u128)?);
+                    o.extend(Ty::U32.enc("max rows", *max as u128)?);
+                }
+                pad(&mut o, p)?;
+            }
+        }
+        Ok(o)
+    }
+}
+
+/// Part 4: the log layout rule (ARCHITECTURE 1.6 item (4), 1.8 "Reservation and the capacity
+/// rule"; PROPOSAL 4.2 item 4): `R` first, then each discretionary operation to the log or tier
+/// E, filling the limits in a fixed order over the operation kinds in a fixed priority.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Layout {
+    /// The reservation `R`, in log order: `(op, param)`.
+    pub r: Vec<(u8, u16)>,
+    /// The limit fill order (codes of [`LIMITS`]); the text: `P`, then `E`, then `V`.
+    pub fill_limits: Vec<u8>,
+    /// The operation priority (codes of [`LOG_OPS`]); the text: `PATH`, `H2`, `ECMUL`.
+    pub fill_ops: Vec<u8>,
+}
+
+impl Layout {
+    /// `[n_r: u16, (op: tag(4), param: u16) .., n_l: u16, limit: tag(2) .., n_o: u16,
+    /// op: tag(4) ..]`. `R` is not empty and holds no `NOP`; `DIGEST` params index the six public
+    /// tags; `SPONGE(n)` has `n >= 1`; `PATH(d)` has `1 <= d <= 32`. The fill lists hold distinct
+    /// codes; fill operations are deferrable kinds (`PERM` to `ECMULG`).
+    pub fn words(&self) -> Res<Vec<u32>> {
+        if self.r.is_empty() {
+            return refuse("layout: R empty");
+        }
+        let mut o = len_word(Ty::U16, "R", self.r.len())?;
+        for (op, param) in &self.r {
+            let ok = match *op {
+                1 | 2 | 5 | 6 => *param == 0,
+                3 => *param >= 1,
+                4 => (1..=32).contains(param),
+                7 => true,
+                8 => *param < 6,
+                _ => false,
+            };
+            if !ok {
+                return refuse(format!("layout: R entry ({op}, {param}) not admitted"));
+            }
+            o.extend(Ty::Tag(4).enc("R op", *op as u128)?);
+            o.extend(Ty::U16.enc("R param", *param as u128)?);
+        }
+        let distinct = |what: &str, xs: &[u8]| -> Res<()> {
+            let mut s = xs.to_vec();
+            s.sort();
+            s.dedup();
+            if s.len() != xs.len() {
+                return refuse(format!("layout: {what} repeats a code"));
+            }
+            Ok(())
+        };
+        distinct("fill_limits", &self.fill_limits)?;
+        o.extend(len_word(Ty::U16, "fill_limits", self.fill_limits.len())?);
+        for l in &self.fill_limits {
+            if *l as usize >= LIMITS.len() {
+                return refuse(format!("layout: limit code {l}"));
+            }
+            o.extend(Ty::Tag(2).enc("limit", *l as u128)?);
+        }
+        distinct("fill_ops", &self.fill_ops)?;
+        o.extend(len_word(Ty::U16, "fill_ops", self.fill_ops.len())?);
+        for op in &self.fill_ops {
+            if !(1..=6).contains(op) {
+                return refuse(format!("layout: fill op {op} not deferrable"));
+            }
+            o.extend(Ty::Tag(4).enc("fill op", *op as u128)?);
+        }
+        Ok(o)
+    }
+}
+
+/// Part 5: the placement rule of discharge shards and of tier E and GP-3 chips (ARCHITECTURE
+/// 1.6 item (4); PROPOSAL 4.2 item 5).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Place {
+    /// A code of [`DISCHARGE`].
+    pub discharge: u8,
+    /// The menu index of the discharge shape (a fixed leaf shape of the plan); 0 when
+    /// `discharge` is 0.
+    pub discharge_shape: u16,
+    /// Menu indices of the shapes that carry tier E chips, strictly ascending.
+    pub tier_e: Vec<u16>,
+    /// Menu indices of the shapes that carry GP-3 chips, strictly ascending.
+    pub gp3: Vec<u16>,
+}
+
+impl Place {
+    /// `[discharge: tag(2), discharge_shape: u16, n_e: u16, shape: u16 .., n_g: u16,
+    /// shape: u16 ..]`. Shape indices are checked against the menu by [`Plan::words`].
+    pub fn words(&self) -> Res<Vec<u32>> {
+        if self.discharge as usize >= DISCHARGE.len() {
+            return refuse(format!("place: discharge code {}", self.discharge));
+        }
+        if self.discharge == 0 && self.discharge_shape != 0 {
+            return refuse("place: discharge shape without discharge");
+        }
+        let mut o = Ty::Tag(2).enc("discharge", self.discharge as u128)?;
+        o.extend(Ty::U16.enc("discharge shape", self.discharge_shape as u128)?);
+        for (what, l) in [("tier_e", &self.tier_e), ("gp3", &self.gp3)] {
+            strictly_ascending(what, l)?;
+            o.extend(len_word(Ty::U16, what, l.len())?);
+            o.extend(l.iter().map(|s| *s as u32));
+        }
+        Ok(o)
+    }
+
+    fn shapes(&self) -> Vec<u16> {
+        let mut v = self.tier_e.clone();
+        v.extend(&self.gp3);
+        if self.discharge != 0 {
+            v.push(self.discharge_shape);
+        }
+        v
+    }
+}
+
+/// The static plan (ARCHITECTURE 1.6): the five parts that `plan_d` binds.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Plan {
+    pub itab: Itab,
+    pub menu: Menu,
+    pub policy: Policy,
+    pub layout: Layout,
+    pub place: Place,
+}
+
+/// The word lists, digests and `plan_d` of a plan.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlanOut {
+    /// `(name, tag, words, digest)` of the five parts, in `plan_d` order.
+    pub parts: Vec<(&'static str, u32, Vec<u32>, [u32; 8])>,
+    /// The `plan_d` preimage after the tag: `1: u16` and the five digests (41 words).
+    pub plan_words: Vec<u32>,
+    pub plan_d: [u32; 8],
+}
+
+impl Plan {
+    pub fn words(&self) -> Res<PlanOut> {
+        let n = self.menu.shapes.len();
+        if let Some(s) = self.place.shapes().iter().find(|s| **s as usize >= n) {
+            return refuse(format!("place: shape {s} not in the menu of {n} shapes"));
+        }
+        let lists = [
+            ("itab", DOM_PLAN_ITAB, self.itab.words()?),
+            ("menu", DOM_PLAN_MENU, self.menu.words()?),
+            ("policy", DOM_PLAN_POLICY, self.policy.words()?),
+            ("layout", DOM_PLAN_LAYOUT, self.layout.words()?),
+            ("place", DOM_PLAN_PLACE, self.place.words()?),
+        ];
+        let mut parts = vec![];
+        let mut plan_words = vec![PLAN_VERSION];
+        for (name, tag, ws) in lists {
+            let d = p2(tag, &ws)?;
+            plan_words.extend(d);
+            parts.push((name, tag, ws, d));
+        }
+        assert_eq!(plan_words.len() + 1, 42, "plan_d preimage is 42 words with the tag");
+        let plan_d = p2(DOM_PLAN, &plan_words)?;
+        Ok(PlanOut { parts, plan_words, plan_d })
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// plan JSON (the input of `sherlock plan`)
+// ---------------------------------------------------------------------------------------------
+
+fn jerr(msg: impl Into<String>) -> EncError {
+    EncError(format!("plan json: {}", msg.into()))
+}
+
+fn ju(v: &Value, what: &str) -> Res<u64> {
+    v.as_u64().ok_or_else(|| jerr(format!("{what}: not an unsigned integer")))
+}
+
+fn jnarrow<T: TryFrom<u64>>(v: &Value, what: &str) -> Res<T> {
+    T::try_from(ju(v, what)?).map_err(|_| jerr(format!("{what}: out of range")))
+}
+
+fn jarr<'a>(v: &'a Value, what: &str) -> Res<&'a Vec<Value>> {
+    v.as_array().ok_or_else(|| jerr(format!("{what}: not an array")))
+}
+
+fn jget<'a>(v: &'a Value, k: &str) -> Res<&'a Value> {
+    v.get(k).ok_or_else(|| jerr(format!("missing key {k}")))
+}
+
+fn jname(v: &Value, table: &[&str], what: &str) -> Res<u8> {
+    let s = v.as_str().ok_or_else(|| jerr(format!("{what}: not a name")))?;
+    table
+        .iter()
+        .position(|n| *n == s)
+        .map(|i| i as u8)
+        .ok_or_else(|| jerr(format!("{what}: unknown name {s}")))
+}
+
+fn jlist<T: TryFrom<u64>>(v: &Value, what: &str) -> Res<Vec<T>> {
+    jarr(v, what)?.iter().map(|x| jnarrow(x, what)).collect()
+}
+
+/// Reads a plan from its JSON form (`crates/sherlock-lfr/examples/plan.json` is the bench
+/// sample). Names map to codes: chips by [`CHIPS`] (1-based), log ops by [`LOG_OPS`], limits by
+/// [`LIMITS`], discharge by [`DISCHARGE`].
+pub fn plan_from_json(v: &Value) -> Res<Plan> {
+    let itab = Itab {
+        entries: jarr(jget(v, "itab")?, "itab")?
+            .iter()
+            .map(|e| {
+                let rows = jarr(jget(e, "rows")?, "rows")?
+                    .iter()
+                    .map(|r| jlist::<u32>(r, "row"))
+                    .collect::<Res<Vec<_>>>()?;
+                Ok(ItabEntry {
+                    entry: ju(jget(e, "entry")?, "entry")?,
+                    width: jnarrow(jget(e, "width")?, "width")?,
+                    rows,
+                })
+            })
+            .collect::<Res<Vec<_>>>()?,
+    };
+    let m = jget(v, "menu")?;
+    let menu = Menu {
+        chip_sets: jarr(jget(m, "chip_sets")?, "chip_sets")?
+            .iter()
+            .map(|cs| {
+                jarr(cs, "chip set")?
+                    .iter()
+                    .map(|c| jname(c, &CHIPS, "chip").map(|i| i as u16 + 1))
+                    .collect::<Res<Vec<_>>>()
+            })
+            .collect::<Res<Vec<_>>>()?,
+        shapes: jarr(jget(m, "shapes")?, "shapes")?
+            .iter()
+            .map(|s| {
+                Ok(Shape {
+                    chip_set: jnarrow(jget(s, "chip_set")?, "chip_set")?,
+                    log_heights: jlist(jget(s, "log_heights")?, "log_heights")?,
+                })
+            })
+            .collect::<Res<Vec<_>>>()?,
+        node_arity: jnarrow(jget(m, "node_arity")?, "node_arity")?,
+    };
+    let p = jget(v, "policy")?;
+    let pad: Vec<u32> = jlist(jget(p, "pad")?, "pad")?;
+    let policy = match jget(p, "mode")?.as_str() {
+        Some("compact") => Policy::Compact { cut_len: ju(jget(p, "cut_len")?, "cut_len")?, pad },
+        Some("general") => Policy::General {
+            cut_rule: jnarrow(jget(p, "cut_rule")?, "cut_rule")?,
+            rule_max: jarr(jget(p, "rule_max")?, "rule_max")?
+                .iter()
+                .map(|r| {
+                    Ok((
+                        jnarrow(jget(r, "rule")?, "rule")?,
+                        jname(jget(r, "chip")?, &CHIPS, "chip")? as u16 + 1,
+                        jnarrow(jget(r, "max")?, "max")?,
+                    ))
+                })
+                .collect::<Res<Vec<_>>>()?,
+            pad,
+        },
+        _ => return Err(jerr("policy.mode: compact or general")),
+    };
+    let l = jget(v, "layout")?;
+    let layout = Layout {
+        r: jarr(jget(l, "r")?, "r")?
+            .iter()
+            .map(|e| {
+                let a = jarr(e, "R entry")?;
+                if a.len() != 2 {
+                    return Err(jerr("R entry: [op, param]"));
+                }
+                Ok((jname(&a[0], &LOG_OPS, "R op")?, jnarrow(&a[1], "R param")?))
+            })
+            .collect::<Res<Vec<_>>>()?,
+        fill_limits: jarr(jget(l, "fill_limits")?, "fill_limits")?
+            .iter()
+            .map(|x| jname(x, &LIMITS, "limit"))
+            .collect::<Res<Vec<_>>>()?,
+        fill_ops: jarr(jget(l, "fill_ops")?, "fill_ops")?
+            .iter()
+            .map(|x| jname(x, &LOG_OPS, "fill op"))
+            .collect::<Res<Vec<_>>>()?,
+    };
+    let pl = jget(v, "place")?;
+    let place = Place {
+        discharge: jname(jget(pl, "discharge")?, &DISCHARGE, "discharge")?,
+        discharge_shape: jnarrow(jget(pl, "discharge_shape")?, "discharge_shape")?,
+        tier_e: jlist(jget(pl, "tier_e")?, "tier_e")?,
+        gp3: jlist(jget(pl, "gp3")?, "gp3")?,
+    };
+    Ok(Plan { itab, menu, policy, layout, place })
+}
+
+/// The JSON report of `sherlock plan`: per part its tag, word list, word count, permutations
+/// and digest, then the `plan_d` preimage and `plan_d`.
+pub fn plan_report(out: &PlanOut) -> Value {
+    let parts: Vec<Value> = out
+        .parts
+        .iter()
+        .map(|(name, tag, ws, d)| {
+            json!({
+                "part": name, "tag": tag, "n_words": ws.len(), "perms": p2_perms(ws.len()),
+                "words": ws, "digest": d,
+            })
+        })
+        .collect();
+    json!({
+        "parts": parts,
+        "plan_tag": DOM_PLAN,
+        "plan_words": out.plan_words,
+        "plan_d": out.plan_d,
+    })
+}
