+/// E3 plan D-7 and D-10: the reservation `R` and the anchor rule, checked on the public words of
+/// `L` (`l_pub`, the index table of `crate::iface`; `l_vals` their values, for the advice of the
+/// two zero tests), with the native replay of `R` (J7, the part of J6 that fits the key):
+///
+/// - `mode` is a bit; entries 0 to 3 are `DIGEST(SHK_PROGC)`, `DIGEST(SHK_INPUT)`,
+///   `DIGEST(SHK_OUTCOME)`, `SPONGE(3)`; entry 4 is `DIGEST(tag_in)`; with `mode` 1 entry 5 is
+///   `DIGEST(tag_out)`; `e_in = 4`, `e_out = 4 + mode`; `tag_in = mode (1 - [j = 1])`, `tag_out =
+///   mode (1 - [j = k])` (`SHK_PROGC` 0, `SHK_LOCK` 1).
+/// - The `SPONGE(3)` inputs are the 3 run `DIGEST` outputs (limb by limb).
+/// - Replay in native Fr: each `DIGEST` output is `Perm(tagFr, x, cap(4, 2))[0]` of its logged
+///   operand (entry 5 only when `mode` is 1), the `SPONGE(3)` output is the `u = 0` sponge of its
+///   inputs. Logged values enter as `sum_i limb_i 2^(30 i)` (`Pack` of each limb, `FrAdd`
+///   doubling); limb range and `Canon` stay with the reader (plan D-9).
+pub fn gen_r_check(g: &mut Gen, l_pub: &[Addr], l_vals: &[u64]) {
+    use crate::iface::{
+        cap_digest, tag_fr, Dims, ANCHOR_IN, DIGEST, E_IN_WORD, E_OUT_WORD, J_WORDS, K_WORDS,
+        LIMBS, LIMB_BITS, MODE_WORD, R_OFF, R_RUN, SHK_LOCK, SHK_PROGC, SPONGE, STMT,
+    };
+    let d = Dims::FULL;
+    assert_eq!(l_pub.len(), d.words());
+    let ent = |i: usize| (l_pub[STMT + 2 * i], l_pub[STMT + 2 * i + 1]);
+    let limb = |j: usize, t: usize| l_pub[d.values_at() + LIMBS * j + t];
+    let one = g.kbb(1);
+    let zero = g.kbb(0);
+    // mode is a bit
+    let mode = l_pub[MODE_WORD];
+    let m1 = g.sub(mode, one);
+    let mm = g.mul(mode, m1);
+    g.assert_eq(mm, zero);
+    // [a = 0] with advice (w, z): a w = 1 - z, a z = 0.
+    let is_zero = |g: &mut Gen, a: Addr, av: u64| -> Addr {
+        let x = BabyBear::from_u64(av);
+        let (w, z) = if av == 0 {
+            (BabyBear::ZERO, BabyBear::ONE)
+        } else {
+            (x.inverse(), BabyBear::ZERO)
+        };
+        let (w, z) = (g.bb_in(w), g.bb_in(z));
+        let aw = g.mul(a, w);
+        let one_z = g.sub(one, z);
+        g.assert_eq(aw, one_z);
+        let az = g.mul(a, z);
+        g.assert_eq(az, zero);
+        z
+    };
+    let p = crate::bb::P;
+    let wv = |i: usize| l_vals[i];
+    let (j_lo, j_hi, k_lo, k_hi) = (
+        l_pub[J_WORDS],
+        l_pub[J_WORDS + 1],
+        l_pub[K_WORDS],
+        l_pub[K_WORDS + 1],
+    );
+    let a = g.sub(j_lo, one);
+    let z1a = is_zero(g, a, (wv(J_WORDS) + p - 1) % p);
+    let z1b = is_zero(g, j_hi, wv(J_WORDS + 1));
+    let z_j1 = g.mul(z1a, z1b);
+    let a = g.sub(j_lo, k_lo);
+    let zka = is_zero(g, a, (wv(J_WORDS) + p - wv(K_WORDS)) % p);
+    let a = g.sub(j_hi, k_hi);
+    let zkb = is_zero(g, a, (wv(J_WORDS + 1) + p - wv(K_WORDS + 1)) % p);
+    let z_jk = g.mul(zka, zkb);
