+/// The lane map of plan D-9: each pair `(lane, entry)` other than `(0, 0)` sets lane `lane` of
+/// the statement to the output (last logged value) of entry `entry`, which must be a `DIGEST` or
+/// a `SPONGE(3)`; the lane must hold zero limbs in the call vector and is set at most once (a
+/// flag, not a value test: a mapped output can be 0; lane `e3-lanemap` finding 2a); lane and entry
+/// are u16 words.
+pub fn apply_lane_map(
+    lanes: Vec<Fr>,
+    pairs: &[(u64, u64)],
+    offs: &[(u64, u64, usize)],
+    vs: &[Fr],
+) -> Result<Vec<Fr>, String> {
+    let mut s = lanes;
+    let mut mapped = vec![false; s.len()];
+    for (k, &(lane, ent)) in pairs.iter().enumerate() {
+        if (lane, ent) == (0, 0) {
+            continue;
+        }
+        if lane >= 1 << 16 || ent >= 1 << 16 {
+            return Err(format!("lane map pair {k}: not u16"));
+        }
+        let (op, param, o) = *offs.get(ent as usize).ok_or("lane map entry")?;
+        if !(op == DIGEST || (op == SPONGE && param == 3))
+            || lane as usize >= s.len()
+            || mapped[lane as usize]
+            || s[lane as usize] != Fr::ZERO
+        {
+            return Err(format!("lane map pair {k}"));
+        }
+        mapped[lane as usize] = true;
+        s[lane as usize] = vs[o + vals(op, param) - 1];
+    }
+    Ok(s)
+}
