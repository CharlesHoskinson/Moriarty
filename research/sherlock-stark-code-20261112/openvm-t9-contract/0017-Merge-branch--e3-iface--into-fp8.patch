+    let x = fr_val(g, R_OFF[5]);
+    let y = fr_val(g, R_OFF[5] + 1);
+    let (tk, _) = g.tape.cswap(tag_out, t_progc, t_lock);
+    let o = g.tape.perm([tk, x, cap]);
+    let (l, _) = g.tape.cswap(mode, y, o[0]);
+    g.assert_eq(l, y);
 }
