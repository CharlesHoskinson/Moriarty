+/// BabyBear tag codes of the onion (F-9).
+pub const TAG_EMPTY: u64 = 1;
+pub const TAG_STEP: u64 = 2;
+pub const TAG_NODE: u64 = 3;
+pub const TAG_ENT: u64 = 4;
+/// Words of `log_d` and `log_n` in the root statement (FP-2).
+pub const LOG_D_WORD: usize = 57;
+pub const LOG_N_WORD: usize = 65;
+
+/// `P2(tag, xs)`: Poseidon2 over BabyBear, width 16, overwrite absorption of `[tag, xs..]` in
+/// blocks of 8 (last block zero padded), `state[8] = 1 + |xs|` first; output `state[0..8]`.
+/// Also returns the permutation inputs, in order.
+pub fn p2_with_inputs(tag: u64, xs: &[u64]) -> ([u64; 8], Vec<[u64; 16]>) {
+    use openvm_stark_backend::{p3_field::PrimeField64, p3_symmetric::Permutation};
+    use openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;
+    use p3_baby_bear::BabyBear;
+    let mut words = vec![tag];
+    words.extend_from_slice(xs);
+    let mut st = [BabyBear::ZERO; 16];
+    st[8] = BabyBear::from_u64(words.len() as u64);
+    let mut ins = vec![];
+    for blk in words.chunks(8) {
+        for i in 0..8 {
+            st[i] = BabyBear::from_u64(*blk.get(i).unwrap_or(&0));
+        }
+        ins.push(st.map(|x| x.as_canonical_u64()));
+        poseidon2_perm().permute_mut(&mut st);
+    }
+    (std::array::from_fn(|i| st[i].as_canonical_u64()), ins)
+}
+
+pub fn p2(tag: u64, xs: &[u64]) -> [u64; 8] {
+    p2_with_inputs(tag, xs).0
+}
+
+/// ENC-2: `enc(e) = [op, param] ++ limbs(v_0) ++ ...`.
+pub fn enc(e: &Entry) -> Vec<u64> {
+    let mut w = vec![e.op, e.param];
+    for v in &e.values {
+        w.extend(limbs(*v));
+    }
+    w
+}
+
+/// The onion of one log segment: `d_0 = P2(TAG_EMPTY)`, `d_(i+1) = P2(tagStep, d_i,
+/// P2(tagEnt, enc(e_i)))`.
+pub fn onion(log: &[Entry]) -> [u64; 8] {
+    let mut d = p2(TAG_EMPTY, &[]);
+    for e in log {
+        let h = p2(TAG_ENT, &enc(e));
+        let x: Vec<u64> = d.iter().chain(h.iter()).copied().collect();
+        d = p2(TAG_STEP, &x);
+    }
+    d
+}
+
+/// A log `(d, n)` (FP-2: `log_d`, `log_n`).
+pub type Log = ([u64; 8], u64);
+
+/// The log of one segment: `(onion(seg), |seg|)`.
+pub fn seg_log(seg: &[Entry]) -> Log {
+    (onion(seg), seg.len() as u64)
+}
+
+/// ARCHITECTURE 1.11 log update rule: `merge(a, b)` is `b` if `n_a = 0`, `a` if `n_b = 0`, else
+/// `(P2(TAG_NODE, d_a, d_b), n_a + n_b)`; `None` when the output `n` is not below 2^16 (the node's
+/// range check).
+pub fn log_merge(a: Log, b: Log) -> Option<Log> {
+    let r = if a.1 == 0 {
+        b
+    } else if b.1 == 0 {
+        a
+    } else {
+        let x: Vec<u64> = a.0.iter().chain(b.0.iter()).copied().collect();
+        (p2(TAG_NODE, &x), a.1 + b.1)
+    };
+    (r.1 < 1 << 16).then_some(r)
+}
