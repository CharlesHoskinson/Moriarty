+//! E3 J8: the log onion in `L` (`iface_l::OnionAir`) on a small `L_iface`: the 4 interface AIRs
+//! with their onion buses, the onion AIR, and a stand-in key table for the Poseidon2 permute bus
+//! (in the bench `L` the keys come from its `Poseidon2Air`, which constrains the permutation).
+//!
+//! Accepted: the honest cases. Refused by the prover: `log_d` of the root statement changed; one
+//! logged value changed with `log_d` kept; `log_n` changed.
+
+use std::sync::Arc;
+
+use openvm_recursion_circuit::bus::{Poseidon2PermuteBus, Poseidon2PermuteMessage};
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, BaseAir},
+    p3_field::Field,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, BaseAirWithPublicValues, PartitionedBaseAir, StarkEngine,
+};
+use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonCpuEngine;
+use p3_baby_bear::BabyBear;
+use sherlock_lfr::{
+    fixture::LSC,
+    iface::{self, Case, Dims},
+    iface_l,
+    testing::small_params_n,
+};
+
+const SMALL: Dims = Dims {
+    b: 32,
+    v: 64,
+    p: 32,
+    l_tx: 62,
+};
+const PERM_BUS: u16 = 950;
+
+/// Stand-in key table: `(input, output, mult)` rows, keys on the permute bus.
+#[derive(Clone, Copy)]
+struct KeyTable;
+impl<F: Field> BaseAir<F> for KeyTable {
+    fn width(&self) -> usize {
+        33
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for KeyTable {}
+impl<F: Field> PartitionedBaseAir<F> for KeyTable {}
+impl<AB: InteractionBuilder> Air<AB> for KeyTable {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let l = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..33).map(|i| l[i].into()).collect();
+        drop(l);
+        Poseidon2PermuteBus::new(PERM_BUS).add_key_with_lookups(
+            builder,
+            Poseidon2PermuteMessage {
+                input: std::array::from_fn(|i| x[i].clone()),
+                output: std::array::from_fn(|i| x[16 + i].clone()),
+            },
+            x[32].clone(),
+        );
+    }
+}
+
+fn key_trace(ins: &[[u64; 16]], height: usize) -> RowMajorMatrix<BabyBear> {
+    use openvm_stark_backend::{p3_field::PrimeCharacteristicRing, p3_symmetric::Permutation};
+    use openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;
+    let mut keys: Vec<([u64; 16], u64)> = vec![];
+    for i in ins {
+        match keys.iter_mut().find(|(k, _)| k == i) {
+            Some(e) => e.1 += 1,
+            None => keys.push((*i, 1)),
+        }
+    }
+    assert!(keys.len() <= height);
+    let mut v = vec![];
+    for r in 0..height {
+        let (inp, m) = keys.get(r).copied().unwrap_or(([0; 16], 0));
+        let mut st = inp.map(BabyBear::from_u64);
+        let i0 = st;
+        poseidon2_perm().permute_mut(&mut st);
+        v.extend(i0);
+        v.extend(st);
+        v.push(BabyBear::from_u64(m));
+    }
+    RowMajorMatrix::new(v, 33)
+}
+
+fn prove(words: &[u64]) -> Result<(), String> {
+    prove_onion(words, true).map(|_| ())
+}
+
+type VkProof = (
+    openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>,
+    openvm_stark_backend::proof::Proof<LSC>,
+);
+
+/// Prove the small `L_iface` with (`onion`) or without the onion AIR set.
+fn prove_onion(words: &[u64], onion: bool) -> Result<VkProof, String> {
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(small_params_n(4, 8));
+    let perm = Poseidon2PermuteBus::new(PERM_BUS);
+    let mut airs: Vec<AirRef<LSC>> = if onion {
+        iface_l::airs_onion(&SMALL, perm)
+    } else {
+        iface_l::airs(&SMALL)
+    };
+    if onion {
+        airs.push(Arc::new(KeyTable));
+    }
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let (traces, ins) = if onion {
+        iface_l::traces_onion::<BabyBear>(&SMALL, words, perm)
+    } else {
+        (iface_l::traces::<BabyBear>(&SMALL, words), vec![])
+    };
+    let mut ctxs: Vec<_> = traces
+        .into_iter()
+        .map(|(t, pv)| {
+            let cm = ColMajorMatrix::from_row_major(&t);
+            AirProvingContext::simple(engine.device().transport_matrix_to_device(&cm), pv)
+        })
+        .collect();
+    if onion {
+        let kt = key_trace(&ins, 512);
+        ctxs.push(AirProvingContext::simple_no_pis(
+            engine
+                .device()
+                .transport_matrix_to_device(&ColMajorMatrix::from_row_major(&kt)),
+        ));
+    }
+    let proof = engine
+        .prove(&d_pk, ProvingContext::new(ctxs.into_iter().enumerate().collect()))
+        .map_err(|e| format!("prover: {e:?}"))?;
+    engine.verify(&vk, &proof).map_err(|e| format!("verifier: {e:?}"))?;
+    Ok((vk, proof))
+}
+
+/// ESTIMATE of the `L_Fr` cost of the onion: the `gen_verifier` tape of the small `L_iface` with
+/// the onion set (onion AIR, key table, onion buses) against the one without.
+#[test]
+fn j8_tape_delta_small() {
+    use sherlock_lfr::lverify::{gen_verifier, Gen, LShape};
+    let (run, _) = iface::case_run(&SMALL, Case::FullV, 7);
+    let w = run.words();
+    let mut n = vec![];
+    for onion in [false, true] {
+        let (vk, proof) = prove_onion(&w, onion).expect("prove");
+        let mut g = Gen::new();
+        let shape = LShape::of(&proof);
+        let words = gen_verifier(&mut g, &vk, &shape, &proof).expect("pinned shape");
+        g.tape.expose(&words);
+        let (_, failed) = g.tape.execute_checked(&g.inputs);
+        assert!(failed.is_empty());
+        let mut c = std::collections::BTreeMap::<String, usize>::new();
+        for o in &g.tape.ops {
+            let k = format!("{o:?}");
+            *c.entry(k.split([' ', '{', '(']).next().unwrap().to_string()).or_default() += 1;
+        }
+        let air: Vec<String> = vk
+            .inner
+            .per_air
+            .iter()
+            .map(|a| {
+                format!(
+                    "w{} c{} i{}",
+                    a.params.width.total_width(),
+                    a.symbolic_constraints.constraints.constraint_idx.len(),
+                    a.symbolic_constraints.interactions.len()
+                )
+            })
+            .collect();
+        println!(
+            "J8 small tape, onion {onion}: {} ops {c:?}; AIRs {air:?}; log heights {:?}; {} transcript events",
+            g.tape.ops.len(),
+            shape.log_heights,
+            g.tt.log.len()
+        );
+        n.push(g.tape.ops.len());
+    }
+    println!("J8 small tape delta of the onion set: {} ops", n[1] - n[0]);
+}
+
+#[test]
+fn j8_onion_small() {
+    for (case, seed) in [
+        (Case::FullV, 7u64),
+        (Case::AllEntries, 8),
+        (Case::Chunk { j: 2, k: 3 }, 9),
+        (Case::MissingR, 7),
+    ] {
+        let (run, _) = iface::case_run(&SMALL, case, seed);
+        let w = run.words();
+        let r = prove(&w);
+        println!("J8 {case:?}: {} entries, onion rows {}: {r:?}", run.log.len(),
+            iface_l::OnionAir { dims: SMALL, perm: Poseidon2PermuteBus::new(PERM_BUS) }.height());
+        assert!(r.is_ok(), "{case:?}");
+    }
+    let (run, _) = iface::case_run(&SMALL, Case::FullV, 7);
+    let w = run.words();
+    let mut bad = w.clone();
+    bad[iface::LOG_D_WORD] = (bad[iface::LOG_D_WORD] + 1) % sherlock_lfr::bb::P;
+    let r = prove(&bad);
+    println!("J8 log_d changed: {r:?}");
+    assert!(r.is_err());
+    let mut bad = w.clone();
+    let at = SMALL.values_at() + 9 * 20;
+    bad[at] ^= 1;
+    let r = prove(&bad);
+    println!("J8 value 20 changed, log_d kept: {r:?}");
+    assert!(r.is_err());
+    let mut bad = w.clone();
+    bad[iface::LOG_N_WORD] += 1;
+    let r = prove(&bad);
+    println!("J8 log_n changed: {r:?}");
+    assert!(r.is_err());
+}
