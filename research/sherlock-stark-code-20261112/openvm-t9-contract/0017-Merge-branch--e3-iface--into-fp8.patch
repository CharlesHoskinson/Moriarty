+    let (op, param) = ent(3);
+    let (ks, k3) = (g.kbb(SPONGE), g.kbb(3));
+    g.assert_eq(op, ks);
+    g.assert_eq(param, k3);
+    let (op, param) = ent(ANCHOR_IN);
+    let kd = g.kbb(DIGEST);
+    g.assert_eq(op, kd);
+    g.assert_eq(param, tag_in);
+    let (op, param) = ent(ANCHOR_IN + 1);
