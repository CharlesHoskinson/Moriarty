diff --git a/crates/sherlock-wrap-export/examples/d3_wrapin.rs b/crates/sherlock-wrap-export/examples/d3_wrapin.rs
new file mode 100644
index 0000000..1d83fff
--- /dev/null
+++ b/crates/sherlock-wrap-export/examples/d3_wrapin.rs
@@ -0,0 +1,44 @@
+//! Sherlock E6 item 4: D3 (the stark-backend `SoundnessCalculator`) at the `L_Fr` key that a
+//! wrap fixture pins (`wrapin` v1 `vk`), with the stock verdict of its proof and the domains.
+//! usage: d3_wrapin <wrapin.json>...
+use openvm_stark_backend::{keygen::types::MultiStarkVerifyingKey, soundness::SoundnessCalculator};
+use serde_json::{json, Value};
+use sherlock_wrap_export::SC;
+
+fn main() {
+    for path in std::env::args().skip(1) {
+        let doc: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+        let vk: MultiStarkVerifyingKey<SC> = serde_json::from_value(doc["vk"].clone()).unwrap();
+        let s = SoundnessCalculator::calculate_from_vk(&vk);
+        let wd = &s.whir_details;
+        let maxc = vk.inner.per_air.iter().map(|a| a.symbolic_constraints.constraints.constraint_idx.len()).max().unwrap();
+        let maxi = vk.inner.per_air.iter().map(|a| a.symbolic_constraints.interactions.len()).max().unwrap();
+        let cols: usize = vk.inner.per_air.iter().map(|a| a.params.width.total_width()).sum();
+        let pubs: usize = vk.inner.per_air.iter().map(|a| a.params.num_public_values).sum();
+        println!(
+            "E6D3 {}",
+            json!({
+                "file": path,
+                "name": doc["name"],
+                "domains": doc["domains"],
+                "stock_verdict": doc["stock_verdict"],
+                "pre_hash": format!("{:?}", vk.pre_hash),
+                "airs": vk.inner.per_air.len(),
+                "public_values": pubs,
+                "max_constraints_per_air": maxc,
+                "max_interactions_per_air": maxi,
+                "columns": cols,
+                "w_stack": vk.inner.params.w_stack,
+                "log_stacked_height": vk.inner.params.log_stacked_height(),
+                "logup": s.logup_bits, "gkr_sumcheck": s.gkr_sumcheck_bits, "gkr_batching": s.gkr_batching_bits,
+                "zerocheck": s.zerocheck_sumcheck_bits, "constraint_batching": s.constraint_batching_bits,
+                "stacked_reduction": s.stacked_reduction_bits, "whir": s.whir_bits,
+                "whir_mu": wd.mu_batching_bits, "whir_fold": wd.fold_rbr_bits, "whir_query": wd.query_bits,
+                "whir_shift": wd.shift_rbr_bits, "whir_gamma": wd.gamma_batching_bits, "whir_ood": wd.ood_rbr_bits,
+                "total": s.total_bits,
+                "gate_100": s.total_bits >= 100.0,
+            })
+        );
+        assert!(s.total_bits >= 100.0, "{path}: below 100 bits");
+    }
+}
diff --git a/crates/sherlock-wrap-export/examples/lfr_call.rs b/crates/sherlock-wrap-export/examples/lfr_call.rs
new file mode 100644
index 0000000..e5687b9
--- /dev/null
+++ b/crates/sherlock-wrap-export/examples/lfr_call.rs
@@ -0,0 +1,282 @@
+//! Sherlock E6: one `L` -> `L_Fr` chain whose `L` call-vector lanes are a given call vector.
+//!
+//! `L_iface` is the E3 stand-in (`examples/iface_fixture.rs` of `sherlock-lfr`): the bench `L`
+//! (39 AIRs over a bench node) plus the 4 interface AIRs at `Dims::FULL` (12,164 public words).
+//! The run of this binary has the statement head of E3 case seed 11 (mode word 0), the
+//! reservation `R` (3 `DIGEST` entries) as its whole log, an empty lane map, and call-vector
+//! lanes equal to the given 1,026 words. The `L_Fr` tape of E3 J5 (`gen_verifier_full`,
+//! `gen_r_check`, `expose`) verifies that `L` proof at `lfr_params`; the `L_Fr` proof is written
+//! as a `wrapin` v1 file for `tools/sherlock-wrap` (Moriarty).
+//!
+//! usage:
+//!   lfr_call key  OUTDIR                 synthetic lanes (seed 6), keygen; writes OUTDIR/lfr_pk.bitcode,
+//!                                        OUTDIR/lfr-call.json (the fixture the wrap is keyed on)
+//!   lfr_call call OUTDIR VECTOR.json OUT.json
+//!                                        VECTOR.json = {"words": [1,026 decimal Fr]}; reads the
+//!                                        cached pk, asserts the same L_Fr vk, writes OUT.json
+use std::{fs, path::PathBuf, sync::Arc, time::Instant};
+
+use num_bigint::BigUint;
+use openvm_cpu_backend::CpuBackend;
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{
+    AggregationSubCircuit, CachedTraceCtx, VerifierConfig, VerifierSubCircuit, VerifierTraceGen,
+};
+use openvm_stark_backend::{
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    p3_field::PrimeCharacteristicRing,
+    proof::Proof,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, StarkEngine,
+};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonCpuEngine,
+    baby_bear_poseidon2::{
+        default_duplex_sponge_recorder, BabyBearPoseidon2CpuEngine, DuplexSponge,
+        DuplexSpongeRecorder,
+    },
+    bls12381_fr_poseidon::Bls12381Fr as Fr,
+    MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use serde_json::json;
+use sherlock_lfr::{
+    fixture::{internal_ud, l_ud, NodeSC, LSC},
+    fr::fr_from_big,
+    iface::{self, Dims, Run},
+    iface_l,
+    lverify::{gen_r_check, gen_verifier_full, Gen, LShape},
+    machine::Machine,
+    record::stock_log,
+    testing::{lfr_params, range_trace, Engine},
+};
+use sherlock_wrap_export::{export, SC};
+
+type F = BabyBear;
+type Eng = BabyBearPoseidon2CpuEngine<DuplexSponge>;
+type RootEng = BabyBearBls12381PoseidonCpuEngine;
+
+fn w1_proofs(n: usize, log_rows: usize) -> (MultiStarkVerifyingKey<NodeSC>, Vec<Proof<NodeSC>>) {
+    let mut rng = StdRng::seed_from_u64(0x5e7_10c);
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let airs: Vec<AirRef<NodeSC>> = vec![chip.air.clone()];
+    let engine = Eng::new(app_params_with_100_bits_security(MAX_APP_LOG_STACKED_HEIGHT));
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let mut proofs = vec![];
+    for _ in 0..n {
+        let inputs: Vec<[F; 16]> = (0..1usize << log_rows)
+            .map(|_| std::array::from_fn(|_| F::from_u32(rng.random::<u32>() % (1 << 30))))
+            .collect();
+        let trace = chip.generate_trace(inputs);
+        let cm = ColMajorMatrix::from_row_major(&trace);
+        let ctx = ProvingContext::new(vec![(
+            0,
+            AirProvingContext::simple_no_pis(engine.device().transport_matrix_to_device(&cm)),
+        )]);
+        let proof = engine.prove(&d_pk, ctx).expect("w1 prove");
+        engine.verify(&vk, &proof).expect("w1 verify");
+        proofs.push(proof);
+    }
+    (vk, proofs)
+}
+
+fn node_proof(
+    child_vk: &MultiStarkVerifyingKey<NodeSC>,
+    proofs: &[Proof<NodeSC>],
+) -> (MultiStarkVerifyingKey<NodeSC>, Proof<NodeSC>) {
+    let engine = Eng::new(internal_ud());
+    let circuit = <VerifierSubCircuit<2> as VerifierTraceGen<CpuBackend<NodeSC>, NodeSC, ()>>::new(
+        Arc::new(child_vk.clone()),
+        Default::default(),
+    );
+    let child_pcs = circuit.commit_child_vk(&engine, child_vk);
+    let airs = circuit.airs::<NodeSC>();
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctxs = circuit.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        child_vk,
+        CachedTraceCtx::PcsData(child_pcs),
+        proofs,
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    let proof = engine
+        .prove(&d_pk, ProvingContext::new(ctxs.into_iter().enumerate().collect()))
+        .expect("node prove");
+    engine.verify(&vk, &proof).expect("node verify");
+    (vk, proof)
+}
+
+/// The E6 run: head of E3 seed 11 with mode 0, log = `R`, empty lane map, the given lanes.
+fn call_run(d: &Dims, lanes: Vec<Fr>) -> Run {
+    assert_eq!(lanes.len(), d.lanes(), "call vector length");
+    let mut rng = StdRng::seed_from_u64(11);
+    let r = iface::reservation(&mut rng);
+    let plan = iface::plan(d, &r, &[]);
+    assert!(plan.spilled.is_empty());
+    let mut head: Vec<u64> = (0..iface::STMT).map(|_| rng.random::<u64>() % 0x7800_0001).collect();
+    head[iface::MODE_WORD] = 0;
+    for w in head.iter_mut().skip(iface::LANE_MAP).take(2 * iface::LANE_PAIRS) {
+        *w = 0;
+    }
+    Run {
+        dims: *d,
+        head,
+        lanes,
+        lane_map: [(0, 0); iface::LANE_PAIRS],
+        log: plan.log,
+    }
+}
+
+fn synthetic_lanes(d: &Dims) -> Vec<Fr> {
+    let mut rng = StdRng::seed_from_u64(6);
+    (0..d.lanes())
+        .map(|i| {
+            if i < 70 {
+                let b: Vec<u8> = (0..31).map(|_| rng.random::<u8>()).collect();
+                fr_from_big(&BigUint::from_bytes_le(&b))
+            } else {
+                Fr::ZERO
+            }
+        })
+        .collect()
+}
+
+fn read_vector(path: &str) -> Vec<Fr> {
+    let v: serde_json::Value = serde_json::from_slice(&fs::read(path).unwrap()).unwrap();
+    v["words"]
+        .as_array()
+        .expect("words")
+        .iter()
+        .map(|w| {
+            let b: BigUint = w.as_str().expect("decimal string").parse().expect("decimal");
+            let x = fr_from_big(&b);
+            assert_eq!(iface::dec(&iface::limbs(x)), Some(x));
+            assert!(b < BigUint::parse_bytes(b"73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001", 16).unwrap(), "canonical");
+            x
+        })
+        .collect()
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let mode = a[1].as_str();
+    let out = PathBuf::from(&a[2]);
+    fs::create_dir_all(&out).unwrap();
+    let t0 = Instant::now();
+    let dims = Dims::FULL;
+    let lanes = match mode {
+        "key" => synthetic_lanes(&dims),
+        "call" => read_vector(&a[3]),
+        _ => panic!("mode key or call"),
+    };
+    let run = call_run(&dims, lanes);
+    let words = run.words();
+
+    // L_iface: W1 -> node -> L (bench L + 4 interface AIRs), as the E3 fixture.
+    let (w1_vk, proofs) = w1_proofs(2, 20);
+    let (node_vk, node_pf) = node_proof(&w1_vk, &proofs);
+    drop(proofs);
+    let node_s = t0.elapsed().as_secs_f64();
+    let node_vk = Arc::new(node_vk);
+    let engine = RootEng::new(l_ud(48));
+    let cfg = VerifierConfig { has_cached: true, ..Default::default() };
+    let l = <VerifierSubCircuit<1> as VerifierTraceGen<CpuBackend<LSC>, LSC, ()>>::new(node_vk.clone(), cfg);
+    let mut airs = AggregationSubCircuit::airs::<LSC>(&l);
+    let n_bench = airs.len();
+    airs.extend(iface_l::airs(&dims));
+    let (pk, l_vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let cached = CachedTraceCtx::PcsData(l.commit_child_vk(&engine, &node_vk));
+    let mut ctxs = l.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        &node_vk,
+        cached,
+        std::slice::from_ref(&node_pf),
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    assert_eq!(ctxs.len(), n_bench);
+    for (tr, pv) in iface_l::traces::<F>(&dims, &words) {
+        let cm = ColMajorMatrix::from_row_major(&tr);
+        ctxs.push(AirProvingContext::simple(engine.device().transport_matrix_to_device(&cm), pv));
+    }
+    let t = Instant::now();
+    let l_proof = engine
+        .prove(&d_pk, ProvingContext::new(ctxs.into_iter().enumerate().collect()))
+        .expect("L_iface prove");
+    let l_prove_s = t.elapsed().as_secs_f64();
+    engine.verify(&l_vk, &l_proof).expect("L_iface verify");
+    drop(d_pk);
+    drop(pk);
+
+    // L_Fr: the E3 J5 tape over the L proof.
+    let (_, ok) = stock_log(&l_vk, &l_proof);
+    assert!(ok);
+    let shape = LShape::of(&l_proof);
+    let mut g = Gen::new();
+    let (lw, l_pub) = gen_verifier_full(&mut g, &l_vk, &shape, &l_proof).expect("pinned shape");
+    gen_r_check(&mut g, &l_pub);
+    g.tape.expose(&lw);
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed {failed:?}");
+    let m = Machine::new(&g.tape);
+    let pw = m.public_values(&mem).concat();
+    let dec = iface::decode(&dims, &pw).expect("decode");
+    assert_eq!(dec, run.statement(), "decoded statement equals the call vector");
+    let lfr = Engine::new(lfr_params());
+    let fairs = m.airs();
+    let pk_path = out.join("lfr_pk.bitcode");
+    let t = Instant::now();
+    let (fpk, keygen_s): (MultiStarkProvingKey<SC>, f64) = if mode == "key" {
+        let (fpk, _) = lfr.keygen(&fairs);
+        let s = t.elapsed().as_secs_f64();
+        fs::write(&pk_path, bitcode::serialize(&fpk).unwrap()).unwrap();
+        (fpk, s)
+    } else {
+        (bitcode::deserialize(&fs::read(&pk_path).unwrap()).expect("pk cache"), t.elapsed().as_secs_f64())
+    };
+    let fvk = fpk.get_vk();
+    let mut traces = m.traces(&mem);
+    traces.push(range_trace(&fpk, &fairs, &traces));
+    let pis = m.public_values(&mem);
+    let d_fpk = lfr.device().transport_pk_to_device(&fpk);
+    let ctx = ProvingContext::new(
+        traces
+            .iter()
+            .enumerate()
+            .map(|(i, t)| {
+                let cm = ColMajorMatrix::from_row_major(t);
+                (i, AirProvingContext::simple(lfr.device().transport_matrix_to_device(&cm), pis[i].clone()))
+            })
+            .collect(),
+    );
+    let t = Instant::now();
+    let proof = lfr.prove(&d_fpk, ctx).expect("L_Fr prove");
+    let lfr_prove_s = t.elapsed().as_secs_f64();
+    let doc = export("lfr-call", lfr.config(), &fvk, &proof);
+    assert!(doc["stock_verdict"].as_bool().unwrap(), "stock verifier refuses the L_Fr proof");
+    let path = if mode == "key" { out.join("lfr-call.json") } else { PathBuf::from(&a[4]) };
+    fs::write(&path, serde_json::to_vec(&doc).unwrap()).unwrap();
+    let pv_hex: Vec<String> = pw.iter().map(sherlock_wrap_export::hex_be).collect();
+    fs::write(path.with_extension("pv.json"), serde_json::to_vec(&pv_hex).unwrap()).unwrap();
+    println!(
+        "{}",
+        json!({
+            "mode": mode,
+            "file": path.display().to_string(),
+            "l_pre_hash": format!("{:?}", l_vk.pre_hash),
+            "lfr_pre_hash": format!("{:?}", fvk.pre_hash),
+            "lfr_public_words": pw.len(),
+            "lfr_airs": fvk.inner.per_air.len(),
+            "widths": proof.stacking_proof.stacking_openings.iter().map(|v| v.len()).collect::<Vec<_>>(),
+            "node_s": node_s,
+            "l_prove_s": l_prove_s,
+            "lfr_keygen_or_load_s": keygen_s,
+            "lfr_prove_s": lfr_prove_s,
+            "wall_s": t0.elapsed().as_secs_f64(),
+        })
+    );
+}
