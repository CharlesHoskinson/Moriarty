diff --git a/crates/sherlock-lfr/tests/j1_public.rs b/crates/sherlock-lfr/tests/j1_public.rs
new file mode 100644
index 0000000..12da942
--- /dev/null
+++ b/crates/sherlock-lfr/tests/j1_public.rs
@@ -0,0 +1,193 @@
+//! E3 J1: public values of `L` through `L_Fr` on a small `L_iface` (the 4 interface AIRs of
+//! `iface_l` at small `Dims`, `L` config at a small parameter set).
+//!
+//! - `L` side: the stock verifier accepts the small `L_iface` proof; refused: a changed public
+//!   value of `L` (the log tables are also checked by the `L` AIRs).
+//! - `L_Fr` side: the tape of the `L` verifier reads the public values of `L` in the DAG
+//!   (`Entry::Public`); every transcript event equals the stock record; no tape assertion fails;
+//!   the exposed words decode to the native statement (plan D-9); the tape proves at the small
+//!   Fr set with 2 commitments. Refused: the changed `L` public value (tape and prover), and on the
+//!   `L_Fr` carrier a changed first, middle and last public word and two swapped words.
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    StarkEngine,
+};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonCpuEngine,
+    bls12381_fr_poseidon::Bls12381Fr as Fr,
+};
+use p3_baby_bear::BabyBear;
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use sherlock_lfr::{
+    fixture::LSC,
+    iface::{self, Case, Dims},
+    iface_l,
+    lverify::{gen_verifier, Gen, LShape},
+    machine::Machine,
+    record::{stock_log_at, Ev},
+    tape::Val,
+    testing::{preprocessed_airs, prove_verify_range_keyed, small_params_n, Engine},
+    transcript::TEv,
+};
+
+const SMALL: Dims = Dims {
+    b: 32,
+    v: 32,
+    p: 32,
+    l_tx: 14,
+};
+
+fn l_params() -> openvm_stark_backend::SystemParams {
+    small_params_n(4, 8)
+}
+
+/// Keygen and prove the small `L_iface` for `words`; the proof and its vk.
+fn l_iface(words: &[u64]) -> (MultiStarkVerifyingKey<LSC>, Proof<LSC>) {
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(l_params());
+    let airs = iface_l::airs(&SMALL);
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctx = ProvingContext::new(
+        iface_l::traces::<BabyBear>(&SMALL, words)
+            .into_iter()
+            .enumerate()
+            .map(|(i, (t, pv))| {
+                let cm = ColMajorMatrix::from_row_major(&t);
+                (
+                    i,
+                    AirProvingContext::simple(engine.device().transport_matrix_to_device(&cm), pv),
+                )
+            })
+            .collect(),
+    );
+    let proof = engine.prove(&d_pk, ctx).expect("L_iface prove");
+    (vk, proof)
+}
+
+fn build(vk: &MultiStarkVerifyingKey<LSC>, shape: &LShape, proof: &Proof<LSC>) -> Gen {
+    let mut g = Gen::new();
+    let words = gen_verifier(&mut g, vk, shape, proof).expect("pinned shape");
+    g.tape.expose(&words);
+    g
+}
+
+fn events_equal(g: &Gen, mem: &[Option<Val>], log: &[Ev]) {
+    assert_eq!(g.tt.log.len(), log.len(), "event count");
+    for (i, (t, s)) in g.tt.log.iter().zip(log).enumerate() {
+        match (t, s) {
+            (TEv::Obs(a), Ev::Obs(v)) => assert_eq!(
+                mem[*a as usize].unwrap().bb(),
+                [v.as_canonical_u32() as u64, 0, 0, 0],
+                "observe {i}"
+            ),
+            (TEv::Commit(a), Ev::Commit(v)) => {
+                assert_eq!(mem[*a as usize].unwrap().fr(), *v, "commit {i}")
+            }
+            (TEv::Sample(a), Ev::Sample(v)) => assert_eq!(
+                mem[*a as usize].unwrap().bb(),
+                [v.as_canonical_u32() as u64, 0, 0, 0],
+                "sample {i}"
+            ),
+            _ => panic!("event {i}: kind differs"),
+        }
+    }
+}
+
+#[test]
+fn j1_public_values_through_lfr() {
+    let (run, plan) = iface::case_run(&SMALL, Case::FullV, 7);
+    let words = run.words();
+    assert_eq!(words.len(), SMALL.words());
+    println!(
+        "J1 small L_iface: {} public words, {} log entries, {} values, {} spilled",
+        words.len(),
+        run.log.len(),
+        run.log.iter().map(|e| e.values.len()).sum::<usize>(),
+        plan.spilled.len()
+    );
+    let (lvk, lproof) = l_iface(&words);
+    let (log, ok) = stock_log_at(l_params(), &lvk, &lproof);
+    assert!(ok, "stock verifier accepts the small L_iface");
+    println!(
+        "J1 L_iface: {} AIRs, log heights {:?}, {} transcript events",
+        lvk.inner.per_air.len(),
+        LShape::of(&lproof).log_heights,
+        log.len()
+    );
+
+    // L_Fr tape.
+    let shape = LShape::of(&lproof);
+    let g = build(&lvk, &shape, &lproof);
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed: {failed:?}");
+    events_equal(&g, &mem, &log);
+    let m = Machine::new(&g.tape);
+    let pis = m.public_values(&mem);
+    let pub_words = pis.concat();
+    assert_eq!(pub_words.len(), 1 + SMALL.words().div_ceil(8));
+    assert_eq!(pub_words[0], lvk.pre_hash[0]);
+    let st = iface::decode(&SMALL, &pub_words).expect("decode");
+    assert_eq!(st, run.statement(), "statement words equal the native ones");
+    println!(
+        "J1 tape: {} ops, {} public words; shape {:?}",
+        g.tape.ops.len(),
+        pub_words.len(),
+        m.shape()
+    );
+
+    // Changed L public value: the stock verifier and the tape refuse.
+    let mut bad = lproof.clone();
+    let k = SMALL.words() - 1;
+    let (air, idx) = (3usize, k - SMALL.call_at());
+    bad.public_values[air][idx] += BabyBear::ONE;
+    let (_, ok_bad) = stock_log_at(l_params(), &lvk, &bad);
+    assert!(!ok_bad, "stock verifier refuses a changed L public value");
+    let gb = build(&lvk, &shape, &bad);
+    let (mem_b, failed_b) = gb.tape.execute_checked(&gb.inputs);
+    println!(
+        "J1 changed L public value: stock refuses; tape assertions failed {}",
+        failed_b.len()
+    );
+    assert!(!failed_b.is_empty());
+    assert_eq!(
+        format!("{:?}", gb.tape.ops),
+        format!("{:?}", g.tape.ops),
+        "same key"
+    );
+
+    // L_Fr proofs at the small Fr set, one key.
+    let max_rows = m.shape().iter().map(|s| s.1).max().unwrap();
+    let n_stack = (max_rows.trailing_zeros() as usize).saturating_sub(2).max(14);
+    let engine = Engine::new(small_params_n(3, n_stack));
+    let airs = m.airs();
+    let (pk, vk) = engine.keygen(&airs);
+    assert_eq!(preprocessed_airs(&vk), 1);
+    let run_o = |traces, pis| prove_verify_range_keyed(&engine, &pk, &vk, &airs, traces, pis);
+    let o = run_o(m.traces(&mem), pis.clone());
+    println!("J1 L_Fr honest (n_stack {n_stack}): {o:?}");
+    assert!(o.accepted());
+    assert_eq!(o.commits(), Some(2));
+
+    let o = run_o(m.traces(&mem_b), m.public_values(&mem_b));
+    println!("J1 L_Fr changed L public value: {o:?}");
+    assert!(!o.accepted());
+
+    let pi = m.names().iter().position(|&n| n == "Public").unwrap();
+    let n = pis[pi].len();
+    for (what, f) in [
+        ("first word", Box::new(|v: &mut Vec<Fr>| v[0] += Fr::ONE) as Box<dyn Fn(&mut Vec<Fr>)>),
+        ("middle word", Box::new(move |v: &mut Vec<Fr>| v[n / 2] += Fr::ONE)),
+        ("last word", Box::new(move |v: &mut Vec<Fr>| v[n - 1] += Fr::ONE)),
+        ("two words swapped", Box::new(move |v: &mut Vec<Fr>| v.swap(3, n - 2))),
+    ] {
+        let mut p = pis.clone();
+        f(&mut p[pi]);
+        assert_ne!(p, pis);
+        let o = run_o(m.traces(&mem), p);
+        println!("J1 L_Fr carrier control, {what}: {o:?}");
+        assert!(!o.accepted(), "{what} accepted");
+    }
+}
