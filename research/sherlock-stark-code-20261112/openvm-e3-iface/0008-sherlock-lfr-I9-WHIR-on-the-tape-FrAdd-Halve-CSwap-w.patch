+// ------------------------------------------------------------------------------------------
+// FrAddAir: program [addr_a, addr_b, addr_out, mult_out, active]; main [x, y, z], z = x + y.
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct FrAddProg {
+    pub a: Addr,
+    pub b: Addr,
+    pub out: Addr,
+    pub mult: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct FrAddAir {
+    pub prog: Arc<Vec<FrAddProg>>,
+}
+air_boiler!(FrAddAir, 3, 5);
+
+impl FrAddAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.a as u64),
+                    fu(p.b as u64),
+                    fu(p.out as u64),
+                    fu(p.mult),
+                    Fr::ONE,
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 5, vec![Fr::ZERO; 5])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let (x, y) = (get(mem, p.a).cells()[0], get(mem, p.b).cells()[0]);
+                vec![x, y, x + y]
+            })
+            .collect();
+        self.finish(rows_to_matrix(rows, self.prog.len(), 3, vec![Fr::ZERO; 3]))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for FrAddAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_FR_ADD, 3, 5);
+        builder.assert_eq(x[2].clone(), x[0].clone() + x[1].clone());
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[0].clone(), &[x[0].clone()]),
+            -p[4].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[1].clone(), &[x[1].clone()]),
+            -p[4].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[2].clone(), &[x[2].clone()]),
+            p[3].clone(),
+            1,
+        );
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// HalveAir: program [addr_x, addr_bit, addr_rest, mult_bit, mult_rest, active];
+// main [x, bit, rest]: x = 2 rest + bit, bit boolean. A chain of n steps from x < 2^n that ends
+// in rest = 0 (an `AssertEq` of the tape) gives the unique binary form of x.
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct HalveProg {
+    pub x: Addr,
+    pub bit: Addr,
+    pub rest: Addr,
+    pub mult_bit: u64,
+    pub mult_rest: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct HalveAir {
+    pub prog: Arc<Vec<HalveProg>>,
+}
+air_boiler!(HalveAir, 3, 6);
+
+impl HalveAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.x as u64),
+                    fu(p.bit as u64),
+                    fu(p.rest as u64),
+                    fu(p.mult_bit),
+                    fu(p.mult_rest),
+                    Fr::ONE,
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 6, vec![Fr::ZERO; 6])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let x = get(mem, p.x).bb()[0];
+                vec![fu(x), fu(x & 1), fu(x >> 1)]
+            })
+            .collect();
+        self.finish(rows_to_matrix(rows, self.prog.len(), 3, vec![Fr::ZERO; 3]))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for HalveAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_HALVE, 3, 6);
+        builder.assert_bool(x[1].clone());
+        builder.assert_eq(x[0].clone(), x[2].clone() * AB::Expr::TWO + x[1].clone());
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[0].clone(), &[x[0].clone()]),
+            -p[5].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[1].clone(), &[x[1].clone()]),
+            p[3].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[2].clone(), &[x[2].clone()]),
+            p[4].clone(),
+            1,
+        );
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// CSwapAir: program [addr_bit, addr_a, addr_b, addr_l, addr_r, mult_l, mult_r, active];
+// main [bit, a, b, l, r]: (l, r) = (a, b) if bit = 0, (b, a) if bit = 1 (Merkle path order).
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct CSwapProg {
+    pub bit: Addr,
+    pub a: Addr,
+    pub b: Addr,
+    pub l: Addr,
+    pub r: Addr,
+    pub mult_l: u64,
+    pub mult_r: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct CSwapAir {
+    pub prog: Arc<Vec<CSwapProg>>,
+}
+air_boiler!(CSwapAir, 5, 8);
+
+impl CSwapAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.bit as u64),
+                    fu(p.a as u64),
+                    fu(p.b as u64),
+                    fu(p.l as u64),
+                    fu(p.r as u64),
+                    fu(p.mult_l),
+                    fu(p.mult_r),
+                    Fr::ONE,
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 8, vec![Fr::ZERO; 8])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let bit = get(mem, p.bit).cells()[0];
+                let (a, b) = (get(mem, p.a).cells()[0], get(mem, p.b).cells()[0]);
+                let (l, r) = if bit == Fr::ONE { (b, a) } else { (a, b) };
+                vec![bit, a, b, l, r]
+            })
+            .collect();
+        self.finish(rows_to_matrix(rows, self.prog.len(), 5, vec![Fr::ZERO; 5]))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for CSwapAir {
+    fn eval(&self, builder: &mut AB) {
+        let (x, p) = split_row(builder, TAG_CSWAP, 5, 8);
+        let (bit, a, b) = (x[0].clone(), x[1].clone(), x[2].clone());
+        builder.assert_bool(bit.clone());
+        builder.assert_eq(
+            x[3].clone(),
+            a.clone() + bit.clone() * (b.clone() - a.clone()),
+        );
+        builder.assert_eq(
+            x[4].clone(),
+            b.clone() + bit.clone() * (a.clone() - b.clone()),
+        );
+        for (i, v) in [bit, a, b].into_iter().enumerate() {
+            builder.push_interaction(MEM_BUS, mem_msg(p[i].clone(), &[v]), -p[7].clone(), 1);
+        }
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[3].clone(), &[x[3].clone()]),
+            p[5].clone(),
+            1,
+        );
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[4].clone(), &[x[4].clone()]),
+            p[6].clone(),
+            1,
+        );
+    }
+}
