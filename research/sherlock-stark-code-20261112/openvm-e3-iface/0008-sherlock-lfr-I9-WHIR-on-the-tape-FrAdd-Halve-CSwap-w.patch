+//! I9 gate: the whole `L` verifier on the tape (parts 1 to 4; part 4: WHIR with the `mu`,
+//! folding and query PoW checks, the query indices and their bits, the Merkle paths at u = 1
+//! leaves and u = 2 nodes against the commitments, the k-fold of every query, the `gamma`
+//! batching and the final polynomial check) on the real `L` proof. All transcript events of one
+//! `L` verification equal the stock record, in order; no tape assertion fails; op counts and the
+//! machine shape are printed (MEASURED); the tape proves on the machine with 2 commitments.
+//! Refused: a changed opened row word, a changed Merkle sibling and a changed final-polynomial
+//! coefficient (by the stock verifier and the plain-Rust tape run; the prover also runs on the
+//! Merkle-sibling control). Ignored by default: needs the fixture.
+
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use sherlock_lfr::{
+    bb::Ef4,
+    fixture::{self, LSC},
+    lverify::{gen_verifier, Gen, LShape},
+    machine::Machine,
+    record::{stock_log, Ev},
+    tape::Op,
+    testing::{preprocessed_airs, prove_verify_range, small_params_n, Outcome},
+    transcript::TEv,
+};
+
+/// Test set: stacked height `2^(2 + N_STACK)`.
+const N_STACK: usize = 17;
+
+type LProof = openvm_stark_backend::proof::Proof<LSC>;
+
+fn build(
+    vk: &openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &LProof,
+) -> Gen {
+    let mut g = Gen::new();
+    gen_verifier(&mut g, vk, shape, proof).expect("pinned shape");
+    g
+}
+
+fn prove(g: &Gen, mem: &[Option<sherlock_lfr::tape::Val>]) -> Outcome {
+    let m = Machine::new(&g.tape);
+    let (o, vk) = prove_verify_range(small_params_n(3, N_STACK), m.airs(), m.traces(mem));
+    assert_eq!(
+        preprocessed_airs(&vk),
+        1,
+        "only the program table is preprocessed"
+    );
+    o
+}
+
+#[test]
+#[ignore = "needs the L fixture on disk"]
+fn i9_whole_verifier_on_real_l() {
+    let fx = fixture::load(&fixture::dir()).expect("fixture");
+    let (log, ok) = stock_log(&fx.l_vk, &fx.l_proof);
+    assert!(ok, "stock verifier accepts L");
+    let shape = LShape::of(&fx.l_proof);
+    let g = build(&fx.l_vk, &shape, &fx.l_proof);
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed: {failed:?}");
+
+    // Every event equals the stock record, in order.
+    let bb = |a: u32| mem[a as usize].unwrap().bb();
+    let (mut n_obs, mut n_commit, mut n_sample) = (0, 0, 0);
+    assert_eq!(
+        g.tt.log.len(),
+        log.len(),
+        "every event of the L verification"
+    );
+    for (i, (t, s)) in g.tt.log.iter().zip(&log).enumerate() {
+        match (t, s) {
+            (TEv::Obs(a), Ev::Obs(v)) => {
+                assert_eq!(
+                    bb(*a),
+                    [v.as_canonical_u32() as u64, 0, 0, 0],
+                    "observe {i}"
+                );
+                n_obs += 1;
+            }
+            (TEv::Commit(a), Ev::Commit(v)) => {
+                assert_eq!(mem[*a as usize].unwrap().fr(), *v, "commit {i}");
+                n_commit += 1;
+            }
+            (TEv::Sample(a), Ev::Sample(v)) => {
+                assert_eq!(bb(*a), [v.as_canonical_u32() as u64, 0, 0, 0], "sample {i}");
+                n_sample += 1;
+            }
+            _ => panic!("event {i}: kind differs: tape {t:?}, stock {s:?}"),
+        }
+    }
+    let dag_nodes: usize = fx
+        .l_vk
+        .inner
+        .per_air
+        .iter()
+        .map(|a| a.symbolic_constraints.constraints.nodes.len())
+        .sum();
+    println!("I9 L DAG nodes (all 39 AIRs): {dag_nodes}");
+
+    let count = |f: fn(&Op) -> bool| g.tape.ops.iter().filter(|o| f(o)).count();
+    let m = Machine::new(&g.tape);
+    println!(
+        "I9 whole verifier: {} events equal the stock record ({n_obs} observes, {n_commit} commitment observes, {n_sample} samples) of {} in one L verification; ops: {} total, {} Input, {} FrInput, {} Const/FrConst, {} Alu, {} Perm, {} Pack, {} Split, {} Compose, {} Decompose, {} AssertEq, {} LowBits, {} FrAdd, {} Halve, {} CSwap; table rows {}; machine shape {:?}",
+        g.tt.log.len(),
+        log.len(),
+        g.tape.ops.len(),
+        count(|o| matches!(o, Op::Input { .. })),
+        count(|o| matches!(o, Op::FrInput { .. })),
+        count(|o| matches!(o, Op::Const { .. } | Op::FrConst { .. })),
+        count(|o| matches!(o, Op::Alu { .. })),
+        count(|o| matches!(o, Op::Perm { .. })),
+        count(|o| matches!(o, Op::Pack { .. })),
+        count(|o| matches!(o, Op::Split { .. })),
+        count(|o| matches!(o, Op::Compose { .. })),
+        count(|o| matches!(o, Op::Decompose { .. })),
+        count(|o| matches!(o, Op::AssertEq { .. })),
+        count(|o| matches!(o, Op::LowBits { .. })),
+        count(|o| matches!(o, Op::FrAdd { .. })),
+        count(|o| matches!(o, Op::Halve { .. })),
+        count(|o| matches!(o, Op::CSwap { .. })),
+        m.table().rows.len(),
+        m.shape()
+    );
+    let t = std::time::Instant::now();
+    let o = prove(&g, &mem);
+    println!(
+        "I9 prove and verify {:.1}s: {o:?}",
+        t.elapsed().as_secs_f64()
+    );
+    assert!(o.accepted(), "honest part 1 refused: {o:?}");
+    assert_eq!(o.commits(), Some(2));
+
+    // Negative controls: the same key (shape and vk), changed proof values.
+    let mut p1 = fx.l_proof.clone();
+    p1.whir_proof.initial_round_opened_rows[0][7][3][2] += p3_baby_bear::BabyBear::ONE;
+    let mut p2 = fx.l_proof.clone();
+    p2.whir_proof.initial_round_merkle_proofs[0][11][4][0] += Fr::ONE;
+    let mut p3 = fx.l_proof.clone();
+    p3.whir_proof.final_poly[1] += Ef4::ONE;
+    // The prover runs on the Merkle-sibling control only (each prove at 2^19 rows takes minutes).
+    for (name, p, run_prover) in [
+        ("changed opened row word", p1, false),
+        ("changed Merkle sibling", p2, true),
+        ("changed final-polynomial coefficient", p3, false),
+    ] {
+        let (_, stock_ok) = stock_log(&fx.l_vk, &p);
+        let gt = build(&fx.l_vk, &shape, &p);
+        assert_eq!(
+            format!("{:?}", gt.tape.ops),
+            format!("{:?}", g.tape.ops),
+            "same tape (the key)"
+        );
+        let (mem_t, failed_t) = gt.tape.execute_checked(&gt.inputs);
+        let o = run_prover.then(|| prove(&gt, &mem_t));
+        println!(
+            "I9 negative {name}: stock verifier accepts {stock_ok}; tape assertions failed at {} ops (first {:?}); prover: {o:?}",
+            failed_t.len(),
+            failed_t.first()
+        );
+        assert!(!stock_ok);
+        assert!(!failed_t.is_empty());
+        if let Some(o) = o {
+            assert!(!o.accepted(), "{name} accepted");
+        }
+    }
+}
