+// ==========================================================================================
+// I9: part 4, WHIR (whir.rs).
+// ==========================================================================================
+
+impl Gen {
+    /// An Fr constant of the key (one op per distinct value).
+    pub fn frk(&mut self, v: Fr) -> Addr {
+        if let Some(&(_, a)) = self.fr_consts.iter().find(|(x, _)| *x == v) {
+            return a;
+        }
+        let a = self.tape.fr_const(v);
+        self.fr_consts.push((v, a));
+        a
+    }
+    /// `n` bits of `x` (little-endian), with the chain end asserted 0 (`x < 2^n`).
+    pub fn bits(&mut self, x: Addr, n: usize) -> Vec<Addr> {
+        let mut cur = x;
+        let mut out = vec![];
+        for _ in 0..n {
+            let (b, r) = self.tape.halve(cur);
+            out.push(b);
+            cur = r;
+        }
+        let zero = self.kbb(0);
+        self.assert_eq(cur, zero);
+        out
+    }
+    /// `prod_j (bit_j ? c_j : 1)` for key constants `c_j` (`1 + bit (c - 1)`).
+    pub fn select_prod(&mut self, bits: &[Addr], cs: &[BabyBear]) -> Addr {
+        let one = self.kbb(1);
+        let mut acc = one;
+        for (&b, &c) in bits.iter().zip(cs) {
+            let k = self.kbb(bb_u64(c - BabyBear::ONE));
+            let t = self.mul(b, k);
+            let f = self.add(t, one);
+            acc = self.mul(acc, f);
+        }
+        acc
+    }
+    /// `MidnightMerkleHasher::hash_slice` (u = 1) of BabyBear word addresses.
+    pub fn leaf_hash(&mut self, words: &[Addr]) -> Addr {
+        use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::{cap_fixed, U_LEAF};
+        let l = words.len().div_ceil(8);
+        let zero = self.frk(Fr::ZERO);
+        let cap = self.frk(cap_fixed(U_LEAF, l as u128));
+        let mut state = [zero, zero, cap];
+        let mut first = true;
+        for block in words.chunks(16) {
+            for (i, w8) in block.chunks(8).enumerate() {
+                let p = self.tape.pack(w8);
+                state[i] = if first {
+                    p
+                } else {
+                    self.tape.fr_add(state[i], p)
+                };
+            }
+            state = self.tape.perm(state);
+            first = false;
+        }
+        state[0]
+    }
+    /// `MidnightMerkleHasher::compress` (u = 2).
+    pub fn compress(&mut self, l: Addr, r: Addr) -> Addr {
+        use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::{cap_fixed, U_NODE};
+        let cap = self.frk(cap_fixed(U_NODE, 2));
+        self.tape.perm([l, r, cap])[0]
+    }
+    /// `merkle_verify` with the index bits; the root must equal `root`.
+    pub fn merkle_verify(&mut self, root: Addr, bits: &[Addr], leaf: Addr, path: &[Fr]) {
+        assert_eq!(bits.len(), path.len());
+        let mut cur = leaf;
+        for (&b, &sib) in bits.iter().zip(path) {
+            let s = self.fr_in(sib);
+            let (l, r) = self.tape.cswap(b, cur, s);
+            cur = self.compress(l, r);
+        }
+        self.assert_eq(cur, root);
+    }
+}
+
+/// Part 4 of the `L` verifier on the tape: WHIR.
+pub fn gen_part4(
+    g: &mut Gen,
+    vk: &MultiStarkVerifyingKey<LSC>,
+    proof: &Proof<LSC>,
+    p3: &Part3,
+) -> Result<(), ShapeError> {
+    use p3_field::TwoAdicField;
+    let params = &vk.inner.params;
+    let wp = &proof.whir_proof;
+    let widths: Vec<usize> = p3.stacking_openings.iter().map(|v| v.len()).collect();
+    let k = params.k_whir();
+    let rounds = params.num_whir_rounds();
+    let m = params.l_skip + params.n_stack;
+    let mut log_rs = m + params.log_blowup;
+    let one = g.kbb(1);
+    if wp.whir_sumcheck_polys.len() != rounds * k
+        || wp.folding_pow_witnesses.len() != rounds * k
+        || wp.query_phase_pow_witnesses.len() != rounds
+        || wp.codeword_commits.len() != rounds - 1
+        || wp.ood_values.len() != rounds - 1
+        || wp.final_poly.len() != 1 << params.log_final_poly_len()
+        || wp.initial_round_opened_rows.len() != widths.len()
+        || wp.initial_round_merkle_proofs.len() != widths.len()
+        || wp.codeword_opened_values.len() != rounds - 1
+        || wp.codeword_merkle_proofs.len() != rounds - 1
+    {
+        return Err(ShapeError::Lengths("WHIR proof"));
+    }
+
+    let w = g.bb_in(wp.mu_pow_witness);
+    g.check_witness(params.whir.mu_pow_bits, w);
+    let mu = g.sample_ext();
+    let total: usize = widths.iter().sum();
+    let mut mu_pows = vec![one];
+    while mu_pows.len() < total {
+        let l = *mu_pows.last().unwrap();
+        mu_pows.push(g.mul(l, mu));
+    }
+    let mut claim = g.kbb(0);
+    for (&o, &mp) in p3.stacking_openings.iter().flatten().zip(&mu_pows) {
+        let a = g.mul(mp, o);
+        claim = g.add(claim, a);
+    }
+
+    let mut sc_iter = wp.whir_sumcheck_polys.iter();
+    let mut fold_pow_iter = wp.folding_pow_witnesses.iter();
+    let (mut gammas, mut zs, mut z0s, mut alphas) = (vec![], vec![], vec![], vec![]);
+    let mut final_poly: Vec<Addr> = vec![];
+    let mut codeword_commits: Vec<Addr> = vec![];
+    for (wr, round_params) in params.whir.rounds.iter().enumerate() {
+        let is_initial = wr == 0;
+        let is_final = wr == rounds - 1;
+        let mut alphas_round = vec![];
+        for _ in 0..k {
+            let [e1, e2] = sc_iter.next().unwrap().map(|x| g.ef_in(x));
+            g.observe_ext(e1);
+            g.observe_ext(e2);
+            let pw = g.bb_in(*fold_pow_iter.next().unwrap());
+            g.check_witness(params.whir.folding_pow_bits, pw);
+            let alpha = g.sample_ext();
+            alphas_round.push(alpha);
+            let e0 = g.sub(claim, e1);
+            claim = g.quad012([e0, e1, e2], alpha);
+        }
+        let y0 = if is_final {
+            final_poly = wp.final_poly.iter().map(|&c| g.ef_in(c)).collect();
+            for &c in &final_poly {
+                g.observe_ext(c);
+            }
+            None
+        } else {
+            let c = g.fr_in(wp.codeword_commits[wr][0]);
+            codeword_commits.push(c);
+            g.observe_commit(c);
+            z0s.push(g.sample_ext());
+            let y0 = g.ef_in(wp.ood_values[wr]);
+            g.observe_ext(y0);
+            Some(y0)
+        };
+        let qw = g.bb_in(wp.query_phase_pow_witnesses[wr]);
+        g.check_witness(params.whir.query_phase_pow_bits, qw);
+
+        let nq = round_params.num_queries;
+        let nbits = log_rs - k;
+        let omega = BabyBear::two_adic_generator(log_rs);
+        let wpows: Vec<BabyBear> = (0..nbits).map(|j| omega.exp_power_of_2(j)).collect();
+        let winv: Vec<BabyBear> = wpows.iter().map(|x| x.inverse()).collect();
+        let omega_k = BabyBear::two_adic_generator(k);
+        let half = BabyBear::TWO.inverse();
+        let (mut zs_round, mut ys_round) = (vec![], vec![]);
+        for q in 0..nq {
+            let idx = g.sample_bits(nbits as u32);
+            let bits = g.bits(idx, nbits);
+            let zi_root = g.select_prod(&bits, &wpows);
+            let zi_root_inv = g.select_prod(&bits, &winv);
+            let mut zi = zi_root;
+            for _ in 0..k {
+                zi = g.mul(zi, zi);
+            }
+            let values: Vec<Addr> = if is_initial {
+                let zero = g.kbb(0);
+                let mut cv = vec![zero; 1 << k];
+                let mut mp_iter = mu_pows.iter();
+                for (ci, &wd) in widths.iter().enumerate() {
+                    let rows = &wp.initial_round_opened_rows[ci][q];
+                    let path = &wp.initial_round_merkle_proofs[ci][q];
+                    if rows.len() != 1 << k || path.len() != nbits {
+                        return Err(ShapeError::Lengths("WHIR initial query"));
+                    }
+                    let row_addrs: Vec<Vec<Addr>> = rows
+                        .iter()
+                        .map(|r| {
+                            assert_eq!(r.len(), wd);
+                            r.iter().map(|&x| g.bb_in(x)).collect()
+                        })
+                        .collect();
+                    let leaves: Vec<Addr> = row_addrs.iter().map(|r| g.leaf_hash(r)).collect();
+                    let digest = tree_compress(g, leaves);
+                    let path: Vec<Fr> = path.iter().map(|d| d[0]).collect();
+                    g.merkle_verify(p3.commits[ci], &bits, digest, &path);
+                    for c in 0..wd {
+                        let mp = *mp_iter.next().unwrap();
+                        for j in 0..1 << k {
+                            let a = g.mul(mp, row_addrs[j][c]);
+                            cv[j] = g.add(cv[j], a);
+                        }
+                    }
+                }
+                cv
+            } else {
+                let ov = &wp.codeword_opened_values[wr - 1][q];
+                let path = &wp.codeword_merkle_proofs[wr - 1][q];
+                if ov.len() != 1 << k || path.len() != nbits {
+                    return Err(ShapeError::Lengths("WHIR query"));
+                }
+                let vals: Vec<Addr> = ov.iter().map(|&x| g.ef_in(x)).collect();
+                let leaves: Vec<Addr> = vals
+                    .iter()
+                    .map(|&v| {
+                        let words = g.tape.decompose(v);
+                        g.leaf_hash(&words)
+                    })
+                    .collect();
+                let digest = tree_compress(g, leaves);
+                let path: Vec<Fr> = path.iter().map(|d| d[0]).collect();
+                g.merkle_verify(codeword_commits[wr - 1], &bits, digest, &path);
+                vals
+            };
+            // binary_k_fold(values, alphas_round, zi_root)
+            let mut vals = values;
+            let x_pows = g.pow2s(zi_root, k);
+            let x_inv_pows = g.pow2s(zi_root_inv, k);
+            for (j, &alpha) in alphas_round.iter().enumerate() {
+                let mm = (1 << k) >> (j + 1);
+                for i in 0..mm {
+                    let tw = g.kbb(bb_u64(omega_k.exp_u64((i << j) as u64)));
+                    let t = g.mul(tw, x_pows[j]);
+                    let itw = g.kbb(bb_u64(omega_k.inverse().exp_u64((i << j) as u64) * half));
+                    let t_inv_h = g.mul(itw, x_inv_pows[j]);
+                    let a = g.sub(alpha, t);
+                    let d = g.sub(vals[i], vals[i + mm]);
+                    let a = g.mul(a, d);
+                    let a = g.mul(a, t_inv_h);
+                    vals[i] = g.add(vals[i], a);
+                }
+            }
+            zs_round.push(zi);
+            ys_round.push(vals[0]);
+        }
+        let gamma = g.sample_ext();
+        if let Some(y0) = y0 {
+            let a = g.mul(y0, gamma);
+            claim = g.add(claim, a);
+        }
+        let mut gp = g.mul(gamma, gamma);
+        for &yi in &ys_round {
+            let a = g.mul(yi, gp);
+            claim = g.add(claim, a);
+            gp = g.mul(gp, gamma);
+        }
+        gammas.push(gamma);
+        zs.push(zs_round);
+        alphas.extend(alphas_round);
+        log_rs -= 1;
+    }
+
+    // Final check.
+    let t = k * rounds;
+    // verifier/mod.rs: WHIR takes `u_cube` = (u_0^(2^i) for i < l_skip) then u_1, .., u_n_stack.
+    let mut u = g.pow2s(p3.u[0], params.l_skip);
+    u.extend_from_slice(&p3.u[1..]);
+    assert_eq!(u.len(), m);
+    let mut prefix = one;
+    for i in 0..t {
+        // (1 - 2 u_i)(1 - a_i) + u_i a_i
+        let two = g.kbb(2);
+        let u2 = g.mul(u[i], two);
+        let w0 = g.sub(one, u2);
+        let oma = g.sub(one, alphas[i]);
+        let a = g.mul(w0, oma);
+        let b = g.mul(u[i], alphas[i]);
+        let f = g.add(a, b);
+        prefix = g.mul(prefix, f);
+    }
+    // eval_mle_evals_at_point(final_poly, u[t..])
+    let mut ev = final_poly.clone();
+    let mut len = ev.len();
+    for &xj in u[t..].iter().rev() {
+        len >>= 1;
+        let omx = g.sub(one, xj);
+        for i in 0..len {
+            let a = g.mul(ev[i], omx);
+            let b = g.mul(ev[i + len], xj);
+            ev[i] = g.add(a, b);
+        }
+    }
+    let mut acc = g.mul(prefix, ev[0]);
+    let mut j = k;
+    for i in 0..rounds {
+        let alpha_slc = alphas[j..t].to_vec();
+        let slc_len = (t - j) + 1;
+        if i != rounds - 1 {
+            let zp = g.pow2s(z0s[i], slc_len);
+            let (max, left) = zp.split_last().unwrap();
+            let e = g.eq_mle(&alpha_slc, left);
+            let h = g.horner(&final_poly, *max);
+            let a = g.mul(gammas[i], e);
+            let a = g.mul(a, h);
+            acc = g.add(acc, a);
+        }
+        let mut gp = g.mul(gammas[i], gammas[i]);
+        for &zi in &zs[i] {
+            let zp = g.pow2s(zi, slc_len);
+            let (max, left) = zp.split_last().unwrap();
+            let e = g.eq_mle(&alpha_slc, left);
+            let h = g.horner(&final_poly, *max);
+            let a = g.mul(gp, e);
+            let a = g.mul(a, h);
+            acc = g.add(acc, a);
+            gp = g.mul(gp, gammas[i]);
+        }
+        j += k;
+    }
+    g.assert_eq(acc, claim);
+    Ok(())
+}
+
+/// `MerkleHasher::tree_compress` of digest addresses.
+fn tree_compress(g: &mut Gen, mut hashes: Vec<Addr>) -> Addr {
+    assert!(hashes.len().is_power_of_two());
+    while hashes.len() > 1 {
+        hashes = hashes
+            .chunks_exact(2)
+            .map(|p| g.compress(p[0], p[1]))
+            .collect();
+    }
+    hashes[0]
+}
+
+/// The whole `L` verifier on the tape (parts 1 to 4).
+pub fn gen_verifier(
+    g: &mut Gen,
+    vk: &MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &Proof<LSC>,
+) -> Result<(), ShapeError> {
+    let p1 = gen_part1(g, vk, shape, proof)?;
+    let p2 = gen_part2(g, vk, shape, proof, &p1)?;
+    let p3 = gen_part3(g, vk, shape, proof, &p1, &p2)?;
+    gen_part4(g, vk, proof, &p3)
+}
