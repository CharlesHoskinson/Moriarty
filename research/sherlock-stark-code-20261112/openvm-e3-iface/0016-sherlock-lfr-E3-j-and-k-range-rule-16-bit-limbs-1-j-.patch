+
+/// The `j`, `k` rule on the words (E3 open item): limbs below 2^16, `1 <= j <= k` for a chunk.
+/// Positives at the 16-bit edges (the borrow of `j <= k`); negatives from chunk 2 of 3 with the
+/// anchor words changed so that the anchor tags stay those of chunk 2 of 3 (only the new rule can
+/// refuse them); the decoder refuses the same words (`iface` unit test `anchor_jk_range`).
+#[test]
+fn j9_jk_range_on_words() {
+    use p3_baby_bear::BabyBear;
+    use p3_field::PrimeCharacteristicRing;
+    use sherlock_lfr::iface::{J_WORDS, K_WORDS};
+    let dims = Dims::FULL;
+    let mut n_ops = None;
+    let edit = |j: [u64; 2], k: [u64; 2]| Some((j, k));
+    let cases: [(&str, iface::Case, Option<([u64; 2], [u64; 2])>, bool); 10] = [
+        ("chunk_1_of_1", iface::Case::Chunk { j: 1, k: 1 }, None, true),
+        ("chunk_ffff_of_10000", iface::Case::Chunk { j: 0xffff, k: 0x10000 }, None, true),
+        ("chunk_10000_of_10001", iface::Case::Chunk { j: 0x10000, k: 0x10001 }, None, true),
+        ("chunk_2_of_20000", iface::Case::Chunk { j: 2, k: 0x20000 }, None, true),
+        ("chunk_full_of_full", iface::Case::Chunk { j: u32::MAX, k: u32::MAX }, None, true),
+        ("j_zero", iface::Case::Chunk { j: 2, k: 3 }, edit([0, 0], [3, 0]), false),
+        ("j_over_k", iface::Case::Chunk { j: 2, k: 3 }, edit([4, 0], [3, 0]), false),
+        ("j_over_k_hi", iface::Case::Chunk { j: 2, k: 3 }, edit([0, 2], [0xffff, 1]), false),
+        ("j_limb_2_16", iface::Case::Chunk { j: 2, k: 3 }, edit([1 << 16, 0], [0, 1]), false),
+        ("k_limb_2_16", iface::Case::Chunk { j: 2, k: 3 }, edit([2, 0], [3, 1 << 16]), false),
+    ];
+    for (name, case, ed, ok) in cases {
+        let (run, _) = iface::case_run(&dims, case, 21);
+        let mut words = run.words();
+        if let Some((j, k)) = ed {
+            words[J_WORDS..J_WORDS + 2].copy_from_slice(&j);
+            words[K_WORDS..K_WORDS + 2].copy_from_slice(&k);
+            assert!(iface::anchor_tags(&words[..iface::STMT]).is_none(), "{name}: decoder");
+        }
+        let mut g = Gen::new();
+        let l_pub: Vec<_> = words.iter().map(|&w| g.bb_in(BabyBear::from_u64(w))).collect();
+        let before = g.tape.ops.len();
+        gen_r_check(&mut g, &l_pub, &words);
+        let added = g.tape.ops.len() - before;
+        let (_, failed) = g.tape.execute_checked(&g.inputs);
+        println!("J9 {name}: {added} ops; failed assertions {}", failed.len());
+        assert_eq!(*n_ops.get_or_insert(added), added, "same tape in every case");
+        assert_eq!(failed.is_empty(), ok, "{name}");
+    }
+}
