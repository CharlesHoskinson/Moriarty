From: Charles Hoskinson <charles.hoskinson@gmail.com>
Date: Fri, 13 Nov 2026 02:36:12 -0700
Subject: [PATCH 16/19] sherlock-lfr: E3 j and k range rule (16-bit limbs, 1 <=
 j <= k for a chunk) in the R check and the decoder; native TAG_NODE log merge
 with the enc2.node(2,4) vector

---
 crates/sherlock-lfr/src/iface.rs     | 122 ++++++++++++++++++++++++++-
 crates/sherlock-lfr/src/lverify.rs   |  33 ++++++++
 crates/sherlock-lfr/tests/j5_gate.rs |  44 ++++++++++
 3 files changed, 197 insertions(+), 2 deletions(-)

diff --git a/crates/sherlock-lfr/src/iface.rs b/crates/sherlock-lfr/src/iface.rs
index ccf4a16..ed0f141 100644
--- a/crates/sherlock-lfr/src/iface.rs
+++ b/crates/sherlock-lfr/src/iface.rs
@@ -283,6 +283,29 @@ pub fn onion(log: &[Entry]) -> [u64; 8] {
     d
 }
 
+/// A log `(d, n)` (FP-2: `log_d`, `log_n`).
+pub type Log = ([u64; 8], u64);
+
+/// The log of one segment: `(onion(seg), |seg|)`.
+pub fn seg_log(seg: &[Entry]) -> Log {
+    (onion(seg), seg.len() as u64)
+}
+
+/// ARCHITECTURE 1.11 log update rule: `merge(a, b)` is `b` if `n_a = 0`, `a` if `n_b = 0`, else
+/// `(P2(TAG_NODE, d_a, d_b), n_a + n_b)`; `None` when the output `n` is not below 2^16 (the node's
+/// range check).
+pub fn log_merge(a: Log, b: Log) -> Option<Log> {
+    let r = if a.1 == 0 {
+        b
+    } else if b.1 == 0 {
+        a
+    } else {
+        let x: Vec<u64> = a.0.iter().chain(b.0.iter()).copied().collect();
+        (p2(TAG_NODE, &x), a.1 + b.1)
+    };
+    (r.1 < 1 << 16).then_some(r)
+}
+
 /// One operation of a run, with its native inputs.
 #[derive(Clone, Debug)]
 pub enum OpIn {
@@ -505,14 +528,18 @@ pub fn unpack(lfr_words: &[Fr], n_words: usize) -> Result<Vec<u64>, String> {
 }
 
 /// The anchor tags of plan D-10 from the anchor statement words: `(tag_in, tag_out)`, `None`
-/// unless `mode` is 0 or 1. ORD, or chunk 1 (`a_in`) and chunk `k` (`a_out`): `SHK_PROGC`;
-/// otherwise `SHK_LOCK`.
+/// unless `mode` is 0 or 1, every limb of `j` and `k` is below 2^16, and for a chunk `1 <= j <=
+/// k`. ORD, or chunk 1 (`a_in`) and chunk `k` (`a_out`): `SHK_PROGC`; otherwise `SHK_LOCK`.
 pub fn anchor_tags(head: &[u64]) -> Option<(u64, u64)> {
     let mode = head[MODE_WORD];
+    if (0..4).any(|i| head[J_WORDS + i] >= 1 << 16) {
+        return None;
+    }
     let u32w = |at: usize| head[at] + (head[at + 1] << 16);
     let (j, k) = (u32w(J_WORDS), u32w(K_WORDS));
     match mode {
         0 => Some((SHK_PROGC, SHK_PROGC)),
+        1 if j < 1 || j > k => None,
         1 => Some((
             if j == 1 { SHK_PROGC } else { SHK_LOCK },
             if j == k { SHK_PROGC } else { SHK_LOCK },
@@ -914,6 +941,97 @@ mod tests {
         }
     }
 
+    fn enc2_log() -> Vec<Entry> {
+        let pack = |ws: &[u64]| {
+            let mut x = BigUint::from(0u32);
+            for (i, &w) in ws.iter().enumerate() {
+                x += BigUint::from(w) << (31 * i);
+            }
+            fr_from_big(&x)
+        };
+        let r_p: Vec<u64> = (101..=108).collect();
+        let prog_d: Vec<u64> = (201..=208).collect();
+        let d2_progc = p2(6, &[r_p, prog_d].concat());
+        let input_d: [u64; 8] = [
+            1844765863, 1946263212, 480254560, 1610161683, 900750315, 731375867, 384171174,
+            1479089448,
+        ];
+        let (a, b, c) = (Fr::from_u64(3), Fr::from_u64(5), Fr::from_u64(7));
+        vec![
+            OpIn::Digest { tag: SHK_PROGC, d2: pack(&d2_progc) }.entry(),
+            OpIn::H2(a, b).entry(),
+            OpIn::Sponge(vec![a, b, c]).entry(),
+            OpIn::Perm([a, b, c]).entry(),
+            OpIn::Pub { lane: 1, v: Fr::from_u64(0x1234) }.entry(),
+            OpIn::Digest { tag: SHK_INPUT, d2: pack(&input_d) }.entry(),
+        ]
+    }
+
+    /// Multi-segment logs (`TAG_NODE` merges, ARCHITECTURE 1.11 log update rule): the ENC-2
+    /// vector `enc2.node(2,4)`, the empty-log identities, node versus a single segment, the
+    /// order and shape of the tree, and the 2^16 range check.
+    #[test]
+    fn enc2_node_merge() {
+        let log = enc2_log();
+        let node = log_merge(seg_log(&log[..2]), seg_log(&log[2..])).unwrap();
+        assert_eq!(
+            node,
+            (
+                [1861935416, 1473206511, 373632707, 288003179, 369101355, 824888920, 854619332, 110820133],
+                6
+            )
+        );
+        let empty = seg_log(&[]);
+        assert_eq!(empty, (p2(TAG_EMPTY, &[]), 0));
+        for x in [seg_log(&log), node, empty] {
+            assert_eq!(log_merge(empty, x), Some(x));
+            assert_eq!(log_merge(x, empty), Some(x));
+        }
+        // a split log is not the single-segment onion; segment order and tree shape count
+        assert_ne!(node.0, onion(&log));
+        let ba = log_merge(seg_log(&log[2..]), seg_log(&log[..2])).unwrap();
+        assert_ne!(ba.0, node.0);
+        let (s0, s1, s2) = (seg_log(&log[..1]), seg_log(&log[1..3]), seg_log(&log[3..]));
+        let left = log_merge(log_merge(s0, s1).unwrap(), s2).unwrap();
+        let right = log_merge(s0, log_merge(s1, s2).unwrap()).unwrap();
+        assert_eq!((left.1, right.1), (6, 6));
+        assert_ne!(left.0, right.0);
+        // a node output n must stay below 2^16
+        let big = (node.0, (1u64 << 16) - 6);
+        assert_eq!(log_merge(big, node), None);
+        assert_eq!(log_merge((node.0, (1 << 16) - 7), node).map(|l| l.1), Some((1 << 16) - 1));
+    }
+
+    /// The `j`, `k` rule of the decoder: limbs below 2^16, and `1 <= j <= k` for a chunk.
+    #[test]
+    fn anchor_jk_range() {
+        let head = |mode: u64, j: [u64; 2], k: [u64; 2]| {
+            let mut h = vec![0u64; STMT];
+            h[MODE_WORD] = mode;
+            h[J_WORDS..J_WORDS + 2].copy_from_slice(&j);
+            h[K_WORDS..K_WORDS + 2].copy_from_slice(&k);
+            h
+        };
+        let (pc, lk) = (SHK_PROGC, SHK_LOCK);
+        for (mode, j, k, want) in [
+            (0, [0, 0], [0, 0], Some((pc, pc))),
+            (1, [1, 0], [1, 0], Some((pc, pc))),
+            (1, [1, 0], [3, 0], Some((pc, lk))),
+            (1, [3, 0], [3, 0], Some((lk, pc))),
+            (1, [0xffff, 0], [0, 1], Some((lk, lk))),
+            (1, [0, 1], [0, 1], Some((lk, pc))),
+            (1, [0, 0], [3, 0], None),
+            (1, [4, 0], [3, 0], None),
+            (1, [0, 2], [0xffff, 1], None),
+            (1, [1 << 16, 0], [0, 1], None),
+            (1, [2, 0], [3, 1 << 16], None),
+            (0, [1 << 16, 0], [0, 0], None),
+            (2, [1, 0], [1, 0], None),
+        ] {
+            assert_eq!(anchor_tags(&head(mode, j, k)), want, "{mode} {j:?} {k:?}");
+        }
+    }
+
     #[test]
     fn layout_full_is_12164() {
         assert_eq!(Dims::FULL.words(), 12_164);
diff --git a/crates/sherlock-lfr/src/lverify.rs b/crates/sherlock-lfr/src/lverify.rs
index 83c91be..041eeac 100644
--- a/crates/sherlock-lfr/src/lverify.rs
+++ b/crates/sherlock-lfr/src/lverify.rs
@@ -1657,6 +1657,39 @@ pub fn gen_r_check(g: &mut Gen, l_pub: &[Addr], l_vals: &[u64]) {
     let a = g.sub(j_hi, k_hi);
     let zkb = is_zero(g, a, (wv(J_WORDS + 1) + p - wv(K_WORDS + 1)) % p);
     let z_jk = g.mul(zka, zkb);
+    // j, k (E3 open item, no owner choice): each limb below 2^16 (I-1) in both modes; for a
+    // chunk (`mode` 1) also `1 <= j <= k`. `j >= 1`: `j_lo + j_hi` (below 2^17 < p, so 0 only
+    // for j = 0) is not zero. `j <= k`: advice borrow bit `c`, `k_lo - j_lo + 2^16 c` and
+    // `k_hi - j_hi - c` both below 2^16 (each in (-2^17, 2^17) as an integer, so the 16-bit
+    // test is the integer test); both are multiplied by `mode`, so an ordinary call has no order
+    // rule.
+    let r16 = |g: &mut Gen, x: Addr| {
+        let lo = g.tape.low_bits(x, 16);
+        g.assert_eq(lo, x);
+    };
+    for x in [j_lo, j_hi, k_lo, k_hi] {
+        r16(g, x);
+    }
+    let s = g.add(j_lo, j_hi);
+    let z_j0 = is_zero(g, s, (wv(J_WORDS) + wv(J_WORDS + 1)) % p);
+    let x = g.mul(mode, z_j0);
+    g.assert_eq(x, zero);
+    let c = g.bb_in(BabyBear::from_u64(
+        (wv(MODE_WORD) == 1 && wv(K_WORDS) < wv(J_WORDS)) as u64,
+    ));
+    let c1 = g.sub(c, one);
+    let cc = g.mul(c, c1);
+    g.assert_eq(cc, zero);
+    let k16 = g.kbb(1 << 16);
+    let x = g.sub(k_lo, j_lo);
+    let y = g.mul(k16, c);
+    let x = g.add(x, y);
+    let x = g.mul(mode, x);
+    r16(g, x);
+    let x = g.sub(k_hi, j_hi);
+    let x = g.sub(x, c);
+    let x = g.mul(mode, x);
+    r16(g, x);
     let nz = g.sub(one, z_j1);
     let tag_in = g.mul(mode, nz);
     let nz = g.sub(one, z_jk);
