+    let mut airs: Vec<AirRef<LSC>> = if onion {
+        iface_l::airs_onion(&SMALL, perm)
+    } else {
+        iface_l::airs(&SMALL)
+    };
+    if onion {
+        airs.push(Arc::new(KeyTable));
+    }
     let (pk, vk) = engine.keygen(&airs);
     let d_pk = engine.device().transport_pk_to_device(&pk);
-    let (traces, ins) = iface_l::traces_onion::<BabyBear>(&SMALL, words, perm);
+    let (traces, ins) = if onion {
+        iface_l::traces_onion::<BabyBear>(&SMALL, words, perm)
+    } else {
+        (iface_l::traces::<BabyBear>(&SMALL, words), vec![])
+    };
     let mut ctxs: Vec<_> = traces
         .into_iter()
         .map(|(t, pv)| {
@@ -99,17 +119,64 @@ fn prove(words: &[u64]) -> Result<(), String> {
             AirProvingContext::simple(engine.device().transport_matrix_to_device(&cm), pv)
         })
         .collect();
-    let kt = key_trace(&ins, 512);
-    ctxs.push(AirProvingContext::simple_no_pis(
-        engine
-            .device()
-            .transport_matrix_to_device(&ColMajorMatrix::from_row_major(&kt)),
-    ));
+    if onion {
