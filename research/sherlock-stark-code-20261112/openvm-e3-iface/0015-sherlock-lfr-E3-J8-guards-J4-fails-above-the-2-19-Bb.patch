     );
     let stacked = 1usize << 20;
     assert!(m.shape().iter().all(|s| s.1 <= stacked));
+    // The headroom rule: the added work must fit the E2 key shape (no doubled table).
+    for name in ["BbAlu", "ProgramTable"] {
+        let h = m.shape().iter().find(|s| s.0 == name).unwrap().1;
+        assert_eq!(h, 1 << 19, "{name} height {h}: over the 2^19 of E2");
