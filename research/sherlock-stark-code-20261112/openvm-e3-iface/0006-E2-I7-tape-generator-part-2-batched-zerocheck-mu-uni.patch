diff --git a/crates/sherlock-lfr/tests/i7_part2.rs b/crates/sherlock-lfr/tests/i7_part2.rs
new file mode 100644
index 0000000..b935cbb
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i7_part2.rs
@@ -0,0 +1,138 @@
+//! I7 gate: the tape generator, parts 1 and 2 (part 2: `mu`, the univariate and multilinear
+//! sumcheck rounds of the batched zerocheck, `eq_3b`, `eq_ns`, `eq_sharp_ns`, the column
+//! openings, the DAG of every `L` AIR, the interaction evaluations and the final claim check) on
+//! the real `L` proof. Every value the tape observes or samples equals the stock verifier's
+//! transcript record, in order, up to the end of `verify_zerocheck_and_logup`. No tape
+//! assertion fails. Op counts and the machine shape are printed (MEASURED); the tape proves on
+//! the machine with 2 commitments. Refused: a changed column opening and a changed univariate
+//! round coefficient (by the stock verifier, the plain-Rust tape run, and the prover). Ignored by
+//! default: needs the fixture.
+
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use sherlock_lfr::{
+    bb::Ef4,
+    fixture::{self, LSC},
+    lverify::{gen_part1, gen_part2, Gen, LShape},
+    machine::Machine,
+    record::{stock_log, Ev},
+    tape::Op,
+    testing::{preprocessed_airs, prove_verify_range, small_params, Outcome},
+    transcript::TEv,
+};
+
+type LProof = openvm_stark_backend::proof::Proof<LSC>;
+
+fn build(
+    vk: &openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &LProof,
+) -> Gen {
+    let mut g = Gen::new();
+    let p1 = gen_part1(&mut g, vk, shape, proof).expect("pinned shape");
+    gen_part2(&mut g, vk, shape, proof, &p1).expect("pinned shape");
+    g
+}
+
+fn prove(g: &Gen, mem: &[Option<sherlock_lfr::tape::Val>]) -> Outcome {
+    let m = Machine::new(&g.tape);
+    let (o, vk) = prove_verify_range(small_params(3), m.airs(), m.traces(mem));
+    assert_eq!(preprocessed_airs(&vk), 1, "only the program table is preprocessed");
+    o
