+// ---- J8: the onion AIR -------------------------------------------------------------------
+
+use openvm_recursion_circuit::bus::{Poseidon2PermuteBus, Poseidon2PermuteMessage};
+
+const O_W: usize = 0; // 8 block words (state_in[0..8])
+const O_CAP: usize = 8; // state_in[8..16]
+const O_OUT: usize = 16; // 16 output words
+const O_D: usize = 32; // 8: the onion digest before this entry
+const O_H: usize = 40; // 8: P2(tagEnt, enc(e)) of this entry (B rows)
+const O_U: usize = 48; // 8: word used (A rows)
+const O_E: usize = 56;
+const O_A: usize = 57;
+const O_FA: usize = 58;
+const O_B0: usize = 59;
+const O_B1: usize = 60;
+const O_B2: usize = 61;
+const O_LAST: usize = 62;
+const O_FIN: usize = 63;
+const O_POS: usize = 64;
+const O_CNT: usize = 65;
+const O_OP: usize = 66;
+const O_PARAM: usize = 67;
+const O_OFF: usize = 68;
+const O_K: usize = 69;
+const O_WIDTH: usize = 70;
+
+/// The onion AIR (module header): rows `E` (`D_EMPTY`), then per used entry the `A` blocks of
+/// `P2(tagEnt, enc(e))` and the 3 `B` blocks of `P2(tagStep, d, h)`, then inactive rows.
+#[derive(Clone, Copy, Debug)]
+pub struct OnionAir {
+    pub dims: Dims,
+    pub perm: Poseidon2PermuteBus,
+}
+
+impl OnionAir {
+    /// Fixed height: at most `1 + sum_i (ceil((3 + 9 k_i) / 8) + 3)` rows, bounded by
+    /// `1 + ceil((3 B + 9 V) / 8) + 4 B`.
+    pub fn height(&self) -> usize {
+        let d = &self.dims;
+        (1 + (3 * d.b + 9 * d.v).div_ceil(8) + 4 * d.b).next_power_of_two()
+    }
+
+    /// The trace for the `L` words of a run and the permutation inputs it looks up.
+    pub fn trace<F: Field>(&self, words: &[u64]) -> (RowMajorMatrix<F>, Vec<[u64; 16]>) {
+        let d = &self.dims;
+        let mut rows: Vec<[u64; O_WIDTH]> = vec![];
+        let mut ins = vec![];
+        let perm_row = |st_in: [u64; 16], rows: &mut Vec<[u64; O_WIDTH]>, ins: &mut Vec<[u64; 16]>| {
+            use openvm_stark_backend::{p3_field::PrimeField64, p3_symmetric::Permutation};
+            use openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;
+            use p3_baby_bear::BabyBear;
+            let mut st = st_in.map(BabyBear::from_u64);
+            poseidon2_perm().permute_mut(&mut st);
+            let out = st.map(|x| x.as_canonical_u64());
+            let mut r = [0u64; O_WIDTH];
+            r[O_W..O_W + 16].copy_from_slice(&st_in);
+            r[O_OUT..O_OUT + 16].copy_from_slice(&out);
+            rows.push(r);
+            ins.push(st_in);
+            out
+        };
+        // E row
+        let mut st = [0u64; 16];
+        st[0] = iface::TAG_EMPTY;
+        st[8] = 1;
+        let out = perm_row(st, &mut rows, &mut ins);
+        rows[0][O_E] = 1;
+        let mut dg: [u64; 8] = out[..8].try_into().unwrap();
+        let (mut off, mut cnt) = (0u64, 0u64);
+        for i in 0..d.b {
+            let (op, param) = (words[iface::STMT + 2 * i], words[iface::STMT + 2 * i + 1]);
+            if op == iface::NOP {
+                break;
+            }
+            let kv = iface::vals(op, param) as u64;
+            let mut enc = vec![iface::TAG_ENT, op, param];
+            let at = d.values_at() + LIMBS * off as usize;
+            enc.extend_from_slice(&words[at..at + LIMBS * kv as usize]);
+            let total = enc.len() as u64;
+            let mut cap = [0u64; 8];
+            cap[0] = total;
+            let mut h = [0u64; 8];
+            let nb = enc.len().div_ceil(8);
+            for (bi, blk) in enc.chunks(8).enumerate() {
+                let mut st = [0u64; 16];
+                st[..blk.len()].copy_from_slice(blk);
+                st[8..].copy_from_slice(&cap);
+                let out = perm_row(st, &mut rows, &mut ins);
+                let r = rows.last_mut().unwrap();
+                r[O_A] = 1;
+                r[O_FA] = (bi == 0) as u64;
+                r[O_LAST] = (bi + 1 == nb) as u64;
+                for j in 0..blk.len() {
+                    r[O_U + j] = 1;
+                }
+                r[O_POS] = 8 * bi as u64;
+                cap.copy_from_slice(&out[8..]);
+                h.copy_from_slice(&out[..8]);
+            }
+            let mut x: Vec<u64> = vec![iface::TAG_STEP];
+            x.extend_from_slice(&dg);
+            x.extend_from_slice(&h);
+            let mut cap = [0u64; 8];
+            cap[0] = 17;
+            for (bi, blk) in x.chunks(8).enumerate() {
+                let mut st = [0u64; 16];
+                st[..blk.len()].copy_from_slice(blk);
+                st[8..].copy_from_slice(&cap);
+                let out = perm_row(st, &mut rows, &mut ins);
+                let r = rows.last_mut().unwrap();
+                r[O_B0 + bi] = 1;
+                cap.copy_from_slice(&out[8..]);
+                if bi == 2 {
+                    dg.copy_from_slice(&out[..8]);
+                }
+            }
+            // entry fields, d and h on every row of this entry
+            let first = rows.len() - nb - 3;
+            for (ri, r) in rows[first..].iter_mut().enumerate() {
+                r[O_OP] = op;
+                r[O_PARAM] = param;
+                r[O_OFF] = off;
+                r[O_K] = kv;
+                r[O_CNT] = cnt;
+                if ri >= nb {
+                    r[O_H..O_H + 8].copy_from_slice(&h);
+                }
+            }
+            off += kv;
+            cnt += 1;
+        }
+        // d before each entry: the output of the previous E or B2 row
+        let mut cur = [0u64; 8];
+        let mut prev_out = [0u64; 8];
+        for r in rows.iter_mut() {
+            if r[O_E] == 1 {
+                prev_out.copy_from_slice(&r[O_OUT..O_OUT + 8]);
+                continue;
+            }
+            if r[O_FA] == 1 {
+                cur = prev_out;
+            }
+            r[O_D..O_D + 8].copy_from_slice(&cur);
+            if r[O_B2] == 1 {
+                prev_out.copy_from_slice(&r[O_OUT..O_OUT + 8]);
+            }
+        }
+        let n_act = rows.len();
+        assert!(n_act <= self.height(), "onion rows {n_act} over {}", self.height());
+        rows[n_act - 1][O_FIN] = 1;
+        let cnt_end = cnt;
+        while rows.len() < self.height() {
+            let mut r = [0u64; O_WIDTH];
+            r[O_CNT] = cnt_end;
+            rows.push(r);
+        }
+        let vals: Vec<F> = rows.iter().flat_map(|r| r.iter().map(|&x| F::from_u64(x))).collect();
+        (RowMajorMatrix::new(vals, O_WIDTH), ins)
+    }
+}
+
+impl<F: Field> BaseAir<F> for OnionAir {
+    fn width(&self) -> usize {
+        O_WIDTH
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for OnionAir {}
+impl<F: Field> PartitionedBaseAir<F> for OnionAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for OnionAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (l, n) = (main.row_slice(0).expect("row"), main.row_slice(1).expect("next"));
+        let x: Vec<AB::Expr> = (0..O_WIDTH).map(|i| l[i].into()).collect();
+        let y: Vec<AB::Expr> = (0..O_WIDTH).map(|i| n[i].into()).collect();
+        drop((l, n));
+        let one = AB::Expr::ONE;
+        let k = |u: u64| AB::Expr::from_u64(u);
+        for c in [O_E, O_A, O_FA, O_B0, O_B1, O_B2, O_LAST, O_FIN] {
+            builder.assert_bool(x[c].clone());
+        }
+        for j in 0..8 {
+            builder.assert_bool(x[O_U + j].clone());
+        }
+        let act = |r: &[AB::Expr]| {
+            r[O_E].clone() + r[O_A].clone() + r[O_B0].clone() + r[O_B1].clone() + r[O_B2].clone()
+        };
+        let (ax, ay) = (act(&x), act(&y));
+        builder.assert_bool(ax.clone());
+        builder.assert_zero(x[O_FA].clone() * (one.clone() - x[O_A].clone()));
+        // row order
+        builder.when_first_row().assert_one(x[O_E].clone());
+        builder.when_first_row().assert_zero(x[O_CNT].clone());
+        builder.when_transition().assert_zero(y[O_E].clone());
+        let mut tr = builder.when_transition();
+        tr.assert_zero(
+            (x[O_E].clone() + x[O_B2].clone()) * ay.clone() * (one.clone() - y[O_FA].clone()),
+        );
+        tr.assert_zero(x[O_A].clone() * x[O_LAST].clone() * (one.clone() - y[O_B0].clone()));
+        tr.assert_zero(
+            x[O_A].clone() * (one.clone() - x[O_LAST].clone()) * (one.clone() - y[O_A].clone()),
+        );
+        tr.assert_zero(x[O_A].clone() * (one.clone() - x[O_LAST].clone()) * y[O_FA].clone());
+        tr.assert_zero(x[O_B0].clone() * (one.clone() - y[O_B1].clone()));
+        tr.assert_zero(x[O_B1].clone() * (one.clone() - y[O_B2].clone()));
+        tr.assert_zero((one.clone() - ax.clone()) * ay.clone());
+        tr.assert_zero(x[O_FIN].clone() - ax.clone() * (one.clone() - ay.clone()));
+        tr.assert_zero(y[O_CNT].clone() - x[O_CNT].clone() - x[O_B2].clone());
+        builder.when_last_row().assert_zero(x[O_FIN].clone() - ax.clone());
+        builder.assert_zero(
+            x[O_FIN].clone() * (x[O_A].clone() + x[O_B0].clone() + x[O_B1].clone()),
+        );
+        // capacities and fixed words
+        let total = k(3) + x[O_K].clone() * k(LIMBS as u64);
+        builder.assert_zero(x[O_E].clone() * (x[O_W].clone() - one.clone()));
+        builder.assert_zero(x[O_E].clone() * (x[O_CAP].clone() - one.clone()));
+        builder.assert_zero(x[O_FA].clone() * (x[O_CAP].clone() - total.clone()));
+        builder.assert_zero(x[O_B0].clone() * (x[O_CAP].clone() - k(17)));
+        let first = x[O_E].clone() + x[O_FA].clone() + x[O_B0].clone();
+        for m in 1..8 {
+            builder.assert_zero(first.clone() * x[O_CAP + m].clone());
+        }
+        for j in 1..8 {
+            builder.assert_zero(x[O_E].clone() * x[O_W + j].clone());
+        }
+        let cont_y = y[O_A].clone() - y[O_FA].clone() + y[O_B1].clone() + y[O_B2].clone();
+        for m in 0..8 {
+            builder
+                .when_transition()
+                .assert_zero(cont_y.clone() * (y[O_CAP + m].clone() - x[O_OUT + 8 + m].clone()));
+        }
+        // the permutation, looked up in the bench Poseidon2 AIR
+        self.perm.lookup_key(
+            builder,
+            Poseidon2PermuteMessage {
+                input: std::array::from_fn(|i| x[O_W + i].clone()),
+                output: std::array::from_fn(|i| x[O_OUT + i].clone()),
+            },
+            ax.clone(),
+        );
+        // A blocks: words of [tagEnt, op, param, limbs...], zero padded
+        let (fa, a) = (x[O_FA].clone(), x[O_A].clone());
+        builder.assert_zero(fa.clone() * (x[O_W].clone() - k(iface::TAG_ENT)));
+        builder.assert_zero(fa.clone() * (x[O_W + 1].clone() - x[O_OP].clone()));
+        builder.assert_zero(fa.clone() * (x[O_W + 2].clone() - x[O_PARAM].clone()));
+        builder.assert_zero(fa.clone() * x[O_POS].clone());
+        builder.when_transition().assert_zero(
+            (y[O_A].clone() - y[O_FA].clone())
+                * (y[O_POS].clone() - x[O_POS].clone() - k(8)),
+        );
+        builder.assert_zero(a.clone() * (one.clone() - x[O_U].clone()));
+        let mut c = AB::Expr::ZERO;
+        for j in 0..8 {
+            let u = x[O_U + j].clone();
+            c += u.clone();
+            if j + 1 < 8 {
+                builder.assert_zero(x[O_U + j + 1].clone() * (one.clone() - u.clone()));
+            }
+            builder.assert_zero(a.clone() * (one.clone() - u.clone()) * x[O_W + j].clone());
+            let m = a.clone() * u - if j < 3 { fa.clone() } else { AB::Expr::ZERO };
+            let g = x[O_OFF].clone() * k(LIMBS as u64) + x[O_POS].clone() + k(j as u64) - k(3);
+            builder.push_interaction(VAL_BUS, vec![g, x[O_W + j].clone()], -m, 1);
+        }
+        let last = x[O_LAST].clone();
+        builder.assert_zero(a.clone() * (one.clone() - last.clone()) * (k(8) - c.clone()));
+        builder.assert_zero(a.clone() * last * (x[O_POS].clone() + c - total));
+        // B blocks: [tagStep, d_0..d_6], [d_7, h_0..h_6], [h_7, 0..]
+        let (b0, b1, b2) = (x[O_B0].clone(), x[O_B1].clone(), x[O_B2].clone());
+        builder.assert_zero(b0.clone() * (x[O_W].clone() - k(iface::TAG_STEP)));
+        for j in 1..8 {
+            builder.assert_zero(b0.clone() * (x[O_W + j].clone() - x[O_D + j - 1].clone()));
+            builder.assert_zero(b1.clone() * (x[O_W + j].clone() - x[O_H + j - 1].clone()));
+            builder.assert_zero(b2.clone() * x[O_W + j].clone());
+        }
+        builder.assert_zero(b1 * (x[O_W].clone() - x[O_D + 7].clone()));
+        builder.assert_zero(b2.clone() * (x[O_W].clone() - x[O_H + 7].clone()));
+        // carried fields
+        let same = ay.clone() * (one.clone() - y[O_FA].clone());
+        for f in [O_OP, O_PARAM, O_OFF, O_K] {
+            builder
+                .when_transition()
+                .assert_zero(same.clone() * (y[f].clone() - x[f].clone()));
+        }
+        for m in 0..8 {
+            let mut tr = builder.when_transition();
+            tr.assert_zero(same.clone() * (y[O_D + m].clone() - x[O_D + m].clone()));
+            tr.assert_zero(y[O_FA].clone() * (y[O_D + m].clone() - x[O_OUT + m].clone()));
+            tr.assert_zero(y[O_B0].clone() * (y[O_H + m].clone() - x[O_OUT + m].clone()));
+            tr.assert_zero(
+                (y[O_B1].clone() + y[O_B2].clone()) * (y[O_H + m].clone() - x[O_H + m].clone()),
+            );
+        }
+        // offsets: the first entry at 0, each next one after the values of the last
+        builder
+            .when_transition()
+            .assert_zero(x[O_E].clone() * y[O_OFF].clone());
+        builder.when_transition().assert_zero(
+            b2.clone() * y[O_FA].clone() * (y[O_OFF].clone() - x[O_OFF].clone() - x[O_K].clone()),
+        );
+        builder.push_interaction(
+            ENT_BUS,
+            vec![x[O_OP].clone(), x[O_PARAM].clone(), x[O_OFF].clone(), x[O_K].clone()],
+            -fa,
+            1,
+        );
+        // the tie: (d_n, n) on the last active row
+        let mut tie: Vec<AB::Expr> = (0..8).map(|m| x[O_OUT + m].clone()).collect();
+        tie.push(x[O_CNT].clone() + b2);
+        builder.push_interaction(TIE_BUS, tie, x[O_FIN].clone(), 1);
+    }
+}
+
+/// The interface AIRs with the onion (J8): the 4 of [`airs`] with their onion buses, then
+/// [`OnionAir`] on the bench `L`'s Poseidon2 permute bus.
+pub fn airs_onion(
+    dims: &Dims,
+    perm: Poseidon2PermuteBus,
+) -> Vec<openvm_stark_backend::AirRef<crate::fixture::LSC>> {
+    let mut v: Vec<openvm_stark_backend::AirRef<crate::fixture::LSC>> = KINDS
+        .iter()
+        .map(|&kind| {
+            std::sync::Arc::new(IfaceAir {
+                kind,
+                dims: *dims,
+                onion: true,
+            }) as openvm_stark_backend::AirRef<crate::fixture::LSC>
+        })
+        .collect();
+    v.push(std::sync::Arc::new(OnionAir { dims: *dims, perm }));
+    v
+}
+
+/// A trace with its public values.
+pub type Traced<F> = (RowMajorMatrix<F>, Vec<F>);
+
+/// The traces of [`airs_onion`] (the onion has no public values) and the Poseidon2 inputs that
+/// the onion looks up (external inputs of the bench `L` trace generation).
+pub fn traces_onion<F: Field>(
+    dims: &Dims,
+    words: &[u64],
+    perm: Poseidon2PermuteBus,
+) -> (Vec<Traced<F>>, Vec<[u64; 16]>) {
+    let mut t = traces::<F>(dims, words);
+    let (tr, ins) = OnionAir { dims: *dims, perm }.trace::<F>(words);
+    t.push((tr, vec![]));
+    (t, ins)
+}
