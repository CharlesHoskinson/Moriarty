+/// J7 on the words alone (no `L` proof): the `R` check and replay of plan D-10 on each case's
+/// public words, entered as inputs; the op count it adds (MEASURED) and its verdict per case.
+#[test]
+fn j7_r_check_on_words() {
+    use p3_baby_bear::BabyBear;
+    use p3_field::PrimeCharacteristicRing;
+    let dims = Dims::FULL;
+    let mut n_ops = None;
+    for (case, name, seed) in CASES {
+        let (run, _) = iface::case_run(&dims, case, seed);
+        let words = run.words();
+        let mut g = Gen::new();
+        let l_pub: Vec<_> = words.iter().map(|&w| g.bb_in(BabyBear::from_u64(w))).collect();
+        let before = g.tape.ops.len();
+        gen_r_check(&mut g, &l_pub, &words);
+        let added = g.tape.ops.len() - before;
+        let (_, failed) = g.tape.execute_checked(&g.inputs);
+        println!(
+            "J7 {name}: R check and replay {added} ops ({}); failed assertions {}",
+            op_counts_from(&g.tape.ops[before..]),
+            failed.len()
+        );
+        assert_eq!(*n_ops.get_or_insert(added), added, "same tape in every case");
+        assert_eq!(failed.is_empty(), !negative(case), "{name}");
+    }
+}
+
+fn op_counts_from(ops: &[sherlock_lfr::tape::Op]) -> String {
+    let mut c = std::collections::BTreeMap::<String, usize>::new();
+    for o in ops {
+        let k = format!("{o:?}");
+        let k = k.split([' ', '{', '(']).next().unwrap().to_string();
+        *c.entry(k).or_default() += 1;
+    }
+    format!("{c:?}")
+}
