@@ -0,0 +1,48 @@
+//! Writes the E5 fixture `lfr-real` (`wrapin` v1) from an existing `L_Fr` proof of the E2 I10
+//! tape (no new prove): the proving key cache and a proof written by the E4 profile harness at
+//! the unchanged tree (openvm c4bd312), read only. The stock verifier must accept the pair.
+//! usage: lfr_e4 <pk.bitcode> <proof.bin>
+use std::{fs, path::PathBuf, time::Instant};
+
+use openvm_stark_backend::{
+    codec::Decode, keygen::types::MultiStarkProvingKey, proof::Proof, StarkEngine,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381FrPoseidonConfig as SC;
+use sherlock_lfr::testing::{lfr_params, Engine};
+use sherlock_wrap_export::export;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let dir = PathBuf::from(std::env::var("E5_FIXTURES").unwrap_or_else(|_| {
+        format!("{}/.cache/e5-wrap/fixtures", std::env::var("HOME").unwrap())
+    }));
+    let t = Instant::now();
+    let pk: MultiStarkProvingKey<SC> =
+        bitcode::deserialize(&fs::read(&a[1]).unwrap()).expect("pk cache");
+    let vk = pk.get_vk();
+    drop(pk);
+    let proof = Proof::<SC>::decode_from_bytes(&fs::read(&a[2]).unwrap()).expect("proof");
+    let engine = Engine::new(lfr_params());
+    let doc = export("lfr-real", engine.config(), &vk, &proof);
+    assert!(
+        doc["stock_verdict"].as_bool().unwrap(),
+        "stock verifier refuses the pair"
+    );
+    let path = dir.join("lfr-real.json");
+    fs::write(&path, serde_json::to_vec(&doc).unwrap()).unwrap();
+    println!(
+        "E5EXPORT lfr-real (from {} and {}): {:.1} s, commitments {}, widths {:?}, log events {}, file {}",
+        a[1],
+        a[2],
+        t.elapsed().as_secs_f64(),
+        proof.stacking_proof.stacking_openings.len(),
+        proof
+            .stacking_proof
+            .stacking_openings
+            .iter()
+            .map(|v| v.len())
+            .collect::<Vec<_>>(),
+        doc["log"].as_array().unwrap().len(),
+        path.display()
+    );
+}
diff --git a/crates/sherlock-wrap-export/examples/lfr_real.rs b/crates/sherlock-wrap-export/examples/lfr_real.rs
