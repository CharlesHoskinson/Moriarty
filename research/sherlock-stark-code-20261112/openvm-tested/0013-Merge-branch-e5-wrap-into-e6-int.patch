--- /dev/null
+++ b/crates/sherlock-wrap-export/examples/lfr_real.rs
@@ -0,0 +1,77 @@
+//! Writes the E5 fixture `lfr-real` (`wrapin` v1): the E2 I10 `L_Fr` proof of the whole `L`
+//! verifier on the real bench `L` proof, at the `L_Fr` parameter set (`testing::lfr_params`),
+//! with the D-2 public word (the `L` vk pre-hash). This is the shape the wrap is keyed on.
+//! usage: cargo run --release -p sherlock-wrap-export --example lfr_real
+use std::{fs, path::PathBuf, time::Instant};
+
+use openvm_stark_backend::{
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    StarkEngine,
+};
+use sherlock_lfr::{
+    fixture,
+    lverify::{gen_verifier, Gen, LShape},
+    machine::Machine,
+    record::stock_log,
+    testing::{lfr_params, range_trace, Engine},
+};
+use sherlock_wrap_export::export;
+
+fn main() {
+    let dir = PathBuf::from(std::env::var("E5_FIXTURES").unwrap_or_else(|_| {
+        format!("{}/.cache/e5-wrap/fixtures", std::env::var("HOME").unwrap())
+    }));
+    fs::create_dir_all(&dir).unwrap();
+    let fx = fixture::load(&fixture::dir()).expect("E2 fixture");
+    let (_, ok) = stock_log(&fx.l_vk, &fx.l_proof);
+    assert!(ok, "stock verifier accepts L");
+    let shape = LShape::of(&fx.l_proof);
+    let mut g = Gen::new();
+    let words = gen_verifier(&mut g, &fx.l_vk, &shape, &fx.l_proof).expect("pinned shape");
+    for w in words {
+        g.tape.public(w);
+    }
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed");
+    let m = Machine::new(&g.tape);
+    let engine = Engine::new(lfr_params());
+    let airs = m.airs();
+    let t = Instant::now();
+    let (pk, vk) = engine.keygen(&airs);
+    let keygen_s = t.elapsed().as_secs_f64();
+    let mut traces = m.traces(&mem);
+    traces.push(range_trace(&pk, &airs, &traces));
+    let pis = m.public_values(&mem);
+    assert_eq!(pis.len(), traces.len());
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctx = ProvingContext::new(
+        traces
+            .iter()
+            .enumerate()
+            .map(|(i, t)| {
+                let cm = ColMajorMatrix::from_row_major(t);
+                (
+                    i,
+                    AirProvingContext::simple(
+                        engine.device().transport_matrix_to_device(&cm),
+                        pis[i].clone(),
+                    ),
+                )
+            })
+            .collect(),
+    );
+    let t = Instant::now();
+    let proof = engine.prove(&d_pk, ctx).expect("L_Fr prove");
+    let prove_s = t.elapsed().as_secs_f64();
+    let doc = export("lfr-real", engine.config(), &vk, &proof);
+    assert!(doc["stock_verdict"].as_bool().unwrap());
+    let path = dir.join("lfr-real.json");
+    fs::write(&path, serde_json::to_vec(&doc).unwrap()).unwrap();
+    println!(
+        "E5EXPORT lfr-real: keygen {keygen_s:.1} s, prove {prove_s:.1} s, commitments {}, widths {:?}, log events {}, file {}",
+        proof.stacking_proof.stacking_openings.len(),
+        proof.stacking_proof.stacking_openings.iter().map(|v| v.len()).collect::<Vec<_>>(),
+        doc["log"].as_array().unwrap().len(),
+        path.display()
+    );
+}
diff --git a/crates/sherlock-wrap-export/src/lib.rs b/crates/sherlock-wrap-export/src/lib.rs
new file mode 100644
index 0000000..38f77a5
--- /dev/null
+++ b/crates/sherlock-wrap-export/src/lib.rs
@@ -0,0 +1,99 @@
+//! Sherlock E5 exporter: an `L_Fr`-config proof (BLS12-381 Fr base, `EF = F`, Midnight
+//! Poseidon at the `L_Fr` codes u = 5, 6, 7) with its vk, the stacked layouts of
+//! `verify_proof_shape`, and the stock transcript record, as one JSON file (`wrapin` v1) for
+//! the wrap circuit in the Moriarty worktree (`tools/sherlock-wrap`). Fr values are serde
+//! bytes (32, little-endian canonical) inside the vk and proof; the log uses 64-digit
+//! big-endian hex.
+
+use std::sync::{Arc, Mutex};
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    verifier::{proof_shape::verify_proof_shape, verify},
+    FiatShamirTranscript, StarkProtocolConfig,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    Bls12381FrPoseidonConfig, Transcript, F,
+};
+use serde_json::{json, Value};
+
+pub type SC = Bls12381FrPoseidonConfig;
+
+/// Big-endian 64-digit hex of a canonical Fr value.
+pub fn hex_be(x: &F) -> String {
+    let v = serde_json::to_value(x).unwrap();
+    let mut b: Vec<u8> = serde_json::from_value(v).unwrap();
+    b.reverse();
+    hex::encode(b)
+}
+
+#[derive(Clone, Debug)]
+pub enum Ev {
+    Obs(F),
+    Commit(F),
+    Sample(F),
+}
+
+#[derive(Clone)]
+pub struct Rec {
+    pub inner: Transcript,
+    pub log: Arc<Mutex<Vec<Ev>>>,
+}
+
+impl FiatShamirTranscript<SC> for Rec {
+    fn observe(&mut self, v: F) {
+        self.log.lock().unwrap().push(Ev::Obs(v));
+        FiatShamirTranscript::<SC>::observe(&mut self.inner, v);
+    }
+    fn sample(&mut self) -> F {
+        let v = FiatShamirTranscript::<SC>::sample(&mut self.inner);
+        self.log.lock().unwrap().push(Ev::Sample(v));
+        v
+    }
+    fn observe_commit(&mut self, d: [F; 1]) {
+        self.log.lock().unwrap().push(Ev::Commit(d[0]));
+        FiatShamirTranscript::<SC>::observe_commit(&mut self.inner, d);
+    }
+}
+
+/// The stock verifier on `proof` with a recording transcript: (log, verdict).
+pub fn stock_log(config: &SC, vk: &MultiStarkVerifyingKey<SC>, proof: &Proof<SC>) -> (Vec<Ev>, bool) {
+    let mut rec = Rec { inner: config.transcript(), log: Default::default() };
+    let ok = verify(config, vk, proof, &mut rec).is_ok();
+    let log = rec.log.lock().unwrap().clone();
+    (log, ok)
+}
+
+/// The `wrapin` v1 document.
+pub fn export(name: &str, config: &SC, vk: &MultiStarkVerifyingKey<SC>, proof: &Proof<SC>) -> Value {
+    let (log, ok) = stock_log(config, vk, proof);
+    let layouts = verify_proof_shape::<SC>(&vk.inner, proof).expect("proof shape");
+    let p = config.params();
+    let d = config.domains();
+    let log: Vec<Value> = log
+        .iter()
+        .map(|e| match e {
+            Ev::Obs(x) => json!(["o", hex_be(x)]),
+            Ev::Commit(x) => json!(["c", hex_be(x)]),
+            Ev::Sample(x) => json!(["s", hex_be(x)]),
+        })
+        .collect();
+    json!({
+        "version": 1,
+        "name": name,
+        "derived": {
+            "k_whir": p.k_whir(),
+            "log_stacked_height": p.log_stacked_height(),
+            "log_final_poly_len": p.log_final_poly_len(),
+            "num_whir_rounds": p.num_whir_rounds(),
+            "num_whir_sumcheck_rounds": p.num_whir_sumcheck_rounds(),
+        },
+        "domains": {"u_leaf": d.u_leaf as u64, "u_node": d.u_node as u64, "u_transcript": d.u_transcript as u64},
+        "vk": serde_json::to_value(vk).unwrap(),
+        "proof": serde_json::to_value(proof).unwrap(),
+        "layouts": serde_json::to_value(&layouts).unwrap(),
+        "log": log,
+        "stock_verdict": ok,
+    })
+}
