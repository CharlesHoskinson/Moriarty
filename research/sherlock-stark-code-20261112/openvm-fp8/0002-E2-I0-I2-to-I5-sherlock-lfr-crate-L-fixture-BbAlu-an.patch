+//! Sherlock E2: the Fr recursion AIR set `L_Fr` that verifies one `L` proof.
+//!
+//! Plan: `research/sherlock-e2-lfr-20261112/PLAN.md` (Moriarty). Route: a dedicated verifier of
+//! the `L` vk with the `L` shape pinned (D-1), run as a tape over generic Fr AIRs.
+
+#![allow(clippy::needless_range_loop)] // index loops mirror the arithmetic of the AIRs
+
+pub mod alu;
+pub mod bb;
+pub mod fixture;
+pub mod fr;
+pub mod machine;
+pub mod poseidon;
+pub mod range;
+pub mod tape;
+pub mod testing;
+pub mod transcript;
diff --git a/crates/sherlock-lfr/src/machine.rs b/crates/sherlock-lfr/src/machine.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6a8aaaaf4e141bfa23cbb847c57dcfe7a8ae6c70
--- /dev/null
+++ b/crates/sherlock-lfr/src/machine.rs
@@ -0,0 +1,768 @@
+//! The tape machine: every AIR that runs a [`Tape`], built from the tape (the key) and filled
+//! from its executed memory (the witness).
+//!
+//! AIRs (only those with at least one op are present; `Range16` is always last):
+//! `InputAir` (BabyBear and `EF4` inputs and constants), `FrInputAir`, `BbAluProgAir`,
+//! `PoseidonProgAir`, `PackAir`, `SplitAir`, `ReshapeAir`, `Range16Air`. All talk over the
+//! write-once memory bus [`MEM_BUS`] and the 16-bit range bus.
+
+use std::sync::Arc;
+
+use num_bigint::BigUint;
+use openvm_stark_backend::{
+    interaction::InteractionBuilder,
+    p3_air::{Air, BaseAir, PairBuilder},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    AirRef, BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+
+use crate::{
+    alu::{canonical_cells, eval_canonical},
+    fr::{fr_from_big, limbs16, split, split_consts, H_LIMBS, V_LIMBS},
+    poseidon::{eval_rounds, poseidon_row, IN, OUT, POSEIDON_WIDTH},
+    range::{Range16Air, RangeCounts, RANGE_BUS},
+    tape::{padded, Addr, BbAluProgAir, InputAir, Op, Tape, Val, MEM_BUS},
+    testing::SC,
+};
+
+fn mem_msg<E: Clone + PrimeCharacteristicRing>(addr: E, v: &[E]) -> Vec<E> {
+    let mut m = vec![addr];
+    m.extend(v.iter().cloned());
+    while m.len() < 5 {
+        m.push(E::ZERO);
+    }
+    m
+}
+
+fn fu(x: u64) -> Fr {
+    Fr::from_u64(x)
+}
+
+fn get(mem: &[Option<Val>], a: Addr) -> Val {
+    mem[a as usize].expect("unwritten address")
+}
+
+macro_rules! air_boiler {
+    ($t:ty, $w:expr, $pw:expr) => {
+        impl BaseAir<Fr> for $t {
+            fn width(&self) -> usize {
+                $w
+            }
+            fn preprocessed_trace(&self) -> Option<RowMajorMatrix<Fr>> {
+                Some(self.pre())
+            }
+        }
+        impl BaseAirWithPublicValues<Fr> for $t {}
+        impl PartitionedBaseAir<Fr> for $t {}
+        impl $t {
+            pub const PRE_WIDTH: usize = $pw;
+        }
+    };
+}
+
+fn rows_to_matrix(rows: Vec<Vec<Fr>>, n: usize, w: usize, pad: Vec<Fr>) -> RowMajorMatrix<Fr> {
+    let h = padded(n);
+    let mut v = Vec::with_capacity(h * w);
+    for i in 0..h {
+        let r = rows.get(i).unwrap_or(&pad);
+        assert_eq!(r.len(), w);
+        v.extend_from_slice(r);
+    }
+    RowMajorMatrix::new(v, w)
+}
+
+// ------------------------------------------------------------------------------------------
+// FrInputAir: pre [addr, mult, is_const, k]; main [v].
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct FrInputProg {
+    pub addr: Addr,
+    pub mult: u64,
+    pub konst: Option<Fr>,
+}
+
+#[derive(Clone, Debug)]
+pub struct FrInputAir {
+    pub prog: Arc<Vec<FrInputProg>>,
+}
+air_boiler!(FrInputAir, 1, 4);
+
+impl FrInputAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                vec![
+                    fu(p.addr as u64),
+                    fu(p.mult),
+                    fu(p.konst.is_some() as u64),
+                    p.konst.unwrap_or(Fr::ZERO),
+                ]
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 4, vec![Fr::ZERO; 4])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| vec![get(mem, p.addr).fr()])
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 1, vec![Fr::ZERO])
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for FrInputAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..4).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let v: AB::Expr = r[0].into();
+        drop(r);
+        builder.assert_zero(p[2].clone() * (v.clone() - p[3].clone()));
+        builder.push_interaction(MEM_BUS, mem_msg(p[0].clone(), &[v]), p[1].clone(), 1);
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// PoseidonProgAir: pre [in_addr[3], out_addr[3], out_mult[3], active]; main = PoseidonFr row.
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct PermProg {
+    pub ins: [Addr; 3],
+    pub outs: [Addr; 3],
+    pub mults: [u64; 3],
+}
+
+#[derive(Clone, Debug)]
+pub struct PoseidonProgAir {
+    pub prog: Arc<Vec<PermProg>>,
+}
+air_boiler!(PoseidonProgAir, POSEIDON_WIDTH, 10);
+
+impl PoseidonProgAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r: Vec<Fr> = p.ins.iter().chain(&p.outs).map(|&a| fu(a as u64)).collect();
+                r.extend(p.mults.iter().map(|&m| fu(m)));
+                r.push(Fr::ONE);
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 10, vec![Fr::ZERO; 10])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| poseidon_row(p.ins.map(|a| get(mem, a).fr()), 0))
+            .collect();
+        rows_to_matrix(
+            rows,
+            self.prog.len(),
+            POSEIDON_WIDTH,
+            poseidon_row([Fr::ZERO; 3], 0),
+        )
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for PoseidonProgAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..10).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..POSEIDON_WIDTH).map(|i| r[i].into()).collect();
+        drop(r);
+        eval_rounds(builder, &x);
+        for i in 0..3 {
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[i].clone(), &[x[IN + i].clone()]),
+                -p[9].clone(),
+                1,
+            );
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[3 + i].clone(), &[x[OUT + i].clone()]),
+                p[6 + i].clone(),
+                1,
+            );
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// PackAir: pre [addr_b[8], use[8], addr_out, mult_out]; main [b[8], out].
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct PackProg {
+    pub ins: Vec<Addr>,
+    pub out: Addr,
+    pub mult: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct PackAir {
+    pub prog: Arc<Vec<PackProg>>,
+}
+air_boiler!(PackAir, 9, 18);
+
+impl PackAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![Fr::ZERO; 18];
+                for (i, &a) in p.ins.iter().enumerate() {
+                    r[i] = fu(a as u64);
+                    r[8 + i] = Fr::ONE;
+                }
+                r[16] = fu(p.out as u64);
+                r[17] = fu(p.mult);
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 18, vec![Fr::ZERO; 18])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![Fr::ZERO; 9];
+                for (i, &a) in p.ins.iter().enumerate() {
+                    r[i] = fu(get(mem, a).bb()[0]);
+                }
+                r[8] = get(mem, p.out).fr();
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 9, vec![Fr::ZERO; 9])
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for PackAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..18).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..9).map(|i| r[i].into()).collect();
+        drop(r);
+        let mut acc = AB::Expr::ZERO;
+        for i in (0..8).rev() {
+            builder.assert_zero((AB::Expr::ONE - p[8 + i].clone()) * x[i].clone());
+            acc = acc * AB::Expr::from_u64(1 << 31) + x[i].clone();
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[i].clone(), &[x[i].clone()]),
+                -p[8 + i].clone(),
+                1,
+            );
+        }
+        builder.assert_eq(x[8].clone(), acc);
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[16].clone(), &[x[8].clone()]),
+            p[17].clone(),
+            1,
+        );
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// SplitAir: pre [addr_x, addr_d[5], mult_d[5], active];
+// main [x, d[5], canon(d)[5][4], hl[7], gl[7], inv_e, is_eq, vl[10]].
+// ------------------------------------------------------------------------------------------
+
+pub const SP_X: usize = 0;
+pub const SP_D: usize = 1;
+pub const SP_DC: usize = 6;
+pub const SP_HL: usize = SP_DC + 20;
+pub const SP_GL: usize = SP_HL + H_LIMBS;
+pub const SP_INV: usize = SP_GL + H_LIMBS;
+pub const SP_EQ: usize = SP_INV + 1;
+pub const SP_VL: usize = SP_EQ + 1;
+pub const SPLIT_WIDTH: usize = SP_VL + V_LIMBS;
+
+#[derive(Clone, Debug)]
+pub struct SplitProg {
+    pub x: Addr,
+    pub outs: [Addr; 5],
+    pub mults: [u64; 5],
+}
+
+#[derive(Clone, Debug)]
+pub struct SplitAir {
+    pub prog: Arc<Vec<SplitProg>>,
+}
+air_boiler!(SplitAir, SPLIT_WIDTH, 12);
+
+/// A split witness: digits `d`, high part `h` (the honest one is [`split`]).
+#[derive(Clone, Debug)]
+pub struct SplitWitness {
+    pub x: Fr,
+    pub d: [u64; 5],
+    pub h: BigUint,
+}
+
+impl SplitWitness {
+    pub fn honest(x: Fr) -> Self {
+        let (d, h) = split(x);
+        Self { x, d, h }
+    }
+    pub fn cells(&self) -> Vec<Fr> {
+        let c = split_consts();
+        let mut r = vec![Fr::ZERO; SPLIT_WIDTH];
+        r[SP_X] = self.x;
+        for i in 0..5 {
+            r[SP_D + i] = fu(self.d[i]);
+            let cc = canonical_cells::<Fr>(self.d[i]);
+            for j in 0..4 {
+                r[SP_DC + 4 * i + j] = cc[j];
+            }
+        }
+        for (j, l) in limbs16(&self.h, H_LIMBS).into_iter().enumerate() {
+            r[SP_HL + j] = fu(l);
+        }
+        let g = if self.h <= c.h_max {
+            &c.h_max - &self.h
+        } else {
+            BigUint::ZERO
+        };
+        for (j, l) in limbs16(&g, H_LIMBS).into_iter().enumerate() {
+            r[SP_GL + j] = fu(l);
+        }
+        let e = fr_from_big(&c.h_max) - fr_from_big(&self.h);
+        let is_eq = e.is_zero();
+        r[SP_INV] = if is_eq { Fr::ZERO } else { e.inverse() };
+        r[SP_EQ] = fu(is_eq as u64);
+        if is_eq {
+            let low: BigUint = (0..5).map(|i| BigUint::from(self.d[i]) * &c.p_pow[i]).sum();
+            let v = if low <= c.low_max {
+                &c.low_max - low
+            } else {
+                BigUint::ZERO
+            };
+            for (j, l) in limbs16(&v, V_LIMBS).into_iter().enumerate() {
+                r[SP_VL + j] = fu(l);
+            }
+        }
+        r
+    }
+}
+
+impl SplitAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![fu(p.x as u64)];
+                r.extend(p.outs.iter().map(|&a| fu(a as u64)));
+                r.extend(p.mults.iter().map(|&m| fu(m)));
+                r.push(Fr::ONE);
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 12, vec![Fr::ZERO; 12])
+    }
+    pub fn witnesses(&self, mem: &[Option<Val>]) -> Vec<SplitWitness> {
+        self.prog
+            .iter()
+            .map(|p| SplitWitness::honest(get(mem, p.x).fr()))
+            .collect()
+    }
+    pub fn trace_from(&self, w: &[SplitWitness]) -> RowMajorMatrix<Fr> {
+        let rows = w.iter().map(|w| w.cells()).collect();
+        rows_to_matrix(
+            rows,
+            self.prog.len(),
+            SPLIT_WIDTH,
+            SplitWitness::honest(Fr::ZERO).cells(),
+        )
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        self.trace_from(&self.witnesses(mem))
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for SplitAir {
+    fn eval(&self, builder: &mut AB) {
+        let c = split_consts();
+        let k = |v: &BigUint| -> AB::Expr { AB::Expr::from(fr_from_big(v)) };
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..12).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..SPLIT_WIDTH).map(|i| r[i].into()).collect();
+        drop(r);
+        let limbs = |base: usize, n: usize| -> AB::Expr {
+            (0..n).rev().fold(AB::Expr::ZERO, |acc, j| {
+                acc * AB::Expr::from_u64(1 << 16) + x[base + j].clone()
+            })
+        };
+        let low = (0..5).fold(AB::Expr::ZERO, |acc, i| {
+            acc + x[SP_D + i].clone() * k(&c.p_pow[i])
+        });
+        let h = limbs(SP_HL, H_LIMBS);
+        builder.assert_eq(x[SP_X].clone(), low.clone() + h.clone() * k(&c.p_pow[5]));
+        let e = k(&c.h_max) - h;
+        builder.assert_eq(e.clone(), limbs(SP_GL, H_LIMBS));
+        let is_eq = x[SP_EQ].clone();
+        builder.assert_eq(is_eq.clone(), AB::Expr::ONE - e.clone() * x[SP_INV].clone());
+        builder.assert_zero(e * is_eq.clone());
+        builder.assert_eq(is_eq * (k(&c.low_max) - low), limbs(SP_VL, V_LIMBS));
+        for i in 0..5 {
+            let b = SP_DC + 4 * i;
+            eval_canonical(
+                builder,
+                x[SP_D + i].clone(),
+                x[b].clone(),
+                x[b + 1].clone(),
+                x[b + 2].clone(),
+                x[b + 3].clone(),
+            );
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[1 + i].clone(), &[x[SP_D + i].clone()]),
+                p[6 + i].clone(),
+                1,
+            );
+        }
+        for j in 0..H_LIMBS {
+            builder.push_interaction(RANGE_BUS, [x[SP_HL + j].clone()], AB::Expr::ONE, 1);
+            builder.push_interaction(RANGE_BUS, [x[SP_GL + j].clone()], AB::Expr::ONE, 1);
+        }
+        for j in 0..V_LIMBS {
+            builder.push_interaction(RANGE_BUS, [x[SP_VL + j].clone()], AB::Expr::ONE, 1);
+        }
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[0].clone(), &[x[SP_X].clone()]),
+            -p[11].clone(),
+            1,
+        );
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// ReshapeAir: pre [addr_ef, addr_bb[4], is_compose, is_decompose, mult_ef, mult_bb[4]]; main v[4].
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct ReshapeProg {
+    pub ef: Addr,
+    pub bb: [Addr; 4],
+    pub compose: bool,
+    pub mult_ef: u64,
+    pub mult_bb: [u64; 4],
+}
+
+#[derive(Clone, Debug)]
+pub struct ReshapeAir {
+    pub prog: Arc<Vec<ReshapeProg>>,
+}
+air_boiler!(ReshapeAir, 4, 12);
+
+impl ReshapeAir {
+    fn pre(&self) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| {
+                let mut r = vec![fu(p.ef as u64)];
+                r.extend(p.bb.iter().map(|&a| fu(a as u64)));
+                r.push(fu(p.compose as u64));
+                r.push(fu(!p.compose as u64));
+                r.push(fu(p.mult_ef));
+                r.extend(p.mult_bb.iter().map(|&m| fu(m)));
+                r
+            })
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 12, vec![Fr::ZERO; 12])
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let rows = self
+            .prog
+            .iter()
+            .map(|p| get(mem, p.ef).cells().to_vec())
+            .collect();
+        rows_to_matrix(rows, self.prog.len(), 4, vec![Fr::ZERO; 4])
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr> + PairBuilder> Air<AB> for ReshapeAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre");
+        let p: Vec<AB::Expr> = (0..12).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let v: Vec<AB::Expr> = (0..4).map(|i| r[i].into()).collect();
+        drop(r);
+        let (comp, decomp) = (p[5].clone(), p[6].clone());
+        builder.push_interaction(
+            MEM_BUS,
+            mem_msg(p[0].clone(), &v),
+            comp.clone() * p[7].clone() - decomp.clone(),
+            1,
+        );
+        for i in 0..4 {
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[1 + i].clone(), &[v[i].clone()]),
+                decomp.clone() * p[8 + i].clone() - comp.clone(),
+                1,
+            );
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// Machine
+// ------------------------------------------------------------------------------------------
+
+/// The AIRs of one tape, in the fixed order of the module comment.
+#[derive(Clone)]
+pub struct Machine {
+    pub input: Option<InputAir>,
+    pub fr_input: Option<FrInputAir>,
+    pub alu: Option<BbAluProgAir>,
+    pub poseidon: Option<PoseidonProgAir>,
+    pub pack: Option<PackAir>,
+    pub split: Option<SplitAir>,
+    pub reshape: Option<ReshapeAir>,
+}
+
+fn some<T>(v: Vec<T>) -> Option<Arc<Vec<T>>> {
+    (!v.is_empty()).then(|| Arc::new(v))
+}
+
+impl Machine {
+    pub fn new(tape: &Tape) -> Self {
+        let reads = tape.reads();
+        let m = |a: &Addr| reads[*a as usize];
+        let (mut fr_in, mut perm, mut pack, mut split, mut reshape) =
+            (vec![], vec![], vec![], vec![], vec![]);
+        let mut inp = vec![];
+        let mut alu = vec![];
+        for op in &tape.ops {
+            match op {
+                Op::Input { kind, out } => inp.push(crate::tape::InputProg {
+                    addr: *out,
+                    mult: m(out),
+                    bb: *kind == crate::tape::ValKind::Bb,
+                    konst: None,
+                }),
+                Op::Const { kind, val, out } => inp.push(crate::tape::InputProg {
+                    addr: *out,
+                    mult: m(out),
+                    bb: *kind == crate::tape::ValKind::Bb,
+                    konst: Some(*val),
+                }),
+                Op::Alu { kind, a, b, out } => alu.push(crate::tape::AluProg {
+                    kind: *kind,
+                    a: *a,
+                    b: *b,
+                    out: *out,
+                    mult: m(out),
+                }),
+                Op::FrInput { out } => fr_in.push(FrInputProg {
+                    addr: *out,
+                    mult: m(out),
+                    konst: None,
+                }),
+                Op::FrConst { val, out } => fr_in.push(FrInputProg {
+                    addr: *out,
+                    mult: m(out),
+                    konst: Some(*val),
+                }),
+                Op::Perm { ins, outs } => perm.push(PermProg {
+                    ins: *ins,
+                    outs: *outs,
+                    mults: outs.map(|a| m(&a)),
+                }),
+                Op::Pack { ins, out } => pack.push(PackProg {
+                    ins: ins.clone(),
+                    out: *out,
+                    mult: m(out),
+                }),
+                Op::Split { x, outs } => split.push(SplitProg {
+                    x: *x,
+                    outs: *outs,
+                    mults: outs.map(|a| m(&a)),
+                }),
+                Op::Compose { ins, out } => reshape.push(ReshapeProg {
+                    ef: *out,
+                    bb: *ins,
+                    compose: true,
+                    mult_ef: m(out),
+                    mult_bb: [0; 4],
+                }),
+                Op::Decompose { x, outs } => reshape.push(ReshapeProg {
+                    ef: *x,
+                    bb: *outs,
+                    compose: false,
+                    mult_ef: 0,
+                    mult_bb: outs.map(|a| m(&a)),
+                }),
+            }
+        }
+        Self {
+            input: some(inp).map(|prog| InputAir { prog }),
+            fr_input: some(fr_in).map(|prog| FrInputAir { prog }),
+            alu: some(alu).map(|prog| BbAluProgAir { prog }),
+            poseidon: some(perm).map(|prog| PoseidonProgAir { prog }),
+            pack: some(pack).map(|prog| PackAir { prog }),
+            split: some(split).map(|prog| SplitAir { prog }),
+            reshape: some(reshape).map(|prog| ReshapeAir { prog }),
+        }
+    }
+
+    /// AIRs in order, `Range16` last.
+    pub fn airs(&self) -> Vec<AirRef<SC>> {
+        let mut v: Vec<AirRef<SC>> = vec![];
+        if let Some(a) = &self.input {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.fr_input {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.alu {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.poseidon {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.pack {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.split {
+            v.push(Arc::new(a.clone()));
+        }
+        if let Some(a) = &self.reshape {
+            v.push(Arc::new(a.clone()));
+        }
+        v.push(Arc::new(Range16Air));
+        v
+    }
+
+    /// AIR names in [`Machine::airs`] order.
+    pub fn names(&self) -> Vec<&'static str> {
+        let mut v = vec![];
+        for (present, n) in [
+            (self.input.is_some(), "Input"),
+            (self.fr_input.is_some(), "FrInput"),
+            (self.alu.is_some(), "BbAlu"),
+            (self.poseidon.is_some(), "PoseidonFr"),
+            (self.pack.is_some(), "Pack"),
+            (self.split.is_some(), "Split"),
+            (self.reshape.is_some(), "Reshape"),
+        ] {
+            if present {
+                v.push(n);
+            }
+        }
+        v.push("Range16");
+        v
+    }
+
+    /// Honest main traces of every AIR except `Range16` (filled by
+    /// [`crate::testing::prove_verify_range`]).
+    pub fn traces(&self, mem: &[Option<Val>]) -> Vec<RowMajorMatrix<Fr>> {
+        let mut v = vec![];
+        let mut dummy = RangeCounts::default();
+        if let Some(a) = &self.input {
+            let vals: Vec<[u64; 4]> = a.prog.iter().map(|p| get(mem, p.addr).bb()).collect();
+            v.push(a.trace(&vals, &mut dummy));
+        }
+        if let Some(a) = &self.fr_input {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.alu {
+            let bb: Vec<[u64; 4]> = mem
+                .iter()
+                .map(|x| match x {
+                    Some(Val::Bb(b)) => *b,
+                    _ => [0; 4],
+                })
+                .collect();
+            v.push(a.trace(&a.rows(&bb), &mut dummy));
+        }
+        if let Some(a) = &self.poseidon {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.pack {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.split {
+            v.push(a.trace(mem));
+        }
+        if let Some(a) = &self.reshape {
+            v.push(a.trace(mem));
+        }
+        v
+    }
+
+    /// Rows and cells per AIR: (name, rows padded, main width, preprocessed width).
+    pub fn shape(&self) -> Vec<(&'static str, usize, usize, usize)> {
+        let mut v = vec![];
+        let mut push =
+            |n: &'static str, len: usize, w: usize, pw: usize| v.push((n, padded(len), w, pw));
+        if let Some(a) = &self.input {
+            push(
+                "Input",
+                a.prog.len(),
+                crate::tape::IN_WIDTH,
+                crate::tape::IN_PRE_WIDTH,
+            );
+        }
+        if let Some(a) = &self.fr_input {
+            push("FrInput", a.prog.len(), 1, 4);
+        }
+        if let Some(a) = &self.alu {
+            push(
+                "BbAlu",
+                a.prog.len(),
+                crate::alu::ALU_WIDTH,
+                crate::tape::ALU_PRE_WIDTH,
+            );
+        }
+        if let Some(a) = &self.poseidon {
+            push("PoseidonFr", a.prog.len(), POSEIDON_WIDTH, 10);
+        }
+        if let Some(a) = &self.pack {
+            push("Pack", a.prog.len(), 9, 18);
+        }
+        if let Some(a) = &self.split {
+            push("Split", a.prog.len(), SPLIT_WIDTH, 12);
+        }
+        if let Some(a) = &self.reshape {
+            push("Reshape", a.prog.len(), 4, 12);
+        }
+        v.push(("Range16", crate::range::RANGE_SIZE, 2, 0));
+        v
+    }
+}
