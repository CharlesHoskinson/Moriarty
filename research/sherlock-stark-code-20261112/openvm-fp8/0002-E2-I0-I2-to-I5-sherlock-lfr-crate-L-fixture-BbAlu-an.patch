index 0000000000000000000000000000000000000000..8ba7af9045ee843e9fb72a862434c69ab46bba16
--- /dev/null
+++ b/crates/sherlock-lfr/src/bb.rs
@@ -0,0 +1,44 @@
+//! BabyBear and `EF4 = BabyBear[x] / (x^4 - 11)` as integers, for trace generation.
+//!
+//! In `L_Fr` a BabyBear value is one Fr cell that holds its canonical representative in `[0, p)`.
+//! An `EF4` value is 4 such cells (coefficients of `1, x, x^2, x^3`).
+
+use p3_baby_bear::BabyBear;
+use p3_field::{
+    extension::BinomialExtensionField, BasedVectorSpace, PrimeCharacteristicRing, PrimeField32,
+};
+
+/// The BabyBear modulus `p = 2^31 - 2^27 + 1`.
+pub const P: u64 = 2_013_265_921;
+/// `p - 1 = 0x7800_0000`: the high 16-bit limb of `p - 1` is `0x7800` and its low limb is 0.
+pub const P_MINUS_1_HI: u64 = 0x7800;
+/// `EF4` is `BabyBear[x] / (x^4 - W)`.
+pub const W: u64 = 11;
+
+pub type Ef4 = BinomialExtensionField<BabyBear, 4>;
+
+/// The integer convolution of `a * b` reduced by `x^4 = W`, before reduction mod p.
+/// Each entry is below `34 p^2 < 2^68`.
+pub fn ef4_mul_unreduced(a: &[u64; 4], b: &[u64; 4]) -> [u128; 4] {
+    let mut c = [0u128; 4];
+    for i in 0..4 {
+        for j in 0..4 {
+            let t = a[i] as u128 * b[j] as u128;
+            if i + j < 4 {
+                c[i + j] += t;
+            } else {
+                c[i + j - 4] += W as u128 * t;
+            }
+        }
+    }
+    c
+}
+
+pub fn to_ef4(a: &[u64; 4]) -> Ef4 {
+    Ef4::from_basis_coefficients_fn(|i| BabyBear::from_u64(a[i]))
+}
+
+pub fn from_ef4(a: Ef4) -> [u64; 4] {
+    let c: &[BabyBear] = a.as_basis_coefficients_slice();
+    std::array::from_fn(|i| c[i].as_canonical_u32() as u64)
+}
diff --git a/crates/sherlock-lfr/src/fixture.rs b/crates/sherlock-lfr/src/fixture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7f267d70fd0137cf2dfc2e96c19be8b733a0efa7
--- /dev/null
+++ b/crates/sherlock-lfr/src/fixture.rs
@@ -0,0 +1,126 @@
+//! I0: the real `L` proof as a fixture on disk.
+//!
+//! The chain is M7's `l_fr.rs` unchanged: two W1 proofs (`Poseidon2SubAir`, app params, 2^20
+//! rows) -> node `VerifierSubCircuit::<2>` at the OD-19 internal set -> `L_cached`
+//! (`VerifierSubCircuit::<1>`, `has_cached = true`) at the OD-19 `L` set with the BabyBear-base,
+//! Midnight-Poseidon-Fr config (u = 1, 2, 3). The example `l_fixture` writes the files below;
+//! [`load`] reads them back.
+
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+use openvm_stark_backend::{
+    codec::{Decode, Encode},
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    SystemParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::{
+    baby_bear_bls12381_poseidon::BabyBearBls12381PoseidonConfig,
+    baby_bear_poseidon2::BabyBearPoseidon2Config, params_with_100_bits_security,
+};
+
+/// Config of `L` (BabyBear base, `EF4`, Midnight Poseidon over Fr, u = 1, 2, 3).
+pub type LSC = BabyBearBls12381PoseidonConfig;
+/// Config of the node below `L` (stock BabyBear Poseidon2).
+pub type NodeSC = BabyBearPoseidon2Config;
+
+pub const L_VK: &str = "l_vk.bitcode";
+pub const L_PROOF: &str = "l_proof.bin";
+pub const NODE_VK: &str = "node_vk.bitcode";
+pub const L_JSON: &str = "l_fixture.json";
+
+/// Fixture directory: `$E2_FIXTURE_DIR`, else `~/.cache/e2-lfr/fixture`.
+pub fn dir() -> PathBuf {
+    if let Ok(d) = std::env::var("E2_FIXTURE_DIR") {
+        return PathBuf::from(d);
+    }
+    let home = std::env::var("HOME").expect("HOME");
+    Path::new(&home).join(".cache/e2-lfr/fixture")
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn ud_params(
+    b: usize,
+    l_skip: usize,
+    n_stack: usize,
+    w_stack: usize,
+    mu: usize,
+    qpow: usize,
+    queries: &[usize],
+    logup: usize,
+) -> SystemParams {
+    let mut p = params_with_100_bits_security(
+        b,
+        l_skip,
+        n_stack,
+        w_stack,
+        0,
+        mu,
+        WhirProximityStrategy::UniqueDecoding,
+        4,
+        qpow,
+        4,
+    );
+    assert_eq!(p.whir.rounds.len(), queries.len(), "WHIR round count");
+    for (r, &q) in p.whir.rounds.iter_mut().zip(queries) {
+        r.num_queries = q;
+    }
+    p.logup.pow_bits = logup;
+    p
+}
+
+/// OD-19 internal set (UD-SIZING.md 5.1).
+pub fn internal_ud() -> SystemParams {
+    ud_params(3, 2, 17, 512, 9, 21, &[97, 82, 81], 18)
+}
+
+/// OD-19 `L` set (UD-SIZING.md 5.1) at a `w_stack` bound.
+pub fn l_ud(w_stack: usize) -> SystemParams {
+    ud_params(3, 2, 18, w_stack, 6, 20, &[98, 83, 82], 18)
+}
+
+/// The `L` fixture read from disk.
+pub struct LFixture {
+    pub l_vk: MultiStarkVerifyingKey<LSC>,
+    pub l_proof: Proof<LSC>,
+    pub l_proof_bytes: Vec<u8>,
+    pub node_vk: MultiStarkVerifyingKey<NodeSC>,
+}
+
+pub fn write(
+    d: &Path,
+    l_vk: &MultiStarkVerifyingKey<LSC>,
+    l_proof: &Proof<LSC>,
+    node_vk: &MultiStarkVerifyingKey<NodeSC>,
+) -> std::io::Result<usize> {
+    fs::create_dir_all(d)?;
+    let bytes = l_proof.encode_to_vec()?;
+    fs::write(d.join(L_PROOF), &bytes)?;
+    fs::write(
+        d.join(L_VK),
+        bitcode::serialize(l_vk).expect("vk serialize"),
+    )?;
+    fs::write(
+        d.join(NODE_VK),
+        bitcode::serialize(node_vk).expect("vk serialize"),
+    )?;
+    Ok(bytes.len())
+}
+
+pub fn load(d: &Path) -> std::io::Result<LFixture> {
+    let l_proof_bytes = fs::read(d.join(L_PROOF))?;
+    let l_proof = Proof::<LSC>::decode_from_bytes(&l_proof_bytes)?;
+    let l_vk = bitcode::deserialize(&fs::read(d.join(L_VK))?)
+        .map_err(|e| std::io::Error::other(format!("l_vk: {e}")))?;
+    let node_vk = bitcode::deserialize(&fs::read(d.join(NODE_VK))?)
+        .map_err(|e| std::io::Error::other(format!("node_vk: {e}")))?;
+    Ok(LFixture {
+        l_vk,
+        l_proof,
+        l_proof_bytes,
+        node_vk,
+    })
+}
diff --git a/crates/sherlock-lfr/src/fr.rs b/crates/sherlock-lfr/src/fr.rs
new file mode 100644
index 0000000000000000000000000000000000000000..841a6cdb6ba3f13912b15576d052017e0a83cf40
--- /dev/null
+++ b/crates/sherlock-lfr/src/fr.rs
@@ -0,0 +1,88 @@
+//! I5: Fr-word ops of the multi-field transcript of `L`.
+//!
+//! - **Pack**: `sum_i b_i 2^(31 i)` of 1 to 8 canonical BabyBear words (`pack_f_to_sf`).
+//! - **Split**: the 5 low base-`p` digits of a canonical Fr word `x` (`extract_samples`):
+//!   `x = sum_{i<5} d_i p^i + p^5 h` as integers, `d_i` canonical BabyBear.
+//!
+//! **Uniqueness of the split.** The AIR checks the identity in Fr, so a witness could represent
+//! `x + r` instead of `x`. It is refused by bounding the integer `T = low + p^5 h` (`low = sum
+//! d_i p^i < p^5`) below `r`: with `H = floor((r - 1) / p^5)` and `L = (r - 1) - p^5 H`, the AIR
+//! range-checks `h` and `H - h` to 112 bits (so `0 <= h <= H`, since `H < 2^101`), and when
+//! `h = H` it range-checks `L - low` to 160 bits (so `low <= L`). Then `T <= r - 1`, and `T = x
+//! mod r` with `0 <= x < r` gives `T = x`: the digits are the stock digits.
+
+use num_bigint::BigUint;
+use openvm_stark_backend::p3_field::{Field, PrimeCharacteristicRing, PrimeField};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+
+use crate::bb::P;
+
+/// Limbs of `h` and of `H - h` (16 bits each: 112 bits).
+pub const H_LIMBS: usize = 7;
+/// Limbs of `L - low` when `h = H` (160 bits).
+pub const V_LIMBS: usize = 10;
+
+pub fn fr_from_big(x: &BigUint) -> Fr {
+    Fr::from_biguint(x.clone()).expect("below r")
+}
+
+pub fn pack(words: &[u64]) -> Fr {
+    assert!(words.len() <= 8 && words.iter().all(|&w| w < P));
+    let base = Fr::from_u64(1 << 31);
+    words
+        .iter()
+        .rev()
+        .fold(Fr::ZERO, |acc, &w| acc * base + Fr::from_u64(w))
+}
+
+pub struct SplitConsts {
+    /// `p^i` for `i = 0..=5`.
+    pub p_pow: [BigUint; 6],
+    pub h_max: BigUint,
+    pub low_max: BigUint,
+}
+
+pub fn split_consts() -> SplitConsts {
+    let r = Fr::order();
+    let p = BigUint::from(P);
+    let p_pow: [BigUint; 6] = std::array::from_fn(|i| p.pow(i as u32));
+    let rm1 = &r - 1u32;
+    let h_max = &rm1 / &p_pow[5];
+    let low_max = &rm1 - &h_max * &p_pow[5];
+    assert!(h_max.bits() <= 16 * H_LIMBS as u64);
+    assert!(p_pow[5].bits() <= 16 * V_LIMBS as u64);
+    SplitConsts {
+        p_pow,
+        h_max,
+        low_max,
+    }
+}
+
+/// The stock digits and the high part `h`.
+pub fn split(x: Fr) -> ([u64; 5], BigUint) {
+    let p = BigUint::from(P);
+    let mut v = x.as_canonical_biguint();
+    let d = std::array::from_fn(|_| {
+        let r = (&v % &p).to_u64_digits().first().copied().unwrap_or(0);
+        v /= &p;
+        r
+    });
+    (d, v)
+}
+
+/// 16-bit limbs of `x` (little-endian), `n` of them; panics if `x` does not fit.
+pub fn limbs16(x: &BigUint, n: usize) -> Vec<u64> {
+    assert!(x.bits() <= 16 * n as u64, "value does not fit {n} limbs");
+    let mut v = x.clone();
+    (0..n)
+        .map(|_| {
+            let l = (&v & BigUint::from(0xffffu32))
+                .to_u64_digits()
+                .first()
+                .copied()
+                .unwrap_or(0);
+            v >>= 16u32;
+            l
+        })
+        .collect()
+}
diff --git a/crates/sherlock-lfr/src/lib.rs b/crates/sherlock-lfr/src/lib.rs
