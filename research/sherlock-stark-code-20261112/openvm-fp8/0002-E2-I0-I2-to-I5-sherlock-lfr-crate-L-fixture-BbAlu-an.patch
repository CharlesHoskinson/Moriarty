+//! `PoseidonFr`: the Midnight Poseidon permutation over BLS12-381 Fr, one row per permutation.
+//!
+//! Permutation (midnight-circuits 7.3.0 constants, as `m7_bls_fr.rs` `reference_perm`): width 3,
+//! 68 rounds; round `r` adds `RC[r]`, applies `x^5` to all 3 cells in a full round (`r < 4` or
+//! `r >= 64`) and to cell 2 in a partial round, then multiplies by `MDS`.
+//!
+//! Row layout: `in[3]`, then per S-box (8 x 3 full + 60 partial = 84 S-boxes) the two cells
+//! `t = x^2` and `y = x^5 = t^2 x`, then `out[3]` and `mult`. The S-box input `x` and every state
+//! cell between S-boxes are linear expressions of earlier cells (no column), so each S-box costs 2
+//! columns and 2 constraints of degree at most 3. Width 3 + 168 + 3 + 1 = 175.
+//!
+//! The row receives `[in, out]` on [`POSEIDON_BUS`] with multiplicity `mult`: a caller sends the
+//! 6 words of each permutation it uses.
+
+use std::sync::OnceLock;
+
+use midnight_circuits::hash::poseidon::constants::PoseidonField;
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, BaseAir},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{Bls12381Fr, MidnightFq};
+
+type Fr = Bls12381Fr;
+
+pub const POSEIDON_BUS: BusIndex = 1;
+pub const ROUNDS: usize = 68;
+pub const SBOXES: usize = 8 * 3 + 60;
+pub const IN: usize = 0;
+pub const SB: usize = 3;
+pub const OUT: usize = SB + 2 * SBOXES;
+pub const MULT: usize = OUT + 3;
+pub const POSEIDON_WIDTH: usize = MULT + 1;
+
+pub fn is_full(r: usize) -> bool {
+    !(4..64).contains(&r)
+}
+
+pub struct Constants {
+    pub rc: [[Fr; 3]; ROUNDS],
+    pub mds: [[Fr; 3]; 3],
+}
+
+pub fn constants() -> &'static Constants {
+    static C: OnceLock<Constants> = OnceLock::new();
+    C.get_or_init(|| {
+        let rc = <MidnightFq as PoseidonField>::ROUND_CONSTANTS;
+        let mds = <MidnightFq as PoseidonField>::MDS;
+        assert_eq!(rc.len(), ROUNDS);
+        Constants {
+            rc: std::array::from_fn(|r| std::array::from_fn(|i| Fr::from_ff(rc[r][i]))),
+            mds: std::array::from_fn(|i| std::array::from_fn(|j| Fr::from_ff(mds[i][j]))),
+        }
+    })
+}
+
+/// The permutation with every S-box input, for trace generation: returns (out, sbox inputs).
+pub fn permute_trace(input: [Fr; 3]) -> ([Fr; 3], Vec<Fr>) {
+    let c = constants();
+    let mut s = input;
+    let mut xs = Vec::with_capacity(SBOXES);
+    for r in 0..ROUNDS {
+        for i in 0..3 {
+            s[i] += c.rc[r][i];
+        }
+        for i in 0..3 {
+            if is_full(r) || i == 2 {
+                xs.push(s[i]);
+                s[i] = s[i].square().square() * s[i];
+            }
+        }
+        let t = s;
+        for i in 0..3 {
+            s[i] = c.mds[i][0] * t[0] + c.mds[i][1] * t[1] + c.mds[i][2] * t[2];
+        }
+    }
+    (s, xs)
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PoseidonFrAir;
+
+impl<F> BaseAir<F> for PoseidonFrAir {
+    fn width(&self) -> usize {
+        POSEIDON_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for PoseidonFrAir {}
+impl<F> PartitionedBaseAir<F> for PoseidonFrAir {}
+
+/// The round constraints of one row: `in -> out` through the 84 S-box cells.
+pub fn eval_rounds<AB: InteractionBuilder<F = Fr>>(builder: &mut AB, x: &[AB::Expr]) {
+    let c = constants();
+    let k = |v: Fr| -> AB::Expr { AB::Expr::from(v) };
+    let mut s: [AB::Expr; 3] = std::array::from_fn(|i| x[IN + i].clone());
+    let mut sb = 0;
+    for r in 0..ROUNDS {
+        for i in 0..3 {
+            s[i] = s[i].clone() + k(c.rc[r][i]);
+        }
+        for i in 0..3 {
+            if is_full(r) || i == 2 {
+                let (t, y) = (x[SB + 2 * sb].clone(), x[SB + 2 * sb + 1].clone());
+                builder.assert_eq(t.clone(), s[i].clone() * s[i].clone());
+                builder.assert_eq(y.clone(), t.clone() * t * s[i].clone());
+                s[i] = y;
+                sb += 1;
+            }
+        }
+        let t = s.clone();
+        s = std::array::from_fn(|i| {
+            t[0].clone() * k(c.mds[i][0])
+                + t[1].clone() * k(c.mds[i][1])
+                + t[2].clone() * k(c.mds[i][2])
+        });
+    }
+    debug_assert_eq!(sb, SBOXES);
+    for i in 0..3 {
+        builder.assert_eq(x[OUT + i].clone(), s[i].clone());
+    }
+}
+
+impl<AB: InteractionBuilder<F = Fr>> Air<AB> for PoseidonFrAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let row = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..POSEIDON_WIDTH).map(|i| row[i].into()).collect();
+        drop(row);
+        eval_rounds(builder, &x);
+        let msg: Vec<AB::Expr> = (0..3)
+            .map(|i| x[IN + i].clone())
+            .chain((0..3).map(|i| x[OUT + i].clone()))
+            .collect();
+        builder.push_interaction(POSEIDON_BUS, msg, -x[MULT].clone(), 1);
+    }
+}
+
+/// One honest row: the permutation of `input`, received `mult` times.
+pub fn poseidon_row(input: [Fr; 3], mult: u64) -> Vec<Fr> {
+    let (out, xs) = permute_trace(input);
+    let mut v = vec![Fr::ZERO; POSEIDON_WIDTH];
+    v[IN..IN + 3].copy_from_slice(&input);
+    for (j, xj) in xs.iter().enumerate() {
+        let t = xj.square();
+        v[SB + 2 * j] = t;
+        v[SB + 2 * j + 1] = t.square() * *xj;
+    }
+    v[OUT..OUT + 3].copy_from_slice(&out);
+    v[MULT] = Fr::from_u64(mult);
+    v
+}
+
+/// Trace of the given rows, padded to a power of two (at least 2) with the zero-state
+/// permutation at multiplicity 0.
+pub fn poseidon_trace(rows: Vec<Vec<Fr>>) -> RowMajorMatrix<Fr> {
+    let h = rows.len().next_power_of_two().max(2);
+    let pad = poseidon_row([Fr::ZERO; 3], 0);
+    let mut v = Vec::with_capacity(h * POSEIDON_WIDTH);
+    for i in 0..h {
+        v.extend_from_slice(rows.get(i).unwrap_or(&pad));
+    }
+    let m = RowMajorMatrix::new(v, POSEIDON_WIDTH);
+    debug_assert_eq!(m.height(), h);
+    m
+}
+
+/// Test caller: sends `[in, out]` on [`POSEIDON_BUS`] once per row with `is_real = 1`.
+/// Columns `[is_real, in[3], out[3]]`.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PoseidonCallerAir;
+
+pub const CALLER_WIDTH: usize = 7;
+
+impl<F> BaseAir<F> for PoseidonCallerAir {
+    fn width(&self) -> usize {
+        CALLER_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for PoseidonCallerAir {}
+impl<F> PartitionedBaseAir<F> for PoseidonCallerAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for PoseidonCallerAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let row = main.row_slice(0).expect("row");
+        builder.assert_bool(row[0]);
+        builder.push_interaction(POSEIDON_BUS, row[1..7].iter().copied(), row[0], 1);
+    }
+}
diff --git a/crates/sherlock-lfr/src/range.rs b/crates/sherlock-lfr/src/range.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3d1a3b12cae68a70bcebd1b4e7999b2df30aacaa
--- /dev/null
+++ b/crates/sherlock-lfr/src/range.rs
@@ -0,0 +1,78 @@
+//! `Range16`: the 16-bit lookup table, one row per value `0 .. 2^16`.
+//!
+//! Columns `[value, mult]`. `value` starts at 0, steps by 1 and ends at `2^16 - 1`; since a trace
+//! height is a power of two, the last-row constraint pins the height to `2^16`. The table receives
+//! `[value]` on [`RANGE_BUS`] with multiplicity `mult`.
+
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, AirBuilder, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+/// Bus of 16-bit range lookups `[x]`.
+pub const RANGE_BUS: BusIndex = 0;
+pub const RANGE_BITS: usize = 16;
+pub const RANGE_SIZE: usize = 1 << RANGE_BITS;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Range16Air;
+
+impl<F> BaseAir<F> for Range16Air {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for Range16Air {}
+impl<F> PartitionedBaseAir<F> for Range16Air {}
+
+impl<AB: InteractionBuilder> Air<AB> for Range16Air {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let local = main.row_slice(0).expect("local row");
+        let next = main.row_slice(1).expect("next row");
+        let (value, mult) = (local[0], local[1]);
+        let next_value = next[0];
+        builder.when_first_row().assert_zero(value);
+        builder
+            .when_transition()
+            .assert_eq(next_value, value.into() + AB::Expr::ONE);
+        builder
+            .when_last_row()
+            .assert_eq(value, AB::Expr::from_u64((RANGE_SIZE - 1) as u64));
+        builder.push_interaction(RANGE_BUS, [value], -mult.into(), 1);
+    }
+}
+
+/// Multiplicity counter for the table.
+#[derive(Clone, Debug)]
+pub struct RangeCounts(pub Vec<u64>);
+
+impl Default for RangeCounts {
+    fn default() -> Self {
+        Self(vec![0; RANGE_SIZE])
+    }
+}
+
+impl RangeCounts {
+    /// Count one lookup of `x`. Panics if `x >= 2^16` (trace generation of a valid witness).
+    pub fn add(&mut self, x: u64) {
+        self.0[usize::try_from(x)
+            .ok()
+            .filter(|&v| v < RANGE_SIZE)
+            .expect("range value")] += 1;
+    }
+
+    pub fn trace<F: Field>(&self) -> RowMajorMatrix<F> {
+        let mut v = Vec::with_capacity(2 * RANGE_SIZE);
+        for (i, &m) in self.0.iter().enumerate() {
+            v.push(F::from_u64(i as u64));
+            v.push(F::from_u64(m));
+        }
+        let m = RowMajorMatrix::new(v, 2);
+        debug_assert_eq!(m.height(), RANGE_SIZE);
+        m
+    }
+}
diff --git a/crates/sherlock-lfr/src/tape.rs b/crates/sherlock-lfr/src/tape.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e2a29ca02929fe076560a1d29d64b7831055b564
--- /dev/null
+++ b/crates/sherlock-lfr/src/tape.rs
@@ -0,0 +1,568 @@
+//! I4: the tape (a straight-line program fixed by the key) and its write-once memory.
+//!
+//! Every tape value has one address and is written once. A writer sends `[addr, v0, v1, v2, v3]`
+//! on [`MEM_BUS`] with the multiplicity `mult` = the number of reads of `addr` in the tape; each
+//! read sends the same message with count `-1`. Addresses, op kinds and multiplicities are
+//! preprocessed columns, so the key fixes the program; only the values are witness.
+//!
+//! AIRs:
+//! - [`InputAir`]: tape inputs (values of the `L` proof) and constants. Preprocessed `[addr,
+//!   mult, z1, z2, z3, is_const, k0..k3]`; main `v[4]` and a canonical gadget per coefficient
+//!   (`lo, hi, inv, is_max`). Each coefficient is canonical BabyBear; `z_k = 1` forces
+//!   coefficient `k` to 0 (a BabyBear value); `is_const = 1` forces `v = k`.
+//! - [`BbAluProgAir`]: the `BbAlu` row with its op, operand addresses and result multiplicity
+//!   preprocessed: `[add, sub, mul, addr_a, addr_b, addr_c, mult_c]`. The main selectors equal
+//!   the preprocessed ones; it reads `a` and `b` (count `-active`) and writes `c` (count
+//!   `mult_c`).
+
+use std::sync::Arc;
+
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder},
+    p3_air::{Air, BaseAir, PairBuilder},
+    p3_field::Field,
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+use p3_field::PrimeCharacteristicRing;
+
+use crate::{
+    alu::{
+        alu_trace, canonical_cells, eval_canonical, AluKind, AluOp, AluRow, BbAluAir, A, B, C,
+        SEL_ADD,
+    },
+    bb::P,
+    range::RangeCounts,
+};
+
+pub const MEM_BUS: BusIndex = 2;
+pub type Addr = u32;
+
+/// Value type of a tape input.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ValKind {
+    Bb,
+    Ef4,
+}
+
+/// A memory value: BabyBear or `EF4` (4 canonical coefficients; BabyBear has 3 zero ones), or
+/// one Fr word. On the bus both are `[addr, v0, v1, v2, v3]`; an Fr word is `[addr, v, 0, 0, 0]`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Val {
+    Bb([u64; 4]),
+    Fr(Fr),
+}
+
+impl Val {
+    pub fn bb(&self) -> [u64; 4] {
+        match self {
+            Val::Bb(v) => *v,
+            Val::Fr(_) => panic!("Fr value read as BabyBear"),
+        }
+    }
+    pub fn fr(&self) -> Fr {
+        match self {
+            Val::Fr(v) => *v,
+            Val::Bb(_) => panic!("BabyBear value read as Fr"),
+        }
+    }
+    pub fn cells(&self) -> [Fr; 4] {
+        match self {
+            Val::Bb(v) => std::array::from_fn(|k| Fr::from_u64(v[k])),
+            Val::Fr(v) => [*v, Fr::ZERO, Fr::ZERO, Fr::ZERO],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Op {
+    Input {
+        kind: ValKind,
+        out: Addr,
+    },
+    Const {
+        kind: ValKind,
+        val: [u64; 4],
+        out: Addr,
+    },
+    Alu {
+        kind: AluKind,
+        a: Addr,
+        b: Addr,
+        out: Addr,
+    },
+    /// A free Fr word (a value of the `L` proof, such as a commitment).
+    FrInput {
+        out: Addr,
+    },
+    FrConst {
+        val: Fr,
+        out: Addr,
+    },
+    /// The Midnight Poseidon permutation of 3 Fr words.
+    Perm {
+        ins: [Addr; 3],
+        outs: [Addr; 3],
+    },
+    /// `sum_i b_i 2^(31 i)` of 1 to 8 BabyBear words (multi-field packing).
+    Pack {
+        ins: Vec<Addr>,
+        out: Addr,
+    },
+    /// The 5 low base-`p` digits of an Fr word (multi-field squeeze).
+    Split {
+        x: Addr,
+        outs: [Addr; 5],
+    },
+    /// 4 BabyBear words -> one `EF4` value.
+    Compose {
+        ins: [Addr; 4],
+        out: Addr,
+    },
+    /// One `EF4` value -> its 4 coefficients as BabyBear words.
+    Decompose {
+        x: Addr,
+        outs: [Addr; 4],
+    },
+}
+
+/// A straight-line program over BabyBear and `EF4` values.
+#[derive(Clone, Debug, Default)]
+pub struct Tape {
+    pub ops: Vec<Op>,
+    next: Addr,
+}
+
+impl Tape {
+    fn fresh(&mut self) -> Addr {
+        self.next += 1; // address 0 is never used (padding rows carry it with count 0)
+        self.next
+    }
+    pub fn input(&mut self, kind: ValKind) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::Input { kind, out });
+        out
+    }
+    pub fn constant(&mut self, kind: ValKind, val: [u64; 4]) -> Addr {
+        assert!(val.iter().all(|&v| v < P));
+        assert!(kind == ValKind::Ef4 || val[1..] == [0; 3]);
+        let out = self.fresh();
+        self.ops.push(Op::Const { kind, val, out });
+        out
+    }
+    pub fn alu(&mut self, kind: AluKind, a: Addr, b: Addr) -> Addr {
+        assert!(
+            a <= self.next && b <= self.next && a > 0 && b > 0,
+            "read before write"
+        );
+        let out = self.fresh();
+        self.ops.push(Op::Alu { kind, a, b, out });
+        out
+    }
+    pub fn add(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Add, a, b)
+    }
+    pub fn sub(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Sub, a, b)
+    }
+    pub fn mul(&mut self, a: Addr, b: Addr) -> Addr {
+        self.alu(AluKind::Mul, a, b)
+    }
+    pub fn num_addrs(&self) -> usize {
+        self.next as usize + 1
+    }
+    fn check(&self, a: Addr) {
+        assert!(a > 0 && a <= self.next, "read before write");
+    }
+    pub fn fr_input(&mut self) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::FrInput { out });
+        out
+    }
+    pub fn fr_const(&mut self, val: Fr) -> Addr {
+        let out = self.fresh();
+        self.ops.push(Op::FrConst { val, out });
+        out
+    }
+    pub fn perm(&mut self, ins: [Addr; 3]) -> [Addr; 3] {
+        ins.iter().for_each(|&a| self.check(a));
+        let outs = [self.fresh(), self.fresh(), self.fresh()];
+        self.ops.push(Op::Perm { ins, outs });
+        outs
+    }
+    pub fn pack(&mut self, ins: &[Addr]) -> Addr {
+        assert!(!ins.is_empty() && ins.len() <= 8);
+        ins.iter().for_each(|&a| self.check(a));
+        let out = self.fresh();
+        self.ops.push(Op::Pack {
+            ins: ins.to_vec(),
+            out,
+        });
+        out
+    }
+    pub fn split(&mut self, x: Addr) -> [Addr; 5] {
+        self.check(x);
+        let outs = std::array::from_fn(|_| self.fresh());
+        self.ops.push(Op::Split { x, outs });
+        outs
+    }
+    pub fn compose(&mut self, ins: [Addr; 4]) -> Addr {
+        ins.iter().for_each(|&a| self.check(a));
+        let out = self.fresh();
+        self.ops.push(Op::Compose { ins, out });
+        out
+    }
+    pub fn decompose(&mut self, x: Addr) -> [Addr; 4] {
+        self.check(x);
+        let outs = std::array::from_fn(|_| self.fresh());
+        self.ops.push(Op::Decompose { x, outs });
+        outs
+    }
+
+    /// Read counts per address.
+    pub fn reads(&self) -> Vec<u64> {
+        let mut r = vec![0u64; self.num_addrs()];
+        let mut rd = |a: &Addr| r[*a as usize] += 1;
+        for op in &self.ops {
+            match op {
+                Op::Alu { a, b, .. } => {
+                    rd(a);
+                    rd(b);
+                }
+                Op::Perm { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Pack { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Split { x, .. } => rd(x),
+                Op::Compose { ins, .. } => ins.iter().for_each(&mut rd),
+                Op::Decompose { x, .. } => rd(x),
+                Op::Input { .. } | Op::Const { .. } | Op::FrInput { .. } | Op::FrConst { .. } => {}
+            }
+        }
+        r
+    }
+
+    /// Run a BabyBear and `EF4` tape on the input values (in order of the `Input` ops).
+    pub fn execute(&self, inputs: &[[u64; 4]]) -> Vec<[u64; 4]> {
+        let ins: Vec<Val> = inputs.iter().map(|v| Val::Bb(*v)).collect();
+        self.execute_vals(&ins)
+            .into_iter()
+            .map(|v| v.map(|v| v.bb()).unwrap_or([0; 4]))
+            .collect()
+    }
+
+    /// Run the tape on the input values (in order of the `Input` and `FrInput` ops). Returns
+    /// every value (`None` at address 0).
+    pub fn execute_vals(&self, inputs: &[Val]) -> Vec<Option<Val>> {
+        let mut mem: Vec<Option<Val>> = vec![None; self.num_addrs()];
+        let mut it = inputs.iter();
+        let get = |mem: &Vec<Option<Val>>, a: &Addr| mem[*a as usize].expect("unwritten address");
+        for op in &self.ops {
+            match op {
+                Op::Input { kind, out } => {
+                    let v = it.next().expect("too few inputs").bb();
+                    assert!(v.iter().all(|&x| x < P), "input not canonical");
+                    assert!(*kind == ValKind::Ef4 || v[1..] == [0; 3], "BabyBear input");
+                    mem[*out as usize] = Some(Val::Bb(v));
+                }
+                Op::Const { val, out, .. } => mem[*out as usize] = Some(Val::Bb(*val)),
+                Op::Alu { kind, a, b, out } => {
+                    let op = AluOp {
+                        kind: *kind,
+                        a: get(&mem, a).bb(),
+                        b: get(&mem, b).bb(),
+                    };
+                    mem[*out as usize] = Some(Val::Bb(op.result()));
+                }
+                Op::FrInput { out } => {
+                    mem[*out as usize] = Some(Val::Fr(it.next().expect("too few inputs").fr()))
+                }
+                Op::FrConst { val, out } => mem[*out as usize] = Some(Val::Fr(*val)),
+                Op::Perm { ins, outs } => {
+                    let (o, _) = crate::poseidon::permute_trace(ins.map(|a| get(&mem, &a).fr()));
+                    for i in 0..3 {
+                        mem[outs[i] as usize] = Some(Val::Fr(o[i]));
+                    }
+                }
+                Op::Pack { ins, out } => {
+                    let words: Vec<u64> = ins.iter().map(|a| get(&mem, a).bb()[0]).collect();
+                    mem[*out as usize] = Some(Val::Fr(crate::fr::pack(&words)));
+                }
+                Op::Split { x, outs } => {
+                    let d = crate::fr::split(get(&mem, x).fr()).0;
+                    for i in 0..5 {
+                        mem[outs[i] as usize] = Some(Val::Bb([d[i], 0, 0, 0]));
+                    }
+                }
+                Op::Compose { ins, out } => {
+                    let v = ins.map(|a| get(&mem, &a).bb()[0]);
+                    mem[*out as usize] = Some(Val::Bb(v));
+                }
+                Op::Decompose { x, outs } => {
+                    let v = get(&mem, x).bb();
+                    for i in 0..4 {
+                        mem[outs[i] as usize] = Some(Val::Bb([v[i], 0, 0, 0]));
+                    }
+                }
+            }
+        }
+        assert!(it.next().is_none(), "too many inputs");
+        mem
+    }
+
+    /// The preprocessed programs of the two AIRs.
+    pub fn programs(&self) -> (InputAir, BbAluProgAir) {
+        let reads = self.reads();
+        let mut inp = vec![];
+        let mut alu = vec![];
+        for op in &self.ops {
+            match op {
+                Op::Input { kind, out } => inp.push(InputProg {
+                    addr: *out,
+                    mult: reads[*out as usize],
+                    bb: *kind == ValKind::Bb,
+                    konst: None,
+                }),
+                Op::Const { kind, val, out } => inp.push(InputProg {
+                    addr: *out,
+                    mult: reads[*out as usize],
+                    bb: *kind == ValKind::Bb,
+                    konst: Some(*val),
+                }),
+                Op::Alu { kind, a, b, out } => alu.push(AluProg {
+                    kind: *kind,
+                    a: *a,
+                    b: *b,
+                    out: *out,
+                    mult: reads[*out as usize],
+                }),
+                _ => panic!("programs() is for BabyBear and EF4 tapes; use machine::Machine"),
+            }
+        }
+        (
+            InputAir {
+                prog: Arc::new(inp),
+            },
+            BbAluProgAir {
+                prog: Arc::new(alu),
+            },
+        )
+    }
+}
+
+pub fn padded(n: usize) -> usize {
+    n.next_power_of_two().max(2)
+}
+
+// ------------------------------------------------------------------------------------------
+// InputAir
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct InputProg {
+    pub addr: Addr,
+    pub mult: u64,
+    pub bb: bool,
+    pub konst: Option<[u64; 4]>,
+}
+
+#[derive(Clone, Debug)]
+pub struct InputAir {
+    pub prog: Arc<Vec<InputProg>>,
+}
+
+pub const IN_PRE_WIDTH: usize = 10;
+pub const IN_WIDTH: usize = 20;
+
+impl<F: Field> BaseAir<F> for InputAir {
+    fn width(&self) -> usize {
+        IN_WIDTH
+    }
+    fn preprocessed_trace(&self) -> Option<RowMajorMatrix<F>> {
+        let h = padded(self.prog.len());
+        let mut v = vec![F::ZERO; h * IN_PRE_WIDTH];
+        for (i, p) in self.prog.iter().enumerate() {
+            let r = &mut v[i * IN_PRE_WIDTH..(i + 1) * IN_PRE_WIDTH];
+            r[0] = F::from_u32(p.addr);
+            r[1] = F::from_u64(p.mult);
+            if p.bb {
+                r[2] = F::ONE;
+                r[3] = F::ONE;
+                r[4] = F::ONE;
+            }
+            if let Some(k) = p.konst {
+                r[5] = F::ONE;
+                for j in 0..4 {
+                    r[6 + j] = F::from_u64(k[j]);
+                }
+            }
+        }
+        Some(RowMajorMatrix::new(v, IN_PRE_WIDTH))
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for InputAir {}
+impl<F: Field> PartitionedBaseAir<F> for InputAir {}
+
+impl<AB: InteractionBuilder + PairBuilder> Air<AB> for InputAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre row");
+        let p = |i: usize| -> AB::Expr { pr[i].into() };
+        let pv: Vec<AB::Expr> = (0..IN_PRE_WIDTH).map(p).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..IN_WIDTH).map(|i| r[i].into()).collect();
+        drop(r);
+        for k in 0..4 {
+            let v = x[k].clone();
+            eval_canonical(
+                builder,
+                v.clone(),
+                x[4 + k].clone(),
+                x[8 + k].clone(),
+                x[12 + k].clone(),
+                x[16 + k].clone(),
+            );
+            if k > 0 {
+                builder.assert_zero(pv[1 + k].clone() * v.clone());
+            }
+            builder.assert_zero(pv[5].clone() * (v - pv[6 + k].clone()));
+        }
+        let msg: Vec<AB::Expr> = std::iter::once(pv[0].clone())
+            .chain(x[0..4].iter().cloned())
+            .collect();
+        builder.push_interaction(MEM_BUS, msg, pv[1].clone(), 1);
+    }
+}
+
+impl InputAir {
+    /// Main trace from the value of each row (in program order). Canonical cells are computed
+    /// from the values as given, so a test can pass a non-canonical value.
+    pub fn trace<F: Field>(
+        &self,
+        vals: &[[u64; 4]],
+        counts: &mut RangeCounts,
+    ) -> RowMajorMatrix<F> {
+        assert_eq!(vals.len(), self.prog.len());
+        let h = padded(self.prog.len());
+        let mut v = vec![F::ZERO; h * IN_WIDTH];
+        for i in 0..h {
+            let val = vals.get(i).copied().unwrap_or([0; 4]);
+            let row = &mut v[i * IN_WIDTH..(i + 1) * IN_WIDTH];
+            for k in 0..4 {
+                row[k] = F::from_u64(val[k]);
+                let cc = canonical_cells::<F>(val[k]);
+                for j in 0..4 {
+                    row[4 + 4 * j + k] = cc[j];
+                }
+                let (lo, hi) = (val[k] & 0xffff, val[k] >> 16);
+                for x in [Some(lo), Some(hi), 0x7800u64.checked_sub(hi)]
+                    .into_iter()
+                    .flatten()
+                {
+                    if x < (1 << 16) {
+                        counts.add(x);
+                    }
+                }
+            }
+        }
+        RowMajorMatrix::new(v, IN_WIDTH)
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// BbAluProgAir
+// ------------------------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct AluProg {
+    pub kind: AluKind,
+    pub a: Addr,
+    pub b: Addr,
+    pub out: Addr,
+    pub mult: u64,
+}
+
+#[derive(Clone, Debug)]
+pub struct BbAluProgAir {
+    pub prog: Arc<Vec<AluProg>>,
+}
+
+pub const ALU_PRE_WIDTH: usize = 7;
+
+impl<F: Field> BaseAir<F> for BbAluProgAir {
+    fn width(&self) -> usize {
+        crate::alu::ALU_WIDTH
+    }
+    fn preprocessed_trace(&self) -> Option<RowMajorMatrix<F>> {
+        let h = padded(self.prog.len());
+        let mut v = vec![F::ZERO; h * ALU_PRE_WIDTH];
+        for (i, p) in self.prog.iter().enumerate() {
+            let r = &mut v[i * ALU_PRE_WIDTH..(i + 1) * ALU_PRE_WIDTH];
+            let s = match p.kind {
+                AluKind::Add => 0,
+                AluKind::Sub => 1,
+                AluKind::Mul => 2,
+            };
+            r[s] = F::ONE;
+            r[3] = F::from_u32(p.a);
+            r[4] = F::from_u32(p.b);
+            r[5] = F::from_u32(p.out);
+            r[6] = F::from_u64(p.mult);
+        }
+        Some(RowMajorMatrix::new(v, ALU_PRE_WIDTH))
+    }
+}
+impl<F: Field> BaseAirWithPublicValues<F> for BbAluProgAir {}
+impl<F: Field> PartitionedBaseAir<F> for BbAluProgAir {}
+
+impl<AB: InteractionBuilder + PairBuilder> Air<AB> for BbAluProgAir {
+    fn eval(&self, builder: &mut AB) {
+        let pre = builder.preprocessed();
+        let pr = pre.row_slice(0).expect("pre row");
+        let pv: Vec<AB::Expr> = (0..ALU_PRE_WIDTH).map(|i| pr[i].into()).collect();
+        drop(pr);
+        let main = builder.main();
+        let r = main.row_slice(0).expect("row");
+        let x: Vec<AB::Expr> = (0..crate::alu::ALU_WIDTH).map(|i| r[i].into()).collect();
+        drop(r);
+        // The ALU identities (selectors from main) ...
+        <BbAluAir as Air<AB>>::eval(&BbAluAir, builder);
+        // ... with the selectors fixed by the program.
+        for s in 0..3 {
+            builder.assert_eq(x[SEL_ADD + s].clone(), pv[s].clone());
+        }
+        let active = pv[0].clone() + pv[1].clone() + pv[2].clone();
+        let msg = |addr: AB::Expr, base: usize| -> Vec<AB::Expr> {
+            std::iter::once(addr)
+                .chain(x[base..base + 4].iter().cloned())
+                .collect()
+        };
+        builder.push_interaction(MEM_BUS, msg(pv[3].clone(), A), -active.clone(), 1);
+        builder.push_interaction(MEM_BUS, msg(pv[4].clone(), B), -active, 1);
+        builder.push_interaction(MEM_BUS, msg(pv[5].clone(), C), pv[6].clone(), 1);
+    }
+}
+
+impl BbAluProgAir {
+    /// Honest rows from the executed memory.
+    pub fn rows(&self, mem: &[[u64; 4]]) -> Vec<AluRow> {
+        self.prog
+            .iter()
+            .map(|p| {
+                AluRow::from_op(&AluOp {
+                    kind: p.kind,
+                    a: mem[p.a as usize],
+                    b: mem[p.b as usize],
+                })
+            })
+            .collect()
+    }
+
+    pub fn trace<F: Field>(&self, rows: &[AluRow], counts: &mut RangeCounts) -> RowMajorMatrix<F> {
+        let m = alu_trace::<F>(rows, counts);
+        assert_eq!(m.height(), padded(self.prog.len()));
+        m
+    }
+}
diff --git a/crates/sherlock-lfr/src/testing.rs b/crates/sherlock-lfr/src/testing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0f321e83c1f3bfa2ff878b33b0371c7bccdd87c3
--- /dev/null
+++ b/crates/sherlock-lfr/src/testing.rs
@@ -0,0 +1,172 @@
+//! Prove-and-verify helpers for the increment tests, at the `L_Fr` domains (u = 5, 6, 7).
+
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use num_bigint::BigUint;
+use openvm_stark_backend::{
+    air_builders::symbolic::SymbolicConstraints,
+    codec::Encode,
+    interaction::debug::{generate_logical_interactions, LogicalInteractions},
+    interaction::LogUpSecurityParameters,
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    p3_field::PrimeField,
+    p3_matrix::dense::RowMajorMatrix,
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    AirRef, StarkEngine, SystemParams, WhirConfig, WhirParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    Bls12381FrPoseidonConfig, Bls12381FrPoseidonLfrCpuEngine, F,
+};
+
+use crate::range::{RangeCounts, RANGE_BUS, RANGE_SIZE};
+
+pub type SC = Bls12381FrPoseidonConfig;
+pub type Engine = Bls12381FrPoseidonLfrCpuEngine;
+
+/// Small Fr test set: UD, log blowup 1, `l_skip` 2, `n_stack` 14 (stacked height 2^16, so the
+/// 2^16-row range table fits), `k_whir` 4, every grinding site on at a few bits.
+pub fn small_params(max_constraint_degree: usize) -> SystemParams {
+    let (l_skip, n_stack, k_whir, log_blowup) = (2, 14, 4, 1);
+    let whir_params = WhirParams {
+        k: k_whir,
+        log_final_poly_len: (l_skip + n_stack) % k_whir,
+        query_phase_pow_bits: 6,
+        folding_pow_bits: 5,
+        mu_pow_bits: 4,
+        proximity: WhirProximityStrategy::UniqueDecoding,
+    };
+    SystemParams {
+        l_skip,
+        n_stack,
+        w_stack: 64,
+        log_blowup,
+        whir: WhirConfig::new(log_blowup, l_skip + n_stack, whir_params, 40),
+        logup: LogUpSecurityParameters {
+            max_interaction_count: 1 << 30,
+            log_max_message_length: 7,
+            pow_bits: 7,
+        },
+        max_constraint_degree,
+    }
+}
+
+/// Outcome of one prove-and-verify run.
+#[derive(Debug)]
+pub enum Outcome {
+    /// Proved and the stock verifier accepted; proof bytes.
+    Accepted(usize),
+    /// The stock verifier refused the proof.
+    VerifierRefused(String),
+    /// The prover stopped (panic) on the witness.
+    ProverRefused(String),
+}
+
+impl Outcome {
+    pub fn accepted(&self) -> bool {
+        matches!(self, Outcome::Accepted(_))
+    }
+}
+
+/// Keygen, prove and verify `airs` on `traces` (one per AIR, in order, no public values).
+pub fn prove_verify(
+    params: SystemParams,
+    airs: Vec<AirRef<SC>>,
+    traces: Vec<RowMajorMatrix<F>>,
+) -> Outcome {
+    let engine = Engine::new(params);
+    let (pk, vk) = engine.keygen(&airs);
+    prove_verify_keyed(&engine, &pk, &vk, traces)
+}
+
+/// The `Range16` multiplicities that balance the range bus for the main traces of
+/// `airs[..n-1]` (the last AIR is `Range16`). A looked-up value at or above `2^16` is left
+/// out, so its bus does not balance.
+pub fn range_trace(
+    pk: &MultiStarkProvingKey<SC>,
+    airs: &[AirRef<SC>],
+    traces: &[RowMajorMatrix<F>],
+) -> RowMajorMatrix<F> {
+    let mut li = LogicalInteractions::<F>::default();
+    for (i, (air, t)) in airs.iter().zip(traces).enumerate() {
+        let sc = SymbolicConstraints::from(&pk.per_air[i].vk.symbolic_constraints);
+        let pre = air.preprocessed_trace();
+        let pre_view = pre.as_ref().map(|m| m.as_view());
+        generate_logical_interactions(i, &sc.interactions, &pre_view, &[t.as_view()], &[], &mut li);
+    }
+    let mut counts = RangeCounts::default();
+    if let Some(bus) = li.at_bus.get(&RANGE_BUS) {
+        for (fields, conns) in bus {
+            let v = fields[0].as_canonical_biguint();
+            if v < BigUint::from(RANGE_SIZE as u64) {
+                let idx = v.to_u64_digits().first().copied().unwrap_or(0) as usize;
+                let total: F = conns.iter().map(|(_, c)| *c).sum();
+                // Counts are small non-negative integers for an honest or tampered trace.
+                let n = total
+                    .as_canonical_biguint()
+                    .to_u64_digits()
+                    .first()
+                    .copied()
+                    .unwrap_or(0);
+                counts.0[idx] += n;
+            }
+        }
+    }
+    counts.trace()
+}
+
+/// Keygen, fill the `Range16` table (last AIR), prove and verify.
+pub fn prove_verify_range(
+    params: SystemParams,
+    airs: Vec<AirRef<SC>>,
+    mut traces: Vec<RowMajorMatrix<F>>,
+) -> (Outcome, MultiStarkVerifyingKey<SC>) {
+    let engine = Engine::new(params);
+    let (pk, vk) = engine.keygen(&airs);
+    assert_eq!(traces.len() + 1, airs.len());
+    traces.push(range_trace(&pk, &airs, &traces));
+    (prove_verify_keyed(&engine, &pk, &vk, traces), vk)
+}
+
+/// Prove and verify under an existing key.
+pub fn prove_verify_keyed(
+    engine: &Engine,
+    pk: &MultiStarkProvingKey<SC>,
+    vk: &MultiStarkVerifyingKey<SC>,
+    traces: Vec<RowMajorMatrix<F>>,
+) -> Outcome {
+    let d_pk = engine.device().transport_pk_to_device(pk);
+    let res = catch_unwind(AssertUnwindSafe(|| {
+        let ctx = ProvingContext::new(
+            traces
+                .iter()
+                .enumerate()
+                .map(|(i, t)| {
+                    let cm = ColMajorMatrix::from_row_major(t);
+                    (
+                        i,
+                        AirProvingContext::simple_no_pis(
+                            engine.device().transport_matrix_to_device(&cm),
+                        ),
+                    )
+                })
+                .collect(),
+        );
+        engine.prove(&d_pk, ctx)
+    }));
+    let proof = match res {
+        Err(e) => {
+            let msg = e
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_default();
+            return Outcome::ProverRefused(msg);
+        }
+        Ok(Err(e)) => return Outcome::ProverRefused(format!("{e:?}")),
+        Ok(Ok(p)) => p,
+    };
+    match engine.verify(vk, &proof) {
+        Ok(()) => Outcome::Accepted(proof.encode_to_vec().map(|b| b.len()).unwrap_or(0)),
+        Err(e) => Outcome::VerifierRefused(format!("{e:?}")),
+    }
+}
