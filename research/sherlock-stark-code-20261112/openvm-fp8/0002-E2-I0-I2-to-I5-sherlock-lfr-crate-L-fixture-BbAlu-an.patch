index 0000000000000000000000000000000000000000..2f6721fb7b819e554c7487088a02a8568daccb37
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i2_alu.rs
@@ -0,0 +1,197 @@
+//! I2 gate: `BbAlu` and `Range16` (BabyBear and `EF4` arithmetic emulated in Fr) prove and
+//! verify at the small Fr set with the stock verifier; the results equal p3 BabyBear and `EF4`;
+//! five invalid witnesses are refused.
+
+#![allow(clippy::needless_range_loop)]
+
+use std::sync::Arc;
+
+use openvm_stark_backend::AirRef;
+use p3_baby_bear::BabyBear;
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use sherlock_lfr::{
+    alu::{alu_trace, AluKind, AluOp, AluRow, BbAluAir, ALU_WIDTH},
+    bb::{from_ef4, to_ef4, P},
+    range::{Range16Air, RangeCounts},
+    testing::{prove_verify, small_params, Outcome, SC},
+};
+
+fn airs() -> Vec<AirRef<SC>> {
+    vec![Arc::new(BbAluAir), Arc::new(Range16Air)]
+}
+
+fn run(rows: &[AluRow]) -> Outcome {
+    let mut counts = RangeCounts::default();
+    let alu = alu_trace(rows, &mut counts);
+    prove_verify(small_params(3), airs(), vec![alu, counts.trace()])
+}
+
+fn ops(n: usize) -> Vec<AluOp> {
+    let mut rng = StdRng::seed_from_u64(0xe2_a1);
+    let mut v = vec![
+        // Edge cases: results p - 1 (the is_max branch), 0, and maximal inputs.
+        AluOp {
+            kind: AluKind::Add,
+            a: [P - 1, 0, 0, 0],
+            b: [0; 4],
+        },
+        AluOp {
+            kind: AluKind::Sub,
+            a: [0; 4],
+            b: [1, 0, 0, 0],
+        },
+        AluOp {
+            kind: AluKind::Add,
+            a: [P - 1; 4],
+            b: [1; 4],
+        },
+        AluOp {
+            kind: AluKind::Mul,
+            a: [P - 1; 4],
+            b: [P - 1; 4],
+        },
+        AluOp {
+            kind: AluKind::Sub,
+            a: [5; 4],
+            b: [5; 4],
+        },
+        AluOp {
+            kind: AluKind::Mul,
+            a: [0; 4],
+            b: [P - 1; 4],
+        },
+    ];
+    for i in 0..n {
+        let kind = [AluKind::Add, AluKind::Sub, AluKind::Mul][i % 3];
+        let bb_only = i % 4 == 0;
+        let mut g = || -> [u64; 4] {
+            std::array::from_fn(|k| {
+                if bb_only && k > 0 {
+                    0
+                } else {
+                    rng.random_range(0..P)
+                }
+            })
+        };
+        let (a, b) = (g(), g());
+        v.push(AluOp { kind, a, b });
+    }
+    v
+}
+
+#[test]
+fn i2_alu_results_equal_p3() {
+    for op in ops(3000) {
+        let (a, b) = (to_ef4(&op.a), to_ef4(&op.b));
+        let want = match op.kind {
+            AluKind::Add => a + b,
+            AluKind::Sub => a - b,
+            AluKind::Mul => a * b,
+        };
+        assert_eq!(op.result(), from_ef4(want), "{op:?}");
+        let row = AluRow::from_op(&op);
+        assert_eq!(row.c, op.result());
+        // BabyBear-only ops stay in the base field.
+        if op.a[1..] == [0; 3] && op.b[1..] == [0; 3] {
+            let (x, y) = (BabyBear::from_u64(op.a[0]), BabyBear::from_u64(op.b[0]));
+            let w = match op.kind {
+                AluKind::Add => x + y,
+                AluKind::Sub => x - y,
+                AluKind::Mul => x * y,
+            };
+            assert_eq!(from_ef4(to_ef4(&[0; 4]) + w)[0], op.result()[0]);
+            assert_eq!(op.result()[1..], [0; 3]);
+        }
+    }
+}
+
+#[test]
+fn i2_alu_honest_proves() {
+    let ops = ops(500);
+    let rows: Vec<AluRow> = ops.iter().map(AluRow::from_op).collect();
+    let out = run(&rows);
+    println!(
+        "I2 honest: {} ops ({} rows padded, {ALU_WIDTH} columns, 24 lookups per row): {out:?}",
+        rows.len(),
+        rows.len().next_power_of_two()
+    );
+    assert!(out.accepted(), "honest ALU trace refused: {out:?}");
+}
+
+/// The first mul row with `q_0 >= 1` and `c_0 + p < 2^31` (so `c_0 + p` has 16-bit limbs).
+fn pick(rows: &[AluRow]) -> usize {
+    rows.iter()
+        .position(|r| {
+            let q = r.ql[0][0] + (r.ql[0][1] << 16) + (r.ql[0][2] << 32);
+            r.sel[2] == 1 && q >= 1 && r.c[0] + P < (1 << 31) && r.hi[0] >= 1
+        })
+        .expect("a row for the negative controls")
+}
+
+fn set_c(r: &mut AluRow, k: usize, c: u64) {
+    r.c[k] = c;
+    r.lo[k] = c & 0xffff;
+    r.hi[k] = c >> 16;
+}
+
+fn set_q(r: &mut AluRow, k: usize, q: u64) {
+    r.ql[k] = [q & 0xffff, (q >> 16) & 0xffff, q >> 32];
+}
+
+fn q_of(r: &AluRow, k: usize) -> u64 {
+    r.ql[k][0] + (r.ql[k][1] << 16) + (r.ql[k][2] << 32)
+}
+
+#[test]
+fn i2_alu_negative_controls() {
+    let ops = ops(200);
+    let honest: Vec<AluRow> = ops.iter().map(AluRow::from_op).collect();
+    let i = pick(&honest);
+    let mut cases: Vec<(&str, Vec<AluRow>)> = vec![];
+
+    // 1. Non-canonical result c + p with q - 1: the integer identity holds, hi > 0x7800.
+    let mut r = honest.clone();
+    let (c, q) = (r[i].c[0], q_of(&r[i], 0));
+    set_c(&mut r[i], 0, c + P);
+    set_q(&mut r[i], 0, q - 1);
+    cases.push(("non-canonical c + p", r));
+
+    // 2. Wrong quotient q + 1.
+    let mut r = honest.clone();
+    set_q(&mut r[i], 0, q + 1);
+    cases.push(("wrong quotient", r));
+
+    // 3. Wrong result c + 1 (limbs consistent with it).
+    let mut r = honest.clone();
+    set_c(&mut r[i], 0, (c + 1) % P);
+    cases.push(("wrong result", r));
+
+    // 4. Limb out of range: lo + 2^16, hi - 1 (same c, so every identity holds).
+    let mut r = honest.clone();
+    r[i].lo[0] += 1 << 16;
+    r[i].hi[0] -= 1;
+    cases.push(("limb out of range", r));
+
+    // 5. The value p itself as a result: add(p - 1, 1) honestly gives q = 1, c = 0; the witness
+    // q = 0, c = p = 0x7800_0001 has 16-bit limbs (hi = 0x7800, lo = 1) and is refused only by
+    // the hi = 0x7800 -> lo = 0 rule.
+    let mut r = honest.clone();
+    r.push(AluRow::from_op(&AluOp {
+        kind: AluKind::Add,
+        a: [P - 1, 0, 0, 0],
+        b: [1, 0, 0, 0],
+    }));
+    let j = r.len() - 1;
+    assert_eq!((r[j].c[0], q_of(&r[j], 0)), (0, 1));
+    set_c(&mut r[j], 0, P);
+    set_q(&mut r[j], 0, 0);
+    assert_eq!((r[j].hi[0], r[j].lo[0]), (0x7800, 1));
+    cases.push(("c = p with 16-bit limbs", r));
+
+    for (name, rows) in cases {
+        let out = run(&rows);
+        println!("I2 negative {name}: {out:?}");
+        assert!(!out.accepted(), "{name} accepted");
+    }
+}
diff --git a/crates/sherlock-lfr/tests/i3_poseidon.rs b/crates/sherlock-lfr/tests/i3_poseidon.rs
