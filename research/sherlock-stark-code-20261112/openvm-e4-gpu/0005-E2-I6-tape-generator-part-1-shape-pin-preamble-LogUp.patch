+//! A recording wrapper around the stock `L` transcript: it logs every observe, commitment
+//! observe and sample while the stock verifier runs. The log is the reference for the tape.
+
+use std::sync::{Arc, Mutex};
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey, proof::Proof, verifier::verify, FiatShamirTranscript,
+    StarkEngine,
+};
+use openvm_stark_sdk::config::baby_bear_bls12381_poseidon::{
+    default_transcript, BabyBearBls12381PoseidonCpuEngine, Bls12381Fr, Transcript,
+};
+use p3_baby_bear::BabyBear;
+
+use crate::fixture::{l_ud, LSC};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ev {
+    Obs(BabyBear),
+    Commit(Bls12381Fr),
+    Sample(BabyBear),
+}
+
+#[derive(Clone)]
+pub struct Rec {
+    pub inner: Transcript,
+    pub log: Arc<Mutex<Vec<Ev>>>,
+}
+
+impl FiatShamirTranscript<LSC> for Rec {
+    fn observe(&mut self, v: BabyBear) {
+        self.log.lock().unwrap().push(Ev::Obs(v));
+        FiatShamirTranscript::<LSC>::observe(&mut self.inner, v);
+    }
+    fn sample(&mut self) -> BabyBear {
+        let v = FiatShamirTranscript::<LSC>::sample(&mut self.inner);
+        self.log.lock().unwrap().push(Ev::Sample(v));
+        v
+    }
+    fn observe_commit(&mut self, d: [Bls12381Fr; 1]) {
+        self.log.lock().unwrap().push(Ev::Commit(d[0]));
+        FiatShamirTranscript::<LSC>::observe_commit(&mut self.inner, d);
+    }
+}
+
+/// The stock verifier's transcript events on an `L` proof, and its verdict.
+pub fn stock_log(vk: &MultiStarkVerifyingKey<LSC>, proof: &Proof<LSC>) -> (Vec<Ev>, bool) {
+    let engine = BabyBearBls12381PoseidonCpuEngine::new(l_ud(48));
+    let mut rec = Rec {
+        inner: default_transcript(),
+        log: Default::default(),
+    };
+    let ok = verify(engine.config(), vk, proof, &mut rec).is_ok();
+    let log = rec.log.lock().unwrap().clone();
+    (log, ok)
+}
