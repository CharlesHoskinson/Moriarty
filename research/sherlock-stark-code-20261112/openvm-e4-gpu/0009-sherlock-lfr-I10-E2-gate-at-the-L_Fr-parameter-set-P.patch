@@ -0,0 +1,253 @@
+//! I10, the E2 gate: the whole `L` verifier tape of the real `L` proof, with the `L_Fr` public
+//! values of D-2 (the `L` vk pre-hash; the bench `L` has no public values), proved at the
+//! `L_Fr` parameter set (`testing::lfr_params`) and accepted by the stock verifier, with 2
+//! commitments. Refused: a changed public word and a changed byte of the encoded `L` proof.
+//! Heights MEASURED; the D3 soundness terms at the measured `L_Fr` key
+//! (`SoundnessCalculator::calculate_from_vk`). Ignored by default: needs the fixture and about
+//! an hour of CPU.
+//!
+//! `i10_public_air_small` checks `PublicAir` on a small tape at the small test set.
+
+use std::time::Instant;
+
+use openvm_stark_backend::{
+    codec::{Decode, Encode},
+    soundness::SoundnessCalculator,
+    StarkEngine,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::Bls12381Fr as Fr;
+use p3_field::PrimeCharacteristicRing;
+use sherlock_lfr::{
+    fixture::{self, LSC},
+    lverify::{gen_verifier, Gen, LShape},
+    machine::Machine,
+    record::stock_log,
+    tape::{Op, Tape, Val},
+    testing::{
+        lfr_params, preprocessed_airs, prove_verify_range_keyed, small_params, Engine, Outcome,
+    },
+};
+
+type LProof = openvm_stark_backend::proof::Proof<LSC>;
+type LVk = openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>;
+
+/// The tape of the whole `L` verifier with the D-2 public words exposed.
+fn build(vk: &LVk, shape: &LShape, proof: &LProof) -> Result<Gen, String> {
+    let mut g = Gen::new();
+    let words = gen_verifier(&mut g, vk, shape, proof).map_err(|e| format!("{e:?}"))?;
+    for w in words {
+        g.tape.public(w);
+    }
+    Ok(g)
+}
+
+/// Keygen at `params`, then prove and verify the honest witness and the changed public word.
+fn public_controls(
+    params: openvm_stark_backend::SystemParams,
+    m: &Machine,
+    mem: &[Option<Val>],
+) -> (Outcome, Outcome) {
+    let engine = Engine::new(params);
+    let airs = m.airs();
+    let (pk, vk) = engine.keygen(&airs);
+    let pis = m.public_values(mem);
+    let honest = prove_verify_range_keyed(&engine, &pk, &vk, &airs, m.traces(mem), pis.clone());
+    let mut bad = pis;
+    let i = m.names().iter().position(|&n| n == "Public").unwrap();
+    bad[i][0] += Fr::ONE;
+    let changed = prove_verify_range_keyed(&engine, &pk, &vk, &airs, m.traces(mem), bad);
+    (honest, changed)
+}
+
+#[test]
+fn i10_public_air_small() {
+    let mut t = Tape::default();
+    let a = t.fr_const(Fr::from_u64(7));
+    let b = t.fr_input();
+    let c = t.fr_add(a, b);
+    t.public(c);
+    t.public(a);
+    let (mem, failed) = t.execute_checked(&[Val::Fr(Fr::from_u64(5))]);
+    assert!(failed.is_empty());
+    let m = Machine::new(&t);
+    assert_eq!(
+        m.public_values(&mem).concat(),
+        vec![Fr::from_u64(12), Fr::from_u64(7)]
+    );
+    let (honest, changed) = public_controls(small_params(3), &m, &mem);
+    println!("I10 small PublicAir: honest {honest:?}; changed public word {changed:?}");
+    assert!(honest.accepted());
+    assert_eq!(honest.commits(), Some(2));
+    assert!(!changed.accepted());
+}
