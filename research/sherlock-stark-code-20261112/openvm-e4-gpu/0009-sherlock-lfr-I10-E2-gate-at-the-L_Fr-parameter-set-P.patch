 /// The whole `L` verifier on the tape (parts 1 to 4).
+/// The whole `L` verifier on the tape (parts 1 to 4). Returns the addresses of the public words
+/// of `L_Fr` (D-2): the `L` vk pre-hash, then the public values of `L` packed 8 BabyBear words
+/// per Fr word (in vk order). The caller exposes them with [`crate::tape::Tape::public`].
 pub fn gen_verifier(
     g: &mut Gen,
     vk: &MultiStarkVerifyingKey<LSC>,
     shape: &LShape,
     proof: &Proof<LSC>,
-) -> Result<(), ShapeError> {
+) -> Result<Vec<Addr>, ShapeError> {
     let p1 = gen_part1(g, vk, shape, proof)?;
     let p2 = gen_part2(g, vk, shape, proof, &p1)?;
     let p3 = gen_part3(g, vk, shape, proof, &p1, &p2)?;
-    gen_part4(g, vk, proof, &p3)
+    gen_part4(g, vk, proof, &p3)?;
