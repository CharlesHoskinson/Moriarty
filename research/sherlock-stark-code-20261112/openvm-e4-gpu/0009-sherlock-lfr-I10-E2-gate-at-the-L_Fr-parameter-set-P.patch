+// ------------------------------------------------------------------------------------------
+// PublicAir (D-2): the public values of the machine. One active row: program
+// [addr_0, .., addr_{P-1}, active]; main [v_0, .., v_{P-1}]. Reads (addr_i, v_i) and constrains
+// `active (v_i - pv_i) = 0`, so public value `i` equals the Fr value at `addr_i` of the tape.
+// The padding row (the nop row of the table: every cell 0) reads nothing.
+// ------------------------------------------------------------------------------------------
+
+/// Most public words of one `PublicAir` row (the program cells of one row, `PROG_W`, less the
+/// `active` cell).
+pub const PUBLIC_MAX: usize = crate::program::PROG_W - 1;
+
+#[derive(Clone, Debug)]
+pub struct PublicAir {
+    pub addrs: Arc<Vec<Addr>>,
+}
+
+impl PublicAir {
+    fn n(&self) -> usize {
+        self.addrs.len()
+    }
+    pub fn prog_rows(&self) -> Vec<Vec<Fr>> {
+        let mut r: Vec<Fr> = self.addrs.iter().map(|&a| fu(a as u64)).collect();
+        r.push(Fr::ONE);
+        vec![r]
+    }
+    pub fn trace(&self, mem: &[Option<Val>]) -> RowMajorMatrix<Fr> {
+        let row: Vec<Fr> = self.addrs.iter().map(|&a| get(mem, a).fr()).collect();
+        let main = rows_to_matrix(vec![row], 1, self.n(), vec![Fr::ZERO; self.n()]);
+        crate::program::with_prog(main, &self.prog_rows(), self.n() + 1)
+    }
+    /// The public values of the honest witness.
+    pub fn values(&self, mem: &[Option<Val>]) -> Vec<Fr> {
+        self.addrs.iter().map(|&a| get(mem, a).fr()).collect()
+    }
+}
+
+impl BaseAir<Fr> for PublicAir {
+    fn width(&self) -> usize {
+        2 * self.n() + 1
+    }
+}
+impl BaseAirWithPublicValues<Fr> for PublicAir {
+    fn num_public_values(&self) -> usize {
+        self.n()
+    }
+}
+impl PartitionedBaseAir<Fr> for PublicAir {}
+
+impl<AB: InteractionBuilder<F = Fr> + AirBuilderWithPublicValues> Air<AB> for PublicAir {
+    fn eval(&self, builder: &mut AB) {
+        let n = self.n();
+        let (v, p) = split_row(builder, TAG_PUBLIC, n, n + 1);
+        let pv: Vec<AB::Expr> = builder.public_values().iter().map(|&x| x.into()).collect();
+        for i in 0..n {
+            builder.assert_zero(p[n].clone() * (v[i].clone() - pv[i].clone()));
+            builder.push_interaction(
+                MEM_BUS,
+                mem_msg(p[i].clone(), &[v[i].clone()]),
+                -p[n].clone(),
+                1,
+            );
+        }
+    }
+}
