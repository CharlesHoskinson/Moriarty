+/// `lfr_params()`, or with `E4_LOG_BLOWUP` = 2 or 1 the same set at that log blowup with the
+/// smallest query vector whose query terms are at least 101 bits by D3 (M7 RESULTS 2b.2:
+/// 120/85/82 at 2, 196/89/82 at 1). For the owner options of E4 (prover time only).
+fn params() -> openvm_stark_backend::SystemParams {
+    let lb: usize = std::env::var("E4_LOG_BLOWUP").ok().and_then(|v| v.parse().ok()).unwrap_or(3);
+    if lb == 3 {
+        return lfr_params();
+    }
+    let q: [usize; 3] = match lb {
+        2 => [120, 85, 82],
+        1 => [196, 89, 82],
+        _ => panic!("E4_LOG_BLOWUP must be 1, 2 or 3"),
+    };
+    let mut p = openvm_stark_sdk::config::params_with_100_bits_security(
+        lb,
+        2,
+        18,
+        48,
+        0,
+        0,
+        openvm_stark_backend::WhirProximityStrategy::UniqueDecoding,
+        4,
+        20,
+        4,
+    );
+    assert_eq!(p.whir.rounds.len(), 3);
+    for (r, n) in p.whir.rounds.iter_mut().zip(q) {
+        r.num_queries = n;
+    }
+    p.logup.pow_bits = 0;
+    println!("E4 log blowup {lb}, queries {q:?}");
+    p
+}
+
