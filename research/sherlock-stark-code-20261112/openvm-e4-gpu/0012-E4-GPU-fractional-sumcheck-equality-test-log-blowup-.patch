new file mode 100644
index 0000000..797dc92
--- /dev/null
+++ b/crates/sherlock-lfr/tests/e4_gpu_frac.rs
@@ -0,0 +1,59 @@
+//! E4: the GPU fractional sumcheck (mori-gpu `frac`, stark-sdk `FracGpu`) gives the same
+//! proof, point and transcript state as the CPU `fractional_sumcheck` (`E4_GPU_FRAC=0`).
+#![cfg(feature = "gpu")]
+
+use std::time::Instant;
+
+use openvm_stark_backend::{
+    prover::fractional_sumcheck_gkr::{fractional_sumcheck, Frac},
+    FiatShamirTranscript,
+};
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    Bls12381Fr as Fr, Bls12381FrPoseidonConfig as SC, MidnightPoseidonFr, Transcript,
+};
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+
+fn rand_fr(rng: &mut StdRng) -> Fr {
+    let a = Fr::from_u128(rng.random::<u128>());
+    let b = Fr::from_u128(rng.random::<u128>());
+    a * Fr::from_u128(1u128 << 127) * Fr::TWO + b
+}
+
+type Out = (Vec<String>, Vec<Fr>, Fr);
+
+fn run(evals: &[Frac<Fr>]) -> Out {
+    let mut ts = Transcript::from(MidnightPoseidonFr::new());
+    let (proof, xi) = fractional_sumcheck::<SC, _>(&mut ts, evals, false).expect("sumcheck");
+    let mut v = vec![format!("{:?}", proof.fractional_sum)];
+    v.extend(proof.claims_per_layer.iter().map(|c| format!("{c:?}")));
+    v.extend(proof.sumcheck_polys.iter().map(|p| format!("{p:?}")));
+    let next = FiatShamirTranscript::<SC>::sample_ext(&mut ts);
+    (v, xi, next)
+}
+
+#[test]
+fn e4_gpu_frac_sumcheck_equals_cpu() {
+    let mut rng = StdRng::seed_from_u64(0xe4f);
+    // 2^12 is the smallest size on the GPU; 2^13 and 2^17 run several GPU layers.
+    for lg in [12usize, 13, 17] {
+        let evals: Vec<Frac<Fr>> = (0..1usize << lg)
+            .map(|_| Frac::new(rand_fr(&mut rng), rand_fr(&mut rng)))
+            .collect();
+        std::env::set_var("E4_GPU_FRAC", "0");
+        let t = Instant::now();
+        let cpu = run(&evals);
+        let tc = t.elapsed().as_secs_f64();
+        std::env::remove_var("E4_GPU_FRAC");
+        let t = Instant::now();
+        let gpu = run(&evals);
+        let tg = t.elapsed().as_secs_f64();
+        assert_eq!(cpu.0.len(), gpu.0.len());
+        for (i, (a, b)) in cpu.0.iter().zip(&gpu.0).enumerate() {
+            assert_eq!(a, b, "2^{lg}: proof item {i} differs");
+        }
+        assert_eq!(cpu.1, gpu.1, "2^{lg}: point differs");
+        assert_eq!(cpu.2, gpu.2, "2^{lg}: transcript state differs");
+        println!("E4 frac 2^{lg}: equal, cpu {tc:.3}s gpu {tg:.3}s");
+    }
+}
