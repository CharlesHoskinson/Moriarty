index 0000000..be8f4b7
--- /dev/null
+++ b/crates/sherlock-lfr/tests/i8_part3.rs
@@ -0,0 +1,150 @@
+//! I8 gate: the tape generator, parts 1 to 3 (part 3: the stacked reduction: lambda, the
+//! univariate and `n_stack` quadratic sumcheck rounds, the eq, rotation-kernel and indicator
+//! terms of every stacked column, the stacking openings and the final sum check) on the real `L`
+//! proof. Every value the tape observes or samples equals the stock verifier's transcript record,
+//! in order, up to the end of `verify_stacked_reduction`. No tape assertion fails. Op counts and
+//! the machine shape are printed (MEASURED); the tape proves on the machine with 2 commitments
+//! at `small_params_n(3, 15)` (stacked height 2^17). Refused: a changed stacking opening and a
+//! changed stacking sumcheck evaluation (by the stock verifier, the plain-Rust tape run, and the
+//! prover). Ignored by default: needs the fixture.
+
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+use sherlock_lfr::{
+    bb::Ef4,
+    fixture::{self, LSC},
+    lverify::{gen_part1, gen_part2, gen_part3, Gen, LShape},
+    machine::Machine,
+    record::{stock_log, Ev},
+    tape::Op,
+    testing::{preprocessed_airs, prove_verify_range, small_params_n, Outcome},
+    transcript::TEv,
+};
+
+type LProof = openvm_stark_backend::proof::Proof<LSC>;
+
+fn build(
+    vk: &openvm_stark_backend::keygen::types::MultiStarkVerifyingKey<LSC>,
+    shape: &LShape,
+    proof: &LProof,
+) -> Gen {
+    let mut g = Gen::new();
+    let p1 = gen_part1(&mut g, vk, shape, proof).expect("pinned shape");
+    let p2 = gen_part2(&mut g, vk, shape, proof, &p1).expect("pinned shape");
+    gen_part3(&mut g, vk, shape, proof, &p1, &p2).expect("pinned shape");
+    g
+}
+
+fn prove(g: &Gen, mem: &[Option<sherlock_lfr::tape::Val>]) -> Outcome {
+    let m = Machine::new(&g.tape);
+    let (o, vk) = prove_verify_range(small_params_n(3, 15), m.airs(), m.traces(mem));
+    assert_eq!(
+        preprocessed_airs(&vk),
+        1,
+        "only the program table is preprocessed"
+    );
+    o
+}
+
+#[test]
+#[ignore = "needs the L fixture on disk"]
+fn i8_part3_on_real_l() {
+    let fx = fixture::load(&fixture::dir()).expect("fixture");
+    let (log, ok) = stock_log(&fx.l_vk, &fx.l_proof);
+    assert!(ok, "stock verifier accepts L");
+    let shape = LShape::of(&fx.l_proof);
+    let g = build(&fx.l_vk, &shape, &fx.l_proof);
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty(), "tape assertions failed: {failed:?}");
+
+    // Every event equals the stock record, in order.
+    let bb = |a: u32| mem[a as usize].unwrap().bb();
+    let (mut n_obs, mut n_commit, mut n_sample) = (0, 0, 0);
+    assert!(g.tt.log.len() < log.len());
+    for (i, (t, s)) in g.tt.log.iter().zip(&log).enumerate() {
+        match (t, s) {
+            (TEv::Obs(a), Ev::Obs(v)) => {
+                assert_eq!(
+                    bb(*a),
+                    [v.as_canonical_u32() as u64, 0, 0, 0],
+                    "observe {i}"
+                );
+                n_obs += 1;
+            }
+            (TEv::Commit(a), Ev::Commit(v)) => {
+                assert_eq!(mem[*a as usize].unwrap().fr(), *v, "commit {i}");
+                n_commit += 1;
+            }
+            (TEv::Sample(a), Ev::Sample(v)) => {
+                assert_eq!(bb(*a), [v.as_canonical_u32() as u64, 0, 0, 0], "sample {i}");
+                n_sample += 1;
+            }
+            _ => panic!("event {i}: kind differs: tape {t:?}, stock {s:?}"),
+        }
+    }
+    let dag_nodes: usize = fx
+        .l_vk
+        .inner
+        .per_air
+        .iter()
+        .map(|a| a.symbolic_constraints.constraints.nodes.len())
+        .sum();
+    println!("I8 L DAG nodes (all 39 AIRs): {dag_nodes}");
+
+    let count = |f: fn(&Op) -> bool| g.tape.ops.iter().filter(|o| f(o)).count();
+    let m = Machine::new(&g.tape);
+    println!(
+        "I8 parts 1 to 3: {} events equal the stock record ({n_obs} observes, {n_commit} commitment observes, {n_sample} samples) of {} in one L verification; ops: {} total, {} Input, {} FrInput, {} Const/FrConst, {} Alu, {} Perm, {} Pack, {} Split, {} Compose, {} Decompose, {} AssertEq, {} LowBits; table rows {}; machine shape {:?}",
+        g.tt.log.len(),
+        log.len(),
+        g.tape.ops.len(),
+        count(|o| matches!(o, Op::Input { .. })),
+        count(|o| matches!(o, Op::FrInput { .. })),
+        count(|o| matches!(o, Op::Const { .. } | Op::FrConst { .. })),
+        count(|o| matches!(o, Op::Alu { .. })),
+        count(|o| matches!(o, Op::Perm { .. })),
+        count(|o| matches!(o, Op::Pack { .. })),
+        count(|o| matches!(o, Op::Split { .. })),
+        count(|o| matches!(o, Op::Compose { .. })),
+        count(|o| matches!(o, Op::Decompose { .. })),
+        count(|o| matches!(o, Op::AssertEq { .. })),
+        count(|o| matches!(o, Op::LowBits { .. })),
+        m.table().rows.len(),
+        m.shape()
+    );
+    let t = std::time::Instant::now();
+    let o = prove(&g, &mem);
+    println!(
+        "I8 prove and verify {:.1}s: {o:?}",
+        t.elapsed().as_secs_f64()
+    );
+    assert!(o.accepted(), "honest part 1 refused: {o:?}");
+    assert_eq!(o.commits(), Some(2));
+
+    // Negative controls: the same key (shape and vk), changed proof values.
+    let mut p1 = fx.l_proof.clone();
+    p1.stacking_proof.stacking_openings[0][5] += Ef4::ONE;
+    let mut p2 = fx.l_proof.clone();
+    p2.stacking_proof.sumcheck_round_polys[4][1] += Ef4::ONE;
+    for (name, p) in [
+        ("changed stacking opening", p1),
+        ("changed stacking sumcheck evaluation", p2),
+    ] {
+        let (_, stock_ok) = stock_log(&fx.l_vk, &p);
+        let gt = build(&fx.l_vk, &shape, &p);
+        assert_eq!(
+            format!("{:?}", gt.tape.ops),
+            format!("{:?}", g.tape.ops),
+            "same tape (the key)"
+        );
+        let (mem_t, failed_t) = gt.tape.execute_checked(&gt.inputs);
+        let o = prove(&gt, &mem_t);
+        println!(
+            "I8 negative {name}: stock verifier accepts {stock_ok}; tape assertions failed at {} ops (first {:?}); prover: {o:?}",
+            failed_t.len(),
+            failed_t.first()
+        );
+        assert!(!stock_ok);
+        assert!(!failed_t.is_empty());
+        assert!(!o.accepted(), "{name} accepted");
+    }
+}
