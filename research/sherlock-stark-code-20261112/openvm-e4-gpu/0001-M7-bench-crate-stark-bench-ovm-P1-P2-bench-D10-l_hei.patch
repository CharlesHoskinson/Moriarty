+// ---------------------------------------------------------------------------
+// leaf proving (generic over CPU / GPU engine)
+// ---------------------------------------------------------------------------
+
+struct LeafOut {
+    json: Value,
+    vk: MultiStarkVerifyingKey<SC>,
+    proofs: Vec<Proof<SC>>,
+}
+
+/// Per-engine knobs. GPU: `SB_ZC_SAVE=0|1` overrides `zerocheck_save_memory` (default in
+/// stark-backend: true when log_blowup == 1, i.e. for app params).
+trait Tune {
+    fn tune(&mut self) -> Value;
+}
+impl Tune for BabyBearPoseidon2CpuEngine<DuplexSponge> {
+    fn tune(&mut self) -> Value {
+        json!(null)
+    }
+}
+#[cfg(feature = "cuda")]
+impl Tune for openvm_cuda_backend::BabyBearPoseidon2GpuEngine {
+    fn tune(&mut self) -> Value {
+        let cfg = self.device_mut().prover_config_mut();
+        if let Ok(v) = std::env::var("SB_ZC_SAVE") {
+            cfg.zerocheck_save_memory = v == "1";
+        }
+        json!({"zerocheck_save_memory": cfg.zerocheck_save_memory,
+               "cache_stacked_matrix": cfg.cache_stacked_matrix,
+               "cache_rs_code_matrix": cfg.cache_rs_code_matrix})
+    }
+}
+
+fn prove_leaf<E: StarkEngine<SC = SC> + Tune>(
+    params: SystemParams,
+    airs: Vec<AirRef<SC>>,
+    traces: Vec<RowMajorMatrix<F>>,
+    reps: usize,
+    keep_proofs: usize,
+) -> LeafOut {
+    let mut engine = E::new(params.clone());
+    let tune = engine.tune();
+    let t = Instant::now();
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let keygen_s = t.elapsed().as_secs_f64();
+
+    let cells: usize = traces.iter().map(|m| Matrix::height(m) * Matrix::width(m)).sum();
+    let shapes: Vec<(usize, usize)> = traces.iter().map(|m| (Matrix::height(m), Matrix::width(m))).collect();
+    let cm: Vec<ColMajorMatrix<F>> = traces
+        .iter()
+        .map(ColMajorMatrix::from_row_major)
+        .collect();
+    drop(traces);
+
+    let mut prove_s = vec![];
+    let mut transport_s = vec![];
+    let mut avg_cores = vec![];
+    let mut gpu_rise = vec![];
+    let mut proofs = vec![];
+    let mut proof_bytes = 0usize;
+    let mut verify_s = 0.0;
+    for rep in 0..reps {
+        let t = Instant::now();
+        let ctx = ProvingContext::new(
+            cm.iter()
+                .enumerate()
+                .map(|(i, m)| {
+                    (
+                        i,
+                        AirProvingContext::simple_no_pis(
+                            engine.device().transport_matrix_to_device(m),
+                        ),
+                    )
+                })
+                .collect(),
+        );
+        transport_s.push(t.elapsed().as_secs_f64());
+        let sampler = GpuSampler::start();
+        let (c0, _) = rusage();
+        let t = Instant::now();
+        let proof = engine.prove(&d_pk, ctx).expect("prove");
+        let dt = t.elapsed().as_secs_f64();
+        let (c1, _) = rusage();
+        let (base, peak) = sampler.finish();
+        gpu_rise.push(peak.saturating_sub(base));
+        prove_s.push(dt);
+        avg_cores.push((c1 - c0) / dt);
+        eprintln!("rep {rep}: prove {dt:.3}s");
+        if rep == 0 {
+            let t = Instant::now();
+            engine.verify(&vk, &proof).expect("verify");
+            verify_s = t.elapsed().as_secs_f64();
+            proof_bytes = proof.encode_to_vec().expect("encode").len();
+        }
+        if proofs.len() < keep_proofs {
+            proofs.push(proof);
+        }
+    }
+    // reps > 1: rep 0 is the warmup, the median is over the rest.
+    let timed: Vec<f64> = if prove_s.len() > 1 {
+        prove_s[1..].to_vec()
+    } else {
+        prove_s.clone()
+    };
+    let med = median(&timed);
+    let (_, maxrss) = rusage();
+    LeafOut {
+        json: json!({
+            "keygen_s": keygen_s,
+            "transport_s": transport_s,
+            "prove_s": prove_s,
+            "prove_median_s": med,
+            "avg_cores": avg_cores,
+            "verify_s": verify_s,
+            "proof_bytes": proof_bytes,
+            "trace_shapes": shapes,
+            "main_cells": cells,
+            "cells_per_s": cells as f64 / med,
+            "gpu_mem_rise_bytes": gpu_rise,
+            "peak_rss_kb": maxrss,
+            "params": params_json(&params),
+            "num_airs_in_vk": airs.len(),
+            "gpu_prover_config": tune,
+            "num_airs_traced": cm.len(),
+        }),
+        vk,
+        proofs,
+    }
+}
+
+// ---------------------------------------------------------------------------
+// node: VerifierSubCircuit::<N> over N child W1 proofs
+// ---------------------------------------------------------------------------
+
+fn prove_node<E: Tune, const N: usize>(
+    child_vk: &MultiStarkVerifyingKey<SC>,
+    proofs: &[Proof<SC>],
+    reps: usize,
+) -> Value
+where
+    E: StarkEngine<SC = SC>,
+    VerifierSubCircuit<N>: VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>> + AggregationSubCircuit,
+    <E::PB as openvm_stark_backend::prover::ProverBackend>::Matrix: Clone,
+{
+    assert_eq!(proofs.len(), N);
+    let params = leaf_params_with_100_bits_security();
+    let mut engine = E::new(params.clone());
+    let tune = engine.tune();
+    let t = Instant::now();
+    let circuit = <VerifierSubCircuit<N> as VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>>>::new(
+        Arc::new(child_vk.clone()),
+        Default::default(),
+    );
+    let child_pcs = circuit.commit_child_vk(&engine, child_vk);
+    let airs = circuit.airs::<SC>();
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let keygen_s = t.elapsed().as_secs_f64();
+
+    let mut tracegen_s = vec![];
+    let mut prove_s = vec![];
+    let mut avg_cores = vec![];
+    let mut gpu_rise = vec![];
+    let mut verify_s = 0.0;
+    let mut proof_bytes = 0usize;
+    let mut cells = 0usize;
+    let mut heights: Vec<(usize, usize, usize)> = vec![];
+    for rep in 0..reps {
+        let t = Instant::now();
+        let ctxs = circuit.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+            child_vk,
+            CachedTraceCtx::PcsData(child_pcs.clone()),
+            proofs,
+            engine.device().device_ctx(),
+            default_duplex_sponge_recorder(),
+        );
+        let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());
+        tracegen_s.push(t.elapsed().as_secs_f64());
+        if rep == 0 {
+            for (i, m) in ctx.common_main_traces() {
+                cells += m.height() * m.width();
+                heights.push((i, m.height(), m.width()));
+            }
+        }
+        let sampler = GpuSampler::start();
+        let (c0, _) = rusage();
+        let t = Instant::now();
+        let proof = engine.prove(&d_pk, ctx).expect("node prove");
+        let dt = t.elapsed().as_secs_f64();
+        let (c1, _) = rusage();
+        let (base, peak) = sampler.finish();
+        gpu_rise.push(peak.saturating_sub(base));
+        prove_s.push(dt);
+        avg_cores.push((c1 - c0) / dt);
+        eprintln!("node rep {rep}: tracegen {:.3}s prove {dt:.3}s", tracegen_s[rep]);
+        if rep == 0 {
+            let t = Instant::now();
+            engine.verify(&vk, &proof).expect("node verify");
+            verify_s = t.elapsed().as_secs_f64();
+            proof_bytes = proof.encode_to_vec().expect("encode").len();
+        }
+    }
+    let timed_p: Vec<f64> = if reps > 1 { prove_s[1..].to_vec() } else { prove_s.clone() };
+    let timed_t: Vec<f64> = if reps > 1 { tracegen_s[1..].to_vec() } else { tracegen_s.clone() };
+    let (_, maxrss) = rusage();
+    json!({
+        "arity": N,
+        "gpu_prover_config": tune,
+        "num_airs": airs.len(),
+        "keygen_s": keygen_s,
+        "tracegen_s": tracegen_s,
+        "tracegen_median_s": median(&timed_t),
+        "prove_s": prove_s,
+        "prove_median_s": median(&timed_p),
+        "node_median_s": median(&timed_p) + median(&timed_t),
+        "avg_cores": avg_cores,
+        "verify_s": verify_s,
+        "proof_bytes": proof_bytes,
+        "recursion_main_cells": cells,
+        "recursion_traces": heights,
+        "gpu_mem_rise_bytes": gpu_rise,
+        "peak_rss_kb": maxrss,
+        "params": params_json(&params),
+    })
+}
+
+// ---------------------------------------------------------------------------
+
+fn run<E: Tune, const N: usize>(workload: &str, log_rows: usize, reps: usize) -> Value
+where
+    E: StarkEngine<SC = SC>,
+    VerifierSubCircuit<N>: VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>> + AggregationSubCircuit,
+    <E::PB as openvm_stark_backend::prover::ProverBackend>::Matrix: Clone,
+{
+    let mut rng = StdRng::seed_from_u64(0x5e7_10c);
+    match workload {
+        "w1" | "w2" | "w3mul" | "w1gen" => {
+            let t = Instant::now();
+            let (airs, traces) = match workload {
+                "w1" => w1_traces(log_rows, &mut rng),
+                "w2" => w2_traces(log_rows, &mut rng),
+                "w1gen" => w1gen_traces(log_rows, &mut rng),
+                _ => w3_traces(log_rows),
+            };
+            let tracegen_s = t.elapsed().as_secs_f64();
+            let mut out = prove_leaf::<E>(app_params(), airs, traces, reps, 0).json;
+            out["tracegen_cpu_s"] = json!(tracegen_s);
+            out
+        }
+        "node" | "nodegen" => {
+            // N child W1 proofs with distinct inputs, proved on the same backend.
+            let mut proofs = vec![];
+            let mut vk = None;
+            let mut leaf_json = json!(null);
+            for i in 0..N {
+                let (airs, traces) = if workload == "node" {
+                    w1_traces(log_rows, &mut rng)
+                } else {
+                    w1gen_traces(log_rows, &mut rng)
+                };
+                let n_airs = airs.len();
+                let mut out = prove_leaf::<E>(app_params(), airs, traces, 1, 1);
+                out.json["child_num_airs"] = json!(n_airs);
+                if i == 0 {
+                    leaf_json = out.json;
+                }
+                vk = Some(out.vk);
+                proofs.extend(out.proofs);
+            }
+            let vk = vk.unwrap();
+            let mut node = prove_node::<E, N>(&vk, &proofs, reps);
+            node["child_leaf"] = leaf_json;
+            node
+        }
+        _ => panic!("unknown workload {workload}"),
+    }
+}
+
+fn dispatch<E: Tune>(workload: &str, log_rows: usize, reps: usize, arity: usize) -> Value
+where
+    E: StarkEngine<SC = SC>,
+    VerifierSubCircuit<2>: VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>> + AggregationSubCircuit,
+    VerifierSubCircuit<4>: VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>> + AggregationSubCircuit,
+    VerifierSubCircuit<8>: VerifierTraceGen<E::PB, SC, EngineDeviceCtx<E>> + AggregationSubCircuit,
+    <E::PB as openvm_stark_backend::prover::ProverBackend>::Matrix: Clone,
+{
+    match arity {
+        2 => run::<E, 2>(workload, log_rows, reps),
+        4 => run::<E, 4>(workload, log_rows, reps),
+        8 => run::<E, 8>(workload, log_rows, reps),
+        _ => panic!("arity must be 2, 4 or 8"),
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() < 5 {
+        eprintln!("usage: stark-bench-ovm <w1|w2|node> <cpu|gpu> <log_rows> <reps> [arity]");
+        std::process::exit(2);
+    }
+    let workload = args[1].as_str();
+    let backend = args[2].as_str();
+    let log_rows: usize = args[3].parse().unwrap();
+    let reps: usize = args[4].parse().unwrap();
+    let arity: usize = args.get(5).map(|s| s.parse().unwrap()).unwrap_or(2);
+    if std::env::var("SB_TRACE").is_ok() {
+        openvm_stark_sdk::utils::setup_tracing();
+    }
+    let t0 = Instant::now();
+    let mut out = match backend {
+        "cpu" => dispatch::<BabyBearPoseidon2CpuEngine<DuplexSponge>>(workload, log_rows, reps, arity),
+        #[cfg(feature = "cuda")]
+        "gpu" => dispatch::<openvm_cuda_backend::BabyBearPoseidon2GpuEngine>(
+            workload, log_rows, reps, arity,
+        ),
+        _ => panic!("backend {backend} not built"),
+    };
+    out["framework"] = json!("openvm-stark-backend v2.1.0 (a6b4761)");
+    out["workload"] = json!(workload);
+    out["backend"] = json!(backend);
+    out["log_rows"] = json!(log_rows);
+    out["reps"] = json!(reps);
+    out["rayon_threads_env"] = json!(std::env::var("RAYON_NUM_THREADS").ok());
+    out["wall_total_s"] = json!(t0.elapsed().as_secs_f64());
+    println!("{}", serde_json::to_string(&out).unwrap());
+}
