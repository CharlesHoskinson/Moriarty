+//! D10: trace heights of the Sherlock last layer L by tracegen over one real node proof.
+//!
+//! Usage: l_heights <child_set> <arity> <w1_log_rows> <prove_l>
+//!   child_set : "internal_ud" (OD-19 internal set: UD, blowup 3, queries 97/82/81, fold PoW 0,
+//!               mu PoW 9, query PoW 21, LogUp PoW 18, l_skip 2, n_stack 17, w_stack 512)
+//!               or "leaf" (stock leaf params, the bench node).
+//!   arity     : 1 or 2 (VerifierSubCircuit::<arity> over W1 proofs at app params).
+//!   prove_l   : 0 or 1. 1 proves and verifies L_nocached and L_cached with the BN254 root engine
+//!               at the OD-19 L set (UD, blowup 3, queries 98/83/82, fold PoW 0, mu PoW 6,
+//!               query PoW 20, LogUp PoW 18, l_skip 2, n_stack 18) with w_stack 48.
+//!
+//! Chain: W1 proofs (CPU, app params) -> node proof (CPU, child_set params, verified) ->
+//! L = VerifierSubCircuit::<1> over the node vk: tracegen with the BabyBear engine and with the
+//! BN254 root engine, both VerifierConfig variants (has_cached true and false). Per-AIR heights
+//! and widths, the stacked width per commit by StackedLayout::new (as proof_shape.rs:540-573),
+//! the total interactions and n_logup (proof_shape.rs:378-384), and the BN254 keygen dump.
+//! Prints one JSON object on stdout.
+
+use std::{cmp::Reverse, collections::BTreeMap, sync::Arc, time::Instant};
+
+use openvm_cpu_backend::CpuBackend;
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{
+    AggregationSubCircuit, CachedTraceCtx, VerifierConfig, VerifierSubCircuit, VerifierTraceGen,
+};
+use openvm_stark_backend::{
+    air_builders::symbolic::{symbolic_variable::Entry, SymbolicExpressionNode},
+    calculate_n_logup,
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    p3_field::PrimeCharacteristicRing,
+    p3_matrix::Matrix,
+    proof::Proof,
+    prover::{
+        stacked_pcs::StackedLayout, AirProvingContext, ColMajorMatrix, DeviceDataTransporter,
+        ProvingContext,
+    },
+    AirRef, StarkEngine, StarkProtocolConfig, SystemParams, WhirProximityStrategy,
+};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_bn254_poseidon2::{BabyBearBn254Poseidon2Config, BabyBearBn254Poseidon2CpuEngine},
+    baby_bear_poseidon2::{
+        default_duplex_sponge_recorder, BabyBearPoseidon2Config, BabyBearPoseidon2CpuEngine,
+        DuplexSponge, DuplexSpongeRecorder,
+    },
+    leaf_params_with_100_bits_security, params_with_100_bits_security, MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+use serde_json::{json, Value};
+
+type F = BabyBear;
+type SC = BabyBearPoseidon2Config;
+type RootSC = BabyBearBn254Poseidon2Config;
+type Eng = BabyBearPoseidon2CpuEngine<DuplexSponge>;
+type RootEng = BabyBearBn254Poseidon2CpuEngine;
+
+#[allow(clippy::too_many_arguments)]
+fn ud_params(
+    b: usize,
+    l_skip: usize,
+    n_stack: usize,
+    w_stack: usize,
+    mu: usize,
+    qpow: usize,
+    queries: &[usize],
+    logup: usize,
+) -> SystemParams {
+    let mut p = params_with_100_bits_security(
+        b, l_skip, n_stack, w_stack, 0, mu, WhirProximityStrategy::UniqueDecoding, 4, qpow, 4,
+    );
+    assert_eq!(p.whir.rounds.len(), queries.len(), "WHIR round count");
+    for (r, &q) in p.whir.rounds.iter_mut().zip(queries) {
+        r.num_queries = q;
+    }
+    p.logup.pow_bits = logup;
+    p
+}
+
+/// OD-19 internal set (UD-SIZING.md 5.1).
+fn internal_ud() -> SystemParams {
+    ud_params(3, 2, 17, 512, 9, 21, &[97, 82, 81], 18)
+}
+/// OD-19 L set (UD-SIZING.md 5.1) at the w_stack bound 48.
+fn l_ud(w_stack: usize) -> SystemParams {
+    ud_params(3, 2, 18, w_stack, 6, 20, &[98, 83, 82], 18)
+}
+
+fn params_json(p: &SystemParams) -> Value {
+    json!({
+        "l_skip": p.l_skip, "n_stack": p.n_stack, "w_stack": p.w_stack, "log_blowup": p.log_blowup,
+        "k_whir": p.k_whir(), "proximity": format!("{:?}", p.whir.proximity),
+        "queries": p.whir.rounds.iter().map(|r| r.num_queries).collect::<Vec<_>>(),
+        "folding_pow_bits": p.whir.folding_pow_bits, "mu_pow_bits": p.whir.mu_pow_bits,
+        "query_phase_pow_bits": p.whir.query_phase_pow_bits, "logup_pow_bits": p.logup.pow_bits,
+    })
+}
+
+fn log2_exact(h: usize) -> usize {
+    assert!(h.is_power_of_two(), "height {h} not a power of two");
+    h.trailing_zeros() as usize
+}
+
+/// Shape of one L tracegen: per-AIR heights, stacked widths, interactions, n_logup.
+fn shape<C: StarkProtocolConfig<F = F>>(
+    pk: &MultiStarkProvingKey<C>,
+    ctxs: &[AirProvingContext<CpuBackend<C>>],
+    l_skip: usize,
+    n_stack: usize,
+) -> Value {
+    assert_eq!(ctxs.len(), pk.per_air.len(), "one ctx per AIR");
+    let mut airs = vec![];
+    // (air_idx, common width, cached widths, log_height, num_interactions)
+    let mut per: Vec<(usize, usize, Vec<usize>, usize, usize)> = vec![];
+    let mut cells = 0usize;
+    for (i, (apk, ctx)) in pk.per_air.iter().zip(ctxs).enumerate() {
+        let h = Matrix::height(&ctx.common_main);
+        let w = Matrix::width(&ctx.common_main);
+        assert_eq!(w, apk.vk.params.width.common_main, "width of AIR {i}");
+        let cached: Vec<(usize, usize)> =
+            ctx.cached_mains.iter().map(|c| (Matrix::height(&c.trace), Matrix::width(&c.trace))).collect();
+        for (ch, _) in &cached {
+            assert_eq!(*ch, h, "cached height of AIR {i}");
+        }
+        let ni = apk.vk.symbolic_constraints.interactions.len();
+        let cw: Vec<usize> = cached.iter().map(|c| c.1).collect();
+        cells += h * (w + cw.iter().sum::<usize>());
+        airs.push(json!({"idx": i, "name": apk.air_name, "height": h, "log_height": log2_exact(h),
+                         "width_common": w, "width_cached": cw, "num_interactions": ni,
+                         "need_rot": apk.vk.params.need_rot}));
+        per.push((i, w, cw, log2_exact(h), ni));
+    }
+    let mut sorted = per.clone();
+    sorted.sort_by_key(|t| Reverse(t.3)); // stable, as sorted_by_key in proof_shape.rs:375
+    let lsh = n_stack + l_skip;
+    let common = StackedLayout::new(l_skip, lsh, sorted.iter().map(|t| (t.1, t.3)).collect())
+        .expect("common layout")
+        .width();
+    let other: Vec<usize> = sorted
+        .iter()
+        .flat_map(|t| t.2.iter().map(move |&cw| (cw, t.3)))
+        .map(|(cw, lh)| StackedLayout::new(l_skip, lsh, vec![(cw, lh)]).expect("layout").width())
+        .collect();
+    let total_int: u64 = per.iter().map(|t| (t.4 as u64) << t.3.max(l_skip)).sum();
+    let n_logup = calculate_n_logup(l_skip, total_int);
+    let mut hist: BTreeMap<usize, usize> = BTreeMap::new();
+    for t in &per {
+        *hist.entry(t.3).or_default() += 1;
+    }
+    json!({
+        "airs": airs, "main_cells": cells,
+        "stacked_width_common": common, "stacked_width_other": other,
+        "w_stack_needed": common + other.iter().sum::<usize>(),
+        "total_interactions_lifted": total_int, "n_logup": n_logup,
+        "gkr_rounds_T": if total_int == 0 { 0 } else { l_skip + n_logup },
+        "distinct_log_heights": hist.keys().collect::<Vec<_>>(), "log_height_histogram": hist,
+        "max_log_height": per.iter().map(|t| t.3).max(),
+    })
+}
+
+fn dump<C: StarkProtocolConfig<F = F>>(pk: &MultiStarkProvingKey<C>) -> Value {
+    let mut airs = vec![];
+    for apk in pk.per_air.iter() {
+        let vk = &apk.vk;
+        let w = &vk.params.width;
+        let dag = &vk.symbolic_constraints.constraints;
+        let mut kinds: BTreeMap<&str, usize> = BTreeMap::new();
+        for n in &dag.nodes {
+            let k = match n {
+                SymbolicExpressionNode::Variable(v) => match v.entry {
+                    Entry::Preprocessed { .. } => "var_pre",
+                    Entry::Main { .. } => "var_main",
+                    Entry::Public => "var_public",
+                    Entry::Challenge => "var_challenge",
+                },
+                SymbolicExpressionNode::IsFirstRow => "is_first_row",
+                SymbolicExpressionNode::IsLastRow => "is_last_row",
+                SymbolicExpressionNode::IsTransition => "is_transition",
+                SymbolicExpressionNode::Constant(_) => "constant",
+                SymbolicExpressionNode::Add { .. } => "add",
+                SymbolicExpressionNode::Sub { .. } => "sub",
+                SymbolicExpressionNode::Neg { .. } => "neg",
+                SymbolicExpressionNode::Mul { .. } => "mul",
+            };
+            *kinds.entry(k).or_default() += 1;
+        }
+        let ints = &vk.symbolic_constraints.interactions;
+        airs.push(json!({
+            "name": apk.air_name, "width_preprocessed": w.preprocessed.unwrap_or(0),
+            "width_cached_mains": w.cached_mains, "width_common_main": w.common_main,
+            "need_rot": vk.params.need_rot, "num_public_values": vk.params.num_public_values,
+            "max_constraint_degree": vk.max_constraint_degree,
+            "num_constraints": dag.constraint_idx.len(), "dag_nodes": dag.nodes.len(),
+            "dag_node_kinds": kinds, "num_interactions": ints.len(),
+            "interaction_msg_len_sum": ints.iter().map(|it| it.message.len()).sum::<usize>(),
+        }));
+    }
+    json!({"num_airs": pk.per_air.len(), "params": params_json(&pk.params),
+           "max_constraint_degree": pk.max_constraint_degree, "airs": airs})
+}
+
+fn w1_proofs(n: usize, log_rows: usize) -> (MultiStarkVerifyingKey<SC>, Vec<Proof<SC>>) {
+    let mut rng = StdRng::seed_from_u64(0x5e7_10c);
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let airs: Vec<AirRef<SC>> = vec![chip.air.clone()];
+    let engine = Eng::new(app_params_with_100_bits_security(MAX_APP_LOG_STACKED_HEIGHT));
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let mut proofs = vec![];
+    for _ in 0..n {
+        let inputs: Vec<[F; 16]> = (0..1usize << log_rows)
+            .map(|_| std::array::from_fn(|_| F::from_u32(rng.random::<u32>() % (1 << 30))))
+            .collect();
+        let trace = chip.generate_trace(inputs);
+        let cm = ColMajorMatrix::from_row_major(&trace);
+        let ctx = ProvingContext::new(vec![(
+            0,
+            AirProvingContext::simple_no_pis(engine.device().transport_matrix_to_device(&cm)),
+        )]);
+        let proof = engine.prove(&d_pk, ctx).expect("w1 prove");
+        engine.verify(&vk, &proof).expect("w1 verify");
+        proofs.push(proof);
+    }
+    (vk, proofs)
+}
+
+fn node_proof<const N: usize>(
+    params: SystemParams,
+    child_vk: &MultiStarkVerifyingKey<SC>,
+    proofs: &[Proof<SC>],
+) -> (MultiStarkVerifyingKey<SC>, Proof<SC>, Value)
+where
+    VerifierSubCircuit<N>: VerifierTraceGen<CpuBackend<SC>, SC, ()> + AggregationSubCircuit,
+{
+    let engine = Eng::new(params.clone());
+    let circuit = <VerifierSubCircuit<N> as VerifierTraceGen<CpuBackend<SC>, SC, ()>>::new(
+        Arc::new(child_vk.clone()),
+        Default::default(),
+    );
+    let child_pcs = circuit.commit_child_vk(&engine, child_vk);
+    let airs = circuit.airs::<SC>();
+    let (pk, vk) = engine.keygen(&airs);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctxs = circuit.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        child_vk,
+        CachedTraceCtx::PcsData(child_pcs),
+        proofs,
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    let sh = shape(&pk, &ctxs, params.l_skip, params.n_stack);
+    let t = Instant::now();
+    let proof = engine.prove(&d_pk, ProvingContext::new(ctxs.into_iter().enumerate().collect()))
+        .expect("node prove");
+    let prove_s = t.elapsed().as_secs_f64();
+    engine.verify(&vk, &proof).expect("node verify");
+    let q: usize = params.whir.rounds.iter().map(|r| r.num_queries).sum();
+    (vk, proof, json!({"arity": N, "params": params_json(&params), "total_queries": q,
+                       "prove_s": prove_s, "verified": true, "shape": sh}))
+}
+
+/// L tracegen (and optionally prove + verify) for one engine and one VerifierConfig.
+fn l_run<E, C>(
+    engine: &E,
+    node_vk: &Arc<MultiStarkVerifyingKey<SC>>,
+    node_proof: &Proof<SC>,
+    has_cached: bool,
+    prove: bool,
+) -> (Value, MultiStarkProvingKey<C>)
+where
+    C: StarkProtocolConfig<F = F>,
+    E: StarkEngine<SC = C, PB = CpuBackend<C>>,
+    (): From<openvm_stark_backend::EngineDeviceCtx<E>>,
+    VerifierSubCircuit<1>: VerifierTraceGen<CpuBackend<C>, C, ()>,
+{
+    let cfg = VerifierConfig { has_cached, ..Default::default() };
+    let l = <VerifierSubCircuit<1> as VerifierTraceGen<CpuBackend<C>, C, ()>>::new(
+        node_vk.clone(),
+        cfg,
+    );
+    let airs = AggregationSubCircuit::airs::<C>(&l);
+    let (pk, vk) = engine.keygen(&airs);
+    let cached = if has_cached {
+        CachedTraceCtx::PcsData(l.commit_child_vk(engine, node_vk))
+    } else {
+        CachedTraceCtx::Records(
+            <VerifierSubCircuit<1> as VerifierTraceGen<CpuBackend<C>, C, ()>>::cached_trace_record(
+                &l, node_vk,
+            ),
+        )
+    };
+    let t = Instant::now();
+    let ctxs = l.generate_proving_ctxs_base::<DuplexSpongeRecorder>(
+        node_vk,
+        cached,
+        std::slice::from_ref(node_proof),
+        &(),
+        default_duplex_sponge_recorder(),
+    );
+    let tracegen_s = t.elapsed().as_secs_f64();
+    let p = engine.params().clone();
+    let mut out = json!({"has_cached": has_cached, "tracegen_s": tracegen_s,
+                         "shape": shape(&pk, &ctxs, p.l_skip, p.n_stack)});
+    if prove {
+        let d_pk = engine.device().transport_pk_to_device(&pk);
+        let t = Instant::now();
+        let proof = engine
+            .prove(&d_pk, ProvingContext::new(ctxs.into_iter().enumerate().collect()))
+            .expect("L prove");
+        let prove_s = t.elapsed().as_secs_f64();
+        let ok = engine.verify(&vk, &proof);
+        let lh: Vec<Option<usize>> =
+            proof.trace_vdata.iter().map(|v| v.as_ref().map(|v| v.log_height)).collect();
+        out["prove"] = json!({"prove_s": prove_s, "verify_ok": ok.is_ok(),
+                              "verify_err": ok.err().map(|e| format!("{e:?}")),
+                              "proof_log_heights": lh, "params": params_json(&p)});
+    }
+    (out, pk)
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let set = a[1].as_str();
+    let arity: usize = a[2].parse().unwrap();
+    let log_rows: usize = a[3].parse().unwrap();
+    let prove_l = a[4] == "1";
+    let t0 = Instant::now();
+    let child_params = match set {
+        "internal_ud" => internal_ud(),
+        "leaf" => leaf_params_with_100_bits_security(),
+        _ => panic!("child_set"),
+    };
+    let (w1_vk, proofs) = w1_proofs(arity, log_rows);
+    eprintln!("w1 proofs done {:.1}s", t0.elapsed().as_secs_f64());
+    let (node_vk, node_pf, node_json) = match arity {
+        1 => node_proof::<1>(child_params, &w1_vk, &proofs),
+        2 => node_proof::<2>(child_params, &w1_vk, &proofs),
+        _ => panic!("arity"),
+    };
+    eprintln!("node proof done {:.1}s", t0.elapsed().as_secs_f64());
+    let node_vk = Arc::new(node_vk);
+    let mut out = json!({"child_set": set, "arity": arity, "w1_log_rows": log_rows, "node": node_json});
+
+    // BabyBear engine at the stock root params (as L-STRUCTURE) and BN254 root engine at the
+    // OD-19 L set. Heights of L do not depend on L's own params; both are dumped to show it.
+    let bb = Eng::new(openvm_stark_sdk::config::root_params_with_100_bits_security());
+    let root = RootEng::new(l_ud(48));
+    for has_cached in [true, false] {
+        let tag = if has_cached { "L_cached" } else { "L_nocached" };
+        let (bb_out, _) = l_run(&bb, &node_vk, &node_pf, has_cached, false);
+        out[format!("{tag}_babybear_rootparams")] = bb_out;
+        let (bn_out, bn_pk) = l_run(&root, &node_vk, &node_pf, has_cached, prove_l);
+        out[format!("{tag}_bn254_ud")] = bn_out;
+        out[format!("{tag}_bn254_ud_keygen")] = dump(&bn_pk);
+        eprintln!("{tag} done {:.1}s", t0.elapsed().as_secs_f64());
+    }
+    out["wall_s"] = json!(t0.elapsed().as_secs_f64());
+    println!("{}", serde_json::to_string(&out).unwrap());
+}
diff --git a/crates/stark-bench-ovm/examples/l_structure.rs b/crates/stark-bench-ovm/examples/l_structure.rs
new file mode 100644
index 0000000..4b0b185
--- /dev/null
+++ b/crates/stark-bench-ovm/examples/l_structure.rs
@@ -0,0 +1,175 @@
+//! Keygen-only dump of the structure of the Sherlock last layer L (no tracegen, no proving).
+//!
+//! Chain: W1 (Poseidon2 AIR) keygen at app params -> node = VerifierSubCircuit::<2> over W1 vk
+//! at leaf params (the bench node) -> L = VerifierSubCircuit::<1> over the node vk at root params.
+//! L is keyed at root params (BabyBear engine; see note in main) and, for the C check, with both
+//! VerifierConfig defaults (has_cached = true) and the RootProver setting (has_cached = false).
+//!
+//! Prints one JSON object on stdout: per-AIR structure for the node and for each L variant.
+
+use std::{collections::BTreeMap, sync::Arc};
+
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{AggregationSubCircuit, VerifierConfig, VerifierSubCircuit};
+use openvm_stark_backend::{
+    air_builders::symbolic::{symbolic_variable::Entry, SymbolicExpressionNode},
+    keygen::types::MultiStarkProvingKey,
+    AirRef, StarkEngine, StarkProtocolConfig, SystemParams,
+};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_poseidon2::{BabyBearPoseidon2Config, BabyBearPoseidon2CpuEngine, DuplexSponge},
+    leaf_params_with_100_bits_security, root_params_with_100_bits_security,
+    MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use serde_json::{json, Value};
+
+type F = BabyBear;
+type SC = BabyBearPoseidon2Config;
+
+fn params_json(p: &SystemParams) -> Value {
+    json!({
+        "l_skip": p.l_skip,
+        "n_stack": p.n_stack,
+        "w_stack": p.w_stack,
+        "log_blowup": p.log_blowup,
+        "k_whir": p.k_whir(),
+        "num_whir_rounds": p.num_whir_rounds(),
+        "whir_queries_per_round": p.whir.rounds.iter().map(|r| r.num_queries).collect::<Vec<_>>(),
+        "log_final_poly_len": p.log_final_poly_len(),
+        "final_poly_len": 1usize << p.log_final_poly_len(),
+        "mu_pow_bits": p.whir.mu_pow_bits,
+        "folding_pow_bits": p.whir.folding_pow_bits,
+        "query_phase_pow_bits": p.whir.query_phase_pow_bits,
+        "logup_pow_bits": p.logup.pow_bits,
+        "max_constraint_degree": p.max_constraint_degree,
+        "debug": format!("{:?}", p),
+    })
+}
+
+fn dump<C: StarkProtocolConfig<F = F>>(pk: &MultiStarkProvingKey<C>) -> Value {
+    let mut airs = vec![];
+    for (i, apk) in pk.per_air.iter().enumerate() {
+        let vk = &apk.vk;
+        let w = &vk.params.width;
+        let dag = &vk.symbolic_constraints.constraints;
+        let nodes = &dag.nodes;
+        let mut kinds: BTreeMap<&str, usize> = BTreeMap::new();
+        let mut var_kinds: BTreeMap<&str, usize> = BTreeMap::new();
+        let is_const = |j: usize| matches!(nodes[j], SymbolicExpressionNode::Constant(_));
+        let mut mul_const = 0usize;
+        let mut max_node_deg = 0usize;
+        for n in nodes {
+            let k = match n {
+                SymbolicExpressionNode::Variable(v) => {
+                    let vk = match v.entry {
+                        Entry::Preprocessed { .. } => "preprocessed",
+                        Entry::Main { .. } => "main",
+                        Entry::Public => "public",
+                        Entry::Challenge => "challenge",
+                    };
+                    *var_kinds.entry(vk).or_default() += 1;
+                    "variable"
+                }
+                SymbolicExpressionNode::IsFirstRow => "is_first_row",
+                SymbolicExpressionNode::IsLastRow => "is_last_row",
+                SymbolicExpressionNode::IsTransition => "is_transition",
+                SymbolicExpressionNode::Constant(_) => "constant",
+                SymbolicExpressionNode::Add { degree_multiple, .. } => {
+                    max_node_deg = max_node_deg.max(*degree_multiple);
+                    "add"
+                }
+                SymbolicExpressionNode::Sub { degree_multiple, .. } => {
+                    max_node_deg = max_node_deg.max(*degree_multiple);
+                    "sub"
+                }
+                SymbolicExpressionNode::Neg { degree_multiple, .. } => {
+                    max_node_deg = max_node_deg.max(*degree_multiple);
+                    "neg"
+                }
+                SymbolicExpressionNode::Mul { left_idx, right_idx, degree_multiple } => {
+                    max_node_deg = max_node_deg.max(*degree_multiple);
+                    if is_const(*left_idx) || is_const(*right_idx) {
+                        mul_const += 1;
+                    }
+                    "mul"
+                }
+            };
+            *kinds.entry(k).or_default() += 1;
+        }
+        let ints = &vk.symbolic_constraints.interactions;
+        let mut buses: Vec<u16> = ints.iter().map(|it| it.bus_index as u16).collect();
+        buses.sort();
+        buses.dedup();
+        let msg_lens: Vec<usize> = ints.iter().map(|it| it.message.len()).collect();
+        airs.push(json!({
+            "idx": i,
+            "name": apk.air_name,
+            "width_preprocessed": w.preprocessed.unwrap_or(0),
+            "width_cached_mains": w.cached_mains,
+            "width_common_main": w.common_main,
+            "width_main_total": w.main_width(),
+            "width_after_challenge": 0,
+            "has_preprocessed_data": vk.preprocessed_data.is_some(),
+            "num_public_values": vk.params.num_public_values,
+            "need_rot": vk.params.need_rot,
+            "is_required": vk.is_required,
+            "max_constraint_degree": vk.max_constraint_degree,
+            "max_dag_node_degree": max_node_deg,
+            "num_constraints": dag.constraint_idx.len(),
+            "dag_nodes": nodes.len(),
+            "dag_node_kinds": kinds,
+            "dag_variable_kinds": var_kinds,
+            "dag_mul_by_constant": mul_const,
+            "num_interactions": ints.len(),
+            "interaction_msg_lens": msg_lens,
+            "interaction_msg_len_sum": msg_lens.iter().sum::<usize>(),
+            "bus_ids": buses,
+        }));
+    }
+    json!({
+        "num_airs": pk.per_air.len(),
+        "params": params_json(&pk.params),
+        "max_constraint_degree": pk.max_constraint_degree,
+        "num_trace_height_constraints": pk.trace_height_constraints.len(),
+        "airs": airs,
+    })
+}
+
+fn main() {
+    // W1 child: Poseidon2 width-16 AIR, app params (the bench leaf).
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let w1_airs: Vec<AirRef<SC>> = vec![chip.air.clone()];
+    let app = BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(app_params_with_100_bits_security(
+        MAX_APP_LOG_STACKED_HEIGHT,
+    ));
+    let (_, w1_vk) = app.keygen(&w1_airs);
+
+    // Bench node: VerifierSubCircuit::<2> over W1 at leaf params, default config.
+    let node = VerifierSubCircuit::<2>::new(Arc::new(w1_vk));
+    let node_airs = node.airs::<SC>();
+    let leaf = BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(leaf_params_with_100_bits_security());
+    let (node_pk, node_vk) = leaf.keygen(&node_airs);
+    let node_json = dump(&node_pk);
+    eprintln!("node: {} AIRs", node_pk.per_air.len());
+
+    let node_vk = Arc::new(node_vk);
+    let mut out = json!({ "node": node_json });
+    for (tag, has_cached) in [("L_cached", true), ("L_nocached", false)] {
+        let cfg = VerifierConfig { has_cached, ..Default::default() };
+        let l = VerifierSubCircuit::<1>::new_with_options(node_vk.clone(), cfg);
+        // Root params. The BN254 root config needs the stark-sdk feature baby-bear-bn254-poseidon2,
+        // which the bench crate does not enable; the AIRs of L do not depend on L's own hash
+        // (airs::<SC>() only fixes the config type), so the BabyBear engine keys the same structure.
+        let root = BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(root_params_with_100_bits_security());
+        let l_airs = l.airs::<SC>();
+        let (l_pk, _) = root.keygen(&l_airs);
+        eprintln!("{tag}: {} AIRs", l_pk.per_air.len());
+        out[tag] = dump(&l_pk);
+        out[tag]["verifier_config"] =
+            json!({"has_cached": has_cached, "continuations_enabled": false,
+                   "final_state_bus_enabled": false, "engine": "BabyBearPoseidon2CpuEngine (root params; BN254 config not built)"});
+    }
+    println!("{}", serde_json::to_string(&out).unwrap());
+}
diff --git a/crates/stark-bench-ovm/src/main.rs b/crates/stark-bench-ovm/src/main.rs
new file mode 100644
index 0000000..b86727c
--- /dev/null
+++ b/crates/stark-bench-ovm/src/main.rs
@@ -0,0 +1,636 @@
+//! Sherlock STARK framework bench, P1 (leaf) and P2 (node), on OpenVM stark-backend v2.1.0.
+//!
+//! Usage: stark-bench-ovm <w1|w2|node> <cpu|gpu> <log_rows> <reps> [arity]
+//!   w1   : Poseidon2 width-16 permutation AIR (OpenVM `Poseidon2SubAir`, BabyBear, SBOX_REGISTERS=1),
+//!          one permutation per row, 2^log_rows rows.
+//!   w2   : authored-for-bench CPU-style ALU AIR (32-bit add in 4 byte limbs, 16 columns) that
+//!          sends 12 byte range checks per row over a LogUp bus to OpenVM's `RangeCheckerAir`
+//!          (256-row preprocessed table with a multiplicity column).
+//!   node : `arity` W1 proofs at 2^log_rows rows (app params) verified by OpenVM's recursion
+//!          `VerifierSubCircuit::<arity>` and proved at leaf params (the leaf-aggregation layer).
+//! Prints one JSON object on stdout. Timings: keygen, tracegen, transport, prove (each rep), verify.
+
+use std::{
+    sync::{
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Instant,
+};
+
+use openvm_circuit_primitives::range::{RangeCheckBus, RangeCheckerChip};
+use openvm_poseidon2_air::{Poseidon2Config, Poseidon2SubChip};
+use openvm_recursion_circuit::system::{
+    AggregationSubCircuit, CachedTraceCtx, VerifierSubCircuit, VerifierTraceGen,
+};
+use openvm_stark_backend::{
+    codec::Encode,
+    interaction::InteractionBuilder,
+    keygen::types::MultiStarkVerifyingKey,
+    p3_air::{Air, BaseAir},
+    p3_field::{Field, PrimeCharacteristicRing},
+    p3_matrix::{dense::RowMajorMatrix, Matrix},
+    proof::Proof,
+    prover::{
+        AirProvingContext, ColMajorMatrix, DeviceDataTransporter, MatrixDimensions, ProverDevice,
+        ProvingContext,
+    },
+    AirRef, BaseAirWithPublicValues, EngineDeviceCtx, PartitionedBaseAir, StarkEngine,
+    SystemParams,
+};
+use openvm_stark_sdk::config::{
+    app_params_with_100_bits_security,
+    baby_bear_poseidon2::{
+        default_duplex_sponge_recorder, BabyBearPoseidon2Config, BabyBearPoseidon2CpuEngine,
+        DuplexSponge, DuplexSpongeRecorder,
+    },
+    leaf_params_with_100_bits_security, MAX_APP_LOG_STACKED_HEIGHT,
+};
+use p3_baby_bear::BabyBear;
+use rand::{rngs::StdRng, Rng, RngCore, SeedableRng};
+use serde_json::{json, Value};
+
+type F = BabyBear;
+type SC = BabyBearPoseidon2Config;
+
+// ---------------------------------------------------------------------------
+// resource helpers
+// ---------------------------------------------------------------------------
+
+fn rusage() -> (f64, u64) {
+    let mut ru: libc::rusage = unsafe { std::mem::zeroed() };
+    unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut ru) };
+    let cpu = ru.ru_utime.tv_sec as f64
+        + ru.ru_utime.tv_usec as f64 * 1e-6
+        + ru.ru_stime.tv_sec as f64
+        + ru.ru_stime.tv_usec as f64 * 1e-6;
+    (cpu, ru.ru_maxrss as u64)
+}
+
+fn median(v: &[f64]) -> f64 {
+    let mut s = v.to_vec();
+    s.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let n = s.len();
+    if n == 0 {
+        return f64::NAN;
+    }
+    if n % 2 == 1 {
+        s[n / 2]
+    } else {
+        0.5 * (s[n / 2 - 1] + s[n / 2])
+    }
+}
+
+/// Samples device memory in use (cudaMemGetInfo total - free) while proving. On this unified
+/// memory device that is a system-wide figure, so the bench reports the rise over the
+/// pre-prove baseline.
+struct GpuSampler {
+    stop: Arc<AtomicBool>,
+    peak: Arc<AtomicUsize>,
+    handle: Option<std::thread::JoinHandle<()>>,
+    base: usize,
+}
+
+impl GpuSampler {
+    fn start() -> Self {
+        let base = gpu_used();
+        if std::env::var("SB_NO_SAMPLER").is_ok() {
+            return Self { stop: Arc::new(AtomicBool::new(true)), peak: Arc::new(AtomicUsize::new(base)), handle: Some(std::thread::spawn(|| {})), base };
+        }
+        let stop = Arc::new(AtomicBool::new(false));
+        let peak = Arc::new(AtomicUsize::new(base));
+        let (s, p) = (stop.clone(), peak.clone());
+        let handle = std::thread::spawn(move || {
+            while !s.load(Ordering::Relaxed) {
+                p.fetch_max(gpu_used(), Ordering::Relaxed);
+                std::thread::sleep(std::time::Duration::from_millis(20));
+            }
+        });
+        Self {
+            stop,
+            peak,
+            handle: Some(handle),
+            base,
+        }
+    }
+    fn finish(mut self) -> (usize, usize) {
+        self.stop.store(true, Ordering::Relaxed);
+        self.handle.take().unwrap().join().unwrap();
+        let peak = self.peak.load(Ordering::Relaxed).max(gpu_used());
+        (self.base, peak)
+    }
+}
+
+#[cfg(feature = "cuda")]
+fn gpu_used() -> usize {
+    openvm_cuda_common::memory_manager::device_memory_used()
+}
+#[cfg(not(feature = "cuda"))]
+fn gpu_used() -> usize {
+    0
+}
+
+// ---------------------------------------------------------------------------
+// W2: CPU-style ALU AIR with byte range checks over a LogUp bus
+// ---------------------------------------------------------------------------
+
+const ALU_W: usize = 16; // a[4] b[4] c[4] carry[4]
+
+#[derive(Clone, Copy, Debug)]
+struct AluAir {
+    bus: RangeCheckBus,
+}
+
+impl<T> BaseAir<T> for AluAir {
+    fn width(&self) -> usize {
+        ALU_W
+    }
+}
+impl<T: Field> BaseAirWithPublicValues<T> for AluAir {}
+impl<T: Field> PartitionedBaseAir<T> for AluAir {}
+
+impl<AB: InteractionBuilder> Air<AB> for AluAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let row = main.row_slice(0).expect("window");
+        let local: Vec<AB::Var> = row.to_vec();
+        drop(row);
+        let base = AB::Expr::from_u32(256);
+        for i in 0..4 {
+            let a: AB::Expr = local[i].into();
+            let b: AB::Expr = local[4 + i].into();
+            let c: AB::Expr = local[8 + i].into();
+            let cy: AB::Expr = local[12 + i].into();
+            let cin: AB::Expr = if i == 0 {
+                AB::Expr::ZERO
+            } else {
+                local[12 + i - 1].into()
+            };
+            builder.assert_bool(cy.clone());
+            builder.assert_eq(a + b + cin, c + cy * base.clone());
+        }
+        for &limb in local.iter().take(12) {
+            self.bus.send(limb).eval(builder, AB::Expr::ONE);
+        }
+    }
+}
+
+fn w2_traces(log_rows: usize, rng: &mut StdRng) -> (Vec<AirRef<SC>>, Vec<RowMajorMatrix<F>>) {
+    let bus = RangeCheckBus::new(0, 256);
+    let range = RangeCheckerChip::new(bus);
+    let n = 1usize << log_rows;
+    let mut vals = F::zero_vec(n * ALU_W);
+    for r in 0..n {
+        let a = rng.next_u32();
+        let b = rng.next_u32();
+        let row = &mut vals[r * ALU_W..(r + 1) * ALU_W];
+        let mut carry = 0u32;
+        for i in 0..4 {
+            let ai = (a >> (8 * i)) & 0xff;
+            let bi = (b >> (8 * i)) & 0xff;
+            let s = ai + bi + carry;
+            let ci = s & 0xff;
+            carry = s >> 8;
+            row[i] = F::from_u32(ai);
+            row[4 + i] = F::from_u32(bi);
+            row[8 + i] = F::from_u32(ci);
+            row[12 + i] = F::from_u32(carry);
+            range.add_count(ai);
+            range.add_count(bi);
+            range.add_count(ci);
+        }
+    }
+    let alu_trace = RowMajorMatrix::new(vals, ALU_W);
+    let range_trace = range.generate_trace::<F>();
+    let airs: Vec<AirRef<SC>> = vec![Arc::new(AluAir { bus }), Arc::new(range.air)];
+    (airs, vec![alu_trace, range_trace])
+}
+
+// ---------------------------------------------------------------------------
+// W1: Poseidon2 permutation AIR
+// ---------------------------------------------------------------------------
+
+fn w1_traces(log_rows: usize, rng: &mut StdRng) -> (Vec<AirRef<SC>>, Vec<RowMajorMatrix<F>>) {
+    let chip = Poseidon2SubChip::<F, 1>::new(Poseidon2Config::<F>::default().constants);
+    let n = 1usize << log_rows;
+    let inputs: Vec<[F; 16]> = (0..n)
+        .map(|_| std::array::from_fn(|_| F::from_u32(rng.random::<u32>() % (1 << 30))))
+        .collect();
+    let trace = chip.generate_trace(inputs);
+    let airs: Vec<AirRef<SC>> = vec![chip.air.clone()];
+    (airs, vec![trace])
+}
+
+
+// ---------------------------------------------------------------------------
+// W3a: BLS12-381 Fr multiply, OpenVM mod-builder FieldExpr (32 x 8-bit limbs) + var range checker
+// ---------------------------------------------------------------------------
+
+fn w3_traces(log_rows: usize) -> (Vec<AirRef<SC>>, Vec<RowMajorMatrix<F>>) {
+    use num_bigint::BigUint;
+    use openvm_circuit_primitives::{
+        var_range::{VariableRangeCheckerBus, VariableRangeCheckerChip},
+        TraceSubRowGenerator,
+    };
+    use openvm_mod_circuit_builder::{ExprBuilder, ExprBuilderConfig, FieldExpr};
+    use openvm_stark_backend::p3_maybe_rayon::prelude::*;
+    let r = BigUint::parse_bytes(
+        b"73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001",
+        16,
+    )
+    .unwrap();
+    let range_checker = Arc::new(VariableRangeCheckerChip::new(VariableRangeCheckerBus::new(
+        1, 17,
+    )));
+    let config = ExprBuilderConfig {
+        modulus: r.clone(),
+        limb_bits: 8,
+        num_limbs: 32,
+    };
+    let builder = ExprBuilder::new(config, range_checker.range_max_bits());
+    let builder = std::rc::Rc::new(std::cell::RefCell::new(builder));
+    let mut x1 = ExprBuilder::new_input(builder.clone());
+    let mut x2 = ExprBuilder::new_input(builder.clone());
+    let mut x3 = &mut x1 * &mut x2;
+    x3.save();
+    let b = builder.borrow().clone();
+    let expr = FieldExpr::new(b, range_checker.bus(), false);
+    let width = BaseAir::<F>::width(&expr);
+    let n = 1usize << log_rows;
+    let mut rng = StdRng::seed_from_u64(7);
+    let inputs: Vec<(BigUint, BigUint)> = (0..n)
+        .map(|_| {
+            let a: Vec<u32> = (0..8).map(|_| rng.next_u32()).collect();
+            let b: Vec<u32> = (0..8).map(|_| rng.next_u32()).collect();
+            (BigUint::new(a) % &r, BigUint::new(b) % &r)
+        })
+        .collect();
+    let mut vals = F::zero_vec(n * width);
+    vals.par_chunks_mut(width)
+        .zip(inputs.into_par_iter())
+        .for_each(|(row, (a, b))| {
+            expr.generate_subrow((range_checker.as_ref(), vec![a, b], vec![]), row);
+        });
+    let trace = RowMajorMatrix::new(vals, width);
+    let range_trace = range_checker.generate_trace::<F>();
+    let airs: Vec<AirRef<SC>> = vec![Arc::new(expr), Arc::new(range_checker.air)];
+    (airs, vec![trace, range_trace])
+}
+
+/// Generic leaf: the W1 Poseidon2 AIR plus the other bench chips (ALU, byte range table,
+/// Fr-multiply FieldExpr, variable range checker) in one verifying key, with only the Poseidon2
+/// trace present. Stands in for a general-purpose leaf configuration that every program shares,
+/// against the program-specialized W1 leaf whose key holds only the chip the program uses.
+fn w1gen_traces(log_rows: usize, rng: &mut StdRng) -> (Vec<AirRef<SC>>, Vec<RowMajorMatrix<F>>) {
+    let (mut airs, traces) = w1_traces(log_rows, rng);
+    // Absent AIRs only (no trace). Tables with preprocessed columns are left out: with absent
+    // preprocessed AIRs in the child key, the node proof failed to verify (see RESULTS.md).
+    let (a2, _) = w2_traces(0, rng);
+    let (a3, _) = w3_traces(0);
+    airs.push(a2[0].clone());
+    airs.push(a3[0].clone());
+    (airs, traces)
+}
+
+fn app_params() -> SystemParams {
