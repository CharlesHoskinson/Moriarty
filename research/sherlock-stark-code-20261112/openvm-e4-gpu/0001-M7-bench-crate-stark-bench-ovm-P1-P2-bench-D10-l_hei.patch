+[package]
+name = "stark-bench-ovm"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+description = "Sherlock STARK framework bench (P1/P2) on OpenVM stark-backend v2.1.0"
+
+[dependencies]
+openvm-stark-backend = { workspace = true }
+openvm-stark-sdk = { workspace = true, features = ["cpu-backend"] }
+openvm-cpu-backend = { workspace = true }
+openvm-poseidon2-air = { workspace = true }
+openvm-circuit-primitives = { workspace = true }
+openvm-recursion-circuit = { workspace = true }
+openvm-mod-circuit-builder = { workspace = true }
+num-bigint = { workspace = true }
+openvm-cuda-backend = { workspace = true, optional = true }
+openvm-cuda-common = { workspace = true, optional = true }
+p3-baby-bear = { workspace = true }
+rand = { workspace = true, features = ["std", "std_rng"] }
+serde_json = { workspace = true }
+libc = "0.2"
+
+[features]
+default = ["parallel"]
+parallel = [
+  "openvm-stark-backend/parallel",
+  "openvm-stark-sdk/parallel",
+  "openvm-cpu-backend/parallel",
+  "openvm-poseidon2-air/parallel",
+  "openvm-circuit-primitives/parallel",
+  "openvm-recursion-circuit/parallel",
+  "openvm-mod-circuit-builder/parallel",
+]
+cuda = [
+  "dep:openvm-cuda-backend",
+  "dep:openvm-cuda-common",
+  "openvm-recursion-circuit/cuda",
+  "openvm-poseidon2-air/cuda",
+  "openvm-circuit-primitives/cuda",
+  "openvm-mod-circuit-builder/cuda",
+]
+# D10: BN254 root config for the L heights example (not used by the bench binary)
+bn254 = ["openvm-stark-sdk/baby-bear-bn254-poseidon2"]
+# M7: BLS12-381 Fr Midnight-Poseidon root config
+bls = ["openvm-stark-sdk/baby-bear-bls12381-poseidon"]
+
+[[example]]
+name = "l_heights"
+required-features = ["bn254"]
+
+# M7: BLS12-381 Fr Midnight-Poseidon config for L (example l_fr, test m7_bls_fr)
+[dev-dependencies]
+midnight-circuits = { version = "=7.3.0", default-features = false }
+ff = "0.13"
+num-bigint = { workspace = true }
+
+[[example]]
+name = "l_fr"
+required-features = ["bls"]
+
+[[test]]
+name = "m7_bls_fr"
+required-features = ["bls"]
