+//! E4 increment 1: the GPU Midnight Poseidon leaf hashes and digest layers equal the CPU
+//! `FrMerkleHasher` (`hash_slice`, `compress`, and the stark-backend scalar layer order).
+#![cfg(feature = "gpu")]
+
+use std::time::Instant;
+
+use openvm_stark_backend::hasher::MerkleHasher;
+use openvm_stark_sdk::config::bls12381_fr_poseidon::{
+    Bls12381Fr as Fr, FrDomains, FrMerkleHasher, MidnightPoseidonFr,
+};
+use p3_field::PrimeCharacteristicRing;
+use rand::{rngs::StdRng, Rng, SeedableRng};
+
+fn hasher() -> FrMerkleHasher {
+    FrMerkleHasher::new(MidnightPoseidonFr::new(), FrDomains::l_fr())
+}
+
+fn rand_fr(rng: &mut StdRng) -> Fr {
+    // a full-width value: x = a * 2^128 + b reduced mod r
+    let a = Fr::from_u128(rng.random::<u128>());
+    let b = Fr::from_u128(rng.random::<u128>());
+    a * Fr::from_u128(1u128 << 127) * Fr::TWO + b
+}
+
+/// `build_digest_layers_scalar` of cpu-backend (sequential copy).
+fn layers_cpu(h: &FrMerkleHasher, leaves: Vec<[Fr; 1]>, rpq: usize) -> Vec<Vec<[Fr; 1]>> {
+    let qs = leaves.len() / rpq;
+    let mut cur = leaves;
+    let mut s = rpq;
+    while s > 1 {
+        cur = (0..cur.len() / 2)
+            .map(|i| {
+                let (x, y) = (i / qs, i % qs);
+                h.compress(cur[2 * x * qs + y], cur[(2 * x + 1) * qs + y])
+            })
+            .collect();
+        s /= 2;
+    }
+    let mut layers = vec![cur];
+    while layers.last().unwrap().len() > 1 {
+        let p = layers.last().unwrap();
+        let l = p.chunks_exact(2).map(|c| h.compress(c[0], c[1])).collect();
+        layers.push(l);
+    }
+    layers
+}
+
+#[test]
+fn e4_gpu_poseidon_equals_cpu() {
+    assert!(mori_gpu_available(), "GPU path not available (MORI_GPU=off or no device)");
+    for mode in ["0", "1"] {
+        std::env::set_var("MORI_POS_MODE", mode);
+        println!("E4 kernel mode {mode} (0 plain rounds, 1 sparse partial rounds)");
+        check_equal();
+    }
+}
+
+fn check_equal() {
+    let h = hasher();
+    let mut rng = StdRng::seed_from_u64(0xe4);
+    for &(width, rows) in &[(33usize, 1usize << 13), (10, 1 << 13), (1, 1 << 14), (2, 1 << 12), (3, 1 << 12), (48, 1 << 12)] {
+        let mut vals: Vec<Fr> = (0..width * rows).map(|_| rand_fr(&mut rng)).collect();
+        // edge values: zeros and p - 1
+        vals[0] = Fr::ZERO;
+        let n = vals.len();
+        vals[1 % n] = -Fr::ONE;
+        let gpu = h.hash_rows(&vals, width).expect("GPU hash_rows taken");
+        let cpu: Vec<[Fr; 1]> = vals.chunks(width).map(|r| h.hash_slice(r)).collect();
+        assert_eq!(gpu, cpu, "hash_rows width {width}");
+        println!("E4 hash_rows width {width} rows {rows}: equal");
+    }
+    for &(n, rpq) in &[(1usize << 13, 16usize), (1 << 13, 1), (1 << 14, 4)] {
+        let leaves: Vec<[Fr; 1]> = (0..n).map(|_| [rand_fr(&mut rng)]).collect();
+        let gpu = h.digest_layers(&leaves, rpq).expect("GPU digest_layers taken");
+        let cpu = layers_cpu(&h, leaves, rpq);
+        assert_eq!(gpu, cpu, "digest_layers n {n} rpq {rpq}");
+        println!("E4 digest_layers n {n} rpq {rpq}: equal ({} layers)", gpu.len());
+    }
+}
+
+/// The fused GPU encode (zero-padded NTT per column, then row hashes) equals
+/// `Radix2DitParallel::dft_batch` on the padded row-major coefficients and `hash_slice`.
+#[test]
+fn e4_gpu_encode_equals_cpu() {
+    use p3_dft::{Radix2DitParallel, TwoAdicSubgroupDft};
+    use p3_matrix::{dense::RowMajorMatrix, Matrix};
+    let h = hasher();
+    let mut rng = StdRng::seed_from_u64(0xe42);
+    for &(width, height, log_blowup) in &[(33usize, 1usize << 11, 3usize), (10, 1 << 12, 3), (3, 1 << 10, 2), (1, 1 << 12, 1)] {
+        let n = height << log_blowup;
+        let coeffs: Vec<Fr> = (0..width * height).map(|_| rand_fr(&mut rng)).collect();
+        let (rm, dg) = h
+            .encode_hash_rows(&coeffs, height, width, n.trailing_zeros() as usize)
+            .expect("GPU encode taken");
+        let mut padded = vec![Fr::ZERO; n * width];
+        for j in 0..width {
+            for i in 0..height {
+                padded[i * width + j] = coeffs[j * height + i];
+            }
+        }
+        let cpu = Radix2DitParallel::default()
+            .dft_batch(RowMajorMatrix::new(padded, width))
+            .to_row_major_matrix();
+        assert_eq!(rm, cpu.values, "codeword width {width} height {height}");
+        let cpu_h: Vec<[Fr; 1]> = cpu.values.chunks(width).map(|r| h.hash_slice(r)).collect();
+        assert_eq!(dg, cpu_h, "row hashes width {width}");
+        println!("E4 encode_hash_rows width {width} height {height} blowup 2^{log_blowup}: equal");
+    }
+}
+
+#[test]
+#[ignore = "throughput only"]
+fn e4_gpu_poseidon_rate() {
+    let h = hasher();
+    let mut rng = StdRng::seed_from_u64(1);
+    let rows = 1usize << 20;
+    let vals: Vec<Fr> = (0..2 * rows).map(|_| rand_fr(&mut rng)).collect();
+    for mode in ["0", "1"] {
+    std::env::set_var("MORI_POS_MODE", mode);
+    let _ = h.hash_rows(&vals[..2 * 4096], 2);
+    for rep in 0..3 {
+        let t = Instant::now();
+        let out = h.hash_rows(&vals, 2).unwrap();
+        let s = t.elapsed().as_secs_f64();
+        println!(
+            "E4 GPU rate mode {mode} rep {rep}: {rows} permutations (width 2 rows) in {s:.3}s = {:.2} M perm/s",
+            rows as f64 / s / 1e6
+        );
+        assert_eq!(out.len(), rows);
+    }
+    }
+    let t = Instant::now();
+    let n = 1usize << 16;
+    let _c: Vec<[Fr; 1]> = vals[..2 * n].chunks(2).map(|r| h.hash_slice(r)).collect();
+    let s = t.elapsed().as_secs_f64();
+    println!("E4 CPU rate (1 thread): {:.0} perm/s", n as f64 / s);
+}
+
+fn mori_gpu_available() -> bool {
+    std::env::var("MORI_GPU").as_deref() != Ok("off")
+}
