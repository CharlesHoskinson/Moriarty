@@ -0,0 +1,109 @@
+//! E4: one honest `L_Fr` prove at the `L_Fr` parameter set on the real `L` proof, with the
+//! backend's tracing spans (stage profile), the proof bytes written to `$E4_PROOF_OUT` (for
+//! the byte-identity check of each GPU increment against the CPU proof), and the peak RSS.
+//! The proving key is cached in `$E4_PK_CACHE` (bitcode) so a run skips the 250 s keygen.
+
+use std::{fs, path::PathBuf, time::Instant};
+
+use openvm_stark_backend::{
+    codec::Encode,
+    keygen::types::{MultiStarkProvingKey, MultiStarkVerifyingKey},
+    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},
+    StarkEngine,
+};
+use sherlock_lfr::{
+    fixture,
+    lverify::{gen_verifier, Gen, LShape},
+    machine::Machine,
+    testing::{lfr_params, range_trace, Engine, SC},
+};
+
+fn vm_hwm_kib() -> u64 {
+    let s = fs::read_to_string("/proc/self/status").unwrap_or_default();
+    s.lines()
+        .find(|l| l.starts_with("VmHWM:"))
+        .and_then(|l| l.split_whitespace().nth(1))
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(0)
+}
+
+#[test]
+#[ignore = "needs the L fixture on disk; one L_Fr prove at the L_Fr parameter set"]
+fn e4_profile_lfr_prove() {
+    openvm_stark_sdk::utils::setup_tracing();
+    let fx = fixture::load(&fixture::dir()).expect("fixture");
+    let shape = LShape::of(&fx.l_proof);
+    let mut g = Gen::new();
+    let words = gen_verifier(&mut g, &fx.l_vk, &shape, &fx.l_proof).expect("pinned shape");
+    for w in words {
+        g.tape.public(w);
+    }
+    let (mem, failed) = g.tape.execute_checked(&g.inputs);
+    assert!(failed.is_empty());
+    let m = Machine::new(&g.tape);
+    let engine = Engine::new(lfr_params());
+    let airs = m.airs();
+
+    let cache = std::env::var("E4_PK_CACHE").ok().map(PathBuf::from);
+    let t = Instant::now();
+    let (pk, vk): (MultiStarkProvingKey<SC>, MultiStarkVerifyingKey<SC>) =
+        match cache.as_ref().filter(|p| p.exists()) {
+            Some(p) => {
+                let pk: MultiStarkProvingKey<SC> =
+                    bitcode::deserialize(&fs::read(p).unwrap()).expect("pk cache");
+                let vk = pk.get_vk();
+                println!("E4 pk loaded from {} in {:.1}s", p.display(), t.elapsed().as_secs_f64());
+                (pk, vk)
+            }
+            None => {
+                let (pk, vk) = engine.keygen(&airs);
+                println!("E4 keygen {:.1}s", t.elapsed().as_secs_f64());
+                if let Some(p) = cache.as_ref() {
+                    fs::write(p, bitcode::serialize(&pk).unwrap()).unwrap();
+                }
+                (pk, vk)
+            }
+        };
+    println!("E4 rss after keygen {} MiB", vm_hwm_kib() / 1024);
+
+    let mut traces = m.traces(&mem);
+    traces.push(range_trace(&pk, &airs, &traces));
+    let pis = m.public_values(&mem);
+    let mut pis_all = pis;
+    pis_all.resize(traces.len(), vec![]);
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let ctx = ProvingContext::new(
+        traces
+            .iter()
+            .enumerate()
+            .map(|(i, t)| {
+                let cm = ColMajorMatrix::from_row_major(t);
+                (
+                    i,
+                    AirProvingContext::simple(
+                        engine.device().transport_matrix_to_device(&cm),
+                        pis_all[i].clone(),
+                    ),
+                )
+            })
+            .collect(),
+    );
+    drop(traces);
+    let t = Instant::now();
+    let proof = engine.prove(&d_pk, ctx).expect("prove");
+    let prove_s = t.elapsed().as_secs_f64();
+    let t = Instant::now();
+    engine.verify(&vk, &proof).expect("stock verifier accepts");
+    let verify_s = t.elapsed().as_secs_f64();
+    let bytes = proof.encode_to_vec().unwrap();
+    println!(
+        "E4 prove {prove_s:.2}s verify {verify_s:.2}s proof {} bytes commits {} peak rss {} MiB",
+        bytes.len(),
+        proof.stacking_proof.stacking_openings.len(),
+        vm_hwm_kib() / 1024
+    );
+    if let Ok(out) = std::env::var("E4_PROOF_OUT") {
+        fs::write(&out, &bytes).unwrap();
+        println!("E4 proof written to {out}");
+    }
+}
