+/// The values the contract tests use, and the `transientHash` parity inputs.
+#[test]
+fn fp3_values() {
+    let h = H {
+        perm: MidnightPoseidonFr::new(),
+    };
+    let c = collection(&h);
+    let mut lines = Vec::new();
+    for n in [1usize, 2, 3, 5, 16] {
+        let xs: Vec<Fr> = (1..=n as u64).map(Fr::from_u64).collect();
+        lines.push(format!("parity.u0[{n}] = {}", hex(h.h0(&xs))));
+    }
+    // XC-3b also names the empty input: the u = 0 sponge with no input permutes nothing.
+    lines.push(format!("parity.u0[0] = {}", hex(h.h0(&[]))));
+    let mut s = [Fr::ZERO, Fr::ZERO, Fr::from_u64(3)];
+    s[0] += Fr::from_u64(1);
+    s[1] += Fr::from_u64(2);
+    let s = h.perm(s);
+    let s = h.perm([s[0] + Fr::from_u64(3), s[1], s[2]]);
+    assert_eq!(s[0], h.h0(&[Fr::ONE, Fr::from_u64(2), Fr::from_u64(3)]));
+    lines.push(format!(
+        "coll.reg_pub = {}",
+        hex(h.pfr4(T_REG, &c.reg_root))
+    ));
+    lines.push(format!(
+        "coll.set_pub = {}",
+        hex(h.pfr4(T_SET, &c.set_root))
+    ));
+    lines.push(format!(
+        "coll.set_root_pack = {}",
+        hex(pack_words(&c.set_root))
+    ));
+    for (k, (o, _, log)) in c.runs.iter().enumerate() {
+        lines.push(format!("coll.run[{k}].c_p = {}", hex(out(&log[0]))));
+        lines.push(format!("coll.run[{k}].input_pub = {}", hex(out(&log[1]))));
+        lines.push(format!("coll.run[{k}].outcome_pub = {}", hex(out(&log[2]))));
+        lines.push(format!("coll.run[{k}].claim_pub = {}", hex(out(&log[3]))));
+        lines.push(format!(
+            "coll.run[{k}].claim_d_pack = {}",
+            hex(pack_words(&o.head_claim))
+        ));
+        lines.push(format!(
+            "coll.run[{k}].head_pack = {}",
+            hex(pack_words(&o.set_root))
+        ));
+        lines.push(format!("coll.run[{k}].n_steps = {}", o.n_steps));
+    }
+    if std::env::var("FP3_PRINT").is_ok() {
+        for l in &lines {
+            println!("FP3 {l}");
+        }
+    }
+    assert_eq!(lines.len(), 6 + 3 + 21);
+}
