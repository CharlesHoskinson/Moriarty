+//! T8b (GP-2): chip set 2, the value set, at the app set. The Halted slice run `unitctor`
+//! (`type U { A(); } entry construct U::A();`) as the producer, and the consumer (type `V`) whose
+//! input value digest is the producer's Halted `vd`. Real proofs with the stock verifier; forged
+//! witnesses are refused (debug checker and the stock verifier on a mutant-prover proof).
+//!
+//! Usage: `value_set OUT_DIR` (with `T6_SLICE_JSON` at the T8b `slice_v1.json`).
+
+use openvm_stark_backend::p3_field::PrimeCharacteristicRing;
+use serde_json::{json, Value};
+use sherlock_leaf::{
+    core::{self, C_VR3, C_VVAL, OP, OT},
+    enc::{val_none, F},
+    harness::{self as sh, Tr},
+    leaf::{self as sl, ProgV},
+};
+
+fn main() {
+    let out = std::path::PathBuf::from(std::env::args().nth(1).expect("OUT_DIR"));
+    std::fs::create_dir_all(&out).unwrap();
+    let eng = sh::engine();
+    let k = sh::key(&eng, sl::airs_set(2, 0)).expect("chip set 2 key (G1 against the app set)");
+    let k0 = sh::key(&eng, sl::airs_set(0, 0)).expect("chip set 0 key");
+    println!("T8BV key chip set 2: {}", k.shape);
+    let kr = [F::ZERO; 8];
+    let pp = sl::program_v(kr, ProgV::P, val_none());
+    let vd = sl::halted_vd(&pp);
+    let pc = sl::program_v(kr, ProgV::C, vd);
+    assert_ne!(pp.adm.prog_d(), pc.adm.prog_d(), "two programs");
+    let mut cases: Vec<Value> = vec![];
+    let mut all = true;
+    for (name, p) in [("producer", &pp), ("consumer", &pc)] {
+        let shs = sl::shards(p);
+        assert_eq!(shs.len(), 1);
+        let tr = sl::traces_set(p, &shs[0], &sl::Build::default(), 2);
+        let r = sh::positive(&eng, &k, &format!("pos_value_{name}"), &tr);
+        all &= r["pass"].as_bool().unwrap();
+        println!("T8BV {} pass={} prove_s={}", r["case"], r["pass"], r["prove_seconds"]);
+        cases.push(r);
+    }
+    // forged witnesses on the producer's shard (each a one-cell change of the honest trace)
+    let shs = sl::shards(&pp);
+    let honest = sl::traces_set(&pp, &shs[0], &sl::Build::default(), 2);
+    let w = core::WIDTH_V;
+    let forge = |f: &dyn Fn(&mut Vec<Tr>)| {
+        let mut t = honest.clone();
+        f(&mut t);
+        t
+    };
+    let mutants: Vec<(&str, Vec<Tr>)> = vec![
+        // the published payload is not the constant's vd (row 2 = post state of the publication)
+        ("value_payload_forged", forge(&|t| t[0].m.values[2 * w + core::C_ST + OP] += F::ONE)),
+        // Halted relabelled as Rejected on the post state
+        ("value_outcome_tag_forged", forge(&|t| t[0].m.values[2 * w + core::C_ST + OT] = F::from_u32(2))),
+        // the constant row vd column changed (ROM lookup and the payload rule)
+        ("value_const_row_vd_forged", forge(&|t| {
+            for r in 0..core::HEIGHT {
+                t[0].m.values[r * w + C_VR3 + 22] += F::ONE;
+            }
+        })),
+        // the consumer's genesis input value changed in the INIT column only (input_d mismatch)
+        ("value_input_vd_forged", forge(&|t| t[0].m.values[C_VVAL] += F::ONE)),
+    ];
+    for (name, tr) in mutants {
+        let d = sh::debug(&eng, &k, &tr);
+        let (p, v, _) = sh::prove(&eng, &k, &tr, true);
+        let refused = d.is_err() && (p.is_err() || v.is_err());
+        all &= refused;
+        println!("T8BV {name} refused={refused} debug={:?}", d.as_ref().err().map(|e| e.chars().take(160).collect::<String>()));
+        cases.push(json!({"case": name, "kind": "mutant", "pass": refused, "debug": format!("{d:?}").chars().take(300).collect::<String>(),
+            "stock_verifier": format!("{v:?}").chars().take(200).collect::<String>()}));
+    }
+    let rec = json!({"all_pass": all, "key_set2": k.shape, "key_set0_pre_hash": format!("{:?}", k0.vk.pre_hash),
+        "vd": vd.iter().map(|x| x.to_string()).collect::<Vec<_>>(), "cases": cases});
+    std::fs::write(out.join("value_set.json"), serde_json::to_string_pretty(&rec).unwrap()).unwrap();
+    println!("T8BV all_pass={all}");
+    assert!(all);
+}
