+    let lp = pvd(&spp, 1);
+    assert_eq!(lp, gp::set_leaf(&cp, &hh(&p3)), "SET LEAF of P");
+    keep("seal_P", &spp, &mut stmts);
+    let (dlv, r) = k.over3(std::slice::from_ref(&spp), gw(gm::DL_LINK_LEAF, Open::Leaf { c: cp, n: hh(&p3) }), None, false);
+    cases.rec("pos_gp2_dl_link_halted_producer", true, r, "DL-STEP input-link element: in_link = claim P, cover LEAF(P)");
+    let dlv = dlv.expect("dl link P");
+    let inc = pc.adm.input_words();
+    assert_eq!(stmt::dig(&inc, 8), vd, "C's input val_d is P's Halted vd");
+    let link = Link { inp: inc.clone(), prog: pp.adm.prog_d(), input: stmt::dig(&hp, 9), outcome: gp::outcome_d(&hp) };
+    let sdc = |link: Option<Link>| GpWit { mode: gm::SEALD, hdr: hc.clone(), open: Open::None, link };
+    let (dep, r) = k.over3(&[c3.clone(), dlv.clone()], sdc(Some(link.clone())), None, false);
+    cases.rec("pos_gp2_b_consumes_a_halted", true, r, "SEAL-WITH-DEPS of C over the link DL: C's input value is P's Halted value (GP-002 (a))");
+    let dep = dep.expect("seal with deps");
+    let dr = pvd(&dep, 1);
+    assert_eq!(dr, gp::set_dep(&cc, &hh(&c3), &lp, &cp), "DEP(claim C, n, LEAF(P), claim P)");
+    keep("dep_C", &dep, &mut stmts);
+    // the producer's claim is openable from the consumer's DEP root: DESCEND to the cover, then a
+    // chain element of P (a nested dependency, `pos_gp2_claim_from_dep_cover`)
+    let (sub_cov, r) = k.over3(std::slice::from_ref(&dep), gw(gm::DESC_DEP, Open::Dep { c: cc, n: hh(&c3), cov: lp, link: cp }), None, false);
+    cases.rec("pos_gp2_descend_dep_cover", true, r, "DESCEND from DEP(C) to its cover LEAF(P)");
