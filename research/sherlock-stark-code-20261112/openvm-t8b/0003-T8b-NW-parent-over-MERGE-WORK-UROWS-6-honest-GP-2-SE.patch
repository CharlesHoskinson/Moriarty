         "keys_d": format!("{:?}", k.table.keys_d()), "keys_d_words": k.table.keys_d().iter().map(|x| x.as_canonical_u32()).collect::<Vec<_>>(), "cut": cut, "keys": k.log, "wall_s": t0.elapsed().as_secs_f64()});
     fs::write(out.join("x7.json"), serde_json::to_string_pretty(&rec).unwrap()).unwrap();
 }
+
+// ------------------------------------------------------------------ T8b: GP-4 parent ladder
+/// Keygen only: a node over the MERGE-WORK key, a node over that, and so on, until the pre-hash
+/// equals N3's (the number of new universal node keys a parent over MERGE-WORK needs).
+fn ladder(out: &PathBuf) {
+    let k = keys();
+    let mut log = vec![];
+    let n3 = k.n3.vk.pre_hash;
+    let mut child = k.work.vk.clone();
+    let mut res = vec![];
+    for i in 1..=4 {
+        let l = layer::<2>(&frozen::INTERNAL, &child, Kind::Node, &format!("node rung {i} over MERGE-WORK"), &mut log);
+        let eq = l.vk.pre_hash == n3;
+        let eqc = l.vk.pre_hash == child.pre_hash;
+        println!("T8BLADDER rung={i} pre_equals_n3={eq} pre_equals_child={eqc} shape={}", shape_json(&frozen::shape(&l.vk)));
+        res.push(json!({"rung": i, "pre_equals_n3": eq, "pre_equals_child": eqc, "shape": shape_json(&frozen::shape(&l.vk))}));
+        child = l.vk.clone();
+        if eq {
+            break;
+        }
+    }
+    fs::write(out.join("ladder.json"), serde_json::to_string_pretty(&json!({"rungs": res, "keys": log})).unwrap()).unwrap();
+}
