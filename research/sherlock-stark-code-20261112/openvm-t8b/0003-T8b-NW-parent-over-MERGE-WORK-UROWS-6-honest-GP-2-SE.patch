+    let (hp, hc) = (hdr_of(&pp), hdr_of(&pc));
+    assert_eq!(hp[0], F::ONE, "P is Halted");
+    assert_eq!(gp::outcome_d(&hp), gp::halted(&vd), "P's outcome is the Halted wrapper of vd");
+    let (cp, cc) = (claim(&pp, &hp), claim(&pc, &hc));
+    let (spp, r) = k.over3(std::slice::from_ref(&p3), seal_w(&hp), None, false);
