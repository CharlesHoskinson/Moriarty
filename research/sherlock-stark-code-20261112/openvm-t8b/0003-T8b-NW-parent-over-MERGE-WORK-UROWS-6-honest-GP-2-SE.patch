+        cases.rec("x7_key_row_forged_refused_by_parent", false, r, "the MERGE-WORK proof with the FV row as its key commitment, under the parent NW");
+    }
     let all = cases.0.iter().all(|c| c["pass"] == true);
     println!("T8X7 all_pass={all} cases={}", cases.0.len());
-    let rec = json!({"all_pass": all, "cases": cases.0, "probe": probe, "output": stmt_out, "work_vkc": format!("{:?}", wv.words()),
