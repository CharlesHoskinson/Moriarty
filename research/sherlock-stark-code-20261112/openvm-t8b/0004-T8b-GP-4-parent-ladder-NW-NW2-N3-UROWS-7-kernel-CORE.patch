+/// T8b (GP-4): the proving form of a kernel CORE trace ([`traces_kernel`] index 0): the step words
+/// `t.pvs` copied into the columns `C_PVK..` of every row, no public values.
+pub fn kernel_core_split(t: &Tr) -> Tr {
+    use crate::core::{C_PVK, WIDTH, WIDTH_SPLIT};
+    assert_eq!(t.pvs.len(), crate::core::pv::N);
+    let h = t.m.values.len() / WIDTH;
+    assert_eq!(h as u32, sherlock_lfr::stmt::STEP_PV_ROWS, "kernel CORE rows = the node's step_pv multiplicity");
+    let mut v = vec![F::ZERO; h * WIDTH_SPLIT];
+    for r in 0..h {
+        v[r * WIDTH_SPLIT..r * WIDTH_SPLIT + WIDTH].copy_from_slice(&t.m.values[r * WIDTH..(r + 1) * WIDTH]);
+        v[r * WIDTH_SPLIT + C_PVK..(r + 1) * WIDTH_SPLIT].copy_from_slice(&t.pvs);
+    }
+    Tr::new(openvm_stark_backend::p3_matrix::dense::RowMajorMatrix::new(v, WIDTH_SPLIT))
+}
