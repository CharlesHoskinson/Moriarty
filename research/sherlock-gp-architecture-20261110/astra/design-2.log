   481	    /// Given the actual fixed bases, resolves the fixed-base part of the MSM
   482	    /// by pairing each named scalar with its base and moving them to regular
   483	    /// variable-base entries.
   484	    ///
   485	    /// After this call, `fixed_base_scalars` becomes empty.
   486	    ///
   487	    /// # Panics
   488	    ///
   489	    /// If some of the keys in `fixed_base_scalars` do not appear in the
   490	    /// provided `fixed_bases` map.
   491	    pub fn resolve_fixed_bases(&mut self, fixed_bases: &BTreeMap<String, S::AssignedPoint>) {
   492	        for (name, scalar) in &self.fixed_base_scalars {
   493	            let base = fixed_bases
   494	                .get(name)
   495	                .unwrap_or_else(|| panic!("Fixed base not provided: {name}"));
   496	            self.bases.push(base.clone());
   497	            self.scalars.push(scalar.clone());
   498	        }
   499	        self.fixed_base_scalars.clear();
   500	    }
