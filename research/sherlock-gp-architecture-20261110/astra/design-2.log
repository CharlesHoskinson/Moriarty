   244	        let transcript_repr = self.scalar_chip.assign_fixed(layouter, transcript_repr_constant)?;
   245	        // We expect a finalized cs with no selectors, i.e. whose selectors have been
   246	        // converted into fixed columns.
   247	        let selectors = vec![vec![false]; cs.num_selectors()];
   248	        let (processed_cs, _) = cs.clone().directly_convert_selectors_to_fixed(selectors);
   249	
   250	        let assigned_vk = AssignedVk {
   251	            vk_name: vk_name.to_string(),
   252	            domain: domain.clone(),
   253	            cs: processed_cs,
   254	            transcript_repr,
   255	        };
