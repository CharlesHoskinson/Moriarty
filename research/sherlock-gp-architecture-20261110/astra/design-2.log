    79	        Ok(self.preprocess(preimage)?.pi_skips)
    80	    }
    81	
    82	    async fn prove(
    83	        &self,
    84	        rng: impl Rng + CryptoRng,
    85	        params: &impl ParamsProverProvider,
    86	        pk: ProverKey<Self>,
    87	        preimage: &ProofPreimage,
    88	    ) -> Result<(Proof, Vec<Fr>, Vec<Option<usize>>), ProvingError> {
    89	        use midnight_zk_stdlib::prove;
    90	
    91	        let params_k = params.get_params(pk.init()?.k()).await?;
    92	        let preproc = self.preprocess(preimage)?;
    93	        let pis = preproc.pis.clone();
    94	        let pi_skips = preproc.pi_skips.clone();
    95	
    96	        let pk = pk
    97	            .init()
    98	            .map_err(|_| anyhow::anyhow!("Could not init pk"))?;
    99	
   100	        let proof = prove::<_, TranscriptHash>(params_k.as_ref(), &pk, self, &pis, preproc, rng)?;
   101	
   102	        Ok((Proof(proof), pis.into_iter().map(Fr).collect(), pi_skips))
   103	    }
   104	
   105	    fn k(&self) -> u8 {
   106	        midnight_zk_stdlib::optimal_k(self) as u8
   107	    }
