   471	    /// Whether the MSM is a single base-scalar pair with no fixed-base scalars
   472	    /// left, as [`collapse`](Self::collapse) after
   473	    /// [`resolve_fixed_bases`](Self::resolve_fixed_bases) leaves it.
   474	    ///
   475	    /// This is a check on the shape only: the value of the scalar is a witness
   476	    /// and is not inspected.
   477	    pub fn is_collapsed(&self) -> bool {
   478	        self.bases.len() == 1 && self.scalars.len() == 1 && self.fixed_base_scalars.is_empty()
   479	    }
