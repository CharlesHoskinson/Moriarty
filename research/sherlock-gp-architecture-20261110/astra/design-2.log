    92	pub(crate) fn rd(section: &'static str, value: u128) -> C6Result<usize> {
    93	    usize::try_from(value).map_err(|_| C6PhysError::UsizeOverflow { section, value })
    94	}
    95	pub(crate) fn rd_bool(section: &'static str, value: u128) -> C6Result<bool> {
    96	    match value {
    97	        0 => Ok(false),
    98	        1 => Ok(true),
    99	        _ => Err(C6PhysError::BadBool { section, value }),
   100	    }
   101	}
   102	/// Lanes `from..to` must be zero; `lane` is an index into `lanes`.
   103	pub(crate) fn zero(section: &'static str, lanes: &[u128], from: usize, to: usize) -> C6Result<()> {
   104	    for (lane, &value) in lanes.iter().enumerate().take(to).skip(from) {
   105	        if value != 0 {
   106	            return Err(C6PhysError::NonZeroPadding {
   107	                section,
   108	                lane,
   109	                value,
   110	            });
   111	        }
   112	    }
