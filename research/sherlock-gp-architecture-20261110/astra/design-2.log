   204	impl<S: SelfEmulation> VerifierGadget<S> {
   205	    /// Assigns a verifying key as a public input. All the necessary information
   206	    /// is required off-circuit, except for the `transcript_repr` value.
   207	    pub fn assign_vk_as_public_input(
   208	        &self,
   209	        layouter: &mut impl Layouter<S::F>,
   210	        vk_name: &str,
   211	        domain: &EvaluationDomain<S::F>,
   212	        cs: &ConstraintSystem<S::F>,
   213	        transcript_repr_value: Value<S::F>,
   214	    ) -> Result<AssignedVk<S>, Error> {
   215	        let transcript_repr: AssignedNative<S::F> =
   216	            self.scalar_chip.assign_as_public_input(layouter, transcript_repr_value)?;
   217	
   218	        // We expect a finalized cs with no selectors, i.e. whose selectors have been
   219	        // converted into fixed columns.
   220	        let selectors = vec![vec![false]; cs.num_selectors()];
   221	        let (processed_cs, _) = cs.clone().directly_convert_selectors_to_fixed(selectors);
   222	
   223	        let assigned_vk = AssignedVk {
   224	            vk_name: vk_name.to_string(),
   225	            domain: domain.clone(),
   226	            cs: processed_cs,
   227	            transcript_repr,
   228	        };
   229	
   230	        Ok(assigned_vk)
   231	    }
