   110	        &self,
   111	        params: &impl ParamsProverProvider,
   112	    ) -> Result<transient_crypto::proofs::VerifierKey, anyhow::Error> {
   113	        use midnight_zk_stdlib::setup_vk;
   114	        Ok(transient_crypto::proofs::VerifierKey::from(setup_vk(
   115	            params.get_params(self.k()).await?.as_ref(),
   116	            self,
   117	        )))
   118	    }
   119	
   120	    async fn keygen(
   121	        &self,
   122	        params: &impl ParamsProverProvider,
   123	    ) -> Result<(ProverKey<Self>, transient_crypto::proofs::VerifierKey), anyhow::Error> {
   124	        use midnight_zk_stdlib::{setup_pk, setup_vk};
   125	        let vk = setup_vk(params.get_params(self.k()).await?.as_ref(), self);
   126	        let pk = setup_pk(self, &vk);
   127	        Ok((
   128	            ProverKey::from_raw(pk),
   129	            transient_crypto::proofs::VerifierKey::from(vk),
   130	        ))
