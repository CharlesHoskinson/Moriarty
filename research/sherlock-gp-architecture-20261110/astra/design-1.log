   352	        self.lhs.collapse(layouter, curve_chip, scalar_chip)?;
   353	        self.rhs.collapse(layouter, curve_chip, scalar_chip)
   354	    }
   355	
   356	    /// Whether both sides are collapsed and fixed-base-resolved; see
   357	    /// [`AssignedMsm::is_collapsed`].
   358	    pub fn is_collapsed(&self) -> bool {
   359	        self.lhs.is_collapsed() && self.rhs.is_collapsed()
   360	    }
   361	
   362	    /// Given the actual fixed bases, resolves the fixed-base part of the
   363	    /// internal MSMs by pairing each named scalar with its base and moving
   364	    /// them to regular variable-base entries.
   365	    ///
   366	    /// After this call, `fixed_base_scalars` of each internal MSM becomes
   367	    /// empty.
   368	    ///
   369	    /// # Panics
   370	    ///
   371	    /// If some of the keys in `fixed_base_scalars` from the internal MSMs do
   372	    /// not appear in the provided `fixed_bases` map.
   373	    pub fn resolve_fixed_bases(&mut self, fixed_bases: &BTreeMap<String, S::AssignedPoint>) {
   374	        self.lhs.resolve_fixed_bases(fixed_bases);
   375	        self.rhs.resolve_fixed_bases(fixed_bases);
   376	    }
   377	
   378	    /// Accumulates several accumulators together. The resulting acc will
   379	    /// satisfy the invariant iff all the accumulators individually do.
   380	    pub fn accumulate(
   381	        layouter: &mut impl Layouter<S::F>,
   382	        acc_pi_chip: &impl PublicInputInstructions<S::F, AssignedAccumulator<S>>,
   383	        scalar_chip: &S::ScalarChip,
   384	        sponge_chip: &S::SpongeChip,
   385	        accs: &[Self],
   386	    ) -> Result<Self, Error> {
   387	        let hash_input = accs
   388	            .iter()
   389	            .map(|acc| acc_pi_chip.as_public_input(layouter, acc))
   390	            .collect::<Result<Vec<_>, Error>>()?
   391	            .into_iter()
   392	            .flatten()
   393	            .collect::<Vec<_>>();
   394	
   395	        let r = sponge_chip.hash(layouter, &hash_input)?;
   396	        #[cfg(feature = "truncated-challenges")]
   397	        let rs = truncated_powers::<S::F>(layouter, scalar_chip, &r, accs.len())?;
   398	        #[cfg(not(feature = "truncated-challenges"))]
   399	        let rs = powers::<S::F>(layouter, scalar_chip, &r, accs.len())?
   400	            .iter()
   401	            .map(|ri| AssignedBoundedScalar::new(ri, None))
   402	            .collect::<Vec<_>>();
   403	
   404	        let mut acc = accs[0].clone();
   405	        for (other, ri) in accs.iter().zip(rs).skip(1) {
   406	            acc.lhs = acc.lhs.accumulate_with_r(layouter, scalar_chip, &other.lhs, &ri)?;
   407	            acc.rhs = acc.rhs.accumulate_with_r(layouter, scalar_chip, &other.rhs, &ri)?;
   408	        }
   409	
   410	        Ok(acc)
   411	    }
   412	}

