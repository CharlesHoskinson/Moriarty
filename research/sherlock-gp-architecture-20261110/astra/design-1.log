   162	/// Wrapper over the MSM function to use the blstrs underlying function
   163	pub fn msm_specific<C: CurveAffine>(coeffs: &[C::Scalar], bases: &[C::Curve]) -> C::Curve {
   164	    // We remove zeros (keep only non-zero coefficients)
   165	    let (coeffs, bases): (Vec<C::Scalar>, Vec<C::Curve>) = coeffs
   166	        .iter()
   167	        .zip(bases)
   168	        .filter(|(s, _)| !s.is_zero_vartime())
   169	        .map(|(s, b)| (*s, *b))
   170	        .unzip();
   171	
   172	    if coeffs.is_empty() {
   173	        return C::Curve::identity();
   174	    }
   175	
   176	    // For BLS12-381 G1 always use blst's Pippenger. The former cut-over to
   177	    // `msm_best` above 2^19 terms ("blst regresses above 2^18") no longer holds,
   178	    // and `msm_best` pays the `from_xy` subgroup check introduced in
   179	    // midnight-curves 0.3.1 once per base and once per bucket, which makes it
   180	    // several times slower on large MSMs.
   181	    if TypeId::of::<C>() == TypeId::of::<midnight_curves::G1Affine>() {
   182	        // Safe: we just checked type
   183	        let coeffs_slice = coeffs.as_slice();
   184	        let bases_slice = bases.as_slice();
   185	        let coeffs = unsafe { &*(coeffs_slice as *const _ as *const [Fq]) };
   186	        let bases = unsafe { &*(bases_slice as *const _ as *const [G1Projective]) };
   187	        let res = G1Projective::multi_exp(bases, coeffs);
   188	        unsafe { std::mem::transmute_copy(&res) }
   189	    } else {
   190	        let mut affine_bases = vec![C::identity(); coeffs.len()];
   191	        C::Curve::batch_normalize(&bases, &mut affine_bases);
   192	        msm_best(&coeffs, &affine_bases)
   193	    }
   194	}
