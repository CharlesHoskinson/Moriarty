   135	impl<S: SelfEmulation> VerifierGadget<S> {
   136	    /// Constrains the given accumulator as a public input. The (fixed and
   137	    /// non-fixed) scalars of its RHS are constrained in committed form (as a
   138	    /// committed instance), whereas the rest of the accumulator is constrained
   139	    /// as a normal instance.
   140	    ///
   141	    /// See [AssignedAccumulator::as_public_input_with_committed_scalars] for
   142	    /// the off-circuit analog of this function.
   143	    pub fn constrain_acc_as_public_input_with_committed_scalars(
   144	        &self,
   145	        layouter: &mut impl Layouter<S::F>,
   146	        acc: &AssignedAccumulator<S>,
   147	    ) -> Result<(), Error> {
   148	        (acc.lhs).constrain_as_public_input(layouter, &self.curve_chip, &self.scalar_chip)?;
   149	        (acc.rhs).constrain_as_public_input_with_committed_scalars(
   150	            layouter,
   151	            &self.curve_chip,
   152	            &self.scalar_chip,
   153	        )
   154	    }
   155	
   156	    /// Witnesses an accumulator with just 1 non-fixed base-scalar pair on each
   157	    /// side (the scalar being constant 1), and as many fixed-base scalars (on
   158	    /// its right-hand-side) as provided through the `fixed_base_names`
   159	    /// argument (no fixed-base scalars on the left-hand-side).
   160	    pub fn assign_collapsed_accumulator(
   161	        &self,
   162	        layouter: &mut impl Layouter<S::F>,
   163	        fixed_base_names: &[String],
   164	        value: Value<Accumulator<S>>,
   165	    ) -> Result<AssignedAccumulator<S>, Error> {
   166	        let mut acc = AssignedAccumulator::assign(
   167	            layouter,
   168	            &self.curve_chip,
   169	            &self.scalar_chip,
   170	            1,
   171	            1,
   172	            &[],
   173	            fixed_base_names,
   174	            value,
   175	        )?;
   176	
   177	        let scalar_chip = &self.scalar_chip;
   178	
   179	        scalar_chip.assert_equal_to_fixed(layouter, &acc.lhs.scalars[0].scalar, S::F::ONE)?;
   180	        scalar_chip.assert_equal_to_fixed(layouter, &acc.rhs.scalars[0].scalar, S::F::ONE)?;
   181	        acc.lhs.scalars[0].bound = BigUint::one();
   182	        acc.rhs.scalars[0].bound = BigUint::one();
   183	
   184	        Ok(acc)
   185	    }
   186	
   187	    /// Accumulates several accumulators together. The resulting acc will
   188	    /// satisfy the invariant iff all the accumulators individually do.
   189	    pub fn accumulate(
   190	        &self,
   191	        layouter: &mut impl Layouter<S::F>,
   192	        accs: &[AssignedAccumulator<S>],
   193	    ) -> Result<AssignedAccumulator<S>, Error> {
   194	        AssignedAccumulator::<S>::accumulate(
   195	            layouter,
   196	            self,
   197	            &self.scalar_chip,
   198	            &self.sponge_chip,
   199	            accs,
   200	        )
   201	    }
   202	}
