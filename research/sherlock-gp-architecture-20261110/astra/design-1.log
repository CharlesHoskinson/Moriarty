  1231	  trivial : A
  1232	  accumulate : List A → A
  1233	  scale : Bool → A → A
  1234	  scale_true : ∀ a, scale true a = a
  1235	  collapse : A → A
  1236	  /-- Collapse after scale: a zero-scaled accumulator collapses to the trivial encoding, whatever
  1237	  bases it was parsed with (`AssignedAccumulator::collapse` after `scale_by_bit`, SHKIVC05). -/
  1238	  collapse_scale_false : ∀ a, collapse (scale false a) = trivial
  1239	  valid : A → Prop
  1240	  valid_collapse : ∀ a, valid (collapse a) ↔ valid a
  1241	  valid_trivial : valid trivial
  1242	  /-- Fold soundness and completeness (SRC-005/006 premise): the fold passes the pairing check iff
  1243	  every input does. -/
  1244	  valid_accumulate : ∀ l, valid (accumulate l) ↔ ∀ a ∈ l, valid a
  1245	
  1246	/-- The node fold of realization (a): the previous-proof and the carried accumulator, each
  1247	scaled by `not_genesis` and collapsed, then the leaf accumulator; the result is collapsed. -/
  1248	def AccAlgebra.nodeFold {A : Type} (alg : AccAlgebra A) (notGenesis : Bool)
  1249	    (proofAcc carried leaf : A) : A :=
  1250	  alg.collapse (alg.accumulate
  1251	    [alg.collapse (alg.scale notGenesis proofAcc), alg.collapse (alg.scale notGenesis carried),
  1252	      leaf])
  1253	
  1254	/-- **L-D, SRC-005 genesis (realization (a)).** At genesis (`not_genesis = 0`) both the
  1255	previous-proof accumulator and the carried accumulator collapse to the trivial encoding before
  1256	the fold. The folded accumulator therefore equals the fold of `[trivial, trivial, leaf]`: it does
  1257	not depend on either witness-supplied accumulator (nor, therefore, does the fold challenge), and
  1258	it passes the pairing check iff the leaf accumulator does, so no unauthenticated deferred
  1259	obligation enters at genesis. Task 2.3 cites this lemma. -/
  1260	theorem genesis_collapse_both {A : Type} (alg : AccAlgebra A) (proofAcc carried leaf : A) :
  1261	    alg.nodeFold false proofAcc carried leaf =
  1262	      alg.collapse (alg.accumulate [alg.trivial, alg.trivial, leaf]) ∧
  1263	    (alg.valid (alg.nodeFold false proofAcc carried leaf) ↔ alg.valid leaf) := by
  1264	  have h : alg.nodeFold false proofAcc carried leaf =
  1265	      alg.collapse (alg.accumulate [alg.trivial, alg.trivial, leaf]) := by
  1266	    simp only [AccAlgebra.nodeFold, alg.collapse_scale_false]
