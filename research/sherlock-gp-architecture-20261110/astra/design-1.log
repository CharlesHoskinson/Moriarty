   204	impl<S: SelfEmulation> VerifierGadget<S> {
   205	    /// Assigns a verifying key as a public input. All the necessary information
   206	    /// is required off-circuit, except for the `transcript_repr` value.
   207	    pub fn assign_vk_as_public_input(
   208	        &self,
   209	        layouter: &mut impl Layouter<S::F>,
   210	        vk_name: &str,
   211	        domain: &EvaluationDomain<S::F>,
   212	        cs: &ConstraintSystem<S::F>,
   213	        transcript_repr_value: Value<S::F>,
   214	    ) -> Result<AssignedVk<S>, Error> {
   215	        let transcript_repr: AssignedNative<S::F> =
   216	            self.scalar_chip.assign_as_public_input(layouter, transcript_repr_value)?;
   217	
   218	        // We expect a finalized cs with no selectors, i.e. whose selectors have been
   219	        // converted into fixed columns.
   220	        let selectors = vec![vec![false]; cs.num_selectors()];
   221	        let (processed_cs, _) = cs.clone().directly_convert_selectors_to_fixed(selectors);
   222	
   223	        let assigned_vk = AssignedVk {
   224	            vk_name: vk_name.to_string(),
   225	            domain: domain.clone(),
   226	            cs: processed_cs,
   227	            transcript_repr,
   228	        };
   229	
   230	        Ok(assigned_vk)
   231	    }
   232	
   233	    /// Assigns a verifying key as a constant. All the necessary information is
   234	    /// available off-circuit, except for the `transcript_repr` which is
   235	    /// "assigned fixed".
   236	    pub fn assign_fixed_vk(
   237	        &self,
   238	        layouter: &mut impl Layouter<S::F>,
   239	        vk_name: &str,
   240	        domain: &EvaluationDomain<S::F>,
   241	        cs: &ConstraintSystem<S::F>,
   242	        transcript_repr_constant: S::F,
   243	    ) -> Result<AssignedVk<S>, Error> {
   244	        let transcript_repr = self.scalar_chip.assign_fixed(layouter, transcript_repr_constant)?;
   245	        // We expect a finalized cs with no selectors, i.e. whose selectors have been
   246	        // converted into fixed columns.
   247	        let selectors = vec![vec![false]; cs.num_selectors()];
   248	        let (processed_cs, _) = cs.clone().directly_convert_selectors_to_fixed(selectors);
   249	
   250	        let assigned_vk = AssignedVk {
   251	            vk_name: vk_name.to_string(),
   252	            domain: domain.clone(),
   253	            cs: processed_cs,
   254	            transcript_repr,
   255	        };
   256	
   257	        Ok(assigned_vk)
   258	    }
   259	}
