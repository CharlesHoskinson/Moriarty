   148	            _ => return Err(failure("Halted result is not a UInt constant.")),
   149	        },
   150	        OutcomeC::Halted {
   151	            value: RefC::Data(i),
   152	        } => match host.image.data.get(i) {
   153	            Some(DataSnapshot::U128 { n }) => *n,
   154	            _ => return Err(failure("Halted result is not a UInt data value.")),
   155	        },
   156	        other => return Err(failure(format!("Run did not halt with a UInt: {other:?}."))),
   157	    };
   158	    Ok(StateOutcome::halted(result))
   159	}
