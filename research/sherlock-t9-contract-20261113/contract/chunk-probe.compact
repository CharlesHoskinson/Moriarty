pragma language_version >= 0.22;
import CompactStandardLibrary;
export ledger anchor: Field;
export ledger x: Field;
export circuit c(a_out: Field, v: Field): [] {
  assert(anchor != (0 as Field), "anchor unset");
  anchor = disclose(a_out);
  x = disclose(v);
}
export circuit o(v: Field): [] {
  assert(anchor != (0 as Field), "anchor unset");
  x = disclose(v);
}
