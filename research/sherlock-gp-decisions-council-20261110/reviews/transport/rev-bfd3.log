   561	        // 5. Fold, collapse, publish.
   562	        let mut next = verifier.accumulate(l, &[proof_acc, prev_acc, leaf_acc])?;
   563	        next.collapse(l, bls, scalar)?;
   564	        verifier.constrain_as_public_input(l, &next)
