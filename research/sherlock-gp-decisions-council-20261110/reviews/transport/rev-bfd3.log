   378	/// SRC-005 realization (a): at genesis no previous proof authenticates the carried
   379	/// accumulator (its proof is scaled away), so its public encoding `lanes` must equal the
   380	/// neutral encoding of `trivial_acc`: `is_genesis * (lane - neutral) == 0` for every lane.
   381	/// `accumulate` hashes exactly these lanes, so at genesis the fold challenge and the folded
   382	/// value depend on the leaf alone: no grinding and no cancellation through the carry.
   383	pub fn constrain_genesis_neutral(
   384	    std: &ZkStdLib,
   385	    l: &mut impl Layouter<F>,
   456	    fn circuit(
   457	        &self,
   458	        std: &ZkStdLib,
   459	        l: &mut impl Layouter<F>,
   460	        _instance: Value<Vec<F>>,
   461	        witness: Value<IvcWitness>,
   462	    ) -> Result<(), Error> {
   463	        let verifier = std.verifier();
   464	        let bls = std.bls12_381();
   465	        let scalar = bls.scalar_field_chip();
   466	
   467	        // 1. Own key as public input (public lane 0).
   468	        let self_vk: AssignedVk<S> = verifier.assign_vk_as_public_input(
   469	            l,
   470	            SELF_NAME,
   471	            &self.self_domain,
   472	            &self.self_cs,
   473	            witness.as_ref().map(|w| w.self_repr),
   474	        )?;
   475	
   476	        // 2. Previous state, transition and new public state.
   477	        let wf = |f: fn(&IvcWitness) -> F| witness.as_ref().map(f);
   478	        let prog_d: AssignedNative<F> = std.assign(l, wf(|w| w.prev.prog_d))?;
   479	        let init_d: AssignedNative<F> = std.assign(l, wf(|w| w.prev.init_d))?;
   480	        let prev_d: AssignedNative<F> = std.assign(l, wf(|w| w.prev.cur_d))?;
   481	        let raw = self.raw_heights;
   482	        let prev_h: AssignedNative<F> = std.assign(
   483	            l,
   484	            witness
   485	                .as_ref()
   486	                .map(|w| raw.map_or(F::from(w.prev.h), |r| r.0)),
   487	        )?;
   488	        let cur_d: AssignedNative<F> = std.assign(l, wf(|w| w.cur_d))?;
   489	        let rule: AssignedNative<F> = std.assign(l, wf(|w| w.rule))?;
   490	        let binding: AssignedNative<F> = std.assign(l, wf(|w| w.leaf_binding))?;
   491	        let steps: AssignedNative<F> = std.assign(
   492	            l,
   493	            witness
   494	                .as_ref()
   495	                .map(|w| raw.map_or(F::from(w.leaf_steps), |r| r.1)),
   496	        )?;
   497	        let h = constrain_heights(std, l, &prev_h, &steps)?;
   498	        let is_genesis = std.is_zero(l, &prev_h)?;
   499	        let not_genesis = std.not(l, &is_genesis)?;
   500	        let chosen = std.select(l, &is_genesis, &init_d, &prev_d)?;
   501	        std.assert_equal(l, &chosen, &prev_d)?;
   502	        for x in [&prog_d, &init_d, &cur_d, &h] {
   503	            std.constrain_as_public_input(l, x)?;
   504	        }
   505	
   506	        // 3. Previous node proof under the self key; scaled away at genesis.
   507	        let prev_acc = AssignedAccumulator::<S>::assign(
   508	            l,
   509	            bls,
   510	            scalar,
   511	            1,
   512	            1,
   513	            &[],
   514	            &self.self_base_names(),
   515	            witness.as_ref().map(|w| w.prev_acc.clone()),
   516	        )?;
   517	        let prev_acc_pi = verifier.as_public_input(l, &prev_acc)?;
   518	        let neutral =
   519	            <AssignedAccumulator<S> as Instantiable<F>>::as_public_input(&self.trivial_acc());
   520	        constrain_genesis_neutral(std, l, &is_genesis, &prev_acc_pi, &neutral)?;
   521	        constrain_collapsed_carry(std, l, &prev_acc_pi, self.carry_scalar_lanes())?;
   522	        let mut prev_pi = verifier.as_public_input(l, &self_vk)?;
   523	        prev_pi.extend([
   524	            prog_d.clone(),
   525	            init_d.clone(),
   526	            prev_d.clone(),
   527	            prev_h.clone(),
   528	        ]);
   529	        prev_pi.extend(prev_acc_pi);
   530	        let id = bls.assign_fixed(l, C::identity())?;
   531	        let mut proof_acc = verifier.prepare(
   532	            l,
   533	            &self_vk,
   534	            &[id],
   535	            &[prev_pi.as_slice()],
   536	            witness.as_ref().map(|w| w.prev_proof.clone()),
   537	        )?;
   538	        AssignedAccumulator::scale_by_bit(l, scalar, &not_genesis, &mut proof_acc)?;
   539	        // Collapsed before the fold. `accumulate` derives its challenge from a hash of every
   540	        // folded accumulator's full encoding, bases included. Scaled by zero at genesis, the
   541	        // uncollapsed accumulator still carries the bases parsed from the (absent) previous
   542	        // proof, so the challenge would depend on them and could not match `next_acc`, which
   543	        // uses `trivial_acc` there. Collapsed, it is (identity, 1, zero fixed scalars): exactly
   544	        // `trivial_acc`. The leaf accumulator stays uncollapsed (its shape is fixed by the
