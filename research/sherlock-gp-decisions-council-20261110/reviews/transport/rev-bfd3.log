    10	//     transcript; the decider binds those read values to the proved run, so a proof
    11	//     of another program or initial state is refused by the ledger;
    12	//   - stmt = H(SHK_RUN, prog_d, init_d, fin_d, n_steps, result) is recorded once;
    13	//   - result is written to the public ledger field `result`.
    14	// The communication commitment is Poseidon(comm_rand, stmt, p, i, steps, fin, r) over
    15	// the inputs below, bound in the decider.
    16	pragma language_version >= 0.22;
    17	import CompactStandardLibrary;
    18	
    19	// Field order is the state layout: result first, so its byte window does not move
    20	// when runs grows. The result is 16 big-endian bytes: the ledger trims trailing zero
    21	// bytes of a value, so a big-endian u128 whose low byte is nonzero keeps a fixed
    22	// 16-byte window (holdout layout encoding u128-be).
    23	export ledger result: Bytes<16>;           // big-endian u128 result of the last accepted run
    24	export ledger steps: Uint<64>;             // machine steps of the last accepted run
    25	export sealed ledger program_d: Field;     // program-image digest (Poseidon)
    26	export sealed ledger init_d: Field;        // admitted initial-state digest (Poseidon)
    27	export ledger runs: Set<Field>;            // accepted run statements
    28	
    29	constructor(prog: Field, init: Field, r0: Bytes<16>) {
    30	  const p = disclose(prog);
    31	  const i = disclose(init);
    32	  assert(p != (0 as Field), "zero program digest");
    33	  assert(i != (0 as Field), "zero initial digest");
    34	  program_d = p;
    35	  init_d = i;
    36	  result = disclose(r0);
    37	  steps = 0;
    38	}
    39	
    40	export circuit acceptRun(stmt: Field, p: Field, i: Field, n: Uint<64>, fin: Field, r: Bytes<16>): [] {
    41	  assert(program_d == disclose(p), "program digest differs");
    42	  assert(init_d == disclose(i), "initial digest differs");
    43	  assert(!runs.member(disclose(stmt)), "run already accepted");
    44	  runs.insert(disclose(stmt));
    45	  steps = disclose(n);
    46	  result = disclose(r);
    47	}

