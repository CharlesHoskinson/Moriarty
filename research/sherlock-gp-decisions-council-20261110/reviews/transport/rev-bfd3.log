   359	/// SRC-004 height checks; returns `h = prev_h + steps`. Heights are integers below 2^64,
   360	/// `1 <= steps <= S_MAX` (as `steps - 1` in `[0, S_MAX)`, one check for both bounds), and the
   361	/// sum is checked again, so `h` is the integer `prev_h + steps < 2^64`, `h >= 1`, and `h`
   362	/// cannot wrap to 0 (which would set `is_genesis` on a later step and drop the previous proof).
   363	pub fn constrain_heights(
   364	    std: &ZkStdLib,
   365	    l: &mut impl Layouter<F>,
   366	    prev_h: &AssignedNative<F>,
   367	    steps: &AssignedNative<F>,
   368	) -> Result<AssignedNative<F>, Error> {
   369	    let h_bound = BigUint::from(1u8) << H_BITS;
   370	    std.assert_lower_than_fixed(l, prev_h, &h_bound)?;
   371	    let steps_m1 = std.add_constant(l, steps, -F::ONE)?;
   372	    std.assert_lower_than_fixed(l, &steps_m1, &BigUint::from(S_MAX))?;
   373	    let h = std.add(l, prev_h, steps)?;
   374	    std.assert_lower_than_fixed(l, &h, &h_bound)?;
   375	    Ok(h)
   376	}
