language "moriarty/1";
agreement InputBoundQuotes {
  action quote(units: UInt, flat: UInt) {
    let subtotal = units * 11;
    emit "quoted"(subtotal - flat);
  }
  action inspect(right: UInt, approved: Bool, left: UInt) {
    let low = left < right;
    let eligible = approved and low;
    emit "eligible"(eligible);
  }
}
