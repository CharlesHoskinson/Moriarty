language "moriarty/2";
agreement LegacyRegistryMetadata {
  asset UNIT = { network: "local", issuer: "metadata-only", reference: "UNIT", scale: 3 };
  action later() {
    liability("zeta", UNIT, "dora", "erin", 0);
  }
  action earlier() {
    liability("alpha", UNIT, "alice", "bob", 0);
    liability("zeta", UNIT, "dora", "erin", 1);
  }
}
