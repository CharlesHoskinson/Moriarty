language "moriarty/1";
agreement IndependentPayment {
  state paid: UInt = 0;
  asset USD = { network: "local", issuer: "issuer", reference: "usd", scale: 2 };
  action pay(amount: UInt, accepted: Bool) {
    requires accepted;
    requires amount > 0;
    transfer(USD, "payer", "recipient", amount);
    fee(USD, "payer", "sponsor", 2);
    next paid = paid + amount;
    emit "receipt"(paid);
  }
}
