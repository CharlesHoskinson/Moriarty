---
source: crates/mori-source6/tests/transfer.rs
description: "Code:\n\nprofile \"moriarty-beta/1\";\nagreement Invoice {\n domain Preview = { id: \"Midnight\", chain: \"midnight\", network: \"preview\" };\n account Buyer = { domain: Preview, id: \"Owner\" };\n account Seller = { domain: Preview, id: \"Recipient\" };\n account Treasury = { domain: Preview, id: \"Fee\" };\n asset USD = { domain: Preview, id: \"A\", scale: 2, representation: \"canonical\", symbol: \"USD\" };\n const price: Qty<USD> = 10.00 USD;\n const fee = 0.10 USD;\n intent Payment = {\n  domain: Preview, asset: USD, signer: Buyer, key: \"key1\", nonce: \"n1\", pre_head: \"h0\",\n  valid: rounds(domain: Preview, from: 0, to: 10), gross_cap: price + fee, fee_cap: fee, net_floor: price,\n  operation: transfer(from: Buyer, to: Seller, fee_to: Treasury, value: price, fee: fee),\n  source_hash: \"src1\", policy_digest: \"policy1\", failure: SuccessOnly,\n  observations: [], disclosures: [], retained_effects: [], retained_duties: [], delegation: None, recovery: None,\n };\n action pay uses Payment;\n}\n"
---
profile "moriarty-financial-agreement-source/6";
agreement Invoice {
domain Midnight;
settlement A scale 2;
selected TransferLiteralFee source_hash "src1" digest "policy1";
intent {
signer Owner key "key1";
nonce "n1";
pre_head "h0";
valid 0..10;
gross_cap 1010;
fee_cap 10;
net_floor 1000;
failure success_only;
signed_action transfer from Owner to Recipient fee_to Fee value 1000 fee 10;
observations empty;
disclosures empty;
retained_effects empty;
retained_duties empty;
delegation none;
recovery none;
}
authenticated {
head "h0";
predecessor "genesis";
round 1;
balance Owner 10000;
balance Recipient 0;
balance Fee 0;
allowance Owner remaining 10000 spent 0;
replay unused;
work_remaining 10;
work_spent 0;
}
submit transfer from Owner to Recipient fee_to Fee value 1000 fee 10;
effects {
debit Owner 1010;
credit Recipient 1000;
credit Fee 10;
use_allowance Owner 1010;
use_replay "n1";
advance_head "h0" "h1";
}
post_head "h1";
}
