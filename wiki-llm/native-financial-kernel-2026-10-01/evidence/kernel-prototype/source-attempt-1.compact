pragma language_version >= 0.27 && <= 0.27;
import CompactStandardLibrary;
export { Secp256k1EcdsaSignature };
circuit configuredKey(pk: Secp256k1Point): [] {
 assert(pk != default<Secp256k1Point>, "IDENTITY_KEY");
 assert((secp256k1PointX(pk) as Bytes<32>) == Bytes[171,40,63,143,116,250,8,170,157,219,54,181,48,124,233,40,217,232,241,246,13,177,180,52,88,32,182,227,42,200,115,108], "SOURCE_SEC1_X");
 assert((secp256k1PointY(pk) as Bytes<32>) == Bytes[92,113,182,219,243,70,189,130,102,27,76,68,72,95,89,11,125,9,142,156,5,197,21,148,15,110,55,176,147,105,52,61], "SOURCE_SEC1_Y_PARITY");
}
circuit canonicalSignature(sig: Secp256k1EcdsaSignature): [] {
 const sb: Bytes<32> = sig.s as Bytes<32>;
 const hi: Uint<128> = slice<16>(sb, 16) as Uint<128>;
 const lo: Uint<128> = slice<16>(sb, 0) as Uint<128>;
 assert(hi < 170141183460469231731687303715884105727 || (hi == 170141183460469231731687303715884105727 && lo <= 124072173638108635037164174234284138656), "HIGH_S");
 assert(sig.r != (0 as Secp256k1Scalar) && sig.s != (0 as Secp256k1Scalar), "ZERO_SIGNATURE");
}
