 use crate::*;
-pub(crate) fn sha(bytes: &[u8]) -> String { format!("{:x}", Sha256::digest(bytes)) }
+pub(crate) fn sha(bytes: &[u8]) -> String {
+    // Encode digest bytes; sha2 0.11's array does not implement LowerHex.
+    // Keep the frozen dependency graph: hex is not a direct dependency.
+    let digest = Sha256::digest(bytes);
+    let alphabet = b"0123456789abcdef";
+    let mut encoded = String::with_capacity(digest.len() * 2);
+    for byte in digest.iter() {
+        encoded.push(alphabet[(*byte >> 4) as usize] as char);
+        encoded.push(alphabet[(*byte & 15) as usize] as char);
+    }
+    encoded
+}
