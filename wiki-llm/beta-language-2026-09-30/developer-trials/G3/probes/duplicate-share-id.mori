profile "moriarty-beta/1";
agreement DuplicateShareId {
  domain HomeRail = {id: "HomeRail", chain: "home-rail", network: "stake-preview"};
  asset RailUSD = {domain: HomeRail, id: "RailUSDCanonical", scale: 2, representation: "canonical", symbol: "USD"};
  share_class HomeShares = {domain: HomeRail, id: "HomeVaultShare", backing: RailUSD};
  share_class HomeSharesAgain = {domain: HomeRail, id: "HomeVaultShare", backing: RailUSD};
}
