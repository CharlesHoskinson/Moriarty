diff --git c/src/plonk/evaluation.rs i/src/plonk/evaluation.rs
index 1371a0a..079efe2 100644
--- c/src/plonk/evaluation.rs
+++ i/src/plonk/evaluation.rs
@@ -819,3 +819,266 @@ pub fn evaluate<F: Field, B: PolynomialRepresentation>(
     });
     values
 }
+
+// ---------------------------------------------------------------------------------
+// gpu-wrap patch: the quotient numerator on the accelerator (hooks::QuotientJob).
+// The job is the stock `Evaluator` flattened, so the device computes the same field
+// values in the same `value * y + term` chain as `evaluate_numerator` above.
+#[allow(unsafe_code)]
+pub(crate) mod gpu {
+    use std::marker::PhantomData;
+
+    use ff::WithSmallOrderMulGroup;
+    use midnight_curves::Fq;
+
+    use super::{Calculation, GraphEvaluator, ValueSource};
+    use crate::{
+        hooks::{self, DevBuf, QCalc, QGraph, QLookup, QSrc, QTrash, QuotientJob},
+        plonk::{traces::ProverTrace, Any, Expression, ProvingKey},
+        poly::{commitment::PolynomialCommitmentScheme, Coeff, ExtendedLagrangeCoeff, Polynomial},
+    };
+
+    struct Flat {
+        calcs: Vec<QCalc>,
+        parts: Vec<QSrc>,
+        constants: Vec<Fq>,
+        nslots: u32,
+        result_slot: u32,
+    }
+
+    fn operands(c: &Calculation) -> Vec<&ValueSource> {
+        match c {
+            Calculation::Add(a, b) | Calculation::Sub(a, b) | Calculation::Mul(a, b) => vec![a, b],
+            Calculation::Square(a)
+            | Calculation::Double(a)
+            | Calculation::Negate(a)
+            | Calculation::Store(a) => vec![a],
+            Calculation::Horner(s, parts, f) => {
+                let mut v = vec![s, f];
+                v.extend(parts.iter());
+                v
+            }
+        }
+    }
+
+    fn flatten<F: WithSmallOrderMulGroup<3>>(g: &GraphEvaluator<F>) -> Flat {
+        let n = g.calculations.len();
+        for (pos, c) in g.calculations.iter().enumerate() {
+            assert_eq!(c.target, pos, "calculation targets are positions");
+        }
+        let mut last = vec![usize::MAX; n];
+        for (pos, c) in g.calculations.iter().enumerate() {
+            for v in operands(&c.calculation) {
+                if let ValueSource::Intermediate(i) = v {
+                    last[*i] = pos;
+                }
+            }
+        }
+        let mut slot = vec![0u32; n];
+        let (mut free, mut next) = (Vec::<u32>::new(), 0u32);
+        let mut calcs = Vec::with_capacity(n);
+        let mut parts = Vec::new();
+        for (pos, c) in g.calculations.iter().enumerate() {
+            let src = |v: &ValueSource, slot: &[u32]| -> QSrc {
+                let (kind, a, rot) = match *v {
+                    ValueSource::Constant(i) => (0, i as u32, 0),
+                    ValueSource::Intermediate(i) => (1, slot[i], 0),
+                    ValueSource::Fixed(c, r) => (2, c as u32, g.rotations[r]),
+                    ValueSource::Advice(c, r) => (3, c as u32, g.rotations[r]),
+                    ValueSource::Instance(c, r) => (4, c as u32, g.rotations[r]),
+                    ValueSource::Challenge(i) => (5, i as u32, 0),
+                    ValueSource::Beta() => (6, 0, 0),
+                    ValueSource::Gamma() => (7, 0, 0),
+                    ValueSource::Theta() => (8, 0, 0),
+                    ValueSource::TrashChallenge() => (9, 0, 0),
+                    ValueSource::Y() => (10, 0, 0),
+                    ValueSource::PreviousValue() => (11, 0, 0),
+                };
+                QSrc { kind, a, rot }
+            };
+            let mut q = QCalc::default();
+            match &c.calculation {
+                Calculation::Add(a, b) => (q.op, q.x, q.y) = (0, src(a, &slot), src(b, &slot)),
+                Calculation::Sub(a, b) => (q.op, q.x, q.y) = (1, src(a, &slot), src(b, &slot)),
+                Calculation::Mul(a, b) => (q.op, q.x, q.y) = (2, src(a, &slot), src(b, &slot)),
+                Calculation::Square(a) => (q.op, q.x) = (3, src(a, &slot)),
+                Calculation::Double(a) => (q.op, q.x) = (4, src(a, &slot)),
+                Calculation::Negate(a) => (q.op, q.x) = (5, src(a, &slot)),
+                Calculation::Horner(s, ps, f) => {
+                    (q.op, q.x, q.y) = (6, src(s, &slot), src(f, &slot));
+                    q.parts_off = parts.len() as u32;
+                    q.parts_len = ps.len() as u32;
+                    parts.extend(ps.iter().map(|p| src(p, &slot)));
+                }
+                Calculation::Store(a) => (q.op, q.x) = (7, src(a, &slot)),
+            }
+            // Free operands whose last use is here (the kernel reads operands before
+            // it writes the target, so the target may take one of their slots).
+            let mut seen = Vec::new();
+            for v in operands(&c.calculation) {
+                if let ValueSource::Intermediate(i) = v {
+                    if last[*i] == pos && *i != n - 1 && !seen.contains(i) {
+                        seen.push(*i);
+                        free.push(slot[*i]);
+                    }
+                }
+            }
+            slot[pos] = free.pop().unwrap_or_else(|| {
+                next += 1;
+                next - 1
+            });
+            q.target = slot[pos];
+            calcs.push(q);
+            if last[pos] == usize::MAX && pos != n - 1 {
+                free.push(slot[pos]);
+            }
+        }
+        Flat {
+            calcs,
+            parts,
+            constants: g.constants.iter().map(|c| hooks::to_fq(*c)).collect(),
+            nslots: next,
+            result_slot: if n > 0 { slot[n - 1] } else { 0 },
+        }
+    }
+
+    fn qgraph(f: &Flat) -> QGraph {
+        QGraph {
+            calcs: f.calcs.as_ptr(),
+            ncalcs: f.calcs.len() as u32,
+            result_slot: f.result_slot,
+            parts: f.parts.as_ptr(),
+            constants: f.constants.as_ptr(),
+        }
+    }
+
+    fn host<F>(p: &Polynomial<F, ExtendedLagrangeCoeff>) -> *const Fq {
+        p.values.as_ptr() as *const Fq
+    }
+
+    /// `compute_nu_poly` on the accelerator, or `None` (the CPU path then runs).
+    pub(crate) fn nu_poly<F: WithSmallOrderMulGroup<3>, CS: PolynomialCommitmentScheme<F>>(
+        pk: &ProvingKey<F, CS>,
+        trace: &ProverTrace<F>,
+    ) -> Option<Polynomial<F, ExtendedLagrangeCoeff>> {
+        if !hooks::is_fq::<F>() || !hooks::QUOTIENT_ON.load(std::sync::atomic::Ordering::Relaxed) {
+            return None;
+        }
+        let h = hooks::get()?;
+        let (qrun, dev) = (h.quotient?, h.dev_coeff_to_extended?);
+        if trace.advice_polys.len() != 1 {
+            return None;
+        }
+        let domain = &pk.vk.domain;
+        let cs = &pk.vk.cs;
+        let (k, ext_k) = (domain.k(), domain.extended_k());
+        let z = domain.coset_zetas();
+        let z = [hooks::to_fq(z[0]), hooks::to_fq(z[1])];
+        let to_dev = |p: &Polynomial<F, Coeff>| -> Option<DevBuf> { dev(hooks::as_fq(&p.values), k, ext_k, z) };
+
+        // Device-resident extended cosets of every committed polynomial of this proof.
+        let advice: Vec<DevBuf> = trace.advice_polys[0].iter().map(to_dev).collect::<Option<_>>()?;
+        let instance: Vec<DevBuf> = trace.instance_polys[0].iter().map(to_dev).collect::<Option<_>>()?;
+        let perm = &trace.permutations[0];
+        let products: Vec<DevBuf> = perm.sets.iter().map(|s| to_dev(&s.permutation_product_poly)).collect::<Option<_>>()?;
+        let mut lk_bufs = Vec::new();
+        for l in trace.lookups[0].iter() {
+            lk_bufs.push((to_dev(&l.product_poly)?, to_dev(&l.permuted_input_poly)?, to_dev(&l.permuted_table_poly)?));
+        }
+        let trash_bufs: Vec<DevBuf> = trace.trashcans[0].iter().map(|t| to_dev(&t.trash_poly)).collect::<Option<_>>()?;
+
+        let fixed: Vec<*const Fq> = pk.fixed_cosets.iter().map(host).collect();
+        let advice_p: Vec<*const Fq> = advice.iter().map(|b| b.ptr).collect();
+        let instance_p: Vec<*const Fq> = instance.iter().map(|b| b.ptr).collect();
+        let products_p: Vec<*const Fq> = products.iter().map(|b| b.ptr).collect();
+        let sigma_p: Vec<*const Fq> = pk.permutation.cosets.iter().map(host).collect();
+        let (mut col_kind, mut col_index) = (Vec::new(), Vec::new());
+        for c in cs.permutation.columns.iter() {
+            col_kind.push(match c.column_type() {
+                Any::Advice(_) => 0u32,
+                Any::Fixed => 1,
+                Any::Instance => 2,
+            });
+            col_index.push(c.index() as u32);
+        }
+        let challenges: Vec<Fq> = trace.challenges.iter().map(|c| hooks::to_fq(*c)).collect();
+        let sc: Vec<Fq> = [
+            trace.beta,
+            trace.gamma,
+            trace.theta,
+            trace.trash_challenge,
+            trace.y,
+            trace.beta * domain.g_coset,
+            F::DELTA,
+            domain.get_extended_omega(),
+        ]
+        .iter()
+        .map(|c| hooks::to_fq(*c))
+        .collect();
+
+        let gates = flatten(&pk.ev.custom_gates);
+        let lflat: Vec<Flat> = pk.ev.lookups.iter().map(flatten).collect();
+        let tflat: Vec<Flat> = pk.ev.trashcans.iter().map(flatten).collect();
+        let nslots = std::iter::once(&gates).chain(&lflat).chain(&tflat).map(|f| f.nslots).max().unwrap_or(0);
+        let lookups: Vec<QLookup> = lflat
+            .iter()
+            .zip(&lk_bufs)
+            .map(|(f, (p, i, t))| QLookup {
+                graph: qgraph(f),
+                product: p.ptr,
+                permuted_input: i.ptr,
+                permuted_table: t.ptr,
+            })
+            .collect();
+        let mut trash = Vec::new();
+        for ((f, b), arg) in tflat.iter().zip(&trash_bufs).zip(cs.trashcans.iter()) {
+            let Expression::Fixed(q) = arg.selector() else { return None };
+            trash.push(QTrash {
+                graph: qgraph(f),
+                trash: b.ptr,
+                selector_col: q.column_index as u32,
+            });
+        }
+        let ext_n = domain.extended_len();
+        let resident = advice.len() + instance.len() + products.len() + 3 * lk_bufs.len() + trash_bufs.len();
+        *hooks::LAST_QUOTIENT_SHAPE.lock().unwrap() =
+            (gates.calcs.len() as u32, nslots, lk_bufs.len() as u32, products.len() as u32, resident as u32);
+        let mut job = QuotientJob {
+            out: std::ptr::null_mut(),
+            n: ext_n as u64,
+            rot_scale: 1 << (ext_k - k),
+            fixed: fixed.as_ptr(),
+            advice: advice_p.as_ptr(),
+            instance: instance_p.as_ptr(),
+            challenges: challenges.as_ptr(),
+            sc: sc.as_ptr(),
+            gates: qgraph(&gates),
+            nsets: products_p.len() as u32,
+            chunk_len: (cs.degree() - 2) as u32,
+            ncols: col_kind.len() as u32,
+            perm_products: products_p.as_ptr(),
+            col_kind: col_kind.as_ptr(),
+            col_index: col_index.as_ptr(),
+            perm_sigma: sigma_p.as_ptr(),
+            last_rot: -((cs.blinding_factors() + 1) as i32),
+            l0: host(&pk.l0),
+            l_last: host(&pk.l_last),
+            l_active: host(&pk.l_active_row),
+            nlookups: lookups.len() as u32,
+            ntrash: trash.len() as u32,
+            lookups: lookups.as_ptr(),
+            trash: trash.as_ptr(),
+            scratch: std::ptr::null_mut(),
+            stride: 0,
+        };
+        let mut values = vec![F::ZERO; ext_n];
+        let ok = unsafe { qrun(&mut job, nslots, hooks::as_fq_mut(&mut values)) };
+        if !ok {
+            return None;
+        }
+        Some(Polynomial {
+            values,
+            _marker: PhantomData,
+        })
+    }
+}
diff --git c/src/plonk/lookup/prover.rs i/src/plonk/lookup/prover.rs
index b2d8ef4..52aec35 100644
--- c/src/plonk/lookup/prover.rs
+++ i/src/plonk/lookup/prover.rs
@@ -427,7 +427,12 @@ where
         .collect::<Result<Vec<_>, _>>()?;
 
     // Populate permuted table at unfilled rows with leftover table elements
-    for (coeff, count) in leftover_table_map.iter() {
+    // gpu-wrap patch: optional fixed leftover order (test-only determinism switch).
+    let mut leftovers: Vec<(&F, &u32)> = leftover_table_map.iter().collect();
+    if crate::hooks::deterministic_lookup() {
+        leftovers.sort_unstable_by(|a, b| a.0.cmp(b.0));
