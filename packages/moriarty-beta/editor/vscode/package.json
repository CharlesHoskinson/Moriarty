{
  "name": "moriarty-beta", "displayName": "Moriarty Beta", "version": "0.1.0",
  "publisher": "moriarty-language", "description": "Moriarty lexical support and bounded stdio authoring LSP. Local preparation remains unqualified.",
  "license": "Apache-2.0", "preview": true, "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages"], "main": "./extension.cjs", "activationEvents": ["onLanguage:moriarty"],
  "contributes": {
    "languages": [{"id": "moriarty", "aliases": ["Moriarty"], "extensions": [".mori"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "moriarty", "scopeName": "source.moriarty", "path": "./syntaxes/moriarty.tmLanguage.json"}],
    "snippets": [{"language": "moriarty", "path": "./snippets/moriarty.json"}],
    "configuration": {"title": "Moriarty", "properties": {"moriarty.nodePath": {"type": "string", "default": "node", "scope": "machine", "description": "Node >=24 executable for the bundled Moriarty stdio server."}}}
  },
  "dependencies": {"vscode-languageclient": "9.0.1"}
}
