pragma language_version >= 0.28 && <= 0.28;
import CompactStandardLibrary;
include "kernel";
include "feed-policy";

export struct OrderTerms {
  account: UserAddress; recipient: UserAddress; executor: UserAddress;
  orderId: Bytes<32>; network: Bytes<32>; assetA: Bytes<32>; assetB: Bytes<32>; program: Bytes<32>;
  epoch: Uint<64>; input: Uint<128>; minimum: Uint<128>; fee: Uint<128>; expiry: Uint<64>;
}
export struct OrderSignature { announcement: JubjubPoint; response: Field; }
struct Challenge {
  domain: Bytes<32>; terms: OrderTerms; instance: ContractAddress; ownerX: Field; ownerY: Field;
  action: Uint<8>; revision: Uint<128>; announcementX: Field; announcementY: Field;
}

export ledger terms: OrderTerms;
export ledger ownerKey: JubjubPoint;
export ledger funded: Boolean;
export ledger kernelState: KernelState;
export ledger remaining: Uint<128>;
export ledger revision: Uint<128>;

pure circuit equalPoint(a: JubjubPoint, b: JubjubPoint): Boolean {
  return jubjubPointX(a) == jubjubPointX(b) && jubjubPointY(a) == jubjubPointY(b);
}

export ledger providerKey: JubjubPoint;

constructor(order: OrderTerms, owner: JubjubPoint, controller: JubjubPoint, provider: JubjubPoint) {
  const pinned: Bytes<32> = Bytes[210,24,176,151,85,117,222,255,251,26,140,56,136,171,164,162,108,56,99,99,106,109,110,124,135,9,143,142,65,255,177,184];
  assert(order.program == pinned, "ORDER_PROGRAM");
  assert(order.assetA != order.assetB, "ORDER_ASSETS");
  assert(order.account != order.recipient && order.account != order.executor && order.recipient != order.executor, "ORDER_ROLES");
  assert(order.input == 100 && order.minimum == 200 && order.fee == 0 && order.expiry == 1400, "O5_TERMS");
  assert(order.epoch <= 18446744073709549615, "CLOCK_OVERFLOW");
  assert(!equalPoint(owner,ecMulGenerator(0 as JubjubScalar)), "OWNER_IDENTITY");
  assert(!equalPoint(provider,ecMulGenerator(0 as JubjubScalar)), "PROVIDER_IDENTITY");
  initializeFeed(controller, order.network);
  providerKey = disclose(provider);
  terms = disclose(order);
  ownerKey = disclose(owner);
}

export pure circuit orderChallenge(order: OrderTerms, instance: ContractAddress, owner: JubjubPoint,
                                   action: Uint<8>, nonce: Uint<128>, announcement: JubjubPoint): Field {
  const h = transientHash<Challenge>(Challenge { domain: pad(32,"moriarty:order:schnorr:v1"),
    terms: order, instance: instance, ownerX:jubjubPointX(owner), ownerY:jubjubPointY(owner), action:action, revision:nonce,
    announcementX:jubjubPointX(announcement), announcementY:jubjubPointY(announcement) });
  return (slice<31>(h as Bytes<32>, 0) as Uint<248>) as Field;
}

circuit authorize(action: Uint<8>, expected: Uint<128>, sig: OrderSignature): [] {
  assert(revision == expected, "ORDER_REVISION");
  assert(funded && kernelState.f3 == 0, "ORDER_CLOSED");
  assert(!equalPoint(sig.announcement,ecMulGenerator(0 as JubjubScalar)), "ORDER_SIGNATURE_IDENTITY");
  const c = orderChallenge(terms,kernel.self(),ownerKey,action,expected,sig.announcement);
  assert(equalPoint(ecMulGenerator(sig.response as JubjubScalar),ecAdd(sig.announcement,ecMul(ownerKey,c as JubjubScalar))), "ORDER_SIGNATURE");
}

export circuit fund(): [] {
  assert(!funded, "ALREADY_FUNDED");
  assert(blockTimeLt((terms.epoch + terms.expiry) as Uint<64>), "ORDER_EXPIRED");
  receiveUnshielded(terms.assetA,terms.input);
  kernelState = KernelState { f0:100, f1:0, f2:0, f3:0 };
  remaining = 128; revision = 0; funded = true;
}

struct ProviderQuote {
  protocol: Bytes<32>; terms: OrderTerms; address: ContractAddress;
  revision: Uint<128>; input: Uint<128>; delivery: Uint<128>;
}

export pure circuit quoteMessage(order: OrderTerms, address: ContractAddress, revision: Uint<128>,
                                 input: Uint<128>, delivery: Uint<128>): Field {
  return transientHash<ProviderQuote>(ProviderQuote {
    protocol: pad(32,"moriarty:o5:provider:v1"), terms: order, address: address,
    revision: revision, input: input, delivery: delivery
  });
}

export circuit fill(expected: Uint<128>, amountA: Uint<128>, amountB: Uint<128>, applicationFee: Uint<128>,
                    now: Uint<64>, sig: OrderSignature, expectedFeed: Bytes<32>, quote: JubjubSchnorrSignature): [] {
  authorize(0,expected,sig);
  requireFeedCondition(expectedFeed);
  const message = quoteMessage(terms,kernel.self(),expected,amountA,amountB);
  assert(jubjubSchnorrVerify<1>([message], quote, providerKey), "PROVIDER_SIGNATURE");
  assert(applicationFee == terms.fee, "APPLICATION_FEE");
  assert(blockTimeLt((terms.epoch + terms.expiry) as Uint<64>), "ORDER_EXPIRED");
  assert(now < terms.expiry, "ORDER_EXPIRED");
  const executionTime = (terms.epoch + disclose(now)) as Uint<64>;
  assert(blockTimeGte(executionTime) && blockTimeLte(executionTime), "O5_EXECUTION_SECOND");
  assert(executionTime >= feedObservedAt, "FEED_FUTURE");
  assert(unshieldedBalanceGte(terms.assetA,kernelState.f0), "CUSTODY_A");
  const result = disclose(transition0(kernelState,Arguments0 { a0:2, a1:3, a2:amountA, a3:amountB },
    KernelObservations { o0:now as Uint<128>, o1:feedPrice, o2:(executionTime - feedObservedAt) as Uint<128> },remaining,revision,Hints0 { unused:0 }));
  assert(result.effect0.v0 == 0 && result.effect0.v1 == 4 && result.effect0.v2 == 5 && result.effect0.v3 == terms.input, "A_EFFECT");
  assert(result.effect1.v0 == 1 && result.effect1.v1 == 5 && result.effect1.v2 == 3 && result.effect1.v3 >= terms.minimum, "B_EFFECT");
  receiveUnshielded(terms.assetB,result.effect1.v3);
  sendUnshielded(terms.assetB,result.effect1.v3,right<ContractAddress,UserAddress>(terms.recipient));
  sendUnshielded(terms.assetA,result.effect0.v3,right<ContractAddress,UserAddress>(terms.executor));
  kernelState = result.after; remaining = result.remaining; revision = result.revision;
}

export circuit cancel(expected: Uint<128>, sig: OrderSignature): [] {
  authorize(1,expected,sig);
  // Cancellation is independent of block time. The source only reads its clock in the common horizon guard.
  const result = disclose(transition1(kernelState,Arguments1 { a0:2 },KernelObservations { o0:0, o1:0, o2:0 },
    remaining,revision,Hints1 { unused:0 }));
  assert(result.effect0.v0 == 0 && result.effect0.v1 == 4 && result.effect0.v2 == 2 && result.effect0.v3 == kernelState.f0, "REFUND_EFFECT");
  assert(unshieldedBalanceGte(terms.assetA,result.effect0.v3), "CUSTODY_A");
  sendUnshielded(terms.assetA,result.effect0.v3,right<ContractAddress,UserAddress>(terms.account));
  kernelState = result.after; remaining = result.remaining; revision = result.revision;
}
