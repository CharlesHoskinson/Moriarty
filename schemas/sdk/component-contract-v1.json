{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriarty.dev/schemas/sdk/component-contract-v1.json",
  "title": "Moriarty SDK component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "package",
    "inputs",
    "outputs",
    "failure_codes",
    "trust_roots",
    "version_fields",
    "security_checks",
    "conformance_vectors",
    "specification",
    "implementation_scope"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "package": {"type": "string", "pattern": "^@moriarty/[a-z][a-z0-9-]*$"},
    "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "failure_codes": {"$ref": "#/$defs/nonEmptyStrings"},
    "trust_roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "version_fields": {"$ref": "#/$defs/nonEmptyStrings"},
    "security_checks": {"$ref": "#/$defs/nonEmptyStrings"},
    "conformance_vectors": {"$ref": "#/$defs/nonEmptyStrings"},
    "specification": {"type": "string", "pattern": "^specs/.+/spec\\.md$"},
    "implementation_scope": {"enum": ["minimum-safety-spine", "complete-sdk-specification"]}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
