{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriarty.dev/schemas/sdk/data-contract-v1.json",
  "title": "Moriarty SDK data contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "schema_id",
    "required_fields",
    "canonical_encoding",
    "producer",
    "consumers",
    "validation",
    "unknown_fields",
    "privacy"
  ],
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"},
    "schema_id": {"type": "string", "pattern": "^moriarty\\.dev/[a-z0-9-]+/v[1-9][0-9]*$"},
    "required_fields": {"$ref": "#/$defs/nonEmptyStrings"},
    "canonical_encoding": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "consumers": {"$ref": "#/$defs/nonEmptyStrings"},
    "validation": {"$ref": "#/$defs/nonEmptyStrings"},
    "unknown_fields": {"type": "string", "minLength": 1},
    "privacy": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
