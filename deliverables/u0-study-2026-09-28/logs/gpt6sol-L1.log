   216	
   217	def check_status(row: dict, evidence_path: str, failures: list[str]) -> None:
   218	    citations, evidence, note = row.get("kCitations"), row.get("evidence"), row.get("note")
   219	    if not isinstance(citations, list) or not isinstance(evidence, list) or not isinstance(note, str):
   220	        return
   221	    label = row["id"] if isinstance(row.get("id"), str) else "<row>"
   222	    status = row.get("status")
   223	    if status == "covered":
   224	        symbols, quotes = cited_symbols(citations), evidence_quotes(evidence)
   225	        shown = bool(symbols and quotes) and all(
   226	            any(execution_quote(path, quote, symbol, evidence_path) for path, quote in quotes)
   227	            for symbol in symbols
   228	        )
   229	        if not shown:
   230	            if not symbols or not quotes:
   231	                failures.append(f"FAIL: {label} covered requires a K citation and an execution quote")
   232	            else:
   233	                failures.append(f"FAIL: {label} covered evidence does not show execution of a cited declaration")
   234	    elif status == "partial":
   235	        if len(citations) < 1:
   236	            failures.append(f"FAIL: {label} partial requires a K citation")
   237	        if PARTIAL_NOTE.search(note) is None:
   238	            failures.append(f"FAIL: {label} partial note must say Covers: ...; Missing: ...")
   239	    elif status == "not-covered":
   240	        if citations:
   241	            failures.append(f"FAIL: {label} not-covered has K citations")
   242	        if LACKS_NOTE.search(note) is None:
   243	            failures.append(f"FAIL: {label} not-covered note does not say what K lacks")
   244	
   245	
   246	def cited_symbols(citations: list[object]) -> list[str]:
   247	    return [item["symbol"] for item in citations if isinstance(item, dict) and isinstance(item.get("symbol"), str)]
   248	
   249	
   250	def evidence_quotes(evidence: list[object]) -> list[tuple[str, str]]:
   251	    return [(item["path"], item["quote"]) for item in evidence if isinstance(item, dict) and isinstance(item.get("path"), str) and isinstance(item.get("quote"), str)]
   252	
