   445	def object_body(text: str, start: int) -> str | None:
   446	    index, length = start, len(text)
   447	    while index < length and text[index].isspace():
   448	        index += 1
   449	    if index < length and text[index] == "<":
   450	        depth = 1
   451	        index += 1
   452	        while index < length and depth:
   453	            depth += text[index] == "<"
   454	            depth -= text[index] == ">"
   455	            index += 1
   456	        while index < length and text[index].isspace():
   457	            index += 1
   458	    if index < length and text[index] == "=":
   459	        index += 1
   460	        while index < length and text[index] not in "{;":
   461	            index += 1
   462	    if index >= length or text[index] != "{":
   463	        return None
   464	    end, depth = index + 1, 1
   465	    while end < length and depth:
   466	        depth += text[end] == "{"
   467	        depth -= text[end] == "}"
   468	        end += 1
   469	    return text[index + 1:end - 1]
