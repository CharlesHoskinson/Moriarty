   101	
   102	def report(failures: list[str], blocked: list[str]) -> int:
   103	    if failures:
   104	        print("\n".join(failures))
   105	    if blocked:
   106	        print("\n".join(blocked))
   107	        return 2
   108	    return 1 if failures else 0
