   476	        elif char == "}":
   477	            depth = max(0, depth - 1)
   478	        elif char == ";" and depth == 0:
   479	            match = MEMBER.match(body, start)
   480	            if match:
   481	                members.add(match.group(1))
   482	            start = index + 1
   483	    return members
