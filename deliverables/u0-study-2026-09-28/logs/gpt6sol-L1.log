    40	CTOR_RE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)\s*\(")
    41	QUOTE_RE = re.compile(r'"(?:[^"\\]|\\.)*"')
    42	PARTIAL_NOTE = re.compile(r"Covers:\s*\S.*?;\s*Missing:\s*\S", re.S)
