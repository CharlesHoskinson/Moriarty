    50	def main(argv: list[str] | None = None) -> int:
    51	    parser = argparse.ArgumentParser(description=__doc__)
    52	    parser.add_argument("--root", type=Path, default=MORIARTY_ROOT)
    53	
    54	    def reject(message: str) -> None:
    55	        print(f"blocked: {message}")
    56	        raise SystemExit(2)
    57	
    58	    parser.error = reject  # type: ignore[method-assign]
    59	    try:
    60	        args = parser.parse_args(argv)
    61	        root = args.root.resolve()
    62	        if not root.is_dir():
    63	            print("blocked: root is not a directory")
    64	            return 2
    65	        return check_root(root)
    66	    except Exception as error:
    67	        print(f"FAIL: internal error: {type(error).__name__}: {error}")
    68	        return 1
