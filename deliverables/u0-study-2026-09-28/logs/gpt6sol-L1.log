    71	def check_root(root: Path) -> int:
    72	    required = (SCHEMA_REL, ARTIFACT_REL, SPEC_REL, JUDGMENTS_REL, K_ROOT)
    73	    blocked = [
    74	        f"blocked: missing {rel.as_posix()}" for rel in required
    75	        if (not (root / rel).is_dir() if rel == K_ROOT else not (root / rel).is_file())
    76	    ]
    77	    if blocked:
    78	        print("\n".join(blocked))
    79	        return 2
    80	    failures: list[str] = []
    81	    schema, _, schema_ok = load_json_text(root / SCHEMA_REL, SCHEMA_REL, failures)
    82	    artifact, artifact_text, artifact_ok = load_json_text(root / ARTIFACT_REL, ARTIFACT_REL, failures)
    83	    spec = read_text(root / SPEC_REL, SPEC_REL, failures)
    84	    judgments, _, judgments_ok = load_json_text(root / JUDGMENTS_REL, JUDGMENTS_REL, failures)
    85	    if schema_ok and artifact_ok:
    86	        check_schema(schema, artifact, artifact_text, failures)
    87	    if judgments_ok:
    88	        check_judgments(judgments, failures)
    89	    if failures or spec is None or not isinstance(artifact, dict):
    90	        return report(failures, [])
    91	    rows = artifact.get("rows")
    92	    blocked = []
    93	    if isinstance(rows, list):
    94	        check_rows(root, artifact, rows, expected_rows(spec, judgments), failures, blocked)
    95	    if not failures and not blocked and isinstance(rows, list):
    96	        counts = {name: sum(isinstance(row, dict) and row.get("status") == name for row in rows) for name in ("covered", "partial", "not-covered")}
    97	        print(f"OK: {len(rows)} rows, {counts['covered']} covered, {counts['partial']} partial, {counts['not-covered']} not-covered")
    98	        print(LIMITATION)
    99	    return report(failures, blocked)
