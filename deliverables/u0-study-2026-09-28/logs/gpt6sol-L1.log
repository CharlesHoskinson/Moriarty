   111	def load_json_text(path: Path, rel: Path, failures: list[str]) -> tuple[object, str, bool]:
   112	    try:
   113	        text = path.read_text(encoding="utf-8")
   114	        return json.loads(text), text, True
   115	    except (OSError, UnicodeError, json.JSONDecodeError) as error:
   116	        failures.append(f"FAIL: {rel.as_posix()} is not UTF-8 JSON ({error})")
   117	        return None, "", False
   118	
   119	
   120	def read_text(path: Path, rel: Path, failures: list[str]) -> str | None:
   121	    try:
   122	        return path.read_text(encoding="utf-8")
   123	    except (OSError, UnicodeError) as error:
   124	        failures.append(f"FAIL: {rel.as_posix()} is not readable UTF-8 ({error})")
   125	        return None
   126	
   127	
   128	def check_schema(schema: object, artifact: object, text: str, failures: list[str]) -> None:
   129	    if not isinstance(schema, dict):
   130	        failures.append("FAIL: reconciliation schema is not an object")
   131	        return
   132	    try:
   133	        Draft202012Validator.check_schema(schema)
   134	    except SchemaError as error:
   135	        failures.append(f"FAIL: reconciliation schema is not valid ({error.message})")
   136	        return
   137	    validator = Draft202012Validator(schema)
   138	    errors = sorted(validator.iter_errors(artifact), key=lambda item: (list(item.absolute_path), item.message))
   139	    for error in errors:
   140	        location = ".".join(str(part) for part in error.absolute_path) or "<root>"
   141	        failures.append(f"FAIL: artifact schema: {location}: {error.message}")
   142	    if text != json.dumps(artifact, indent=2, ensure_ascii=False) + "\n":
   143	        failures.append("FAIL: artifact is not canonical UTF-8 JSON")
   144	    check_key_order(artifact, schema, "", failures)
   145	    rows = artifact.get("rows") if isinstance(artifact, dict) else None
   146	    seen: set[str] = set()
   147	    for row in rows if isinstance(rows, list) else []:
   148	        row_id = row.get("id") if isinstance(row, dict) else None
   149	        if isinstance(row_id, str) and row_id in seen:
   150	            failures.append(f"FAIL: duplicate row id {row_id}")
   151	        if isinstance(row_id, str):
   152	            seen.add(row_id)
   153	
   154	
   155	def check_judgments(instance: object, failures: list[str]) -> None:
   156	    errors = sorted(Draft202012Validator(JUDGMENTS_SCHEMA).iter_errors(instance), key=lambda item: (list(item.absolute_path), item.message))
   157	    for error in errors:
   158	        location = ".".join(str(part) for part in error.absolute_path) or "<root>"
   159	        failures.append(f"FAIL: judgments.json: {location}: {error.message}")
   160	
   161	
   162	def check_key_order(instance: object, schema: object, path: str, failures: list[str]) -> None:
   163	    if not isinstance(schema, dict):
   164	        return
   165	    if schema.get("type") == "array" and isinstance(instance, list):
   166	        for index, item in enumerate(instance):
   167	            check_key_order(item, schema.get("items"), f"{path}[{index}]", failures)
   168	        return
   169	    properties = schema.get("properties")
   170	    if schema.get("type") != "object" or not isinstance(properties, dict) or not isinstance(instance, dict):
   171	        return
   172	    if list(instance) != list(properties):
   173	        failures.append(f"FAIL: {path or 'artifact'} keys are {list(instance)!r}")
   174	    for key, child in properties.items():
   175	        if key in instance:
   176	            check_key_order(instance[key], child, f"{path}.{key}" if path else key, failures)
   177	
   178	
   179	def expected_rows(spec: str, judgments: object) -> list[tuple[str, str, str]]:
   180	    rows = [(uni_id, "uni", title) for uni_id, title in sorted(UNI_HEADING.findall(spec))]
   181	    items = judgments["judgments"] if isinstance(judgments, dict) else []
   182	    return rows + [(item["key"], "judgment", item["key"]) for item in items]
   183	
   184	
   185	def check_rows(
   186	    root: Path, artifact: dict, rows: list[object], expected: list[tuple[str, str, str]],
   187	    failures: list[str], blocked: list[str],
   188	) -> None:
   189	    actual = [(row.get("id"), row.get("kind"), row.get("title")) if isinstance(row, dict) else None for row in rows]
   190	    if actual != expected:
   191	        failures.append("FAIL: rows are not the UNI headings followed by judgments.json keys")
   192	        actual_ids = [item[0] for item in actual if item is not None]
   193	        if actual_ids != [item[0] for item in expected]:
   194	            failures.append(f"FAIL: row ids are {actual_ids!r}")
   195	        for row, want in zip((row for row in rows if isinstance(row, dict)), expected, strict=False):
   196	            if row.get("id") != want[0]:
   197	                continue
   198	            if row.get("title") != want[2]:
   199	                failures.append(f"FAIL: {want[0]} title is {row.get('title')!r}")
   200	            if row.get("kind") != want[1]:
   201	                failures.append(f"FAIL: {want[0]} kind is {row.get('kind')!r}")
   202	    raw = artifact.get("executionEvidence")
   203	    evidence_path = raw.get("path") if isinstance(raw, dict) and isinstance(raw.get("path"), str) else ""
   204	    roots = artifact.get("kRoots")
   205	    k_roots = roots if isinstance(roots, list) and all(isinstance(item, str) for item in roots) else []
   206	    cache: dict[str, str] = {}
   207	    modules: dict[str, dict[str, set[str]]] = {}
   208	    for row in rows:
   209	        if not isinstance(row, dict):
   210	            continue
   211	        check_status(row, evidence_path, failures)
   212	        check_citations(root, row, k_roots, cache, modules, failures, blocked)
   213	        check_evidence(root, row, cache, failures, blocked)
   214	    check_execution(root, artifact.get("executionEvidence"), cache, failures, blocked)
