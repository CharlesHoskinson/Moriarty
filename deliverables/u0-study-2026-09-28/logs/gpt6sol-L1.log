    31	    "properties": {"schemaVersion": {"type": "string", "const": "moriarty-u0-judgments/1"}, "judgments": {"type": "array", "items": _JUDGMENT}},
    32	}
    33	Draft202012Validator.check_schema(JUDGMENTS_SCHEMA)
    34	UNI_HEADING = re.compile(r"^### Requirement: (UNI-\d{3}) (.+)$", re.M)
    35	MODULE_RE = re.compile(r"\bmodule\s+([A-Za-z0-9-]+)\b(.*?)\bendmodule\b", re.S)
    36	DECL_RE = re.compile(r"(?m)^[ \t]*(syntax|configuration|rule|context|claim|imports|endmodule|requires|module)\b")
    37	LABEL_RE = re.compile(r"\[(?:symbol|klabel)\(([A-Za-z_][A-Za-z0-9_]*)\)\]")
