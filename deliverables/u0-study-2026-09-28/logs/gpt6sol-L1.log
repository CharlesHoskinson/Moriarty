   406	        for cursor in range(start, end):
   407	            if chars[cursor] != "\n":
   408	                chars[cursor] = " "
   409	    while index < length:
   410	        pair = text[index:index + 2]
   411	        if pair in ("//", "/*"):
   412	            marker = "\n" if pair == "//" else "*/"
   413	            end = text.find(marker, index + 2)
   414	            end = length if end < 0 else end + (0 if pair == "//" else 2)
   415	            blank(index, end)
   416	            index = end
