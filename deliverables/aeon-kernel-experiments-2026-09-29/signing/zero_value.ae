
def authorize
  (domain:{d:Int | d = 1})
  (path:{p:Int | p = 7})
  (digest:{h:Int | h = 314159})
  (recipient:{r:Int | r = 42})
  (value:{v:Int | v > 0 && v <= 100})
  (epoch:{e:Int | e = 5})
  (nonce:{n:Int | n = 9})
  : {s:Int | s = 1} := 1;

def attempt : {s:Int | s = 1} := authorize 1 7 314159 42 0 5 9;
