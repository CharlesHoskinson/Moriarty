+      } else if (['Not', 'And', 'Or'].includes(k)) {
+        childTypes.forEach(ct => this.requireType(ct, ['Bool'])); t = ['Bool'];
+      } else if (k === 'Require' || k === 'Ensure') { this.requireType(childTypes[0], ['Bool']); t = ['Unit']; }
