{"nodes": [{"id": "experiments_moriarty_language_spec_successor_lexical", "label": "Lexical Rules for Successor Syntax/0", "file_type": "document", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "experiments_moriarty_language_spec_successor_lexical_utf8_spans", "label": "UTF-8 Encoding and Spans", "file_type": "concept", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parser does not normalize Unicode, strip a BOM, or rewrite the caller string. CLI decoder uses a fatal UTF-8 decode."}, {"id": "experiments_moriarty_language_spec_successor_lexical_keywords", "label": "Successor Syntax Keywords", "file_type": "concept", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pre and post are identifiers. next is a keyword and begins a state update. floor_div and ceil_div are identifiers and parse as calls when followed by an argument list."}, {"id": "experiments_moriarty_language_spec_successor_lexical_token_bound", "label": "Token Bound 8192", "file_type": "concept", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "experiments_moriarty_language_spec_successor_lexical_integer_tokens", "label": "Integer Tokens", "file_type": "concept", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as decimal text, not converted to an IEEE number. More than 78 digits fails INTEGER_BOUND."}, {"id": "experiments_moriarty_language_spec_successor_lexical_string_tokens", "label": "JSON String Tokens", "file_type": "concept", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formatter emits the original string token text, so \\u0041 and A remain distinct literals."}, {"id": "experiments_moriarty_language_spec_successor_lexical_gte_type_split", "label": ">= Type-Argument Split", "file_type": "rationale", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no >> token. The type parser splits a >= token into > and = when closing a type argument list so Debt<USD>= debt(1, USD) is accepted. Extra = counts toward the 8192 token bound."}, {"id": "experiments_moriarty_language_spec_successor_lexical_no_division_operator", "label": "No Division Operator Token", "file_type": "rationale", "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slash that does not start // or /* is not a token. There is no division operator; floor_div and ceil_div are identifier calls."}], "edges": [{"source": "experiments_moriarty_language_spec_successor_lexical", "target": "experiments_moriarty_language_spec_successor_grammar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "experiments/moriarty-language/spec/successor/lexical.md", "source_location": null, "weight": 1.0}, {"source": "experiments_moriarty_language_spec_successor_lexical_utf8_spans", "target": "experiments_moriarty_language_spec_successor_representation_span_p", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file