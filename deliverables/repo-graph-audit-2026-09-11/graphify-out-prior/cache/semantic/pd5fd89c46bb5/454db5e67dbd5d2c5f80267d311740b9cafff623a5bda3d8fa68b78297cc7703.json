{"nodes": [{"id": "roadmap_moriarty", "label": "Moriarty", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Midnight-centric language for bounded financial contracts and proof-carrying transactions. Developers should express a financial agreement, inspect possible effects, authorize an outcome, prove a valid transition and settle it on Midnight. Each accepted transition must preserve the contract's rules, signed intent and compliant predecessor history."}, {"id": "roadmap_hard_release_gate", "label": "Hard Release Gate", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moriarty must work end to end on Midnight Preview. Programs compiled from Moriarty source must produce actual financial transactions whose finalized state and complete effects match independent expectations. Local tests, local settlement, hello-world receipts and source reviews cannot close this gate. A blocked Midnight interface does not authorize changing the target or weakening acceptance. The user's September 10 instruction makes this requirement non-negotiable."}, {"id": "roadmap_midnight_preview", "label": "Midnight Preview", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_compact", "label": "Compact", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_actus", "label": "ACTUS", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_defi_corpus", "label": "DeFi Corpus", "file_type": "concept", "sour