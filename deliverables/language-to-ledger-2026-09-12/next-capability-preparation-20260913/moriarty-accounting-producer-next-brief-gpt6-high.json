      ],
      "positive": "One exclusive application marker, exact preserved predecessor and reserve transfer, canonical counterpart before each master write.",
      "negative": [
        "held budget lock",
        "duplicate grant",
        "wrong Decimal closure/owner/prefix/reserve",
        "fault or rollback after every marker/intent/master/projection/correspondence boundary"
      ]
    },
    {
