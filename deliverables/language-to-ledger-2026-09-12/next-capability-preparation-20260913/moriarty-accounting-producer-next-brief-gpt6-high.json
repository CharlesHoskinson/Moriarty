      ],
      "positive": "One125s charge before observer; actual isolated observer+parent produce current evidence with unchanged input bytes and stopped children.",
      "negative": [
        "forbidden wallet/submit/prove/persist API",
        "wrong SDK/identity/source/unit",
        "known material pending use",
        "timeout/stop failure/parent death",
        "free retry or caller-seeded receipt"
      ]
    },
    {
      "id": 4,
      "title": "Runtime debit and continuous ownership handover",
      "target": [
        "accounting runtime debit",
        "store.reserve atomic handover",
        "records/policy/runner final prepaid checks",
        "accepted executor handoff"
      ],
      "positive": "125s observer then bounded runtime separately charged; primary continuously occupied and same wallet OS lock held; one claim and one executor.",
      "negative": [
        "competitor race",
        "stale90/120second boundary",
        "less than30second margin",
        "source change after preflight",
        "double subtraction/prepaid replay",
        "unlaunched debit refund"
      ]
    },
    {
      "id": 5,
      "title": "Actual provider allocation/submit guard and terminal disposition",
      "target": [
        "providers.mjs bindingFor/reservation/submission guard",
        "existing financial caller",
        "runner/cli/store result consumer"
      ],
      "positive": "One authenticated provider allocation and all submits guarded; complete result releases only owned state after containment; financial acceptance pending.",
      "negative": [
        "fifth submission",
        "counter reset or reservation path switch",
        "foreign payer/asset/over-gross/over-DUST",
        "failed finalize refund",
