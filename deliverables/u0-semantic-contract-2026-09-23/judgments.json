{
  "schemaVersion": "moriarty-u0-judgments/1",
  "judgments": [
    {
      "key": "stage",
      "designDocJudgment": "contract properties",
      "definition": "The stage judgment holds when the bound profiles, program, circuit, domain, and lifecycle identity satisfy the program contract.",
      "schemaFields": [
        "circuitIdentity.circuitId",
        "circuitIdentity.compilerPin",
        "circuitIdentity.verifierKeyId",
        "circuitIdentity.zkirVersion",
        "domain.chainId",
        "domain.domainId",
        "domain.stateFrameRef",
        "lifecycleIds.lifecycleId",
        "lifecycleIds.logicalRequestId",
        "lifecycleIds.stageId",
        "profiles.numericProfile",
        "profiles.semanticProfile",
        "programIdentity.coreRef",
        "programIdentity.entryPoint",
        "programIdentity.programId",
        "programIdentity.sourceRef",
        "schemaVersion"
      ]
    },
    {
      "key": "intent",
      "designDocJudgment": "intent refinement",
      "definition": "The intent judgment holds when the signed intention refines the stage, including the signer, assets, recipients, caps, disclosures, and consent, delegation, validity, replay, and recovery policies.",
      "schemaFields": [
        "disclosures[].fields[]",
        "disclosures[].party",
        "signedIntent.assetIdentities[]",
        "signedIntent.consentPolicy",
        "signedIntent.delegationPolicy",
        "signedIntent.feeCap",
        "signedIntent.grossDebitCap",
        "signedIntent.intentId",
        "signedIntent.minNetOutcome",
        "signedIntent.recipients[]",
        "signedIntent.recoveryPolicy",
        "signedIntent.replayPolicy",
        "signedIntent.signer",
        "signedIntent.validity"
      ]
    },
    {
      "key": "effect",
      "designDocJudgment": "valid state/effect transition",
      "definition": "The effect judgment holds when the observations, gross effects, fees, net effects, supply changes, liabilities, and outcome are the authorized state transition.",
      "schemaFields": [
        "effects.fees[].account",
        "effects.fees[].amount",
        "effects.fees[].asset",
        "effects.gross[].account",
        "effects.gross[].amount",
        "effects.gross[].asset",
        "effects.net[].account",
        "effects.net[].amount",
        "effects.net[].asset",
        "effects.supplyChanges[].account",
        "effects.supplyChanges[].amount",
        "effects.supplyChanges[].asset",
        "liabilities.closing[].amount",
        "liabilities.closing[].asset",
        "liabilities.closing[].creditor",
        "liabilities.closing[].debtor",
        "liabilities.closing[].liabilityId",
        "liabilities.opening[].amount",
        "liabilities.opening[].asset",
        "liabilities.opening[].creditor",
        "liabilities.opening[].debtor",
        "liabilities.opening[].liabilityId",
        "observations[].domain",
        "observations[].finality",
        "observations[].issuer",
        "observations[].kind",
        "observations[].time",
        "outcome.continuations[]",
        "outcome.kind"
      ]
    },
    {
      "key": "authority",
      "designDocJudgment": "valid state/effect transition",
      "definition": "The authority judgment holds when consumed authority, remaining authority, replay state, and resource reservations stay inside the signed budget.",
      "schemaFields": [
        "authority.consumed",
        "authority.remaining",
        "authority.replayState",
        "resources.cumulativeReservations",
        "resources.resourceCertificate"
      ]
    },
    {
      "key": "history",
      "designDocJudgment": "compliant history",
      "definition": "The history judgment holds when predecessor commitments and obligation commitments are the compliant history that this stage extends.",
      "schemaFields": [
        "obligationCommitments[].commitment",
        "obligationCommitments[].obligationId",
        "predecessorCommitments[].commitment",
        "predecessorCommitments[].predecessorId"
      ]
    },
    {
      "key": "failure",
      "designDocJudgment": "rejection/partial failure transition",
      "definition": "The failure judgment holds when rejection or partial failure is the specified transition and retains only the authorized phase effects and fees.",
      "schemaFields": [
        "failurePolicy.phasePolicy",
        "failurePolicy.retainedEffects",
        "failurePolicy.retainedFees"
      ]
    }
  ]
}
