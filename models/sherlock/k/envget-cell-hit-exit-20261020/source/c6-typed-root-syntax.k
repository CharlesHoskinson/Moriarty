requires "domains.md"

module SHERLOCK-C6-TYPED-ROOT-SYNTAX
  imports INT
  imports BOOL
  imports STRING
  syntax CTRef ::= ctConst(Int) [klabel(ctConst)]
                   | ctData(Int) [klabel(ctData)]
  syntax CTEnv ::= ctEnvNone() [klabel(ctEnvNone)]
                   | ctEnvSome(Int) [klabel(ctEnvSome)]
  syntax CTFunction ::= ctFunctionNone() [klabel(ctFunctionNone)]
                        | ctFunctionSome(Int) [klabel(ctFunctionSome)]
  syntax CTSlice ::= ctSlice(Int, Int) [klabel(ctSlice)]
  syntax CTBinary ::= ctAdd() [klabel(ctAdd)]
                      | ctSub() [klabel(ctSub)]
                      | ctMul() [klabel(ctMul)]
                      | ctEq() [klabel(ctEq)]
                      | ctLt() [klabel(ctLt)]
                      | ctCons() [klabel(ctCons)]
                      | ctBranch() [klabel(ctBranch)]
  syntax CTUnary ::= ctLeaf() [klabel(ctLeaf)]
                     | ctNot() [klabel(ctNot)]
  syntax CTFrame ::= ctLetF(Int, Int, CTEnv, Int) [klabel(ctLetF)]
                     | ctLeftF(CTBinary, Int, CTEnv, Int) [klabel(ctLeftF)]
                     | ctRightF(CTBinary, CTRef, Int) [klabel(ctRightF)]
                     | ctUnaryF(CTUnary, Int) [klabel(ctUnaryF)]
                     | ctIfF(Int, Int, CTEnv, Int) [klabel(ctIfF)]
                     | ctMatchF(CTSlice, CTEnv, Int) [klabel(ctMatchF)]
                     | ctArgsF(Int, CTSlice, CTSlice, CTEnv, Int) [klabel(ctArgsF)]
                     | ctReturnF(Int, CTEnv, Int) [klabel(ctReturnF)]
                     | ctScopeF(CTEnv, Int) [klabel(ctScopeF)]
                     | ctConstructorFieldsF(Int, Int, Int, Int, Bool, CTSlice, CTSlice, CTEnv, Int) [klabel(ctConstructorFieldsF)]
  syntax CTFrames ::= ctNoFrames() [klabel(ctNoFrames)]
                      | ctFrame(CTFrame, CTFrames) [klabel(ctFrame)]
  syntax CTBinding ::= ctBindingBad() [klabel(ctBindingBad)]
                       | ctBindingOk(CTEnv) [klabel(ctBindingOk)]
  syntax CTMatching ::= ctNoMatch() [klabel(ctNoMatch)]
                        | ctMatched(CTEnv) [klabel(ctMatched)]
  syntax CTPrimitive ::= ctPrimValue(CTRef) [klabel(ctPrimValue)]
                         | ctPrimError(Int) [klabel(ctPrimError)]
  syntax CTControl ::= ctEval(Int) [klabel(ctEval)]
                       | ctReturn(CTRef) [klabel(ctReturn)]
                       | ctScheduleNext(CTFrame, Int, CTEnv) [klabel(ctScheduleNext)]
                       | ctInvoke(Int, CTSlice) [klabel(ctInvoke)]
                       | ctEnter(CTFunction, CTSlice) [klabel(ctEnter)]
                       | ctBound(CTBinding, Int, Int) [klabel(ctBound)]
                       | ctCases(CTRef, CTSlice, CTEnv) [klabel(ctCases)]
                       | ctCaseResult(CTMatching, CTRef, Int, CTSlice, CTEnv) [klabel(ctCaseResult)]
                       | ctPrimResult(CTPrimitive) [klabel(ctPrimResult)]
                       | ctError(Int) [klabel(ctError)]
                       | ctMaterialize(Int, Int, CTSlice) [klabel(ctMaterialize)]
  syntax CTExhaust ::= ctFuel() [klabel(ctFuel)]
                       | ctDataNodes() [klabel(ctDataNodes)]
                       | ctDataFields() [klabel(ctDataFields)]
                       | ctEnvironmentCells() [klabel(ctEnvironmentCells)]
                       | ctHelperTasks() [klabel(ctHelperTasks)]
                       | ctHelperWork() [klabel(ctHelperWork)]
                       | ctSerializationBytes() [klabel(ctSerializationBytes)]
  syntax CTOutcome ::= ctRunning() [klabel(ctRunning)]
                       | ctHalted(CTRef) [klabel(ctHalted)]
                       | ctRejected(Int) [klabel(ctRejected)]
                       | ctExhausted(CTExhaust) [klabel(ctExhausted)]
  syntax CTAlloc ::= ctAlloc(Int, Int, Int) [klabel(ctAlloc)]
  syntax CTActive ::= ctActive(Int, Int, Int, Int) [klabel(ctActive)]
  syntax CTRoot ::= ctRoot(CTControl, Int, CTEnv, Int, CTOutcome, Int, Int, Int, Int, Int, Int, CTAlloc, CTActive, CTActive, CTAlloc, Int, CTFrames) [klabel(ctRoot)]
  syntax CTLanes ::= ctNoLanes() [klabel(ctNoLanes)]
                     | ctLane(Int, CTLanes) [klabel(ctLane)]
endmodule
