requires "c6-positive-context-syntax.k"

module SHERLOCK-C6-COMPLETE-POSITIVE-META-SYNTAX
  imports SHERLOCK-C6-POSITIVE-CONTEXT-SYNTAX
  // Complete positive byte-projection carriers. No transition/refusal policy.
  syntax CMBytes ::= cmNoBytes() [klabel(cmNoBytes)]
  syntax CMBytes ::= cmByte(Int, CMBytes) [klabel(cmByte)]
  syntax CMPair ::= cmPair(CMBytes, CMBytes) [klabel(cmPair)]
  syntax CMOptPair ::= cmNoPair() [klabel(cmNoPair)]
  syntax CMOptPair ::= cmSomePair(CMPair) [klabel(cmSomePair)]
  syntax CMGrammar ::= cmDedicated() [klabel(cmDedicated)]
  syntax CMGrammar ::= cmGeneric() [klabel(cmGeneric)]
  syntax CMFinance ::= cmFinanceAbsent() [klabel(cmFinanceAbsent)]
  syntax CMFinance ::= cmFinanceReserved() [klabel(cmFinanceReserved)]
  syntax CMDigest ::= cmUnselected() [klabel(cmUnselected)]
  syntax CMDigest ::= cmSelected(CMPair, CMBytes) [klabel(cmSelected)]
  syntax CMIdentity ::= cmIdentity(Int, CMGrammar, CMFinance, CMPair, CMDigest, CMDigest, CMOptPair, CMDigest) [klabel(cmIdentity)]
  syntax CMWidthEntry ::= cmWidth(CMBytes, Int) [klabel(cmWidth)]
  syntax CMWidthList ::= cmNoWidthList() [klabel(cmNoWidthList)]
  syntax CMWidthList ::= cmWidthItem(CMWidthEntry, CMWidthList) [klabel(cmWidthItem)]
  syntax CMWidths ::= cmWidths(CMWidthList, CMWidthList, CMWidthList) [klabel(cmWidths)]
  syntax CMOptWidths ::= cmNoWidths() [klabel(cmNoWidths)]
  syntax CMOptWidths ::= cmSomeWidths(CMWidths) [klabel(cmSomeWidths)]
  syntax CMLayout ::= cmLayout(CMPair, CMOptPair, CMOptWidths, CMOptPair, CXBounds, CXLayoutCaps, Bool) [klabel(cmLayout)]
  syntax CMRunInt ::= cmNegative() [klabel(cmNegative)]
  syntax CMRunInt ::= cmNat(Int) [klabel(cmNat)]
  syntax CMRunInt ::= cmAbove() [klabel(cmAbove)]
  syntax CMRunId ::= cmRunId(CMIdentity, CMRunInt, CMRunInt) [klabel(cmRunId)]
  syntax CMMetadata ::= cmMetadata(CMIdentity, CXBounds, CMLayout, CMRunId) [klabel(cmMetadata)]
  syntax CMLimits ::= cmLimits(Int, Int, Int, Int, Int) [klabel(cmLimits)]
  syntax CMField ::= cmFIdentity() [klabel(cmFIdentity)]
  syntax CMField ::= cmFRunId() [klabel(cmFRunId)]
  syntax CMField ::= cmFLayout() [klabel(cmFLayout)]
  syntax CMField ::= cmFLayoutVersion() [klabel(cmFLayoutVersion)]
  syntax CMField ::= cmFLayoutDigest() [klabel(cmFLayoutDigest)]
  syntax CMField ::= cmFBoundsDigest() [klabel(cmFBoundsDigest)]
  syntax CMField ::= cmFFieldId() [klabel(cmFFieldId)]
  syntax CMField ::= cmFMembershipDigest() [klabel(cmFMembershipDigest)]
  syntax CMField ::= cmFFormat() [klabel(cmFFormat)]
  syntax CMField ::= cmFBytes() [klabel(cmFBytes)]
  syntax CMField ::= cmFFirst() [klabel(cmFFirst)]
  syntax CMField ::= cmFSecond() [klabel(cmFSecond)]
  syntax CMField ::= cmFWidths() [klabel(cmFWidths)]
  syntax CMField ::= cmFIndexWidths() [klabel(cmFIndexWidths)]
  syntax CMField ::= cmFCounterWidths() [klabel(cmFCounterWidths)]
  syntax CMField ::= cmFRecordWidths() [klabel(cmFRecordWidths)]
  syntax CMField ::= cmFName() [klabel(cmFName)]
  syntax CMField ::= cmFScalarLayoutId() [klabel(cmFScalarLayoutId)]
  syntax CMPath ::= cmNoPath() [klabel(cmNoPath)]
  syntax CMPath ::= cmField(CMField, CMPath) [klabel(cmField)]
  syntax CMPath ::= cmIndex(Int, CMPath) [klabel(cmIndex)]
  syntax CMBlobKind ::= cmText() [klabel(cmText)]
  syntax CMBlobKind ::= cmOpaque() [klabel(cmOpaque)]
  syntax CMSpan ::= cmSpan(CMBlobKind, CMPath, Int, Int, Int, CMBytes) [klabel(cmSpan)]
  syntax CMSpans ::= cmNoSpans() [klabel(cmNoSpans)]
  syntax CMSpans ::= cmSpanItem(CMSpan, CMSpans) [klabel(cmSpanItem)]
  syntax CMReader ::= cmReader(CTLanes, Int, CMSpans, Int, Int) [klabel(cmReader)]
  syntax CMObservation ::= cmObservation(CTLanes, CMMetadata, CMSpans, Int, Int, Int) [klabel(cmObservation)]
  syntax CMObservations ::= cmNoObservations() [klabel(cmNoObservations)]
  syntax CMObservations ::= cmObservationItem(CMObservation, CMObservations) [klabel(cmObservationItem)]
  syntax CMCases ::= cmNoCases() [klabel(cmNoCases)]
  syntax CMCases ::= cmCase(String, CMLimits, CMMetadata, CMCases) [klabel(cmCase)]
  syntax CMBytesRead ::= cmBytesRead(CMBytes, CMReader) [klabel(cmBytesRead)]
  syntax CMPairRead ::= cmPairRead(CMPair, CMReader) [klabel(cmPairRead)]
  syntax CMOptPairRead ::= cmOptPairRead(CMOptPair, CMReader) [klabel(cmOptPairRead)]
  syntax CMDigestRead ::= cmDigestRead(CMDigest, CMReader) [klabel(cmDigestRead)]
  syntax CMIdentityRead ::= cmIdentityRead(CMIdentity, CMReader) [klabel(cmIdentityRead)]
  syntax CMBoundsRead ::= cmBoundsRead(CXBounds, CMReader) [klabel(cmBoundsRead)]
  syntax CMCapsRead ::= cmCapsRead(CXLayoutCaps, CMReader) [klabel(cmCapsRead)]
  syntax CMWidthListRead ::= cmWidthListRead(CMWidthList, CMReader) [klabel(cmWidthListRead)]
  syntax CMWidthsRead ::= cmWidthsRead(CMWidths, CMReader) [klabel(cmWidthsRead)]
  syntax CMOptWidthsRead ::= cmOptWidthsRead(CMOptWidths, CMReader) [klabel(cmOptWidthsRead)]
  syntax CMLayoutRead ::= cmLayoutRead(CMLayout, CMReader) [klabel(cmLayoutRead)]
  syntax CMRunIntRead ::= cmRunIntRead(CMRunInt, CMReader) [klabel(cmRunIntRead)]
  syntax CMRunIdRead ::= cmRunIdRead(CMRunId, CMReader) [klabel(cmRunIdRead)]
  syntax CMMetadataRead ::= cmMetadataRead(CMMetadata, CMReader) [klabel(cmMetadataRead)]
endmodule
