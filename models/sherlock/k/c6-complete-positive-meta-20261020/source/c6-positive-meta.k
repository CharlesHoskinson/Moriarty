  rule cmLayoutStep1(V0, P, cmOptPairRead(V1, R)) => cmLayoutStep2(V0, V1, P, cmReadOptWidths(cmAppendField(P, cmFWidths()), R))
  syntax CMLayoutRead ::= cmLayoutStep2(CMPair, CMOptPair, CMPath, CMOptWidthsRead) [function, klabel(cmLayoutStep2)]
  rule cmLayoutStep2(V0, V1, P, cmOptWidthsRead(V2, R)) => cmLayoutStep3(V0, V1, V2, P, cmReadOptPair(cmAppendField(P, cmFScalarLayoutId()), R))
  syntax CMLayoutRead ::= cmLayoutStep3(CMPair, CMOptPair, CMOptWidths, CMPath, CMOptPairRead) [function, klabel(cmLayoutStep3)]
  rule cmLayoutStep3(V0, V1, V2, P, cmOptPairRead(V3, R)) => cmLayoutStep4(V0, V1, V2, V3, P, cmReadBounds(P, R))
  syntax CMLayoutRead ::= cmLayoutStep4(CMPair, CMOptPair, CMOptWidths, CMOptPair, CMPath, CMBoundsRead) [function, klabel(cmLayoutStep4)]
  rule cmLayoutStep4(V0, V1, V2, V3, P, cmBoundsRead(V4, R)) => cmLayoutStep5(V0, V1, V2, V3, V4, P, cmReadCaps(P, R))
  syntax CMLayoutRead ::= cmLayoutStep5(CMPair, CMOptPair, CMOptWidths, CMOptPair, CXBounds, CMPath, CMCapsRead) [function, klabel(cmLayoutStep5)]
