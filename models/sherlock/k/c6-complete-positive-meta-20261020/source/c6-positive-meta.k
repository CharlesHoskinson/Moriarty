  syntax CMRunIntRead ::= cmReadRunInt(CMPath, CMReader) [function, klabel(cmReadRunInt)]
  rule cmReadRunInt(_, cmReader(ctLane(0, ctLane(0, L)), C, S, B, W)) => cmRunIntRead(cmNegative(), cmReader(L, C +Int 2, S, B, W))
  rule cmReadRunInt(_, cmReader(ctLane(1, ctLane(N, L)), C, S, B, W)) => cmRunIntRead(cmNat(N), cmReader(L, C +Int 2, S, B, W))
  rule cmReadRunInt(_, cmReader(ctLane(2, ctLane(0, L)), C, S, B, W)) => cmRunIntRead(cmAbove(), cmReader(L, C +Int 2, S, B, W))
