requires "c6-positive-meta-syntax.k"
requires "c6-typed-root-codec.k"

module SHERLOCK-C6-COMPLETE-POSITIVE-META
  imports SHERLOCK-C6-COMPLETE-POSITIVE-META-SYNTAX
  imports SHERLOCK-C6-TYPED-ROOT
  // Positive canonical images only; limits/width/UTF8 premises are external.
  // No admission, error-firstness, refusal, transition, authentication or clock policy.
  syntax Int ::= cmByteCount(CMBytes) [function, klabel(cmByteCount)]
  rule cmByteCount(cmNoBytes()) => 0
  rule cmByteCount(cmByte(_, T)) => 1 +Int cmByteCount(T)
  syntax CTLanes ::= cmBytesLanes(CMBytes) [function, klabel(cmBytesLanes)]
  rule cmBytesLanes(cmNoBytes()) => ctNoLanes()
  rule cmBytesLanes(cmByte(H, T)) => ctLane(H, cmBytesLanes(T))
  syntax CMBytes ::= cmTakeBytes(Int, CTLanes) [function, klabel(cmTakeBytes)]
  rule cmTakeBytes(0, _) => cmNoBytes()
  rule cmTakeBytes(N, ctLane(H, T)) => cmByte(H, cmTakeBytes(N -Int 1, T)) requires N >Int 0
  syntax CMPath ::= cmAppendField(CMPath, CMField) [function, klabel(cmAppendField)]
  rule cmAppendField(cmNoPath(), X) => cmField(X, cmNoPath())
  rule cmAppendField(cmField(F, T), X) => cmField(F, cmAppendField(T, X))
  rule cmAppendField(cmIndex(I, T), X) => cmIndex(I, cmAppendField(T, X))
  syntax CMPath ::= cmAppendIndex(CMPath, Int) [function, klabel(cmAppendIndex)]
  rule cmAppendIndex(cmNoPath(), X) => cmIndex(X, cmNoPath())
  rule cmAppendIndex(cmField(F, T), X) => cmField(F, cmAppendIndex(T, X))
  rule cmAppendIndex(cmIndex(I, T), X) => cmIndex(I, cmAppendIndex(T, X))
  syntax CMSpans ::= cmReverseSpans(CMSpans, CMSpans) [function, klabel(cmReverseSpans)]
  rule cmReverseSpans(cmNoSpans(), A) => A
  rule cmReverseSpans(cmSpanItem(H, T), A) => cmReverseSpans(T, cmSpanItem(H, A))
  syntax Int ::= cmGrammarTag(CMGrammar) [function, klabel(cmGrammarTag)]
  syntax CMGrammar ::= cmGrammarDecode(Int) [function, klabel(cmGrammarDecode)]
  rule cmGrammarTag(cmDedicated()) => 0
  rule cmGrammarDecode(0) => cmDedicated()
  rule cmGrammarTag(cmGeneric()) => 1
  rule cmGrammarDecode(1) => cmGeneric()
  syntax Int ::= cmFinanceTag(CMFinance) [function, klabel(cmFinanceTag)]
  syntax CMFinance ::= cmFinanceDecode(Int) [function, klabel(cmFinanceDecode)]
  rule cmFinanceTag(cmFinanceAbsent()) => 0
  rule cmFinanceDecode(0) => cmFinanceAbsent()
  rule cmFinanceTag(cmFinanceReserved()) => 1
  rule cmFinanceDecode(1) => cmFinanceReserved()
  syntax CTLanes ::= cmEncodeBlob(CMBytes) [function, klabel(cmEncodeBlob)]
  rule cmEncodeBlob(B) => ctLane(cmByteCount(B), cmBytesLanes(B))
  syntax CTLanes ::= cmEncodePair(CMPair) [function, klabel(cmEncodePair)]
  rule cmEncodePair(cmPair(A, B)) => ctJoin(cmEncodeBlob(A), cmEncodeBlob(B))
  syntax CTLanes ::= cmEncodeOptPair(CMOptPair) [function, klabel(cmEncodeOptPair)]
  rule cmEncodeOptPair(cmNoPair()) => ctLane(0, ctNoLanes())
  rule cmEncodeOptPair(cmSomePair(P)) => ctLane(1, cmEncodePair(P))
  syntax CTLanes ::= cmEncodeDigest(CMDigest) [function, klabel(cmEncodeDigest)]
  rule cmEncodeDigest(cmUnselected()) => ctLane(0, ctNoLanes())
  rule cmEncodeDigest(cmSelected(F, B)) => ctLane(1, ctJoin(cmEncodePair(F), cmEncodeBlob(B)))
  syntax CTLanes ::= cmEncodeIdentity(CMIdentity) [function, klabel(cmEncodeIdentity)]
  rule cmEncodeIdentity(cmIdentity(I, G, F, V, L, B, P, M)) => ctJoin(ctLane(I, ctLane(cmGrammarTag(G), ctLane(cmFinanceTag(F), ctNoLanes()))), ctJoin(cmEncodePair(V), ctJoin(cmEncodeDigest(L), ctJoin(cmEncodeDigest(B), ctJoin(cmEncodeOptPair(P), cmEncodeDigest(M))))))
  syntax CTLanes ::= cmEncodeBounds(CXBounds) [function, klabel(cmEncodeBounds)]
  rule cmEncodeBounds(cxBounds(B0, B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11, B12, B13, B14, B15, B16, B17, B18, B19, B20, B21)) => ctLane(B0, ctLane(B1, ctLane(B2, ctLane(B3, ctLane(B4, ctLane(B5, ctLane(B6, ctLane(B7, ctLane(B8, ctLane(B9, ctLane(B10, ctLane(B11, ctLane(B12, ctLane(B13, ctLane(B14, ctLane(B15, ctLane(B16, ctLane(B17, ctLane(B18, ctLane(B19, ctLane(B20, ctLane(B21, ctNoLanes()))))))))))))))))))))))
  syntax CTLanes ::= cmEncodeCaps(CXLayoutCaps) [function, klabel(cmEncodeCaps)]
  rule cmEncodeCaps(cxLayoutCaps(A, B, C, D)) => ctLane(A, ctLane(B, ctLane(C, ctLane(D, ctNoLanes()))))
  syntax Int ::= cmWidthCount(CMWidthList) [function, klabel(cmWidthCount)]
  rule cmWidthCount(cmNoWidthList()) => 0
  rule cmWidthCount(cmWidthItem(_, T)) => 1 +Int cmWidthCount(T)
  syntax CTLanes ::= cmEncodeWidthItems(CMWidthList) [function, klabel(cmEncodeWidthItems)]
  rule cmEncodeWidthItems(cmNoWidthList()) => ctNoLanes()
  rule cmEncodeWidthItems(cmWidthItem(cmWidth(B, W), T)) => ctJoin(cmEncodeBlob(B), ctJoin(ctLane(W, ctNoLanes()), cmEncodeWidthItems(T)))
  syntax CTLanes ::= cmEncodeWidthList(CMWidthList) [function, klabel(cmEncodeWidthList)]
  rule cmEncodeWidthList(L) => ctLane(cmWidthCount(L), cmEncodeWidthItems(L))
  syntax CTLanes ::= cmEncodeWidths(CMOptWidths) [function, klabel(cmEncodeWidths)]
  rule cmEncodeWidths(cmNoWidths()) => ctLane(0, ctNoLanes())
  rule cmEncodeWidths(cmSomeWidths(cmWidths(I, C, R))) => ctLane(1, ctJoin(cmEncodeWidthList(I), ctJoin(cmEncodeWidthList(C), cmEncodeWidthList(R))))
  syntax CTLanes ::= cmEncodeLayout(CMLayout) [function, klabel(cmEncodeLayout)]
  rule cmEncodeLayout(cmLayout(V, F, W, S, B, C, P)) => ctJoin(cmEncodePair(V), ctJoin(cmEncodeOptPair(F), ctJoin(cmEncodeWidths(W), ctJoin(cmEncodeOptPair(S), ctJoin(cmEncodeBounds(B), ctJoin(cmEncodeCaps(C), ctLane(ctBool(P), ctNoLanes())))))))
  syntax CTLanes ::= cmEncodeRunInt(CMRunInt) [function, klabel(cmEncodeRunInt)]
  rule cmEncodeRunInt(cmNegative()) => ctLane(0, ctLane(0, ctNoLanes()))
  rule cmEncodeRunInt(cmNat(N)) => ctLane(1, ctLane(N, ctNoLanes()))
  rule cmEncodeRunInt(cmAbove()) => ctLane(2, ctLane(0, ctNoLanes()))
  syntax CTLanes ::= cmEncodeRunId(CMRunId) [function, klabel(cmEncodeRunId)]
  rule cmEncodeRunId(cmRunId(I, F, S)) => ctJoin(cmEncodeIdentity(I), ctJoin(cmEncodeRunInt(F), cmEncodeRunInt(S)))
  syntax CTLanes ::= cmEncodeMetadata(CMMetadata) [function, klabel(cmEncodeMetadata)]
  rule cmEncodeMetadata(cmMetadata(I, B, L, R)) => ctJoin(ctLane(18918541878711089, ctLane(1, ctLane(1296389185, ctNoLanes()))), ctJoin(cmEncodeIdentity(I), ctJoin(cmEncodeBounds(B), ctJoin(cmEncodeLayout(L), cmEncodeRunId(R)))))
  syntax CMBytesRead ::= cmReadBlob(CMPath, CMBlobKind, CMReader) [function, klabel(cmReadBlob)]
  rule cmReadBlob(P, K, cmReader(ctLane(N, L), C, S, B, W)) => cmBytesRead(cmTakeBytes(N, L), cmReader(ctDrop(N, L), C +Int 1 +Int N, cmSpanItem(cmSpan(K, P, C, C +Int 1, C +Int 1 +Int N, cmTakeBytes(N, L)), S), B +Int N, W)) requires N >=Int 0
  syntax CMPairRead ::= cmReadPair(CMPath, CMReader) [function, klabel(cmReadPair)]
  rule cmReadPair(P, R) => cmPairFirst(P, cmReadBlob(cmAppendField(P, cmFFirst()), cmText(), R))
  syntax CMPairRead ::= cmPairFirst(CMPath, CMBytesRead) [function, klabel(cmPairFirst)]
  rule cmPairFirst(P, cmBytesRead(A, R)) => cmPairSecond(A, cmReadBlob(cmAppendField(P, cmFSecond()), cmText(), R))
  syntax CMPairRead ::= cmPairSecond(CMBytes, CMBytesRead) [function, klabel(cmPairSecond)]
  rule cmPairSecond(A, cmBytesRead(B, R)) => cmPairRead(cmPair(A, B), R)
  syntax CMOptPairRead ::= cmReadOptPair(CMPath, CMReader) [function, klabel(cmReadOptPair)]
  rule cmReadOptPair(_, cmReader(ctLane(0, L), C, S, B, W)) => cmOptPairRead(cmNoPair(), cmReader(L, C +Int 1, S, B, W))
  rule cmReadOptPair(P, cmReader(ctLane(1, L), C, S, B, W)) => cmSomePairRead(cmReadPair(P, cmReader(L, C +Int 1, S, B, W)))
  syntax CMOptPairRead ::= cmSomePairRead(CMPairRead) [function, klabel(cmSomePairRead)]
  rule cmSomePairRead(cmPairRead(P, R)) => cmOptPairRead(cmSomePair(P), R)
  syntax CMDigestRead ::= cmReadDigest(CMPath, CMReader) [function, klabel(cmReadDigest)]
  rule cmReadDigest(_, cmReader(ctLane(0, L), C, S, B, W)) => cmDigestRead(cmUnselected(), cmReader(L, C +Int 1, S, B, W))
  rule cmReadDigest(P, cmReader(ctLane(1, L), C, S, B, W)) => cmDigestFormat(P, cmReadPair(cmAppendField(P, cmFFormat()), cmReader(L, C +Int 1, S, B, W)))
  syntax CMDigestRead ::= cmDigestFormat(CMPath, CMPairRead) [function, klabel(cmDigestFormat)]
  rule cmDigestFormat(P, cmPairRead(F, R)) => cmDigestBytes(F, cmReadBlob(cmAppendField(P, cmFBytes()), cmOpaque(), R))
  syntax CMDigestRead ::= cmDigestBytes(CMPair, CMBytesRead) [function, klabel(cmDigestBytes)]
  rule cmDigestBytes(F, cmBytesRead(B, R)) => cmDigestRead(cmSelected(F, B), R)
  syntax CMIdentityRead ::= cmReadIdentity(CMPath, CMReader) [function, klabel(cmReadIdentity)]
  rule cmReadIdentity(P, cmReader(ctLane(A, ctLane(G, ctLane(F, L))), C, S, B, W)) => cmIdentityStep0(A, cmGrammarDecode(G), cmFinanceDecode(F), P, cmReadPair(cmAppendField(P, cmFLayoutVersion()), cmReader(L, C +Int 3, S, B, W)))
  syntax CMIdentityRead ::= cmIdentityStep0(Int, CMGrammar, CMFinance, CMPath, CMPairRead) [function, klabel(cmIdentityStep0)]
  rule cmIdentityStep0(A, G0, F0, P, cmPairRead(V0, R)) => cmIdentityStep1(A, G0, F0, V0, P, cmReadDigest(cmAppendField(P, cmFLayoutDigest()), R))
  syntax CMIdentityRead ::= cmIdentityStep1(Int, CMGrammar, CMFinance, CMPair, CMPath, CMDigestRead) [function, klabel(cmIdentityStep1)]
  rule cmIdentityStep1(A, G0, F0, V0, P, cmDigestRead(V1, R)) => cmIdentityStep2(A, G0, F0, V0, V1, P, cmReadDigest(cmAppendField(P, cmFBoundsDigest()), R))
  syntax CMIdentityRead ::= cmIdentityStep2(Int, CMGrammar, CMFinance, CMPair, CMDigest, CMPath, CMDigestRead) [function, klabel(cmIdentityStep2)]
  rule cmIdentityStep2(A, G0, F0, V0, V1, P, cmDigestRead(V2, R)) => cmIdentityStep3(A, G0, F0, V0, V1, V2, P, cmReadOptPair(cmAppendField(P, cmFFieldId()), R))
  syntax CMIdentityRead ::= cmIdentityStep3(Int, CMGrammar, CMFinance, CMPair, CMDigest, CMDigest, CMPath, CMOptPairRead) [function, klabel(cmIdentityStep3)]
  rule cmIdentityStep3(A, G0, F0, V0, V1, V2, P, cmOptPairRead(V3, R)) => cmIdentityStep4(A, G0, F0, V0, V1, V2, V3, P, cmReadDigest(cmAppendField(P, cmFMembershipDigest()), R))
  syntax CMIdentityRead ::= cmIdentityStep4(Int, CMGrammar, CMFinance, CMPair, CMDigest, CMDigest, CMOptPair, CMPath, CMDigestRead) [function, klabel(cmIdentityStep4)]
  rule cmIdentityStep4(A, G0, F0, V0, V1, V2, V3, P, cmDigestRead(V4, R)) => cmIdentityRead(cmIdentity(A, G0, F0, V0, V1, V2, V3, V4), R)
  syntax CMBoundsRead ::= cmReadBounds(CMPath, CMReader) [function, klabel(cmReadBounds)]
  rule cmReadBounds(_, cmReader(ctLane(B0, ctLane(B1, ctLane(B2, ctLane(B3, ctLane(B4, ctLane(B5, ctLane(B6, ctLane(B7, ctLane(B8, ctLane(B9, ctLane(B10, ctLane(B11, ctLane(B12, ctLane(B13, ctLane(B14, ctLane(B15, ctLane(B16, ctLane(B17, ctLane(B18, ctLane(B19, ctLane(B20, ctLane(B21, L)))))))))))))))))))))), C, S, B, W)) => cmBoundsRead(cxBounds(B0, B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11, B12, B13, B14, B15, B16, B17, B18, B19, B20, B21), cmReader(L, C +Int 22, S, B, W))
  syntax CMCapsRead ::= cmReadCaps(CMPath, CMReader) [function, klabel(cmReadCaps)]
  rule cmReadCaps(_, cmReader(ctLane(A, ctLane(D, ctLane(E, ctLane(F, L)))), C, S, B, W)) => cmCapsRead(cxLayoutCaps(A, D, E, F), cmReader(L, C +Int 4, S, B, W))
  syntax CMWidthListRead ::= cmReadWidthList(CMPath, CMReader) [function, klabel(cmReadWidthList)]
  rule cmReadWidthList(P, cmReader(ctLane(N, L), C, S, B, W)) => cmReadWidthItems(N, 0, P, cmReader(L, C +Int 1, S, B, W +Int N)) requires N >=Int 0
  syntax CMWidthListRead ::= cmReadWidthItems(Int, Int, CMPath, CMReader) [function, klabel(cmReadWidthItems)]
  rule cmReadWidthItems(0, _, _, R) => cmWidthListRead(cmNoWidthList(), R)
  rule cmReadWidthItems(N, I, P, R) => cmReadWidthName(N, I, P, cmReadBlob(cmAppendField(cmAppendIndex(P, I), cmFName()), cmText(), R)) requires N >Int 0
  syntax CMWidthListRead ::= cmReadWidthName(Int, Int, CMPath, CMBytesRead) [function, klabel(cmReadWidthName)]
  rule cmReadWidthName(N, I, P, cmBytesRead(V, cmReader(ctLane(X, L), C, S, B, W))) => cmReadWidthTail(cmWidth(V, X), cmReadWidthItems(N -Int 1, I +Int 1, P, cmReader(L, C +Int 1, S, B, W)))
  syntax CMWidthListRead ::= cmReadWidthTail(CMWidthEntry, CMWidthListRead) [function, klabel(cmReadWidthTail)]
  rule cmReadWidthTail(H, cmWidthListRead(T, R)) => cmWidthListRead(cmWidthItem(H, T), R)
  syntax CMWidthsRead ::= cmReadWidths(CMPath, CMReader) [function, klabel(cmReadWidths)]
  rule cmReadWidths(P, R) => cmWidthsStep0(P, cmReadWidthList(cmAppendField(P, cmFIndexWidths()), R))
  syntax CMWidthsRead ::= cmWidthsStep0(CMPath, CMWidthListRead) [function, klabel(cmWidthsStep0)]
  rule cmWidthsStep0(P, cmWidthListRead(V0, R)) => cmWidthsStep1(V0, P, cmReadWidthList(cmAppendField(P, cmFCounterWidths()), R))
  syntax CMWidthsRead ::= cmWidthsStep1(CMWidthList, CMPath, CMWidthListRead) [function, klabel(cmWidthsStep1)]
  rule cmWidthsStep1(V0, P, cmWidthListRead(V1, R)) => cmWidthsStep2(V0, V1, P, cmReadWidthList(cmAppendField(P, cmFRecordWidths()), R))
  syntax CMWidthsRead ::= cmWidthsStep2(CMWidthList, CMWidthList, CMPath, CMWidthListRead) [function, klabel(cmWidthsStep2)]
  rule cmWidthsStep2(V0, V1, P, cmWidthListRead(V2, R)) => cmWidthsRead(cmWidths(V0, V1, V2), R)
  syntax CMOptWidthsRead ::= cmReadOptWidths(CMPath, CMReader) [function, klabel(cmReadOptWidths)]
  rule cmReadOptWidths(_, cmReader(ctLane(0, L), C, S, B, W)) => cmOptWidthsRead(cmNoWidths(), cmReader(L, C +Int 1, S, B, W))
  rule cmReadOptWidths(P, cmReader(ctLane(1, L), C, S, B, W)) => cmSomeWidthsRead(cmReadWidths(P, cmReader(L, C +Int 1, S, B, W)))
  syntax CMOptWidthsRead ::= cmSomeWidthsRead(CMWidthsRead) [function, klabel(cmSomeWidthsRead)]
  rule cmSomeWidthsRead(cmWidthsRead(V, R)) => cmOptWidthsRead(cmSomeWidths(V), R)
  syntax CMLayoutRead ::= cmReadLayout(CMPath, CMReader) [function, klabel(cmReadLayout)]
  rule cmReadLayout(P, R) => cmLayoutStep0(P, cmReadPair(cmAppendField(P, cmFLayoutVersion()), R))
  syntax CMLayoutRead ::= cmLayoutStep0(CMPath, CMPairRead) [function, klabel(cmLayoutStep0)]
