requires "c6-typed-root-syntax.k"

// Positive canonical codec domain only. No interpreter step, resource guard,
// admission, primitive/publication semantics or K/B clock relation. All unused
// lanes start at zero. Malformed/cap/refusal policy is explicitly outside this
// component. Decode laws are claimed only for positive canonical encodings.
module SHERLOCK-C6-TYPED-ROOT
  imports SHERLOCK-C6-TYPED-ROOT-SYNTAX

  syntax CTLanes ::= ctJoin(CTLanes, CTLanes) [function, klabel(ctJoin)]
  rule ctJoin(ctNoLanes(), R) => R
  rule ctJoin(ctLane(I, L), R) => ctLane(I, ctJoin(L, R))
  syntax Int ::= ctSize(CTLanes) [function, klabel(ctSize)]
  rule ctSize(ctNoLanes()) => 0
  rule ctSize(ctLane(_, L)) => 1 +Int ctSize(L)
  syntax CTLanes ::= ctTake(Int, CTLanes) [function, klabel(ctTake)]
  syntax CTLanes ::= ctDrop(Int, CTLanes) [function, klabel(ctDrop)]
  syntax Int ::= ctAt(Int, CTLanes) [function, klabel(ctAt)]
  rule ctTake(0, _) => ctNoLanes()
  rule ctTake(N, ctLane(I, L)) => ctLane(I, ctTake(N -Int 1, L)) requires N >Int 0
  rule ctDrop(0, L) => L
  rule ctDrop(N, ctLane(_, L)) => ctDrop(N -Int 1, L) requires N >Int 0
  rule ctAt(0, ctLane(I, _)) => I
  rule ctAt(N, ctLane(_, L)) => ctAt(N -Int 1, L) requires N >Int 0
  syntax Int ::= ctEnvTag(CTEnv) [function, klabel(ctEnvTag)]
  syntax Int ::= ctEnvIndex(CTEnv) [function, klabel(ctEnvIndex)]
  syntax Int ::= ctFunctionTag(CTFunction) [function, klabel(ctFunctionTag)]
  syntax Int ::= ctFunctionIndex(CTFunction) [function, klabel(ctFunctionIndex)]
  syntax Int ::= ctRefTag(CTRef) [function, klabel(ctRefTag)]
  syntax Int ::= ctRefIndex(CTRef) [function, klabel(ctRefIndex)]
  syntax Int ::= ctBool(Bool) [function, klabel(ctBool)]
  rule ctEnvTag(ctEnvNone()) => 0
  rule ctEnvTag(ctEnvSome(_)) => 1
  rule ctEnvIndex(ctEnvNone()) => 0
  rule ctEnvIndex(ctEnvSome(I)) => I
  rule ctFunctionTag(ctFunctionNone()) => 0
  rule ctFunctionTag(ctFunctionSome(_)) => 1
  rule ctFunctionIndex(ctFunctionNone()) => 0
  rule ctFunctionIndex(ctFunctionSome(I)) => I
  rule ctRefTag(ctConst(_)) => 0
  rule ctRefIndex(ctConst(I)) => I
  rule ctRefTag(ctData(_)) => 1
  rule ctRefIndex(ctData(I)) => I
  rule ctBool(false) => 0
  rule ctBool(true) => 1
  syntax CTEnv ::= ctEnvDecode(Int, Int) [function, klabel(ctEnvDecode)]
  syntax CTFunction ::= ctFunctionDecode(Int, Int) [function, klabel(ctFunctionDecode)]
  syntax CTRef ::= ctRefDecode(Int, Int) [function, klabel(ctRefDecode)]
  rule ctEnvDecode(0, 0) => ctEnvNone()
  rule ctEnvDecode(1, I) => ctEnvSome(I)
  rule ctFunctionDecode(0, 0) => ctFunctionNone()
  rule ctFunctionDecode(1, I) => ctFunctionSome(I)
  rule ctRefDecode(0, I) => ctConst(I)
  rule ctRefDecode(1, I) => ctData(I)
  syntax Bool ::= ctBoolDecode(Int) [function, klabel(ctBoolDecode)]
  rule ctBoolDecode(0) => false
  rule ctBoolDecode(1) => true
  syntax Int ::= ctBinary(CTBinary) [function, klabel(ctBinary)]
  syntax CTBinary ::= ctBinaryDecode(Int) [function, klabel(ctBinaryDecode)]
  rule ctBinary(ctAdd()) => 0
  rule ctBinaryDecode(0) => ctAdd()
  rule ctBinary(ctSub()) => 1
  rule ctBinaryDecode(1) => ctSub()
  rule ctBinary(ctMul()) => 2
  rule ctBinaryDecode(2) => ctMul()
  rule ctBinary(ctEq()) => 3
  rule ctBinaryDecode(3) => ctEq()
  rule ctBinary(ctLt()) => 4
  rule ctBinaryDecode(4) => ctLt()
  rule ctBinary(ctCons()) => 5
  rule ctBinaryDecode(5) => ctCons()
  rule ctBinary(ctBranch()) => 6
  rule ctBinaryDecode(6) => ctBranch()
  syntax Int ::= ctUnary(CTUnary) [function, klabel(ctUnary)]
  syntax CTUnary ::= ctUnaryDecode(Int) [function, klabel(ctUnaryDecode)]
  rule ctUnary(ctLeaf()) => 0
  rule ctUnaryDecode(0) => ctLeaf()
  rule ctUnary(ctNot()) => 1
  rule ctUnaryDecode(1) => ctNot()
  syntax Int ::= ctExhaust(CTExhaust) [function, klabel(ctExhaust)]
  syntax CTExhaust ::= ctExhaustDecode(Int) [function, klabel(ctExhaustDecode)]
  rule ctExhaust(ctFuel()) => 0
  rule ctExhaustDecode(0) => ctFuel()
  rule ctExhaust(ctDataNodes()) => 1
  rule ctExhaustDecode(1) => ctDataNodes()
  rule ctExhaust(ctDataFields()) => 2
  rule ctExhaustDecode(2) => ctDataFields()
  rule ctExhaust(ctEnvironmentCells()) => 3
  rule ctExhaustDecode(3) => ctEnvironmentCells()
  rule ctExhaust(ctHelperTasks()) => 4
  rule ctExhaustDecode(4) => ctHelperTasks()
  rule ctExhaust(ctHelperWork()) => 5
  rule ctExhaustDecode(5) => ctHelperWork()
  rule ctExhaust(ctSerializationBytes()) => 6
  rule ctExhaustDecode(6) => ctSerializationBytes()
  syntax Int ::= ctSliceStart(CTSlice) [function, klabel(ctSliceStart)]
  syntax Int ::= ctSliceLen(CTSlice) [function, klabel(ctSliceLen)]
  rule ctSliceStart(ctSlice(S, _)) => S
  rule ctSliceLen(ctSlice(_, N)) => N
  syntax CTLanes ::= ctEncodeFrame(CTFrame) [function, klabel(ctEncodeFrame)]
  syntax CTFrame ::= ctDecodeFrame(CTLanes) [function, klabel(ctDecodeFrame)]
  rule ctEncodeFrame(ctLetF(B, X, E, O)) => ctLane(0, ctLane(B, ctLane(X, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(0, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctLetF(A1, A2, ctEnvDecode(A3, A4), A5)
  rule ctEncodeFrame(ctLeftF(Op, X, E, O)) => ctLane(1, ctLane(ctBinary(Op), ctLane(X, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(1, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctLeftF(ctBinaryDecode(A1), A2, ctEnvDecode(A3, A4), A5)
  rule ctEncodeFrame(ctRightF(Op, V, O)) => ctLane(2, ctLane(ctBinary(Op), ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(2, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctRightF(ctBinaryDecode(A1), ctRefDecode(A2, A3), A4)
  rule ctEncodeFrame(ctUnaryF(Op, O)) => ctLane(3, ctLane(ctUnary(Op), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(3, ctLane(A1, ctLane(A2, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctUnaryF(ctUnaryDecode(A1), A2)
  rule ctEncodeFrame(ctIfF(T, F, E, O)) => ctLane(4, ctLane(T, ctLane(F, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(4, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctIfF(A1, A2, ctEnvDecode(A3, A4), A5)
  rule ctEncodeFrame(ctMatchF(S, E, O)) => ctLane(5, ctLane(ctSliceStart(S), ctLane(ctSliceLen(S), ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(5, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctMatchF(ctSlice(A1, A2), ctEnvDecode(A3, A4), A5)
  rule ctEncodeFrame(ctArgsF(F, D, R, E, O)) => ctLane(6, ctLane(F, ctLane(ctSliceStart(D), ctLane(ctSliceLen(D), ctLane(ctSliceStart(R), ctLane(ctSliceLen(R), ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(6, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(A6, ctLane(A7, ctLane(A8, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctArgsF(A1, ctSlice(A2, A3), ctSlice(A4, A5), ctEnvDecode(A6, A7), A8)
  rule ctEncodeFrame(ctReturnF(T, E, O)) => ctLane(7, ctLane(T, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(7, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctReturnF(A1, ctEnvDecode(A2, A3), A4)
  rule ctEncodeFrame(ctScopeF(E, O)) => ctLane(8, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(8, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))) => ctScopeF(ctEnvDecode(A1, A2), A3)
  rule ctEncodeFrame(ctConstructorFieldsF(T, C, I, FT, B, D, R, E, O)) => ctLane(9, ctLane(T, ctLane(C, ctLane(I, ctLane(FT, ctLane(ctBool(B), ctLane(ctSliceStart(D), ctLane(ctSliceLen(D), ctLane(ctSliceStart(R), ctLane(ctSliceLen(R), ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(O, ctNoLanes())))))))))))))
  rule ctDecodeFrame(ctLane(9, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(A6, ctLane(A7, ctLane(A8, ctLane(A9, ctLane(A10, ctLane(A11, ctLane(A12, ctNoLanes())))))))))))))) => ctConstructorFieldsF(A1, A2, A3, A4, ctBoolDecode(A5), ctSlice(A6, A7), ctSlice(A8, A9), ctEnvDecode(A10, A11), A12)
  syntax CTLanes ::= ctBindingLanes(CTBinding) [function, klabel(ctBindingLanes)]
  syntax CTLanes ::= ctMatchingLanes(CTMatching) [function, klabel(ctMatchingLanes)]
  syntax CTLanes ::= ctPrimitiveLanes(CTPrimitive) [function, klabel(ctPrimitiveLanes)]
  syntax CTLanes ::= ctOutcomeLanes(CTOutcome) [function, klabel(ctOutcomeLanes)]
  rule ctBindingLanes(ctBindingBad()) => ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))
  rule ctBindingLanes(ctBindingOk(E)) => ctLane(1, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctNoLanes())))
  rule ctMatchingLanes(ctNoMatch()) => ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))
  rule ctMatchingLanes(ctMatched(E)) => ctLane(1, ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctNoLanes())))
  rule ctPrimitiveLanes(ctPrimValue(V)) => ctLane(0, ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctNoLanes())))
  rule ctPrimitiveLanes(ctPrimError(C)) => ctLane(1, ctLane(C, ctLane(0, ctNoLanes())))
  rule ctOutcomeLanes(ctRunning()) => ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))
  rule ctOutcomeLanes(ctHalted(V)) => ctLane(1, ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctNoLanes())))
  rule ctOutcomeLanes(ctRejected(C)) => ctLane(2, ctLane(C, ctLane(0, ctNoLanes())))
  rule ctOutcomeLanes(ctExhausted(E)) => ctLane(3, ctLane(ctExhaust(E), ctLane(0, ctNoLanes())))
  syntax CTBinding ::= ctBindingDecode(Int, Int, Int) [function, klabel(ctBindingDecode)]
  syntax CTMatching ::= ctMatchingDecode(Int, Int, Int) [function, klabel(ctMatchingDecode)]
  syntax CTPrimitive ::= ctPrimitiveDecode(Int, Int, Int) [function, klabel(ctPrimitiveDecode)]
  syntax CTOutcome ::= ctOutcomeDecode(Int, Int, Int) [function, klabel(ctOutcomeDecode)]
  rule ctBindingDecode(0, 0, 0) => ctBindingBad()
  rule ctBindingDecode(1, T, I) => ctBindingOk(ctEnvDecode(T, I))
  rule ctMatchingDecode(0, 0, 0) => ctNoMatch()
  rule ctMatchingDecode(1, T, I) => ctMatched(ctEnvDecode(T, I))
  rule ctPrimitiveDecode(0, T, I) => ctPrimValue(ctRefDecode(T, I))
  rule ctPrimitiveDecode(1, C, 0) => ctPrimError(C)
  rule ctOutcomeDecode(0, 0, 0) => ctRunning()
  rule ctOutcomeDecode(1, T, I) => ctHalted(ctRefDecode(T, I))
  rule ctOutcomeDecode(2, C, 0) => ctRejected(C)
  rule ctOutcomeDecode(3, E, 0) => ctExhausted(ctExhaustDecode(E))
  syntax CTLanes ::= ctEncodeControl(CTControl) [function, klabel(ctEncodeControl)]
  syntax CTControl ::= ctDecodeControl(CTLanes) [function, klabel(ctDecodeControl)]
  rule ctEncodeControl(ctEval(X)) => ctLane(0, ctLane(X, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(0, ctLane(A1, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctEval(A1)
  rule ctEncodeControl(ctReturn(V)) => ctLane(1, ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(1, ctLane(A1, ctLane(A2, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctReturn(ctRefDecode(A1, A2))
  rule ctEncodeControl(ctInvoke(F, S)) => ctLane(3, ctLane(F, ctLane(ctSliceStart(S), ctLane(ctSliceLen(S), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(3, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctInvoke(A1, ctSlice(A2, A3))
  rule ctEncodeControl(ctEnter(F, S)) => ctLane(4, ctLane(ctFunctionTag(F), ctLane(ctFunctionIndex(F), ctLane(ctSliceStart(S), ctLane(ctSliceLen(S), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(4, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctEnter(ctFunctionDecode(A1, A2), ctSlice(A3, A4))
  rule ctEncodeControl(ctBound(B, T, X)) => ctLane(5, ctLane(ctAt(0, ctBindingLanes(B)), ctLane(ctAt(1, ctBindingLanes(B)), ctLane(ctAt(2, ctBindingLanes(B)), ctLane(T, ctLane(X, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(5, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctBound(ctBindingDecode(A1, A2, A3), A4, A5)
  rule ctEncodeControl(ctCases(V, S, E)) => ctLane(6, ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctLane(ctSliceStart(S), ctLane(ctSliceLen(S), ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(6, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(A6, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctCases(ctRefDecode(A1, A2), ctSlice(A3, A4), ctEnvDecode(A5, A6))
  rule ctEncodeControl(ctCaseResult(M, V, B, S, E)) => ctLane(7, ctLane(ctAt(0, ctMatchingLanes(M)), ctLane(ctAt(1, ctMatchingLanes(M)), ctLane(ctAt(2, ctMatchingLanes(M)), ctLane(ctRefTag(V), ctLane(ctRefIndex(V), ctLane(B, ctLane(ctSliceStart(S), ctLane(ctSliceLen(S), ctLane(ctEnvTag(E), ctLane(ctEnvIndex(E), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(7, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(A4, ctLane(A5, ctLane(A6, ctLane(A7, ctLane(A8, ctLane(A9, ctLane(A10, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctCaseResult(ctMatchingDecode(A1, A2, A3), ctRefDecode(A4, A5), A6, ctSlice(A7, A8), ctEnvDecode(A9, A10))
  rule ctEncodeControl(ctPrimResult(P)) => ctLane(8, ctLane(ctAt(0, ctPrimitiveLanes(P)), ctLane(ctAt(1, ctPrimitiveLanes(P)), ctLane(ctAt(2, ctPrimitiveLanes(P)), ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
  rule ctDecodeControl(ctLane(8, ctLane(A1, ctLane(A2, ctLane(A3, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))) => ctPrimResult(ctPrimitiveDecode(A1, A2, A3))
  rule ctEncodeControl(ctError(C)) => ctLane(9, ctLane(C, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctLane(0, ctNoLanes())))))))))))))))))
