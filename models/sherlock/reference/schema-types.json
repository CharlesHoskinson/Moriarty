  "ownership": "Integrator owns shared schema; source rule catalog and independent oracles have separate authors; security invariants/policies/gates exclusively Opus",
  "scope": {
    "frozen_A": "Source adapter only; no new A capacity, charge or result",
    "proposed_B": "Strict first-order named self/mutual recursion; closed monomorphic nominal recursive groups; full language and financial extensions remain required",
    "financial_state_extension": "Committed/tentative state, ordered effects, duties, pending operations and bound external observations are a separately required extension, not implemented by pure rows",
    "native_field": "Separately qualified; no Midnight compatibility or native commitment selected"
  },
  "layout_contract": {
    "unbounded_semantic_types": [
      "SemanticValue",
      "Environment",
      "Frame",
      "LegacyControl",
      "Control",
      "ReferenceState",
      "StepRecord"
    ],
    "bounded_image": "MachineImage tables use fixed declared capacities; no recursive semantic object is a circuit payload",
    "index_encoding": "Each table defines width and optional-index convention in its reviewed LayoutSchema; no host u32/u64 limit is implicit in this source contract",
    "tag_encoding": "LayoutSchema must assign fixed tags and zero padding for every listed variant; no tag ABI is frozen by this file",
    "scalar_baseline": "UInt128 sixteen little-endian bytes, each in [0,255]; embedding into F and constraints are separately implemented/qualified",
    "remaining_layout_inputs": [
      "Names dictionary and all source maps are host metadata; native rows carry bounded NameId indices",
      "Exact controls/valueSlots and per-case payload widths must be supplied before layout/encoding implementation",
      "Physical row allocation/reuse and all failure charges consume the Opus Phase0 policy, never generated from this schema",
      "RuleId, OccurrenceId and ReasonId dictionaries and fixed digest format/width are required layout inputs; no unbounded strings are in native rows."
    ],
    "host_metadata_types": [
      "MachineIdentity",
      "SourceOccurrence",
      "Name",
      "Digest",
      "Text"
    ],
    "identity_encoding": "NativeIdentity carries fixed-layout digest elements and profile tags; full source names/field/layout descriptions remain host metadata bound by separately qualified statements."
  },
