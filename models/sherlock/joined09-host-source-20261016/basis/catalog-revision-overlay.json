  "status": "PROPOSED_UNADOPTED. Requires I-B-EVENT-ADOPTION (rules.json:7448-7451: I with fresh Muse nonsecurity and applicable Opus review) before any exact B oracle is authored. This file does not edit rules.json; R owns that file and root integrates.",
  "answers": ["Muse F-07 (revised schedule, no catalog revision supplied)", "Opus1 F6 (inventory revision before oracles; Disabled scope)", "Opus2 L-6 (profile-wide Disabled wording)"],
  "governance": {"native_authority": 0, "c4_unchanged": true, "decision_vote": false, "execution_claims": [], "json_validated_by_tool": false},
  "base_catalog": {"path": "models/sherlock/reference/rules.json", "sha256": "71b4e4e67173cf7da6fbff8cd7dfbb36533250278565469b67bfd0b77468ad2a", "sections": ["k_rules machine entries (proposed_b_helper_dependencies)", "proposed_b.helpers[*].events", "proposed_b.bookkeeping", "proposed_b.legacy_completion", "proposed_b.administrative_boundaries"]},
  "scope": {"profile": "sherlock-helper-microstep/1", "grammarDomain": "DedicatedSorts", "not_scope": "GenericNominal and any nested-helper or financial extension; their schedule is not decided here"},
  "normative_rows": "rows-supplement.json (format sherlock-b-core-rows-supplement/2)",
  "oracle_rule": "Exact-fuel oracles for B-core target this overlay plus rows-supplement.json, never the raw catalog. The raw catalog does not determine a unique schedule by itself: entry applicability is 'Legacy rule requires this helper and no task exists', per-site helper plans and task-push events are unstated, and allocation rows are 'pending S'. So no exact-fuel figure derived from the raw catalog exists to compare against; this overlay is the first complete schedule proposal and is labelled a revision, not conformance.",
  "unchanged_catalog_facts": [
    "Every Enabled helper and bookkeeping event keeps the catalog charge: semanticWork 1, helperWork 1, referenceCursorDelta 0.",
    "Every legacy completion keeps semanticWork 1, helperWork 0, helperVisits 0, referenceCursorDelta 1 (rules.json:7317-7320).",
    "Administrative boundaries keep workDelta 0 and helperWork 0 (rules.json:7335-7366); the catalog states no cursor delta for them and this overlay specifies 0 (D-09R).",
    "Every Enabled event keeps its catalog helperVisits constant (D-19).",
    "No ID is added, renamed or split."
  ],
  "text_constants": {
    "U_INSTALL": "Install typed helper control and complete resume fields; allocate at most one task slot",
    "U_FAIL": "Stage source-defined helper failure result, when applicable; restore resume selector and release at most one live task slot; further releases have separate task-release events",
    "U_EXIT_SUFFIX": "; restore resume selector and release at most one live task slot; further releases have separate task-release events",
    "expansion_rule": "An old.bounded_update equal to a constant name is that constant's exact text. A value of the form 'TEXT U_EXIT_SUFFIX' is TEXT immediately followed by U_EXIT_SUFFIX with no space (for example 'Stage Bool' + '; restore ...'). Every other value is the exact catalog text."
  },
  "change_codes": {
    "C00": "UNCHANGED: charge, helperWork, cursor delta and helperVisits equal the catalog; the row fixes guards, reads, writes and deltas the catalog left unstated",
    "C01": "ENTRY_TASKS_FIXED: the catalog's 'allocate at most one task slot' is realized as exactly 0 slots, or exactly 1 for Validate.entry and Equal.entry",
    "C02": "NO_RESUME_STORE: catalog resume_fields are not stored; site, originReferenceCursor and the unchanged legacy control and frames are the complete resume selector (D-04); sourceOccurrenceId is reported through StepEvent.sourceExprId",
    "C03": "EXIT_FAILURE_SPLIT: .exit stages only success variants and .failure only failure variants (D-06, F-05)",
    "C04": "ALLOCATION_ASSIGNED: the row fixes the logical allocation the catalog left 'pending S' (D-10)",
    "C05": "TASK_PUSH_FUSED: the child or pair task push happens in this reading event; b.bookkeeping.task.enqueue is Disabled (F-07)",
    "C06": "TASK_POP_FUSED: the consumed task is popped in this event",
    "C07": "INLINE_NESTED_OPERATION: a helper the catalog names as nested (Scalar or EnvPut) is performed inline as an operation of this event (D-20, F-03, F-12)",
    "C08": "DISABLED_NO_SOURCE_CONDITION under DedicatedSorts (T-DISABLED scope)",
    "C09": "DISABLED_FUSED_ELSEWHERE under DedicatedSorts",
    "C10": "EXTENSION_ONLY",
    "C11": "VALUE_SLOT_ARENA: value-sequence reads and writes use img.valueSlots, outside logical counters (D-08R)",
    "C12": "LEGACY_DEPENDENCY_ADDED: a helper interval precedes this legacy rule although the catalog lists none (F-02)",
    "C13": "LEGACY_DEPENDENCY_NARROWED: of the catalog's listed helpers, exactly one runs, chosen by site and top.op (D-07, F-03)",
    "C14": "KIND_PROJECTION: every tag test is over kind() (D-23)",
    "C15": "RESULT_MATERIALIZED_AT_EXIT: the produced value node is allocated at exit (F-11)",
    "C16": "STAGED_NOT_SCHEDULED: the child is staged in the helper register; no pattern task is scheduled",
    "C17": "EXIT_RELEASES_NONE: exit and failure require taskLive = 0; every task pop happened in an earlier charged event, so the catalog's 'release at most one live task slot' at exit is 0",
    "C18": "CURSOR_RULE: referenceCursor advances only on legacy completions (D-09R; README.md:47-48)"
  },
  "global_changes": [
    {"code": "C02", "applies_to": "all Enabled helper and bookkeeping events"},
