module doctorwatson_cleanup_test {
  import doctorwatson_cleanup.* from "./doctorwatson_cleanup"
  action graphAndWiki:bool=refresh(VerifiedRefresh).then(appendWiki)
  action deleteCandidate(id:int):bool=removeWorktree(id).then(deleteRef(id,DeleteOK))
  run orderedSuccessfulCycleTest=initWith(true).then(graphAndWiki)
    .then(deleteCandidate(1)).then(deleteCandidate(2)).then(finishCycle(true))
    .expect(state.finished and state.retirements.size()==2 and cleanupInvariant)
  run plannedOrFailedGraphCannotAppendTest=initWith(true).then(refresh(PlannedRefresh))
    .expect(not(currentGraph(state))).then(appendWiki.fail())
  run failedGraphLeavesCycleOpenTest=initWith(true).then(refresh(FailedRefresh))
    .then(unrelatedWork).expect(not(state.finished) and state.unrelatedProgress==1)
    .then(finishCycle(true).fail())
  run currentSourceAndActualArtifactRequiredTest=initWith(true).then(graphAndWiki)
    .then(changeSource).expect(not(currentGraph(state)) and state.entries.length()==2)
    .then(removeWorktree(1).fail())
  run graphArtifactDriftBlocksRetirementTest=initWith(true).then(graphAndWiki)
    .then(changeArtifact).expect(not(currentWiki(state))).then(removeWorktree(1).fail())
  run wikiAppendIsIdempotentAndPrefixPreservingTest=initWith(true).then(graphAndWiki)
    .then(appendWiki).then(appendWiki)
    .expect(state.entries==List(prefix,wantedEntry(state)) and cleanupInvariant)
  run conflictingCyclePayloadPreservesHistoryTest=initWith(true).then(graphAndWiki)
    .then(changePayload).then(appendWiki)
    .expect(state.wikiConflict and state.entries.nth(1).payload==0 and state.entries.length()==2)
    .then(removeWorktree(1).fail())
  run inspectCannotDeleteOrFinishTest=initWith(false).then(refresh(VerifiedRefresh))
    .expect(not(state.finished) and state.entries==List(prefix)).then(removeWorktree(1).fail())
  run eachProtectionReasonPreventsDeletionTest=initWith(true).expect(
    Set(ActiveTask,OpenPR,UniqueWork,UserData,InactivityUnknown,OwnerUnknown).forall(why=>{
      val c={...clean,active:why==ActiveTask,openPR:why==OpenPR,userData:why==UserData,
        inactiveKnown:why!=InactivityUnknown,ownerKnown:why!=OwnerUnknown,merged:why!=UniqueWork}
      reasonFor(c)==why }))
  run allRetainedCanFinishWithoutDeletionQuotaTest=initWith(true).then(graphAndWiki)
    .then(protect(1,ActiveTask)).then(protect(2,UniqueWork)).then(retain(1,true)).then(retain(2,true))
    .then(finishCycle(true)).expect(state.finished and state.retirements.size()==0 and cleanupInvariant)
  run incompleteRetentionRecordCannotFinishTest=initWith(true).then(graphAndWiki)
    .then(protect(1,OpenPR)).then(protect(2,UserData)).then(retain(1,false)).then(retain(2,true))
    .expect(not(canFinish(state))).then(finishCycle(true).fail())
  run exactTipRaceLeavesPartialCleanupTest=initWith(true).then(graphAndWiki)
    .then(removeWorktree(1)).then(moveTip(1)).then(deleteRef(1,DeleteOK))
    .expect(state.candidates.get(1).disposition==CleanupFailed and not(state.finished))
    .then(finishCycle(true).fail())
  run retainedRootRaceCannotDeleteTest=initWith(true).then(graphAndWiki)
    .then(removeWorktree(1)).then(moveRoot).then(deleteRef(1,DeleteOK))
    .expect(state.candidates.get(1).disposition==CleanupFailed and state.retirements.size()==0)
  run unknownSecondCleanupRetainsFirstActualResultTest=initWith(true).then(graphAndWiki)
    .then(deleteCandidate(1)).then(removeWorktree(2)).then(deleteRef(2,DeleteUnknown))
    .expect(state.candidates.get(1).disposition==Deleted and state.candidates.get(2).disposition==CleanupUnknown
      and state.retirements.size()==1 and not(canFinish(state)))
  run interruptionPreservesHistoryAndUnknownTest=initWith(true).then(graphAndWiki)
    .then(deleteCandidate(1)).then(removeWorktree(2)).then(interrupt)
    .expect(state.entries.length()==2 and state.graphHistory.size()==1 and state.retirements.size()==1
      and state.candidates.get(2).disposition==CleanupUnknown and not(state.finished))
    .then(unrelatedWork).expect(state.unrelatedProgress==1 and cleanupInvariant)
  run inventoryAndFinalReportFailureCannotCompleteTest=initWith(true).then(graphAndWiki)
    .then(deleteCandidate(1)).then(deleteCandidate(2)).then(finishCycle(false))
    .expect(state.reportFailed and not(state.finished) and not(state.reportSaved))
    .then(finishCycle(true).fail())
  run unknownInactivityAndOwnerBlockCompletionTest=initWith(true).then(graphAndWiki)
    .then(protect(1,InactivityUnknown)).then(protect(2,OwnerUnknown)).then(retain(1,true)).then(retain(2,true))
    .expect(state.candidates.get(1).disposition==CleanupFailed and state.candidates.get(2).disposition==CleanupFailed
      and not(canFinish(state))).then(finishCycle(true).fail())
  run unknownInventoryPreventsCleanupTest=initWith(true).then(graphAndWiki).then(unknownInventory)
    .expect(not(preCleanup(state))).then(removeWorktree(1).fail())
  run staleInventoryPreventsCleanupTest=initWith(true).then(graphAndWiki).then(staleInventory)
    .expect(not(preCleanup(state))).then(removeWorktree(1).fail())
}
