module doctorwatson_readiness_test {
  import doctorwatson_readiness.* from "./doctorwatson_readiness"
  run dependenciesDoNotCreateExecutorTest=initWith(true).then(assess)
    .expect(dependencyReady(state,3) and not(readyForDispatch(state,3)))
    .then(selectTask(3)).then(recheck).expect(not(canDispatch(state))).then(dispatch.fail())
  run missingCollectorDoesNotDispatchTest=initWith(true).then(assess)
    .expect(not(capability(adapter(4)).collectorAvailable) and dependencyReady(state,4))
    .then(selectTask(4)).then(recheck).then(dispatch.fail())
  run historyRequiredAtUseTest=initWith(false).then(assess).then(selectTask(2)).then(recheck)
    .expect(readyForDispatch(state,2) and not(canDispatch(state)))
    .then(provideHistory).expect(not(canDispatch(state))).then(recheck).then(dispatch).expect(verifierLaunchWitness and readinessInvariant)
  run enabledLocalVerifierDispatchTest=initWith(true).then(assess).then(selectTask(2)).then(recheck)
    .expect(canDispatch(state)).then(dispatch).expect(verifierLaunchWitness and readinessInvariant)
    .then(outcome(2,Succeeded,false)).expect(not(state.proofAccepted) and not(state.targetAccepted))
  run buildCompatibilityTest=initWith(true).then(assess).then(selectTask(1)).then(recheck)
    .then(dispatch).expect(buildLaunchWitness and readinessInvariant)
  run assessmentDoesNotSkipUseTimeRecheckTest=initWith(true).then(assess).then(selectTask(2))
    .expect(not(canDispatch(state))).then(recheck).expect(canDispatch(state))
  run sharedEditInvalidatesSelectedFingerprintTest=initWith(true).then(assess).then(selectTask(2))
    .then(editSharedInput).then(recheck).expect(staleSharedWitness and not(canDispatch(state)))
    .then(selectTask(2)).then(recheck).then(dispatch).expect(verifierLaunchWitness and readinessInvariant)
  run editAfterRecheckStillBlocksTest=initWith(true).then(assess).then(selectTask(2)).then(recheck)
    .then(editSharedInput).expect(not(canDispatch(state))).then(dispatch.fail())
  run sharedDependentsAndIndependentFingerprintsTest=initWith(true).then(assess).then(editSharedInput).then(assess)
    .expect(state.fingerprints.get(1)==11 and state.fingerprints.get(2)==12
      and state.fingerprints.get(3)==3 and state.fingerprints.get(4)==4 and readinessInvariant)
  run historicalUnknownSurvivesChangedInputTest=initWith(true).then(assess).then(markUnknown(2))
    .then(editSharedInput).then(assess).expect(state.unknown.get(2) and not(dependencyReady(state,2)))
    .then(selectTask(2).fail())
  run cleanupDebtSurvivesChangedInputTest=initWith(true).then(assess).then(markDebt(2))
    .then(editSharedInput).then(assess).expect(state.debt.get(2) and not(dependencyReady(state,2)))
    .then(selectTask(2).fail())
  run acceptedSourceDoesNotStandForProofOrTargetTest=initWith(true).then(acceptSource)
    .expect(sourceOnlyWitness and readinessInvariant).then(observeProof)
    .expect(state.proofAccepted and state.explicitProofObservation and not(state.targetAccepted))
  run consumedAttemptCannotLaunchTwiceTest=initWith(true).then(assess).then(selectTask(2)).then(recheck)
    .then(dispatch).then(outcome(2,Unknown,true)).then(editSharedInput).then(assess)
    .expect(state.launches.size()==1 and state.unknown.get(2) and state.debt.get(2) and readinessInvariant)
    .then(dispatch.fail())
  run missingDependencyBlocksBothViewsTest=initWith(true).then(assess).then(missingDependency(2))
    .expect(not(dependencyReady(state,2)) and not(readyForDispatch(state,2)))
}
