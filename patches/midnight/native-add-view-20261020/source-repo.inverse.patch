-/// Whether a recording session is active on this thread. Hooks call
-/// this (or read the active session id) before doing any recording
-/// work, so the inactive path is a single thread-local check.
-pub fn is_recording_active() -> bool {
-    active_session_id().is_some()
-}
-
-/// Take the most recent keygen session recorded on this thread.
-/// The session is retained in thread-local storage — including
-/// complete recorded tables — until this call, a later keygen
-/// session on the same thread, or thread exit. Any code on this
-/// thread can take it; thread reuse is not a privacy boundary, so
-/// callers must take sessions promptly.
-pub fn take_last_keygen_recording() -> Option<RecordedSession> {
-    LAST_KEYGEN
-        .try_with(|slot| slot.try_borrow_mut().ok()?.take())
-        .ok()
-        .flatten()
-}
-
-/// Take the most recent proving session recorded on this thread.
-/// Proving sessions contain witness advice encodings; the retention
-/// and same-thread access warnings on
-/// [`take_last_keygen_recording`] apply unchanged.
-pub fn take_last_proving_recording() -> Option<RecordedSession> {
-    LAST_PROVING
-        .try_with(|slot| slot.try_borrow_mut().ok()?.take())
-        .ok()
-        .flatten()
-}
-
-/// Id of the innermost active session on this thread, read under a
-/// brief borrow that is released before any external work runs.
-fn active_session_id() -> Option<u64> {
-    ACTIVE_STACK
-        .try_with(|stack_cell| {
-            stack_cell
-                .try_borrow()
-                .ok()?
-                .last()
-                .map(|frame| frame.id)
-        })
-        .ok()
-        .flatten()
-}
-
-/// Store into the frame owned by `session_id`, wherever it now sits
-/// in the stack. If that frame is gone (its guard was dropped while
-/// external work ran), the store is silently discarded. The borrow
-/// is held only for the store itself.
-fn store_to_session(session_id: u64, store: impl FnOnce(&mut RecordedSession)) {
-    let _ = ACTIVE_STACK.try_with(|stack_cell| {
-        if let Ok(mut stack) = stack_cell.try_borrow_mut() {
-            if let Some(frame) = stack.iter_mut().find(|frame| frame.id == session_id) {
-                store(&mut frame.session);
-            }
-        }
-    });
-}
-
-/// Encode one field element as its `PrimeField::to_repr` byte string.
-/// For `midnight_curves::Fq` this is the 32-byte little-endian
-/// canonical representation produced by `to_bytes_le`. This is a
-/// structural encoding only, not a proved homomorphism.
-pub fn encode_prime_field<F: PrimeField>(value: &F) -> Vec<u8> {
-    value.to_repr().as_ref().to_vec()
-}
-
-/// Record the domain parameters of the current session, if a session
-/// is active. Inactive: one thread-local check, no other work.
-pub fn record_dimensions(k: u32, num_rows: usize) {
-    if let Some(session_id) = active_session_id() {
-        store_to_session(session_id, |session| {
-            session.k = Some(k);
-            session.num_rows = Some(num_rows);
-        });
-    }
-}
