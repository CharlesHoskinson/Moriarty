-/// How one bounded region name resolves inside a single session:
-/// absent, exactly one distinct base, or several distinct bases.
-/// Absent and ambiguous are distinct outcomes and both refuse at
-/// join time.
-#[derive(Clone, Copy, Debug, PartialEq, Eq)]
-enum RegionStartResolution {
-    /// No region with this name was recorded in the session.
-    Absent,
-    /// Every region with this name had this one starting row.
-    Unique(usize),
-    /// Regions with this name had at least two distinct starting rows.
-    Ambiguous,
-}
-
-fn region_start_resolution(session: &RecordedSession, name: &str) -> RegionStartResolution {
-    let mut found: Option<usize> = None;
-    for region in &session.regions {
-        if region.name == name {
-            match found {
-                None => found = Some(region.region_start),
-                Some(start) if start == region.region_start => {}
-                Some(_) => return RegionStartResolution::Ambiguous,
-            }
-        }
-    }
-    match found {
-        Some(start) => RegionStartResolution::Unique(start),
-        None => RegionStartResolution::Absent,
-    }
-}
-
-fn resolve_region_start(
-    keygen: &RecordedSession,
-    proving: &RecordedSession,
-    name: &'static str,
-) -> Result<usize, JoinError> {
-    match (
-        region_start_resolution(keygen, name),
-        region_start_resolution(proving, name),
-    ) {
-        (RegionStartResolution::Unique(a), RegionStartResolution::Unique(b)) if a == b => Ok(a),
-        _ => Err(JoinError::RegionMismatch { name }),
-    }
-}
-
-fn fixed_at(
-    session: &RecordedSession,
-    column_index: usize,
-    row: usize,
-) -> Result<Vec<u8>, JoinError> {
-    session
-        .fixed_values
-        .get(column_index)
-        .and_then(|column| column.get(row))
-        .cloned()
-        .ok_or(JoinError::MissingCell { what: "fixed cell" })
-}
-
-fn converted_selector_at(
-    session: &RecordedSession,
-    selector_index: usize,
-    row: usize,
-) -> Result<Vec<u8>, JoinError> {
-    session
-        .converted_selector_fixed
-        .get(selector_index)
-        .and_then(|column| column.get(row))
-        .cloned()
-        .ok_or(JoinError::MissingCell {
-            what: "converted selector fixed cell",
-        })
-}
-
-fn advice_permutation_position(
-    session: &RecordedSession,
-    advice_index: usize,
-) -> Result<usize, JoinError> {
-    let mut found: Option<usize> = None;
-    for desc in &session.permutation_columns {
-        if desc.column_index == advice_index && desc.column_kind_debug.contains("Advice") {
-            match found {
-                None => found = Some(desc.position),
-                Some(_) => {
-                    return Err(JoinError::AmbiguousPermutationColumn { advice_index });
-                }
-            }
-        }
-    }
-    found.ok_or(JoinError::AmbiguousPermutationColumn { advice_index })
-}
-
-fn copy_partner(session: &RecordedSession, target: PermCell) -> Result<PermCell, JoinError> {
-    let mut found: Option<PermCell> = None;
-    for pair in &session.copy_pairs {
-        let partner = if pair.left == target {
-            Some(pair.right)
-        } else if pair.right == target {
-            Some(pair.left)
-        } else {
-            None
-        };
-        if let Some(partner) = partner {
-            match found {
-                None => found = Some(partner),
-                Some(existing) if existing == partner => {}
-                Some(_) => {
