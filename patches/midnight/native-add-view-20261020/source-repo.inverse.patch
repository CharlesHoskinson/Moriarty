-/// Record one `NativeChip::configure` binding, constructing it lazily
-/// via `make` only if a session is active. Called from inside
-/// `NativeChip::configure`, the only place where the private
-/// `NativeConfig` fields exist as locals. Inactive: `make` is never
-/// invoked, so no index vectors are built.
-///
-/// `make` runs with no recorder borrow held: it may call other
-/// hooks or begin and end a nested session without panicking. The
-/// constructed binding is stored into the session that was active
-/// when this hook was entered, even if a nested session is active
-/// by the time `make` returns; if that session has ended, the
-/// binding is discarded.
-pub fn record_native_config_binding_with(make: impl FnOnce() -> NativeConfigBinding) {
-    let Some(session_id) = active_session_id() else {
-        return;
-    };
-    let binding = make();
-    store_to_session(session_id, |session| {
-        if !session.config_bindings.contains(&binding) {
-            session.config_bindings.push(binding);
-        }
-    });
-}
-
-/// Record the base of one region, if a session is active. Only the
-/// two region names used by the bounded linear-combination path are
-/// kept; every other region is ignored. The floor-planner caller
-/// checks [`is_recording_active`] before invoking the region-name
-/// closure, so the inactive path never calls that closure for
-/// recording. While armed, that closure is invoked once extra for
-/// every region; see the module documentation.
-pub fn record_region_base(name: &str, region_index: usize, region_start: usize) {
-    if name != "Assign fixed" && name != "Linear combination" {
-        return;
-    }
-    if let Some(session_id) = active_session_id() {
-        let region = RegionBase {
-            name: name.to_string(),
-            region_index,
-            region_start,
-        };
-        store_to_session(session_id, |session| {
-            session.regions.push(region);
-        });
-    }
-}
