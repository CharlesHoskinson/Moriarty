-/// Record the keygen fixed columns and original selector booleans.
-/// Must be called after synthesis and before the fixed columns are
-/// batch-inverted and the selectors are taken for conversion, so the
-/// recorded data is the data the keygen `Assembly` actually held.
-/// All encoding and cloning happens only if a session is active,
-/// and runs with no recorder borrow held.
-pub fn record_keygen_fixed_and_selectors<F: PrimeField>(
-    fixed: &[Polynomial<Rational<F>, LagrangeCoeff>],
-    selectors: &[Vec<bool>],
-) {
-    let Some(session_id) = active_session_id() else {
-        return;
-    };
-    let encoded_fixed: Vec<Vec<Vec<u8>>> = fixed
-        .iter()
-        .map(|poly| {
-            poly.iter()
-                .map(|value| encode_prime_field(&value.evaluate()))
-                .collect::<Vec<Vec<u8>>>()
-        })
-        .collect::<Vec<Vec<Vec<u8>>>>();
-    let cloned_selectors: Vec<Vec<bool>> = selectors.iter().cloned().collect::<Vec<Vec<bool>>>();
-    store_to_session(session_id, |session| {
-        session.fixed_values = encoded_fixed;
-        session.selectors = cloned_selectors;
-    });
-}
-
-/// Record the selector fixed columns produced by
-/// `directly_convert_selectors_to_fixed`, before they are appended
-/// to the fixed table. Encoding happens only if a session is active,
-/// and runs with no recorder borrow held.
-pub fn record_converted_selector_fixed<F: PrimeField>(selector_polys: &[Vec<F>]) {
-    let Some(session_id) = active_session_id() else {
-        return;
-    };
-    let encoded: Vec<Vec<Vec<u8>>> = selector_polys
-        .iter()
-        .map(|poly| {
-            poly.iter()
-                .map(|value| encode_prime_field(value))
-                .collect::<Vec<Vec<u8>>>()
-        })
-        .collect::<Vec<Vec<Vec<u8>>>>();
-    store_to_session(session_id, |session| {
-        session.converted_selector_fixed = encoded;
-    });
-}
-
-/// Record the proving advice columns for the current phase. Columns
-/// are merged across phases by column index; each call replaces the
-/// recorded column, which is correct because `WitnessCollection`
-/// only writes advice columns of its current phase. Encoding happens
-/// only if a session is active, and runs with no recorder borrow
-/// held.
-pub fn record_advice_columns<F: PrimeField>(
-    advice: &[Polynomial<Rational<F>, LagrangeCoeff>],
-    column_indices: &std::collections::BTreeSet<usize>,
-) {
-    let Some(session_id) = active_session_id() else {
-        return;
-    };
-    let mut encoded_columns: Vec<(usize, Vec<Vec<u8>>)> = Vec::new();
-    for column_index in column_indices {
-        if let Some(poly) = advice.get(*column_index) {
-            let encoded = poly
-                .iter()
-                .map(|value| encode_prime_field(&value.evaluate()))
-                .collect::<Vec<Vec<u8>>>();
-            encoded_columns.push((*column_index, encoded));
-        }
-    }
-    store_to_session(session_id, |session| {
-        for (column_index, encoded) in encoded_columns {
-            if session.advice_values.len() <= column_index {
-                session.advice_values.resize(column_index + 1, Vec::new());
-            }
-            session.advice_values[column_index] = encoded;
-        }
-    });
-}
-
-/// Record one ordered permutation copy call, in permutation-argument
-/// coordinates. Called from inside
-/// `permutation::keygen::Assembly::copy`, after the column positions
-/// and row bounds have been resolved and before any cycle merging,
-/// so the log holds the original calls rather than the successor
-/// mapping of the built argument. Column descriptors — including
-/// their `Debug` formatting — are built only if a session is active,
-/// only on the first recorded call, and with no recorder borrow
-/// held.
-pub fn record_copy_pair(
-    columns: &[Column<Any>],
-    left: (usize, usize),
-    right: (usize, usize),
-) {
-    let Some(session_id) = active_session_id() else {
-        return;
-    };
-    let descriptors: Vec<PermutationColumnDesc> = columns
-        .iter()
-        .enumerate()
-        .map(|(position, column)| PermutationColumnDesc {
-            position,
-            column_index: column.index(),
-            column_kind_debug: format!("{:?}", column.column_type()),
-        })
-        .collect::<Vec<PermutationColumnDesc>>();
-    let pair = CopyPair {
-        left: PermCell {
-            permutation_column_position: left.0,
-            row: left.1,
-        },
-        right: PermCell {
-            permutation_column_position: right.0,
-            row: right.1,
-        },
-    };
-    store_to_session(session_id, |session| {
-        if session.permutation_columns.is_empty() {
-            session.permutation_columns = descriptors;
-        }
-        session.copy_pairs.push(pair);
-    });
-}
