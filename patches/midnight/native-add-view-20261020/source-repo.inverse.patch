-            }
-            JoinError::SecondSessionNotProving => {
-                write!(f, "second recorded session is not declared as a proving session")
-            }
-            JoinError::DeclaredCircuitCountNotOne { phase, count } => write!(
-                f,
-                "{phase:?} session declared {count} circuits, expected exactly one declared"
