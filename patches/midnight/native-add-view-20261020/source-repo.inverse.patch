-/// Every variant is a structural mismatch in the recorded data;
-/// none of them is a statement about constraint satisfaction or
-/// verification.
-#[derive(Clone, Debug, PartialEq, Eq)]
-pub enum JoinError {
-    /// The first session was not declared as a keygen recording.
-    FirstSessionNotKeygen,
-    /// The second session was not declared as a proving recording.
-    SecondSessionNotProving,
-    /// A session declared a circuit count other than one. The count
-    /// is caller-declared; this checks the declaration only.
-    DeclaredCircuitCountNotOne {
-        /// Declared phase whose count was wrong.
-        phase: CapturePhase,
-        /// Observed declared count.
-        count: usize,
-    },
-    /// The domain parameters of the two phases are missing or differ.
-    DomainMismatch,
-    /// The two phases did not observe exactly one identical configure
-    /// binding.
-    BindingMismatch,
-    /// The binding does not have exactly five value columns and
-    /// exactly five coefficient columns.
-    InvalidArithColumnCount {
-        /// Observed number of value columns.
-        value_columns: usize,
-        /// Observed number of coefficient columns.
-        coefficient_columns: usize,
-    },
-    /// A recorded table column does not have exactly `num_rows`
-    /// entries, or a table has the wrong number of columns.
-    TableDimensionMismatch {
-        /// Which recorded table failed.
-        table: &'static str,
-        /// Column index within the table, or the column count when
-        /// the whole table width is wrong.
-        column: usize,
-        /// Required row count (or column count).
-        expected: usize,
-        /// Observed row count (or column count).
-        actual: usize,
-    },
-    /// Checked arithmetic overflowed while deriving a column index.
-    ArithmeticOverflow {
-        /// Which derivation overflowed.
-        what: &'static str,
-    },
-    /// `add_row + 1` is not a row inside `num_rows`.
-    NextRowOutOfBounds {
-        /// The linear-combination row.
-        add_row: usize,
-        /// Number of rows in the recorded domain.
-        num_rows: usize,
-    },
-    /// The recorded `q_arith` selector is not enabled at `add_row`.
-    QArithNotEnabled,
-    /// A bounded region name was absent in a phase, had several
-    /// distinct bases in a phase, or resolved to different bases
-    /// across the two phases.
-    RegionMismatch {
-        /// Region name that failed to resolve uniquely in both phases.
-        name: &'static str,
-    },
-    /// A recorded table does not contain a required cell.
-    MissingCell {
-        /// Human-readable description of the missing cell.
-        what: &'static str,
-    },
-    /// The recorded zero-cell encoding is not all zero bytes.
-    ZeroCellNotZero,
-    /// An advice column does not resolve to exactly one position in
-    /// the permutation argument.
-    AmbiguousPermutationColumn {
-        /// Advice column index that failed to resolve uniquely.
-        advice_index: usize,
-    },
-    /// A gate value cell does not have exactly one copy partner in
-    /// the ordered copy-call log.
-    AmbiguousCopyPartner {
-        /// Permutation position of the gate value cell.
-        position: usize,
-        /// Absolute row of the gate value cell.
-        row: usize,
-    },
-}
