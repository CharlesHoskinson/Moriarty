-/// Begin recording one declared synthesis phase on this thread.
-/// This is the only activation boundary: production entry points
-/// never call this.
-///
-/// `declared_phase` and `declared_circuit_count` are caller
-/// declarations, not measurements; see the module documentation.
-/// The caller holds the returned guard across the production call
-/// it intends to cover (for example `keygen_vk_with_k` or
-/// `keygen_pk`, or `create_proof`). While the guard is alive, the
-/// bounded hooks in `keygen`, `prover`, `permutation::keygen`,
-/// `single_pass`, and `NativeChip::configure` record into the
-/// session. Guards may nest; see [`NativeAddRecordingGuard`] for
-/// the drop discipline.
-pub fn begin_recording(
-    declared_phase: CapturePhase,
-    declared_circuit_count: usize,
-) -> NativeAddRecordingGuard {
-    let session_id = NEXT_SESSION_ID
-        .try_with(|next| {
-            let id = next.get();
-            next.set(id.wrapping_add(1).max(1));
-            id
-        })
-        .unwrap_or(0);
-    let session = RecordedSession {
-        declared_phase,
-        declared_circuit_count,
-        k: None,
-        num_rows: None,
-        config_bindings: Vec::new(),
-        regions: Vec::new(),
-        fixed_values: Vec::new(),
-        selectors: Vec::new(),
-        converted_selector_fixed: Vec::new(),
-        permutation_columns: Vec::new(),
-        copy_pairs: Vec::new(),
-        advice_values: Vec::new(),
-    };
-    let _ = ACTIVE_STACK.try_with(|stack_cell| {
-        if let Ok(mut stack) = stack_cell.try_borrow_mut() {
-            stack.push(ActiveFrame {
-                id: session_id,
-                session,
-            });
-        }
-    });
-    NativeAddRecordingGuard {
-        declared_phase,
-        session_id,
-        _not_send: PhantomData,
-    }
-}
