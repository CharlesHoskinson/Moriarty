-/// Join one keygen session and one proving session into the bounded
-/// structural view for one generic linear-combination shape, by
-/// shape agreement only.
-///
-/// The join refuses, with a structural error, unless: both sessions
-/// declare exactly one circuit (a caller declaration, not a
-/// measurement); the domain parameters agree; both phases observed
-/// exactly one identical configure binding with exactly five value
-/// and five coefficient columns; each bounded region name resolves
-/// to exactly one distinct base in each session and those bases are
-/// equal; every table exposed in the view has internally consistent
-/// `num_rows` dimensions; `add_row + 1` is inside `num_rows`; the
-/// converted `q_arith` column index is derived with checked
-/// arithmetic; `q_arith` is enabled at `add_row`; the proving advice
-/// table covers the named value cells at `add_row` and `add_row + 1`;
-/// the recorded zero cell encodes zero; and the two gate value cells
-/// at the add row each have exactly one copy partner.
-///
-/// This does not validate the add-shaped coefficient pattern and
-/// does not establish an actual `NativeAdd`. It is not a
-/// same-circuit or same-key check: sessions are public
-/// caller-constructible data, and no verifying key, proving key, key
-/// material, or concrete circuit identity is compared. Nothing here
-/// evaluates a gate, checks a copy constraint, or interprets the
-/// encodings in another carrier. Actual SDK add correspondence,
-/// gate satisfaction, copy satisfaction, and verifier acceptance
-/// remain open.
-pub fn join_linear_combination_view(
-    keygen: RecordedSession,
-    proving: RecordedSession,
-) -> Result<JoinedLinearCombinationView, JoinError> {
-    if keygen.declared_phase != CapturePhase::Keygen {
-        return Err(JoinError::FirstSessionNotKeygen);
-    }
-    if proving.declared_phase != CapturePhase::Proving {
-        return Err(JoinError::SecondSessionNotProving);
-    }
-    if keygen.declared_circuit_count != 1 {
-        return Err(JoinError::DeclaredCircuitCountNotOne {
-            phase: CapturePhase::Keygen,
-            count: keygen.declared_circuit_count,
-        });
-    }
-    if proving.declared_circuit_count != 1 {
-        return Err(JoinError::DeclaredCircuitCountNotOne {
-            phase: CapturePhase::Proving,
-            count: proving.declared_circuit_count,
-        });
-    }
-    let (k, num_rows) = match (keygen.k, keygen.num_rows, proving.k, proving.num_rows) {
-        (Some(k1), Some(n1), Some(k2), Some(n2)) if k1 == k2 && n1 == n2 => (k1, n1),
-        _ => return Err(JoinError::DomainMismatch),
-    };
-    if keygen.config_bindings.len() != 1
-        || proving.config_bindings.len() != 1
-        || keygen.config_bindings[0] != proving.config_bindings[0]
-    {
-        return Err(JoinError::BindingMismatch);
-    }
-    let binding = keygen.config_bindings[0].clone();
-    if binding.value_cols.len() != NB_ARITH_COLS || binding.coeff_cols.len() != NB_ARITH_COLS {
-        return Err(JoinError::InvalidArithColumnCount {
-            value_columns: binding.value_cols.len(),
-            coefficient_columns: binding.coeff_cols.len(),
-        });
-    }
-    // Internal dimensions of every table exposed in the view.
-    check_byte_table_rows(&keygen.fixed_values, num_rows, "fixed")?;
-    check_bool_table_rows(&keygen.selectors, num_rows, "selector")?;
-    check_byte_table_rows(
-        &keygen.converted_selector_fixed,
-        num_rows,
-        "converted selector fixed",
-    )?;
-    check_byte_table_rows(&proving.advice_values, num_rows, "advice")?;
-    if keygen.converted_selector_fixed.len() != keygen.selectors.len() {
-        return Err(JoinError::TableDimensionMismatch {
-            table: "converted selector fixed",
-            column: keygen.converted_selector_fixed.len(),
-            expected: keygen.selectors.len(),
-            actual: keygen.converted_selector_fixed.len(),
-        });
-    }
-    for (expected_position, desc) in keygen.permutation_columns.iter().enumerate() {
-        if desc.position != expected_position {
-            return Err(JoinError::TableDimensionMismatch {
-                table: "permutation columns",
-                column: expected_position,
-                expected: expected_position,
-                actual: desc.position,
-            });
-        }
-    }
-    for pair in &keygen.copy_pairs {
-        for cell in [pair.left, pair.right] {
-            if cell.permutation_column_position >= keygen.permutation_columns.len()
-                || cell.row >= num_rows
-            {
-                return Err(JoinError::MissingCell {
-                    what: "copy-pair cell outside recorded permutation table",
-                });
-            }
-        }
-    }
-    let assign_fixed_region_start =
-        resolve_region_start(&keygen, &proving, "Assign fixed")?;
-    let linear_combination_region_start =
-        resolve_region_start(&keygen, &proving, "Linear combination")?;
-    let add_row = linear_combination_region_start;
-    let next_row = add_row
-        .checked_add(1)
-        .filter(|next| *next < num_rows)
-        .ok_or(JoinError::NextRowOutOfBounds { add_row, num_rows })?;
-    let zero_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: binding.fixed_values_col,
-        row: assign_fixed_region_start,
-    };
-    let zero_cell_encoding = fixed_at(&keygen, zero_cell.column_index, zero_cell.row)?;
-    if zero_cell_encoding.iter().any(|byte| *byte != 0) {
-        return Err(JoinError::ZeroCellNotZero);
-    }
-    let value_cells: Vec<AbsoluteCell> = binding
-        .value_cols
-        .iter()
-        .map(|column_index| AbsoluteCell {
-            kind: CellKind::Advice,
-            column_index: *column_index,
-            row: add_row,
-        })
-        .collect::<Vec<AbsoluteCell>>();
-    let coeff_cells: Vec<AbsoluteCell> = binding
-        .coeff_cols
-        .iter()
-        .map(|column_index| AbsoluteCell {
-            kind: CellKind::Fixed,
-            column_index: *column_index,
-            row: add_row,
-        })
-        .collect::<Vec<AbsoluteCell>>();
-    let const_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: binding.constant_col,
-        row: add_row,
-    };
-    let q_next_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: binding.q_next_col,
-        row: add_row,
-    };
-    let mul_ab_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: binding.mul_ab_col,
-        row: add_row,
-    };
-    let mul_ac_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: binding.mul_ac_col,
-        row: add_row,
-    };
-    let num_original_fixed_columns = keygen.fixed_values.len();
-    let q_arith_column_index = num_original_fixed_columns
-        .checked_add(binding.q_arith_selector)
-        .ok_or(JoinError::ArithmeticOverflow {
-            what: "converted q_arith fixed column index",
-        })?;
-    let q_arith_cell = AbsoluteCell {
-        kind: CellKind::Fixed,
-        column_index: q_arith_column_index,
-        row: add_row,
-    };
-    let q_arith_enabled = keygen
-        .selectors
-        .get(binding.q_arith_selector)
-        .and_then(|column| column.get(add_row))
-        .copied()
-        .ok_or(JoinError::MissingCell {
-            what: "q_arith selector cell",
-        })?;
-    if !q_arith_enabled {
-        return Err(JoinError::QArithNotEnabled);
-    }
-    // The proving advice table must cover the named value cells at
-    // the add row and the next row.
-    for cell in &value_cells {
-        let column = proving
-            .advice_values
-            .get(cell.column_index)
-            .ok_or(JoinError::MissingCell {
-                what: "proving advice column for a value cell",
-            })?;
-        if column.get(add_row).is_none() || column.get(next_row).is_none() {
-            return Err(JoinError::MissingCell {
-                what: "proving advice cell at add or next row",
-            });
-        }
-    }
-    let mut gate_fixed_encodings: Vec<Vec<u8>> = Vec::new();
-    for cell in &coeff_cells {
-        gate_fixed_encodings.push(fixed_at(&keygen, cell.column_index, cell.row)?);
-    }
-    gate_fixed_encodings.push(fixed_at(&keygen, const_cell.column_index, const_cell.row)?);
-    gate_fixed_encodings.push(fixed_at(&keygen, q_next_cell.column_index, q_next_cell.row)?);
-    gate_fixed_encodings.push(fixed_at(&keygen, mul_ab_cell.column_index, mul_ab_cell.row)?);
-    gate_fixed_encodings.push(fixed_at(&keygen, mul_ac_cell.column_index, mul_ac_cell.row)?);
-    gate_fixed_encodings.push(converted_selector_at(&keygen, binding.q_arith_selector, add_row)?);
-    let left_position = advice_permutation_position(&keygen, binding.value_cols[1])?;
-    let right_position = advice_permutation_position(&keygen, binding.value_cols[2])?;
-    let left_partner = copy_partner(
-        &keygen,
-        PermCell {
-            permutation_column_position: left_position,
-            row: add_row,
-        },
-    )?;
-    let right_partner = copy_partner(
-        &keygen,
-        PermCell {
-            permutation_column_position: right_position,
-            row: add_row,
-        },
-    )?;
-    Ok(JoinedLinearCombinationView {
-        binding: binding.clone(),
-        k,
-        num_rows,
-        assign_fixed_region_start,
-        linear_combination_region_start,
-        add_row,
-        zero_cell,
-        zero_cell_encoding,
-        out_cell: value_cells[0],
-        next_out_cell: AbsoluteCell {
-            kind: CellKind::Advice,
-            column_index: binding.value_cols[0],
-            row: next_row,
-        },
-        value_cells,
-        coeff_cells,
-        const_cell,
-        q_next_cell,
-        mul_ab_cell,
-        mul_ac_cell,
-        q_arith_cell,
-        q_arith_enabled,
-        gate_fixed_encodings,
-        left_partner,
-        right_partner,
-        fixed_values: keygen.fixed_values.clone(),
-        selectors: keygen.selectors.clone(),
-        converted_selector_fixed: keygen.converted_selector_fixed.clone(),
-        permutation_columns: keygen.permutation_columns.clone(),
-        copy_pairs: keygen.copy_pairs.clone(),
-        advice_values: proving.advice_values.clone(),
-    })
-}
