-/// One frame of the thread-local recording stack. Frames are
-/// identified by a unique session id so that hooks can store into
-/// the frame that was active when their external work began, even
-/// if a nested session has since become the top frame.
-struct ActiveFrame {
-    /// Unique id of the session that owns this frame.
-    id: u64,
-    /// The session being recorded into this frame.
-    session: RecordedSession,
-}
-
-thread_local! {
-    static ACTIVE_STACK: RefCell<Vec<ActiveFrame>> = RefCell::new(Vec::new());
-    static LAST_KEYGEN: RefCell<Option<RecordedSession>> = RefCell::new(None);
-    static LAST_PROVING: RefCell<Option<RecordedSession>> = RefCell::new(None);
-    static NEXT_SESSION_ID: Cell<u64> = Cell::new(1);
-}
-
-/// RAII guard for one opt-in recording session.
-///
-/// The guard is not `Send` and not `Sync` (the `PhantomData<Rc<()>>`
-/// marker): it must be created, held, and dropped on the thread
-/// that called [`begin_recording`]. Moving it to another thread is
-/// a compile error:
-///
-/// ```compile_fail
-/// let guard = midnight_proofs::plonk::native_add_view::begin_recording(
-///     midnight_proofs::plonk::native_add_view::CapturePhase::Keygen,
-///     1,
-/// );
-/// std::thread::spawn(move || drop(guard));
-/// ```
-///
-/// Dropping in LIFO order finalizes the session into the per-phase
-/// slot read by [`take_last_keygen_recording`] /
-/// [`take_last_proving_recording`]. Dropping out of order discards
-/// only that guard's session, leaves any inner active session
-/// recording, and never resurrects the dropped session. `Drop`
-/// never panics, including during TLS teardown or unwinding.
-pub struct NativeAddRecordingGuard {
-    /// Caller-declared phase label for this session.
-    declared_phase: CapturePhase,
-    /// Unique id of this guard's frame in the recording stack.
-    session_id: u64,
-    /// Non-`Send`, non-`Sync` marker: the guard is thread-affine.
-    _not_send: PhantomData<Rc<()>>,
-}
-
-impl fmt::Debug for NativeAddRecordingGuard {
-    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
-        f.debug_struct("NativeAddRecordingGuard")
-            .field("declared_phase", &self.declared_phase)
-            .finish_non_exhaustive()
-    }
-}
-
-fn publish_session(session: RecordedSession) {
-    match session.declared_phase {
-        CapturePhase::Keygen => {
-            let _ = LAST_KEYGEN.try_with(|slot| {
-                if let Ok(mut slot) = slot.try_borrow_mut() {
-                    *slot = Some(session);
-                }
-            });
-        }
-        CapturePhase::Proving => {
-            let _ = LAST_PROVING.try_with(|slot| {
-                if let Ok(mut slot) = slot.try_borrow_mut() {
-                    *slot = Some(session);
-                }
-            });
-        }
-    }
-}
-
-impl Drop for NativeAddRecordingGuard {
-    fn drop(&mut self) {
-        // Extract this guard's session only if it is the top frame.
-        // An out-of-order frame is removed and discarded unpublished;
-        // frames above and below it are untouched. Every access is
-        // fallible so destruction during TLS teardown or unwinding
-        // cannot panic inside `Drop`.
-        let extracted: Option<RecordedSession> = ACTIVE_STACK
-            .try_with(|stack_cell| {
-                let mut stack = stack_cell.try_borrow_mut().ok()?;
-                let position = stack.iter().position(|frame| frame.id == self.session_id)?;
-                if position + 1 == stack.len() {
-                    stack.pop().map(|frame| frame.session)
-                } else {
-                    let _discarded = stack.remove(position);
-                    None
-                }
-            })
-            .ok()
-            .flatten();
-        if let Some(session) = extracted {
-            publish_session(session);
-        }
-    }
-}
