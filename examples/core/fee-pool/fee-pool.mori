      opBWeight < exclusiveU64 and
      daSeatWeight < exclusiveU64 and
      watcherWeight < exclusiveU64 and
      ordinaryAmount < exclusiveU64 and
      stipendAmount < exclusiveU64 and
      opAAmount < exclusiveU64 and
      opBAmount < exclusiveU64 and
      daAmount < exclusiveU64 and
      l2Amount < exclusiveU64 and
      midnightAmount < exclusiveU64 and
      dustAmount < exclusiveU64 and
      spendAmount < exclusiveU64 and
      claimedTotal < exclusiveU64 and
      carried < exclusiveU64;
    requires observedAt < exclusiveU64;
    requires metered == ordinaryAmount + stipendAmount;
    requires metered <= gross;
    requires opWeight == opAWeight + opBWeight;
    requires daWeight == daSeatWeight;
    requires rewardSeatCount <= 3 and allocatedCount <= rewardSeatCount;
    requires not finished or settled;
    requires recorded and settled and spendIssued and not spendClaimed;
    requires spendAmount > 0;
    requires liability_present("watcher_spend");
    requires liability_amount("watcher_spend") == spendAmount;
    requires observedAt >= epochClose;
    let claimAmount = spendAmount;
    let nextClaimed = claimedTotal + claimAmount;
    requires nextClaimed < exclusiveU64;
    transfer(FEES, "fee-pool", "watcher", claimAmount);
    discharge("watcher_spend", claimAmount);
    next claimedTotal = nextClaimed;
    next spendClaimed = true;
  }
}
