// Finite one-epoch monetary component; no native authentication or clock binding.
// Public observations and fixed recipients are explicit external premises.
// Entitlements reserve funded custody; only claims transfer it.
language "moriarty/1";
agreement FeePoolU64Component {
  asset FEES = { network: "local", issuer: "fee-pool-source", reference: "SERVICE", scale: 0 };
  state epoch: UInt = 0;
  state epochClose: UInt = 0;
