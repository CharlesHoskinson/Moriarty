      l2Amount < exclusiveU64 and
      midnightAmount < exclusiveU64 and
      dustAmount < exclusiveU64 and
      spendAmount < exclusiveU64 and
      claimedTotal < exclusiveU64 and
      carried < exclusiveU64;
    requires opQ < exclusiveU64 and opR < exclusiveU64 and daQ < exclusiveU64 and daR < exclusiveU64 and watcherQ < exclusiveU64 and watcherR < exclusiveU64 and l2Q < exclusiveU64 and l2R < exclusiveU64 and refill < exclusiveU64;
    requires metered == ordinaryAmount + stipendAmount;
    requires metered <= gross;
    requires opWeight == opAWeight + opBWeight;
    requires daWeight == daSeatWeight;
    requires rewardSeatCount <= 3 and allocatedCount <= rewardSeatCount;
    requires not finished or settled;
    requires recorded and not settled;
    requires not liability_present("treasury_l2");
    requires not liability_present("treasury_midnight");
    requires l2Amount == 0 and midnightAmount == 0 and not l2Claimed and not midnightClaimed;
    let surplus = gross - metered;
    requires opR < 100;
    requires opQ * 100 + opR == surplus * 55;
    requires daR < 100;
    requires daQ * 100 + daR == surplus * 10;
    requires watcherR < 100;
    requires watcherQ * 100 + watcherR == surplus * 5;
    requires l2R < 100;
    requires l2Q * 100 + l2R == surplus * 15;
    let shares = opQ + daQ + watcherQ + l2Q;
    requires shares <= surplus;
    let midnight = surplus - shares;
    requires refill <= l2Q;
    let afterBackstop = backstop + refill;
    requires afterBackstop < exclusiveU64;
    requires (backstop >= target and refill == 0) or (backstop < target and afterBackstop <= target and (refill == l2Q or afterBackstop == target));
    let newL2 = l2Q - refill;
    let nextWatcher = watcherHeld + watcherQ;
    requires nextWatcher < exclusiveU64;
    let nextCarried = opQ + daQ;
    requires nextCarried < exclusiveU64;
    liability("treasury_l2", FEES, "fee-pool", "l2-treasury", newL2);
    liability("treasury_midnight", FEES, "fee-pool", "midnight-treasury", midnight);
    next opTotal = opQ;
    next daTotal = daQ;
    next watcherTotal = watcherQ;
    next opRemaining = opQ;
    next daRemaining = daQ;
    next carried = nextCarried;
    next watcherHeld = nextWatcher;
    next backstop = afterBackstop;
    next l2Amount = newL2;
    next midnightAmount = midnight;
    next settled = true;
  }

