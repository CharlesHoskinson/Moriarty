    requires not liability_present("cost_stipend");
    requires not liability_present("reward_operator_a");
    requires not liability_present("reward_operator_b");
    requires not liability_present("reward_da");
    requires not liability_present("treasury_l2");
    requires not liability_present("treasury_midnight");
    requires not liability_present("treasury_dust");
    requires not liability_present("watcher_spend");
    let nextEpoch = epochId + 1;
    requires nextEpoch < exclusiveU64;
    let close = nextEpoch * 86400;
    requires close < exclusiveU64;
    requires closeObservedAt >= close;
    transfer(FEES, "funding-source", "fee-pool", grossAmount);
    next epoch = epochId;
    next epochClose = close;
    next gross = grossAmount;
    next target = initialTarget;
    next stipendLimit = watcherStipendLimit;
    next carried = grossAmount;
    next recorded = true;
  }

