    requires daWeight == daSeatWeight;
    requires rewardSeatCount <= 3 and allocatedCount <= rewardSeatCount;
    requires not finished or settled;
    requires recorded and not settled and not opARegistered;
    requires weight <= 86400;
    requires (attested and effectiveWeight == weight) or (not attested and effectiveWeight == 0);
    let nextWeight = opWeight + effectiveWeight;
    requires nextWeight < exclusiveU64;
    let nextSeats = rewardSeatCount + 1;
    requires nextSeats <= 3;
    next opAWeight = effectiveWeight;
    next opWeight = nextWeight;
    next rewardSeatCount = nextSeats;
    next opARegistered = true;
  }

