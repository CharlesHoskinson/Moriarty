    requires ordinaryAmount == 0 and not ordinaryClaimed;
    let nextMetered = metered + amount;
    requires nextMetered <= gross;
    requires amount <= carried;
    let nextCarried = carried - amount;
    liability("cost_ordinary", FEES, "fee-pool", "cost-provider", amount);
