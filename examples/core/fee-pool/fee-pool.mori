    requires recorded and settled and not finished and opARegistered and not opAAllocated;
    requires not liability_present("reward_operator_a");
    requires opAAmount == 0 and not opAClaimed;
    requires (opWeight == 0 and denominator == 1) or (opWeight > 0 and denominator == opWeight);
    requires denominator > 0 and remainder < denominator;
    requires quotient * denominator + remainder == opTotal * opAWeight;
    requires quotient <= opRemaining and quotient <= carried;
    let nextRemaining = opRemaining - quotient;
    let nextCarried = carried - quotient;
    let nextAllocated = allocatedCount + 1;
    requires nextAllocated <= rewardSeatCount;
    let rewardUnlock = epochClose + 2592000;
    requires rewardUnlock < exclusiveU64;
    liability("reward_operator_a", FEES, "fee-pool", "operator-a", quotient);
    next opAAmount = quotient;
    next opRemaining = nextRemaining;
    next carried = nextCarried;
    next allocatedCount = nextAllocated;
    next opAAllocated = true;
