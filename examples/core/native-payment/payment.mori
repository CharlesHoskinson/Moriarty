language "moriarty/1";
agreement NativePayment {
  asset QA = { network: "local", issuer: "native-proof-qa", reference: "QA", scale: 0 };
  state paid: UInt = 0;
  action run(amount: UInt, approved: Bool) {
    requires approved and amount > 0;
    transfer(QA, "alice", "bob", amount);
    fee(QA, "alice", "treasury", 2);
    next paid = paid + amount + 2;
    emit "settled"(paid);
  }
}
