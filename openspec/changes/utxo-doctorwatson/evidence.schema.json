{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moriarty:doctorwatson-utxo:evidence:1",
  "title": "doctorwatson<UTXO> declared evidence record, version1",
  "description": "Structural field contract only. The reader additionally validates source membership, pins, declared dependencies and closure declarations. Neither schema nor reader authenticates semantic acceptance. Unknown optional metadata is inert.",
  "type": "object",
  "properties": {
    "format": {
      "const": "doctorwatson-utxo.evidence/1"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/publicRef"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "scenarioNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicability": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "profile",
              "target",
              "reason"
            ]
          },
          "implementation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "detail"
            ]
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/publicRef"
                }
              }
            },
            "required": [
              "status",
              "evidenceRefs"
            ]
          },
          "acceptance": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reviewRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/publicRef"
                }
              }
            },
            "required": [
              "status",
              "scope",
              "reason",
              "reviewRefs"
            ]
          },
          "scenarioRecords": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "expectation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/publicRef"
                  }
                }
              },
              "required": [
                "name",
                "status",
                "expectation",
                "evidenceRefs"
              ]
            }
          },
          "sourcePins": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/publicRef"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextAction": {
            "type": "object",
            "properties": {
              "consumer": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "blockedBy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "readiness": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "consumer",
              "expected",
              "owner",
              "blockedBy",
              "readiness"
            ]
          }
        },
        "required": [
          "key",
          "id",
          "group",
          "source",
          "heading",
          "scenarioNames",
          "applicability",
          "implementation",
          "validation",
          "acceptance",
          "scenarioRecords",
          "sourcePins",
          "dependsOn",
          "nextAction"
        ]
      }
    },
    "families": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "type": "string",
            "minLength": 1
          },
          "compiled": {
            "type": "string",
            "minLength": 1
          },
          "native": {
            "type": "string",
            "minLength": 1
          },
          "private": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "admission",
          "compiled",
          "native",
          "private"
        ]
      }
    }
  },
  "required": [
    "format",
    "rows",
    "families"
  ],
  "$defs": {
    "publicRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  }
}
