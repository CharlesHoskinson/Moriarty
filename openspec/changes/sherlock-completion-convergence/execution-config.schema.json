{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sherlock-host-config/1 draft proposal; checked actual-type width conversion required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profile",
    "grammar",
    "finance",
    "bounds",
    "layout",
    "fuel",
    "stack",
    "host"
  ],
  "properties": {
    "format": {
      "const": "sherlock-host-config/1"
    },
    "profile": {
      "const": "sherlock-helper-microstep/1"
    },
    "grammar": {
      "const": "DedicatedSorts"
    },
    "finance": {
      "const": "Absent"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_rows",
        "function_rows",
        "code_child_slots",
        "parameter_slots",
        "pattern_rows",
        "match_plan_rows",
        "match_arm_rows",
        "type_rows",
        "constructor_rows",
        "constructor_field_slots",
        "max_arity",
        "constant_nodes",
        "constant_field_slots",
        "data_nodes",
        "data_field_slots",
        "environment_cells",
        "frames",
        "helper_tasks",
        "serialization_bytes",
        "max_reference_work",
        "max_helper_work",
        "step_cap"
      ],
      "properties": {
        "code_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "function_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "code_child_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "parameter_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "pattern_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "match_plan_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "match_arm_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "type_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "constructor_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "constructor_field_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_arity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "constant_nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "constant_field_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "data_nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "data_field_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "environment_cells": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "frames": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "helper_tasks": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "serialization_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_reference_work": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_helper_work": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "step_cap": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_version",
        "field_id",
        "widths",
        "scalar_layout_id",
        "capacities",
        "boundary_capacities_present"
      ],
      "properties": {
        "layout_version": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "field_id": {
          "type": "null"
        },
        "widths": {
          "type": "null"
        },
        "scalar_layout_id": {
          "type": "null"
        },
        "capacities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name_rows",
            "name_bytes",
            "occurrence_path_slots",
            "value_slots"
          ],
          "properties": {
            "name_rows": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "name_bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "occurrence_path_slots": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "value_slots": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        "boundary_capacities_present": {
          "const": false
        }
      }
    },
    "fuel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "Nat"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "Negative"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "NatAboveU128"
            }
          }
        }
      ]
    },
    "stack": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "Nat"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "Negative"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "NatAboveU128"
            }
          }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_actions",
        "max_source_expressions",
        "max_source_statements",
        "max_action_inputs",
        "max_supplied_inputs",
        "max_projection_occurrences",
        "max_generated_ast_nodes",
        "max_ast_nesting",
        "max_input_name_bytes",
        "max_total_input_name_bytes"
      ],
      "properties": {
        "max_source_actions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_source_expressions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_source_statements": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_action_inputs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_supplied_inputs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_projection_occurrences": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_generated_ast_nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_ast_nesting": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_input_name_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_total_input_name_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
