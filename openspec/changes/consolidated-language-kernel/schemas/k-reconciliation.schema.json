{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriarty.invalid/u0/k-reconciliation/1",
  "title": "Moriarty U0 K reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kRoots",
    "executionEvidence",
    "limitation",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "moriarty-u0-k-reconciliation/1"
    },
    "kRoots": {
      "type": "array",
      "const": [
        "experiments/moriarty-language/formal/k"
      ]
    },
    "executionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "quotes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "const": "Coverage is a reviewed claim; the checker proves citations and evidence quotes only."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "status",
          "kCitations",
          "evidence",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "uni",
              "judgment"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "partial",
              "not-covered"
            ]
          },
          "kCitations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "context",
                "symbol"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "quote"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
