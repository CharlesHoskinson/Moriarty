{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moriarty-u0-backend-matrix/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "sourceSha256", "rows"],
  "properties": {
    "schemaVersion": {
      "const": "moriarty-u0-backend-matrix/1"
    },
    "source": {
      "const": "docs/MORIARTY-BACKEND-REQUIREMENTS.md"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "title",
        "class",
        "requirement",
        "acceptance",
        "presentSupport",
        "refines",
        "owner",
        "milestone",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(ZR|MNR)[0-9]{2}$"
        },
        "family": {
          "enum": ["ZR", "MNR"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z](?:/[A-Z])*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "presentSupport": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "refines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ZR[0-9]{2}$"
          }
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "milestone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "specified-only"
        }
      }
    }
  }
}
