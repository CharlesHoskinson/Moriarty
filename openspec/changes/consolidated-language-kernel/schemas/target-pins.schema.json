{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moriarty U0 target pins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "compatibleTupleEstablished",
    "absenceSearch",
    "pins",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": {
      "const": "moriarty-u0-target-pins/1"
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "compatibleTupleEstablished": {
      "type": "boolean",
      "const": false
    },
    "absenceSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "pinPatterns", "limitation"],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pinPatterns": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitation": {
          "const": "absent means no pin found by this recorded search; not a proof that none exists"
        }
      }
    },
    "pins": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "name",
          "pin",
          "pinKind",
          "status",
          "sourceEvidence",
          "note",
          "claims",
          "searchTerms",
          "excludedHits"
        ],
        "properties": {
          "component": {
            "enum": [
              "moriarty-compiler",
              "compact-compiler",
              "zkir",
              "native-proof-system",
              "verifier",
              "proving-keys",
              "verifier-keys",
              "srs-parameters",
              "ledger",
              "proof-server",
              "k-reference-toolchain"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": ["string", "null"]
          },
          "pinKind": {
            "enum": ["git-commit", "version", "sha256", "none"]
          },
          "status": {
            "enum": ["historical", "absent"]
          },
          "sourceEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text", "evidencePath", "evidenceQuote"],
              "properties": {
                "kind": {
                  "enum": ["found-in", "conflict", "not-found", "unresolved"]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidencePath": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "evidenceQuote": {
                  "type": ["string", "null"],
                  "minLength": 12
                }
              }
            }
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "excludedHits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "reason"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
