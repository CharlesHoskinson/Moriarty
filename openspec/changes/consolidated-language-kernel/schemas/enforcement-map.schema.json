{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriarty.invalid/u0/enforcement-map/1",
  "title": "Moriarty U0 enforcement map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageSchema",
    "stageSchemaSha256",
    "nativeRoots",
    "limitation",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "moriarty-u0-enforcement-map/1"
    },
    "stageSchema": {
      "type": "string",
      "const": "openspec/changes/consolidated-language-kernel/schemas/stage-relation.schema.json"
    },
    "stageSchemaSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nativeRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaField",
          "status",
          "mechanisms",
          "note"
        ],
        "properties": {
          "schemaField": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "enforced",
              "host-only",
              "NOT_ENFORCED"
            ]
          },
          "mechanisms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "file",
                "line",
                "symbol",
                "note"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "circuit",
                    "ledgerPrimitive",
                    "signature",
                    "nativeBoundary",
                    "hostCheck"
                  ]
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
