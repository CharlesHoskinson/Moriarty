{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriarty.invalid/u0/stage-relation/1",
  "title": "Moriarty canonical stage relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles",
    "programIdentity",
    "circuitIdentity",
    "domain",
    "signedIntent",
    "lifecycleIds",
    "predecessorCommitments",
    "obligationCommitments",
    "observations",
    "effects",
    "liabilities",
    "authority",
    "resources",
    "disclosures",
    "failurePolicy",
    "outcome",
    "judgments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "moriarty-stage-relation/1"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticProfile",
        "numericProfile"
      ],
      "properties": {
        "semanticProfile": {
          "type": "string"
        },
        "numericProfile": {
          "type": "string"
        }
      }
    },
    "programIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "coreRef",
        "programId",
        "entryPoint"
      ],
      "properties": {
        "sourceRef": {
          "type": "string"
        },
        "coreRef": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "entryPoint": {
          "type": "string"
        }
      }
    },
    "circuitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerPin",
        "zkirVersion",
        "circuitId",
        "verifierKeyId"
      ],
      "properties": {
        "compilerPin": {
          "type": "string"
        },
        "zkirVersion": {
          "type": "string"
        },
        "circuitId": {
          "type": "string"
        },
        "verifierKeyId": {
          "type": "string"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "domainId",
        "stateFrameRef"
      ],
      "properties": {
        "chainId": {
          "type": "string"
        },
        "domainId": {
          "type": "string"
        },
        "stateFrameRef": {
          "type": "string"
        }
      }
    },
    "signedIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "signer",
        "consentPolicy",
        "delegationPolicy",
        "assetIdentities",
        "recipients",
        "grossDebitCap",
        "feeCap",
        "minNetOutcome",
        "validity",
        "replayPolicy",
        "recoveryPolicy"
      ],
      "properties": {
        "intentId": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "consentPolicy": {
          "type": "string"
        },
        "delegationPolicy": {
          "type": "string"
        },
        "assetIdentities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grossDebitCap": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "feeCap": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "minNetOutcome": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "validity": {
          "type": "string"
        },
        "replayPolicy": {
          "type": "string"
        },
        "recoveryPolicy": {
          "type": "string"
        }
      }
    },
    "lifecycleIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycleId",
        "stageId",
        "logicalRequestId"
      ],
      "properties": {
        "lifecycleId": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "logicalRequestId": {
          "type": "string"
        }
      }
    },
    "predecessorCommitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predecessorId",
          "commitment"
        ],
        "properties": {
          "predecessorId": {
            "type": "string"
          },
          "commitment": {
            "type": "string"
          }
        }
      }
    },
    "obligationCommitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligationId",
          "commitment"
        ],
        "properties": {
          "obligationId": {
            "type": "string"
          },
          "commitment": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "issuer",
          "domain",
          "time",
          "finality"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "finality": {
            "type": "string"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross",
        "fees",
        "net",
        "supplyChanges"
      ],
      "properties": {
        "gross": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "account",
              "amount"
            ],
            "properties": {
              "asset": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "account",
              "amount"
            ],
            "properties": {
              "asset": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        },
        "net": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "account",
              "amount"
            ],
            "properties": {
              "asset": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        },
        "supplyChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "account",
              "amount"
            ],
            "properties": {
              "asset": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        }
      }
    },
    "liabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening",
        "closing"
      ],
      "properties": {
        "opening": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "liabilityId",
              "debtor",
              "creditor",
              "asset",
              "amount"
            ],
            "properties": {
              "liabilityId": {
                "type": "string"
              },
              "debtor": {
                "type": "string"
              },
              "creditor": {
                "type": "string"
              },
              "asset": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        },
        "closing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "liabilityId",
              "debtor",
              "creditor",
              "asset",
              "amount"
            ],
            "properties": {
              "liabilityId": {
                "type": "string"
              },
              "debtor": {
                "type": "string"
              },
              "creditor": {
                "type": "string"
              },
              "asset": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumed",
        "remaining",
        "replayState"
      ],
      "properties": {
        "consumed": {
          "type": "string"
        },
        "remaining": {
          "type": "string"
        },
        "replayState": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceCertificate",
        "cumulativeReservations"
      ],
      "properties": {
        "resourceCertificate": {
          "type": "string"
        },
        "cumulativeReservations": {
          "type": "string"
        }
      }
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party",
          "fields"
        ],
        "properties": {
          "party": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phasePolicy",
        "retainedEffects",
        "retainedFees"
      ],
      "properties": {
        "phasePolicy": {
          "type": "string"
        },
        "retainedEffects": {
          "type": "string"
        },
        "retainedFees": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "continuations"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "continuation",
            "terminal"
          ]
        },
        "continuations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "judgments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "intent",
        "effect",
        "authority",
        "history",
        "failure"
      ],
      "properties": {
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enforcementRef"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "held",
                "violated",
                "unchecked"
              ]
            },
            "enforcementRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
