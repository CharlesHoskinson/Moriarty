{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moriarty-u0-trust-premises/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "limitation", "premises"],
  "properties": {
    "schemaVersion": {
      "const": "moriarty-u0-trust-premises/1"
    },
    "limitation": {
      "type": "string",
      "minLength": 40,
      "description": "States that semantic fit of a quote to its label is a reviewed claim, not mechanically proven."
    },
    "premises": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/premise"
      }
    }
  },
  "$defs": {
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "statement", "kind", "sourceRefs", "relatedIds", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TP[0-9]{2}$"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "statement": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "^[^.!?;\\n]+[.!?]$"
        },
        "kind": {
          "enum": ["trust-assumption", "unresolved-interface", "planning-assumption"]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "relatedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(ZR[0-9]{2}|MNR[0-9]{2}|UNI-[0-9]{3}|MPLR-[0-9]{3})$"
          }
        },
        "status": {
          "enum": ["open", "accepted-assumption"]
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "quoteRole", "quote"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "quoteRole": {
          "enum": ["states-premise", "states-limitation", "states-owner"]
        },
        "quote": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
