module installment_test {
  import installment_harness.* from "./installment_harness"

  run prepareParentAfterTest = initAfter.then(prepareParent).expect(parentChecked)
  run prepareParentBeforeTest = initBefore.then(prepareParent).expect(parentChecked)
  run signParentAfterTest = initAfter.then(prepareParent).then(signParent).expect(parentRegistered)
  run signParentBeforeTest = initBefore.then(prepareParent).then(signParent).expect(parentRegistered)
  run prepareRaceAfterTest = initAfter.then(prepareParent).then(signParent)
    .then(proposeFirstFill).then(proposeInitialCancellation)
    .then(verifyFirstFill).then(verifyInitialCancellation).expect(racePrepared)
  run prepareRaceBeforeTest = initBefore.then(prepareParent).then(signParent)
    .then(proposeInitialCancellation).then(proposeFirstFill)
    .then(verifyInitialCancellation).then(verifyFirstFill).expect(racePrepared)

  run completedPaymentAfterTest = initAfter.then(prepareParent).then(signParent)
    .then(proposeFirstFill).then(proposeInitialCancellation)
    .then(verifyFirstFill).then(verifyInitialCancellation)
    .then(commitFirstFill).then(rejectInitialCancellation)
    .then(proposeSecondFill).then(verifySecondFill).then(commitSecondFill)
    .expect(completedPaymentAfter and installmentSafety)
  run completedPaymentBeforeTest = initBefore.then(prepareParent).then(signParent)
    .then(proposeInitialCancellation).then(proposeFirstFill)
    .then(verifyInitialCancellation).then(verifyFirstFill)
    .then(commitFirstFill).then(rejectInitialCancellation)
    .then(proposeSecondFill).then(verifySecondFill).then(commitSecondFill)
    .expect(completedPaymentBefore and installmentSafety)
  run cancellationWinsRecoveryTenAfterTest = initAfter.then(prepareParent).then(signParent)
    .then(proposeFirstFill).then(proposeInitialCancellation)
    .then(verifyFirstFill).then(verifyInitialCancellation)
    .then(commitInitialCancellation).then(rejectFirstFill)
    .then(prepareRecovery).then(signRecovery).then(proposeRecovery).then(verifyRecovery).then(commitRecovery)
    .expect(recoveryTenAfter and installmentSafety)
  run cancellationWinsRecoveryTenBeforeTest = initBefore.then(prepareParent).then(signParent)
    .then(proposeInitialCancellation).then(proposeFirstFill)
    .then(verifyInitialCancellation).then(verifyFirstFill)
    .then(commitInitialCancellation).then(rejectFirstFill)
    .then(prepareRecovery).then(signRecovery).then(proposeRecovery).then(verifyRecovery).then(commitRecovery)
    .expect(recoveryTenBefore and installmentSafety)
  run fillWinsRecoveryFiveAfterTest = initAfter.then(prepareParent).then(signParent)
    .then(proposeFirstFill).then(proposeInitialCancellation)
    .then(verifyFirstFill).then(verifyInitialCancellation)
    .then(commitFirstFill).then(rejectInitialCancellation)
    .then(proposeFreshCancellation).then(verifyFreshCancellation).then(commitFreshCancellation)
    .then(prepareRecovery).then(signRecovery).then(proposeRecovery).then(verifyRecovery).then(commitRecovery)
    .expect(recoveryFiveAfter and installmentSafety)
  run fillWinsRecoveryFiveBeforeTest = initBefore.then(prepareParent).then(signParent)
    .then(proposeInitialCancellation).then(proposeFirstFill)
    .then(verifyInitialCancellation).then(verifyFirstFill)
    .then(commitFirstFill).then(rejectInitialCancellation)
    .then(proposeFreshCancellation).then(verifyFreshCancellation).then(commitFreshCancellation)
    .then(prepareRecovery).then(signRecovery).then(proposeRecovery).then(verifyRecovery).then(commitRecovery)
    .expect(recoveryFiveBefore and installmentSafety)
}
