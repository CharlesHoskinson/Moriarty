+}
+
+/// Actual Core observations projected with this harness's own arithmetic into the frozen
+/// accounting fields (never the candidate's accounting code).
+struct Observed {
+    balances: BTreeMap<(AssetId, String), BTreeMap<String, Json>>,
+    duties: BTreeMap<String, BTreeMap<String, Json>>,
+    residual: Vec<String>,
+}
+
+fn signed_delta(post: u128, pre: u128) -> String {
+    if post >= pre { (post - pre).to_string() } else { format!("-{}", pre - post) }
+}
+
+fn observe(pre: &Snapshot, post: &Snapshot, effects: &[Effect]) -> Result<Observed, String> {
+    let mut balances = BTreeMap::new();
+    if pre.balances.len() != post.balances.len() {
+        return Err("pre and post balance row counts differ".into());
+    }
+    for b in &pre.balances {
+        let after = post
+            .balances
+            .iter()
+            .find(|p| p.asset == b.asset && p.account == b.account)
+            .ok_or_else(|| format!("post lacks {}", b.account))?
+            .amount
+            .0;
+        let (mut gross, mut gross_ex_self, mut fees) = (0u128, 0u128, 0u128);
+        for e in effects {
+            let (asset, from, to, amount, is_fee) = match e {
+                Effect::Transfer { asset, from, to, amount } => (asset, from, to, amount.0, false),
+                Effect::Fee { asset, from, to, amount } => (asset, from, to, amount.0, true),
+                _ => continue,
+            };
+            if *asset == b.asset && *from == b.account {
+                gross = gross.checked_add(amount).ok_or("gross debit overflows u128")?;
+                if to != from {
+                    gross_ex_self = gross_ex_self.checked_add(amount).ok_or("gross debit overflows u128")?;
+                }
+                if is_fee {
+                    fees = fees.checked_add(amount).ok_or("fees overflow u128")?;
+                }
+            }
+        }
+        let mut row = BTreeMap::new();
+        row.insert("pre".to_string(), Json::String(b.amount.0.to_string()));
+        row.insert("post".to_string(), Json::String(after.to_string()));
+        row.insert("net_delta".to_string(), Json::String(signed_delta(after, b.amount.0)));
+        row.insert("gross_debit".to_string(), Json::String(gross.to_string()));
+        row.insert("gross_debit_excluding_self".to_string(), Json::String(gross_ex_self.to_string()));
+        row.insert("fees_paid".to_string(), Json::String(fees.to_string()));
+        balances.insert((b.asset.clone(), b.account.clone()), row);
+    }
+    let mut names: BTreeSet<String> = pre.liabilities.iter().map(|l| l.name.clone()).collect();
+    names.extend(post.liabilities.iter().map(|l| l.name.clone()));
+    let mut duties = BTreeMap::new();
+    let mut residual = Vec::new();
+    for name in names {
+        let opening = pre.liabilities.iter().find(|l| l.name == name).map(|l| l.amount.0);
+        let closing = post.liabilities.iter().find(|l| l.name == name).map(|l| l.amount.0);
+        let (mut accrued, mut discharged) = (0u128, 0u128);
+        for e in effects {
+            if let Effect::Liability { name: n, before, after, .. } = e {
+                if *n == name {
+                    if after.0 >= before.0 {
+                        accrued = accrued.checked_add(after.0 - before.0).ok_or("accrual overflows u128")?;
+                    } else {
+                        discharged = discharged.checked_add(before.0 - after.0).ok_or("discharge overflows u128")?;
+                    }
+                }
+            }
+        }
+        let mut row = BTreeMap::new();
+        row.insert("opening".to_string(), Json::String(opening.unwrap_or(0).to_string()));
+        row.insert("closing".to_string(), Json::String(closing.unwrap_or(0).to_string()));
+        row.insert("accrued".to_string(), Json::String(accrued.to_string()));
+        row.insert("discharged".to_string(), Json::String(discharged.to_string()));
+        row.insert("present_before".to_string(), Json::Bool(opening.is_some()));
+        row.insert("present_after".to_string(), Json::Bool(closing.is_some()));
+        row.insert("present_zero_after".to_string(), Json::Bool(closing == Some(0)));
+        if closing.is_some_and(|c| c > 0) {
+            residual.push(name.clone());
+        }
+        duties.insert(name, row);
+    }
+    residual.sort();
+    Ok(Observed { balances, duties, residual })
+}
+
+const BALANCE_FIELDS: [&str; 6] = ["pre", "post", "net_delta", "gross_debit", "gross_debit_excluding_self", "fees_paid"];
+const DUTY_FIELDS: [&str; 7] = ["opening", "accrued", "discharged", "closing", "present_before", "present_after", "present_zero_after"];
+
+fn frozen_asset(j: &Json) -> AssetId {
+    serde_json::from_value(j.clone()).expect("frozen asset identity decodes")
+}
+
+/// Field-by-field differences between a frozen accounting block and an observation.
+fn compare_accounting(frozen: &Json, obs: &Observed) -> Vec<String> {
+    let mut diffs = Vec::new();
+    let mut seen = BTreeSet::new();
+    for row in frozen["balances"].as_array().expect("frozen balances") {
+        let key = (frozen_asset(&row["asset"]), row["account"].as_str().expect("account").to_string());
+        match obs.balances.get(&key) {
+            None => diffs.push(format!("balance {}/{}: no observed row", key.0.reference, key.1)),
+            Some(o) => {
+                for f in BALANCE_FIELDS {
+                    if o.get(f) != Some(&row[f]) {
+                        diffs.push(format!("balance {}/{} {f}: observed {:?} frozen {}", key.0.reference, key.1, o.get(f), row[f]));
+                    }
+                }
+            }
+        }
+        seen.insert(key);
+    }
+    for key in obs.balances.keys().filter(|k| !seen.contains(*k)) {
+        diffs.push(format!("balance {}/{}: observed row absent from the frozen block", key.0.reference, key.1));
+    }
+    let mut seen = BTreeSet::new();
+    for row in frozen["duties"].as_array().expect("frozen duties") {
+        let name = row["name"].as_str().expect("duty name").to_string();
+        match obs.duties.get(&name) {
+            None => diffs.push(format!("duty {name}: no observed row")),
+            Some(o) => {
+                for f in DUTY_FIELDS {
+                    if o.get(f) != Some(&row[f]) {
+                        diffs.push(format!("duty {name} {f}: observed {:?} frozen {}", o.get(f), row[f]));
+                    }
+                }
+            }
+        }
+        seen.insert(name);
+    }
+    for name in obs.duties.keys().filter(|n| !seen.contains(*n)) {
+        diffs.push(format!("duty {name}: observed row absent from the frozen block"));
+    }
+    let mut frozen_residual: Vec<String> =
+        frozen["residual_positive"].as_array().expect("residual_positive").iter().map(|n| n.as_str().expect("name").to_string()).collect();
+    frozen_residual.sort();
+    if frozen_residual != obs.residual {
+        diffs.push(format!("residual_positive: observed {:?} frozen {frozen_residual:?}", obs.residual));
+    }
+    diffs
+}
+
+/// The public statement of `rel` for frozen records, compared with the frozen block:
+/// represented pre/post cells, registry duty presence and amounts, Liability effect slots.
+/// Returns (mismatches, rows outside the statement).
+fn compare_statement(rel: &CompiledRelation, public: &[Fr], frozen: &Json, effects: &[Effect]) -> (Vec<String>, Vec<String>) {
+    let plan = rel.plan();
+    let mut diffs = Vec::new();
+    let mut outside = Vec::new();
+    let rows: BTreeMap<(AssetId, String), &Json> = frozen["balances"]
+        .as_array()
+        .expect("frozen balances")
+        .iter()
+        .map(|r| ((frozen_asset(&r["asset"]), r["account"].as_str().expect("account").to_string()), r))
+        .collect();
+    for (i, cell) in plan.cells.iter().enumerate() {
+        let Some(row) = rows.get(&(cell.asset.clone(), cell.account.clone())) else {
+            diffs.push(format!("represented cell {}/{} has no frozen row", cell.asset_name, cell.account));
+            continue;
+        };
+        if slot_fields(rel, public, SlotKind::PreCell { index: i }) != Some(uint_fe(num(&row["pre"]))) {
+            diffs.push(format!("pre.cell.{}.{} differs from frozen pre {}", cell.asset_name, cell.account, row["pre"]));
+        }
+        if slot_fields(rel, public, SlotKind::PostCell { index: i }) != Some(uint_fe(num(&row["post"]))) {
+            diffs.push(format!("post.cell.{}.{} differs from frozen post {}", cell.asset_name, cell.account, row["post"]));
+        }
+    }
+    for ((asset, account), row) in &rows {
+        if plan.cell_index(asset, account).is_none() {
+            if row["gross_debit"].as_str() != Some("0") {
+                diffs.push(format!("debited row {}/{account} is not represented", asset.reference));
+            } else {
+                outside.push(format!("balance {}/{account} (frame row; not in the statement under this option)", asset.reference));
+            }
+        }
+    }
+    let duties: BTreeMap<String, &Json> =
+        frozen["duties"].as_array().expect("frozen duties").iter().map(|d| (d["name"].as_str().expect("name").to_string(), d)).collect();
+    for (j, d) in plan.duties.iter().enumerate() {
+        let (pb, opening, pa, closing) = match duties.get(&d.name) {
+            Some(r) => (
+                r["present_before"].as_bool().expect("bool"),
+                num(&r["opening"]),
+                r["present_after"].as_bool().expect("bool"),
+                num(&r["closing"]),
+            ),
+            // A registry duty absent before and after has no frozen row: canonical (false, 0).
+            None => (false, 0, false, 0),
+        };
+        let checks = [
+            (SlotKind::PreDutyPresent { index: j }, bool_fe(pb), "pre.present"),
+            (SlotKind::PreDutyAmount { index: j }, uint_fe(opening), "pre.amount (opening)"),
+            (SlotKind::PostDutyPresent { index: j }, bool_fe(pa), "post.present"),
+            (SlotKind::PostDutyAmount { index: j }, uint_fe(closing), "post.amount (closing)"),
+        ];
+        for (kind, want, what) in checks {
+            if slot_fields(rel, public, kind) != Some(want) {
+                diffs.push(format!("duty {} {what} differs from the frozen block", d.name));
+            }
+        }
+    }
+    for name in duties.keys() {
+        if plan.duty_index(name).is_none() {
+            outside.push(format!("duty {name} (unregistered; not representable, F-05)"));
+        }
+    }
+    for (k, shape) in plan.effects.iter().enumerate() {
+        if let EffectShape::Liability { name, .. } = shape {
+            match effects.get(k) {
+                Some(Effect::Liability { name: n, before, after, .. }) if n == name => {
+                    let b = slot_fields(rel, public, SlotKind::Effect { index: k, role: EffectRole::DutyBefore });
+                    let a = slot_fields(rel, public, SlotKind::Effect { index: k, role: EffectRole::DutyAfter });
+                    if b != Some(uint_fe(before.0)) || a != Some(uint_fe(after.0)) {
+                        diffs.push(format!("effect {k} liability {name} before/after slots differ from the frozen effect"));
+                    }
+                }
+                _ => diffs.push(format!("effect {k}: frozen effect is not liability {name}")),
+            }
+        }
+    }
+    (diffs, outside)
+}
