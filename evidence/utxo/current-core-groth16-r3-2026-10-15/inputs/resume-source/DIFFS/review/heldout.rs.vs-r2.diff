+#[test]
+fn hw_traceability() {
+    // Every frozen HW-01..26 proposal has exactly one typed traceability entry (v2, machine
+    // row references). This test checks only the table's form, so every HW entry is an OPEN
+    // row carrying its class: whether the referenced rows ran and passed is decided after
+    // the run by resolving each {table, row} against the printed rows (operator-proposals/
+    // libtest_rows.py), never by this table.
+    const CLASSES: [&str; 7] =
+        ["RELATION-EXECUTED", "RELATION-PARTIAL", "ENCODER-ONLY", "CORE-AND-PREMISE", "TARGET-GAP", "STRUCTURAL-SOURCE", "NOT-APPLICABLE"];
+    const TABLES: [&str; 13] = [
+        "heldout", "hostile", "mutations", "addendum2", "static", "addendum3", "addendum4", "accounting", "grossfees", "rejected", "hw25", "hwtrace",
+        "probe",
+    ];
+    let frozen: Vec<String> =
+        json(VECTORS)["hostile_witness_proposals"].as_array().expect("hostile_witness_proposals").iter().map(|h| h["id"].as_str().unwrap().to_string()).collect();
+    let trace = json(HW_TRACE);
+    let entries = trace["entries"].as_array().expect("entries");
+    let ids: Vec<String> = entries.iter().map(|e| e["id"].as_str().unwrap_or("").to_string()).collect();
+    let mut t = Table::new("hwtrace");
+    t.check("ids", ids == frozen, "TRACE-FORM", format!("{} entries vs {} frozen proposals, same order", ids.len(), frozen.len()));
+    let mut malformed = Vec::new();
+    for e in entries {
+        let id = e["id"].as_str().unwrap_or("?");
+        let class = e["class"].as_str().unwrap_or("?");
+        let refs: Vec<String> = e["refs"]
+            .as_array()
+            .map(|a| {
+                a.iter()
+                    .map(|r| match (r["table"].as_str(), r["row"].as_str()) {
+                        (Some(tb), Some(row)) if TABLES.contains(&tb) && !row.is_empty() => format!("{tb}/{row}"),
+                        _ => "MALFORMED".to_string(),
+                    })
+                    .collect()
+            })
+            .unwrap_or_else(|| vec!["MALFORMED".to_string()]);
+        let e4: Vec<&str> = e["e4"].as_array().map(|a| a.iter().filter_map(Json::as_str).collect()).unwrap_or_default();
+        let reason = e["reason"].as_str().unwrap_or("");
+        let well_formed = CLASSES.contains(&class)
+            && !refs.iter().any(|r| r == "MALFORMED")
+            && match class {
+                "RELATION-EXECUTED" | "RELATION-PARTIAL" | "ENCODER-ONLY" | "CORE-AND-PREMISE" => !refs.is_empty(),
+                _ => refs.is_empty() && !reason.is_empty(),
+            };
+        if !well_formed {
+            malformed.push(id.to_string());
+        }
+        t.open(id, class, format!("refs [{}] e4 [{}] | {}", refs.join(", "), e4.join(", "), reason));
+    }
+    t.check("form", malformed.is_empty(), "TRACE-FORM", format!("malformed entries: {malformed:?}"));
+    t.finish();
+}
