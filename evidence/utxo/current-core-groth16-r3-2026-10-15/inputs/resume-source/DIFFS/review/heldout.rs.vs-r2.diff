+                        pi.shape_digest.hex(),
+                        bi.program_hash.hex(),
+                        bi.shape_digest.hex()
+                    ),
+                );
+                let proposal = mori_core::simulate(&core_program("H1-settle-usdy"), "settle", &scenario)
+                    .map_err(|e| format!("Core refused H1': {e}"))
+                    .and_then(|exe| values_from(&prime, &scenario, &exe.pre, &exe.post, &exe.effects, None).map_err(|e| format!("not encodable: {e}")))
+                    .and_then(|vals| prime.assignment::<Fr>(vals).map_err(|e| format!("not encodable: {e}")));
+                match proposal {
+                    Ok(a) => {
+                        t.expect("HW-14-r3/control", &check_assignment(&prime, a.clone(), Tamper::none()), "SAT", " (AUTH: H1' honest under H1')");
+                        t.expect("HW-14-r3", &check_assignment(&base, a, Tamper::none()), "UNSAT", " (AUTH: H1' public vector under the H1 relation)");
+                    }
+                    Err(e) => t.check("HW-14-r3", false, "NOT-ENCODABLE", e),
+                }
+            }
+            Err(e) => t.check("HW-14-r3", false, "COMPILE-REFUSED", e.to_string()),
+        }
+    }
+
+    // HW-15-r3: a close-shaped witness under the settle circuit (refused before synthesis).
+    {
+        let settle = plain("H1-settle", "settle", false).expect("H1 settle compiles");
+        let close = plain("H1-settle", "close", false).expect("H1 close compiles");
+        match honest_assignment(&close, &vector("H1-P3"), None) {
+            Ok(a) => t.expect(
+                "HW-15-r3",
+                &check_assignment(&settle, a, Tamper::none()),
+                "ASSIGNMENT-SHAPE",
+                " (AUTH: refused before the constraint system, not relation evidence; relation counterpart M-13/action_index)",
+            ),
+            Err(e) => t.check("HW-15-r3", false, "NOT-ENCODABLE", e),
+        }
+    }
+
+    // HW-18-r3: claim W = 35 instead of 36 on the W-1 capped relation.
+    {
+        let v = vector("W-1");
+        let cap = cap_of(&v);
+        let rel = plain("H1-settle", "settle", cap.is_some()).expect("H1 settle (PublicCap) compiles");
+        match (honest_assignment(&rel, &v, cap), slot_offset_by_label(&rel, "header.logical_work")) {
+            (Ok(mut a), Some(offset)) => {
+                a.public[offset] = Fr::from(35u64);
+                t.expect("HW-18-r3", &check_assignment(&rel, a, Tamper::none()), "UNSAT", " (AUTH: W is a bound header constant)");
+            }
+            (Err(e), _) => t.check("HW-18-r3", false, "NOT-ENCODABLE", e),
+            (_, None) => t.check("HW-18-r3", false, "LAYOUT", "no slot header.logical_work".into()),
+        }
+    }
+
+    // HW-23-r3/H6-B1: Bool input p of beq.
+    {
+        let rel = plain("H6-bounds", "beq", false).expect("H6 beq compiles");
+        let index = rel.plan().inputs.iter().position(|i| i.name == "p").expect("input p");
+        match (honest_assignment(&rel, &vector("H6-B1"), None), slot_offset(&rel, SlotKind::Input { index })) {
+            (Ok(honest), Some((offset, 1))) => {
+                t.expect("HW-23-r3/H6-B1/control", &check_assignment(&rel, honest.clone(), Tamper::none()), "SAT", " (AUTH control)");
+                let mut two = honest.clone();
+                two.public[offset] = Fr::from(2u64);
+                let deep = check_assignment_deep(&rel, two.clone(), Tamper::none());
+                t.expect("HW-23-r3/H6-B1/two", &deep.outcome, "UNSAT", &format!(" (AUTH; public field only; {})", deep.detail()));
+                let mut minus_one = honest;
+                minus_one.public[offset] = -Fr::from(1u64);
+                t.expect("HW-23-r3/H6-B1/minus-one", &check_assignment(&rel, minus_one, Tamper::none()), "UNSAT", " (AUTH; p - 1 as true)");
+                let wire = check_assignment_deep(&rel, two, Tamper::none().set("entry/input0#0", Fr::from(2u64)));
+                t.check(
+                    "HW-23-r3/H6-B1/wire-two",
+                    wire.refused_at_entry_constraint_zero() && wire.overrides_used == 1,
+                    wire.outcome.class(),
+                    format!("{} (AUTH expected: UNSAT at constraint 0, the booleanity of input 0, with 1 override)", wire.detail()),
+                );
+            }
+            (Err(e), _) => t.check("HW-23-r3/H6-B1/control", false, "NOT-ENCODABLE", e),
+            (_, other) => t.check("HW-23-r3/H6-B1/control", false, "LAYOUT", format!("input p slot {other:?} is not one Bool field")),
+        }
+    }
+
+    // HW-26-r3: exchange the buyer and seller USDX pre-cell slots (unsorted rows).
+    {
+        let rel = plain("H1-settle", "settle", false).expect("H1 settle compiles");
+        let slot = |label: &str| rel.layout().slot(label).map(|s| (s.offset, s.encoding.width()));
+        match (honest_assignment(&rel, &vector("H1-P1"), None), slot("pre.cell.USDX.buyer"), slot("pre.cell.USDX.seller")) {
+            (Ok(mut a), Some((buyer, 2)), Some((seller, 2))) => {
+                let distinct = a.public[buyer..buyer + 2] != a.public[seller..seller + 2];
+                swap_slots(&mut a.public, buyer, seller, 2);
+                let outcome = check_assignment(&rel, a, Tamper::none());
+                t.check(
+                    "HW-26-r3/unsorted",
+                    distinct && matches!(outcome, Outcome::Unsat),
+                    outcome.class(),
+                    format!("{} (AUTH expected UNSAT; slots distinct before the swap = {distinct})", outcome.detail()),
+                );
+            }
+            (Err(e), _, _) => t.check("HW-26-r3/unsorted", false, "NOT-ENCODABLE", e),
+            (_, b, s) => t.check("HW-26-r3/unsorted", false, "LAYOUT", format!("buyer {b:?} seller {s:?} are not UInt slots")),
+        }
+        t.open("HW-26-r3/padding", "NOT-APPLICABLE", "DirectFieldV0 has no padding rows; open for any padded ABI mapping, never a pass".into());
+    }
+    t.finish();
+}
