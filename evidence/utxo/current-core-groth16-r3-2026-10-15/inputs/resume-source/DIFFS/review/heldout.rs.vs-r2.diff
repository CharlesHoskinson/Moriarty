+fn gross_rows(rel: &CompiledRelation, public: &[Fr], frozen: &Json) -> (Vec<String>, Vec<String>) {
+    let plan = rel.plan();
+    let mut diffs = Vec::new();
+    let mut notes = Vec::new();
+    let rows: BTreeMap<(AssetId, String), &Json> = frozen["balances"]
+        .as_array()
+        .expect("frozen balances")
+        .iter()
+        .map(|r| ((frozen_asset(&r["asset"]), r["account"].as_str().expect("account").to_string()), r))
+        .collect();
+    for &cell in &plan.debit_cells {
+        let c = &plan.cells[cell];
+        let Some(row) = rows.get(&(c.asset.clone(), c.account.clone())) else {
+            diffs.push(format!("debit cell {}/{} has no frozen row", c.asset_name, c.account));
+            continue;
+        };
+        let gross = slot_fields(rel, public, SlotKind::GrossDebit { cell });
+        let fees = slot_fields(rel, public, SlotKind::FeesPaid { cell });
+        if gross != Some(wide_fe(num(&row["gross_debit"]))) {
+            diffs.push(format!("gross_debit {}/{}: public slot differs from frozen {}", c.asset_name, c.account, row["gross_debit"]));
+        }
+        if fees != Some(wide_fe(num(&row["fees_paid"]))) {
+            diffs.push(format!("fees_paid {}/{}: public slot differs from frozen {}", c.asset_name, c.account, row["fees_paid"]));
+        }
+    }
+    for ((asset, account), row) in &rows {
+        if !plan.debit_cells.iter().any(|&i| plan.cells[i].asset == *asset && plan.cells[i].account == *account) {
+            if row["gross_debit"].as_str() != Some("0") || row["fees_paid"].as_str() != Some("0") {
+                diffs.push(format!("frozen debit on {}/{account} has no accounting slot", asset.reference));
+            } else {
+                notes.push(format!("{}/{account}: no slot, frozen 0", asset.reference));
+            }
+        }
+    }
+    (diffs, notes)
+}
+
+fn gross_and_fee_rows(t: &mut Table, id: &str, rel: &CompiledRelation, v: &Json, cap: Option<UInt>) {
+    let frozen = &v["expected"]["accounting"];
+    let honest = match honest_assignment(rel, v, cap) {
+        Ok(a) => a,
+        Err(e) => {
+            t.check(id, false, "NOT-ENCODABLE", e);
+            return;
+        }
+    };
+    t.expect(id, &check_assignment(rel, honest.clone(), Tamper::none()), "SAT", " (AUTH: GrossDebitAndFees relation on frozen records)");
+    let (diffs, notes) = gross_rows(rel, &honest.public, frozen);
+    t.check(
+        &format!("{id}/sums"),
+        diffs.is_empty(),
+        "BOUND-SUMS",
+        if diffs.is_empty() { format!("{} debit cell(s) equal frozen gross_debit/fees_paid; {}", rel.plan().debit_cells.len(), notes.join("; ")) } else { diffs.join("; ") },
+    );
+    for &cell in &rel.plan().debit_cells {
+        let c = &rel.plan().cells[cell];
+        for (kind, what) in [(SlotKind::GrossDebit { cell }, "gross"), (SlotKind::FeesPaid { cell }, "fees")] {
+            let row_id = format!("{id}/tamper-{what}-{}.{}", c.asset_name, c.account);
+            match slot_offset(rel, kind) {
+                Some((offset, 3)) => {
+                    let mut a = honest.clone();
+                    a.public[offset] += Fr::from(1u64);
+                    t.expect(&row_id, &check_assignment(rel, a, Tamper::none()), "UNSAT", " (AUTH: public sum + 1)");
+                }
+                other => t.check(&row_id, false, "LAYOUT", format!("slot {other:?} is not a 3-field wide sum")),
+            }
+        }
+    }
+}
