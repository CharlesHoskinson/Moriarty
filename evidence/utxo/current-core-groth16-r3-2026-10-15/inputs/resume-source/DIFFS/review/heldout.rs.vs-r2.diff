+            Ok((
+                serde_json::from_value(claim["pre"].clone()).map_err(|e| format!("pre: {e}"))?,
+                serde_json::from_value(claim["post"].clone()).map_err(|e| format!("post: {e}"))?,
+                serde_json::from_value(claim["effects"].clone()).map_err(|e| format!("effects: {e}"))?,
+            ))
+        })();
+        let outcome = match decoded {
+            Ok((pre, post, effects)) => check_records(&rel, &scenario, &pre, &post, &effects, cap),
+            Err(e) => Outcome::NotDecodable(e),
