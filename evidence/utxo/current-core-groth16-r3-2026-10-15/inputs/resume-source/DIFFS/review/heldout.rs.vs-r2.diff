+
+impl Outcome {
+    fn class(&self) -> &'static str {
+        match self {
+            Self::Sat => "SAT",
+            Self::Unsat => "UNSAT",
+            Self::NotEncodable(_) => "NOT-ENCODABLE",
+            Self::NotDecodable(_) => "NOT-DECODABLE",
+            Self::AssignmentShape(_) => "ASSIGNMENT-SHAPE",
+            Self::CircuitError(_) => "CIRCUIT-ERROR",
