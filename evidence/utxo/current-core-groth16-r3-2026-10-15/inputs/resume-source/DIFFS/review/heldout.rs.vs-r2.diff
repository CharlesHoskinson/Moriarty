+/// Addendum 4 S-9/states: H3 + 200 UInt states + an action of 400 `requires true`.
+/// 203 trace records * 402 = 81,606 > 65,536 within Core's declaration and statement bounds.
+fn s9_states_program() -> Program {
+    let mut p = h3_program();
+    for i in 0..200 {
+        p.states.push(mori_core::StateDecl { name: format!("s9s{i:03}"), ty: mori_core::Type::UInt, initial: mori_core::Value::UInt(UInt(0)) });
+    }
+    let t = u16::try_from(p.expressions.len()).expect("expression id fits u16");
+    p.expressions.push(mori_core::Expr::Literal { value: mori_core::Value::Bool(true) });
+    p.actions.push(mori_core::Action { name: "s9states".into(), inputs: Vec::new(), statements: vec![mori_core::Statement::Requires { predicate: t }; 400] });
+    p
+}
