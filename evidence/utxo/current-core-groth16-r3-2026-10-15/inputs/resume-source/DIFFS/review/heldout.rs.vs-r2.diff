+/// Addendum 4 S-9/duties: H3 + 1025 source Liability statements over two actions (registry
+/// 1026 duties > 1,024) + a one-statement action whose trace product stays under the cap.
+fn s9_duties_program() -> Program {
+    let mut p = h3_program();
+    let one = u16::try_from(p.expressions.len()).expect("expression id fits u16");
+    p.expressions.push(mori_core::Expr::Literal { value: mori_core::Value::UInt(UInt(1)) });
+    let t = one + 1;
+    p.expressions.push(mori_core::Expr::Literal { value: mori_core::Value::Bool(true) });
+    let duty = |i: usize| mori_core::Statement::Liability {
+        name: format!("s9d{i:04}"),
+        asset: "T".into(),
+        debtor: "p".into(),
+        creditor: "q".into(),
+        amount: one,
+    };
+    p.actions.push(mori_core::Action { name: "s9dutiesa".into(), inputs: Vec::new(), statements: (0..513).map(&duty).collect() });
+    p.actions.push(mori_core::Action { name: "s9dutiesb".into(), inputs: Vec::new(), statements: (513..1025).map(&duty).collect() });
+    p.actions.push(mori_core::Action { name: "s9dutiesc".into(), inputs: Vec::new(), statements: vec![mori_core::Statement::Requires { predicate: t }] });
+    p
 }
 
