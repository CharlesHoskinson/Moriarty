+/// One checked assignment with the facts needed to say WHICH constraint refused:
+/// tamper hits and arkworks' first unsatisfied constraint index (`which_is_unsatisfied`,
+/// a decimal index when no ConstraintLayer trace is installed), plus the size of the
+/// "entry" region, which synthesis records first (circuit.rs).
+struct Deep {
+    outcome: Outcome,
+    overrides_used: usize,
+    first_unsatisfied: Option<String>,
+    entry_constraints: Option<usize>,
+}
+
+impl Deep {
+    fn detail(&self) -> String {
+        format!(
+            "{}; overrides_used={} first_unsatisfied={:?} entry_region_constraints={:?}",
+            self.outcome.detail(),
+            self.overrides_used,
+            self.first_unsatisfied,
+            self.entry_constraints
+        )
+    }
+    /// UNSAT at the first constraint of the entry region (booleanity of input 0).
+    fn refused_at_entry_constraint_zero(&self) -> bool {
+        matches!(self.outcome, Outcome::Unsat)
+            && self.first_unsatisfied.as_deref() == Some("0")
+            && self.entry_constraints.is_some_and(|n| n > 0)
+    }
+}
+
+fn check_assignment_deep(rel: &CompiledRelation, assignment: Assignment<Fr>, tamper: Tamper<Fr>) -> Deep {
+    let failed = |outcome: Outcome| Deep { outcome, overrides_used: 0, first_unsatisfied: None, entry_constraints: None };
+    let circuit = match rel.circuit(Some(assignment), tamper) {
+        Ok(c) => c,
+        Err(CompileError::AssignmentShape(m)) => return failed(Outcome::AssignmentShape(m)),
+        Err(e) => return failed(Outcome::CircuitError(format!("circuit: {e}"))),
+    };
+    let cs = ConstraintSystem::<Fr>::new_ref();
+    let report = match circuit.synthesize_into(cs.clone()) {
+        Ok(r) => r,
+        Err(e) => return failed(Outcome::CircuitError(format!("synthesis: {e}"))),
+    };
+    let entry_constraints = report.regions.first().filter(|r| r.label == "entry").map(|r| r.constraints);
+    let (outcome, first_unsatisfied) = match cs.which_is_unsatisfied() {
+        Ok(None) => (Outcome::Sat, None),
+        Ok(Some(index)) => (Outcome::Unsat, Some(index)),
+        Err(e) => (Outcome::CircuitError(format!("which_is_unsatisfied: {e}")), None),
+    };
+    Deep { outcome, overrides_used: report.overrides_used, first_unsatisfied, entry_constraints }
 }
 
