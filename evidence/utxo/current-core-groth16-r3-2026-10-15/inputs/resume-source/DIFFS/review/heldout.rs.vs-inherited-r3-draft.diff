+                let wire = check_assignment_deep(&rel, two, Tamper::none().set("entry/input0#0", Fr::from(2u64)));
+                t.check(
+                    "HW-23-r3/H6-B1/wire-two",
+                    wire.refused_at_entry_constraint_zero() && wire.overrides_used == 1,
+                    wire.outcome.class(),
+                    format!("{} (AUTH expected: UNSAT at constraint 0, the booleanity of input 0, with 1 override)", wire.detail()),
+                );
+            }
+            (Err(e), _) => t.check("HW-23-r3/H6-B1/control", false, "NOT-ENCODABLE", e),
+            (_, other) => t.check("HW-23-r3/H6-B1/control", false, "LAYOUT", format!("input p slot {other:?} is not one Bool field")),
+        }
+    }
+
+    // HW-26-r3: exchange the buyer and seller USDX pre-cell slots (unsorted rows).
+    {
+        let rel = plain("H1-settle", "settle", false).expect("H1 settle compiles");
+        let slot = |label: &str| rel.layout().slot(label).map(|s| (s.offset, s.encoding.width()));
+        match (honest_assignment(&rel, &vector("H1-P1"), None), slot("pre.cell.USDX.buyer"), slot("pre.cell.USDX.seller")) {
+            (Ok(mut a), Some((buyer, 2)), Some((seller, 2))) => {
+                let distinct = a.public[buyer..buyer + 2] != a.public[seller..seller + 2];
+                swap_slots(&mut a.public, buyer, seller, 2);
+                let outcome = check_assignment(&rel, a, Tamper::none());
+                t.check(
+                    "HW-26-r3/unsorted",
+                    distinct && matches!(outcome, Outcome::Unsat),
+                    outcome.class(),
+                    format!("{} (AUTH expected UNSAT; slots distinct before the swap = {distinct})", outcome.detail()),
+                );
+            }
+            (Err(e), _, _) => t.check("HW-26-r3/unsorted", false, "NOT-ENCODABLE", e),
+            (_, b, s) => t.check("HW-26-r3/unsorted", false, "LAYOUT", format!("buyer {b:?} seller {s:?} are not UInt slots")),
+        }
+        t.open("HW-26-r3/padding", "NOT-APPLICABLE", "DirectFieldV0 has no padding rows; open for any padded ABI mapping, never a pass".into());
+    }
+    t.finish();
+}
