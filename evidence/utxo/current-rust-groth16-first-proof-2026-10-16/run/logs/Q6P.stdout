probe-start mode=Q6P
record mode=Q6P
record uid=1000
record cap CapInh=0000000000000000
record cap CapPrm=0000000000000000
record cap CapEff=0000000000000000
record cap CapBnd=0000000000000000
record cap CapAmb=0000000000000000
record status NoNewPrivs=1
record status Seccomp=0
record ns user view=user:[4026532381] host=user:[4026531837]
record ns pid view=pid:[4026532400] host=pid:[4026532221]
record ns net view=net:[4026532401] host=net:[4026531833]
record ns ipc view=ipc:[4026532379] host=ipc:[4026532208]
record ns uts view=uts:[4026532378] host=uts:[4026532220]
record netdev interfaces=1 name=lo
record absent path=/home
record absent path=/root
record absent path=/run
record absent path=/var
record absent path=/etc/alternatives
record absent path=/nonexistent
record root entries=bin dev etc lib lib64 proc task tmp usr 
record etc entries=ld.so.cache 
record task entries=bin in keys-ro out stage 
record bin entries=mori-k2 type=regular executable=1 setid=0
record in entries=K4H-GOLD.json conditional-reserve.mori installment-invoice.mori invoice-partial.request.json invoice-partial.selector.json invoice-partial.setup.json 
record out entries=empty
record stage entries=empty
record mount point=/usr options=ro,nosuid,nodev,relatime
record mount point=/bin options=ro,nosuid,nodev,relatime
record mount point=/lib options=ro,nosuid,nodev,relatime
record mount point=/lib64 options=ro,nosuid,nodev,relatime
record mount point=/task/bin options=ro,nosuid,nodev,relatime
record mount point=/task/in options=ro,nosuid,nodev,relatime
record mount point=/task/stage options=ro,nosuid,nodev,relatime
record mount point=/task/keys-ro options=ro,nosuid,nodev,relatime
record mount point=/task/out options=rw,nosuid,nodev,relatime
record mount point=/tmp fstype=tmpfs
record dev path=/dev/null type=char read=never
record dev path=/dev/urandom type=char read=never
record dev path=/dev/random type=char read=never
record fd stdin=/dev/null
record fdlist child=0,1,2,3
record env HOME=/nonexistent
record env PATH=/usr/bin:/bin
record env PWD=/task
record env SHLVL=1
