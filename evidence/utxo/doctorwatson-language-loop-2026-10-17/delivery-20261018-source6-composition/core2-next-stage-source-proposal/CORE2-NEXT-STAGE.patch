+ 'balances':[{'account':a,'asset':deepcopy(A),'amount':str(n)} for a,n in zip(['alice','bob','escrow','observer'],amounts)],
+ 'liabilities':deepcopy(liabilities)}
+initial=snap([20,2,3,9],[])
