---
source: crates/mori-fmt/src/tests.rs
description: "Code:\n\n// The invoice agreement.\nprofile \"moriarty-beta/1\"; // the only profile\nagreement Invoice { // body follows\n  // Prices.\n  const price = 10.00 /* list */ USD;\n  const fee = 0.10 USD; // flat fee\n  account alice = {\n    domain: Preview, // home domain\n    id: \"alice\",\n    // more fields later\n  };\n  /* trailing note */\n}\n// after the agreement\n"
---
// The invoice agreement.
profile "moriarty-beta/1"; // the only profile

agreement Invoice { // body follows
  // Prices.
  const price = 10.00 /* list */ USD;

  const fee = 0.10 USD; // flat fee

  account alice = {
    domain: Preview, // home domain
    id: "alice",
    // more fields later
  };
  /* trailing note */
}
// after the agreement
