    {
      "versionedId": "MCP-PLN-01@1",
      "statementSchema": {
        "encoding": "typed field list (moriarty-statement-fields/1); the byte encoding into Plutus Data / scalars is not fixed by v1",
        "fields": [
          {
            "name": "domain_tag",
            "type": "Bytes",
            "role": "domain-tag",
            "source": "circuit-constant"
          },
          {
            "name": "predicate_digest",
            "type": "Bytes32",
            "digest_of": "predicate_digest",
            "source": "circuit-constant",
            "note": "per-row predicate digest of this SemanticEntry; never a whole-catalogue digest"
          },
          {
            "name": "template_digest",
            "type": "Bytes32",
            "digest_of": "template_digest",
            "source": "circuit-constant"
          },
          {
            "name": "network_label",
            "type": "Bytes",
            "role": "network-label-asserted",
            "source": "statement-public"
          },
          {
            "name": "tx_id",
            "type": "TxId",
            "tx_relation": "historical-other-tx",
            "source": "statement-public",
            "note": "id of a past transaction whose bytes are the witness; never the carrying transaction (MCP-REF-09)"
          },
          {
            "name": "output_index",
            "type": "Int",
            "index_of": "historical-tx-output",
            "min": "0",
            "max": "65535",
            "source": "circuit-constant"
          },
          {
            "name": "payment_key_hash",
            "type": "Bytes28",
            "role": "payment-key-hash",
            "source": "statement-public"
          },
          {
            "name": "threshold_lovelace",
            "type": "Int",
            "role": "amount",
            "min": "0",
            "max": "9223372036854775807",
            "source": "statement-public"
          }
        ],
        "binding_constraints": [
          {
            "id": "PL0-C1-constants",
            "fields": [
              "domain_tag",
              "predicate_digest",
              "template_digest",
              "output_index"
            ],
            "constraint": "relation fixes these values; they enter the statement digest preimage"
          },
          {
            "id": "PL0-C2-txid",
            "fields": [
              "tx_id"
            ],
            "constraint": "BLAKE2b-256(B) == tx_id for witness bytes B"
          },
          {
            "id": "PL0-C3-template",
            "fields": [
              "template_digest",
              "output_index"
            ],
            "constraint": "B matches the fixed template identified by template_digest; the payment output is output_index"
          },
          {
            "id": "PL0-C4-address",
            "fields": [
              "payment_key_hash",
              "output_index"
            ],
            "constraint": "output[output_index] address payment part is key hash payment_key_hash"
          },
          {
            "id": "PL0-C5-coin",
            "fields": [
              "threshold_lovelace",
              "output_index"
            ],
            "constraint": "coin(output[output_index]) >= threshold_lovelace"
          },
          {
            "id": "PL0-C6-label",
            "fields": [
              "network_label"
            ],
            "constraint": "label enters the statement digest only; asserted, not checked against B (body key 15 absent)"
          }
        ],
        "note": "Catalogue-normative statement type. Correspondence to the G16 circuit's actual public-input layout is NOT established; an AdmissionRecord must map every constraint id to a relation locator and the audit must review it."
      }
    },
