+profile "moriarty-financial-agreement-source/6";
+agreement MaxRebatePayout {
+domain Midnight;
+settlement A scale 2;
+selected TransferLiteralFee source_hash "rebate-source" digest "rebate-policy";
+intent {
+signer Owner key "rebate-key";
+nonce "rebate-nonce";
+pre_head "m0";
+valid 2..12;
+gross_cap 850;
+fee_cap 25;
+net_floor 800;
+failure success_only;
+signed_action transfer from Owner to Recipient fee_to Fee value 800 fee 25;
+observations empty;
+disclosures empty;
+retained_effects empty;
+retained_duties empty;
+delegation none;
+recovery none;
+}
+authenticated {
+head "m0";
+predecessor "rebate-opening";
+round 4;
+balance Owner 2000;
+balance Recipient 5;
+balance Fee 7;
+allowance Owner remaining 2000 spent 25;
+replay unused;
+work_remaining 12;
+work_spent 2;
+}
+submit transfer from Owner to Recipient fee_to Fee value 800 fee 25;
+effects {
+debit Owner 825;
+credit Recipient 800;
+credit Fee 25;
+use_allowance Owner 825;
+use_replay "rebate-nonce";
+advance_head "m0" "m1";
+}
+post_head "m1";
+}
