+#[test]
+fn checked_transfer_profiles_have_complete_cli_contracts() {
+    let files = Files::new();
+    fs::write(files.0.join("max-rebate.mori"), fixture!("max-rebate.mori")).unwrap();
+    fs::write(
+        files.0.join("max-rebate.scenario.json"),
+        fixture!("max-rebate.scenario.json"),
+    )
+    .unwrap();
+
+    for (source, action, scenario, expected_check, expected_source6) in [
+        (
+            "invoice.mori",
+            "pay",
+            "scenario.json",
+            fixture!("invoice.check.stdout.json"),
+            fixture!("invoice.source6"),
+        ),
+        (
+            "max-rebate.mori",
+            "pay_rebate",
+            "max-rebate.scenario.json",
+            fixture!("max-rebate.check.stdout.json"),
+            fixture!("max-rebate.source6"),
+        ),
+    ] {
+        let checked = files.invoke(&["check", source, "--json"]);
+        assert_eq!(checked.status.code(), Some(0), "check {source}");
+        assert_eq!(checked.stdout.as_slice(), expected_check, "check {source}");
+        assert!(
+            checked.stderr.is_empty(),
+            "check {source}: {:?}",
+            checked.stderr
+        );
+
+        // Beta reports identify the source agreement/action; Source/6 is the
+        // emitted proposal profile, rather than the checked input language.
+        let report: Value = serde_json::from_slice(&checked.stdout).unwrap();
+        assert!(report.get("language").is_none());
+        assert_eq!(report["actions"][0]["name"], action);
+        assert_eq!(report["actions"][0]["support"], "local_s0");
+
+        let arguments = [
+            "expand",
+            source,
+            "--action",
+            action,
+            "--scenario",
+            scenario,
+            "--emit-source6-transfer",
+        ];
+        let expanded = files.invoke(&arguments);
+        assert_eq!(expanded.status.code(), Some(0), "expand {source}");
+        assert_eq!(
+            expanded.stdout.as_slice(),
+            expected_source6,
+            "expand {source}"
+        );
+        assert_eq!(expanded.stderr.as_slice(), fixture!("source6.stderr.txt"));
+        assert!(expanded.stdout.starts_with(
+            b"profile \"moriarty-financial-agreement-source/6\";\n"
+        ));
+
+        let mut quiet_arguments = vec!["--quiet"];
+        quiet_arguments.extend(arguments);
+        let quiet = files.invoke(&quiet_arguments);
+        assert_eq!(quiet.status.code(), Some(0), "quiet expand {source}");
+        assert_eq!(
+            quiet.stdout.as_slice(),
+            expected_source6,
+            "quiet expand {source}"
+        );
+        assert!(quiet.stderr.is_empty(), "quiet expand {source}");
+    }
+}
