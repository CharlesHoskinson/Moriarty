  "program": "// Ordinary local Core/1 partial release. Account labels and supplied state\n// are local premises; no ledger custody or authority is asserted.\nlanguage \"moriarty/1\";\nagreement PartialEscrowRelease {\n  asset CASH = { network: \"local\", issuer: \"escrow-partial-example\", reference: \"CASH\", scale: 0 };\n  asset BONUS = { network: \"local\", issuer: \"escrow-partial-example\", reference: \"BONUS\", scale: 0 };\n  state paid: UInt = 0;\n  state fees: UInt = 0;\n  state marker: UInt = 77;\n  state epoch: UInt = 0;\n\n  action release(payout: UInt, processingFee: UInt) {\n    requires payout > 0;\n    requires payout <= 50;\n    requires processingFee == 3;\n    let priorPaid = paid;\n    transfer(CASH, \"escrow\", \"merchant\", payout);\n    fee(CASH, \"escrow\", \"treasury\", processingFee);\n    discharge(\"merchant-due\", payout);\n    next paid = priorPaid + payout;\n    next fees = fees + processingFee;\n    ensures paid == priorPaid + payout;\n    emit \"released\"(payout);\n  }\n}\n",
