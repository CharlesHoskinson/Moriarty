{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mori-shared-check-core-integration-review/1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "reviewer",
    "head",
    "tree",
    "base",
    "coverage",
    "sourceChecks",
    "resultChecks",
    "findings",
    "sourceDisposition",
    "resultDisposition",
    "unrunOrUnread",
    "retainedOpenRequirements",
    "reviewToken"
  ],
  "properties": {
    "format": {
      "const": "mori-shared-check-core-integration-review/1"
    },
    "reviewer": {
      "type": "object",
      "required": [
        "requestedModel",
        "returnedModel",
        "effort",
        "authorOfCandidate",
        "independent",
        "terminalStatus"
      ],
      "properties": {
        "requestedModel": {
          "type": "string"
        },
        "returnedModel": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "authorOfCandidate": {
          "const": false
        },
        "independent": {
          "type": "boolean"
        },
        "terminalStatus": {
          "enum": [
            "completed",
            "partial",
            "unavailable",
            "refused",
            "failed"
          ]
        }
      }
    },
    "head": {
      "const": "ca95950817a68277d46308570f22e40dbf6796c9"
    },
    "tree": {
      "const": "423da55aa235facdc33e778092f6306c3dd110a9"
    },
    "base": {
      "const": "049395532c43b17c54bdbc5a529535b521dc56df"
    },
    "coverage": {
      "type": "object",
      "minProperties": 21,
      "maxProperties": 21,
      "propertyNames": {
        "enum": [
          "crates/fixtures/check-source/cases.json",
          "crates/fixtures/check-source/cases/accepted.mori",
          "crates/fixtures/check-source/cases/core1-accepted.mori",
          "crates/fixtures/check-source/cases/core1-rejected.mori",
          "crates/fixtures/check-source/cases/core2-accepted.mori",
          "crates/fixtures/check-source/cases/core2-rejected.mori",
          "crates/fixtures/check-source/cases/rejected.mori",
          "crates/fixtures/check-source/cases/unicode-byte-offsets.mori",
          "crates/fixtures/check-source/cases/unparsable.mori",
          "crates/fixtures/check-source/expected/accepted.stdout",
          "crates/fixtures/check-source/expected/core1-accepted.stdout",
          "crates/fixtures/check-source/expected/core1-rejected.stdout",
          "crates/fixtures/check-source/expected/core2-accepted.stdout",
          "crates/fixtures/check-source/expected/core2-rejected.stdout",
          "crates/fixtures/check-source/expected/rejected.stdout",
          "crates/fixtures/check-source/expected/unicode-byte-offsets.stdout",
          "crates/fixtures/check-source/expected/unparsable.stdout",
          "crates/mori/src/commands/check.rs",
          "crates/mori/src/commands/check_source.rs",
          "crates/mori/src/commands/mod.rs",
          "crates/mori/tests/check_source_dispatch.rs"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "sourceChecks": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "propertyNames": {
        "enum": [
          "public-consumer",
          "profiles-and-checkers",
          "beta-json-bytes",
          "human-laziness-and-order",
          "core-report-and-qualification",
          "exit-and-diagnostics",
          "public-regression-and-oracle",
          "scope-and-guidelines",
          "evidence-boundaries",
          "approved-capability-integration",
          "approved-core-integration"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/assessment"
      }
    },
    "resultChecks": {
      "type": "object",
      "minProperties": 14,
      "maxProperties": 14,
      "propertyNames": {
        "enum": [
          "accepted",
          "rejected",
          "unparsable",
          "core1-accepted",
          "core1-rejected",
          "core2-accepted",
          "core2-rejected",
          "unicode-byte-offsets",
          "capabilities-query",
          "capabilities-profile-consumers",
          "invoice-complete-core-wire",
          "reserve-complete-core-wire",
          "program-plan-continuation-roundtrip",
          "utxo-complete-prefix-outcome"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/assessment"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "axis",
          "severity",
          "predicate",
          "quotes",
          "expected",
          "observed",
          "fixOrNextCheck"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "axis": {
            "enum": [
              "source",
              "result",
              "guideline",
              "coverage"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor",
              "note"
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 20
          },
          "quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/quote"
            }
          },
          "expected": {
            "type": "string",
            "minLength": 20
          },
          "observed": {
            "type": "string",
            "minLength": 20
          },
          "fixOrNextCheck": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "sourceDisposition": {
      "enum": [
        "accept-scoped-source",
        "changes-required",
        "partial",
        "abstain"
      ]
    },
    "resultDisposition": {
      "enum": [
        "stored-fourteen-test-eight-case-results-consistent",
        "inconsistent",
        "partial",
        "abstain"
      ]
    },
    "unrunOrUnread": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retainedOpenRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewToken": {
      "type": "string",
      "minLength": 1,
      "description": "Exact opaque review token supplied by root external prefix; root independently checks equality.",
      "const": "shared-check-core-integration-review-055ae50b32b14c259cac75aae270c5ba"
    }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "sha256",
        "exactQuote",
        "supports"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "exactQuote": {
          "type": "string",
          "minLength": 8
        },
        "supports": {
          "type": "string",
          "minLength": 20
        },
        "jsonPointer": {
          "type": "string"
        },
        "deliveryScope": {
          "enum": [
            "full",
            "excerpt",
            "lossless-byte-alias",
            "compacted-json-value"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "lineStart",
            "lineEnd"
          ]
        },
        {
          "required": [
            "jsonPointer"
          ]
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "disposition",
        "reason",
        "quotes",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "supported",
            "defect",
            "partial",
            "unassessed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 80
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sha256",
        "readScope",
        "assessment"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "readScope": {
          "enum": [
            "full",
            "partial",
            "unread"
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
