language "moriarty/2";
agreement TwoStagePartialFill {
  asset PAY = { network: "local", issuer: "partial-fill-example", reference: "PAY", scale: 0 };
  state filled: UInt = 0;
  state feesPaid: UInt = 0;
  state grossSpent: UInt = 0;
  state marker: UInt = 77;
  action fill() {
    requires filled + 4 <= 10;
    requires feesPaid + 1 <= 3;
    requires grossSpent + 5 <= 13;
    liability("delivery", PAY, "maker", "taker", 10);
    transfer(PAY, "maker", "taker", 4);
    fee(PAY, "maker", "treasury", 1);
    discharge("delivery", 4);
    next filled = filled + 4;
    next feesPaid = feesPaid + 1;
    next grossSpent = grossSpent + 5;
    await finish(ok: Bool) when ok;
    requires filled + 6 <= 10;
    requires feesPaid + 2 <= 3;
    requires grossSpent + 8 <= 13;
    transfer(PAY, "maker", "taker", 6);
    fee(PAY, "maker", "treasury", 2);
    discharge("delivery", 6);
    next filled = filled + 6;
    next feesPaid = feesPaid + 2;
    next grossSpent = grossSpent + 8;
    ensures filled == 10;
  }
  action declare() {
    liability("unrelated", PAY, "observer", "treasury", 0);
    liability("zero", PAY, "observer", "taker", 0);
  }
}
