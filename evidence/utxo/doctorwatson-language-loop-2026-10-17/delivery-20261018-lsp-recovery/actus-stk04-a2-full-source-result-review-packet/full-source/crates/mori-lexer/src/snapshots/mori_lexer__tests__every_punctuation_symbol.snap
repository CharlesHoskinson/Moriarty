---
source: crates/mori-lexer/src/tests.rs
description: "Code:\n\n{ } [ ] ( ) : ; , = < > . + - *"
---
LBrace         0..1       "{"
RBrace         2..3       "}"
LBracket       4..5       "["
RBracket       6..7       "]"
LParen         8..9       "("
RParen         10..11     ")"
Colon          12..13     ":"
Semicolon      14..15     ";"
Comma          16..17     ","
Eq             18..19     "="
Lt             20..21     "<"
Gt             22..23     ">"
Dot            24..25     "."
Plus           26..27     "+"
Minus          28..29     "-"
Star           30..31     "*"
Eof            31..31     ""
