          "expected": "reopen.report.example.json"
        },
        {
          "operation": "recover",
          "checkpoint_in": "scratch/pending.json",
          "event": "recover.event.json",
          "checkpoint_out": "scratch/closed.json",
          "expected": "recover-direct.report.example.json"
        },
        {
          "operation": "reopen",
          "checkpoint_in": "scratch/closed.json",
          "expected": "reopen-closed.report.example.json"
        }
      ]
    }
