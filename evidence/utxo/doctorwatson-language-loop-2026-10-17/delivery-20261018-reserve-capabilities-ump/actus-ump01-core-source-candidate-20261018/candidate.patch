+#[test]
+fn actus_ump01_matches_frozen_core_trace_and_seven_financial_fields() {
+    use sha2::Digest;
+
+    let expected: Value =
+        serde_json::from_str(fixture!("actus-ump01/author-provisional.json")).unwrap();
+    let source = fixture!("actus-ump01/source.mori");
+    let opening = fixture!("actus-ump01/opening.scenario.json");
+    let bindings_json = fixture!("actus-ump01/subject-bindings.json");
+    let operands_json = fixture!("actus-ump01/call-operands.json");
+    let normative_json = fixture!("actus-ump01/ump01.normative-operands.json");
+    for (name, input) in [
+        ("source.mori", source),
+        ("opening.scenario.json", opening),
+        ("subject-bindings.json", bindings_json),
+        ("call-operands.json", operands_json),
+        ("ump01.normative-operands.json", normative_json),
+    ] {
+        assert_eq!(
+            mori_core::intent::hex(&sha2::Sha256::digest(input.as_bytes())),
+            expected["input_sha256"][name].as_str().unwrap()
+        );
+    }
+    let bindings: Ump01Bindings = serde_json::from_str(bindings_json).unwrap();
+    let scenario: Scenario = serde_json::from_str(opening).unwrap();
+    let original = scenario.clone();
+    let operands: Value = serde_json::from_str(operands_json).unwrap();
+    let calls = operands["calls"].as_array().unwrap();
+    assert_eq!(calls.len(), 1);
+    assert_eq!(calls[0]["action"], expected["action"]);
+    assert_eq!(serde_json::to_value(&scenario.inputs).unwrap(), calls[0]["inputs"]);
+    assert_eq!(operands["language"], expected["profile"]["language"]);
+    assert_eq!(operands["semantics"], expected["profile"]["semantics"]);
+
+    let (actual, fields) = ump01_observe(source, &scenario, &bindings).unwrap();
+    assert_eq!(scenario, original);
+    assert_eq!(actual.action, expected["action"].as_str().unwrap());
+    assert_eq!(actual.semantics, expected["profile"]["semantics"].as_str().unwrap());
+    assert_eq!(serde_json::to_value(&actual.pre).unwrap(), expected["pre"]);
+    assert_eq!(serde_json::to_value(&actual.post).unwrap(), expected["post"]);
+    assert_eq!(serde_json::to_value(&actual.effects).unwrap(), expected["effects"]);
+    assert_eq!(serde_json::to_value(fields).unwrap(), expected["financial_fields"]);
+
+    let expected_steps = expected["steps"].as_array().unwrap();
+    assert_eq!(actual.steps.len(), expected_steps.len());
+    let mut prefix: Vec<Value> = Vec::new();
+    for (ordinal, (step, frozen)) in actual.steps.iter().zip(expected_steps).enumerate() {
+        assert_eq!(usize::from(step.index), ordinal);
+        assert_eq!(json!(step.index), frozen["index"]);
+        assert_eq!(serde_json::to_value(&step.value).unwrap(), frozen["value"]);
+        assert_eq!(serde_json::to_value(&step.snapshot).unwrap(), frozen["snapshot"]);
+        let delta = serde_json::to_value(&step.effects).unwrap();
+        assert_eq!(delta, frozen["effects"]);
+        prefix.extend(delta.as_array().unwrap().iter().cloned());
+        assert_eq!(json!(prefix), frozen["effect_prefix"]);
+        let mut statement = serde_json::to_value(&step.statement).unwrap();
+        let object = statement.as_object_mut().unwrap();
+        for member in frozen["statement_contract"]["wire_exprid_members_unasserted"]
+            .as_array()
+            .unwrap()
+        {
+            let id = object.remove(member.as_str().unwrap()).unwrap();
+            assert!(id.is_u64());
+        }
+        assert_eq!(statement, frozen["statement_contract"]["known_wire_members"]);
+    }
+    assert_eq!(json!(prefix), expected["effects"]);
+}
