  "ownerPrerequisitesVerbatim": [
    {
      "id": "O-ID",
      "interface_gap_or_dependency": "Requires designated-owner specification of exact canonical preimages, domain separation, serialization, and concrete digests for all four RecoveryCheckpoint/inspect bindings (base_program, base_plan, recovery_module, recovery_plan), compatibility with the adopted M03 Core2 local identity clause (F4 in B32), and version/migration refusal diagnostics.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-REG",
      "interface_gap_or_dependency": "Requires designated-owner specification of the combined base Program plus recovery-handler liability registry (extending decode::registry in B25), permitted incoming/created/discharged duty identities across forward and recovery branches, conflict detection, and checking order.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-ACCT",
      "interface_gap_or_dependency": "Requires designated-owner specification of combined account and asset boundary coverage across base actions and recovery handlers (extending decode::canonical_boundary balance checks in B25), preserved untouched/observer rows, custody versus funded reserve assumptions, and missing/extra row refusal policy.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-TRACE",
      "interface_gap_or_dependency": "Requires designated-owner specification of concrete numerical bounds and resource envelopes for paired sources, handler arenas, JSON decoding, cumulative history arrays, ordered_effects, and combined trace snapshot cells (extending MAX_TRACE_CELLS in B21/B25) without silent truncation or unauthorized budget expansion.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-CAP",
      "interface_gap_or_dependency": "Requires designated-owner specification of paired ceiling preflight (using successful_path_ceiling=13 rather than normal forward_total=11 in the compensation case), committed_cap storage/override/editability rules, lifetime/service attempt budget limits relative to attempted_total T, recovery reserves, and refusal precedence.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-PEND",
      "interface_gap_or_dependency": "Requires designated-owner specification of pending continuation association to the paired source/action/site/captures/history, admission rules for transitioning from pending to forward-complete or recovery-complete, and prevention of unrelated actions or host replacements from retiring a pending path.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-EVIDENCE",
      "interface_gap_or_dependency": "Requires designated-owner specification of authenticated outcome evidence origin, correlation, finality, freshness, expiry, signed temporal domains, and known-versus-unknown external outcome classification so local Bool event binders are never treated as authenticated external nonexecution or timeout proof.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-CONTROL",
      "interface_gap_or_dependency": "Requires designated-owner specification of per-stage normal and recovery authority, participant consent, asset custody control for refund versus funded reserve authority for compensation, and gross-debit/fee/liability cap enforcement across stages.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-DURABLE",
      "interface_gap_or_dependency": "Requires designated-owner specification of strict RecoveryCheckpoint decoding, canonicality, source-bound reopen verification across pending, forward-complete, and recovery-complete states, consistency between control/accounting/residual/history, refusal of bare old Continuation promotion, and malformed/stale/tampered record diagnostics.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-LIVE",
      "interface_gap_or_dependency": "Requires designated-owner specification of once-only live consumption, replay and copy rejection, nonce/authority consumption, concurrent normal-completion versus recovery race resolution, and revocation rules across persisted checkpoint files and target execution.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-FAIL",
      "interface_gap_or_dependency": "Requires designated-owner specification of the complete non-normal failure family across load, reopen, admission, guard, body, and target phases\u2014including reachable prefixes, retained effects/fees/duties/work, L04 conditional transfer-only-before-discharge disposition, and exact error/control DTOs, codes, offsets, steps, and precedence.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    },
    {
      "id": "O-IO",
      "interface_gap_or_dependency": "Requires designated-owner specification of public CLI and test file publication atomicity/overwrite/staging rules (beyond copying proof_io::publish_new in B17), crash/write/read/export/stdout ordering relative to state transitions, child-process execution bounds in mori test, and failure reporting when persistence is incomplete or unknown.",
      "mandatory_before_dependent_implementation": true,
      "security_rule_authored_here": false
    }
  ],
  "sourceOwnerPrerequisites": [
    {
      "id": "O-ID",
      "topic": "Paired identities and version binding",
      "missing_exact_contract": "Exact canonical preimages/domains/serialization and concrete identities for base Program/plan plus companion module/plan; source/version change and migration rules; old M03 compatibility and exact diagnostics.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-REG",
      "topic": "Combined duty domain",
      "missing_exact_contract": "Exact complete base+handler duty registry and permitted incoming/created/discharged identities, conflict/domain treatment and checking order.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-ACCT",
      "topic": "Combined account and asset boundary",
      "missing_exact_contract": "Exact source/branch account-row coverage, canonical boundary and preserved rows across forward/recovery; authentic custody/funding/control assumptions and missing/extra row policy.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-TRACE",
      "topic": "Whole bounded source and trace admission",
      "missing_exact_contract": "Concrete pair/handler/source/JSON/history/trace bounds and resource envelope; complete normal/recovery trace cells including preserved rows; no hidden subset, truncation or budget increase.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-CAP",
      "topic": "Paired ceiling and lifetime budget admission",
      "missing_exact_contract": "Required successful_path_ceiling preflight with forward11/recovery13 discriminator; cap storage/override/editability/reserves, refusal order, cumulative attempt/committed overflow and all resource-cost distinctions.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-PEND",
      "topic": "Actual pending association",
      "missing_exact_contract": "Actual source/action/site/capture/history association, permitted changes and exact pending/closed transition admission; no unrelated source action or host replacement retires a pending path.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-EVIDENCE",
      "topic": "Outcome evidence and late/unknown facts",
      "missing_exact_contract": "Actual origin/correlation/finality/freshness/expiry and known/unknown rules; late success versus refund/compensation interpretation and signed temporal domains. Local Bool is not external evidence.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-CONTROL",
      "topic": "Authority, consent and financial control",
      "missing_exact_contract": "Per-stage recovery/normal/creation/discharge authority, exact assets/intent, consent/funding and retained gross/net/fee/duty constraints; custody refund versus funded forward compensation prerequisites.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-DURABLE",
      "topic": "Complete imported record and history",
      "missing_exact_contract": "Actual strict record decoding/canonicality and source-bound import/provenance/history/accounting/control consistency; pending and both closed variants; migration, malformed/oversized/stale/tampered behavior and diagnostics.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-LIVE",
      "topic": "Once-only and concurrent/late consumption",
      "missing_exact_contract": "Normal/recovery copies, replay, authority/nonce consumption, unique entitlement, races, revocation and target live-consumption policy; no local closed file proves global cancellation.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-FAIL",
      "topic": "Complete failure family",
      "missing_exact_contract": "Exact reachable prefixes and known retained state/effects/fees/duties/work/authority for each load/import/admission/guard/body/target phase failure; pending/closed/unresolved disposition, retries and full result/error DTO/code/offset/step/precedence. Include L04 conditional transfer-only-before-discharge family without assuming its reachability/commit policy.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    },
    {
      "id": "O-IO",
      "topic": "Actual public persistence and process failures",
      "missing_exact_contract": "Writer publication/overwrite/path/crash/durability/read/write/export/stdout/child-process failure rules and ordering relative to actual local/target transition; exact published/known/unknown state notification and complete failure records. No copied proof writer or generic io::Error silently selects this.",
      "mandatory_before_dependent_implementation": true,
      "supplied_by_ordinary_author": false
    }
  ],
