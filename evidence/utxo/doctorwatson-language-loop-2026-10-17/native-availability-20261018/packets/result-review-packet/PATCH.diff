+#[test]
+fn native_routes_report_unavailable_before_io() {
+    assert_eq!(
+        normalize_ws(
+            "\n  × mori::command::native-unavailable: This mori build has no Midnight\n  │ support. Rebuild with the native feature enabled.\n"
+        ),
+        format!("× {NATIVE_CODE}: {NATIVE_MSG}")
+    );
+    assert_eq!(
+        normalize_ws("  × header │ keep\n    │ │ body │ keep\n"),
+        "× header │ keep │ body │ keep"
+    );
+
+    let routes: Vec<(&str, Vec<&str>)> = vec![
+        (
+            "compile",
+            vec![
+                "compile",
+                "agreement.mori",
+                "--target",
+                "target.json",
+                "--out",
+                "out_dir",
+            ],
+        ),
+        (
+            "compile-call",
+            vec![
+                "compile-call",
+                "agreement.mori",
+                "--action",
+                "settle",
+                "--out",
+                "out_dir",
+            ],
+        ),
+        (
+            "prepare-call",
+            vec![
+                "prepare-call",
+                "agreement.mori",
+                "--action",
+                "settle",
+                "--deployment",
+                "deploy.json",
+                "--predecessor",
+                "pred.bin",
+                "--parameters",
+                "params.bin",
+                "--request",
+                "req.json",
+                "--out",
+                "out_dir",
+            ],
+        ),
+        (
+            "keygen-call",
+            vec![
+                "keygen-call",
+                "agreement.mori",
+                "--seed-deployment",
+                "deploy.json",
+                "--seed-state",
+                "state.bin",
+                "--parameters",
+                "params.bin",
+                "--action",
+                "settle",
+                "--params-dir",
+                "srs_dir",
+                "--work-limits",
+                "limits.json",
+                "--out",
+                "out_dir",
+            ],
+        ),
+        ("prove-call", {
+            let mut v = vec!["prove-call"];
+            v.extend_from_slice(CALL_ARGS);
+            v.extend_from_slice(&["--keyset", "keyset.bin", "--out", "out_dir"]);
+            v
+        }),
+        ("verify-call", {
+            let mut v = vec!["verify-call"];
+            v.extend_from_slice(CALL_ARGS);
+            v.extend_from_slice(&["--public-keyset", "pub_keyset.bin", "--proof", "proof.bin"]);
+            v
+        }),
+        (
+            "keygen-signed-call",
+            vec![
+                "keygen-signed-call",
+                "agreement.mori",
+                "--signer-policy",
+                "policy.json",
+                "--seed-deployment",
+                "deploy.json",
+                "--seed-state",
+                "state.bin",
+                "--parameters",
+                "params.bin",
+                "--action",
+                "settle",
+                "--params-dir",
+                "srs_dir",
+                "--work-limits",
+                "limits.json",
+                "--out",
+                "out_dir",
+            ],
+        ),
+        ("prepare-signed-call", {
+            let mut v = vec!["prepare-signed-call"];
+            v.extend_from_slice(SIGNED_CALL_ARGS);
+            v.extend_from_slice(&["--public-keyset", "pub_keyset.bin", "--out", "out_dir"]);
+            v
+        }),
+        ("prove-signed-call", {
+            let mut v = vec!["prove-signed-call"];
+            v.extend_from_slice(SIGNED_CALL_ARGS);
+            v.extend_from_slice(&[
+                "--keyset",
+                "keyset.bin",
+                "--signed-attachment",
+                "attach.json",
+                "--out",
+                "out_dir",
+            ]);
+            v
+        }),
+        ("verify-signed-call", {
+            let mut v = vec!["verify-signed-call"];
+            v.extend_from_slice(SIGNED_CALL_ARGS);
+            v.extend_from_slice(&[
+                "--public-keyset",
+                "pub_keyset.bin",
+                "--proof",
+                "proof.bin",
+                "--signed-attachment",
+                "attach.json",
+            ]);
+            v
+        }),
+        ("prove", {
+            let mut v = vec!["prove"];
+            v.extend_from_slice(ACTION_ARGS);
+            v.extend_from_slice(&[
+                "--target",
+                "target.json",
+                "--params-dir",
+                "srs_dir",
+                "--out",
+                "out.proof",
+            ]);
+            v
+        }),
+        ("verify", {
+            let mut v = vec!["verify"];
+            v.extend_from_slice(ACTION_ARGS);
+            v.extend_from_slice(&[
+                "--target",
+                "target.json",
