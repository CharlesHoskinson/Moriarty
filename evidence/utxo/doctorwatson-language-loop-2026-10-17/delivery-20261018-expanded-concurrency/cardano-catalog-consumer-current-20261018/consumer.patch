ction\",\n      \"sources\": [\n        \"X-PLAN\",\n        \"X-G16REPORT\",\n        \"S-REVIEW-CAT\",\n        \"A-G16\",\n        \"X-G16TEMPLATE\",\n        \"A-CATV1\"\n      ],\n      \"publicInputs\": \"Typed statementSchema: domain tag, predicate_digest, template_digest (fixed by value), asserted network label, historical tx_id, output_index (fixed to 1), payment key hash, threshold.\",\n      \"privateWitness\": \"Body bytes B.\",\n      \"anchorAndAssumptions\": \"BLAKE2b-256 collision resistance; the template fixes the decoding path to output 1; Groth16 knowledge soundness as MCP-EXE-01. Inclusion of B in any chain is not part of this relation.\",\n      \"freshnessValidity\": \"Bytes are immutable; no inclusion, unspentness or finality.\",\n      \"strategy\": \"Direct Groth16 over BLS12-381 with a hand-written Blake2b gadget (as reported).\",\n      \"implementationEvidence\": \"Independent G16 audit (A-G16, sha256 62fbdee0...b238) agrees with the X1-X3/X5 relation observations as E1/E2 for this one template shape and dissents on the X6 binding design (F1 script binding keyed on entryName; F2 the circuit's predicate constant does not identify the relation, the X3 control VK carries the P-L0 constants). The G16 circuit's 166-byte statement layout is not this typed statementSchema; correspondence is not established. Evidence attaches to admission records (audit_refs chosen by each consumer), never to this row.\",\n      \"status\": \"experiment-disputed\",\n      \"firstBlocker\": \"A statement encoding frozen by a non-author and an AdmissionRecord whose circuit_constants and audit_refs cover a key for this exact relation; X6-class binding redesign (G16 audit s11 items 1-3).\",\n      \"moriartyRelation\": \"Feeds P-M0 (MCP-PLN-02@2).\",\n      \"experiment\": \"Remove-the-binding control per binding constraint (MCP-REF-10); isolating derived-mutation vectors (G16 audit F5); control circuits only under key_role negative-control (MCP-REF-11).\",\n      \"notEstablished\": \"Inclusion on any chain; Preprod membership (network label asserted, body key 15 absent); phase-2 validity (is_valid and witnesses outside the txid); signer; output existence or unspentness; finality; any other template shape; that a circuit enforces each binding constraint of this statement schema.\",\n      \"category\": \"b\",\n      \"versionedId\": \"MCP-PLN-01@2\",\n      \"supersedes\": \"MCP-PLN-01@1\",\n      \"changeReason\": [\n        \"A5: SemanticEntry text carries no status, setup, key or provenance statement\",\n        \"A3: output_index fixed to 1 and template_digest fixed by value inside the SemanticEntry\",\n        \"A11: G16 audit 62fbdee0 recorded; experiment-disputed (qualified: typed statement and bundle carriage are X6-class and not approved); author vote 1, see NOTES\"\n      ],\n      \"introducedIn\": \"1.1-draft-20261015\",\n      \"statementSchema\": {\n        \"encoding\": \"typed field list (moriarty-statement-fields/1); the byte encoding into Plutus Data or scalars is not fixed\",\n        \"fields\": [\n          {\n            \"name\": \"domain_tag\",\n            \"type\": \"Bytes\",\n            \"role\": \"domain-tag\",\n            \"source\": \"circuit-constant\"\n          },\n          {\n            \"name\": \"predicate_digest\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"predicate_digest\",\n            \"source\": \"circuit-constant\",\n            \"note\": \"per-row predicate digest of this SemanticEntry; never a whole-catalogue digest\"\n          },\n          {\n            \"name\": \"template_digest\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"template_digest\",\n            \"source\": \"circuit-constant\",\n            \"value\": \"55186627f90973f0e59c0bb9e2bfafb6473c3f31f00df069fcb976a886520402\",\n            \"note\": \"BLAKE2b-256 of the template description bytes\"\n          },\n          {\n            \"name\": \"network_label\",\n            \"type\": \"Bytes\",\n            \"role\": \"network-label-asserted\",\n            \"source\": \"statement-public\"\n          },\n          {\n            \"name\": \"tx_id\",\n            \"type\": \"TxId\",\n            \"tx_relation\": \"historical-other-tx\",\n            \"source\": \"statement-public\",\n            \"note\": \"id of a past transaction whose bytes are the witness; never the carrying transaction (MCP-REF-09)\"\n          },\n          {\n            \"name\": \"output_index\",\n            \"type\": \"Int\",\n            \"index_of\": \"historical-tx-output\",\n            \"min\": \"0\",\n            \"max\": \"65535\",\n            \"source\": \"circuit-constant\",\n            \"value\": \"1\"\n          },\n          {\n            \"name\": \"payment_key_hash\",\n            \"type\": \"Bytes28\",\n            \"role\": \"payment-key-hash\",\n            \"source\": \"statement-public\"\n          },\n          {\n            \"name\": \"threshold_lovelace\",\n            \"type\": \"Int\",\n            \"role\": \"amount\",\n            \"min\": \"0\",\n            \"max\": \"9223372036854775807\",\n            \"source\": \"statement-public\"\n          }\n        ],\n        \"binding_constraints\": [\n          {\n            \"id\": \"PL0-C1-constants\",\n            \"fields\": [\n              \"domain_tag\",\n              \"predicate_digest\",\n              \"template_digest\",\n              \"output_index\"\n            ],\n            \"constraint\": \"relation fixes these values; they enter the statement digest preimage\"\n          },\n          {\n            \"id\": \"PL0-C2-txid\",\n            \"fields\": [\n              \"tx_id\"\n            ],\n            \"constraint\": \"BLAKE2b-256(B) == tx_id for witness bytes B\"\n          },\n          {\n            \"id\": \"PL0-C3-template\",\n            \"fields\": [\n              \"template_digest\",\n              \"output_index\"\n            ],\n            \"constraint\": \"B matches the template identified by template_digest; the payment output is output_index\"\n          },\n          {\n            \"id\": \"PL0-C4-address\",\n            \"fields\": [\n              \"payment_key_hash\",\n              \"output_index\"\n            ],\n            \"constraint\": \"output[output_index] address payment part is key hash payment_key_hash\"\n          },\n          {\n            \"id\": \"PL0-C5-coin\",\n            \"fields\": [\n              \"threshold_lovelace\",\n              \"output_index\"\n            ],\n            \"constraint\": \"coin(output[output_index]) >= threshold_lovelace\"\n          },\n          {\n            \"id\": \"PL0-C6-label\",\n            \"fields\": [\n              \"network_label\"\n            ],\n            \"constraint\": \"label enters the statement digest only; asserted, not checked against B (body key 15 absent)\"\n          }\n        ],\n        \"note\": \"Catalogue-normative statement type. An AdmissionRecord maps every constraint id to a relation locator and pins every circuit-constant field; naming a field in a constraint is not evidence that a relation enforces it.\"\n      },\n      \"anchorType\": \"none\",\n      \"semanticsId\": \"cardano-tx-body-bytes/fixed-template (P-L0)\",\n      \"resultSchema\": \"accept/reject of the relation over the typed statement; no ledger result\",\n      \"auditRef\": \"groth16-preprod-independent-opus-review-20261015/root-owned-attempt-2/FINAL-RESPONSE.md sha256 62fbdee0341f410684449d72e09e515a99d5c8d94d8b16cb489ab4267b7ed238 (APPROVE_SCOPED_RESEARCH_RESULT for X0-X5 observations; X6 binding design not approved)\"\n    },\n    {\n      \"id\": \"MCP-PLN-02\",\n      \"version\": \"2\",\n      \"family\": \"PLN\",\n      \"title\": \"P-M0: P-L0 composed with one hand-lowered Moriarty pay action\",\n      \"property\": \"P-L0 composed with the hand-lowered pay action of payment.mori. The relation fixes the raw-source SHA-256 raw_source_sha256 (identity layer 1, not program_hash) and the action name action_name as constants, takes a declared pre-snapshot and a public post-snapshot, and sets amount = coin of output output_index (fixed to 1) of the P-L0 body; the pay arithmetic is checked UInt128 arithmetic for this one action.\",\n      \"claimKind\": \"computation\",\n      \"temporalScope\": \"One execution\",\n      \"sources\": [\n        \"X-PLAN\",\n        \"X-G16REPORT\",\n        \"S-REVIEW-CAT\",\n        \"A-G16\",\n        \"X-G16TEMPLATE\",\n        \"A-CATV1\"\n      ],\n      \"publicInputs\": \"Typed statementSchema: P-L0 fields without threshold, plus raw_source_sha256, action_name, pre_snapshot, post_snapshot, amount.\",\n      \"privateWitness\": \"Body bytes, intermediate wires.\",\n      \"anchorAndAssumptions\": \"As MCP-PLN-01@2; correspondence of the hand lowering to moriarty-core/1 is vector-evidenced at most.\",\n      \"freshnessValidity\": \"n/a\",\n      \"strategy\": \"Single straight-line Groth16 circuit.\",\n      \"implementationEvidence\": \"Independent G16 audit (A-G16, sha256 62fbdee0...b238): X4 arithmetic agreed for one vector; X6 binding design not approved (F1/F2); requires amount > 0 never isolated (F5). Evidence attaches to admission records, never to this row.\",\n      \"status\": \"experiment-disputed\",\n      \"firstBlocker\": \"As MCP-PLN-01@2; program_hash binding needs identity layer 2 or 3 (MCP-EXE-01).\",\n      \"moriartyRelation\": \"First concrete instance of MCP-EXE-01 shape, without commitments or Cardano validator.\",\n      \"experiment\": \"Isolating amount = 0 derived-mutation vector (G16 audit F5); whitespace-only .mori edit changes raw_source_sha256 but not program_hash (identity-ladder control).\",\n      \"notEstablished\": \"Compiler/lowering correctness; the requires amount > 0 constraint in isolation; effect digest (not in statement); asset identity (program asset vs lovelace unbound); predecessor authenticity; Cardano validator or ScriptContext binding; program_hash correspondence (identity layer 2).\",\n      \"category\": \"b\",\n      \"versionedId\": \"MCP-PLN-02@2\",\n      \"supersedes\": \"MCP-PLN-02@1\",\n      \"changeReason\": [\n        \"A5: SemanticEntry text carries no status, setup, key or provenance statement\",\n        \"A3: PM0-C7 no longer lists raw_source_sha256 as transition-bound (it is a relation constant in PM0-C1); output_index and template_digest fixed by value\",\n        \"A11: G16 audit 62fbdee0; X4-X6 rely on the X6 binding: experiment-disputed (audit recommendation plus author agreement)\"\n      ],\n      \"introducedIn\": \"1.1-draft-20261015\",\n      \"statementSchema\": {\n        \"encoding\": \"typed field list (moriarty-statement-fields/1); the byte encoding into Plutus Data or scalars is not fixed\",\n        \"fields\": [\n          {\n            \"name\": \"domain_tag\",\n            \"type\": \"Bytes\",\n            \"role\": \"domain-tag\",\n            \"source\": \"circuit-constant\"\n          },\n          {\n            \"name\": \"predicate_digest\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"predicate_digest\",\n            \"source\": \"circuit-constant\",\n            \"note\": \"per-row predicate digest of this SemanticEntry; never a whole-catalogue digest\"\n          },\n          {\n            \"name\": \"template_digest\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"template_digest\",\n            \"source\": \"circuit-constant\",\n            \"value\": \"55186627f90973f0e59c0bb9e2bfafb6473c3f31f00df069fcb976a886520402\",\n            \"note\": \"BLAKE2b-256 of the template description bytes\"\n          },\n          {\n            \"name\": \"network_label\",\n            \"type\": \"Bytes\",\n            \"role\": \"network-label-asserted\",\n            \"source\": \"statement-public\"\n          },\n          {\n            \"name\": \"tx_id\",\n            \"type\": \"TxId\",\n            \"tx_relation\": \"historical-other-tx\",\n            \"source\": \"statement-public\",\n            \"note\": \"id of a past transaction whose bytes are the witness; never the carrying transaction (MCP-REF-09)\"\n          },\n          {\n            \"name\": \"output_index\",\n            \"type\": \"Int\",\n            \"index_of\": \"historical-tx-output\",\n            \"min\": \"0\",\n            \"max\": \"65535\",\n            \"source\": \"circuit-constant\",\n            \"value\": \"1\"\n          },\n          {\n            \"name\": \"payment_key_hash\",\n            \"type\": \"Bytes28\",\n            \"role\": \"payment-key-hash\",\n            \"source\": \"statement-public\"\n          },\n          {\n            \"name\": \"raw_source_sha256\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"raw_source_sha256\",\n            \"source\": \"circuit-constant\",\n            \"note\": \"identity layer 1 (source bytes); not program_hash\"\n          },\n          {\n            \"name\": \"action_name\",\n            \"type\": \"Bytes\",\n            \"role\": \"action-id\",\n            \"source\": \"circuit-constant\"\n          },\n          {\n            \"name\": \"pre_snapshot\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"pre-snapshot\",\n            \"source\": \"statement-public\",\n            \"note\": \"declared pre-snapshot; predecessor authenticity not established\"\n          },\n          {\n            \"name\": \"post_snapshot\",\n            \"type\": \"Bytes32\",\n            \"digest_of\": \"post-snapshot\",\n            \"source\": \"statement-public\"\n          },\n          {\n            \"name\": \"amount\",\n            \"type\": \"Int\",\n            \"role\": \"amount\",\n            \"min\": \"0\",\n            \"max\": \"9223372036854775807\",\n            \"source\": \"statement-public\"\n          }\n        ],\n        \"binding_constraints\": [\n          {\