      "actual": "Execution#/pre",
      "scope": "complete normalized prestate"
    },
    {
      "expected": "independent/COMPLETE-PREFIXES.expected.json#/post",
      "actual": "Execution#/post",
      "scope": "complete poststate"
    },
    {
      "expected": "independent/COMPLETE-PREFIXES.expected.json#/prefixes/{i}/snapshot",
