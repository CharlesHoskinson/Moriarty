    {
      "expected": "independent/COMPLETE-PREFIXES.expected.json#/prefixes/{i}/cumulativeEffects",
      "actual": "ordered concatenation Execution#/steps/0..i/effects",
      "range": "i=0..10",
      "scope": "complete ordered cumulative effects"
    },
    {
      "expected": "independent/COMPLETE-PREFIXES.expected.json#/effects",
      "actual": "Execution#/effects and all-step concatenation",
      "scope": "all six complete ordered effects"
