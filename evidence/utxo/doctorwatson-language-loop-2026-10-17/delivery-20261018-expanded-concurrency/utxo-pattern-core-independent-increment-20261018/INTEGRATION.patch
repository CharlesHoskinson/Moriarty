+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Balance {
+    pub account: String,
+    pub asset: AssetId,
+    pub amount: UInt,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Liability {
+    pub name: String,
+    pub asset: AssetId,
+    pub debtor: String,
+    pub creditor: String,
+    pub amount: UInt,
+}
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Scenario {
+    pub state: BTreeMap<String, Value>,
+    pub inputs: BTreeMap<String, Value>,
+    pub balances: Vec<Balance>,
+    pub liabilities: Vec<Liability>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Snapshot {
+    pub state: BTreeMap<String, Value>,
+    pub balances: Vec<Balance>,
+    pub liabilities: Vec<Liability>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(tag = "kind", deny_unknown_fields)]
+pub enum Effect {
+    State {
+        name: String,
+        before: Value,
+        after: Value,
+    },
+    Transfer {
+        asset: AssetId,
+        from: String,
+        to: String,
+        amount: UInt,
+    },
+    Fee {
+        asset: AssetId,
+        from: String,
+        to: String,
+        amount: UInt,
+    },
+    Liability {
+        name: String,
+        asset: AssetId,
+        debtor: String,
+        creditor: String,
+        before: UInt,
+        after: UInt,
+    },
+    Emit {
+        name: String,
+        value: Value,
+    },
+}
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Step {
+    pub index: u16,
+    pub statement: Statement,
+    pub value: Option<Value>,
+    pub snapshot: Snapshot,
