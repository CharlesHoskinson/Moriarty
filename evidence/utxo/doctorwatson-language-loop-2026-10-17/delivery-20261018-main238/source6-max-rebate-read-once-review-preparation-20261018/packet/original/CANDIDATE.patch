+          {
+            "owner": "Owner",
+            "remaining": "1175",
+            "spent": "850"
+          }
+        ],
+        "head": "m1",
+        "round": "4",
+        "selectedReplay": {
+          "tuple": [
+            "Midnight",
+            "Owner",
+            "rebate-nonce"
+          ],
+          "encodedKey": "[\"Midnight\",\"Owner\",\"rebate-nonce\"]",
+          "state": "consumed"
+        },
+        "localTransferDuties": []
+      },
+      "scope": "Complete provided financial frame and selected replay/head only; mathematical effect prefix, not an observed evaluator trace or complete Core state. Work is separately unasserted."
+    }
+  ]
+}
