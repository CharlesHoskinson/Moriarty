new file mode 100644
index 0000000000000000000000000000000000000000..3826dad5bb86aec29b44ea4178c72fe3be4baf89
--- /dev/null
+++ b/crates/fixtures/check-source/cases/financial-beta-invoice.mori
@@ -0,0 +1,19 @@
+// Normal transfer with a distinct fee recipient.
+profile "moriarty-beta/1";
+agreement BetaInvoiceCheck {
+  domain Preview = { id: "Midnight", chain: "midnight", network: "preview" };
+  account Buyer = { domain: Preview, id: "Buyer" };
+  account Seller = { domain: Preview, id: "Seller" };
+  account Treasury = { domain: Preview, id: "Treasury" };
+  asset USD = { domain: Preview, id: "USD", scale: 2, representation: "canonical" };
+  const price = 25.00 USD;
+  const fee = 0.20 USD;
+  intent Payment = {
+    domain: Preview, asset: USD, signer: Buyer, key: "key1", nonce: "invoice", pre_head: "h0",
+    valid: rounds(domain: Preview, from: 0, to: 10), gross_cap: price + fee, fee_cap: fee, net_floor: price,
+    operation: transfer(from: Buyer, to: Seller, fee_to: Treasury, value: price, fee: fee),
+    source_hash: "src1", policy_digest: "policy1", failure: SuccessOnly,
+    observations: [], disclosures: [], retained_effects: [], retained_duties: [], delegation: None, recovery: None,
+  };
+  action pay uses Payment;
+}
diff --git a/crates/fixtures/check-source/cases/financial-beta-repayment.mori b/crates/fixtures/check-source/cases/financial-beta-repayment.mori
new file mode 100644
index 0000000000000000000000000000000000000000..25b6f25247f7e0bbb1591a6aa9bca3d67785740b
--- /dev/null
+++ b/crates/fixtures/check-source/cases/financial-beta-repayment.mori
@@ -0,0 +1,18 @@
+// Normal repayment names an obligation rather than a transfer recipient.
+profile "moriarty-beta/1";
+agreement BetaRepaymentCheck {
+  domain Preview = { id: "Midnight", chain: "midnight", network: "preview" };
+  account Payer = { domain: Preview, id: "Payer" };
+  account Creditor = { domain: Preview, id: "Creditor" };
+  asset USD = { domain: Preview, id: "USD", scale: 2, representation: "canonical" };
+  obligation Debt = { domain: Preview, asset: USD, id: "Loan" };
+  const amount = 12.00 USD;
+  intent Repayment = {
+    domain: Preview, asset: USD, signer: Payer, key: "key1", nonce: "repayment", pre_head: "h0",
+    valid: rounds(domain: Preview, from: 0, to: 10), gross_cap: amount, fee_cap: 0.00 USD, net_floor: 0.00 USD,
+    operation: repay(obligation: Debt, payer: Payer, amount: amount),
+    source_hash: "src1", policy_digest: "policy1", failure: SuccessOnly,
+    observations: [], disclosures: [], retained_effects: [], retained_duties: [], delegation: None, recovery: None,
+  };
+  action repay_loan uses Repayment;
+}
