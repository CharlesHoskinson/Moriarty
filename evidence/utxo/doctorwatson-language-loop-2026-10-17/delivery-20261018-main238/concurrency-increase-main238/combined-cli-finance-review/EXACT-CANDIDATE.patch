@@ -0,0 +1,9 @@
+// Normal immediate payment with a separate fee.
+language "moriarty/1";
+agreement CorePaymentCheck {
+  asset CASH = { network: "local", issuer: "check-payment", reference: "CASH", scale: 0 };
+  action pay(amount: UInt) {
+    transfer(CASH, "buyer", "merchant", amount);
+    fee(CASH, "buyer", "treasury", 2);
+  }
+}
diff --git a/crates/fixtures/check-source/cases/financial-core2-escrow.mori b/crates/fixtures/check-source/cases/financial-core2-escrow.mori
new file mode 100644
index 0000000000000000000000000000000000000000..25f2ef00af42bdaa462d80e21f195be020241783
--- /dev/null
+++ b/crates/fixtures/check-source/cases/financial-core2-escrow.mori
@@ -0,0 +1,12 @@
+// Normal funded delivery carries a release duty across its await.
+language "moriarty/2";
+agreement StagedEscrowCheck {
+  asset CASH = { network: "local", issuer: "check-escrow", reference: "CASH", scale: 0 };
+  action deliver(amount: UInt) {
+    transfer(CASH, "buyer", "escrow", amount);
+    liability("release", CASH, "escrow", "seller", amount);
+    await delivery(ready: Bool) when ready;
+    transfer(CASH, "escrow", "seller", amount);
+    discharge("release", amount);
+  }
+}
diff --git a/crates/fixtures/check-source/cases/financial-core2-rebate.mori b/crates/fixtures/check-source/cases/financial-core2-rebate.mori
