{
 "schema": "moriarty-cardano-catalogue-v12-auth-pack/1",
 "label": "AUTH",
 "frozenBy": "claude-opus-5-5, v1.2 repair source author (same model id as the v1/v1.1 authors, the review author and the falsifier author; context independence only). Every expectation here is SAME-AUTHOR (AUTH), written before the v1.2 source and data existed. None is independent evidence.",
 "relation": "Additive to the frozen independent pack (cardano-catalogue-v11-independent-falsifiers-20261015, FREEZE a575bbce...). Never replaces, edits or re-scores any of its 282 cases.",
 "caseLanguage": "Same world/normative language as the independent pack (world_ind.World specs; driver.match/invariants), plus adapter-level keys: genuine ('v12' default | 'v11'), bases ('v0v1v11' default | 'v0v1' | 'v11-is-v1'), argv placeholder '{v11}'.",
 "designContract": {
  "editions": {
   "1.2-draft-20261015": "current: schema moriarty-cardano-property-catalogue/1.2; DOC_KEYS = v1.1 keys + v11Base + lineage; bases v0, v1, v11 (all three byte-pinned in code); every v1.1 row carried byte-identically (CAT_V11_ROW_MISSING / CAT_V11_ROW_ALTERED)",
   "1.1-draft-20261015": "legacy: still validated, but only under the repaired v1.2 rules (B1-B3); bases v0, v1; unchanged API"
  },
  "lineage": "v1.2 doc member lineage = {predecessorVersion: '1.1-draft-20261015', successorVersion: '1.2-draft-20261015', rowCarriage: str, renames: [{item, from, to, note}], unchanged: [{item, identity}], repairs: [{id, source, summary}], notClaimed: [str]}; exact keys, typed; version fields pinned",
  "v11Base": "same shape as v1Base: {catalogueVersion, locator, fileBytes, fileSha256, catalogueManifestDigest, rowCount, immutability}; pinned fields equal pins.V11_PIN",
  "unchangedIdentities": "MCJ/1 (mcj.py byte-identical), SemanticEntry /1 projection, admission record /1.1, bundle /1.1, manifest format /1.1, profiles, vocabularies; every predicate_digest and row_digest of the 143 rows",
  "B1": "policy /2 consumer grants exactly as independent policy-grant-data.json futureSchema; policy /1 only with accepted_auditors == []; one shared effective-audit function for admission requirements and the bundle vector-evidenced cap; deny-list kept in addition to disputes",
  "B2": "re.fullmatch with ASCII-only classes for every typed string; decimal strings bounded (Int <= 78 digits; row version <= 15 digits, i.e. < 2^53); typed predicate refs (versioned id) in policies, records and bundle entries; hex-typed bundle entry digests; pinned-content comparisons by MCJ/1 bytes (no bool/int aliasing)",
  "B3": "type guards before every iteration/membership test; every DOC member typed (AMB-3) for both editions; no library exception for MCJ-valid inputs; CLI stdout ASCII JSON (ensure_ascii) so a surrogate-escaped argv byte cannot break the one-JSON-object contract",
  "cli": "unchanged positional argv; new optional --v11 PATH, required only for edition 1.2 documents (CAT_BASE_INPUT otherwise)"
 },
 "newInfFindingsBeforeExecution": [
  "INF-1 (B3 class): Python >= 3.11 int() refuses decimal strings longer than 4300 digits; v1.1 value_ok/check_statement_schema call int() on any is_dec string, so an Int statement value, circuit constant or catalogue min/max/value of >4300 digits raises ValueError (library) / CLI_INTERNAL_ERROR (CLI). Cases AUTH-A19, AUTH-C01, AUTH-C02, AUTH-E05.",
  "INF-2 (B3 class): a row version >= 2^53 passes v1.1 VER_RE; semantic_entry puts int(version) into an MCJ value, so manifest_rows raises MCJ_INT_RANGE out of validate_catalogue. Case AUTH-A18.",
  "INF-3 (B2 class): pinned-content equality uses Python ==, so true == 1 and false == 0: profiles networkMagic true, recoveredBridgeRows false and manifest current 1 alias the pinned values. Cases AUTH-A15, AUTH-A16, AUTH-A17."
 ],
 "unitChecks": [
  {"id": "U-DATA-1", "expect": "v1.2 doc rows equal v1.1 doc rows element by element under MCJ/1; 143 rows; 89 current heads; every manifest row_digest and predicate_digest equals the v1.1 manifest's for the same versionedId"},
  {"id": "U-DATA-2", "expect": "candidate semantic.build_manifest(v1.2 doc, file bytes) equals the checked-in v1.2 manifest (differential against the stdlib builder)"},
  {"id": "U-DATA-3", "expect": "v1.2 doc v11Base pinned fields equal sha256/length/manifest digest/row count of the byte-copied v1.1 file; catalogue_manifest_digest(v1.1) == c856d17bb166d95bcb4315e4a58c9451de09d9ab09fff7532f46c5f0be28bee2; v1 digest == 4dbe36a58a04f09e13461a28a96b43b1dc2d5e1c8043835849df0ef4c9093498"},
  {"id": "U-MCJ-1", "expect": "candidate mcj.py and semantic.py identity functions unchanged: mcj.py bytes equal the v1.1 origin bytes"},
  {"id": "U-API-1", "expect": "validate_catalogue(doc, manifest, base_bytes, expected_manifest_digest), open_context(doc, manifest, base_bytes, policy), admission_full(doc, manifest, base_bytes, policy, records, index), bundle_full(doc, manifest, base_bytes, policy, records, bundle) keep their v1.1 parameter lists"},
  {"id": "U-STATIC-1", "expect": "no candidate source line combines a .match( call with a $-anchored validator; every typed validator regex is used with fullmatch"},
  {"id": "U-L7-STRICT", "expect": "cli.main(argv with a lone surrogate) writing to a strict-errors UTF-8 text stream returns 2, raises nothing, and the bytes are one ASCII JSON object with codes [CLI_USAGE]"},
  {"id": "U-NET-PROBE", "expect": "evidence only: inside the child, a TCP connect to 127.0.0.1:9 fails (network namespace without a configured interface); recorded, not an acceptance claim"}
 ],
