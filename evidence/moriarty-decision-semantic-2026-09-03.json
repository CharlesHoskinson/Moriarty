      "file_type": "rationale",
      "id": "deliverables_moriarty_agentic_council_record_2026_09_03_position_a",
      "label": "Council Position A: Mechanism-First Demotion",
      "rationale": "Rejects F1-F6/P as exclusive architecture and reduces to four primary mechanisms (exchange, credit, derivative, consensus claim) to establish strict boundary discipline and prevent premature taxonomical sprawl.",
      "source_file": "deliverables/moriarty-agentic-council-record-2026-09-03.md",
      "source_location": null,
      "source_url": null
    },
    {
      "author": null,
      "captured_at": null,
      "contributor": null,
      "file_type": "rationale",
      "id": "deliverables_moriarty_agentic_council_record_2026_09_03_position_b",
      "label": "Council Position B: Provisional Human Taxonomy and M5 Formal Profile",
      "rationale": "Separates human market navigation from formal machine behavior by maintaining M2+M3 for people, M5 for verification, and proposing a library-only Compact templates fallback if a new language provides no assurance delta.",
      "source_file": "deliverables/moriarty-agentic-council-record-2026-09-03.md",
      "source_location": null,
      "source_url": null
    },
    {
      "author": null,
      "captured_at": null,
      "contributor": null,
      "file_type": "rationale",
      "id": "deliverables_moriarty_agentic_council_record_2026_09_03_position_c",
      "label": "Council Position C: Conditional Transfer Base and Certifying Elaboration",
      "rationale": "Advocates Moriarty Core as a formal semantic delta against Marlowe, requiring an audit triple and translation-validation certification before observable semantic additions like atomic Step or Attest can be admitted.",
      "source_file": "deliverables/moriarty-agentic-council-record-2026-09-03.md",
      "source_location": null,
      "source_url": null
    },
