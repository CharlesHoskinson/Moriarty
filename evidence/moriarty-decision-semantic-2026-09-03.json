      "id": "deliverables_moriarty_agentic_council_record_2026_09_03_backend_boundedness_stop_condition",
      "label": "Backend Boundedness Hard Stop Condition",
      "rationale": "If generated Compact requires unbounded containers or unconstrained witness callbacks, halt Moriarty Core expansion immediately and default to audited libraries.",
