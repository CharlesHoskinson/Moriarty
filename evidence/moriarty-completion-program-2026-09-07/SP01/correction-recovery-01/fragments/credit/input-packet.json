  "findings": [
    {
      "id": "R01",
      "severity": "blocking",
      "title": "Bad debt disappears without a resolving transition",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/14/input",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/14/steps/0",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/14/expected/debt",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/mutations/17"
      ],
      "evidence": "The input has debt 1000 and collateral valued at 400. The sole step recognizes a 600 loss. Expected debt becomes 0. There is no collateral sale, 400 settlement, authorized write-off, or successor liability. The erasure=false flag does not establish discharge. The mutation rejects a missing loss label, but permits this positive case with unsupported debt deletion.",
      "materiallyMissingObligation": "A complete distinction between recoverable debt, recovery cash, authorized loss allocation, and the surviving or explicitly resolved borrower duty. This is a design contradiction, independent of protocol source availability."
    },
    {
      "id": "R02",
      "severity": "blocking",
      "title": "Redemption final observations contradict the listed claim step",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/2",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/6",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/6/observationMap/tokens"
      ],
      "evidence": "Both traces list claim 40 USDC as their last step. Expected status remains Claimable, claimable remains 40, and sharesLocked remains 100. They also assert residualShares 60 without a share-to-asset conversion. The held-out input includes claimedFloor 9500, which the expected observations never check. The intent trace explicitly drops that floor. Its map marks token transfers inapplicable despite the claim payment.",
      "materiallyMissingObligation": "A coherent post-claim asset/share/request state, independently derived conversion, retained net intent constraint, and double-claim rejection. An unknown exchange-rate function cannot justify the asserted numeric residual."
    },
    {
      "id": "R03",
      "severity": "blocking",
      "title": "Refinance does not account for funding, financed fees, or gross authority",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/1/input",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/1/steps",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/1/expected",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/5"
      ],
      "evidence": "The old creditor receives 50000 before new debt creation, but no payer balance or bridge funding exists in the input. New debt is 50050 with a financed 50 fee. tokensMoved lists only 50000 USDC and 20 WETH, with no fee recipient or lender disbursement. authorityRemaining leaves fee charging conditional on whether fees are transfer-like. The 1000 transfer cap is not bound to a defined actor or debit domain. Collateralization is asserted without prices or a numeric toy ratio. workRemaining 1008 has no charged-step derivation.",
      "materiallyMissingObligation": "Complete authorized gross transfers, funding origin, financed-fee allocation, independently bounded debt authority, observable collateral prefixes, and exact residual authority/work. Protocol parameters can remain unfrozen while a generic oracle supplies its own explicit assumptions."
    },
    {
      "id": "R06",
      "severity": "blocking",
      "title": "Work and residual preservation are asserted without complete finite accounting",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/4",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/7/expected/workRemaining",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/sharedProfiles/defaultBounds",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/compositionOperators/0/residualAuthority",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/7/boundedFootprint"
      ],
      "evidence": "Recurring workRemaining is the string not reset. No work costs or remaining closure reserve are derived. Partial fill has zero fees, no actual refund, no account balances, and no outstanding duty beyond a consumed-authority record. Its map says residual fill rights persist while the trace gives no surviving rights state after cancellation. Composition carries no numeric work split or join accounting. Default bounds are repeated without connecting trace operations to consumed resources.",
      "materiallyMissingObligation": "Concrete lifetime/work/closure arithmetic and surviving duties for partial progress, cancellation, exhaustion, split, and continuation. The no-refresh and no-erasure requirements need discriminating observations, not only boolean declarations."
    },
    {
      "id": "R10",
      "severity": "blocking",
      "title": "Representation paths and footprints do not identify the concrete state/effects under review",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/1/representationPath",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/1/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/11/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/compositionOperators/3/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/sharedProfiles/acceptanceIncludesGenesisAndAdmin"
      ],
      "evidence": "Most representation paths repeat generic stage notes. Many read/write footprints name only the challenge itself with bound 1, or op-name with bound 2. Refinance omits funding accounts and fee recipients. The concentrated footprint does not enumerate its three ticks and position records. Four mandatory claims and genesis/admin inclusion are preserved as names and flags, but no concrete acceptance statement or genesis/admin case binds the complete proposed state/effects.",
      "materiallyMissingObligation": "A reviewable source-to-intent-to-plan-to-state/effect/assumption/successor mapping and real bounded resources. Future implementation may remain open, but placeholders cannot support full design-map acceptance."
    }
  ]
