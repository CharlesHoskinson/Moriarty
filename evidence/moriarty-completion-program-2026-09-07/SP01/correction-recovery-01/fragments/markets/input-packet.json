  "findings": [
    {
      "id": "R04",
      "severity": "blocking",
      "title": "Concentrated-liquidity and iterative-AMM examples do not derive the named mechanisms",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/11",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/mutations/14",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/12",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/mutations/15"
      ],
      "evidence": "Concentrated liquidity lists ticks and liquidity but no input amount, price representation, output amount, position change, or fee-growth calculation. It asserts a fee of 1 and floor-on-zeroForOne without a quantity-specific formula or reverse-direction result. The iterative case supplies D=1000,1008,1004,1004 without an invariant function, recurrence, derivative, or reserves. Its mutation names cap 8 but gives no concrete nonconvergent capped run.",
      "materiallyMissingObligation": "Independently derived bounded numeric examples for tick/position/fee rounding and AMM convergence, including discriminating rejection inputs. Arbitrarily chosen output sequences are insufficient even for generic design oracles."
    },
    {
      "id": "R07",
      "severity": "blocking",
      "title": "Shared-vault settlement is an unexplained zeroing of deltas",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/15/input",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/15/steps/2",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/15/expected"
      ],
      "evidence": "The hook changes token1 delta from -9 to -10. The final step says settle to 0, but gives no vault inventory, participant balances, settlement transfers, fee recipient, or delta-sign convention. Thus the final zero cannot distinguish real settlement from resetting a counter. The negative example checks nonzero final delta, not unsupported zeroing.",
      "materiallyMissingObligation": "A complete pre/temporary/final accounting derivation that binds permitted hook effects to actual asset settlement and fee allocation."
    },
    {
      "id": "R09",
      "severity": "blocking",
      "title": "Margin/funding and ordered redemption lack full resulting financial state",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/17",
        "experiments/moriarty-language/spec/successor/challenge-traces.json#/traces/13"
      ],
      "evidence": "Margin/funding mixes a rejected withdrawal with a withdrawal that may proceed. Expected cash 95 describes availability after a funding hold, not an executed withdrawal. There is no position, margin requirement, settled transfer, or final collateral state. Ordered redemption computes debt residuals correctly but supplies no collateral quantities/prices, received assets, burn/settlement, fees, or account/authority changes.",
      "materiallyMissingObligation": "An unambiguous positive execution and full observable result for each mechanism. The arithmetic 100-5=95 and 150=100+50 does not establish an admissible financial transition."
    },
    {
      "id": "R10",
      "severity": "blocking",
      "title": "Representation paths and footprints do not identify the concrete state/effects under review",
      "locations": [
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/1/representationPath",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/1/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/challenges/11/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/compositionOperators/3/boundedFootprint",
        "experiments/moriarty-language/spec/successor/challenge-map.json#/sharedProfiles/acceptanceIncludesGenesisAndAdmin"
      ],
      "evidence": "Most representation paths repeat generic stage notes. Many read/write footprints name only the challenge itself with bound 1, or op-name with bound 2. Refinance omits funding accounts and fee recipients. The concentrated footprint does not enumerate its three ticks and position records. Four mandatory claims and genesis/admin inclusion are preserved as names and flags, but no concrete acceptance statement or genesis/admin case binds the complete proposed state/effects.",
      "materiallyMissingObligation": "A reviewable source-to-intent-to-plan-to-state/effect/assumption/successor mapping and real bounded resources. Future implementation may remain open, but placeholders cannot support full design-map acceptance."
    }
  ]
}
