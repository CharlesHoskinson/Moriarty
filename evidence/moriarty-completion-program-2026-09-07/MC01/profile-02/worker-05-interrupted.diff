+
+status_decl = "status", "episode", "closed_when", identifier, "==", literal, ";"
+            | "status", "agreement", "remaining_notional", identifier, ";"
+            | "status", "agreement", "no_remaining_notional", ";" ;
 
 effect_decl = "effect", effect_kind, "{", field_decl, { field_decl }, "}" ;
 
