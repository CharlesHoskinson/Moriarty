  "command": "/home/charl/Moriarty/.venv/bin/python - <<'PY'\nfrom pathlib import Path\nimport hashlib,json,tarfile\nroot=Path('/tmp/moriarty-a5-nullary-control.7xc9Oc')\narchive=Path('evidence/s02-candidate-a-completion/a5/nullary-control/control-evidence.tar.gz')\nh=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nmembers=[]\nwith tarfile.open(archive,'r:gz') as t:\n for m in t:\n  if m.isfile():\n   raw=t.extractfile(m).read()\n   assert raw==(root/m.name).read_bytes(),m.name\n   members.append({'path':m.name,'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)})\nfor stage,code in [('compile-agreement',0),('compile-wrong',0),('check-agreement',0),('check-wrong',12)]:\n r=json.loads((root/stage/'result.json').read_text());i=json.loads((root/stage/'input.json').read_text())\n assert r['exitCode']==code and not r['timedOut'] and r['sourceAndToolsUnchanged'],stage\n stdout=root/stage/('input.qnt.json' if stage.startswith('compile-')else 'stdout.txt')\n assert h(stdout)==r['stdoutSha256'] and h(root/stage/'stderr.txt')==r['stderrSha256']\n assert all(h(Path(p['path']))==p['sha256']for p in i['pins'])\n if stage=='check-agreement':assert 'Checker reports no error up to computation length 2' in stdout.read_text()\n if stage=='check-wrong':assert 'State 1: state invariant 0 violated.' in stdout.read_text()\nv=json.loads((root/'compile-agreement/input.qnt.json').read_text())\nd=next(d for d in v['modules'][0]['declarations']if d.get('name')=='cached')\nassert d['expr']['expr']['kind']=='let'\nassert d['expr']['expr']['opdef']['qualifier']=='val'\nidentity=json.loads((root/'java-identity-before-check.json').read_text())\nassert h(Path(identity['path']))==identity['sha256']\ntraces=list((root/'check-wrong').rglob('violation1.itf.json'))\nassert len(traces)==1\nprint(json.dumps({'status':'diagnostic-control-validated-not-A5-acceptance','archiveSha256':h(archive),'members':members,'counterexample':str(traces[0].relative_to(root))},indent=2))\nPY",
