def dec (j : Json) : Except String St := do
  exactKeys j "state" fieldNames
  pure { memAvail := ← getNat j "memAvail",
         cgroupHead := ← getNat j "cgroupHead",
         hasGpu := ← getBool j "hasGpu",
         gpuReportsMem := ← getBool j "gpuReportsMem",
         hwGpuTotal := ← getNat j "hwGpuTotal",
         hwGpuFree := ← getNat j "hwGpuFree",
         cores := ← getNat j "cores",
         proverKeyD := ← getNat j "proverKeyD",
         caps := ← getNats j "caps",
         calT := ← getNats j "calT",
         calHost := ← getNats j "calHost",
         calDev := ← getNats j "calDev",
         profWritten := ← getBool j "profWritten",
         profFormatOk := ← getBool j "profFormatOk",
         profFieldsOk := ← getBool j "profFieldsOk",
         profKeyD := ← getNat j "profKeyD",
         memBudget := ← getNat j "memBudget",
         unified := ← getBool j "unified",
         gpuCount := ← getNat j "gpuCount",
         gpuTotal := ← getNat j "gpuTotal",
         gpuFree := ← getNat j "gpuFree",
         profCores := ← getNat j "profCores",
         calMask := ← getNat j "calMask",
         setupStops := ← getNat j "setupStops",
         memUnit := ← getNat j "memUnit",
         limMemOn := ← getBool j "limMemOn",
         limMem := ← getNat j "limMem",
         gpusOff := ← getBool j "gpusOff",
         limGpuMemOn := ← getBool j "limGpuMemOn",
         limGpuMem := ← getNat j "limGpuMem",
         n := ← getNat j "n",
         prog := ← getNat j "prog",
         input := ← getNat j "input",
         rP := ← getNat j "rP",
         salt := ← getNat j "salt",
         box := ← getNat j "box",
         scheduled := ← getBool j "scheduled",
         calibrated := ← getBool j "calibrated",
         schShape := ← getNat j "schShape",
         schDevice := ← getNat j "schDevice",
         schConc := ← getNat j "schConc",
         schEst := ← getNat j "schEst",
         cut := ← getNats j "cut",
         forced := ← getBool j "forced",
         policy := ← getNat j "policy",
         peakStark := ← getNat j "peakStark",
         peakWrap := ← getNat j "peakWrap",
         peakCoset := ← getNat j "peakCoset",
         wrapFree := ← getNat j "wrapFree",
         starkExtra := ← getNat j "starkExtra",
         margin := ← getNat j "margin",
         earlyWraps := ← getNat j "earlyWraps",
         runs := ← getNat j "runs",
         recBox := ← getNat j "recBox",
         recShape := ← getNat j "recShape",
         recDevice := ← getNat j "recDevice",
         recLeaves := ← getNat j "recLeaves",
         recCalibrated := ← getBool j "recCalibrated",
         recKeys := ← getNat j "recKeys",
         recClaim := ← getNat j "recClaim",
         nodes := ← getNat j "nodes" }

def ctx : Ctx St where
  fields := fieldNames
  decode := dec
  encode := enc
  stepRefusals s op := (stepRefusals s op).map Refusal.code
  step := step
  runRefusals s ops := (runRefusals s ops).map Refusal.code
  run := run

def main (args : List String) : IO UInt32 := mainWith ctx args
