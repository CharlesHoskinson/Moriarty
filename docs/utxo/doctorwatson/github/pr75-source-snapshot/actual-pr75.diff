diff --git a/models/core-stage-tests/history/blocked-r2/quoted-fee.mori b/models/core-stage-tests/history/blocked-r2/quoted-fee.mori
new file mode 100644
index 00000000..40b23679
--- /dev/null
+++ b/models/core-stage-tests/history/blocked-r2/quoted-fee.mori
@@ -0,0 +1,13 @@
+language "moriarty/2";
+agreement QuotedFee {
+  state total: UInt = 0;
+  state marker: UInt = 9;
+  asset UNIT = { network: "local", issuer: "independent-staged-test-oracle", reference: "UNIT", scale: 0 };
+  action charge(amount: UInt) {
+    let payable = amount + 1;
+    await quote(agreed: Bool) when agreed;
+    fee(UNIT, "payer", "treasury", payable);
+    next total = payable;
+    emit "fee"(payable);
+  }
+}
