{"path": "crates/mori/src/commands/init.rs", "commit": "2c87d1a8c45677acf2568aeff1511d0c7d72d044", "full_source_sha256": "17d8fb1b7ab93a497892605d6d9db6a62a09e120157d39df4d372b5f48775274", "classification": "read_only_source_selector_excerpt", "lines": [{"line": 93, "text": "        \"# Moriarty starter\\n\\nThis project uses `language \\\"moriarty/1\\\"` and local reference execution.\\nThe TEST asset and accounts are examples. Simulation does not settle a ledger transaction or produce a proof.\\n\\nRun these commands from this directory with `mori` on your PATH:\\n\\n```sh\\nmori check source.mori --json\\nmori simulate source.mori --action {action} --scenario scenario.json\\nmori test .\\n```\\n\\nThe manifest checks the complete expected post-state and ordered effects.\\n\\nInitialization requires a new destination and an existing parent directory.\\nAn I/O failure can leave an incomplete project. Choose a new destination before retrying.\\n\""}, {"line": 94, "text": "    );"}, {"line": 95, "text": "    Ok(vec!["}, {"line": 96, "text": "        (\"source.mori\", source.as_bytes().to_vec()),"}, {"line": 97, "text": "        (\"scenario.json\", format!(\"{scenario}\\n\").into_bytes()),"}, {"line": 98, "text": "        (\"mori-tests.json\", format!(\"{manifest}\\n\").into_bytes()),"}, {"line": 99, "text": "        (\"README.md\", readme.into_bytes()),"}, {"line": 100, "text": "    ])"}, {"line": 101, "text": "}"}, {"line": 102, "text": ""}, {"line": 103, "text": "pub fn run(args: Args, shell: &mut Shell) -> super::Result<ExitCode> {"}, {"line": 104, "text": "    let files = project(args.template)?;"}]}
