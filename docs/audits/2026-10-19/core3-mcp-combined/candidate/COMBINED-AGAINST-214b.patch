+#[test]
+fn mcp_core3_ordinary_type_refusal_preserves_source_profile_metadata_only() {
+    let source = r#"language "moriarty/3";
+agreement TypeExample {
+  state count: UInt = 0;
+  action run() { next count = true; }
+}
+"#;
+    let mut child = Command::new(env!("CARGO_BIN_EXE_mori"))
+        .args(["--color", "never", "mcp"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn public mori mcp");
+    let mut input = child.stdin.take().unwrap();
+    for value in [
+        initialize(),
+        ready(),
+        request(
+            json!("core3-type"),
+            "tools/call",
+            json!({"name":"check", "arguments":{"source":source}}),
+        ),
+    ] {
+        serde_json::to_writer(&mut input, &value).unwrap();
+        input.write_all(b"\n").unwrap();
+    }
+    drop(input);
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(0), "{source}");
+    assert!(output.stderr.is_empty(), "{source}");
+    let replies: Vec<Value> = output
+        .stdout
+        .split(|byte| *byte == b'\n')
+        .filter(|line| !line.is_empty())
+        .map(|line| serde_json::from_slice(line).unwrap())
+        .collect();
+    assert_eq!(replies.len(), 2, "{source}");
+    // No complete error body/code/message is predicted by this metadata test.
+    let result = &replies[1]["result"];
+    assert_eq!(
+        result["isError"], true,
+        "exercise the rejected-check branch"
+    );
+    assert_eq!(result["structuredContent"]["sourceProfile"], "moriarty/3");
+    let text: Value = serde_json::from_str(result["content"][0]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(text["sourceProfile"], "moriarty/3");
+}
