+            W::Requires { predicate } => Self::Requires { predicate },
+            W::Ensures { predicate } => Self::Ensures { predicate },
+            W::Next { state, value } => Self::Next { state, value },
+            W::Emit { name, value } => Self::Emit { name, value },
+            W::Transfer {
+                asset,
+                from,
+                to,
+                amount,
+            } => Self::Transfer {
+                asset,
+                from,
+                to,
+                amount,
+            },
+            W::Fee {
+                asset,
+                from,
+                to,
+                amount,
+            } => Self::Fee {
+                asset,
+                from,
+                to,
+                amount,
+            },
+            W::Liability {
+                name,
+                asset,
+                debtor,
+                creditor,
+                amount,
+            } => Self::Liability {
+                name,
+                asset,
+                debtor,
+                creditor,
+                amount,
