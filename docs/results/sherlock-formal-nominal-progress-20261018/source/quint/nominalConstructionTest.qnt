module nominalConstructionTest {
  import nominalConstruction.* from "./nominalConstruction"
  import nominalConstructionInputs as I from "./nominalConstructionInputs"
  // Values below bind independently frozen expected-normal.json literals.
  // No expected value/trace is generated by advance, ordinary, or an evaluator.
  pure val expectedChain: Value = List(
    ConstructorToken({typeId: 10, ctorId: 1, arity: 2}), UIntToken(2),
    ConstructorToken({typeId: 10, ctorId: 1, arity: 2}), UIntToken(1),
    ConstructorToken({typeId: 10, ctorId: 0, arity: 0}))
  pure val expectedSchedule: Value = List(ConstructorToken({typeId: 20, ctorId: 0, arity: 2})).concat(expectedChain).concat(List(UIntToken(9)))
  pure val expectedMutual: Value = List(
    ConstructorToken({typeId: 30, ctorId: 0, arity: 1}),
    ConstructorToken({typeId: 31, ctorId: 0, arity: 1}),
    ConstructorToken({typeId: 30, ctorId: 1, arity: 0}))
  action init: bool = initProgram(I::mainProgram, 192)
  // Deterministic finite trace: terminal stutters make the bounded suffix total.
  action checkedStep: bool = step.expect(allInv)
  run mainConstructionAndCallerTest = init
    .then(192.reps(i => checkedStep))
    .expect(and {
      machine.outcome == Done(uint(18)), machine.environment == Map(),
      machine.frames == List(), machine.selectedArms == List(1),
      machine.builds.length() == 4,
      machine.builds.foldl(List(), (ids, b) => ids.append(b.occurrence)) == List(101, 102, 102, 200),
      machine.builds.nth(2).value == expectedChain,
      machine.builds.nth(3).value == expectedSchedule,
      machine.builds.nth(3).fields == List(expectedChain, uint(9)),
      machine.constructorNodes == 4, machine.constructorFieldSlots == 6,
      machine.enteredArguments.slice(0, 3) == List(List(uint(2)), List(uint(1)), List(uint(0))),
      allInv,
    })
  run repeatedSourceOccurrenceTest = initProgram(I::repeatedProgram, 128)
    .then(128.reps(i => checkedStep))
    .expect(and {
      machine.outcome == Done(uint(8)), machine.builds.length() == 3,
      machine.builds.nth(0).occurrence == 301, machine.builds.nth(1).occurrence == 302,
      machine.builds.nth(0).value == machine.builds.nth(1).value,
      machine.builds.nth(0).fields == List(uint(4)), allInv,
    })
  run mutualDeclarationTest = initProgram(I::mutualProgram, 32)
    .then(32.reps(i => checkedStep))
    .expect(and {
      machine.outcome == Done(expectedMutual),
      machine.builds.foldl(List(), (ids, b) => ids.append(b.occurrence)) == List(401, 402, 403),
      machine.constructorNodes == 3, machine.constructorFieldSlots == 2, allInv,
    })
  // The first-field witness is reached during make(1); lower frames retain all
  // context. Subsequent tests inspect the full record through a semantic cut.
  pure def runPrefix(s: Snapshot, count: int): Snapshot =
    range(0, count).foldl(s, (state, ignored) => advance(state))
  pure val mainPrefixes = range(0, 193).foldl(List(), (states, index) => states.append(runPrefix(initial(I::mainProgram, 192), index)))
  run recursiveFirstFieldRetainedTest = all {
    mainPrefixes.foldl(false, (reached, s) => reached or and {
      s.enteredArguments.length() >= 2,
      s.frames.foldl(false, (seen, frame) => seen or match frame {
        | ConstructorFields(c) => and {
            c.typeId == 20, c.ctorId == 0, c.occurrence == 200, c.source == 3,
            c.completed == List(), c.remaining == List(6), c.saved == Map(1 -> uint(9)),
          }
        | _ => false
      }),
    }),
  }
  run recursiveLastFieldRetainedTest = all {
    mainPrefixes.foldl(false, (reached, s) => reached or and {
      s.enteredArguments.length() >= 2,
      s.frames.foldl(false, (seen, frame) => seen or match frame {
        | ConstructorFields(c) => and {
            c.typeId == 10, c.ctorId == 1, c.occurrence == 102,
            c.completed == List(uint(2)), c.remaining == List(), c.saved == Map(3 -> uint(2)),
          }
        | _ => false
      }),
    }),
  }
  run allPrefixResumeTest = all {
    mainPrefixes.foldl(true, (ok, saved) =>
      ok and runPrefix(saved, 192 - saved.consumed) == runPrefix(initial(I::mainProgram, 192), 192)),
  }
  // This is model Snapshot equality after a pure value save/resume. It is not
  // production canonical serialization or persistent export/import evidence.
  run postFieldAllocationTest = all {
    mainPrefixes.foldl(true, (ok, s) => ok and match s.control {
      | Build(c) => c.remaining == List() and c.completed.length() == s.program.layouts.get((c.typeId, c.ctorId)).fields.length()
      | _ => true
    }),
  }
  run terminalChargeAdapterTest = all {
    TERMINAL_PUBLICATION_CHARGE == 1, FROZEN_K_A_TERMINAL_PUBLICATION_CHARGE == 0,
    {
      val pending = {...initial(I::mainProgram, 1), control: Return(uint(18))}
      val terminal = advance(pending)
      terminal.outcome == Done(uint(18)) and terminal.consumed == 1 and terminal.remaining == 0 and advance(terminal) == terminal
    },
    advance({...initial(I::mainProgram, 0), control: Return(uint(18))}).outcome == Exhausted,
  }
}
