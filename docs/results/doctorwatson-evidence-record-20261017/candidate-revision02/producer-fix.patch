+def compile_evidence_record(repo, package, case):
+    """Identify seven evidence fields for an existing capture, never execute it.
+
+    The optional companion is separate from artifact/1 and ordinary corpus QA.
+    Its source/binary facts are labeled recorded identities, not authentication
+    or current compiler execution. Bare fixed-snapshot wrappers load no leaf.
+    """
+    path = Path(__file__).resolve().with_name('compile_evidence_record.py')
+    raw = path.read_bytes()
+    spec = importlib.util.spec_from_file_location('sherlock_compile_evidence_record', path)
+    require(spec is not None and spec.loader is not None, 'compile evidence helper unavailable')
+    module = importlib.util.module_from_spec(spec)
+    exec(compile(raw, str(path), 'exec', dont_inherit=True), module.__dict__)
+
+    def read_file(path, *, json_document):
+        raw = Path(path).read_bytes()
+        identity = dict(path=str(path), sha256=digest(raw), bytes=len(raw))
+        value = (json.loads(raw, object_pairs_hook=unique_members, parse_constant=nonfinite,
+                            parse_float=finite) if json_document else raw)
+        return identity, value
+
+    return module.build_record(repo, package, case, read_file=read_file)
+
