language "moriarty/1";
agreement AscendingComparisons {
  action inspect(left: UInt, right: UInt) {
    let different = left not = right;
    let low = left <= right;
    let high = right > left;
    let inclusive = left >= right;
    let both = different and low;
    let either = high or inclusive;
    let result = both and either;
    emit "ascending"(result);
  }
}
