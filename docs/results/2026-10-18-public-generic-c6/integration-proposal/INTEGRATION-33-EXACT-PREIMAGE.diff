+/// Callable ordinary product predicate: consume the real C6 continuation in
+/// Match ExprId order; only planned matches acquire real complete plan roots.
+pub(super) fn lower_ext_p(matches: Vec<MatchOccurrence<'_>>,
+    writer: &mut impl ExtPProgramWriter) -> Result<(), ExtTypeBuildError> {
+    for source in &matches {
+        let arms = match writer.begin_match(source)? { None => continue, Some(arms) => arms };
