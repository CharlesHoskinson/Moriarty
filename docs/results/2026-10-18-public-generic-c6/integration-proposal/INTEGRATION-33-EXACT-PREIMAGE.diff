+        RawConstRow::Bool { .. } => TypeIdC(1),
+        RawConstRow::Nil { .. } | RawConstRow::Cons { .. } => TypeIdC(2),
+        RawConstRow::Leaf { .. } | RawConstRow::Branch { .. } => TypeIdC(3),
+        RawConstRow::Constructor { type_id, .. } => TypeIdC(type_id.0),
+    }
