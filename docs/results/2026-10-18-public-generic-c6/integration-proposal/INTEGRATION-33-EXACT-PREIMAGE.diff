+fn bitlen_count(n: u128) -> u128 {
+    if n == 0 {
+        1
+    } else {
+        (128 - n.leading_zeros()) as u128
+    }
+}
+
+fn bitlen_id(z: u128) -> u128 {
+    if z <= 1 {
+        1
+    } else {
+        (128 - (z - 1).leading_zeros()) as u128
+    }
+}
