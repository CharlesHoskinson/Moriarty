+        || sb.consumed_work > pre.img.consumed_work
+    {
+        return Err(HostViolation { kind: HostViolationKind::StepInvViolated,
+            clause: Some(StepInvClauseId::SI05), rule: None,
+            locator: Some("segBase prefix invariant".to_string()) });
+    }
+    Ok(sb)
