+        Cell::Row(id) => writer.pattern(id)?,
+    };
+    // These are the fixed existing builtin TypeIds/CtorIds, never fabricated
+    // user identities or surrogate values. Dedicated rows remain stored once.
+    Ok(match row {
+        PatternRowC::PVar { .. } | PatternRowC::Wildcard => Head::Irrefutable,
+        PatternRowC::PNil => Head::Constructor { type_id: TypeIdC::List,
+            ctor_id: CtorIdC(0), fields: vec![] },
+        PatternRowC::PCons { x, y } => Head::Constructor { type_id: TypeIdC::List,
+            ctor_id: CtorIdC(1), fields: vec![Cell::Binder(x), Cell::Binder(y)] },
+        PatternRowC::PLeaf { x } => Head::Constructor { type_id: TypeIdC::Tree,
+            ctor_id: CtorIdC(2), fields: vec![Cell::Binder(x)] },
+        PatternRowC::PBranch { x, y } => Head::Constructor { type_id: TypeIdC::Tree,
+            ctor_id: CtorIdC(3), fields: vec![Cell::Binder(x), Cell::Binder(y)] },
+        PatternRowC::Constructor { type_id, ctor_id, children } => Head::Constructor {
+            type_id, ctor_id, fields: writer.pattern_children(children)?.into_iter().map(Cell::Row).collect() },
+    })
