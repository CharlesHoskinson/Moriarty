+pub(super) fn si22_adt_helper_ok(
+    pre: &PreImage,
+    h: &HelperControlC,
+) -> Result<bool, HostViolation> {
+    if pre.task_live() != 0 {
+        return Ok(false);
+    }
+    si21_adt_helper_ok(pre, h)
+}
