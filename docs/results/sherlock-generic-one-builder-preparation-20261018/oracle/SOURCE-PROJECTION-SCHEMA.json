        "right": "ExtExpr"
      }
    },
    "Unary": {
      "Unary": {
        "op": "public UnaryOp variant name",
        "operand": "ExtExpr"
      }
    },
    "If": {
      "If": {
        "cond": "ExtExpr",
        "then_expr": "ExtExpr",
        "else_expr": "ExtExpr"
      }
    },
    "Call": {
      "Call": {
        "name": "String",
        "args": [
          "ExtExpr"
        ]
      }
    },
    "Match": {
      "Match": {
        "scrutinee": "ExtExpr",
        "arms": [
          {
            "pattern": "ExtPattern",
            "body": "ExtExpr"
          }
        ]
      }
    },
    "Construct": {
      "Construct": {
        "ty": "TypeExprSrc",
        "ctor": "String",
        "fields": [
          "ExtExpr"
        ]
      }
    }
  },
  "ExtValue": {
    "Core": {
      "Core": "CoreValue (value field unwrapped)"
    },
    "Constructor": {
      "Constructor": {
        "ty": "TypeExprSrc",
        "ctor": "String",
        "fields": [
          "ExtValue"
        ]
      }
    }
  },
  "CoreValue_positive_corpus": {
    "UInt": {
      "UInt": {
