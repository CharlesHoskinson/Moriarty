      }
    }
  },
  "CoreValue_optional_projection_extensions": {
    "Bool": {
      "Bool": {
        "b": "boolean"
      }
    },
    "List": {
      "List": {
        "elements": [
          "KIntC projection"
        ]
      }
    },
    "Tree": {
