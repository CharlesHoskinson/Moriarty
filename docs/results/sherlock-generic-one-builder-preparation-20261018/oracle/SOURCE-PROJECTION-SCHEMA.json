{
  "format": "independent-full-source-projection/1",
  "purpose": "Complete source fields for this supplied corpus, not Debug/Clone/hash/address equality or evaluator output.",
  "ExtProgram": "{types:[TypeDeclSrc],assets:[],states:[],inputs:[],functions:[ExtFunction],entry:ExtExpr}",
  "TypeDeclSrc": "{name:String,parameters:[String],ctors:[CtorDeclSrc]}",
  "CtorDeclSrc": "{name:String,fields:[{name:String,ty:TypeExprSrc}]}",
