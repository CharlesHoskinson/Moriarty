    {
      "id": "UIREQ-030",
      "index": 29,
      "title": "Typed arithmetic component API",
      "acceptance": {
        "status": "closed",
        "proposedStatus": "closed",
        "scope": "Whole original UIREQ-030 clause and original Carry, borrow and full product scenario; all applicable refinements retained separately.",
