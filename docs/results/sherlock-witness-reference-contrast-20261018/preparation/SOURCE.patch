+fn compare_b0_schedule(initial:&co::HostSnapshot,spans:&[rp::ReferenceSpan]) {
+    // Construct the COMPLETE actual prefix first; no expected cell supplies any
+    // field, rule, counter, missing interval or semantic association.
+    let columns=json!(["A_record_index_or_null","preceding_B_rule_id_or_null","consumed_work","helper_work","helper_visits","reference_cursor","remaining_work","erased_semantic_A_snapshot_index"]);
+    let mut prefixes=vec![b_clock_row(None,None,initial,0)];let mut intervals=Vec::new();
+    let mut previous=initial.clone();let mut ordinal=0usize;
+    for (a_index,span) in spans.iter().enumerate() {
+        assert_eq!(span.b_start,ordinal);
+        assert_eq!(span.raw.len(),span.b_end_exclusive-span.b_start);
+        assert_eq!(span.source_event.checked_add(1),Some(span.b_end_exclusive),"normal B0 separate completion ends interval");
+        let mut helper_ids=Vec::new();let mut completion_id=None;
+        for (offset,record) in span.raw.iter().enumerate() {
+            assert_eq!(record.before,previous);verify_record_counters(record);
+            let id=b_rule_id(record.event.rule_id);let is_completion=span.b_start+offset==span.source_event;
+            if is_completion {
+                assert!(matches!(record.event.event_kind,EventKind::LegacyComplete|EventKind::Publish));
+                completion_id=Some(id);
+            }else{
+                assert!(!matches!(record.event.event_kind,EventKind::LegacyComplete|EventKind::Publish));
+                // Charged bookkeeping belongs here as well; event kind cannot
+                // hide any prefix row or charged preceding rule.
+                if record.event.work_delta!=0 {helper_ids.push(id);}
+            }
+            prefixes.push(b_clock_row(Some(a_index),Some(id),&record.after,if is_completion {a_index+1}else{a_index}));
+            previous=record.after.clone();ordinal+=1;
+        }
+        intervals.push(json!({"A_record_index":a_index,"A_rule_line":span.reference.rule_start_line,"first_B_record":span.b_start,"B_records_exclusive":span.b_end_exclusive,"helper_rule_ids":helper_ids,"legacy_rule_id":completion_id.expect("actual source completion")}));
+    }
+    assert_eq!(prefixes.len(),ordinal+1);
+    let actual=json!({"clockPrefixColumns":columns,"clockPrefixes":prefixes,"intervals":intervals});
+    // B0 describes this explicit DedicatedSorts run. No A/B work equality is
+    // asserted; the previous full A39 comparison remains independently bound.
+    let profile=match initial.admission.identity.profile_id {2=>"sherlock-helper-microstep/1",_=>panic!("selected B profile")};
+    let grammar=format!("{:?}",initial.admission.identity.grammar_domain);
+    let expected:J=serde_json::from_str(FACT2_B0).expect("opaque independent complete B0 schedule");
+    assert_eq!(expected.get("profile"),Some(&json!(profile)));
+    assert_eq!(expected.get("grammarDomain"),Some(&json!(grammar)));
+    assert_eq!(expected.get("initialFuel"),Some(&json!(initial.image.initial_fuel)));
+    for key in ["clockPrefixColumns","clockPrefixes","intervals"] {
+        assert!(expected.get(key).is_some(),"missing independent B0 field {key}");
+        assert_eq!(&actual[key],&expected[key],"complete independent B0 field {key}");
+    }
