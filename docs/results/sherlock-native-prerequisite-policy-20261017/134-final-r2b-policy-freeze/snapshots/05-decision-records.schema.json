        {
          "properties": {
            "primary_model": {
              "const": "claude-opus-5-5"
            },
            "requested_model": {
              "const": "gemini-4-argon-high"
            },
            "returned_identity": {
              "const": "gemini-4-argon-high"
            },
            "effort": {
              "const": "high"
            },
            "fallback_status": {
              "const": "standing_opus_quota_outage_fallback"
            }
          }
        }
      ]
