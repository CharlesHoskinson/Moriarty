{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unadopted owner-proposed decision record schemas; not records or authority",
  "$defs": {
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_granted_by_this_file_alone",
        "kind",
        "reviewer_role",
        "decision",
        "primary_model",
        "requested_model",
        "returned_identity",
        "effort",
        "fallback_status",
        "terminal_sha256",
        "report_sha256",
        "runner_sha256",
        "source_manifest_sha256",
        "subject_manifest_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "authority_granted_by_this_file_alone": {
          "const": false
        },
        "kind": {
          "const": "security_source_review"
        },
        "reviewer_role": {
          "const": "designated_security_owner"
        },
        "decision": {
          "const": "APPROVED_SOURCE_WITH_LIMITS"
        },
        "primary_model": {
          "const": "claude-opus-5-5"
        },
        "requested_model": {
          "enum": [
            "claude-opus-5-5",
            "gemini-4-argon-high"
          ]
        },
        "returned_identity": {
          "enum": [
            "claude-opus-5-5",
            "gemini-4-argon-high"
          ]
        },
        "effort": {
          "const": "high"
        },
        "fallback_status": {
          "enum": [
            "primary",
            "standing_opus_quota_outage_fallback"
          ]
        },
        "terminal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "primary_model": {
              "const": "claude-opus-5-5"
            },
            "requested_model": {
              "const": "claude-opus-5-5"
            },
            "returned_identity": {
              "const": "claude-opus-5-5"
            },
            "effort": {
              "const": "high"
            },
            "fallback_status": {
              "const": "primary"
            }
          }
