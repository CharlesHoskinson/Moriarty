+impl ResourceReport {
+    /// Ordinary diagnostic projection of the same observed pair and summary.
+    /// Unknown profile IDs remain unselected; no default schedule is chosen.
+    pub fn from_owner_with_manifest(observation: &HostObservation<'_>, summary: &RunSummary)
+        -> ManifestResourceReport
+    {
+        let observations = Self::from_owner(observation, summary);
+        let reference_schedule_id = match observation.admission.identity.profile_id {
+            0 => Some("sherlock-k-a/1"),
+            1 => Some("sherlock-quint-a/1"),
+            2 => Some("sherlock-helper-microstep/1"),
+            _ => None,
+        };
+        let io_bytes = gap("owner-observation-carries-no-io-byte-observation", &["io-bytes"]);
+        let mut unknown_metrics = Vec::new();
+        let u = observations.unmeasured;
+        for group in [u.peaks, u.physical, u.circuit, u.proof, u.host, u.overhead,
+            u.financial_target, u.event_reconciliation, u.remaining_nonhelper_reference_work] {
+            unknown_metrics.extend_from_slice(group.metrics);
+        }
+        unknown_metrics.extend_from_slice(io_bytes.metrics);
+        ManifestResourceReport {
+            format: "moriarty-sherlock-b-resource-report/3",
+            manifest: ResourceManifestV3 {
+                format: "moriarty-sherlock-resource-manifest/3",
+                reference_schedule_id,
+                admission_identity: observation.admission.identity.into(),
+                supplied: observations.supplied,
+                missing_required_identity: a_report::ReferenceIdentityGap {
+                    status: "gap",
+                    reason: "no-selected-program-image-or-rule-or-lowering-identity-producer",
+                    fields: &["rule-inventory-digest", "program-image-id", "lowering-digest"],
+                },
+                io_bytes, retained_profiles: a_report::RETAINED_RESOURCE_PROFILES,
+                unknown_metrics,
