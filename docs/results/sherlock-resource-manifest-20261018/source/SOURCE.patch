+/// Successful report-transport bytes, not total host/physical/checkpoint I/O.
+/// This is separate from the resource manifest's unobserved collection I/O.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub struct ReportWriteObservation {
+    pub format: &'static str,
+    pub serialization_bytes: Counter,
+    pub io_bytes: Counter,
+    pub measurement_scope: &'static str,
+}
+#[derive(Debug)]
+pub enum ReportWriteError {
+    Serialization(serde_json::Error),
+    Io(std::io::Error),
+}
+
+/// Serialize the real supplied report once and write those exact bytes. A
+/// receipt exists only after write_all succeeds. The writer owns publication,
+/// destination and failure policy; no file creation or overwrite rule is added.
+/// The allocation/serialization work remains ordinary unbounded diagnostics.
+pub fn write_report_json<R: Serialize + ?Sized, W: std::io::Write + ?Sized>(
+    report: &R, writer: &mut W,
+) -> Result<ReportWriteObservation, ReportWriteError> {
+    let bytes = serde_json::to_vec(report).map_err(ReportWriteError::Serialization)?;
+    writer.write_all(&bytes).map_err(ReportWriteError::Io)?;
+    let count = Counter(bytes.len() as u128);
+    Ok(ReportWriteObservation {
+        format: "moriarty-sherlock-report-write-observation/1",
+        serialization_bytes: count,
+        io_bytes: count,
+        measurement_scope: "complete-report-json-write-only;excludes-input-checkpoint-and-physical-io",
+    })
+}
