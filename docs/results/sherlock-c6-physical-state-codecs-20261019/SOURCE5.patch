+    #[test]
+    fn refusals_follow_the_declared_first_error_order() {
+        let t = C6HelperTables { helper: Some(all_helpers()[1]), result: Some(HelperResultC::Validated { ok: true }),
+            tasks: vec![HelperTaskC::ValidateTask { r: RefC::Data(2), visit: TaskVisitC::Fields, cursor: 1 }] };
+        let lanes = encode_helper_tables(&t, &caps()).unwrap();
+        assert_eq!(lanes.len(), 38);
+        let dec = |l: &[u128]| decode_helper_tables(l, &caps());
+        let set = |pairs: &[(usize, u128)]| { let mut m = lanes.clone(); for &(k, v) in pairs { m[k] = v; } m };
+        assert_eq!(dec(&lanes[..30]), Err(C6PhysError::Truncated { section: SECTION, needed: 31, actual: 30 }));
+        assert_eq!(dec(&set(&[(0, 0), (2, 0)])), Err(C6PhysError::BadMagic { actual: 0 }));
+        assert_eq!(dec(&set(&[(1, 2)])), Err(C6PhysError::BadVersion { actual: 2 }));
+        assert_eq!(dec(&set(&[(2, DATA_SECTION_TAG)])), Err(C6PhysError::BadTag { section: SECTION, tag: DATA_SECTION_TAG }));
+        assert_eq!(dec(&set(&[(3, u128::MAX)])), Err(C6PhysError::UsizeOverflow { section: SECTION, value: u128::MAX }));
+        assert_eq!(dec(&set(&[(3, 65)])), exceeded("state.tasks", 65, 64));
+        assert_eq!(dec(&set(&[(3, 2)])), Err(C6PhysError::Truncated { section: SECTION, needed: 45, actual: 38 }));
+        let mut trailing = lanes.clone();
+        trailing.push(0);
+        assert_eq!(dec(&trailing), Err(C6PhysError::TrailingLanes { section: SECTION, extra: 1 }));
+        assert_eq!(dec(&set(&[(4, 12)])), Err(C6PhysError::BadTag { section: HELPER_S, tag: 12 }));
+        assert_eq!(dec(&set(&[(12, 2)])), Err(C6PhysError::BadTag { section: HELPER_S, tag: 2 }));
+        assert_eq!(dec(&set(&[(12, 0)])), Err(C6PhysError::NonZeroPadding { section: HELPER_S, lane: 9, value: 1 }));
+        assert_eq!(dec(&set(&[(16, 1)])), Err(C6PhysError::NonZeroPadding { section: HELPER_S, lane: 12, value: 1 }));
+        // Structure precedes caps; the helper record precedes the result record.
+        assert_eq!(dec(&set(&[(9, 999), (15, 7)])), Err(C6PhysError::BadTag { section: HELPER_S, tag: 7 }));
+        assert_eq!(dec(&set(&[(9, 256), (28, 2)])), exceeded("state.helper.binder", 257, 256));
+        assert_eq!(dec(&set(&[(28, 2)])), Err(C6PhysError::BadBool { section: RESULT_S, value: 2 }));
+        assert_eq!(dec(&set(&[(34, 2)])), Err(C6PhysError::BadTag { section: TASK_S, tag: 2 }));
+        assert_eq!(dec(&set(&[(35, 9)])), exceeded("state.task.cursor", 9, 8));
+        // u8 lanes refuse overflow; no truncation.
+        let mut l = encode_result_record(Some(HelperResultC::ScalarError { code: 255 }));
+        l[1] = 256;
+        assert_eq!(decode_result_record(&l), Err(C6PhysError::UsizeOverflow { section: RESULT_S, value: 256 }));
+        let mut l = encode_helper_record(Some(all_helpers()[0]));
+        l[16] = 0; l[15] = 4; l[16] = 256;
+        assert_eq!(decode_helper_record(&l), Err(C6PhysError::UsizeOverflow { section: HELPER_S, value: 256 }));
+        l[15] = 0; l[16] = 1;
+        assert_eq!(decode_helper_record(&l), Err(C6PhysError::NonZeroPadding { section: HELPER_S, lane: 16, value: 1 }));
+        let mut l = encode_helper_record(Some(all_helpers()[8]));
+        l[15] = 256;
+        assert_eq!(decode_helper_record(&l), Err(C6PhysError::UsizeOverflow { section: HELPER_S, value: 256 }));
+        // The encoder applies the same caps.
+        let mut tight = caps();
+        tight.max_helper_tasks = 0;
+        assert_eq!(encode_helper_tables(&t, &tight), exceeded("state.tasks", 1, 0));
+        assert_eq!(decode_helper_tables(&lanes, &tight).map(|_| ()), exceeded("state.tasks", 1, 0));
+    }
