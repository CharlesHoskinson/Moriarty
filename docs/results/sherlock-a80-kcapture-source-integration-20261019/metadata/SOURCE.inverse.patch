-        if row.len() == n { Ok(row) } else { Err(error("sherlock-shape", "Statement operands ended early.")) }
-    };
-    let root = take(root.len())?;
-    let mut rows = Vec::with_capacity(tables.len());
-    for table in tables {
-        let mut table_rows = Vec::with_capacity(table.capacity);
