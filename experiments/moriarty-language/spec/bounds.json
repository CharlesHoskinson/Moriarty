  "jointValidation": [
    "source bytes and lexical bounds",
    "AST bytes/depth/nodes/records/arrays/text",
    "typed program bytes/depth/nodes/records/arrays/text plus embedded AST bounds",
    "all program-shape counts",
    "full manifest bytes/depth/nodes/records/arrays/text",
    "compact signing bytes/depth/nodes/records/arrays/text",
    "genesis/state/observation/evaluation bytes/depth/nodes/records/arrays/text",
    "result bytes/depth/nodes/records/arrays/text",
    "post-trace proof acceptance objects use proofAcceptanceEncoding",
    "external resolved proof count, per-proof bytes, and aggregate bytes"
