  "representabilityRule": "Reject any failed applicable bound. Expanded internal metadata has its own finite limits. Public signing, evaluation and result encodings remain 65536 bytes and depth 16. All actual aggregate sizes are checked.",
  "lifecycle": {
    "initialAllowance": "positive-UInt128-frozen-at-authenticated-genesis",
    "consumption": "one-per-successful-action",
    "horizon": "UInt128-UTC-epoch-second-exclusive-upper-bound-frozen-at-genesis",
    "timeSource": "explicit-authenticated-observation-now-no-host-clock-read",
    "closureReserve": "Only an explicit reserve ACTION for CLOSURE declaration imposes the stage-6 RESERVE_RULE predicate: distinct existing actions, unique reserved ACTION, CLOSURE not itself reserved, and a top-level Guard with exact Gt(Remaining, Literal(UIntLiteral token 1)) AST in ACTION. No implicit roles or exceptions.",
    "revision": "increment-one-on-Complete-with-overflow-rejection",
    "resets": "forbidden",
    "pending": "UNSUPPORTED_PENDING",
    "splitJoin": "unsupported-profile"
