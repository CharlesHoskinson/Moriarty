  // Each successful action returns the entire private state, step transfers and effect.
  // Failure carries no tentative state. The caller attaches the action index.
  syntax LCApply ::= lcApplied(EJSON,EJSON,EJSON) | lcFailed(String)
  syntax LCApply ::= lcApply(EJSON,EJSON,EJSON) [function, total]
  syntax EJSON ::= lcAppend(EJSON,EJSON) [function, total]
                 | lcReplace(EJSON,EJSON,EJSON) [function, total]
  rule lcAppend(ejArray(L),V) => ejArray(ejAppend(L,ejCons(V,ejNil())))
  rule lcAppend(_,_) => ejMissing() [owise]
  rule lcReplace(ejArray(ejNil()),_,V) => ejArray(ejCons(V,ejNil()))
  rule lcReplace(ejArray(ejCons(Old,L)),Old,V) => ejArray(ejCons(V,L))
  rule lcReplace(ejArray(ejCons(H,L)),Old,V) => ejArray(ejCons(H,lxUnwrapArray(lcReplace(ejArray(L),Old,V)))) requires H =/=K Old
  rule lcReplace(_,_,_) => ejMissing() [owise]
  syntax Int ::= lcRound(Int,Int,EJSON) [function]
  rule lcRound(P,D,R) => P /Int D +Int 1 requires D >Int 0 andBool R ==K ejString("ceil") andBool P %Int D =/=Int 0
  rule lcRound(P,D,R) => P /Int D requires D >Int 0 andBool (R =/=K ejString("ceil") orBool P %Int D ==Int 0)
  syntax Int ::= lcSettlement(EJSON,EJSON) [function]
  rule lcSettlement(N,C) => lcRound(lxInt(N) *Int lxInt(ejGet(C,"mantissa")),10 ^Int lxInt(ejGet(C,"scale")),ejGet(C,"rounding"))
  syntax String ::= lcConversionCode(EJSON,EJSON) [function]
