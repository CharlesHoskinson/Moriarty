requires "lifecycle-infer.k"
module MORIARTY-LIFECYCLE-DATA
  imports MORIARTY-LIFECYCLE-EXPRESSION-INFER
  // These functions operate on raw structural input; no host validation flag exists.
  syntax Int ::= lcU128() [function] | lcU64() [function] | lcS128() [function]
  rule lcU128() => 340282366920938463463374607431768211455
  rule lcU64() => 18446744073709551615
  rule lcS128() => 170141183460469231731687303715884105727
  syntax Bool ::= lcUnsigned(EJSON,Int) [function, total]
                | lcIdentifier(EJSON) [function, total]
  rule lcUnsigned(V,M) => lxDecimal(V) andBool lxInt(V) >=Int 0 andBool lxInt(V) <=Int M andBool V ==K ejString(Int2String(lxInt(V)))
  rule lcIdentifier(ejString(S)) => lxIdentifier(ejString(S))
  rule lcIdentifier(_) => false [owise]
  syntax String ::= lcClosed(EJSON,EJList) [function, total]
  rule lcClosed(ejObject(L),K) => lxFirst(lxCheck(ejKeysMatch(L,K),"UNKNOWN_FIELD"),lxCheck(ejLength(L) ==Int ejLength(K),"SCHEMA"))
  rule lcClosed(_,_) => "SCHEMA" [owise]
  syntax EJSON ::= lcFind(EJSON,String,EJSON) [function, total]
                 | lcFindPair(EJSON,EJSON,EJSON) [function, total]
  rule lcFind(ejArray(ejCons(V,L)),K,N) => V requires ejGet(V,K) ==K N
  rule lcFind(ejArray(ejCons(V,L)),K,N) => lcFind(ejArray(L),K,N) requires ejGet(V,K) =/=K N
  rule lcFind(_,_,_) => ejMissing() [owise]
  rule lcFindPair(ejArray(ejCons(V,L)),P,A) => V requires ejGet(V,"party") ==K P andBool ejGet(V,"asset") ==K A
  rule lcFindPair(ejArray(ejCons(V,L)),P,A) => lcFindPair(ejArray(L),P,A) requires ejGet(V,"party") =/=K P orBool ejGet(V,"asset") =/=K A
  rule lcFindPair(_,_,_) => ejMissing() [owise]
  syntax EJList ::= lcColumn(EJList,String) [function, total]
  rule lcColumn(ejNil(),_) => ejNil()
  rule lcColumn(ejCons(V,L),K) => ejCons(ejGet(V,K),lcColumn(L,K))
  syntax Bool ::= lcUnique(EJList) [function, total] | lcSubset(EJList,EJList) [function, total] | lcPairUnique(EJList) [function, total]
  rule lcUnique(ejNil()) => true
  rule lcUnique(ejCons(V,L)) => notBool ejMember(V,L) andBool lcUnique(L)
  rule lcSubset(ejNil(),_) => true
  rule lcSubset(ejCons(V,L),R) => ejMember(V,R) andBool lcSubset(L,R)
  rule lcPairUnique(ejNil()) => true
  rule lcPairUnique(ejCons(V,L)) => lcFindPair(ejArray(L),ejGet(V,"party"),ejGet(V,"asset")) ==K ejMissing() andBool lcPairUnique(L)
  syntax String ::= lcRow(String,EJSON) [function, total]
                  | lcRows(String,EJSON) [function, total]
                  | lcRowsList(String,EJList) [function, total]
  rule lcRows(K,ejArray(L)) => lxFirst(lxCheck(ejLength(L) <=Int 128,"CAPACITY"),lcRowsList(K,L))
  rule lcRows(_,_) => "SCHEMA" [owise]
  rule lcRowsList(_,ejNil()) => ""
  rule lcRowsList(K,ejCons(V,L)) => lxFirst(lcRow(K,V),lcRowsList(K,L))
  rule lcRow("identifier",V) => lxCheck(lcIdentifier(V),"INVALID_IDENTIFIER")

  rule lcRow("conversion",V) => lxFirst(lcClosed(V,ejCons(ejString("mantissa"),ejCons(ejString("scale"),ejCons(ejString("rounding"),ejNil())))),lxFirst(lxCheck(lcUnsigned(ejGet(V,"mantissa"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"scale"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(ejGet(V,"rounding") ==K ejString("none") orBool ejGet(V,"rounding") ==K ejString("floor") orBool ejGet(V,"rounding") ==K ejString("ceil"),"SCHEMA"),lxFirst(lxCheck(lxInt(ejGet(V,"mantissa")) >Int 0,"INVARIANT"),lxFirst(lxCheck(lxInt(ejGet(V,"scale")) <=Int 18,"INVARIANT"),""))))))
  rule lcRow("terms",V) => lxFirst(lcClosed(V,ejCons(ejString("numerator"),ejCons(ejString("denominator"),ejCons(ejString("rounding"),ejCons(ejString("periodSeconds"),ejCons(ejString("firstPeriodStart"),ejNil())))))),lxFirst(lxCheck(lcUnsigned(ejGet(V,"numerator"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"denominator"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(ejGet(V,"rounding") ==K ejString("floor") orBool ejGet(V,"rounding") ==K ejString("ceil"),"SCHEMA"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"periodSeconds"),lcU64()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"firstPeriodStart"),lcU64()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"denominator")) >Int 0,"INVARIANT"),lxFirst(lxCheck(lxInt(ejGet(V,"periodSeconds")) >Int 0,"INVARIANT"),""))))))))
  rule lcRow("balance",V) => lxFirst(lcClosed(V,ejCons(ejString("party"),ejCons(ejString("asset"),ejCons(ejString("amount"),ejNil())))),lxFirst(lxCheck(lcIdentifier(ejGet(V,"party")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"asset")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"amount"),lcU128()),"INVALID_AMOUNT"),""))))
  rule lcRow("allowance",V) => lxFirst(lcClosed(V,ejCons(ejString("party"),ejCons(ejString("asset"),ejCons(ejString("remaining"),ejCons(ejString("spent"),ejNil()))))),lxFirst(lxCheck(lcIdentifier(ejGet(V,"party")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"asset")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"remaining"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"spent"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"remaining")) +Int lxInt(ejGet(V,"spent")) <=Int lcU128(),"INVARIANT"),""))))))
  rule lcRow("work",V) => lxFirst(lcClosed(V,ejCons(ejString("remaining"),ejCons(ejString("spent"),ejCons(ejString("closureReserve"),ejNil())))),lxFirst(lxCheck(lcUnsigned(ejGet(V,"remaining"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"spent"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"closureReserve"),lcU128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"remaining")) +Int lxInt(ejGet(V,"spent")) +Int lxInt(ejGet(V,"closureReserve")) <=Int lcU128(),"INVARIANT"),"")))))
  rule lcRow("obligation",V) => lxFirst(lcClosed(V,ejCons(ejString("id"),ejCons(ejString("debtor"),ejCons(ejString("creditor"),ejCons(ejString("denomination"),ejCons(ejString("settlementAsset"),ejCons(ejString("principal"),ejCons(ejString("accrued"),ejCons(ejString("outstanding"),ejCons(ejString("allocationRule"),ejCons(ejString("conversion"),ejCons(ejString("status"),ejCons(ejString("originationId"),ejCons(ejString("originationTransferId"),ejCons(ejString("initialPrincipal"),ejCons(ejString("nominalLiabilityCap"),ejCons(ejString("liabilityIncurred"),ejCons(ejString("accrualTerms"),ejCons(ejString("lastAccruedPeriod"),ejCons(ejString("nextAccrualAt"),ejNil())))))))))))))))))))),lxFirst(lxCheck(lcIdentifier(ejGet(V,"id")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"debtor")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"creditor")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"denomination")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"settlementAsset")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"principal"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"accrued"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"outstanding"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(ejGet(V,"allocationRule") ==K ejString("AccrualFirst") orBool ejGet(V,"allocationRule") ==K ejString("PrincipalFirst") orBool ejGet(V,"allocationRule") ==K ejString("ProRata"),"SCHEMA"),lxFirst(lcRow("conversion",ejGet(V,"conversion")),lxFirst(lxCheck(ejGet(V,"status") ==K ejString("Outstanding") orBool ejGet(V,"status") ==K ejString("Settled"),"SCHEMA"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"originationId")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcIdentifier(ejGet(V,"originationTransferId")),"INVALID_IDENTIFIER"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"initialPrincipal"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"initialPrincipal")) >Int 0,"INVARIANT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"nominalLiabilityCap"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"nominalLiabilityCap")) >Int 0,"INVARIANT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"liabilityIncurred"),lcS128()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"liabilityIncurred")) >Int 0,"INVARIANT"),lxFirst(lcRow("terms",ejGet(V,"accrualTerms")),lxFirst(lxCheck(lcUnsigned(ejGet(V,"lastAccruedPeriod"),lcU64()),"INVALID_AMOUNT"),lxFirst(lxCheck(lcUnsigned(ejGet(V,"nextAccrualAt"),lcU64()),"INVALID_AMOUNT"),lxFirst(lxCheck(lxInt(ejGet(V,"principal")) +Int lxInt(ejGet(V,"accrued")) ==Int lxInt(ejGet(V,"outstanding")),"INVARIANT"),lxFirst(lxCheck((ejGet(V,"status") ==K ejString("Outstanding")) ==Bool (lxInt(ejGet(V,"outstanding")) >Int 0),"INVARIANT"),lxFirst(lxCheck(lxInt(ejGet(V,"principal")) <=Int lxInt(ejGet(V,"initialPrincipal")) andBool lxInt(ejGet(V,"initialPrincipal")) <=Int lxInt(ejGet(V,"liabilityIncurred")) andBool lxInt(ejGet(V,"liabilityIncurred")) <=Int lxInt(ejGet(V,"nominalLiabilityCap")),"INVARIANT"),lxFirst(lxCheck(lxInt(ejGet(V,"accrued")) <=Int lxInt(ejGet(V,"liabilityIncurred")) -Int lxInt(ejGet(V,"initialPrincipal")),"INVARIANT"),lxFirst(lxCheck(lxInt(ejGet(V,"lastAccruedPeriod")) <Int lcU64() andBool lcNextAt(V) <=Int lcU64() andBool lcNextAt(V) ==Int lxInt(ejGet(V,"nextAccrualAt")),"INVARIANT"),""))))))))))))))))))))))))))))
  syntax Int ::= lcNextAt(EJSON) [function, total] | lcPeriodSum(EJList) [function, total]
  rule lcNextAt(V) => lxInt(ejGet(ejGet(V,"accrualTerms"),"firstPeriodStart")) +Int ((lxInt(ejGet(V,"lastAccruedPeriod")) +Int 1) *Int lxInt(ejGet(ejGet(V,"accrualTerms"),"periodSeconds")))
  rule lcPeriodSum(ejNil()) => 0
  rule lcPeriodSum(ejCons(V,L)) => lxInt(ejGet(V,"lastAccruedPeriod")) +Int lcPeriodSum(L)
  syntax String ::= lcState(EJSON) [function, total]

  rule lcState(V) => lxFirst(lcClosed(V,ejCons(ejString("schemaVersion"),ejCons(ejString("balances"),ejCons(ejString("allowances"),ejCons(ejString("obligations"),ejCons(ejString("usedTransferIds"),ejCons(ejString("usedAllocationIds"),ejCons(ejString("usedOriginationIds"),ejCons(ejString("usedAccrualIds"),ejCons(ejString("work"),ejNil())))))))))),lxFirst(lxCheck(ejGet(V,"schemaVersion") ==K ejString("moriarty-financial-lifecycle-state/1"),"SCHEMA"),lxFirst(lcRows("balance",ejGet(V,"balances")),lxFirst(lxCheck(lcPairUnique(lxUnwrapArray(ejGet(V,"balances"))),"DUPLICATE"),lxFirst(lcRows("allowance",ejGet(V,"allowances")),lxFirst(lxCheck(lcPairUnique(lxUnwrapArray(ejGet(V,"allowances"))),"DUPLICATE"),lxFirst(lcRows("obligation",ejGet(V,"obligations")),lxFirst(lxCheck(lcUnique(lcColumn(lxUnwrapArray(ejGet(V,"obligations")),"id")),"DUPLICATE"),lxFirst(lxCheck(lcUnique(lcColumn(lxUnwrapArray(ejGet(V,"obligations")),"originationId")),"DUPLICATE"),lxFirst(lxCheck(lcUnique(lcColumn(lxUnwrapArray(ejGet(V,"obligations")),"originationTransferId")),"DUPLICATE"),lxFirst(lcRows("identifier",ejGet(V,"usedTransferIds")),lxFirst(lxCheck(lcUnique(lxUnwrapArray(ejGet(V,"usedTransferIds"))),"DUPLICATE"),lxFirst(lcRows("identifier",ejGet(V,"usedAllocationIds")),lxFirst(lxCheck(lcUnique(lxUnwrapArray(ejGet(V,"usedAllocationIds"))),"DUPLICATE"),lxFirst(lcRows("identifier",ejGet(V,"usedOriginationIds")),lxFirst(lxCheck(lcUnique(lxUnwrapArray(ejGet(V,"usedOriginationIds"))),"DUPLICATE"),lxFirst(lcRows("identifier",ejGet(V,"usedAccrualIds")),lxFirst(lxCheck(lcUnique(lxUnwrapArray(ejGet(V,"usedAccrualIds"))),"DUPLICATE"),lxFirst(lcRow("work",ejGet(V,"work")),lxFirst(lxCheck(lxArrayLength(ejGet(V,"usedOriginationIds")) ==Int lxArrayLength(ejGet(V,"obligations")),"INVARIANT"),lxFirst(lxCheck(lcSubset(lcColumn(lxUnwrapArray(ejGet(V,"obligations")),"originationId"),lxUnwrapArray(ejGet(V,"usedOriginationIds"))),"INVARIANT"),lxFirst(lxCheck(lcSubset(lcColumn(lxUnwrapArray(ejGet(V,"obligations")),"originationTransferId"),lxUnwrapArray(ejGet(V,"usedTransferIds"))),"INVARIANT"),lxFirst(lxCheck(lcPeriodSum(lxUnwrapArray(ejGet(V,"obligations"))) ==Int lxArrayLength(ejGet(V,"usedAccrualIds")),"INVARIANT"),"")))))))))))))))))))))))
endmodule
