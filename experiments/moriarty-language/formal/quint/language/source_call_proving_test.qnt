// Independent literal proposals; no expected()/producer helper constructs them.
// Opaque SDK/VM IDs are stipulated external oracle values, not native measurements.
module source_call_proving_test {
  import source_call_proving.* from "./source_call_proving"
  pure val literalOperation: Operation = {ir:21,vk:71,legacyKeyPresent:false}
  pure val literalA: Statement = {parent:111,binding:121,communication:131,
    pi:List(121,131,141),transcript:List(151,0,152),effects:List(StateChange({name:205,before:4,after:11}),TransferEffect({asset:201,from:202,dst:203,amount:7}),TransferEffect({asset:201,from:202,dst:203,amount:7}),FeeEffect({asset:201,from:202,dst:204,amount:2}),DutyChange({name:206,asset:201,debtor:202,creditor:203,before:0,after:7}),DutyChange({name:206,asset:201,debtor:202,creditor:203,before:7,after:4}),UIntEmit({name:207,value:11}),BoolEmit({name:208,value:true})),running:11,
    charge:4,balances:List(84,19,3),chargedState:161,events:List(11,1),
    measuredGas:171,declaredGas:181,
    envelope:{offers:81,ttl:91,randomness:101,actions:List(51)},version:3}
  pure val literalB: Statement = {parent:112,binding:122,communication:132,
    pi:List(122,132,142),transcript:List(151,0,0,152),effects:List(StateChange({name:205,before:31,after:34}),TransferEffect({asset:201,from:202,dst:203,amount:3}),TransferEffect({asset:201,from:202,dst:203,amount:3}),FeeEffect({asset:201,from:202,dst:204,amount:2}),DutyChange({name:206,asset:201,debtor:202,creditor:203,before:9,after:12}),DutyChange({name:206,asset:201,debtor:202,creditor:203,before:12,after:9}),UIntEmit({name:207,value:34}),BoolEmit({name:208,value:true})),running:34,
    charge:9,balances:List(92,11,3),chargedState:162,events:List(34,1),
    measuredGas:172,declaredGas:182,
    envelope:{offers:81,ttl:91,randomness:101,actions:List(51)},version:3}
  action ready(c: Case,b: Binding): bool = init.then(prepare(c,11))
    .then(derive(11,SourceRecompiled)).then(check(51)).then(resolve(51))
    .then(split).then(sdkProve(1,0,b))
  run literalATest = ready(A,Supplied(121)).expect(state.statement == literalA)
    .then(verify(literalA,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess))
    .expect(state.phase == Verified and finalStatementExactness)
  run literalBTest = ready(B,Supplied(122)).expect(state.statement == literalB)
    .then(verify(literalB,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess))
    .expect(state.phase == Verified and finalStatementExactness)
  run contrastingSameSourceKeyTest = ready(A,Supplied(121))
    .expect(state.key.ir == 21 and state.key.vk == 71 and state.statement.running == 11)
    .then(ready(B,Supplied(122)))
    .expect(state.key.ir == 21 and state.key.vk == 71 and state.statement.running == 34)
  run sourceAndImportRefusalTest = init.expect(not(canPrepare(state,12)))
    .then(prepare(A,11)).expect(not(canDerive(state,12,SourceRecompiled)))
    .expect(not(canDerive(state,11,ImportedClaim))).then(derive(11,SourceRecompiled))
    .expect(not(canCheck(state,52))).then(check(51)).expect(not(canResolve(state,52)))
    .then(resolve(51)).expect(snapshotIdentity)
  run changedSourcePrepareTest = init.then(prepare(A,12).fail())
  run changedSourceDeriveTest = init.then(prepare(A,11)).then(derive(12,SourceRecompiled).fail())
  run importedClaimTest = init.then(prepare(A,11)).then(derive(11,ImportedClaim).fail())
  run unknownCheckLocationTest = init.then(prepare(A,11)).then(derive(11,SourceRecompiled))
    .then(check(52).fail())
  run unknownResolveLocationTest = init.then(prepare(A,11)).then(derive(11,SourceRecompiled))
    .then(check(51)).then(resolve(52).fail())
  run immutableSnapshotTest = init.then(prepare(A,11)).then(derive(11,SourceRecompiled))
    .then(changeUntrustedArtifact).then(check(51)).then(resolve(51)).then(split)
    .expect(state.changedUntrustedArtifact and snapshotIdentity)
    .expect(not(canSdkProve({...state,resolvedKey:{...state.key,pk:62}},1,0,Supplied(121))))
    .expect(not(canSdkProve({...state,splitKey:{...state.key,vk:72}},1,0,Supplied(121))))
    .expect(not(canSdkProve({...state,checkedKey:{...state.key,ir:22}},1,0,Supplied(121))))
    .then(sdkProve(1,0,Supplied(121))).expect(singleExpansion)
  action beforeSdk: bool = init.then(prepare(A,11)).then(derive(11,SourceRecompiled))
    .then(check(51)).then(resolve(51)).then(split)
  run rawOwnershipRefusalTest = beforeSdk
    .expect(not(canSdkProve(state,2,0,Supplied(121))))
    .expect(not(canSdkProve(state,1,1,Supplied(121))))
    .expect(not(canSdkProve(state,1,0,Missing)))
    .then(sdkProve(1,0,Supplied(121))).expect(singleExpansion)
    .expect(not(canSdkProve(state,1,0,Supplied(121))))
  run wrongRawOwnerTest = beforeSdk.then(sdkProve(2,0,Supplied(121)).fail())
  run processedInputTest = beforeSdk.then(sdkProve(1,1,Supplied(121)).fail())
  run missingFinalBindingTest = beforeSdk.then(sdkProve(1,0,Missing).fail())
  run doubleProveTest = ready(A,Supplied(121)).then(sdkProve(1,0,Supplied(121)).fail())
  // Presence does not mean nonzero: provider accepts supplied zero. Final SDK
  // statement equality is where an incorrect binding must be refused.
  run overwrittenZeroBindingTest = ready(A,Supplied(0))
    .expect(state.statement.binding == 0 and state.statement.pi == List(0,131,141))
    .then(verify(state.statement,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run overwrittenWrongBindingTest = ready(A,Supplied(999))
    .expect(state.statement.binding == 999)
    .then(verify(state.statement,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run parentRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,parent:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run bindingRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,binding:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run communicationRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,communication:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run piMissingRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,pi:List(121,131)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run piOrderRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,pi:List(131,121,141)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run transcriptExtraRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,transcript:List(151,0,0,152)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run effectsMissingRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,effects:literalA.effects.tail()},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run feeValueRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,effects:literalA.effects.replaceAt(3,FeeEffect({asset:201,from:202,dst:204,amount:3}))},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run runningRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,running:12},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run chargeRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,charge:5},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run balancesRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,balances:List(84,19,4)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run chargedStateRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,chargedState:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run eventOrderRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,events:List(1,11)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run measuredGasRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,measuredGas:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run declaredGasRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,declaredGas:999},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run ttlRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,envelope:{...literalA.envelope,ttl:999}},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run offersRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,envelope:{...literalA.envelope,offers:999}},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run randomnessRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,envelope:{...literalA.envelope,randomness:999}},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run extraActionRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,envelope:{...literalA.envelope,actions:List(51,52)}},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run proofVersionRefusalTest = ready(A,Supplied(121))
    .then(verify({...literalA,version:2},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run otherScenarioRefusalTest = ready(A,Supplied(121))
    .then(verify(literalB,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run operationirRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,{ir:22,vk:71,legacyKeyPresent:false},ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run operationvkRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,{ir:21,vk:72,legacyKeyPresent:false},ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run operationlegacyRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,{ir:21,vk:71,legacyKeyPresent:true},ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run preimageMarkerRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,literalOperation,PreimageMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run erasedMarkerRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,literalOperation,ErasedMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run mockRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,literalOperation,ProofMarker,Mock,Verifying,VerifierReturnedSuccess).fail())
  run compiledOutRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,literalOperation,ProofMarker,Real,CompiledOut,VerifierReturnedSuccess).fail())
  run cryptoFailureRefusalTest = ready(A,Supplied(121))
    .then(verify(literalA,literalOperation,ProofMarker,Real,Verifying,VerifierReturnedFailure).fail())
  // Deliberately inadequate validators are independent negative controls.
  pure def weakKeyOnly(op: Operation): bool = op.vk == 71
  pure def weakRunningOnly(st: Statement): bool = st.running == 11
  run distinguishingWeakGuardsTest = ready(A,Supplied(121))
    .expect(weakKeyOnly({ir:22,vk:71,legacyKeyPresent:false}))
    .expect(not(canVerify(state,literalA,{ir:22,vk:71,legacyKeyPresent:false},ProofMarker,Real,Verifying,VerifierReturnedSuccess)))
    .expect(weakRunningOnly({...literalA,measuredGas:999,pi:List(0)}))
    .expect(not(canVerify(state,{...literalA,measuredGas:999,pi:List(0)},literalOperation,ProofMarker,Real,Verifying,VerifierReturnedSuccess)))
  run identityDriftTest = init.then(prepare(A,11)).then(derive(11,SourceRecompiled))
    .expect(not(canCheck({...state,key:{...state.key,source:12}},51)))
    .expect(not(canCheck({...state,key:{...state.key,ir:22}},51)))
    .expect(not(canCheck({...state,key:{...state.key,manifest:32}},51)))
    .expect(not(canCheck({...state,key:{...state.key,closure:42}},51)))
    .expect(not(canCheck({...state,key:{...state.key,pk:62}},51)))
    .expect(not(canCheck({...state,key:{...state.key,vk:72}},51)))
    .expect(not(canCheck({...state,key:{...state.key,degree:18}},51)))
    .expect(not(canCheck({...state,key:{...state.key,entrypoint:52}},51)))
    .expect(not(canCheck({...state,key:{...state.key,origin:ImportedClaim}},51)))
  run missingOperationIrTest = ready(A,Supplied(121))
    .then(verify(literalA,{ir:0,vk:71,legacyKeyPresent:false},ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run missingOperationVkTest = ready(A,Supplied(121))
    .then(verify(literalA,{ir:21,vk:0,legacyKeyPresent:false},ProofMarker,Real,Verifying,VerifierReturnedSuccess).fail())
  run invariantsAtInitTest = init.expect(rawOwnership and snapshotIdentity and singleExpansion and finalStatementExactness)
  // Representation-only smoke: no assertion of Rust arithmetic correspondence.
  run u128RepresentationTest = init
    .expect(340282366920938463463374607431768211455 + 1 == 340282366920938463463374607431768211456)
}
