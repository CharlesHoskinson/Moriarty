include "arithmetic";
export ledger output: Uint<128>;
export circuit multiply(a: Uint<128>, b: Uint<128>, h: MulHint): [] {
  output = disclose(checkedMul(a, b, h));
}
export circuit divide(n: Uint<128>, d: Uint<128>, q: Uint<128>, r: Uint<128>, h: MulHint): [] {
  output = disclose(checkedDiv(n, d, q, r, h));
}
