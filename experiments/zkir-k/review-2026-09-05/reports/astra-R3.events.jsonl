 <k> #input(boolOk(true), T, O, \"public\") => #put(O, #decodeSlice(#prePubOut(Pre), Idx, T, Strict)) ... </k>\n   379\t       <pre> Pre </pre> <pubOutIdx> Idx => Idx +Int encodedLen(T) </pubOutIdx> <genMode> false </genMode> <strictDecode> Strict </strictDecode>\n   380\t    requires Idx +Int encodedLen(T) >Int size(#prePubOut(Pre))\n   381\t  rule <k> #input(boolOk(true), T, O, \"public\") => .K ... </k> <mem> M => M[O <- defaultValue(T)] </mem>\n   382\t       <pre> Pre </pre> <pubOutIdx> Idx => Idx +Int encodedLen(T) </pubOutIdx> <genMode> true </genMode>\n   383\t       <needs> N => N ListItem(needPubOut(T)) </needs>\n   384\t    requires Idx +Int encodedLen(T) >Int size(#prePubOut(Pre))\n   385\t  rule <k> #input(boolOk(true), T, O, \"private\") => #put(O, #decodeSlice(#prePrivate(Pre), Idx, T, Strict)) ... </k>\n   386\t       <pre> Pre </pre> <privIdx> Idx => Idx +Int encodedLen(T) </privIdx> <strictDecode> Strict </strictDecode>\n   387\t    requires Idx +Int encodedLen(T) <=Int size(#prePrivate(Pre))\n   388\t  rule <k> #input(boolOk(true), T, O, \"private\") => #put(O, #decodeSlice(#prePrivate(Pre), Idx, T, Strict)) ... </k>\n   389\t       <pre> Pre </pre> <privIdx> Idx => Idx +Int encodedLen(T) </privIdx> <genMode> false </genMode> <strictDecode> Strict </strictDecode>\n   390\t    requires Idx +Int encodedLen(T) >Int size(#prePrivate(Pre))\n   391\t  rule <k> #input(boolOk(true), T, O, \"private\") => .K ... </k> <mem> M => M[O <- defaultValue(T)] </mem>\n   392\t       <pre> Pre </pre> <privIdx> Idx => Idx +Int encodedLen(T) </privIdx> <genMode> true </genMode>\n   393\t       <needs> N => N ListItem(needPriv(T)) </needs>\n   394\t    requires Idx +Int encodedLen(T) >Int size(#prePrivate(Pre))\n   395\t  // The Rust code indexes the slice directly and panics past the end; we report it.\n   396\t  // (The Rust code indexes the transcript slice directly and panics with an\n   397\t  // index-out-of-range when it is too short; here that is an error.)\n  