F>>, Error> {\n   927\t        let f_num_bytes = F::NUM_BITS.div_ceil(8);\n   928\t        let nb_bytes = nb_bytes.unwrap_or(f_num_bytes as usize);\n   929\t        if nb_bytes > f_num_bytes as usize {\n   930\t            panic!(\"assigned_to_le_bytes: why do you need the output to have more bytes than necessary?\");\n   931\t        }\n   932\t        // If nb_bytes equals ⌈F::NUM_BITS / 8⌉, we need extra care to\n   933\t        // guarantee that the output is canonical: we split in bits enforcing canonicity\n   934\t        // and then group the bits in bytes.\n   935\t        if nb_bytes == f_num_bytes as usize {\n   936\t            let bits = self.assigned_to_le_bits(layouter, x, Some(F::NUM_BITS as usize), true)?;\n   937\t            bits.chunks(8)\n   938\t                .map(|chunk| {\n   939\t                    let terms = chunk\n   940\t                        .iter()\n   941\t                        .enumerate()\n   942\t                        .map(|(i, bit)| (F::from(1 << i), bit.clone().into()))\n   943\t                        .collect::<Vec<_>>();\n   944\t                    let byte = self.linear_combination(layouter, &terms, F::ZERO)?;\n   945\t                    self.convert_unsafe(layouter, &byte)\n   946\t                })\n   947\t                .collect::<Result<Vec<AssignedByte<F>>, Error>>()\n   786\t    fn point_from_coordinates(\n   787\t        &self,\n   788\t        layouter: &mut impl Layouter<C::Base>,\n   789\t        x: &Self::Coordinate,\n   790\t        y: &Self::Coordinate,\n   791\t    ) -> Result<Self::Point, Error> {\n   792\t        let point_val = x.value().zip(y.value()).map(|(x, y)| {\n   793\t            C::from_xy(*x, *y)\n   794\t                .expect(\"Affine coordinates must satisfy Jubjub equation.\")\n   795\t                .into_subgroup()\n   796\t        });\n   797\t        let point: Self::Point = self.assign(layouter, point_val)?;\n   798\t        self.native_gadget.assert_equal(layouter, x, &point.x)?;\n   799\t        self.native_gadget.assert_equal(layouter, y, &point.y)?;\n   800\t        Ok(point)\n   801\t    }\n   802\t\n   803\t    fn assign_without_subgroup_check(\n   804\t        &self,\n   805\t        layouter: &mut impl Layouter<C::Base>,\n   806\t        value: Value<C::CryptographicGroup>,\n   807\t    ) -> Result<Self::Point, Error> {\n   808\t        let config = self.config();\n   809\t        let (x_val, y_val) = value\n   810\t            .map(|p| p.into().coordinates().expect(\"assign_without_subgroup_check: invalid point\"))\n   811\t            .unzip();\n   812\t\n   813\t        layouter.assign_region(\n   814\t            || \"assign point without subgroup check\",\n   836\t    fn base_field(&self) -> &impl DecompositionInstructions<C::Base, Self::Coordinate> {\n   837\t        &self.native_gadget\n   838\t    }\n   839\t}\n   840\t\n   841\timpl<C: EdwardsCurve> AssignmentInstructions<C::Base, AssignedNativePoint<C>> for EccChip<C> {\n   842\t    fn assign(\n   843\t        &self,\n   844\t        layouter: &mut impl Layouter<C::Base>,\n   845\t        value: Value<C::CryptographicGroup>,\n   846\t    ) -> Result<AssignedNativePoint<C>, Error> {\n   847\t        // Ensure the point lies in the correct subgroup.\n   848\t        // To achieve this, we first assign the point multiplied by the inverse of the\n   849\t        // cofactor. Then, we return the assigned point after multiplying it by\n   850\t        // the cofactor.\n   851\t        let cofactor = C::ScalarField::from_u128(C::COFACTOR);\n   852\t        let cf_root_val = value.map(|p| p * cofactor.invert().expect(\"Cofactor must not be 0\"));\n   853\t        let cf_root = self.assign_without_subgroup_check(layouter, cf_root_val)?;\n   854\t\n   855\t        self.clear_cofactor(layouter, &cf_root)\n   856\t    }\n   857\t\n   858\t    fn assign_fixed(\n   859\t        &self,\n   860\t        layouter: &mut impl Layouter<C::Base>,\n   861\t        constant: C::CryptographicGroup,\n   862\t    ) -> Result<AssignedNativePoint<C>, Error> {\n   863\t        let coords = constant.into().coordinates().unwrap();\n   864\t        let x = self.native_gadget.assign_fixed(layouter, coords.0)?;\n   865\t        let y = self.native_gadget.assign_fixed(layouter, coords.1)?;\n   866\t        Ok(AssignedNativePoint {\n   867\t            x,\n   868\t            y,\n   869\t            checked_in_subgroup: true,\n   870\t        })\n   871\t    }\n   872\t}\n   873\t\n   874\timpl<C: EdwardsCurve> AssignmentInstructions<C::Base, AssignedScalarOfNativeCurve<C>>\n   875\t    for EccChip<C>\n   876\t{\n   877\t    fn assign(\n   878\t        &self,\n   879\t        layouter: &mut impl Layouter<C::Base>,\n   880\t        value: Value<C::ScalarField>,\n   881\t    ) -> Result<AssignedScalarOfNativeCurve<C>, Error> {\n   882\t        let bits = value\n   883\t            .map(|s| s.to_bits_le(Some(C::ScalarField::NUM_BITS as usize)))\n   884\t            .transpose_vec(<C::ScalarField as PrimeField>::NUM_BITS as usize);\n   885\t        Ok(AssignedScalarOfNativeCurve {\n   886\t            bits: self.native_gadget.assign_many(layouter, &bits)?,\n   887\t            enforced_canonical: false,\n   888\t        })\n   889\t    }\n   890\t\n   891\t    fn assign_fixed(\n   892\t        &self,\n   893\t        layouter: &mut impl Layouter<C::Base>,\n   894\t        constant: C::ScalarField,\n   895\t    ) -> Result<AssignedScalarOfNativeCurve<C>, Error> {\n   896\t        Ok(AssignedScalarOfNativeCurve {\n   897\t            bits: self.native_gadget.assign_many_fixed(layouter, &constant.to_bits_le(None))?,\n   898\t            enforced_canonical: true,\n   899\t        })\n   900\t    }\n   901\t}\n   902\t\n   903\timpl<C: EdwardsCurve> AssertionInstructions<C::Base, AssignedNativePoint<C>> for EccChip<C> {\n   904\t    fn assert_equal(\n  1030\t}\n  1031\t\n  1032\timpl<C: EdwardsCurve> PublicInputInstructions<C::Base, AssignedScalarOfNativeCurve<C>>\n  1033\t    for EccChip<C>\n  1034\t{\n  1035\t    fn as_public_input(\n  1036\t        &self,\n  1037\t        layouter: &mut impl Layouter<C::Base>,\n  1038\t        assigned: &AssignedScalarOfNativeCurve<C>,\n  1039\t    ) -> Result<Vec<AssignedNative<C::Base>>, Error> {\n  1040\t        // We aggregate the bits while they fit in a single `AssignedNative`.\n  1041\t        let nb_bits_per_batch = C::Base::NUM_BITS as usize - 1;\n  1042\t        assigned\n  1043\t            .bits\n  1044\t            .chunks(nb_bits_per_batch)\n  1045\t            .map(|chunk| self.native_gadget.assigned_from_le_bits(layouter, chunk))\n  1046\t            .collect()\n  1047\t    }\n  1048\t\n  1049\t    fn constrain_as_public_input(\n  1050\t        &self,\n  1051\t        layouter: &mut impl Layouter<C::Base>,\n  1052\t        assigned: &AssignedScalarOfNativeCurve<C>,\n  1053\t    ) -> Result<(), Error> {\n  1054\t        self.as_public_input(layouter, assigned)?\n  1055\t            .iter()\n  1360\t    /// Creates an assigned Jubjub scalar from an integer represented as a\n  1361\t    /// sequence of little-endian bytes.\n  1362\t    pub fn scalar_from_le_bytes(\n  1363\t        &self,\n  1364\t        layouter: &mut impl Layouter<C::Base>,\n  1365\t        bytes: &[AssignedByte<C::Base>],\n  1366\t    ) -> Result<AssignedScalarOfNativeCurve<C>, Error> {\n  1367\t        let mut bits = Vec::with_capacity(bytes.len() * 8);\n  1368\t        for byte in bytes {\n  1369\t            let byte_as_f: AssignedNative<C::Base> = self.native_gadget.convert(layouter, byte)?;\n  1370\t            bits.extend(self.native_gadget.assigned_to_le_bits(\n  1371\t                layouter,\n  1372\t                &byte_as_f,\n  1373\t                Some(8),\n  1374\t                true,\n  1375\t            )?)\n  1376\t        }\n  1377\t        Ok(AssignedScalarOfNativeCurve {\n  1378\t            bits,\n  1379\t            enforced_canonical: false,\n  1380\t        })\n  1381\t    }\n  1382\t}\n  