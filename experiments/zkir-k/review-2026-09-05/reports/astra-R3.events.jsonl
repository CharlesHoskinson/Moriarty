JubjubPoint).collect()),\n    83\t\n    84\t        IrType::JubjubScalar => std_lib\n    85\t            .jubjub()\n    86\t            .assign_many(layouter, &convert_values::<JubjubFr>(values)?)\n    87\t            .map(|xs| xs.into_iter().map(CircuitValue::JubjubScalar).collect()),\n    88\t\n    89\t        IrType::Secp256k1Point => std_lib\n    90\t            .secp256k1()\n    91\t            .assign_many(layouter, &convert_values::<k256::K256>(values)?)\n    92\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256k1Point).collect()),\n    93\t\n    94\t        IrType::Secp256k1Base => std_lib\n    95\t            .secp256k1()\n    96\t            .base_field_chip()\n    97\t            .assign_many(layouter, &convert_values::<k256::Fp>(values)?)\n    98\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256k1Base).collect()),\n    99\t\n   100\t        IrType::Secp256k1Scalar => std_lib\n   101\t            .secp256k1()\n   102\t            .scalar_field_chip()\n   103\t            .assign_many(layouter, &convert_values::<k256::Fq>(values)?)\n   104\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256k1Scalar).collect()),\n   105\t\n   106\t        IrType::Secp256r1Point => std_lib\n   107\t            .p256()\n   108\t            .assign_many(layouter, &convert_values::<p256::P256>(values)?)\n   109\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256r1Point).collect()),\n   110\t\n   111\t        IrType::Secp256r1Base => std_lib\n   112\t            .p256()\n   113\t            .base_field_chip()\n   114\t            .assign_many(layouter, &convert_values::<p256::Fp>(values)?)\n   115\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256r1Base).collect()),\n   116\t\n   117\t        IrType::Secp256r1Scalar => std_lib\n   118\t            .p256()\n   119\t            .scalar_field_chip()\n   120\t            .assign_many(layouter, &convert_values::<p256::Fq>(values)?)\n   121\t            .map(|xs| xs.into_iter().map(CircuitValue::Secp256r1Scalar).collect()),\n   122\t\n   123\t        IrType::Curve25519Point => std_lib\n   124\t            .curve25519()\n   125\t            .assign_many(\n   126\t                layouter,\n   127\t                &convert_values::<curve25519::Curve25519Subgroup>(values)?,\n   128\t            )\n   129\t            .map(|xs| xs.into_iter().map(CircuitValue::Curve25519Point).collect()),\n   130\t\n   131\t        IrType::Curve25519Base => std_lib\n   132\t            .curve25519()\n   133\t            .base_field_chip()\n   134\t            .assign_many(layouter, &convert_values::<curve25519::Fp>(values)?)\n   135\t            .map(|xs| xs.into_iter().map(CircuitValue::Curve25519Base).collect()),\n   136\t\n   137\t        IrType::Curve25519Scalar => std_lib\n   138\t            .curve25519()\n   139\t            .scalar_field_chip()\n   140\t            .assign_many(layouter, &convert_values::<curve25519::Scalar>(values)?)\n   141\t            .map(|xs| xs.into_iter().map(CircuitValue::Curve25519Scalar).collect()),\n   142\t    }\n   143\t}\n     1\t// This file is part of midnight-ledger.\n     2\t// Copyright (C) Midnight Foundation\n     3\t// SPDX-License-Identifier: Apache-2.0\n     4\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t// You may not use this file except in compliance with the License.\n     6\t// You may obtain a copy of the License at\n     7\t// http://www.apache.org/licenses/LICENSE-2.0\n     8\t// Unless required by applicable law or agreed to in writing, software\n     9\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    10\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\tuse midnight_circuits::{\n    15\t    CircuitField,\n    16\t    ecc::foreign::edwards_chip::AssignedForeignEdwardsPoint,\n    17\t    field::foreign::params::MultiEmulationParams as MEP,\n    18\t    instructions::{DecompositionInstructions, PublicInputInstructions, ZeroInstructions},\n    19\t    types::{\n    20\t        AssignedBigUint, AssignedField, AssignedForeignPoint, AssignedNative, AssignedNativePoint,\n    21\t        AssignedScalarOfNativeCurve, Instantiable,\n    22\t    },\n    23\t};\n    24\tuse midnight_curves::{Fr as JubjubFr, JubjubExtended, curve25519, k256, p256};\n    25\tuse midnight_proofs::{circuit::Layouter, plonk::Error};\n    26\tuse midnight_zk_stdlib::ZkStdLib;\n    27\tuse transient_crypto::curve::Fr;\n    28\t\n    29\tuse crate::{\n    30\t    ir_instructions::F,\n    31\t    ir_types::{CircuitValue, IrType, IrValue},\n    32\t};\n    33\tuse anyhow::anyhow;\n    34\t\n    35\t/// Encodes the given off-circuit value as a vector of IrValue::Native.\n    36\tpub fn encode_offcircuit(value: &IrValue) -> Vec<IrValue> {\n    37\t    let encoded = match value {\n    38\t        IrValue::Native(x) => AssignedNative::<F>::as_public_input(&x.0),\n    39\t        IrValue::Bytes32(bs) => {\n    40\t            let mut low: [u8; 32] = *bs;\n    41\t            low[31] = 0;\n    42\t\n    43\t            let mut high = [0u8; 32];\n    44\t            high[0] = bs[31];\n    45\t\n    46\t            vec![\n    47\t                F::from_bytes_le(&low).unwrap(),\n    48\t                F::from_bytes_le(&high).unwrap(),\n    49\t            ]\n    50\t        }\n    51\t        IrValue::JubjubPoint(p) => AssignedNativePoint::<JubjubExtended>::as_public_input(p),\n    52\t        IrValue::JubjubScalar(s) => {\n    53\t            let encoded = AssignedScalarOfNativeCurve::<JubjubExtended>::as_public_input(s);\n    54\t            // In ZKIRv3, an assigned scalar can only originate from a circuit\n    55\t            // input (PublicInput or PrivateInput), which yields canonical assigned\n    56\t            // scalars (whose internal representation uses at most 252 bits).\n    57\t            assert_eq!(encoded.len(), 1);\n    58\t            encoded\n    59\t        }\n    60\t\n    61\t        IrValue::Secp256k1Point(p) => {\n    62\t            AssignedForeignPoint::<F, k256::K256, MEP>::as_public_input(p)\n    63\t        }\n    64\t        IrValue::Secp256k1Base(s) => AssignedField::<F, k256::Fp, MEP>::as_public_input(s),\n    65\t        IrValue::Secp256k1Scalar(s) => AssignedField::<F, k256::Fq, MEP>::as_public_input(s),\n    66\t\n    67\t        IrValue::Secp256r1Point(p) => AssignedForeignPoint::<F, p256::P256, MEP>::as_public_input(p),\n    68\t        IrValue::Secp256r1Base(s) => AssignedField::<F, p256::Fp, MEP>::as_public_input(s),\n    69\t        IrValue::Secp256r1Scalar(s) => AssignedField::<F, p256::Fq, MEP>::as_public_input(s),\n    70\t\n    71\t        IrValue::Curve25519Point(p) => {\n    72\t            AssignedForeignEdwardsPoint::<F, curve25519::Curve25519, MEP>::as_public_input(p)\n    73\t        }\n    74\t        IrValue::Curve25519Base(s) => AssignedField::<F, curve25519::Fp, MEP>::as_public_input(s),\n    75\t        IrValue::Curve25519Scalar(s) => {\n    76\t            AssignedField::<F, curve25519::Scalar, MEP>::as_public_input(s)\n    77\t        }\n    78\t    };\n    79\t    encoded\n    80\t        .into_iter()\n    81\t        .map(|s| IrValue::Native(Fr(s)))\n    82\t        .collect()\n    83\t}\n    84\t\n    85\t/// Encodes the given in-circuit value as a vector of CircuitValue::Native.\n    86\tpub fn encode_incircuit(\n    87\t    std_lib: &ZkStdLib,\n    88\t    layouter: &mut impl Layouter<F>,\n    89\t    value: &CircuitValue,\n    90\t) -> Result<Vec<CircuitValue>, Error> {\n    91\t    let encoded = match value {\n    92\t        CircuitValue::Native(x) => std_lib.as_public_input(layouter, x),\n    93\t        CircuitValue::Bytes32(bs) => Ok(vec![\n    94\t            std_lib.assigned_from_le_bytes(layouter, &bs[..31])?,\n    95\t            bs[31].clone().into(),\n    96\t        ]),\n    97\t        CircuitValue::JubjubPoint(p) => std_lib.jubjub().as_public_input(layouter, p),\n    98\t        CircuitValue::JubjubScalar(s) => {\n    99\t            // Jubjub::Scalar::NUM_BITS is incorrectly set to 255 (instead of 252)\n   100\t            // in midnight-curves v0.2.0. Consequently, Jubjub scalars may be encoded\n   101\t            // unnecessarily as 2 native field values instead of one.\n   102\t            // We return the first only and make sure the rest (supposedly one more)\n   103\t            // are zero.\n   104\t            let encoded = std_lib.jubjub().as_public_input(layouter, s)?;\n   105\t            for x in encoded[1..].iter() {\n   106\t                std_lib.assert_zero(layouter, x)?;\n   107\t            }\n   108\t            Ok(encoded[..1].to_vec())\n   109\t        }\n   110\t\n   111\t        CircuitValue::Secp256k1Point(p) => std_lib.secp256k1().as_public_input(layouter, p),\n   112\t        CircuitValue::Secp256k1Base(s) => {\n   113\t            (std_lib.secp256k1().base_field_chip()).as_public_input(layouter, s)\n   114\t        }\n   115\t        CircuitValue::Secp256k1Scalar(s) => {\n   116\t            (std_lib.secp256k1().scalar_field_chip()).as_public_input(layouter, s)\n   117\t        }\n   118\t\n   119\t        CircuitValue::Secp256r1Point(p) => std_lib.p256().as_public_input(layouter, p),\n   120\t        CircuitValue::Secp256r1Base(s) => {\n   121\t            (std_lib.p256().base_field_chip()).as_public_input(layouter, s)\n   122\t        }\n   123\t        CircuitValue::Secp256r1Scalar(s) => {\n   124\t            (std_lib.p256().scalar_field_chip()).as_public_input(layouter, s)\n   125\t        }\n   126\t\n   127\t        CircuitValue::Curve25519Point(p) => std_lib.curve25519().as_public_input(layouter, p),\n   128\t        CircuitValue::Curve25519Base(s) => {\n   129\t            (std_lib.curve25519().base_field_chip()).as_public_input(layouter, s)\n   130\t        }\n   131\t        CircuitValue::Curve25519Scalar(s) => {\n   132\t            (std_lib.curve25519().scalar_field_chip()).as_public_input(layouter, s)\n   133\t        }\n   134\t    }?;\n   135\t    Ok(encoded.into_iter().map(CircuitValue::Native).collect())\n   136\t}\n   137\t\n   138\t/// Decodes the given Fr values as an IrValue of the given type.\n   139\t///\n   140\t/// # Errors\n   141\t///\n   142\t/// Returns an error if the provided raw values cannot be decoded as the given type.\n   143\tpub fn decode_offcircuit(encoded: &[Fr], val_t: &IrType) -> Result<IrValue, anyhow::Error> {\n   144\t    let encoded: Vec<F> = encoded.iter().map(|f| f.0).collect();\n   145\t    match val_t {\n   146\t        IrType::Native => AssignedNative::<F>::from_public_input(&encoded)\n   147\t            .map(Fr)\n   148\t            .map(IrValue::Native),\n   149\t\n   150\t        IrType::Bytes32 => {\n   151\t            if encoded.len() != 2 {\n   152\t                None\n   153\t            } else {\n   154\t                let mut bytes = encoded[0].to_bytes_le();\n   155\t                assert_eq!(bytes[31], 0);\n   156\t\n   157\t                let high = encoded[1].to_bytes_le();\n   158\t                for b in high.iter().skip(1) {\n   159\t                    assert_eq!(*b, 0);\n   160\t                }\n   161\t\n   162\t                bytes[31] = high[0];\n   163\t                Some(IrValue::Bytes32(bytes))\n   164\t            }\n   165\t        }\n   166\t\n   167\t        IrType::JubjubPoint => AssignedNativePoint::<JubjubExtended>::from_public_input(&encoded)\n   168\t            .map(IrValue::JubjubPoint),\n   169\t\n   170\t        IrType::JubjubScalar => {\n   171\t            AssignedScalarOfNativeCurve::<JubjubExtended>::from_public_input(&encoded)\n   172\t                .map(IrValue::JubjubScalar)\n   173\t        }\n   174\t\n   175\t        IrType::Secp256k1Point => {\n   176\t            AssignedForeignPoint::<F, k256::K256, MEP>::from_public_input(&encoded)\n   177\t                .map(IrValue::Secp256k1Point)\n   178\t        }\n   179\t\n   180\t        IrType::Secp256k1Base => AssignedField::<F, k256::Fp, MEP>::from_public_input(&encoded)\n   181\t            .map(IrValue::Secp256k1Base),\n   182\t\n   183\t        IrType::Secp256k1Scalar => AssignedField::<F, k256::Fq, MEP>::from_public_input(&encoded)\n   184\t            .map(IrValue::Secp256k1Scalar),\n   185\t\n   186\t        IrType::Secp256r1Point => {\n   187\t            AssignedForeignPoint::<F, p256::P256, MEP>::from_public_input(&encoded)\n   188\t                .map(IrValue::Secp256r1Point)\n   189\t        }\n   190\t\n   191\t        IrType::Secp256r1Base => AssignedField::<F, p256::Fp, MEP>::from_public_input(&encoded)\n   192\t            .map(IrValue::Secp256r1Base),\n   193\t\n   194\t        IrType::Secp256r1Scalar => AssignedField::<F, p256::Fq, MEP>::from_public_input(&encoded)\n   195\t            .map(IrValue::Secp256r1Scalar),\n   196\t\n   197\t        IrType::Curve25519Point => {\n   198\t            AssignedForeignEdwardsPoint::<F, curve25519::Curve25519, MEP>::from_public_input(\n   199\t                &encoded,\n   200\t            )\n   201\t            .map(IrValue::Curve25519Point)\n   202\t        }\n   203\t\n   204\t        IrType::Curve25519Base => {\n   205\t            AssignedField::<F, curve25519::Fp, MEP>::from_public_input(&encoded)\n   206\t                .map(IrValue::Curve25519Base)\n   207\t        }\n   208\t\n   209\t        IrType::Curve25519Scalar => {\n   210\t            AssignedField::<F, curve25519::Scalar, MEP>::from_public_input(&encoded)\n   211\t                .map(IrValue::Curve25519Scalar)\n   212\t        }\n   213\t    }\n   214\t    .ok_or_else(|| anyhow!(\"Failed to decode {encoded:?} as {val_t:?}\"))\n   215\t}\n   216\t\n   217\t/// Converts a native field element to a Jubjub scalar by reducing modulo\n   218\t/// the Jubjub scalar field order if necessary.\n   219\tpub fn native_to_jubjub_scalar(native: &Fr) -> JubjubFr {\n   220\t    let mut bytes = [0u8; 64];\n   221\t    bytes[..32].copy_from_slice(&native.0.to_bytes_le());\n   222\t    JubjubFr::from_bytes_wide(&bytes)\n   223\t}\n   224\t\n   225\t/// Reduces the given biguint modulo the Jubjub scalar field order and returns the\n   226\t/// result as an `AssignedScalarOfNativeCurve<JubjubExtended>` of exactly 252 bits.\n   227\tpub fn jubjub_scalar_from_biguint(\n   228\t    std_lib: &ZkStdLib,\n   229\t    layouter: &mut impl Layouter<F>,\n   230\t    x: AssignedBigUint<F>,\n   231\t) -> Result<AssignedScalarOfNativeCurve<JubjubExtended>, Error> {\n   232\t    let jubjub_order = {\n   233\t        let p = JubjubFr::modulus();\n   234\t        std_lib.biguint().assign_fixed_biguint(layouter, p)?\n   235\t    };\n   236\t    let (_q, r) = std_lib.biguint().div_rem(layouter, &x, &jubjub_order)?;\n   237\t\n   238\t    let r_le_bytes = std_lib.biguint().to_le_bytes(layouter, &r)?;\n   239\t    std_lib.jubjub().scalar_from_le_bytes(layouter, &r_le_bytes)\n   240\t}\n     1\t// This file is part of midnight-ledger.\n     2\t// Copyright (C) Midnight Foundation\n     3\t// SPDX-License-Identifier: Apache-2.0\n     4\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t// You may not use this file except in compliance with the License.\n     6\t// You may obtain a copy of the License at\n     7\t// http://www.apache.org/licenses/LICENSE-2.0\n     8\t// Unless required by applicable law or agreed to in writing, software\n     9\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    10\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\tuse group::ff::Field;\n    15\tuse midnight_circuits::instructions::ArithInstructions;\n    16\tuse midnight_proofs::{circuit::Layouter, plonk};\n    17\tuse midnight_zk_stdlib::ZkStdLib;\n    18\tuse transient_crypto::curve::Fr;\n    19\t\n    20\tuse crate::{\n    21\t    ir_instructions::F,\n    22\t    ir_types::{CircuitValue, IrValue},\n    23\t};\n    24\t\n    25\t/// Inverts off-circuit the given input.\n    26\t/// Inversion is supported on:\n    27\t///   - `Native`\n    28\t///   - `Secp256k1Base`\n    29\t///   - `Secp256k1Scalar`\n    30\t///   - `Secp256r1Base`\n    31\t///   - `Secp256r1Scalar`\n    32\t///   - `Curve25519Base`\n    33\t///   - `Curve25519Scalar`\n    34\t///\n    35\t/// # Errors\n    36\t///\n    37\t/// This function results in an error if the input type is not supported,\n    38\t/// or if the given value is zero.\n    39\tpub fn inv_offcircuit(x: &IrValue) -> Result<IrValue, anyhow::Error> {\n    40\t    use IrValue::*;\n    41\t    let zero_err = || anyhow::anyhow!(\"cannot invert zero of type {:?}\", x.get_type());\n    42\t    match x {\n    43\t        Native(a) => Option::from(a.0.invert())\n    44\t            .ok_or_else(zero_err)\n    45\t            .map(Fr)\n    46\t            .map(Native),\n    47\t\n    48\t        Secp256k1Base(s) => Option::from(s.invert())\n    49\t            .ok_or_else(zero_err)\n    50\t            .map(Secp256k1Base),\n    51\t\n    52\t        Secp256k1Scalar(s) => Option::from(s.invert())\n    53\t            .ok_or_else(zero_err)\n    54\t            .map(Secp256k1Scalar),\n    55\t\n    56\t        Secp256r1Base(s) => Option::from(s.invert()).ok_or_else(zero_err).map(Secp256r1Base),\n    57\t\n    58\t        Secp256r1Scalar(s) => Option::from(s.invert())\n    59\t            .ok_or_else(zero_err)\n    60\t            .map(Secp256r1Scalar),\n    61\t\n    62\t        Curve25519Base(s) => Option::from(s.invert())\n    63\t            .ok_or_else(zero_err)\n    64\t            .map(Curve25519Base),\n    65\t\n    66\t        // Nb. dalek's inherent `Scalar::invert` (which is not a `CtOption`)\n    67\t        // would shadow `Field::invert` here, hence the qualified call.\n    68\t        Curve25519Scalar(s) => Option::from(Field::invert(s))\n    69\t            .ok_or_else(zero_err)\n    70\t            .map(Curve25519Scalar),\n    71\t\n    72\t        _ => Err(anyhow::anyhow!(\n    73\t            \"Unsupported inversion of {:?}\",\n    74\t            x.get_type(),\n    75\t        )),\n    76\t    }\n    77\t}\n    78\t\n    79\t/// Inverts in-circuit the given input.\n    80\t/// Inversion is supported on:\n    81\t///   - `Native`\n    82\t///   - `Secp256k1Base`\n    83\t///   - `Secp256k1Scalar`\n    84\t///   - `Secp256r1Base`\n    85\t///   - `Secp256r1Scalar`\n    86\t///   - `Curve25519Base`\n    87\t///   - `Curve25519Scalar`\n    88\t///\n    89\t/// # Errors\n    90\t///\n    91\t/// This function results in an error if the input type is not supported,\n    92\t/// or if the given value is zero.\n    93\tpub fn inv_incircuit(\n    94\t    std_lib: &ZkStdLib,\n    95\t    layouter: &mut impl Layouter<F>,\n    96\t    x: &CircuitValue,\n    97\t) -> Result<CircuitValue, plonk::Error> {\n    98\t    use CircuitValue::*;\n    99\t    match x {\n   100\t        Native(a) => {\n   101\t            let r = std_lib.inv(layouter, a)?;\n   102\t            Ok(Native(r))\n   103\t        }\n   104\t        Secp256k1Base(a) => {\n   105\t            let r = (std_lib.secp256k1().base_field_chip()).inv(layouter, a)?;\n   106\t            Ok(Secp256k1Base(r))\n   107\t        }\n   108\t        Secp256k1Scalar(a) => {\n   109\t            let r = (std_lib.secp256k1().scalar_field_chip()).inv(layouter, a)?;\n   110\t            Ok(Secp256k1Scalar(r))\n   111\t        }\n   112\t\n   113\t        Secp256r1Base(a) => {\n   114\t            let r = (std_lib.p256().base_field_chip()).inv(layouter, a)?;\n   115\t            Ok(Secp256r1Base(r))\n   116\t        }\n   117\t        Secp256r1Scalar(a) => {\n   118\t            let r = (std_lib.p256().scalar_field_chip()).inv(layouter, a)?;\n   119\t            Ok(Secp256r1Scalar(r))\n   120\t        }\n   121\t\n   122\t        Curve25519Base(a) => {\n   123\t            let r = (std_lib.curve25519().base_field_chip()).inv(layouter, a)?;\n   124\t            Ok(Curve25519Base(r))\n   125\t        }\n   126\t        Curve25519Scalar(a) => {\n   127\t            let r = (std_lib.curve25519().scalar_field_chip()).inv(layouter, a)?;\n   128\t            Ok(Curve25519Scalar(r))\n   129\t        }\n   130\t\n   131\t        _ => Err(plonk::Error::Synthesis(format!(\n   132\t            \"Unsupported inversion of {:?}\",\n   133\t            x.get_type(),\n   134\t        ))),\n   135\t    }\n   136\t}\n   137\t\n   138\t#[cfg(test)]\n   139\tmod tests {\n   140\t    use group::ff::Field;\n   141\t    use midnight_curves::{curve25519, k256, p256};\n   142\t    use rand_chacha::rand_core::OsRng;\n   143\t    use transient_crypto::curve::Fr;\n   144\t\n   145\t    use super::*;\n   146\t\n   147\t    #[test]\n   148\t    fn test_inv() {\n   149\t        use IrValue::*;\n   150\t\n   151\t        let x = Fr(F::random(OsRng));\n   152\t        assert_eq!(\n   153\t            inv_offcircuit(&Native(x)).unwrap(),\n   154\t            Native(Fr(x.0.invert().unwrap()))\n   155\t        );\n   156\t\n   157\t        let x = k256::Fp::random(OsRng);\n   158\t        assert_eq!(\n   159\t            inv_offcircuit(&Secp256k1Base(x)).unwrap(),\n   160\t            Secp256k1Base(x.invert().unwrap())\n   161\t        );\n   162\t\n   163\t        let x = k256::Fq::random(OsRng);\n   164\t        assert_eq!(\n   165\t            inv_offcircuit(&Secp256k1Scalar(x)).unwrap(),\n   166\t            Secp256k1Scalar(x.invert().unwrap())\n   167\t        );\n   168\t\n   169\t        let x = p256::Fp::random(OsRng);\n   170\t        assert_eq!(\n   171\t            inv_offcircuit(&Secp256r1Base(x)).unwrap(),\n   172\t            Secp256r1Base(x.invert().unwrap())\n   173\t        );\n   174\t\n   175\t        let x = p256::Fq::random(OsRng);\n   176\t        assert_eq!(\n   177\t            inv_offcircuit(&Secp256r1Scalar(x)).unwrap(),\n   178\t            Secp256r1Scalar(x.invert().unwrap())\n   179\t        );\n   180\t\n   181\t        let x = curve25519::Fp::random(OsRng);\n   182\t        assert_eq!(\n   183\t            inv_offcircuit(&Curve25519Base(x)).unwrap(),\n   184\t            Curve25519Base(x.invert().unwrap())\n   185\t        );\n   186\t\n   187\t        let x = <curve25519::Scalar as Field>::random(OsRng);\n   188\t        assert_eq!(\n   189\t            inv_offcircuit(&Curve25519Scalar(x)).unwrap(),\n   190\t            Curve25519Scalar(Field::invert(&x).unwrap())\n   191\t        );\n   192\t    }\n   193\t}\nnl: /home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/bytes32_from_low_high.rs: No such file or directory\n     1\t// This file is part of midnight-ledger.\n     2\t// Copyright (C) Midnight Foundation\n     3\t// SPDX-License-Identifier: Apache-2.0\n     4\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t// You may not use this file except in compliance with the License.\n     6\t// You may obtain a copy of the License at\n     7\t// http://www.apache.org/licenses/LICENSE-2.0\n     8\t// Unless required by applicable law or agreed to in writing, software\n     9\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    10\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\tuse group::cofactor::CofactorGroup;\n    15\tuse midnight_circuits::{ecc::curves::CircuitCurve, instructions::EccInstructions};\n    16\t\n    17\tuse midnight_curves::{JubjubExtended, JubjubSubgroup, curve25519, k256, p256};\n    18\tuse midnight_proofs::{circuit::Layouter, plonk};\n    19\tuse midnight_zk_stdlib::ZkStdLib;\n    20\t\n    21\tuse crate::{\n    22\t    ir_instructions::F,\n    23\t    ir_types::{CircuitValue, IrValue},\n    24\t};\n    25\t\n    26\t/// Constructs (off-circuit) a point from a pair of affine coordinates `(x, y)`.\n    27\t/// Supported on:\n    28\t///   - `(Native, Native)` -> `JubjubPoint`\n    29\t///   - `(Secp256k1Base, Secp256k1Base)` -> `Secp256k1Point`\n    30\t///   - `(Secp256r1Base, Secp256r1Base)` -> `Secp256r1Point`\n    31\t///   - `(Curve25519Base, Curve25519Base)` -> `Curve25519Point`\n    32\t///\n    33\t/// NB: In Weierstrass curves, the identity point cannot be constructed through\n    34\t/// this function.\n    35\t///\n    36\t/// # Errors\n    37\t///\n    38\t/// Errors if the inputs are of the supported types, declared above.\n    39\tpub fn from_coordinates_offcircuit(x: &IrValue, y: &IrValue) -> Result<IrValue, anyhow::Error> {\n    40\t    use IrValue::*;\n    41\t    match (x, y) {\n    42\t        (Native(x), Native(y)) => JubjubExtended::from_xy(x.0, y.0)\n    43\t            .map(<JubjubExtended as CofactorGroup>::into_subgroup)\n    44\t            .and_then(Into::<Option<JubjubSubgroup>>::into)\n    45\t            .map(JubjubPoint)\n    46\t            .ok_or(anyhow::anyhow!(\n    47\t                \"Cannot build a Jubjub point from ({x}, {y})\",\n    48\t            )),\n    49\t\n    50\t        (Secp256k1Base(x), Secp256k1Base(y)) => k256::K256::from_xy(*x, *y)\n    51\t            .map(Secp256k1Point)\n    52\t            .ok_or(anyhow::anyhow!(\n    53\t                \"Cannot build a Secp256k1Point point from ({x:?}, {y:?})\",\n    54\t            )),\n    55\t\n    56\t        (Secp256r1Base(x), Secp256r1Base(y)) => {\n    57\t            p256::P256::from_xy(*x, *y)\n    58\t                .map(Secp256r1Point)\n    59\t                .ok_or(anyhow::anyhow!(\n    60\t                    \"Cannot build a Secp256r1Point point from ({x:?}, {y:?})\",\n    61\t                ))\n    62\t        }\n    63\t\n    64\t        (Curve25519Base(x), Curve25519Base(y)) => curve25519::Curve25519::from_xy(*x, *y)\n    65\t            .and_then(|p| curve25519::Curve25519Subgroup::from_edwards(p.0))\n    66\t            .map(Curve25519Point)\n    67\t            .ok_or(anyhow::anyhow!(\n    68\t                \"Cannot build a Curve25519Point point from ({x:?}, {y:?})\",\n    69\t            )),\n    70\t\n    71\t        (x, y) => Err(anyhow::anyhow!(\n    72\t            \"Unsupported `from_coordinates` on ({:?}, {:?})\",\n    73\t            x.get_type(),\n    74\t            y.get_type(),\n    75\t        )),\n    76\t    }\n    77\t}\n    78\t\n    79\t/// Constructs (in-circuit) a point from a pair of affine coordinates `(x, y)`.\n    80\t/// Supported on:\n    81\t///   - `(Native, Native)` -> `JubjubPoint`\n    82\t///   - `(Secp256k1Base, Secp256k1Base)` -> `Secp256k1Point`\n    83\t///   - `(Secp256r1Base, Secp256r1Base)` -> `Secp256r1Point`\n    84\t///   - `(Curve25519Base, Curve25519Base)` -> `Curve25519Point`\n    85\t///\n    86\t/// NB: In Weierstrass curves, the identity point cannot be constructed through\n    87\t/// this function.\n    88\t///\n    89\t/// # Errors\n    90\t///\n    91\t/// Errors if the inputs are of the supported types, declared above.\n    92\tpub fn from_coordinates_incircuit(\n    93\t    std_lib: &ZkStdLib,\n    94\t    layouter: &mut impl Layouter<F>,\n    95\t    x: &CircuitValue,\n    96\t    y: &CircuitValue,\n    97\t) -> Result<CircuitValue, plonk::Error> {\n    98\t    use CircuitValue::*;\n    99\t    match (x, y) {\n   100\t        (Native(x), Native(y)) => std_lib\n   101\t            .jubjub()\n   102\t            .point_from_coordinates(layouter, x, y)\n   103\t            .map(JubjubPoint),\n   104\t\n   105\t        (Secp256k1Base(x), Secp256k1Base(y)) => std_lib\n   106\t            .secp256k1()\n   107\t            .point_from_coordinates(layouter, x, y)\n   108\t            .map(Secp256k1Point),\n   109\t\n   110\t        (Secp256r1Base(x), Secp256r1Base(y)) => std_lib\n   111\t            .p256()\n   112\t            .point_from_coordinates(layouter, x, y)\n   113\t            .map(Secp256r1Point),\n   114\t\n   115\t        (Curve25519Base(x), Curve25519Base(y)) => std_lib\n   116\t            .curve25519()\n   117\t            .point_from_coordinates(layouter, x, y)\n   118\t            .map(Curve25519Point),\n   119\t\n   120\t        _ => Err(plonk::Error::Synthesis(format!(\n   121\t            \"Unsupported `from_coordinates` on ({:?}, {:?})\",\n   122\t            x.get_type(),\n   123\t            y.get_type(),\n   124\t        ))),\n   125\t    }\n   126\t}\n   127\t\n   128\t#[cfg(test)]\n   129\tmod tests {\n   130\t    use group::Group;\n   131\t    use midnight_curves::{JubjubSubgroup, curve25519, k256, p256};\n   132\t    use rand_chacha::rand_core::OsRng;\n   133\t    use transient_crypto::curve::Fr;\n   134\t\n   135\t    use super::*;\n   136\t\n   137\t    #[test]\n   138\t    fn test_coordinates() {\n   139\t        use IrValue::*;\n   140\t\n   141\t        let p = JubjubSubgroup::random(OsRng);\n   142\t        let (x, y) = Into::<JubjubExtended>::into(p).coordinates().unwrap();\n   143\t        assert_eq!(\n   144\t            from_coordinates_offcircuit(&Native(Fr(x)), &Native(Fr(y))).unwrap(),\n   145\t            JubjubPoint(p)\n   146\t        );\n   147\t\n   148\t        let p = k256::K256::random(OsRng);\n   149\t        let (x, y) = p.coordinates().unwrap();\n   150\t        assert_eq!(\n   151\t            from_coordinates_offcircuit(&Secp256k1Base(x), &Secp256k1Base(y)).unwrap(),\n   152\t            Secp256k1Point(p)\n   153\t        );\n   154\t\n   155\t        assert!(from_coordinates_offcircuit(&Native(0.into()), &Secp256k1Base(y)).is_err());\n   156\t        assert!(from_coordinates_offcircuit(&Native(0.into()), &Native(0.into())).is_err());\n   157\t\n   158\t        let p = p256::P256::random(OsRng);\n   159\t        let (x, y) = p.coordinates().unwrap();\n   160\t        assert_eq!(\n   161\t            from_coordinates_offcircuit(&Secp256r1Base(x), &Secp256r1Base(y)).unwrap(),\n   162\t            Secp256r1Point(p)\n   163\t        );\n   164\t\n   165\t        // (x, y) not on the Secp256r1 curve.\n   166\t        assert!(from_coordinates_offcircuit(&Secp256r1Base(x), &Secp256r1Base(x)).is_err());\n   167\t\n   168\t        let p = curve25519::Curve25519Subgroup::random(OsRng);\n   169\t        let (x, y) = Into::<curve25519::Curve25519>::into(p).coordinates().unwrap();\n   170\t        assert_eq!(\n   171\t            from_coordinates_offcircuit(&Curve25519Base(x), &Curve25519Base(y)).unwrap(),\n   172\t            Curve25519Point(p)\n   173\t        );\n   174\t\n   175\t        // (x, y) not on the Curve25519 curve.\n   176\t        assert!(from_coordinates_offcircuit(&Curve25519Base(x), &Curve25519Base(x)).is_err());\n   177\t    }\n   178\t}\n","exit_code":0,"status":"completed"}}
