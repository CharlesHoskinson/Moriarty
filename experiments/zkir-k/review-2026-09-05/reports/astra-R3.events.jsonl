 = -F::ONE; // coeff of res\n   356\t                self.custom(&mut region, &coeffs, F::ZERO, (m1, m2), k, 0)?;\n   357\t                Ok(res)\n   358\t            },\n   359\t        )\n   360\t    }\n   361\t\n   362\t    /// Assigns the given value into a variable `x`, and returns `(x, r)`, where\n   363\t    /// `r` is such that `(x - shift) * r = 1`.\n   364\t    ///\n   365\t    /// Calling this function on `value = shift` will make the circuit\n   366\t    /// unsatisfiable.\n   367\t    fn assign_with_shifted_inverse(\n   368\t        &self,\n   369\t        layouter: &mut impl Layouter<F>,\n   370\t        value: Value<F>,\n   371\t        shift: F,\n   372\t    ) -> Result<(AssignedNative<F>, AssignedNative<F>), Error> {\n   373\t        layouter.assign_region(\n   374\t            || \"assign with shifted inverse\",\n   375\t            |mut region| {\n   376\t                // x * r - shift * r - 1 = 0\n   377\t                let r_value = value.map(|x| (x - shift).invert().unwrap_or(F::ZERO));\n   378\t                let x = region.assign_advice(|| \"x\", self.config.value_cols[0], 0, || value)?;\n   379\t                let r = region.assign_advice(|| \"r\", self.config.value_cols[1], 0, || r_value)?;\n   380\t                let mut coeffs = [F::ZERO; NB_ARITH_COLS];\n   381\t                coeffs[1] = -shift; // coeff of r\n   382\t                self.custom(&mut region, &coeffs, F::ZERO, (F::ONE, F::ZERO), -F::ONE, 0)?;\n   383\t                Ok((x, r))\n   384\t            },\n   385\t        )\n   386\t    }\n   387\t\n   388\t    /// Assigns values to verify a linear combination of the given terms.\n   389\t    ///\n   390\t    /// Concretely, given terms s.t. `term_i = (c_i, a_i)` and result, it\n   391\t    /// asserts that `result = sum c_i a_i`.\n   392\t    ///\n   393\t    /// The chip uses `cols_used` columns per row to accumulate `col_used` terms\n   394\t    /// in a temporary result and one column to keep this temporary result.\n   395\t    ///\n   396\t    /// This function is called recursively via the following relation:\n   397\t    ///\n   398\t    /// `res = \\sum c_j a_j + \\sum c_i a_i <==> (res - \\sum c_j a_j) = \\sum c_i\n   399\t    /// a_i`\n   400\t    ///\n   401\t    /// - the j indices correspond to the (not more than cols_used) terms\n   402\t    ///   consumed\n   403\t    /// - the i indices correspond to the rest terms\n   404\t    ///\n   405\t    /// if the i indices are empty we directly verify the relation in a single\n   406\t    /// row, otherwise we verify the relation `new_result = res + \\sum c_j\n   407\t    /// a_j` by using the `q_next_col` column to query the witnessed\n   408\t    /// `new_result` which will always be in the first column of the next row\n   409\t    ///\n   410\t    /// INVARIANT: Whenever this function is called: `result = \\sum terms[i].0 *\n   411\t    /// terms[i].1`\n   412\t    ///\n   413\t    /// The function returns the assigned linear combination witness elements\n   414\t    /// and the linear combination result\n   415\t    pub(crate) fn assign_linear_combination_aux(\n   416\t        &self,\n   417\t        region: &mut Region<'_, F>,\n   418\t        terms: &[(F, Value<F>)],\n   419\t        constant: F,\n   420\t        result: &Value<F>,\n   421\t        cols_used: usize,\n   422\t        offset: &mut usize,\n   423\t    ) -> Result<(Vec<AssignedNative<F>>, AssignedNative<F>), Error> {\n   438\t        let x_cells = (0..P::NB_LIMBS)\n   439\t            .map(|i| x.clone().map(|limbs| bigint_to_fe::<F>(&limbs[i as usize])))\n   440\t            .zip(well_formed_log2_bounds::<F, K, P>().iter())\n   441\t            .map(|(xi_value, log2_bound)| {\n   442\t                self.native_gadget.assign_lower_than_fixed(\n   443\t                    layouter,\n   444\t                    xi_value,\n   445\t                    &(BigUint::one() << *log2_bound),\n   446\t                )\n   447\t            })\n   448\t            .collect::<Result<Vec<_>, Error>>()?;\n   449\t\n   450\t        Ok(AssignedField::<F, K, P> {\n   451\t            limb_values: x_cells,\n   452\t            limb_bounds: well_formed_bounds::<F, K, P>(),\n   453\t            _marker: PhantomData,\n   454\t        })\n   455\t    }\n   456\t\n   457\t    fn assign_fixed(\n   458\t        &self,\n   459\t        layouter: &mut impl Layouter<F>,\n   460\t        constant: K,\n   461\t    ) -> Result<AssignedField<F, K, P>, Error> {\n   462\t        let base = BI::from(2).pow(P::LOG2_BASE);\n   463\t        // We shift the value of x by 1, remember that limbs {xi}_i represent integer\n   464\t        //   1 + sum_i base^i xi\n   465\t        let constant = (constant - K::ONE).to_biguint().into();\n   466\t        let constant_limbs = bi_to_limbs(P::NB_LIMBS, &base, &constant);\n     1\t//! Differential-testing oracle for the ZKIR-in-K semantics.\n     2\t//! Runs `IrSource::preprocess` (made `pub` by a one-line patch in this\n     3\t//! worktree) on a .zkir file and a preimage, and prints the resulting memory,\n     4\t//! public-input vector and skip vector as JSON. Field elements are decimal\n     5\t//! strings; memory values are given by their `encode_offcircuit` vectors and\n     6\t//! their variant name.\n     7\tuse std::borrow::Cow;\n     8\tuse std::collections::BTreeMap;\n     9\tuse std::fs::File;\n    10\tuse std::io::BufReader;\n    11\t\n    12\tuse midnight_zkir_v3::IrSource;\n    13\tuse midnight_zkir_v3::ir_instructions::encode::encode_offcircuit;\n    14\tuse num_bigint::BigUint;\n    15\tuse serde::{Deserialize, Serialize};\n    16\tuse transient_crypto::curve::Fr;\n    17\tuse transient_crypto::proofs::{KeyLocation, ProofPreimage};\n    18\t\n    19\t#[derive(Deserialize)]\n    20\tstruct PreimageJson {\n    21\t    inputs: Vec<String>,\n    22\t    binding_input: String,\n    23\t    #[serde(default)]\n    24\t    communications_commitment: Option<(String, String)>,\n    25\t    #[serde(default)]\n    26\t    private_transcript: Vec<String>,\n    27\t    #[serde(default)]\n    28\t    public_transcript_inputs: Vec<String>,\n    29\t    #[serde(default)]\n    30\t    public_transcript_outputs: Vec<String>,\n    31\t}\n    32\t\n    33\t#[derive(Serialize)]\n    34\tstruct MemValue {\n    35\t    variant: String,\n    36\t    encoded: Vec<String>,\n    37\t}\n    38\t\n    39\t#[derive(Serialize)]\n    40\tstruct Output {\n    41\t    status: &'static str,\n    42\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    43\t    error: Option<String>,\n    44\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    45\t    memory: Option<BTreeMap<String, MemValue>>,\n    46\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    47\t    pis: Option<Vec<String>>,\n    48\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    49\t    pi_skips: Option<Vec<Option<usize>>>,\n    50\t}\n    51\t\n    52\tfn fr_from_dec(s: &str) -> anyhow::Result<Fr> {\n    53\t    let n: BigUint = s.parse().map_err(|e| anyhow::anyhow!(\"bad decimal {s}: {e}\"))?;\n    54\t    let mut bytes = n.to_bytes_le();\n    55\t    if bytes.len() > 32 {\n    56\t        anyhow::bail!(\"{s} does not fit in 32 bytes\");\n    57\t    }\n    58\t    bytes.resize(32, 0);\n    59\t    Fr::from_le_bytes(&bytes).ok_or_else(|| anyhow::anyhow!(\"{s} is not a canonical field element\"))\n    60\t}\n    61\t\n    62\tfn fr_to_dec(x: &Fr) -> String {\n    63\t    BigUint::from_bytes_le(&x.as_le_bytes()).to_string()\n    64\t}\n    65\t\n    66\tfn main() -> anyhow::Result<()> {\n    67\t    let args: Vec<String> = std::env::args().collect();\n    68\t    if args.len() != 3 {\n    69\t        eprintln!(\"usage: zkir-oracle IR.zkir PREIMAGE.json\");\n    70\t        std::process::exit(2);\n    71\t    }\n    72\t    let ir = IrSource::load(BufReader::new(File::open(&args[1])?))?;\n    73\t    let pj: PreimageJson = serde_json::from_reader(BufReader::new(File::open(&args[2])?))?;\n    74\t    let vec_fr = |v: &Vec<String>| -> anyhow::Result<Vec<Fr>> { v.iter().map(|s| fr_from_dec(s)).collect() };\n    75\t    let preimage = ProofPreimage {\n    76\t        binding_input: fr_from_dec(&pj.binding_input)?,\n    77\t        communications_commitment: match &pj.communications_commitment {\n    78\t            Some((c, r)) => Some((fr_from_dec(c)?, fr_from_dec(r)?)),\n    79\t            None => None,\n    80\t        },\n    81\t        inputs: vec_fr(&pj.inputs)?,\n    82\t        private_transcript: vec_fr(&pj.private_transcript)?,\n    83\t        public_transcript_inputs: vec_fr(&pj.public_transcript_inputs)?,\n    84\t        public_transcript_outputs: vec_fr(&pj.public_transcript_outputs)?,\n    85\t        key_location: KeyLocation(Cow::Borrowed(\"builtin\")),\n    86\t    };\n    87\t    let out = match ir.preprocess(&preimage) {\n    88\t        Ok(p) => {\n    89\t            let mut memory = BTreeMap::new();\n    90\t            for (id, v) in p.memory.iter() {\n    91\t                let dbg = format!(\"{v:?}\");\n    92\t                let variant = dbg.split('(').next().unwrap_or(\"\").to_string();\n    93\t                let encoded = encode_offcircuit(v)\n    94\t                    .into_iter()\n    95\t                    .map(|e| {\n    96\t                        let f: Fr = e.try_into().expect(\"encode yields Native\");\n    97\t                        fr_to_dec(&f)\n    98\t                    })\n    99\t                    .collect();\n   100\t                memory.insert(id.0.clone(), MemValue { variant, encoded });\n   101\t            }\n   102\t            Output {\n   103\t                status: \"ok\",\n   104\t                error: None,\n   105\t                memory: Some(memory),\n   106\t                pis: Some(p.pis.iter().map(|x| fr_to_dec(&Fr(*x))).collect()),\n   107\t                pi_skips: Some(p.pi_skips.clone()),\n   108\t            }\n   109\t        }\n   110\t        Err(e) => Output { status: \"error\", error: Some(format!(\"{e:#}\")), memory: None, pis: None, pi_skips: None },\n   111\t    };\n   112\t    println!(\"{}\", serde_json::to_string(&out)?);\n   113\t    Ok(())\n   114\t}\n     1\t// Main module: run job(program, preimage) with ZKIR-VM.\n     2\trequires \"zkir-vm.k\"\n     3\t\n     4\tmodule ZKIR\n     5\t  imports ZKIR-VM\n     6\tendmodule\n","exit_code":0,"status":"completed"}}
