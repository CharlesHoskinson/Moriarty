{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_vm.rs | sed -n '705,900p;978,1075p;1151,1265p'\"","aggregated_output":"   705\t    fn circuit(\n   706\t        &self,\n   707\t        std: &ZkStdLib,\n   708\t        layouter: &mut impl Layouter<outer::Scalar>,\n   709\t        _instance: Value<Self::Instance>,\n   710\t        witness: Value<Self::Witness>,\n   711\t    ) -> Result<(), Error> {\n   712\t        let mut input_values = Vec::new();\n   713\t        for id in &self.inputs {\n   714\t            let value = witness.as_ref().map(|preproc| {\n   715\t                preproc\n   716\t                    .memory\n   717\t                    .get(&id.name)\n   718\t                    .cloned()\n   719\t                    .unwrap_or(IrValue::Native(0.into()))\n   720\t            });\n   721\t            input_values.push(value);\n   722\t        }\n   723\t\n   724\t        let binding_input_value = witness.as_ref().map(|preproc| preproc.binding_input);\n   725\t        let comm_comm_value = witness.as_ref().map(|preproc| preproc.comm_comm);\n   726\t\n   727\t        let mut memory: HashMap<Identifier, CircuitValue> = HashMap::new();\n   728\t\n   729\t        for (id, value) in self.inputs.iter().zip(input_values) {\n   730\t            let assigned = assign_incircuit(std, layouter, &id.val_t, &[value])?[0].clone();\n   731\t            memory.insert(id.name.clone(), assigned);\n   732\t        }\n   733\t\n   734\t        let binding_input = std.assign(layouter, binding_input_value)?;\n   735\t\n   736\t        let mut outputs = Vec::new();\n   737\t\n   738\t        fn idx<'a>(\n   739\t            memory: &'a HashMap<Identifier, CircuitValue>,\n   740\t            id: &Identifier,\n   741\t        ) -> Result<&'a CircuitValue, Error> {\n   742\t            memory\n   743\t                .get(id)\n   744\t                .ok_or(Error::Synthesis(format!(\"value {id:?} not in memory\")))\n   745\t        }\n   746\t\n   747\t        fn resolve_operand<'a>(\n   748\t            std: &ZkStdLib,\n   749\t            layouter: &mut impl Layouter<outer::Scalar>,\n   750\t            memory: &'a HashMap<Identifier, CircuitValue>,\n   751\t            operand: &'a Operand,\n   752\t        ) -> Result<CircuitValue, Error> {\n   753\t            match operand {\n   754\t                Operand::Variable(id) => idx(memory, id).cloned(),\n   755\t                Operand::Immediate(imm) => {\n   756\t                    std.assign_fixed(layouter, imm.0).map(CircuitValue::Native)\n   757\t                }\n   758\t            }\n   759\t        }\n   760\t\n   761\t        let mem_insert = |id: Identifier,\n   762\t                          cell: CircuitValue,\n   763\t                          mem: &mut HashMap<Identifier, CircuitValue>|\n   764\t         -> Result<(), Error> {\n   765\t            // If id exists in the witness memory, make sure the value that\n   766\t            // we are inserting is the same.\n   767\t            // Miguel: This seems unnecessary to me. I would fail when calling\n   768\t            // `mem_insert` with an id that exists in the witness memory.\n   769\t            witness.as_ref()\n   770\t                .zip(cell.value())\n   771\t                .error_if_known_and(|(preproc, v)| {\n   772\t                    if let Some(expected) = preproc.memory.get(&id) && *expected != *v  {\n   773\t                        error!(id = ?id, expected = ?expected, actual = ?v, \"Misalignment between `prepare` and `synthesize` runs. This is a bug.\");\n   774\t                        return true;\n   775\t                    }\n   776\t                    false\n   777\t                })?;\n   778\t\n   779\t            mem.insert(id, cell);\n   780\t            Ok(())\n   781\t        };\n   782\t\n   783\t        let pi_push = |cell: AssignedNative<outer::Scalar>,\n   784\t                       pis: &mut Vec<AssignedNative<outer::Scalar>>|\n   785\t         -> Result<(), Error> {\n   786\t            let idx = pis.len();\n   787\t            witness.as_ref()\n   788\t                .zip(cell.value())\n   789\t                .error_if_known_and(|(preproc, v)| {\n   790\t                    if idx < preproc.pis.len() && preproc.pis[idx] != **v {\n   791\t                        error!(prepare = ?preproc.pis, ?idx, ?v, \"Misalignment between `prepare` and `synthesize` runs. This is a bug.\");\n   792\t                        true\n   793\t                    } else {\n   794\t                        false\n   795\t                    }\n   796\t                })?;\n   797\t            pis.push(cell);\n   798\t            Ok(())\n   799\t        };\n   800\t\n   801\t        let mut public_inputs = vec![];\n   802\t        pi_push(binding_input, &mut public_inputs)?;\n   803\t\n   804\t        if self.do_communications_commitment {\n   805\t            let comm_comm_value = comm_comm_value.map(|c| {\n   806\t                c.ok_or_else(|| {\n   807\t                    error!(\"Communication commitment not present despite preproc. This is a bug.\");\n   808\t                    Error::Synthesis(\"Communication commitment not present despite preproc.\".into())\n   809\t                })\n   810\t                .unwrap()\n   811\t                .0\n   812\t            });\n   813\t            let comm_comm = std.assign(layouter, comm_comm_value)?;\n   814\t            pi_push(comm_comm, &mut public_inputs)?;\n   815\t        }\n   816\t        for ins in self.instructions.iter() {\n   817\t            match ins {\n   818\t                I::Encode { input, outputs } => {\n   819\t                    let val = resolve_operand(std, layouter, &memory, input)?;\n   820\t                    let encoded = encode_incircuit(std, layouter, &val)?;\n   821\t                    if encoded.len() != outputs.len() {\n   822\t   