6\trequires \"zkir-ops.k\"\n    27\t\n    28\tmodule ZKIR-CONSTRAINTS\n    29\t  imports ZKIR-OPS\n    30\t  imports ZKIR-WF\n    31\t  imports MAP\n    32\t  imports SET\n    33\t\n    34\t  syntax Constraint ::= gate(Instr)                       [symbol(gate)]\n    35\t                      | piGate(Int, Operand, Operand)     [symbol(piGate)]\n    36\t                      | piFixed(Int, Operand)             [symbol(piFixed)]\n    37\t  syntax Outcome ::= holds() [symbol(holds)] | violated(String) [symbol(violated)]\n    38\t                   | synthErr(String) [symbol(synthErr)] | unknown(String) [symbol(unknown)]\n    39\t  syntax Verdict ::= verdict(Constraint, Outcome) [symbol(verdict)]\n    40\t\n    41\t  // --- Chips -----------------------------------------------------------------------\n    42\t  syntax Set ::= usedChips(Program) [function, total]\n    43\t  rule usedChips(program(_, Ins, _, DoComm, Is))\n    44\t    => #chipsOfTypes(#inputTypes(Ins) #ioTypes(Is)) |Set #chipsOfInstrs(Is) |Set #commChip(DoComm)\n    45\t  syntax Set ::= #commChip(Bool) [function, total]\n    46\t  rule #commChip(true) => SetItem(\"poseidon\")\n    47\t  rule #commChip(false) => .Set\n    48\t  syntax List ::= #inputTypes(TypedIds) [function, total]\n    49\t  rule #inputTypes(.TypedIds) => .List\n    50\t  rule #inputTypes((typedId(_, T), Rest)) => ListItem(T) #inputTypes(Rest)\n    51\t  syntax List ::= #ioTypes(Instrs) [function, total]\n    52\t  rule #ioTypes(.Instrs) => .List\n    53\t  rule #ioTypes((publicInput(_, T, _) ; Is)) => ListItem(T) #ioTypes(Is)\n    54\t  rule #ioTypes((privateInput(_, T, _) ; Is)) => ListItem(T) #ioTypes(Is)\n    55\t  rule #ioTypes((_ ; Is)) => #ioTypes(Is) [owise]\n    56\t  syntax Set ::= #chipsOfTypes(List) [function, total]\n    57\t  rule #chipsOfTypes(.List) => .Set\n    58\t  rule #chipsOfTypes(ListItem(T:IrType) L) => chipOfType(T) |Set #chipsOfTypes(L)\n    59\t  rule #chipsOfTypes(ListItem(_) L) => #chipsOfTypes(L) [owise]\n    60\t  syntax Set ::= #chipsOfInstrs(Instrs) [function, total]\n    61\t  rule #chipsOfInstrs(.Instrs) => .Set\n    62\t  rule #chipsOfInstrs((hashToCurve(_, _) ; Is)) => (SetItem(\"jubjub\") SetItem(\"poseidon\")) |Set #chipsOfInstrs(Is)\n    63\t  rule #chipsOfInstrs((transientHash(_, _) ; Is)) => SetItem(\"poseidon\") |Set #chipsOfInstrs(Is)\n    64\t  rule #chipsOfInstrs((persistentHash(_, _, _) ; Is)) => SetItem(\"sha2_256\") |Set #chipsOfInstrs(Is)\n    65\t  rule #chipsOfInstrs((keccak256(_, _, _) ; Is)) => SetItem(\"keccak_256\") |Set #chipsOfInstrs(Is)\n    66\t  rule #chipsOfInstrs((_ ; Is)) => #chipsOfInstrs(Is) [owise]\n    67\t\n    68\t  // chip needed to hold a value of a type (\"\" = none)\n    69\t  syntax Set ::= chipOfType(IrType) [function, total]\n    70\t  rule chipOfType(jubjubPoint())     => SetItem(\"jubjub\")\n    71\t  rule chipOfType(jubjubScalar())    => SetItem(\"jubjub\")\n    72\t  rule chipOfType(secp256k1Point())  => SetItem(\"secp256k1\")\n    73\t  rule chipOfType(secp256k1Base())   => SetItem(\"secp256k1\")\n    74\t  rule chipOfType(secp256k1Scalar()) => SetItem(\"secp256k1\")\n    75\t  rule chipOfType(secp256r1Point())  => SetItem(\"p256\")\n    76\t  rule chipOfType(secp256r1Base())   => SetItem(\"p256\")\n    77\t  rule chipOfType(secp256r1Scalar()) => SetItem(\"p256\")\n    78\t  rule chipOfType(curve25519Point()) => SetItem(\"curve25519\")\n    79\t  rule chipOfType(curve25519Base())  => SetItem(\"curve25519\")\n    80\t  rule chipOfType(curve25519Scalar())=> SetItem(\"curve25519\")\n    81\t  rule chipOfType(_) => .Set [owise]\n    82\t\n    83\t  // --- Evaluation of all constraints --------------------------------------------------\n    84\t  // verdicts(constraints, mem, pi, chips, binding, commOpt)\n    85\t  syntax List ::= verdicts(List, Map, List, Set) [function, total]\n    86\t  rule verdicts(.List, _, _, _) => .List\n    87\t  rule verdicts(ListItem(C:Constraint) Cs, M, Pi, Chips) => ListItem(verdict(C, eval(C, M, Pi, Chips))) verdicts(Cs, M, Pi, Chips)\n    88\t  rule verdicts(ListItem(_) Cs, M, Pi, Chips) => verdicts(Cs, M, Pi, Chips) [owise]\n    89\t\n    90\t  syntax List ::= violations(List) [function, total]   // verdicts that are not holds()\n    91\t  rule violations(.List) => .List\n    92\t  rule violations(ListItem(verdict(_, holds())) Vs) => violations(Vs)\n    93\t  rule violations(ListItem(V) Vs) => ListItem(V) violations(Vs) [owise]\n    94\t\n    95\t  // --- Reading the witness ------------------------------------------------------------\n    96\t  syntax ValueResult ::= rd(Operand, Map) [function, total]\n    97\t  rule rd(imm(I), _) => vOk(native(I))\n    98\t  rule rd(var(X), M) => vOk({M[X]}:>Value) requires X in_keys(M)\n    99\t  rule rd(var(X), M) => vErr(\"register \" +String X +String \" is not in the witness\") requires notBool X in_keys(M)\n   100\t  syntax ValueResult ::= rdId(String, Map) [function, total]\n   101\t  rule rdId(X, M) => rd(var(X), M)\n   102\t\n   103\t  syntax Outcome ::= #need(ValueResult) [function, total]   // an absent register makes the outcome unknown\n   104\t  rule #need(vErr(S)) => unknown(S)\n   105\t  rule #need(vOk(_)) => holds()\n   106\t\n   107\t  syntax Outcome ::= #and(Outcome, Outcome) [function, total]   // first non-holds outcome wins\n   108\t  rule #and(holds(), O) => O\n   109\t  rule #and(O, _) => O requires O =/=K holds()\n   110\t\n   111\t  syntax Outcome ::= #chipFor(IrType, Set) [function, total]\n   112\t  rule #chipFor(T, Chips) => holds() requires chipOfType(T) <=Set Chips\n   113\t  rule #chipFor(T, Chips) => synthErr(\"chip not initialised for \" +String typeName(T)) requires notBool (chipOfType(T) <=Set Chips)\n   114\t  syntax Outcome ::= #chipsForValues(List, Set) [function, total]\n   115\t  rule #chipsForValues(.List, _) => holds()\n   116\t  rule #chipsForValues(ListItem(V:Value) L, Chips) => #and(#chipFor(typeOf(V), Chips), #chipsForValues(L, Chips))\n   117\t  rule #chipsForValues(ListItem(_) L, Chips) => #chipsForValues(L, Chips) [owise]\n   118\t\n   119\t  syntax Outcome ::= #native(ValueResult, String) [function, total]\n   120\t  rule #native(vErr(S), _) => unknown(S)\n   121\t  rule #native(vOk(native(_)), _) => holds()\n   122\t  rule #native(vOk(V), What) => synthErr(What +String \": cannot convert \" +String tn(V) +String \" to Native\") [owise]\n   123\t  syntax Outcome ::= #boolean(ValueResult, String) [function, total]\n   124\t  rule #boolean(vErr(S), _) => unknown(S)\n   125\t  rule #boolean(vOk(native(0)), _) => holds()\n   126\t  rule #boolean(vOk(native(1)), _) => holds()\n   127\t  rule #boolean(vOk(native(V)), What) => violated(What +String \" is not boolean: \" +String Int2String(V)) requires V =/=Int 0 andBool V =/=Int 1\n   128\t  rule #boolean(vOk(V), What) => synthErr(What +String \": cannot convert \" +String tn(V) +String \" to Native\") [owise]\n   129\t  syntax Outcome ::= #eqValues(ValueResult, ValueResult, String) [function, total]\n   130\t  rule #eqValues(vErr(S), _, _) => unknown(S)\n   131\t  rule #eqValues(vOk(_), vErr(S), _) => unknown(S)\n   132\t  rule #eqValues(vOk(A), vOk(B), _) => holds() requires A ==K B\n   133\t  rule #eqValues(vOk(A), vOk(B), What) => violated(What) requires A =/=K B\n   134\t  // expected value computed by an off-circuit function vs the register\n   135\t  syntax Outcome ::= #matches(ValueResult, ValueResult, String) [function, total]\n   136\t  rule #matches(vErr(S), _, What) => synthErr(What +String \": \" +String S)   // the in-circuit op is undefined on these types\n   137\t  rule #matches(vOk(_), vErr(S), _) => unknown(S)\n   138\t  rule #matches(vOk(A), vOk(B), _) => holds() requires A ==K B\n   139\t  rule #matches(vOk(A), vOk(B), What) => violated(What) requires A =/=K B\n   140\t  syntax Int ::= #int(ValueResult) [function, total]\n   141\t  rule #int(vOk(native(X))) => X\n   142\t  rule #int(_) => -1 [owise]\n   143\t\n   144\t  // --- Gates --------------------------------------------------------------------------\n   145\t  syntax Outcome ::= eval(Constraint, Map, List, Set) [function, total]\n   146\t\n   147\t  rule eval(piFixed(_, _), _, _, _) => holds()\n   148\t  rule eval(piGate(I, G, X), M, Pi, _) => #and(#boolean(rd(G, M), \"impact guard\"), #and(#native(rd(X, M), \"impact\"), #piEq(I, rd(G, M), rd(X, M), Pi)))\n   149\t  syntax Outcome ::= #piEq(Int, ValueResult, ValueResult, List) [function, total]\n   150\t  rule #piEq(I, _, _, Pi) => violated(\"public input index \" +String Int2String(I) +String \" out of range\") requires I >=Int size(Pi)\n   151\t  rule #piEq(I, G, X, Pi) => holds() requires I <Int size(Pi) andBool {Pi[I]}:>Int ==Int #guarded(#int(G), #int(X))\n   152\t  rule #piEq(I, G, X, Pi) => violated(\"public input \" +String Int2String(I) +String \" differs from the guarded value\") requires I <Int size(Pi) andBool {Pi[I]}:>Int =/=Int #guarded(#int(G), #int(X))\n   153\t  syntax Int ::= #guarded(Int, Int) [function, total]\n   154\t  rule #guarded(1, X) => X\n   155\t  rule #guarded(_, _) => 0 [owise]\n   156\t\n   157\t  // assert: cond != 0 (finding 2: booleanity is not enforced in circuit)\n   158\t  rule eval(gate(assert(C)), M, _, _) => #and(#native(rd(C, M), \"assert\"), #nonZero(rd(C, M)))\n   159\t  syntax Outcome ::= #nonZero(ValueResult) [function, total]\n   160\t  rule #nonZero(vOk(native(0))) => violated(\"assert of zero\")\n   161\t  rule #nonZero(_) => holds() [owise]\n   162\t\n   163\t  rule eval(gate(constrainToBoolean(V)), M, _, _) => #boolean(rd(V, M), \"constrain_to_boolean\")\n   164\t  rule eval(gate(constrainBits(V, N)), M, _, _) => #and(#native(rd(V, M), \"constrain_bits\"), #bits(rd(V, M), N))\n   165\t  syntax Outcome ::= #bits(ValueResult, Int) [function, total]\n   166\t  rule #bits(vOk(native(X)), N) => holds() requires N >=Int #frBits orBool fitsBits(X, N)\n   167\t  rule #bits(vOk(native(X)), N) => violated(\"value does not fit in \" +String Int2String(N) +String \" bits\") requires N <Int #frBits andBool notBool fitsBits(X, N)\n   168\t  rule #bits(_, _) => holds() [owise]\n   169\t\n   170\t  // constrain_eq / test_eq / cond_select: in-circuit dispatch has no arm for\n   171\t  // JubjubScalar (constrain_eq, findings 7) nor Bytes32 / JubjubScalar (cond_select, finding 6)\n   172\t  rule eval(gate(constrainEq(A, B)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)),\n   173\t      #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips), #and(#eqSupported(rd(A, M), rd(B, M), \"constrain_eq\"), #eqValues(rd(A, M), rd(B, M), \"constrain_eq fails\")))))\n   174\t  syntax List ::= #vals(ValueResult, ValueResult) [function, total]\n   175\t  rule #vals(vOk(A), vOk(B)) => ListItem(A) ListItem(B)\n   176\t  rule #vals(vOk(A), vErr(_)) => ListItem(A)\n   177\t  rule #vals(vErr(_), vOk(B)) => ListItem(B)\n   178\t  rule #vals(vErr(_), vErr(_)) => .List\n   179\t  syntax Outcome ::= #eqSupported(ValueResult, ValueResult, String) [function, total]\n   180\t  rule #eqSupported(vOk(A), vOk(B), What) => synthErr(\"Unsupported \" +String What +String \": \" +String tn(A) +String \" == \" +String tn(B)) requires notBool sameType(A, B)\n   181\t  rule #eqSupported(vOk(jubjubScalar(_)), vOk(jubjubScalar(_)), What) => synthErr(\"Unsupported \" +String What +String \": JubjubScalar == JubjubScalar\")\n   182\t  rule #eqSupported(vOk(bytes32(_)), vOk(bytes32(_)), \"cond_select\") => synthErr(\"Unsupported cond_select: Bytes32 ? Bytes32\")\n   183\t  rule #eqSupported(vOk(bytes32(_)), vOk(bytes32(_)), \"constrain_eq\") => holds()\n   184\t  rule #eqSupported(vOk(bytes32(_)), vOk(bytes32(_)), \"test_eq\") => holds()\n   185\t  rule #eqSupported(_, _, _) => holds() [owise]\n   186\t\n   187\t  rule eval(gate(testEq(A, B, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)),\n   188\t      #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips), #and(#eqSupported(rd(A, M), rd(B, M), \"test_eq\"),\n   189\t      #matches(#bin2(rd(A, M), rd(B, M), \"test_eq\"), rdId(O, M), \"test_eq output\")))))\n   190\t  rule eval(gate(condSelect(Bit, A, B, O)), M, _, Chips) => #and(#boolean(rd(Bit, M), \"cond_select bit\"), #and(#need(rd(A, M)), #and(#need(rd(B, M)),\n   191\t      #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips), #and(#eqSupported(rd(A, M), rd(B, M), \"cond_select\"),\n   192\t      #matches(#selBit(#int(rd(Bit, M)), rd(A, M), rd(B, M)), rdId(O, M), \"cond_select output\"))))))\n   193\t  syntax ValueResult ::= #selBit(Int, ValueResult, ValueResult) [function, total]\n   194\t  rule #selBit(1, vOk(A), vOk(B)) => selectV(true, A, B)\n   195\t  rule #selBit(0, vOk(A), vOk(B)) => selectV(false, A, B)\n   196\t  rule #selBit(_, vOk(A), vOk(B)) => selectV(false, A, B) [owise]\n   197\t  rule #selBit(_, _, _) => vErr(\"missing\") [owise]\n   198\t\n   199\t  syntax ValueResult ::= #bin2(ValueResult, ValueResult, String) [function, total]\n   200\t  rule #bin2(vErr(S), _, _) => vErr(S)\n   201\t  rule #bin2(vOk(_), vErr(S), _) => vErr(S)\n   202\t  rule #bin2(vOk(A), vOk(B), \"add\") => addV(A, B)\n   203\t  rule #bin2(vOk(A), vOk(B), \"mul\") => mulV(A, B)\n   204\t  rule #bin2(vOk(A), vOk(B), \"test_eq\") => testEqV(A, B)\n   205\t  rule #bin2(vOk(A), vOk(B), \"ec_mul\") => ecMulV(A, B)\n   206\t  rule #bin2(vOk(A), vOk(B), \"bytes32_from_low_high\") => #lowHighInCircuit(A, B)\n   207\t  rule #bin2(vOk(_), vOk(_), Op) => vErr(\"unknown op \" +String Op) [owise]\n   208\t\n   209\t  // arithmetic: output must equal the off-circuit result; unsupported types are\n   210\t  // synthesis errors (same dispatch as off-circuit for add/mul/neg/inv/ec_mul)\n   211\t  rule eval(gate(add(A, B, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)), #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips),\n   212\t      #matches(#bin2(rd(A, M), rd(B, M), \"add\"), rdId(O, M), \"add output\"))))\n   213\t  rule eval(gate(mul(A, B, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)), #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips),\n   214\t      #matches(#bin2(rd(A, M), rd(B, M), \"mul\"), rdId(O, M), \"mul output\"))))\n   215\t  rule eval(gate(ecMul(A, S, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(S, M)), #and(#chipsForValues(#vals(rd(A, M), rd(S, M)), Chips),\n   216\t      #matches(#bin2(rd(A, M), rd(S, M), \"ec_mul\"), rdId(O, M), \"ec_mul output\"))))\n   217\t  rule eval(gate(neg(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"neg\"), rdId(O, M), \"neg output\")))\n   218\t  rule eval(gate(inv(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"inv\"), rdId(O, M), \"inv output (a * inv = 1)\")))\n   219\t  rule eval(gate(copy(A, O)), M, _, _) => #eqValues(rd(A, M), rdId(O, M), \"copy output\")\n   220\t  rule eval(gate(not(A, O)), M, _, _) => #and(#boolean(rd(A, M), \"not\"), #matches(#notOf(rd(A, M)), rdId(O, M), \"not output\"))\n   221\t  syntax ValueResult ::= #notOf(ValueResult) [function, total]\n   222\t  rule #notOf(vOk(native(X))) => vOk(native(1 -Int X)) requires X ==Int 0 orBool X ==Int 1\n   223\t  rule #notOf(_) => vErr(\"not boolean\") [owise]\n   224\t  syntax ValueResult ::= #un2(ValueResult, String) [function, total]\n   225\t  rule #un2(vErr(S), _) => vErr(S)\n   226\t  rule #un2(vOk(A), \"neg\") => negV(A)\n   227\t  rule #un2(vOk(A), \"inv\") => invV(A)\n   228\t  rule #un2(vOk(A), \"into_bytes32\") => intoBytes32V(A)\n   229\t  rule #un2(vOk(A), \"ec_mul_generator\") => ecMulGeneratorV(A)\n   230\t  rule #un2(vOk(_), Op) => vErr(\"unknown op \" +String Op) [owise]\n   231\t\n   232\t  rule eval(gate(ecMulGenerator(S, O)), M, _, Chips) => #and(#need(rd(S, M)), #and(#chipsForValues(#vals(rd(S, M), vErr(\"\")), Chips),\n   233\t      #matches(#un2(rd(S, M), \"ec_mul_generator\"), rdId(O, M), \"ec_mul_generator output\")))\n   234\t\n   235\t  // less_than: the chip rounds the bit width up to max(bits + bits % 2, 4) (finding 4)\n   236\t  rule eval(gate(lessThan(A, B, N, O)), M, _, _) => #and(#native(rd(A, M), \"less_than\"), #and(#native(rd(B, M), \"less_than\"),\n   237\t      #and(#bits(rd(A, M), #ltBits(N)), #and(#bits(rd(B, M), #ltBits(N)), #matches(#ltOf(rd(A, M), rd(B, M)), rdId(O, M), \"less_than output\")))))\n   238\t  syntax Int ::= #ltBits(Int) [function, total]\n   239\t  rule #ltBits(N) => maxInt(N +Int (N modInt 2), 4)\n   240\t  syntax ValueResult ::= #ltOf(ValueResult, ValueResult) [function, total]\n   241\t  rule #ltOf(vOk(native(A)), vOk(native(B))) => vOk(native(bool2Word(A <Int B)))\n   242\t  rule #ltOf(_, _) => vErr(\"not native\") [owise]\n   243\t\n   244\t  rule eval(gate(jubjubScalarFromNative(A, O)), M, _, Chips) => #and(#native(rd(A, M), \"jubjub_scalar_from_native\"), #and(#chipFor(jubjubScalar(), Chips),\n   245\t      #matches(#jjOf(rd(A, M)), rdId(O, M), \"jubjub_scalar_from_native output\")))\n   246\t  syntax ValueResult ::= #jjOf(ValueResult) [function, total]\n   247\t  rule #jjOf(vOk(native(X))) => vOk(jubjubScalar(X modInt #rJ))\n   248\t  rule #jjOf(_) => vErr(\"not native\") [owise]\n   249\t\n   250\t  // public_input / private_input: the register holds a value of the declared\n   251\t  // type (assign_incircuit); the guard plays no part (finding 3)\n   252\t  rule eval(gate(publicInput(_, T, O)), M, _, Chips) => #and(#need(rdId(O, M)), #and(#chipFor(T, Chips), #typed(rdId(O, M), T)))\n   253\t  rule eval(gate(privateInput(_, T, O)), M, _, Chips) => #and(#need(rdId(O, M)), #and(#chipFor(T, Chips), #typed(rdId(O, M), T)))\n   254\t  syntax Outcome ::= #typed(ValueResult, IrType) [function, total]\n   255\t  rule #typed(vOk(V), T) => holds() requires typeOf(V) ==K T\n   256\t  rule #typed(vOk(V), T) => violated(\"register has type \" +String tn(V) +String \", declared \" +String typeName(T)) requires typeOf(V) =/=K T\n   257\t  rule #typed(vErr(S), _) => unknown(S)\n   258\t\n   259\t  // div_mod_power_of_two: canonical decomposition of a native value\n   260\t  rule eval(gate(divModPowerOfTwo(V, N, (Q, (Rm, .Ids)))), M, _, _) => #and(#native(rd(V, M), \"div_mod_power_of_two\"),\n   261\t      #and(#matches(#hi(rd(V, M), N), rdId(Q, M), \"div_mod quotient\"), #matches(#lo(rd(V, M), N), rdId(Rm, M), \"div_mod remainder\")))\n   262\t  rule eval(gate(divModPowerOfTwo(_, _, _)), _, _, _) => synthErr(\"Unexpected output length of DivModPowerOfTwo instruction\") [owise]\n   263\t  syntax ValueResult ::= #hi(ValueResult, Int) [function, total]\n   264\t  rule #hi(vOk(native(X)), N) => vOk(native(highBits(X, N)))\n   265\t  rule #hi(_, _) => vErr(\"not native\") [owise]\n   266\t  syntax ValueResult ::= #lo(ValueResult, Int) [function, total]\n   267\t  rule #lo(vOk(native(X)), N) => vOk(native(lowBits(X, N)))\n   268\t  rule #lo(_, _) => vErr(\"not native\") [owise]\n   269\t\n   270\t  // reconstitute_field: divisor < 2^(255 - bits), modulus < 2^bits, output = 2^bits divisor + modulus mod r\n   271\t  rule eval(gate(reconstituteField(D, Mo, N, O)), M, _, _) => #and(#native(rd(D, M), \"reconstitute_field\"), #and(#native(rd(Mo, M), \"reconstitute_field\"),\n   272\t      #and(#bits(rd(D, M), #frBits -Int N), #and(#bits(rd(Mo, M), N), #matches(#recOf(rd(D, M), rd(Mo, M), N), rdId(O, M), \"reconstitute_field output\")))))\n   273\t  syntax ValueResult ::= #recOf(ValueResult, ValueResult, Int) [function, total]\n   274\t  rule #recOf(vOk(native(D)), vOk(native(Mo)), N) => vOk(native(((D <<Int N) +Int Mo) modInt #r))\n   275\t  rule #recOf(_, _, _) => vErr(\"not native\") [owise]\n   276\t\n   277\t  // encode\n   278\t  rule eval(gate(encode(X, Os)), M, _, Chips) => #and(#need(rd(X, M)), #and(#chipsForValues(#vals(rd(X, M), vErr(\"\")), Chips), #encMatch(rd(X, M), Os, M)))\n   279\t  syntax Outcome ::= #encMatch(ValueResult, Ids, Map) [function, total]\n   280\t  rule #encMatch(vOk(V), Os, M) => synthErr(\"Unexpected output length of encode instruction\") requires size(encodeValue(V)) =/=Int lenIds(Os)\n   281\t  rule #encMatch(vOk(V), Os, M) => #encEach(encodeValue(V), Os, M) requires size(encodeValue(V)) ==Int lenIds(Os)\n   282\t  rule #encMatch(vErr(S), _, _) => unknown(S)\n   283\t  syntax Outcome ::= #encEach(List, Ids, Map) [function, total]\n   284\t  rule #encEach(.List, .Ids, _) => holds()\n   285\t  rule #encEach(ListItem(X) L, (O, Os), M) => #and(#matches(vOk(native(X)), rdId(O, M), \"encode output\"), #encEach(L, Os, M))\n   286\t  rule #encEach(_, _, _) => holds() [owise]\n   287\t\n   288\t  // coordinates\n   289\t  rule eval(gate(intoCoordinates(P, X, Y)), M, _, Chips) => #and(#need(rd(P, M)), #and(#chipsForValues(#vals(rd(P, M), vErr(\"\")), Chips), #coordsMatch(rd(P, M), X, Y, M)))\n   290\t  syntax Outcome ::= #coordsMatch(ValueResult, String, String, Map) [function, total]\n   291\t  rule #coordsMatch(vOk(secp256k1Point(inf())), _, _, _) => violated(\"into_coordinates of the identity is unsatisfiable\")\n   292\t  rule #coordsMatch(vOk(secp256r1Point(inf())), _, _, _) => violated(\"into_coordinates of the identity is unsatisfiable\")\n   293\t  rule #coordsMatch(vOk(V), X, Y, M) => #pairMatch(intoCoordinatesV(V), X, Y, M) [owise]\n   294\t  rule #coordsMatch(vErr(S), _, _, _) => unknown(S)\n   295\t  syntax Outcome ::= #pairMatch(PairResult, String, String, Map) [function, total]\n   296\t  rule #pairMatch(pErr(S), _, _, _) => synthErr(S)\n   297\t  rule #pairMatch(pOk(A, B), X, Y, M) => #and(#matches(vOk(A), rdId(X, M), \"first output\"), #matches(vOk(B), rdId(Y, M), \"second output\"))\n   298\t\n   299\t  // from_coordinates in circuit: point_from_coordinates constrains the exact\n   300\t  // (x, y) to lie on the curve; the off-circuit Jubjub path goes through\n   301\t  // decompression instead (only the parity of x is used)\n   302\t  rule eval(gate(fromCoordinates(X, Y, O)), M, _, Chips) => #and(#need(rd(X, M)), #and(#need(rd(Y, M)), #and(#chipsForValues(#vals(rd(X, M), rd(Y, M)), Chips),\n   303\t      #fromCoordsGate(rd(X, M), rd(Y, M), rdId(O, M)))))\n   304\t  // curve and type dispatch of point_from_coordinates: the exact (x, y) must lie\n   305\t  // on the curve and (after cofactor clearing) in the prime-order subgroup\n   306\t  syntax Outcome ::= #fromCoordsGate(ValueResult, ValueResult, ValueResult) [function, total]\n   307\t  rule #fromCoordsGate(vOk(native(X)), vOk(native(Y)), O) => #fromCoordsPt(fromXY(#jubjub, X, Y), #jubjub, jubjubPoint(), O)\n   308\t  rule #fromCoordsGate(vOk(secp256k1Base(X)), vOk(secp256k1Base(Y)), O) => #fromCoordsPt(fromXY(#secp256k1, X, Y), #secp256k1, secp256k1Point(), O)\n   309\t  rule #fromCoordsGate(vOk(secp256r1Base(X)), vOk(secp256r1Base(Y)), O) => #fromCoordsPt(fromXY(#secp256r1, X, Y), #secp256r1, secp256r1Point(), O)\n   310\t  rule #fromCoordsGate(vOk(curve25519Base(X)), vOk(curve25519Base(Y)), O) => #fromCoordsPt(fromXY(#curve25519, X, Y), #curve25519, curve25519Point(), O)\n   311\t  rule #fromCoordsGate(vOk(A), vOk(B), _) => synthErr(\"Unsupported `from_coordinates` on (\" +String tn(A) +String \", \" +String tn(B) +String \")\") [owise]\n   312\t  rule #fromCoordsGate(vErr(S), _, _) => unknown(S)\n   313\t  rule #fromCoordsGate(vOk(_), vErr(S), _) => unknown(S)\n   314\t  syntax Outcome ::= #fromCoordsPt(PointResult, Curve, IrType, ValueResult) [function, total]\n   315\t  rule #fromCoordsPt(ptErr(_), _, _, _) => violated(\"from_coordinates: (x, y) is not on the curve\")\n   316\t  rule #fromCoordsPt(ptOk(Q), C, _, _) => violated(\"from_coordinates: point is not in the prime-order subgroup\") requires notBool inSubgroup(C, Q)\n   317\t  rule #fromCoordsPt(ptOk(Q), C, T, O) => #matches(vOk(#wrapPoint(Q, T)), O, \"from_coordinates output\") requires inSubgroup(C, Q)\n   318\t\n   319\t  // bytes\n   320\t  rule eval(gate(intoBytes32(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"into_bytes32\"), rdId(O, M), \"into_bytes32 output\")))\n   321\t  rule eval(gate(fromBytes32(B, T, O)), M, _, Chips) => #and(#need(rd(B, M)), #and(#chipFor(T, Chips), #matches(#fromB32c(rd(B, M), T), rdId(O, M), \"from_bytes32 output\")))\n   322\t  syntax ValueResult ::= #fromB32c(ValueResult, IrType) [function, total]\n   323\t  rule #fromB32c(vOk(bytes32(B)), T) => fromBytes32V(T, B)\n   324\t  rule #fromB32c(vOk(V), _) => vErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   325\t  rule #fromB32c(vErr(S), _) => vErr(S)\n   326\t  rule eval(gate(reverseBytes(B, O)), M, _, _) => #and(#need(rd(B, M)), #matches(#revOf(rd(B, M)), rdId(O, M), \"reverse_bytes output\"))\n   327\t  syntax ValueResult ::= #revOf(ValueResult) [function, total]\n   328\t  rule #revOf(vOk(bytes32(B))) => vOk(bytes32(reverseBytes(B)))\n   329\t  rule #revOf(vOk(V)) => vErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   330\t  rule #revOf(vErr(S)) => vErr(S)\n   331\t  rule eval(gate(bytes32IntoLowHigh(B, L, H)), M, _, _) => #and(#need(rd(B, M)), #lowHighMatch(rd(B, M), L, H, M))\n   332\t  syntax Outcome ::= #lowHighMatch(ValueResult, String, String, Map) [function, total]\n   333\t  rule #lowHighMatch(vOk(bytes32(B)), L, H, M) => #pairMatch(bytes32IntoLowHighV(B), L, H, M)\n   334\t  rule #lowHighMatch(vOk(V), _, _, _) => synthErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   335\t  rule #lowHighMatch(vErr(S), _, _, _) => unknown(S)\n   336\t  // bytes32_from_low_high: high must be Native in circuit, low may be any\n   337\t  // field element (finding 8); low's byte 31 must be zero\n   338\t  rule eval(gate(bytes32FromLowHigh(L, H, O)), M, _, _) => #and(#need(rd(L, M)), #and(#native(rd(H, M), \"bytes32_from_low_high high\"),\n   339\t      #matches(#bin2(rd(L, M), rd(H, M), \"bytes32_from_low_high\"), rdId(O, M), \"bytes32_from_low_high output\")))\n   340\t  syntax ValueResult ::= #lowHighInCircuit(Value, Value) [function, total]\n   341\t  rule #lowHighInCircuit(L, native(H)) => #lowHighIC2(intoBytes32V(L), H)\n   342\t  rule #lowHighInCircuit(_, H) => vErr(\"cannot convert \" +String tn(H) +String \" to Native\") [owise]\n   343\t  syntax ValueResult ::= #lowHighIC2(ValueResult, Int) [function, total]\n   344\t  rule #lowHighIC2(vErr(S), _) => vErr(S)\n   345\t  rule #lowHighIC2(vOk(bytes32(BL)), H) => vOk(bytes32(replaceAtBytes(BL, 31, Int2Bytes(1, H, LE)))) requires BL[31] ==Int 0 andBool fitsBits(H, 8)\n   346\t  rule #lowHighIC2(vOk(bytes32(BL)), _) => vErr(\"low operand uses byte 31\") requires BL[31] =/=Int 0\n   347\t  rule #lowHighIC2(vOk(bytes32(_)), H) => vErr(\"high operand is not a byte\") requires notBool fitsBits(H, 8)\n   348\t  rule #lowHighIC2(vOk(_), _) => vErr(\"not bytes\") [owise]\n   349\t\n   350\t  // hashes\n   351\t  rule eval(gate(transientHash(Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"poseidon\", Chips), #matches(#th3(#natives(Xs, M)), rdId(O, M), \"transient_hash output\")))\n   352\t  rule eval(gate(hashToCurve(Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"poseidon\", Chips), #and(#chipNamed(\"jubjub\", Chips), #matches(#htc3(#natives(Xs, M)), rdId(O, M), \"hash_to_curve output\"))))\n   353\t  rule eval(gate(persistentHash(Al, Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"sha2_256\", Chips), #matches(#std3(#natives(Xs, M), Al, \"sha256\"), rdId(O, M), \"persistent_hash output\")))\n   354\t  rule eval(gate(keccak256(Al, Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"keccak_256\", Chips), #matches(#std3(#natives(Xs, M), Al, \"keccak256\"), rdId(O, M), \"keccak256 output\")))\n   355\t  syntax Outcome ::= #chipNamed(String, Set) [function, total]\n   356\t  rule #chipNamed(N, Chips) => holds() requires N in Chips\n   357\t  rule #chipNamed(N, Chips) => synthErr(\"chip not initialised: \" +String N) requires notBool (N in Chips)\n   358\t  syntax Outcome ::= #needAll(Operands, Map) [function, total]\n   359\t  rule #needAll(.Operands, _) => holds()\n   360\t  rule #needAll((X, Xs), M) => #and(#native(rd(X, M), \"hash input\"), #needAll(Xs, M))\n   361\t  syntax IntsResult ::= #natives(Operands, Map) [function, total]\n   362\t  rule #natives(.Operands, _) => isOk(.List)\n   363\t  rule #natives((X, Xs), M) => #consNat(rd(X, M), #natives(Xs, M))\n   364\t  syntax IntsResult ::= #consNat(ValueResult, IntsResult) [function, total]\n   365\t  rule #consNat(vOk(native(X)), isOk(L)) => isOk(ListItem(X) L)\n   366\t  rule #consNat(vOk(V), _) => isErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires notBool isNative(V)\n   367\t  rule #consNat(vErr(S), _) => isErr(S)\n   368\t  rule #consNat(_, isErr(S)) => isErr(S) [owise]\n   369\t  syntax ValueResult ::= #th3(IntsResult) [function, total]\n   370\t  rule #th3(isErr(S)) => vErr(S)\n   371\t  rule #th3(isOk(L)) => vOk(native(poseidonHash(L)))\n   372\t  syntax ValueResult ::= #htc3(IntsResult) [function, total]\n   373\t  rule #htc3(isErr(S)) => vErr(S)\n   374\t  rule #htc3(isOk(L)) => vOk(jubjubPoint(hashToCurve(L)))\n   375\t  syntax ValueResult ::= #std3(IntsResult, Alignment, String) [function, total]\n   376\t  rule #std3(isErr(S), _, _) => vErr(S)\n   377\t  rule #std3(isOk(L), Al, H) => #std4(alignedBytes(Al, L), H)\n   378\t  syntax ValueResult ::= #std4(BytesResult, String) [function, total]\n   379\t  rule #std4(bErr(S), _) => vErr(S)\n   380\t  rule #std4(bOk(B), \"sha256\") => vOk(bytes32(sha256Bytes(B)))\n   381\t  rule #std4(bOk(B), _) => vOk(bytes32(keccak256Bytes(B))) [owise]\n   382\t\n   383\t  // output: the signature types are checked at synthesis\n   384\t  rule eval(gate(output(_)), _, _, _) => holds()\n   385\t  rule eval(gate(_), _, _, _) => holds() [owise]\n   386\tendmodule\n","exit_code":0,"status":"completed"}}
