                }\n   854\t                I::ConstrainEq { a, b } => {\n   855\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   856\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   857\t                    constrain_eq_incircuit(std, layouter, &a_val, &b_val)?;\n   858\t                }\n   859\t                I::ConstrainToBoolean { val } => {\n   860\t                    // Yes, this does insert a constraint.\n   861\t                    let val_assigned = resolve_operand(std, layouter, &memory, val)?;\n   862\t                    let x: AssignedNative<_> = val_assigned.try_into()?;\n   863\t                    let _: AssignedBit<_> = std.convert(layouter, &x)?;\n   864\t                }\n   865\t                I::Copy { val, output } => {\n   866\t                    let val = resolve_operand(std, layouter, &memory, val)?;\n   867\t                    mem_insert(output.clone(), val, &mut memory)?;\n   868\t                }\n   869\t                I::Impact { guard, inputs } => {\n   870\t                    let zero = std.assign_fixed(layouter, outer::Scalar::from(0))?;\n   871\t                    let guard: AssignedBit<_> = {\n   872\t                        let guard = resolve_operand(std, layouter, &memory, guard)?;\n   873\t                        let guard: AssignedNative<_> = guard.try_into()?;\n   874\t                        std.convert(layouter, &guard)?\n   875\t                    };\n   876\t                    for input in inputs {\n   877\t                        let val_assigned = resolve_operand(std, layouter, &memory, input)?;\n   878\t                        let x: AssignedNative<_> = val_assigned.try_into()?;\n   879\t                        let guarded_x = std.select(layouter, &guard, &x, &zero)?;\n   880\t                        pi_push(guarded_x, &mut public_inputs)?;\n   881\t                    }\n   882\t                }\n   883\t                I::TransientHash { inputs, output } => {\n   884\t                    let mut resolved_inputs = Vec::new();\n   885\t                    for inp in inputs {\n   886\t                        let x = resolve_operand(std, layouter, &memory, inp)?;\n   887\t                        let x: AssignedNative<_> = x.try_into()?;\n   888\t                        resolved_inputs.push(x);\n   889\t                    }\n   890\t                    let result = CircuitValue::Native(std.poseidon(layouter, &resolved_inputs)?);\n   891\t                    mem_insert(output.clone(), result, &mut memory)?;\n   892\t                }\n   893\t                I::PersistentHash {\n   894\t                    alignment,\n   895\t                    inputs,\n   896\t                    output,\n   897\t                }\n   898\t                | I::Keccak256 {\n   899\t                    alignment,\n   900\t                    inputs,\n   978\t                I::PublicInput {\n   979\t                    guard: _,\n   980\t                    val_t,\n   981\t                    output,\n   982\t                }\n   983\t                | I::PrivateInput {\n   984\t                    guard: _,\n   985\t                    val_t,\n   986\t                    output,\n   987\t                } => {\n   988\t                    let value = witness.as_ref().map_with_result(|preproc| {\n   989\t                        preproc\n   990\t                            .memory\n   991\t                            .get(output)\n   992\t                            .cloned()\n   993\t                            .ok_or(Error::Synthesis(format!(\n   994\t                                \"Output {:?} not found in witness memory\",\n   995\t                                output\n   996\t                            )))\n   997\t                    })?;\n   998\t\n   999\t                    mem_insert(\n  1000\t                        output.clone(),\n  1001\t                        assign_incircuit(std, layouter, val_t, &[value])?[0].clone(),\n  1002\t                        &mut memory,\n  1003\t                    )?;\n  1004\t                }\n  1005\t                I::DivModPowerOfTwo { val, bits, outputs } => {\n  1006\t                    if outputs.len() != 2 {\n  1007\t                        return Err(Error::Synthesis(\n  1008\t                            \"Unexpected output length of DivModPowerOfTwo instruction\".into(),\n  1009\t                        ));\n  1010\t                    }\n  1011\t                    let val = resolve_operand(std, layouter, &memory, val)?;\n  1012\t                    let val: AssignedNative<_> = val.try_into()?;\n  1013\t                    let val_bits = std.assigned_to_le_bits(layouter, &val, None, true)?;\n  1014\t                    let modulus = CircuitValue::Native(\n  1015\t                        std.assigned_from_le_bits(layouter, &val_bits[..*bits as usize])?,\n  1016\t                    );\n  1017\t\n  1018\t                    let divisor = CircuitValue::Native(\n  1019\t                        std.assigned_from_le_bits(layouter, &val_bits[*bits as usize..])?,\n  1020\t                    );\n  1021\t\n  1022\t                    mem_insert(outputs[0].clone(), divisor, &mut memory)?;\n  1023\t                    mem_insert(outputs[1].clone(), modulus, &mut memory)?;\n  1024\t                }\n  1025\t                I::ReconstituteField {\n  1026\t                    divisor,\n  1027\t                    modulus,\n  1028\t                    bits,\n  1029\t                    output,\n  1030\t                } => {\n  1031\t                    let divisor_val = resolve_operand(std, layouter, &memory, divisor)?;\n  1032\t                    let modulus_val = resolve_operand(std, layouter, &memory, modulus)?;\n  1033\t                    let divisor: AssignedNative<_> = divisor_val.try_into()?;\n  1034\t                    let modulus: AssignedNative<_> = modulus_val.try_into()?;\n  1035\t\n  1036\t                    std.as