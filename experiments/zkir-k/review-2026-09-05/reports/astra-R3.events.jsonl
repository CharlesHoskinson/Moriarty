 -> Self::Coordinate {\n  1112\t        point.y.clone()\n  1113\t    }\n  1114\t\n  1115\t    fn base_field(&self) -> &impl DecompositionInstructions<F, Self::Coordinate> {\n  1116\t        self.base_field_chip()\n  1117\t    }\n  1118\t\n  1119\t    fn assign_without_subgroup_check(\n  1120\t        &self,\n  1121\t        layouter: &mut impl Layouter<F>,\n  1122\t        value: Value<C::CryptographicGroup>,\n  1123\t    ) -> Result<Self::Point, Error> {\n  1124\t        let p = self.assign_point_unchecked(layouter, value)?;\n  1125\t        self.assert_on_curve(layouter, &p.x, &p.y)?;\n  1126\t        Ok(p)\n  1127\t    }\n  1128\t}\n","exit_code":0,"status":"completed"}}
