{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-vm.k'","aggregated_output":"     1\t// ZKIR v3 virtual machine: the witness computation (`IrSource::preprocess`,\n     2\t// zkir-v3/src/ir_vm.rs at midnight-ledger 92e8bdd3) and, in the same rewrite,\n     3\t// the constraint set that `Relation::circuit` would synthesise for the same\n     4\t// instruction (plan decisions CLM-0704 .. CLM-0706, CLM-0720).\n     5\t//\n     6\t// State (one cell per component of the seven-tuple on the VM wiki page):\n     7\t//   <mem>        registers, String |-> Value, write-once\n     8\t//   <pi>         public-input vector (binding input, optional commitment, impacts)\n     9\t//   <skips>      pi_skips: skipNone() for an active impact, skipSome(n) for an inactive one\n    10\t//   <pubInIdx>, <pubOutIdx>, <privIdx>   transcript cursors\n    11\t//   <outputs>    values returned by `output`, in order\n    12\t//   <constraints> instruction-level relations emitted by every instruction,\n    13\t//                whether or not the witness computation is still alive\n    14\t//   <status>     ok() or error(msg): the first witness failure freezes the\n    15\t//                witness cells; the remaining instructions still emit constraints\n    16\t//\n    17\t// A run is job(program, preimage). The preimage mirrors `ProofPreimage`.\n    18\trequires \"zkir-syntax.k\"\n    19\trequires \"zkir-ops.k\"\n    20\trequires \"zkir-constraints.k\"\n    21\t\n    22\tmodule ZKIR-VM-SYNTAX\n    23\t  imports ZKIR-SYNTAX\n    24\t  imports LIST\n    25\t  imports INT\n    26\t\n    27\t  syntax Preimage ::= preimage(List, Int, CommOpt, List, List, List) [symbol(preimage)]\n    28\t                      // inputs, binding_input, communications_commitment, private_transcript,\n    29\t                      // public_transcript_inputs, public_transcript_outputs\n    30\t  syntax CommOpt  ::= noComm()        [symbol(noComm)]\n    31\t                    | comm(Int, Int)  [symbol(comm)]    // (commitment, opening randomness)\n    32\t  syntax Job ::= job(Program, Preimage)    [symbol(job)]\n    33\t               | genJob(Program, Preimage) [symbol(genJob)]   // generation mode, see <genMode>\n    34\tendmodule\n    35\t\n    36\tmodule ZKIR-VM\n    37\t  imports ZKIR-VM-SYNTAX\n    38\t  imports ZKIR-WF\n    39\t  imports ZKIR-OPS\n    40\t  imports ZKIR-CONSTRAINTS\n    41\t  imports MAP\n    42\t  imports SET\n    43\t  imports K-EQUAL\n    44\t\n    45\t  syntax Status ::= ok() [symbol(ok)] | error(String) [symbol(error)]\n    46\t  syntax Skip   ::= skipNone() [symbol(skipNone)] | skipSome(Int) [symbol(skipSome)]\n    47\t\n    48\t  // Constraints (sort Constraint, ZKIR-CONSTRAINTS): the in-circuit relation\n    49\t  // of one instruction over register names and immediates; piGate(i, g, x)\n    50\t  // states pi[i] = g ? x : 0; piFixed pins the binding input and commitment.\n    51\t\n    52\t  configuration\n    53\t    <zkir>\n    54\t      <k> $PGM:Job </k>\n    55\t      <mem> .Map </mem>\n    56\t      <pi> .List </pi>\n    57\t      <skips> .List </skips>\n    58\t      <pubInIdx> 0 </pubInIdx>\n    59\t      <pubOutIdx> 0 </pubOutIdx>\n    60\t      <privIdx> 0 </privIdx>\n    61\t      <outputs> .List </outputs>\n    62\t      <outTypes> .IrTypes </outTypes>\n    63\t      <doComm> false </doComm>\n    64\t      <pre> preimage(.List, 0, noComm(), .List, .List, .List) </pre>\n    65\t      <constraints> .List </constraints>\n    66\t      <chips> .Set </chips>\n    67\t      <verdicts> .List </verdicts>\n    68\t      <deadPis> 0 </deadPis>\n    69\t      <genMode> false </genMode>\n    70\t      <needs> .List </needs>\n    71\t      <strictDecode> false </strictDecode>   // true for the ZKIR-EXT surface (canonical-form check on decoding)\n    72\t      <status> ok() </status>\n    73\t    </zkir>\n    74\t\n    75\t  // Generation mode (test harness only): a transcript that runs out yields the\n    76\t  // type's default value and records what was needed; impact values and the\n    77\t  // communications commitment are recorded instead of checked. The harness\n    78\t  // (tools/diff_test.py) uses this to build a consistent preimage before the\n    79\t  // real run.\n    80\t  syntax Need ::= needPubOut(IrType) [symbol(needPubOut)]\n    81\t                | needPriv(IrType)   [symbol(needPriv)]\n    82\t                | needPubIn(Int)     [symbol(needPubIn)]\n    83\t                | needComm(Int)      [symbol(needComm)]\n    84\t  rule <k> genJob(P, Pre) => job(P, Pre) ... </k> <genMode> _ => true </genMode>\n    85\t\n    86\t  // --- Start: decode inputs, seed the public-input vector ------------------------------\n    87\t  rule <k> job(program(Mi, Ins, Outs, DoComm, Is), Pre) => #loadInputs(decodeInputs(#preInputs(Pre), Ins, 0, Strict)) ~> #seedPi ~> Is ~> #verdicts </k>\n    88\t       <pre> _ => Pre </pre> <strictDecode> Strict </strictDecode>\n    89\t       <chips> _ => usedChips(program(Mi, Ins, Outs, DoComm, Is)) </chips>\n    90\t       <outTypes> _ => Outs </outTypes>\n    91\t       <doComm> _ => DoComm </doComm>\n    92\t\n    93\t  syntax List ::= #preInputs(Preimage) [function, total]\n    94\t  rule #preInputs(preimage(I, _, _, _, _, _)) => I\n    95\t  syntax Int ::= #preBinding(Preimage) [function, total]\n    96\t  rule #preBinding(preimage(_, B, _, _, _, _)) => B\n    97\t  syntax CommOpt ::= #preComm(Preimage) [function, total]\n    98\t  rule #preComm(preimage(_, _, C, _, _, _)) => C\n    99\t  syntax List ::= #prePrivate(Preimage) [function, total]\n   100\t  rule #prePrivate(preimage(_, _, _, P, _, _)) => P\n   101\t  syntax List ::= #prePubIn(Preimage) [function, total]\n   102\t  rule #prePubIn(preimage(_, _, _, _, P, _)) => P\n   103\t  syntax List ::= #prePubOut(Preimage) [function, total]\n   104\t  rule #prePubOut(preimage(_, _, _, _, _, P)) => P\n   105\t\n   106\t  syntax KItem ::= #loadInputs(DecodeMany) | \"#seedPi\" | #bind(List)\n   107\t  rule <k> #loadInputs(decManyErr(S)) => .K ... </k> <status> ok() => error(S) </status>\n   108\t  rule <k> #loadInputs(decManyOk(L)) => #bind(L) ... </k>\n   109\t  rule <k> #bind(.List) => .K ... </k>\n   110\t  rule <k> #bind(ListItem(binding(N, V)) L) => #bind(L) ... </k> <mem> M => M[N <- V] </mem>\n   111\t\n   112\t  // pis = [binding_input] ++ [commitment if do_communications_commitment]\n   113\t  rule <k> #seedPi => .K ... </k> <pre> Pre </pre> <doComm> false </doComm>\n   114\t       <pi> _ => ListItem(#preBinding(Pre)) </pi>\n   115\t       <constraints> Cs => Cs ListItem(piFixed(0, var(\"$binding\"))) </constraints>\n   116\t  rule <k> #seedPi => .K ... </k> <pre> Pre </pre> <doComm> true </doComm>\n   117\t       <pi> _ => ListItem(#preBinding(Pre)) ListItem(#commValue(#preComm(Pre))) </pi>\n   118\t       <constraints> Cs => Cs ListItem(piFixed(0, var(\"$binding\"))) ListItem(piFixed(1, var(\"$commitment\"))) </constraints>\n   119\t       <status> St => #requireComm(#preComm(Pre), St) </status>\n   120\t  syntax Int ::= #commValue(CommOpt) [function, total]\n   121\t  rule #commValue(comm(C, _)) => C\n   122\t  rule #commValue(noComm()) => 0\n   123\t  syntax Status ::= #requireComm(CommOpt, Status) [function, total]\n   124\t  rule #requireComm(noComm(), ok()) => error(\"Expected communications commitment\")\n   125\t  rule #requireComm(_, St) => St [owise]\n   126\t\n   127\t  // --- Instruction sequencing ------------------------------------------------------------\n   128\t  rule <k> (I:Instr ; Is:Instrs) => I ~> Is ... </k>\n   129\t  rule <k> .Instrs => #finish ... </k>\n   130\t\n   131\t  // Every instruction emits its constraint, then runs its witness half (if alive).\n   132\t  // The witness half is written as #exec(I); when the status is an error only\n   133\t  // the constraint half fires.\n   134\t  syntax KItem ::= #exec(Instr)\n   135\t  rule <k> I:Instr => #exec(I) ... </k> <constraints> Cs => Cs #constraintsOf(I) </constraints>\n   136\t    requires notBool isImpact(I)\n   137\t  rule <k> #exec(_) => .K ... </k> <status> error(_) </status>\n   138\t\n   139\t  syntax Bool ::= isImpact(Instr) [function, total]\n   140\t  rule isImpact(impact(_, _)) => true\n   141\t  rule isImpact(_) => false [owise]\n   142\t  syntax List ::= #constraintsOf(Instr) [function, total]\n   143\t  rule #constraintsOf(I) => ListItem(gate(I))\n   144\t\n   145\t  // impact: constraints reference absolute public-input positions, so they\n   146\t  // depend on how many public inputs precede them; with a dead witness the\n   147\t  // count continues from the constraint side (piIdx cell would be needed for\n   148\t  // full independence; here we use the length of <pi>, which is frozen on\n   149\t  // error, plus the impacts seen since). The dead-witness case is tracked by\n   150\t  // <deadPis>.\n   151\t  rule <k> impact(G, Xs) => #exec(impact(G, Xs)) ... </k>\n   152\t       <pi> Pi </pi> <deadPis> D </deadPis>\n   153\t       <constraints> Cs => Cs #piGates(size(Pi) +Int D, G, Xs) </constraints>\n   154\t  syntax List ::= #piGates(Int, Operand, Operands) [function, total]\n   155\t  rule #piGates(_, _, .Operands) => .List\n   156\t  rule #piGates(N, G, (X, Xs)) => ListItem(piGate(N, G, X)) #piGates(N +Int 1, G, Xs)\n   157\t\n   158\t  rule <k> #exec(impact(_, Xs)) => .K ... </k> <status> error(_) </status> <deadPis> D => D +Int lenOperands(Xs) </deadPis>\n   159\t    [priority(30)]\n   160\t\n   161\t  // --- Operand resolution ----------------------------------------------------------------\n   162\t  syntax ValueResult ::= resolve(Operand, Map) [function, total]\n   163\t  rule resolve(imm(I), _) => vOk(native(I))\n   164\t  rule resolve(var(X), M) => vOk({M[X]}:>Value) requires X in_keys(M)\n   165\t  rule resolve(var(X), M) => vErr(\"variable not found: Identifier(\\\"\" +String X +String \"\\\")\") requires notBool X in_keys(M)\n   166\t\n   167\t  syntax BoolResult ::= resolveBool(Operand, Map) [function, total]\n   168\t  rule resolveBool(O, M) => #toBool(resolve(O, M))\n   169\t  syntax BoolResult ::= #toBool(ValueResult) [function, total]\n   170\t  rule #toBool(vErr(S)) => boolErr(S)\n   171\t  rule #toBool(vOk(V)) => asBool(V)\n   172\t\n   173\t  syntax ValuesResult ::= vsOk(List) | vsErr(String)\n   174\t  syntax ValuesResult ::= resolveAll(Operands, Map) [function, total]\n   175\t  rule resolveAll(.Operands, _) => vsOk(.List)\n   176\t  rule resolveAll((O, Os), M) => #consValue(resolve(O, M), resolveAll(Os, M))\n   177\t  syntax ValuesResult ::= #consValue(ValueResult, ValuesResult) [function, total]\n   178\t  rule #consValue(vErr(S), _) => vsErr(S)\n   179\t  rule #consValue(vOk(_), vsErr(S)) => vsErr(S)\n   180\t  rule #consValue(vOk(V), vsOk(L)) => vsOk(ListItem(V) L)\n   181\t\n   182\t  // Write helpers: #put(name, result) stores or fails.\n   183\t  syntax KItem ::= #put(String, ValueResult) | #put2(String, String, PairResult) | #fail(String)\n   184\t  rule <k> #put(_, vErr(S)) => #fail(S) ... </k>\n   185\t  rule <k> #put(X, vOk(V)) => .K ... </k> <mem> M => M[X <- V] </mem>\n   186\t  rule <k> #put2(_, _, pErr(S)) => #fail(S) ... </k>\n   187\t  rule <k> #put2(X, Y, pOk(V, W)) => .K ... </k> <mem> M => M[X <- V][Y <- W] </mem>\n   188\t  rule <k> #fail(S) => .K ... </k> <status> ok() => error(S) </status>\n   189\t  syntax KItem ::= #check(CheckResult)\n   190\t  rule <k> #check(cOk()) => .K ... </k>\n   191\t  rule <k> #check(cErr(S)) => #fail(S) ... </k>\n   192\t\n   193\t  // --- Witness semantics, one rule per instruction (alive only) --------------------------\n   194\t  rule <k> #exec(add(A, B, O)) => #put(O, #bin(resolve(A, M), resolve(B, M), \"add\")) ... </k> <mem> M </mem> <status> ok() </status>\n   195\t  rule <k> #exec(mul(A, B, O)) => #put(O, #bin(resolve(A, M), resolve(B, M), \"mul\")) ... </k> <mem> M </mem> <status> ok() </status>\n   196\t  rule <k> #exec(testEq(A, B, O)) => #put(O, #bin(resolve(A, M), resolve(B, M), \"test_eq\")) ... </k> <mem> M </mem> <status> ok() </status>\n   197\t  rule <k> #exec(ecMul(A, S, O)) => #put(O, #bin(resolve(A, M), resolve(S, M), \"ec_mul\")) ... </k> <mem> M </mem> <status> ok() </status>\n   198\t  rule <k> #exec(fromCoordinates(X, Y, O)) => #put(O, #bin(resolve(X, M), resolve(Y, M), \"from_coordinates\")) ... </k> <mem> M </mem> <status> ok() </status>\n   199\t  rule <k> #exec(bytes32FromLowHigh(L, H, O)) => #put(O, #bin(resolve(L, M), resolve(H, M), \"bytes32_from_low_high\")) ... </k> <mem> M </mem> <status> ok() </status>\n   200\t  syntax ValueResult ::= #bin(ValueResult, ValueResult, String) [function, total]\n   201\t  rule #bin(vErr(S), _, _) => vErr(S)\n   202\t  rule #bin(vOk(_), vErr(S), _) => vErr(S)\n   203\t  rule #bin(vOk(A), vOk(B), \"add\") => addV(A, B)\n   204\t  rule #bin(vOk(A), vOk(B), \"mul\") => mulV(A, B)\n   205\t  rule #bin(vOk(A), vOk(B), \"test_eq\") => testEqV(A, B)\n   206\t  rule #bin(vOk(A), vOk(B), \"ec_mul\") => ecMulV(A, B)\n   207\t  rule #bin(vOk(A), vOk(B), \"from_coordinates\") => fromCoordinatesV(A, B)\n   208\t  rule #bin(vOk(A), vOk(B), \"bytes32_from_low_high\") => bytes32FromLowHighV(A, B)\n   209\t  rule #bin(vOk(_), vOk(_), Op) => vErr(\"unknown binary op \" +String Op) [owise]\n   210\t\n   211\t  rule <k> #exec(neg(A, O)) => #put(O, #un(resolve(A, M), \"neg\")) ... </k> <mem> M </mem> <status> ok() </status>\n   212\t  rule <k> #exec(inv(A, O)) => #put(O, #un(resolve(A, M), \"inv\")) ... </k> <mem> M </mem> <status> ok() </status>\n   213\t  rule <k> #exec(copy(A, O)) => #put(O, resolve(A, M)) ... </k> <mem> M </mem> <status> ok() </status>\n   214\t  rule <k> #exec(ecMulGenerator(S, O)) => #put(O, #un(resolve(S, M), \"ec_mul_generator\")) ... </k> <mem> M </mem> <status> ok() </status>\n   215\t  rule <k> #exec(intoBytes32(A, O)) => #put(O, #un(resolve(A, M), \"into_bytes32\")) ... </k> <mem> M </mem> <status> ok() </status>\n   216\t  rule <k> #exec(reverseBytes(A, O)) => #put(O, #un(resolve(A, M), \"reverse_bytes\")) ... </k> <mem> M </mem> <status> ok() </status>\n   217\t  rule <k> #exec(jubjubScalarFromNative(A, O)) => #put(O, #un(resolve(A, M), \"jubjub_scalar_from_native\")) ... </k> <mem> M </mem> <status> ok() </status>\n   218\t  syntax ValueResult ::= #un(ValueResult, String) [function, total]\n   219\t  rule #un(vErr(S), _) => vErr(S)\n   220\t  rule #un(vOk(A), \"neg\") => negV(A)\n   221\t  rule #un(vOk(A), \"inv\") => invV(A)\n   222\t  rule #un(vOk(A), \"ec_mul_generator\") => ecMulGeneratorV(A)\n   223\t  rule #un(vOk(A), \"into_bytes32\") => intoBytes32V(A)\n   224\t  rule #un(vOk(A), \"reverse_bytes\") => #reverse(asBytes32(A))\n   225\t  rule #un(vOk(A), \"jubjub_scalar_from_native\") => #jjScalar(asNative(A))\n   226\t  rule #un(vOk(_), Op) => vErr(\"unknown unary op \" +String Op) [owise]\n   227\t  syntax ValueResult ::= #reverse(BytesResult) [function, total]\n   228\t  rule #reverse(bErr(S)) => vErr(S)\n   229\t  rule #reverse(bOk(B)) => vOk(bytes32(reverseBytes(B)))\n   230\t  syntax ValueResult ::= #jjScalar(IntResult) [function, total]\n   231\t  rule #jjScalar(iErr(S)) => vErr(S)\n   232\t  rule #jjScalar(iOk(X)) => vOk(jubjubScalar(X modInt #rJ))\n   233\t\n   234\t  rule <k> #exec(not(A, O)) => #put(O, #notV(resolveBool(A, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   235\t  syntax ValueResult ::= #notV(BoolResult) [function, total]\n   236\t  rule #notV(boolErr(S)) => vErr(S)\n   237\t  rule #notV(boolOk(B)) => vOk(native(bool2Word(notBool B)))\n   238\t\n   239\t  rule <k> #exec(assert(C)) => #assert(resolveBool(C, M)) ... </k> <mem> M </mem> <status> ok() </status>\n   240\t  syntax KItem ::= #assert(BoolResult)\n   241\t  rule <k> #assert(boolErr(S)) => #fail(S) ... </k>\n   242\t  rule <k> #assert(boolOk(true)) => .K ... </k>\n   243\t  rule <k> #assert(boolOk(false)) => #fail(\"Failed direct assertion\") ... </k>\n   244\t\n   245\t  rule <k> #exec(constrainToBoolean(V)) => #check(#boolCheck(resolveBool(V, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   246\t  syntax CheckResult ::= #boolCheck(BoolResult) [function, total]\n   247\t  rule #boolCheck(boolErr(S)) => cErr(S)\n   248\t  rule #boolCheck(boolOk(_)) => cOk()\n   249\t\n   250\t  rule <k> #exec(constrainBits(V, N)) => #check(#bitsCheck(resolve(V, M), N)) ... </k> <mem> M </mem> <status> ok() </status>\n   251\t  syntax CheckResult ::= #bitsCheck(ValueResult, Int) [function, total]\n   252\t  rule #bitsCheck(vErr(S), _) => cErr(S)\n   253\t  rule #bitsCheck(vOk(V), N) => checkBits(V, N)\n   254\t\n   255\t  rule <k> #exec(constrainEq(A, B)) => #check(#eqCheck(resolve(A, M), resolve(B, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   256\t  syntax CheckResult ::= #eqCheck(ValueResult, ValueResult) [function, total]\n   257\t  rule #eqCheck(vErr(S), _) => cErr(S)\n   258\t  rule #eqCheck(vOk(_), vErr(S)) => cErr(S)\n   259\t  rule #eqCheck(vOk(A), vOk(B)) => constrainEqV(A, B)\n   260\t\n   261\t  rule <k> #exec(condSelect(Bit, A, B, O)) => #put(O, #sel(resolveBool(Bit, M), resolve(A, M), resolve(B, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   262\t  syntax ValueResult ::= #sel(BoolResult, ValueResult, ValueResult) [function, total]\n   263\t  rule #sel(boolErr(S), _, _) => vErr(S)\n   264\t  rule #sel(boolOk(_), vErr(S), _) => vErr(S)\n   265\t  rule #sel(boolOk(_), vOk(_), vErr(S)) => vErr(S)\n   266\t  rule #sel(boolOk(Bit), vOk(A), vOk(B)) => selectV(Bit, A, B)\n   267\t\n   268\t  rule <k> #exec(encode(X, Os)) => #encode(resolve(X, M), Os) ... </k> <mem> M </mem> <status> ok() </status>\n   269\t  syntax KItem ::= #encode(ValueResult, Ids)\n   270\t  rule <k> #encode(vErr(S), _) => #fail(S) ... </k>\n   271\t  rule <k> #encode(vOk(V), Os) => #fail(\"Unexpected output length of encode instruction: \" +String tn(V)) ... </k>\n   272\t    requires size(encodeValue(V)) =/=Int lenIds(Os)\n   273\t  rule <k> #encode(vOk(V), Os) => #bindEncoded(Os, encodeValue(V)) ... </k>\n   274\t    requires size(encodeValue(V)) ==Int lenIds(Os)\n   275\t  syntax KItem ::= #bindEncoded(Ids, List)\n   276\t  rule <k> #bindEncoded(.Ids, _) => .K ... </k>\n   277\t  rule <k> #bindEncoded((O, Os), ListItem(X) L) => #bindEncoded(Os, L) ... </k> <mem> M => M[O <- native(X)] </mem>\n   278\t  rule <k> #bindEncoded((_, _), .List) => .K ... </k>\n   279\t\n   280\t  rule <k> #exec(intoCoordinates(P, X, Y)) => #put2(X, Y, #coords(resolve(P, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   281\t  syntax PairResult ::= #coords(ValueResult) [function, total]\n   282\t  rule #coords(vErr(S)) => pErr(S)\n   283\t  rule #coords(vOk(V)) => intoCoordinatesV(V)\n   284\t\n   285\t  rule <k> #exec(bytes32IntoLowHigh(B, L, H)) => #put2(L, H, #lowHigh(resolve(B, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   286\t  syntax PairResult ::= #lowHigh(ValueResult) [function, total]\n   287\t  rule #lowHigh(vErr(S)) => pErr(S)\n   288\t  rule #lowHigh(vOk(V)) => #lowHigh2(asBytes32(V))\n   289\t  syntax PairResult ::= #lowHigh2(BytesResult) [function, total]\n   290\t  rule #lowHigh2(bErr(S)) => pErr(S)\n   291\t  rule #lowHigh2(bOk(B)) => bytes32IntoLowHighV(B)\n   292\t\n   293\t  rule <k> #exec(fromBytes32(B, T, O)) => #put(O, #fromB32(resolve(B, M), T)) ... </k> <mem> M </mem> <status> ok() </status>\n   294\t  syntax ValueResult ::= #fromB32(ValueResult, IrType) [function, total]\n   295\t  rule #fromB32(vErr(S), _) => vErr(S)\n   296\t  rule #fromB32(vOk(V), T) => #fromB32b(asBytes32(V), T)\n   297\t  syntax ValueResult ::= #fromB32b(BytesResult, IrType) [function, total]\n   298\t  rule #fromB32b(bErr(S), _) => vErr(S)\n   299\t  rule #fromB32b(bOk(B), T) => fromBytes32V(T, B)\n   300\t\n   301\t  // div_mod_power_of_two: bits <= 248 checked statically; val must be Native\n   302\t  rule <k> #exec(divModPowerOfTwo(V, N, (Q, (R, .Ids)))) => #divMod(resolve(V, M), N, Q, R) ... </k> <mem> M </mem> <status> ok() </status>\n   303\t  syntax KItem ::= #divMod(ValueResult, Int, String, String)\n   304\t  rule <k> #divMod(vErr(S), _, _, _) => #fail(S) ... </k>\n   305\t  rule <k> #divMod(vOk(native(X)), N, Q, R) => .K ... </k> <mem> M => M[Q <- native(highBits(X, N))][R <- native(lowBits(X, N))] </mem>\n   306\t  rule <k> #divMod(vOk(V), _, _, _) => #fail(\"cannot convert \" +String tn(V) +String \" to Native\") ... </k> requires notBool isNative(V)\n   307\t\n   308\t  // reconstitute_field: modulus < 2^bits, divisor < 2^(255-bits), and the\n   309\t  // combination must not exceed r - 1 (compared bit by bit against r - 1).\n   310\t  rule <k> #exec(reconstituteField(D, Mo, N, O)) => #recon(resolve(D, M), resolve(Mo, M), N, O) ... </k> <mem> M </mem> <status> ok() </status>\n   311\t  syntax KItem ::= #recon(ValueResult, ValueResult, Int, String)\n   312\t  rule <k> #recon(_, vErr(S), _, _) => #fail(S) ... </k>\n   313\t  rule <k> #recon(vErr(S), vOk(_), _, _) => #fail(S) ... </k>\n   314\t  rule <k> #recon(vOk(DV), vOk(MV), N, O) => #recon2(checkBits(MV, N), checkBits(DV, #frBits -Int N), DV, MV, N, O) ... </k>\n   315\t  syntax KItem ::= #recon2(CheckResult, CheckResult, Value, Value, Int, String)\n   316\t  rule <k> #recon2(cErr(S), _, _, _, _, _) => #fail(S) ... </k>\n   317\t  rule <k> #recon2(cOk(), cErr(S), _, _, _, _) => #fail(S) ... </k>\n   318\t  rule <k> #recon2(cOk(), cOk(), native(DV), native(MV), N, O) => #fail(\"Reconstituted element overflows field\") ... </k>\n   319\t    requires (DV <<Int N) +Int MV >Int #r -Int 1\n   320\t  rule <k> #recon2(cOk(), cOk(), native(DV), native(MV), N, O) => .K ... </k>\n   321\t    <mem> M => M[O <- native(((DV <<Int N) +Int MV) modInt #r)] </mem>\n   322\t    requires (DV <<Int N) +Int MV <=Int #r -Int 1\n   323\t\n   324\t  rule <k> #exec(lessThan(A, B, N, O)) => #lt(resolve(A, M), resolve(B, M), N, O) ... </k> <mem> M </mem> <status> ok() </status>\n   325\t  syntax KItem ::= #lt(ValueResult, ValueResult, Int, String)\n   326\t  rule <k> #lt(vErr(S), _, _, _) => #fail(S) ... </k>\n   327\t  rule <k> #lt(vOk(_), vErr(S), _, _) => #fail(S) ... </k>\n   328\t  rule <k> #lt(vOk(AV), vOk(BV), N, O) => #lt2(checkBits(AV, N), checkBits(BV, N), AV, BV, O) ... </k>\n   329\t  syntax KItem ::= #lt2(CheckResult, CheckResult, Value, Value, String)\n   330\t  rule <k> #lt2(cErr(S), _, _, _, _) => #fail(S) ... </k>\n   331\t  rule <k> #lt2(cOk(), cErr(S), _, _, _) => #fail(S) ... </k>\n   332\t  rule <k> #lt2(cOk(), cOk(), native(AV), native(BV), O) => .K ... </k> <mem> M => M[O <- native(bool2Word(AV <Int BV))] </mem>\n   333\t\n   334\t  // hashes\n   335\t  rule <k> #exec(transientHash(Xs, O)) => #put(O, #th(resolveAll(Xs, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   336\t  syntax ValueResult ::= #th(ValuesResult) [function, total]\n   337\t  rule #th(vsErr(S)) => vErr(S)\n   338\t  rule #th(vsOk(Vs)) => #th2(asNatives(Vs))\n   339\t  syntax ValueResult ::= #th2(IntsResult) [function, total]\n   340\t  rule #th2(isErr(S)) => vErr(S)\n   341\t  rule #th2(isOk(L)) => vOk(native(poseidonHash(L)))\n   342\t\n   343\t  rule <k> #exec(hashToCurve(Xs, O)) => #put(O, #htcV(resolveAll(Xs, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   344\t  syntax ValueResult ::= #htcV(ValuesResult) [function, total]\n   345\t  rule #htcV(vsErr(S)) => vErr(S)\n   346\t  rule #htcV(vsOk(Vs)) => #htcV2(asNatives(Vs))\n   347\t  syntax ValueResult ::= #htcV2(IntsResult) [function, total]\n   348\t  rule #htcV2(isErr(S)) => vErr(S)\n   349\t  rule #htcV2(isOk(L)) => vOk(jubjubPoint(hashToCurve(L)))\n   350\t\n   351\t  rule <k> #exec(persistentHash(Al, Xs, O)) => #put(O, #stdHash(resolveAll(Xs, M), Al, \"sha256\")) ... </k> <mem> M </mem> <status> ok() </status>\n   352\t  rule <k> #exec(keccak256(Al, Xs, O)) => #put(O, #stdHash(resolveAll(Xs, M), Al, \"keccak256\")) ... </k> <mem> M </mem> <status> ok() </status>\n   353\t  syntax ValueResult ::= #stdHash(ValuesResult, Alignment, String) [func