s='wfError';out='n/a';extra=''\n else:\n  j=k.kast_to_kore(KApply('job',[pt,preimage_term(pre)]),KSort('Job'))\n  cfg=k.kore_to_kast(llvm_interpret(D,top_cell_initializer({'\"'$PGM'\"':inj(SortApp('SortJob'),SORT_K_ITEM,j)})))\n  ks=find_cell(cfg,'<status>').label.name\n  vals=list_items(find_cell(cfg,'<verdicts>'))\n  hits=[v for v in vals if gate_sub.replace('_','').lower() in k.pretty_print(v.args[0]).replace('_','').lower()]\n  out=hits[0].args[1].label.name if hits else 'ABSENT'\n  extra='; '.join(k.pretty_print(v) for v in vals if v.args[1].label.name\"'!='\"'holds')\n ok=(ks,rs,out)==(exp_k,exp_r,exp_out)\n passed+=ok\n print(('PASS' if ok else 'FAIL'),name,ks,rs,out,extra[:240])\nprint('Matched expectations:',passed,'/',len(dt.CASES))\n\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
