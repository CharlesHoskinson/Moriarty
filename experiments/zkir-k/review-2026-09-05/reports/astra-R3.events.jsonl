preimage.inputs.len()\n   210\t            );\n   211\t        }\n   212\t\n   213\t        let mut pis = vec![preimage.binding_input];\n   448\t                    let power = (0..*bits).fold(Fr::from(1), |acc, _| Fr::from(2) * acc);\n   449\t                    let modulus: Fr = resolve_operand(&memory, modulus)?.try_into()?;\n   450\t                    let divisor: Fr = resolve_operand(&memory, divisor)?.try_into()?;\n   451\t                    let result = IrValue::Native(power * divisor + modulus);\n   452\t                    memory.insert(output.clone(), result);\n   453\t                }\n   454\t                I::LessThan { a, b, bits, output } => {\n   455\t                    let result =\n   456\t                        (from_bits(resolve_operand_bits(&memory, a, Some(*bits))?.into_iter())\n   457\t                            < from_bits(\n   458\t                                resolve_operand_bits(&memory, b, Some(*bits))?.into_iter(),\n   459\t                            ))\n   460\t                        .into();\n   461\t                    memory.insert(output.clone(), IrValue::Native(result));\n   462\t                }\n   463\t                I::JubjubScalarFromNative { native, output } => {\n   464\t                    let x: Fr = resolve_operand(&memory, native)?.try_into()?;\n   465\t                    let s = native_to_jubjub_scalar(&x);\n   466\t                    memory.insert(output.clone(), IrValue::JubjubScalar(s));\n   467\t                }\n   468\t                I::TransientHash { inputs, output } => {\n   469\t                    let result = transient_hash(\n   470\t                        &inputs\n   471\t                            .iter()\n   472\t                            .map(|i| resolve_operand(&memory, i))\n   473\t                            .map(|r| r.and_then(|v| v.try_into()))\n   474\t                            .collect::<Result<Vec<Fr>, _>>()?,\n   475\t                    );\n   476\t                    memory.insert(output.clone(), IrValue::Native(result));\n   477\t                }\n   478\t                I::PersistentHash {\n   479\t                    alignment,\n   653\t                public_transcript_inputs = ?preimage.public_transcript_inputs,\n   654\t                public_transcript_outputs = ?preimage.public_transcript_outputs,\n   655\t                private_transcript_outputs = ?preimage.private_transcript,\n   656\t                ?public_transcript_inputs_idx,\n   657\t                ?public_transcript_outputs_idx,\n   658\t                ?private_transcript_outputs_idx,\n   659\t                \"Transcripts not fully consumed\");\n   660\t            bail!(\"Transcripts not fully consumed\");\n   661\t        }\n   662\t        if self.do_communications_commitment {\n   663\t            let comm_comm = preimage\n   664\t                .communications_commitment\n   665\t                .ok_or(anyhow!(\"Expected communications randomness\"))?;\n   666\t            let mut comm_comm_inputs: Vec<Fr> = Vec::new();\n   667\t            comm_comm_inputs.extend(preimage.inputs.iter());\n   668\t            for value in outputs.iter() {\n   669\t                for ir_val in encode_offcircuit(value) {\n   670\t                    comm_comm_inputs.push(ir_val.try_into()?);\n   671\t                }\n   672\t            }\n   673\t            if comm_comm.0 != transient_commit(&comm_comm_inputs[..], comm_comm.1) {\n   674\t                error!(\n   675\t                    ?comm_comm,\n   676\t                    ?comm_comm_inputs,\n   677\t                    \"Communications commitment mismatch\"\n   678\t                );\n   679\t                bail!(\"Communications commitment mismatch\");\n   680\t            }\n   681\t        }\n   120\t        self.limb_values.iter().for_each(|elem| elem.hash(state));\n   121\t    }\n   122\t}\n   123\t\n   124\timpl<F, K, P> Instantiable<F> for AssignedField<F, K, P>\n   125\twhere\n   126\t    F: CircuitField,\n   127\t    K: CircuitField,\n   128\t    P: FieldEmulationParams<F, K>,\n   129\t{\n   130\t    fn as_public_input(element: &K) -> Vec<F> {\n   131\t        // We shift the value of x by 1 for the unique-zero representation.\n   132\t        let element_as_bi = (*element - K::ONE).to_biguint().into();\n   133\t        let base = BI::from(2).pow(P::LOG2_BASE);\n   134\t        let nb_limbs_per_batch = (F::CAPACITY / P::LOG2_BASE) as usize;\n   135\t        bi_to_limbs(P::NB_LIMBS, &base, &element_as_bi)\n   136\t            .chunks(nb_limbs_per_batch)\n   137\t            .map(|chunk| bigint_to_fe::<F>(&bi_from_limbs(&base, chunk)))\n   138\t            .collect()\n   139\t    }\n   140\t\n   141\t    fn from_public_input(fields: &[F]) -> Option<K> {\n   142\t        let base = BI::from(2).pow(P::LOG2_BASE);\n   143\t        let nb_limbs_per_batch = (F::CAPACITY / P::LOG2_BASE) as usize;\n   144\t        if nb_limbs_per_batch == 0\n   145\t            || fields.len() != (P::NB_LIMBS as usize).div_ceil(nb_limbs_per_batch)\n   146\t        {\n   147\t            return None;\n   148\t        }\n   149\t        // Every batch must be expressible with `nb_limbs_per_batch` limbs in base\n   150\t        // `base`, otherwise the input is not a valid encoding.\n   151\t        let batch_bound = BI::pow(&base, nb_limbs_per_batch as u32);\n   152\t        let limbs: Vec<BI> = fields\n   153\t            .iter()\n   154\t            .map(|f| {\n   155\t                let bi: BI = f.to_biguint().into();\n   156\t                (bi < batch_bound).then(|| bi_to_limbs(nb_limbs_per_batch as u32, &base, &bi))\n   157\t            })\n   158\t            .collect::<Option<Vec<_>>>()?\n   159\t            .concat();\n   160\t        let (head, tail) = limbs.split_at(P::NB_LIMBS as usize);\n   161\t        if tail.iter().any(|l| !l.is_zero()) {\n   162\t            return None;\n   163\t        }\n   164\t        let element_as_bi = bi_from_limbs(&base, head) + BI::one();\n   165\t        Some(bigint_to_fe::<K>(&element_as_bi))\n   166\t    }\n   167\t}\n   168\t\n   169\timpl<F, K, P> InnerValue for AssignedField<F, K, P>\n   170\twhere\n   171\t    F: CircuitField,\n   172\t    K: CircuitField,\n   173\t    P: FieldEmulationParams<F, K>,\n   174\t{\n   175\t    type Element = K;\n   418\twhere\n   419\t    F: CircuitField,\n   420\t    K: CircuitField,\n   421\t    P: FieldEmulationParams<F, K>,\n   422\t    N: NativeInstructions<F>,\n   423\t{\n   424\t    fn assign(\n   425\t        &self,\n   426\t        layouter: &mut impl Layouter<F>,\n   427\t        x: Value<K>,\n   428\t    ) -> Result<AssignedField<F, K, P>, Error> {\n   429\t        let base = BI::from(2).pow(P::LOG2_BASE);\n   430\t        // We shift the value of x by 1, remember that limbs {xi}_i represent integer\n   431\t        //   1 + sum_i base^i xi\n   432\t        let x = x.map(|v| {\n   433\t            let bi = (v - K::ONE).to_biguint().into();\n   434\t            bi_to_limbs(P::NB_LIMBS, &base, &bi)\n   435\t        });\n   436\t\n   437\t        // Range-check the cells in the range [0, base)\n   438\t        let x_cells = (0..P::NB_LIMBS)\n   439\t            .map(|i| x.clone().map(|limbs| bigint_to_fe::<F>(&limbs[i as usize])))\n   440\t            .zip(well_formed_log2_bounds::<F, K, P>().iter())\n   441\t            .map(|(xi_value, log2_bound)| {\n   500\t}\n   501\t\n   502\timpl<F, K, P, N> PublicInputInstructions<F, AssignedField<F, K, P>> for FieldChip<F, K, P, N>\n   503\twhere\n   504\t    F: CircuitField,\n   505\t    K: CircuitField,\n   506\t    P: FieldEmulationParams<F, K>,\n   507\t    N: NativeInstructions<F>,\n   508\t{\n   509\t    fn as_public_input(\n   510\t        &self,\n   511\t        layouter: &mut impl Layouter<F>,\n   512\t        assigned: &AssignedField<F, K, P>,\n   513\t    ) -> Result<Vec<AssignedNative<F>>, Error> {\n   514\t        let assigned = self.normalize(layouter, assigned)?;\n   515\t        let nb_limbs_per_batch = (F::CAPACITY / P::LOG2_BASE) as usize;\n   516\t        let base = BI::from(2).pow(P::LOG2_BASE);\n   517\t        assigned\n   518\t            .limb_values\n   519\t            .chunks(nb_limbs_per_batch)\n   520\t            .map(|chunk| {\n   521\t                let terms: Vec<(F, AssignedNative<F>)> = chunk\n   522\t                    .iter()\n   523\t                    .enumerate()\n   524\t                    .map(|(i, limb)| (bigint_to_fe::<F>(&base.pow(i as u32)), limb.clone()))\n   525\t                    .collect();\n   526\t                self.native_gadget.linear_combination(layouter, &terms, F::ZERO)\n   527\t            })\n   528\t            .collect()\n   529\t    }\n   530\t\n   531\t    fn constrain_as_public_input(\n   532\t        &self,\n   533\t        layouter: &mut impl Layouter<F>,\n   534\t        assigned: &AssignedField<F, K, P>,\n   535\t    ) -> Result<(), Error> {\n   536\t        self.as_public_input(layouter, assigned)?\n    15\t//                     i.e. enc(p-1) twice, then 1\n    16\t//   Curve25519 point  enc(x) ++ enc(y)\n    17\trequires \"zkir-syntax.k\"\n    18\trequires \"zkir-curves.k\"\n    19\t\n    20\tmodule ZKIR-VALUES\n    21\t  imports ZKIR-SYNTAX\n    22\t  imports ZKIR-CURVES\n    23\t  imports BYTES\n    24\t  imports LIST\n    25\t  imports STRING\n    26\t\n    27\t  syntax Value ::= native(Int)            [symbol(nativeV)]\n    28\t                 | bytes32(Bytes)         [symbol(bytes32V)]\n    29\t                 | jubjubPoint(Point)     [symbol(jubjubPointV)]\n    30\t                 | jubjubScalar(Int)      [symbol(jubjubScalarV)]\n    31\t                 | secp256k1Point(Point)  [symbol(secp256k1PointV)]\n    32\t                 | secp256k1Base(Int)     [symbol(secp256k1BaseV)]\n    33\t                 | secp256k1Scalar(Int)   [symbol(secp256k1ScalarV)]\n    34\t                 | secp256r1Point(Point)  [symbol(secp256r1PointV)]\n    35\t                 | secp256r1Base(Int)     [symbol(secp256r1BaseV)]\n    36\t                 | secp256r1Scalar(Int)   [symbol(secp256r1ScalarV)]\n    37\t                 | curve25519Point(Point) [symbol(curve25519PointV)]\n    38\t                 | curve25519Base(Int)    [symbol(curve25519BaseV)]\n    39\t                 | curve25519Scalar(Int)  [symbol(curve25519ScalarV)]\n    40\t\n    41\t  syntax IrType ::= typeOf(Value) [function, total]\n    42\t  rule typeOf(native(_))          => native()\n    43\t  rule typeOf(bytes32(_))         => bytes32()\n    44\t  rule typeOf(jubjubPoint(_))     => jubjubPoint()\n    45\t  rule typeOf(jubjubScalar(_))    => jubjubScalar()\n    46\t  rule typeOf(secp256k1Point(_))  => secp256k1Point()\n    47\t  rule typeOf(secp256k1Base(_))   => secp256k1Base()\n    48\t  rule typeOf(secp256k1Scalar(_)) => secp256k1Scalar()\n    49\t  rule typeOf(secp256r1Point(_))  => secp256r1Point()\n    50\t  rule typeOf(secp256r1Base(_))   => secp256r1Base()\n    51\t  rule typeOf(secp256r1Scalar(_)) => secp256r1Scalar()\n    52\t  rule typeOf(curve25519Point(_)) => curve25519Point()\n    53\t  rule typeOf(curve25519Base(_))  => curve25519Base()\n    54\t  rule typeOf(curve25519Scalar(_))=> curve25519Scalar()\n    55\t\n    56\t  // `IrValue::default(t)`: zero / identity of each type.\n    57\t  syntax Value ::= defaultValue(IrType) [function, total]\n    58\t  rule defaultValue(native())          => native(0)\n    59\t  rule defaultValue(bytes32())         => bytes32(padRightBytes(.Bytes, 32, 0))\n    60\t  rule defaultValue(jubjubPoint())     => jubjubPoint(pt(0, 1))\n    61\t  rule defaultValue(jubjubScalar())    => jubjubScalar(0)\n    62\t  rule defaultValue(secp256k1Point())  => secp256k1Point(inf())\n    63\t  rule defaultValue(secp256k1Base())   => secp256k1Base(0)\n    64\t  rule defaultValue(secp256k1Scalar()) => secp256k1Scalar(0)\n    65\t  rule defaultValue(secp256r1Point())  => secp256r1Point(inf())\n    66\t  rule defaultValue(secp256r1Base())   => secp256r1Base(0)\n    67\t  rule defaultValue(secp256r1Scalar()) => secp256r1Scalar(0)\n    68\t  rule defaultValue(curve25519Point()) => curve25519Point(pt(0, 1))\n    69\t  rule defaultValue(curve25519Base())  => curve25519Base(0)\n    70\t  rule defaultValue(curve25519Scalar())=> curve25519Scalar(0)\n    71\t\n    72\t  // Debug-style names matching the Rust variant names (used by the oracle).\n    73\t  syntax String ::= typeName(IrType) [function, total]\n    74\t  rule typeName(native())          => \"Native\"\n    75\t  rule typeName(bytes32())         => \"Bytes32\"\n    76\t  rule typeName(jubjubPoint())     => \"JubjubPoint\"\n    77\t  rule typeName(jubjubScalar())    => \"JubjubScalar\"\n    78\t  rule typeName(secp256k1Point())  => \"Secp256k1Point\"\n    79\t  rule typeName(secp256k1Base())   => \"Secp256k1Base\"\n    80\t  rule typeName(secp256k1Scalar()) => \"Secp256k1Scalar\"\n    81\t  rule typeName(secp256r1Point())  => \"Secp256r1Point\"\n    82\t  rule typeName(secp256r1Base())   => \"Secp256r1Base\"\n    83\t  rule typeName(secp256r1Scalar()) => \"Secp256r1Scalar\"\n    84\t  rule typeName(curve25519Point()) => \"Curve25519Point\"\n    85\t  rule typeName(curve25519Base())  => \"Curve25519Base\"\n    86\t  rule typeName(curve25519Scalar())=> \"Curve25519Scalar\"\n    87\t\n    88\t  // --- Foreign-field limb encoding -------------------------------------------------\n    89\t  // encForeign(x, p, log2Base, nbLimbs): list of native elements.\n    90\t  syntax List ::= encForeign(Int, Int, Int, Int) [function, total]\n    91\t  rule encForeign(X, P, L, NB) => #groupLimbs(fsub(X, 1, P), L, NB, 254 /Int L)\n    92\t  // #groupLimbs(e, log2Base, limbsLeft, perBatch): successive batches of perBatch limbs\n   164\t  rule decodeValue(ListItem(X) ListItem(Y), jubjubPoint()) => #decJubjub(jubjubFromXY(X, Y))\n   165\t  rule decodeValue(Fs, jubjubPoint()) => decErr(\"Failed to decode as JubjubPoint\") requires size(Fs) =/=Int 2\n   166\t  syntax DecodeResult ::= #decJubjub(PointResult) [function, total]\n   167\t  rule #decJubjub(ptErr(_)) => decErr(\"Failed to decode as JubjubPoint\")\n   168\t  rule #decJubjub(ptOk(Q)) => decOk(jubjubPoint(Q)) requires inSubgroup(#jubjub, Q)\n   169\t  rule #decJubjub(ptOk(Q)) => decErr(\"Failed to decode as JubjubPoint\") requires notBool inSubgroup(#jubjub, Q)\n   170\t\n   171\t  // JubjubScalar: one element below 2^254; its low 252 bits must be a canonical\n   172\t  // scalar (AssignedScalarOfNativeCurve::from_public_input).\n   173\t  rule decodeValue(ListItem(F), jubjubScalar()) => decOk(jubjubScalar(lowBits(F, 252)))\n   174\t    requires fitsBits(F, 254) andBool lowBits(F, 252) <Int #rJ\n   175\t  rule decodeValue(ListItem(F), jubjubScalar()) => decErr(\"Failed to decode as JubjubScalar\")\n   176\t    requires notBool (fitsBits(F, 254) andBool lowBits(F, 252) <Int #rJ)\n   177\t  rule decodeValue(Fs, jubjubScalar()) => decErr(\"Failed to decode as JubjubScalar\") requires size(Fs) =/=Int 1\n   178\t\n   179\t  rule decodeValue(Fs, secp256k1Base())   => #decField(decField64(Fs, #k256P), secp256k1Base())\n   180\t  rule decodeValue(Fs, secp256k1Scalar()) => #decField(decField64(Fs, #k256N), secp256k1Scalar())\n   181\t  rule decodeValue(Fs, secp256r1Base())   => #decField(decField64(Fs, #p256P), secp256r1Base())\n   182\t  rule decodeValue(Fs, secp256r1Scalar()) => #decField(decField64(Fs, #p256N), secp256r1Scalar())\n   183\t  rule decodeValue(Fs, curve25519Base())  => #decField(decField64(Fs, #c25519P), curve25519Base())\n   184\t  rule decodeValue(Fs, curve25519Scalar())=> #decField(decForeign(Fs, #c25519L, 51, 5), curve25519Scalar())\n   185\t  syntax DecodeResult ::= #decField(Int, IrType) [function, total]\n   186\t  rule #decField(-1, T) => decErr(\"Failed to decode as \" +String typeName(T))\n   187\t  rule #decField(X, secp256k1Base())    => decOk(secp256k1Base(X))    requires X >=Int 0\n   188\t  rule #decField(X, secp256k1Scalar())  => decOk(secp256k1Scalar(X))  requires X >=Int 0\n   189\t  rule #decField(X, secp256r1Base())    => decOk(secp256r1Base(X))    requires X >=Int 0\n   190\t  rule #decField(X, secp256r1Scalar())  => decOk(secp256r1Scalar(X))  requires X >=Int 0\n   191\t  rule #decField(X, curve25519Base())   => decOk(curve25519Base(X))   requires X >=Int 0\n   192\t  rule #decField(X, curve25519Scalar()) => decOk(curve25519Scalar(X)) requires X >=Int 0\n   193\t  rule #decField(_, T) => decErr(\"Failed to decode as \" +String typeName(T)) [owise]\n   194\t\n   195\t  // Weierstrass points: 5 elements; last == 1 means identity.\n   196\t  rule decodeValue(Fs, secp256k1Point()) => #decWPoint(Fs, #secp256k1, secp256k1Point())\n   197\t  rule decodeValue(Fs, secp256r1Point()) => #decWPoint(Fs, #secp256r1, secp256r1Point())\n   198\t  syntax DecodeResult ::= #decWPoint(List, Curve, IrType) [function, total]\n   199\t  rule #decWPoint(Fs, C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires size(Fs) =/=Int 5\n   200\t  rule #decWPoint(Fs, C, T) => decOk(#wrapPoint(inf(), T)) requires size(Fs) ==Int 5 andBool Fs[4] ==K 1\n   201\t  rule #decWPoint(Fs, C, T) => #decWPointXY(decField64(range(Fs, 0, 3), curveField(C)), decField64(range(Fs, 2, 1), curveField(C)), C, T)\n   202\t    requires size(Fs) ==Int 5 andBool Fs[4] =/=K 1\n   203\t  syntax DecodeResult ::= #decWPointXY(Int, Int, Curve, IrType) [function, total]\n   204\t  rule #decWPointXY(X, Y, C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires X <Int 0 orBool Y <Int 0\n   205\t  rule #decWPointXY(X, Y, C, T) => #decPointResult(fromXY(C, X, Y), C, T) requires X >=Int 0 andBool Y >=Int 0\n   206\t  syntax DecodeResult ::= #decPointResult(PointResult, Curve, IrType) [function, total]\n   207\t  rule #decPointResult(ptErr(_), _, T) => decErr(\"Failed to decode as \" +String typeName(T))\n   208\t  rule #decPointResult(ptOk(Q), C, T) => decOk(#wrapPoint(Q, T)) requires inSubgroup(C, Q)\n   209\t  rule #decPointResult(ptOk(Q), C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires notBool inSubgroup(C, Q)\n   210\t\n   211\t  // Curve25519 points: 4 elements, exact curve check then subgroup check.\n   212\t  rule decodeValue(Fs, curve25519Point()) => decErr(\"Failed to decode as Curve25519Point\") requires size(Fs) =/=Int 4\n   213\t  rule decodeValue(Fs, curve25519Point())\n   214\t    => #decWPointXY(decField64(range(Fs, 0, 2), #c25519P), decField64(range(Fs, 2, 0), #c25519P), #curve25519, curve25519Point())\n{\n \"version\": {\n  \"major\": 3,\n  \"minor\": 0\n },\n \"inputs\": [\n  {\n   \"name\": \"%x\",\n   \"type\": \"Scalar<BLS12-381>\"\n  },\n  {\n   \"name\": \"%y\",\n   \"type\": \"Scalar<BLS12-381>\"\n  }\n ],\n \"outputs\": [],\n \"do_communications_commitment\": false,\n \"instructions\": [\n  {\n   \"op\": \"from_coordinates\",\n   \"inputs\": [\n    \"%x\",\n    \"%y\"\n   ],\n   \"output\": \"%p\"\n  },\n  {\n   \"op\": \"into_coordinates\",\n   \"point\": \"%p\",\n   \"outputs\": [\n    \"%px\",\n    \"%py\"\n   ]\n  }\n ]\n}\n{\n \"version\": {\n  \"major\": 3,\n  \"minor\": 0\n },\n \"inputs\": [\n  {\n   \"name\": \"%a\",\n   \"type\": \"Scalar<BLS12-381>\"\n  }\n ],\n \"outputs\": [],\n \"do_communications_commitment\": false,\n \"instructions\": [\n  {\n   \"op\": \"private_input\",\n   \"guard\": null,\n   \"type\": \"Scalar<BLS12-381>\",\n   \"output\": \"%x\"\n  },\n  {\n   \"op\": \"add\",\n   \"a\": \"%a\",\n   \"b\": \"%x\",\n   \"output\": \"%y\"\n  }\n ]\n}\n","exit_code":0,"status":"completed"}}
