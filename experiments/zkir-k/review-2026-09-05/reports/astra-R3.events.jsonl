 /// Returns `true` iff the given assigned element is strictly lower than the\n   359\t    /// given bound.\n   360\t    fn lower_than_fixed(\n    25\t/// Equality testing is supported on:\n    26\t///   - `Native`\n    27\t///   - `Bytes32`\n    28\t///   - `JubjubPoint`\n    29\t///   - `Secp256k1Point`\n    30\t///   - `Secp256k1Base`\n    31\t///   - `Secp256k1Scalar`\n    32\t///   - `Secp256r1Point`\n    33\t///   - `Secp256r1Base`\n    34\t///   - `Secp256r1Scalar`\n    35\t///   - `Curve25519Point`\n    36\t///   - `Curve25519Base`\n    37\t///   - `Curve25519Scalar`\n    38\t///\n    39\t/// # Errors\n    40\t///\n    41\t/// This function results in an error if the input types are not supported.\n    42\tpub fn test_eq_offcircuit(a: &IrValue, b: &IrValue) -> Result<bool, anyhow::Error> {\n    43\t    use IrValue::*;\n    44\t    match (a, b) {\n    45\t        (Native(x), Native(y)) => Ok(x == y),\n    46\t        (Bytes32(xs), Bytes32(ys)) => Ok(xs == ys),\n    47\t        (JubjubPoint(p), JubjubPoint(q)) => Ok(p == q),\n    48\t\n    49\t        (Secp256k1Point(p), Secp256k1Point(q)) => Ok(p == q),\n    50\t        (Secp256k1Base(s), Secp256k1Base(r)) => Ok(s == r),\n    51\t        (Secp256k1Scalar(s), Secp256k1Scalar(r)) => Ok(s == r),\n    52\t\n    53\t        (Secp256r1Point(p), Secp256r1Point(q)) => Ok(p == q),\n    54\t        (Secp256r1Base(s), Secp256r1Base(r)) => Ok(s == r),\n    55\t        (Secp256r1Scalar(s), Secp256r1Scalar(r)) => Ok(s == r),\n    56\t\n    57\t        (Curve25519Point(p), Curve25519Point(q)) => Ok(p == q),\n    58\t        (Curve25519Base(s), Curve25519Base(r)) => Ok(s == r),\n    59\t        (Curve25519Scalar(s), Curve25519Scalar(r)) => Ok(s == r),\n    60\t\n    61\t        _ => Err(anyhow::anyhow!(\n    62\t            \"Unsupported test_eq: {:?} == {:?}\",\n    63\t            a.get_type(),\n    64\t            b.get_type()\n    65\t        )),\n    66\t    }\n    67\t}\n    68\t\n    69\t/// Tests in-circuit whether the given inputs are equal.\n    70\t/// Equality testing is supported on:\n    71\t///   - `Native`\n    72\t///   - `JubjubPoint`\n    73\t///   - `Secp256k1Point`\n    74\t///   - `Secp256k1Base`\n    75\t///   - `Secp256k1Scalar`\n    76\t///   - `Secp256r1Point`\n    77\t///   - `Secp256r1Base`\n    78\t///   - `Secp256r1Scalar`\n    79\t///   - `Curve25519Point`\n    80\t///   - `Curve25519Base`\n    81\t///   - `Curve25519Scalar`\n    82\t///\n    83\t/// # Errors\n    84\t///\n    85\t/// This function results in an error if the input types are not supported.\n    86\tpub fn test_eq_incircuit(\n    87\t    std_lib: &ZkStdLib,\n    88\t    layouter: &mut impl Layouter<F>,\n    89\t    a: &CircuitValue,\n    90\t    b: &CircuitValue,\n    91\t) -> Result<AssignedBit<F>, plonk::Error> {\n    92\t    use CircuitValue::*;\n    93\t    match (a, b) {\n    94\t        (Native(x), Native(y)) => std_lib.is_equal(layouter, x, y),\n    95\t\n    96\t        (Bytes32(xs), Bytes32(ys)) => {\n    97\t            let pair_wise_eqs = (xs.iter().zip(ys.iter()))\n    98\t                .map(|(x, y)| std_lib.is_equal(layouter, x, y))\n    99\t                .collect::<Result<Vec<_>, plonk::Error>>()?;\n   100\t            std_lib.and(layouter, &pair_wise_eqs)\n   101\t        }\n   102\t\n   103\t        (JubjubPoint(p), JubjubPoint(q)) => std_lib.jubjub().is_equal(layouter, p, q),\n   104\t\n   105\t        (Secp256k1Point(p), Secp256k1Point(q)) => std_lib.secp256k1().is_equal(layouter, p, q),\n   106\t        (Secp256k1Base(s), Secp256k1Base(r)) => {\n   107\t            (std_lib.secp256k1().base_field_chip()).is_equal(layouter, s, r)\n   108\t        }\n   109\t        (Secp256k1Scalar(s), Secp256k1Scalar(r)) => {\n   110\t            (std_lib.secp256k1().scalar_field_chip()).is_equal(layouter, s, r)\n   111\t        }\n   112\t\n   113\t        (Secp256r1Point(p), Secp256r1Point(q)) => std_lib.p256().is_equal(layouter, p, q),\n   114\t        (Secp256r1Base(s), Secp256r1Base(r)) => {\n   115\t            (std_lib.p256().base_field_chip()).is_equal(layouter, s, r)\n   116\t        }\n   117\t        (Secp256r1Scalar(s), Secp256r1Scalar(r)) => {\n   118\t            (std_lib.p256().scalar_field_chip()).is_equal(layouter, s, r)\n   119\t        }\n   120\t\n   121\t        (Curve25519Point(p), Curve25519Point(q)) => std_lib.curve25519().is_equal(layouter, p, q),\n   122\t        (Curve25519Base(s), Curve25519Base(r)) => {\n   123\t            (std_lib.curve25519().base_field_chip()).is_equal(layouter, s, r)\n   124\t        }\n   125\t        (Curve25519Scalar(s), Curve25519Scalar(r)) => {\n   126\t            (std_lib.curve25519().scalar_field_chip()).is_equal(layouter, s, r)\n   127\t        }\n   128\t        _ => Err(plonk::Error::Synthesis(format!(\n   129\t            \"Unsupported test_eq: {:?} == {:?}\",\n   130\t            a.get_type(),\n   131\t            b.get_type()\n   132\t        ))),\n   133\t    }\n   134\t}\n   135\t\n   136\t#[cfg(test)]\n   137\tmod tests {\n   138\t    use group::Group;\n   139\t    use group::ff::Field;\n   140\t    use midnight_curves::{JubjubSubgroup, curve25519, k256, p256};\n   141\t    use rand::Rng;\n   142\t    use rand_chacha::rand_core::OsRng;\n   143\t    use transient_crypto::curve::Fr;\n   144\t\n   145\t    use super::*;\n   146\t\n   147\t    #[test]\n   148\t    fn test_eq_offcircuit_behavior() {\n   149\t        use IrValue::*;\n   150\t        let x = Fr(F::random(OsRng));\n   151\t        assert!(test_eq_offcircuit(&Native(x), &Native(x)).unwrap());\n   152\t\n   153\t        let bytes: [u8; 32] = std::array::from_fn(|_| rand::thread_rng().r#gen());\n   154\t        assert!(test_eq_offcircuit(&Bytes32(bytes), &Bytes32(bytes)).unwrap());\n   155\t\n   156\t        let p = JubjubSubgroup::random(OsRng);\n   157\t        assert!(test_eq_offcircuit(&JubjubPoint(p), &JubjubPoint(p)).unwrap());\n   158\t        assert!(test_eq_offcircuit(&Native(x), &JubjubPoint(p)).is_err());\n   159\t\n   160\t        let p = k256::K256::random(OsRng);\n   161\t        let s = k256::Fp::random(OsRng);\n   162\t        let r = k256::Fq::random(OsRng);\n   163\t        assert!(test_eq_offcircuit(&Secp256k1Point(p), &Secp256k1Point(p)).unwrap());\n   164\t        assert!(test_eq_offcircuit(&Secp256k1Base(s), &Secp256k1Base(s)).unwrap());\n    31\t/// point as a pair of base field values. Supported on:\n    32\t///   - `JubjubPoint`    -> `(Native, Native)`\n    33\t///   - `Secp256k1Point` -> `(Secp256k1Base, Secp256k1Base)`\n    34\t///   - `Secp256r1Point`      -> `(Secp256r1Base, Secp256r1Base)`\n    35\t///   - `Curve25519Point`     -> `(Curve25519Base, Curve25519Base)`\n    36\t///\n    37\t/// # Errors\n    38\t///\n    39\t/// Errors if the input is not a supported type, or if it is the identity of a\n    40\t/// Weierstrass curve (which has no affine coordinates).\n    41\tpub fn into_coordinates_offcircuit(point: &IrValue) -> Result<(IrValue, IrValue), anyhow::Error> {\n    42\t    use IrValue::*;\n    43\t    match point {\n    44\t        JubjubPoint(p) => {\n    45\t            let p_ext: JubjubExtended = (*p).into();\n    46\t            let (x, y) = p_ext.coordinates().unwrap();\n    47\t            Ok((Native(Fr(x)), Native(Fr(y))))\n    48\t        }\n    49\t        Secp256k1Point(p) => {\n    50\t            if bool::from(p.is_identity()) {\n    51\t                return Err(anyhow::anyhow!(\n    52\t                    \"Cannot extract coordinates of the Secp256k1 identity\"\n    53\t                ));\n    54\t            }\n    55\t            let (x, y) = p.coordinates().unwrap();\n    56\t            Ok((Secp256k1Base(x), Secp256k1Base(y)))\n    57\t        }\n    58\t        Secp256r1Point(p) => {\n    59\t            if bool::from(p.is_identity()) {\n    60\t                return Err(anyhow::anyhow!(\n    61\t                    \"Cannot extract coordinates of the Secp256r1 identity\"\n    62\t                ));\n    63\t            }\n    64\t            let (x, y) = p.coordinates().unwrap();\n    65\t            Ok((Secp256r1Base(x), Secp256r1Base(y)))\n    66\t        }\n    67\t        Curve25519Point(p) => {\n    68\t            // Edwards points always have affine coordinates, including the\n    69\t            // identity, which is (0, 1).\n    70\t            let p_ext: curve25519::Curve25519 = (*p).into();\n    71\t            let (x, y) = p_ext.coordinates().unwrap();\n    72\t            Ok((Curve25519Base(x), Curve25519Base(y)))\n    73\t        }\n    74\t        _ => Err(anyhow::anyhow!(\n    75\t            \"Unsupported coordinate extraction of {:?}\",\n    76\t            point.get_type(),\n    77\t        )),\n    78\t    }\n    79\t}\n    80\t\n    81\t/// Extracts in-circuit the affine `(x, y)` coordinates of an elliptic curve\n    82\t/// point as a pair of assigned base field values. Supported on:\n    83\t///   - `JubjubPoint`    -> `(Native, Native)`\n    84\t///   - `Secp256k1Point` -> `(Secp256k1Base, Secp256k1Base)`\n    85\t///   - `Secp256r1Point`      -> `(Secp256r1Base, Secp256r1Base)`\n    86\t///   - `Curve25519Point`     -> `(Curve25519Base, Curve25519Base)`\n    87\t///\n    88\t/// For Weierstrass curves this constrains the point to not be the identity\n    89\t/// (which has no affine coordinates), making the circuit unsatisfiable on the\n    90\t/// identity.\n    91\t///\n    92\t/// # Errors\n    93\t///\n    94\t/// Errors if the input is not a supported type.\n    95\tpub fn into_coordinates_incircuit(\n    96\t    std_lib: &ZkStdLib,\n    97\t    layouter: &mut impl Layouter<F>,\n    98\t    point: &CircuitValue,\n    99\t) -> Result<(CircuitValue, CircuitValue), plonk::Error> {\n   100\t    use CircuitValue::*;\n   101\t    match point {\n   102\t        JubjubPoint(p) => {\n   103\t            let jubjub = std_lib.jubjub();\n   104\t            Ok((\n   105\t                Native(jubjub.x_coordinate(p)),\n   106\t                Native(jubjub.y_coordinate(p)),\n   107\t            ))\n   108\t        }\n   109\t        Secp256k1Point(p) => {\n   110\t            let curve = std_lib.secp256k1();\n   111\t            curve.assert_non_zero(layouter, p)?;\n   112\t            Ok((\n   113\t                Secp256k1Base(curve.x_coordinate(p)),\n   114\t                Secp256k1Base(curve.y_coordinate(p)),\n   115\t            ))\n   116\t        }\n   117\t        Secp256r1Point(p) => {\n   118\t            let curve = std_lib.p256();\n   119\t            curve.assert_non_zero(layouter, p)?;\n   120\t            Ok((\n   121\t                Secp256r1Base(curve.x_coordinate(p)),\n   122\t                Secp256r1Base(curve.y_coordinate(p)),\n   123\t            ))\n   124\t        }\n   125\t        Curve25519Point(p) => {\n   126\t            // Edwards points always have affine coordinates, including the\n   127\t            // identity, so no non-zero assertion is needed.\n   128\t            let curve = std_lib.curve25519();\n   129\t            Ok((\n   130\t                Curve25519Base(curve.x_coordinate(p)),\n   131\t                Curve25519Base(curve.y_coordinate(p)),\n   132\t            ))\n   133\t        }\n   134\t        _ => Err(plonk::Error::Synthesis(format!(\n   135\t            \"Unsupported coordinate extraction of {:?}\",\n   136\t            point.get_type(),\n   137\t        ))),\n   138\t    }\n   139\t}\n   140\t\n","exit_code":0,"status":"completed"}}
