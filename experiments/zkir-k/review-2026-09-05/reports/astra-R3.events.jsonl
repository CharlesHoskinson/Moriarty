{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"nl -ba experiments/zkir-k/tools/zkir_run.py | sed -n '1,240p'; rg -n 'decode|aligned|invV' experiments/zkir-k/semantics/zkir-ops.k; rg -n 'bytes32_from_low_high|aligned|decode|PersistentHash|LessThan' /home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_vm.rs\"","aggregated_output":"     1\t\"\"\"Run a ZKIR v3 program through the K semantics (ZKIR-VM) and read the result.\n     2\t\n     3\t`run_job(program_path, preimage)` builds job(Program, Preimage), runs krun on\n     4\tthe ZKIR definition, and returns a dict shaped like the Rust oracle's output:\n     5\t  {status: 'ok'|'error', error?: str, memory: {id: {variant, encoded}},\n     6\t   pis: [str], pi_skips: [None|int], cursors: (pubIn, pubOut, priv),\n     7\t   constraints: int}\n     8\tMemory values are re-encoded on the Python side with the same encoding as\n     9\t`encode_offcircuit` (the encodings are unit-tested against K in unit_values.py).\n    10\t\n    11\tUsage: zkir_run.py FILE.zkir PREIMAGE.json [--definition DIR]\n    12\t\"\"\"\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport sys\n    18\tfrom pathlib import Path\n    19\tfrom typing import Any\n    20\t\n    21\tfrom pyk.kast.inner import KApply, KInner, KSort, KToken, top_down\n    22\tfrom pyk.kast.prelude.kint import intToken\n    23\tfrom pyk.kore.parser import KoreParser\n    24\tfrom pyk.ktool.krun import KRun\n    25\t\n    26\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    27\timport zkir_kast  # noqa: E402\n    28\t\n    29\tR = 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    30\tRJ = 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    31\tK256P = 2**256 - 2**32 - 977\n    32\tK256N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\n    33\tP256P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF\n    34\tP256N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551\n    35\tC25519P = 2**255 - 19\n    36\tC25519L = 2**252 + 27742317777372353535851937790883648493\n    37\t\n    38\t\n    39\tdef default_definition() -> Path:\n    40\t    return Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-kompiled'\n    41\t\n    42\t\n    43\tdef default_ext_definition() -> Path:\n    44\t    return Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-ext-kompiled'\n    45\t\n    46\t\n    47\t# --- preimage term ---------------------------------------------------------------------\n    48\t\n    49\tdef klist(items: list[KInner]) -> KInner:\n    50\t    t: KInner = KApply('.List')\n    51\t    for it in reversed(items):\n    52\t        t = KApply('_List_', [KApply('ListItem', [it]), t])\n    53\t    return t\n    54\t\n    55\t\n    56\tdef ints(values) -> KInner:\n    57\t    return klist([intToken(int(v)) for v in values])\n    58\t\n    59\t\n    60\tdef preimage_term(p: dict[str, Any]) -> KInner:\n    61\t    cc = p.get('communications_commitment')\n    62\t    comm = KApply('noComm') if cc is None else KApply('comm', [intToken(int(cc[0])), intToken(int(cc[1]))])\n    63\t    return KApply('preimage', [\n    64\t        ints(p.get('inputs', [])),\n    65\t        intToken(int(p.get('binding_input', 0))),\n    66\t        comm,\n    67\t        ints(p.get('private_transcript', [])),\n    68\t        ints(p.get('public_transcript_inputs', [])),\n    69\t        ints(p.get('public_transcript_outputs', [])),\n    70\t    ])\n    71\t\n    72\t\n    73\t# --- result extraction --------------------------------------------------------------------\n    74\t\n    75\tdef find_cell(term: KInner, name: str) -> KInner:\n    76\t    found: list[KInner] = []\n    77\t\n    78\t    def visit(t: KInner) -> KInner:\n    79\t        if isinstance(t, KApply) and t.label.name ==