een in public API\")]\n    73\tpub const BASEPOINT_ORDER: Scalar = BASEPOINT_ORDER_PRIVATE;\n    74\t\n    75\tpub(crate) const BASEPOINT_ORDER_PRIVATE: Scalar = Scalar {\n    76\t    bytes: [\n    77\t        0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde,\n    78\t        0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,\n    79\t        0x00, 0x10,\n    80\t    ],\n    81\t};\n    82\t\n    83\t#[cfg(feature = \"precomputed-tables\")]\n    84\tuse crate::ristretto::RistrettoBasepointTable;\n    85\t\n    86\t/// The Ristretto basepoint, as a `RistrettoBasepointTable` for scalar multiplication.\n     1\t{-# OPTIONS --safe #-}\n     2\t\n     3\t------------------------------------------------------------------------\n     4\t-- Assumptions of the zkir-v3 formalization\n     5\t--\n     6\t-- The trust base of the development, collected into a single flat record\n     7\t-- `Assumptions`, in the style of zkir-v2.  Downstream modules take an\n     8\t-- `Assumptions` value as a module parameter\n     9\t-- (`module M (⋯ : _) (open Assumptions ⋯) where`), so the development\n    10\t-- typechecks under `--safe` with no `postulate`s.\n    11\t--\n    12\t-- The assumed laws are only those the faithfulness proofs consume: the\n    13\t-- field non-triviality `1ᶠ≢0ᶠ` (Group A) and the typed-encoding\n    14\t-- round-trips (Group C).  Laws are admitted only when a proof needs\n    15\t-- them.\n    16\t--\n    17\t-- Chips are modeled at the level of their *functional contract*: each\n    18\t-- field below is the relation a `midnight-zk-stdlib` operation\n    19\t-- guarantees, not its gate-level lowering (see docs/zkir-v3-spec.md §7.0).\n    20\t------------------------------------------------------------------------\n    21\t\n    22\tmodule zkir-v3.Assumptions where\n    23\t\n    24\topen import Data.Bool    using (Bool; if_then_else_)\n    25\topen import Data.Fin     using (Fin)\n  