rc/derive/curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/bn256/fq.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/bn256/fr.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/bn256/curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/k256/base_field.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/k256/curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/tests/field_halo2curves.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/tests/field.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/tests/curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/jubjub/fr.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/jubjub/curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/hash_to_curve.rs\n/home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/midnight-curves-0.3.1/src/curve.rs\n\"\"\"Generate semantics/zkir-constants.k from midnight-circuits 7.2.4 sources.\n\nReads the Poseidon round constants and MDS matrix for the BLS12-381 scalar\nfield (hash/poseidon/constants/blstrs.rs, produced by the pasta-hadeshash grain\nscript for t=3, R_F=8, R_P=60) and the Jubjub map-to-curve parameters\n(ecc/hash_to_curve/mtc_params.rs). `Fq::from_raw([a, b, c, d])` are the four\nlittle-endian 64-bit limbs of the canonical integer.\n\nUsage: python gen_constants.py <midnight-circuits-src-dir> > ../semantics/zkir-constants.k\n\"\"\"\nimport re\nimport sys\nfrom pathlib import Path\n\nsrc = Path(sys.argv[1])\nFROM_RAW = re.compile(r'from_raw\\(\\s*\\[([^\\]]*)\\]\\s*\\)', re.S)\n\n\ndef limbs_to_int(text: str) -> int:\n    limbs = [int(x.replace('_', ''), 16) for x in re.findall(r'0x[0-9a-fA-F_]+', text)]\n    assert len(limbs) == 4, limbs\n    return sum(l << (64 * i) for i, l in enumerate(limbs))\n\n\nblstrs = (src / 'hash/poseidon/constants/blstrs.rs').read_text()\nrc_start = blstrs.index('const ROUND_CONSTANTS')\nmds_start = blstrs.index('const MDS')\nrc_text, mds_text = (blstrs[rc_start:mds_start], blstrs[mds_start:]) if rc_start < mds_start else (blstrs[rc_start:], blstrs[mds_start:rc_start])\nrcs = [limbs_to_int(m) for m in FROM_RAW.findall(rc_text)]\nmds = [limbs_to_int(m) for m in FROM_RAW.findall(mds_text)]\nassert len(rcs) == 68 * 3, len(rcs)\nassert len(mds) == 9, len(mds)\n\nmtc = (src / 'ecc/hash_to_curve/mtc_params.rs').read_text()\nconsts = {}\nfor name in ['SVDW_Z', 'A', 'B', 'MONT_J', 'MONT_K']:\n    m = re.search(r'const %s: JubjubBase = JubjubBase::from_raw\\(\\s*\\[([^\\]]*)\\]' % name, mtc, re.S)\n    consts[name] = limbs_to_int(m.group(1))\n\nout = []\nout.append('// GENERATED by tools/gen_constants.py from midnight-circuits 7.2.4; do not edit.')\nout.append('// Poseidon (BLS12-381 scalar field, t=3, R_F=8, R_P=60) round constants and MDS,')\nout.append('// and the Jubjub Shallue-van de Woestijne map-to-curve parameters.')\nout.append('module ZKIR-CONSTANTS')\nout.append('  imports INT')\nout.append('  syntax Int ::= poseidonRC(Int, Int) [function, total]   // round 0..67, position 0..2')\nfor r in range(68):\n    for j in range(3):\n        out.append(f'  rule poseidonRC({r}, {j}) => {rcs[r * 3 + j]}')\nout.append('  rule poseidonRC(_, _) => 0 [owise]')\nout.append('  syntax Int ::= poseidonMDS(Int, Int) [function, total]')\nfor i in range(3):\n    for j in range(3):\n        out.append(f'  rule poseidonMDS({i}, {j}) => {mds[i * 3 + j]}')\nout.append('  rule poseidonMDS(_, _) => 0 [owise]')\nfor name, k in [('SVDW_Z', 'svdwZ'), ('A', 'svdwA'), ('B', 'svdwB'), ('MONT_J', 'montJ'), ('MONT_K', 'montK')]:\n    out.append(f'  syntax Int ::= \"#{k}\" [function, total]')\n    out.append(f'  rule #{k} => {consts[name]}')\nout.append('endmodule')\nprint('\\n'.join(out))\n","exit_code":0,"status":"completed"}}
