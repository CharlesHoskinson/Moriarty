() != (P::NB_LIMBS as usize).div_ceil(nb_limbs_per_batch)\n   146\t        {\n   147\t            return None;\n   148\t        }\n   149\t        // Every batch must be expressible with `nb_limbs_per_batch` limbs in base\n   150\t        // `base`, otherwise the input is not a valid encoding.\n   151\t        let batch_bound = BI::pow(&base, nb_limbs_per_batch as u32);\n   152\t        let limbs: Vec<BI> = fields\n   153\t            .iter()\n   154\t            .map(|f| {\n   155\t                let bi: BI = f.to_biguint().into();\n   156\t                (bi < batch_bound).then(|| bi_to_limbs(nb_limbs_per_batch as u32, &base, &bi))\n   157\t            })\n   158\t            .collect::<Option<Vec<_>>>()?\n   159\t            .concat();\n   160\t        let (head, tail) = limbs.split_at(P::NB_LIMBS as usize);\n   161\t        if tail.iter().any(|l| !l.is_zero()) {\n   162\t            return None;\n   163\t        }\n   164\t        let element_as_bi = bi_from_limbs(&base, head) + BI::one();\n   165\t        Some(bigint_to_fe::<K>(&element_as_bi))\n   166\t    }\n   167\t}\n   168\t\n   169\timpl<F, K, P> InnerValue for AssignedField<F, K, P>\n   170\twhere\n   171\t    F: CircuitField,\n   172\t    K: CircuitField,\n   173\t    P: FieldEmulationParams<F, K>,\n   174\t{\n   175\t    type Element = K;\n     1\t\"\"\"Python reference for ZKIR v3 values: field constants, curve arithmetic and\n     2\tthe public-input encodings (shared by the unit tests and the differential\n     3\tharness). Everything here is cross-checked against the K definition by\n     4\tunit_values.py; the K definition is cross-checked against the Rust crate by\n     5\tdiff_test.py.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport random\n    10\t\n    11\tR = 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    12\tRJ = 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    13\tK256P = 2**256 - 2**32 - 977\n    14\tK256N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\n    15\tP256P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF\n    16\tP256N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551\n    17\tP256B = 0x5AC635D8AA3A93E7B3EBBD55769886BC651D06B0CC53B0F63BCE3C3E27D2604B\n    18\tC25519P = 2**255 - 19\n    19\tC25519L = 2**252 + 27742317777372353535851937790883648493\n    20\tJUBJUB_D = (-10240 * pow(10241, -1, R)) % R\n    21\tC25519_D = (-121665 * pow(121666, -1, C25519P)) % C25519P\n    22\tJUBJUB_G_FULL = (44746807950788659978687200207992930935149218647843500701850233404325651525118, 11)\n    23\tC25519_G = (15112221349535400772501151409588531511454012693041857206046113283949847762202,\n    24\t            46316835694926478169428394003475163141307993866256225615783033603165251855960)\n    25\tK256_G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,\n    26\t          0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\n    27\tP256_G = (0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,\n    28\t          0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5)\n    29\t\n    30\t\n    31\tdef ed_add(p, q, mod, d):\n    32\t    (x1, y1), (x2, y2) = p, q\n    33\t    t = d * x1 * x2 * y1 * y2 % mod\n    34\t    x3 = (x1 * y2 + y1 * x2) * pow(1 + t, -1, mod) % mod\n    35\t    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, mod) % mod\n    36\t    return (x3, y3)\n    37\t\n    38\t\n    39\tdef ed_mul(p, k, mod, d):\n    40\t    acc = (0, 1)\n    41\t    while k:\n    42\t        if k & 1:\n    43\t            acc = ed_add(acc, p, mod, d)\n    44\t        p = ed_add(p, p, mod, d)\n    45\t        k >>= 1\n    46\t    return acc\n    47\t\n    48\t\n    49\tdef w_add(p, q, mod, a):\n    50\t    if p is None:\n    51\t        return q\n    52\t    if q is None:\n    53\t        return p\n    54\t    (x1, y1), (x2, y2) = p, q\n    55\t    if x1 == x2 and (y1 + y2) % mod == 0:\n    56\t        return None\n    57\t    if p == q:\n    58\t        lam = (3 * x1 * x1 + a) * pow(2 * y1, -1, mod) % mod\n    59\t    else:\n    60\t        lam = (y2 - y1) * pow(x2 - x1, -1, mod) % mod\n    61\t    x3 = (lam * lam - x1 - x2) % mod\n    62\t    y3 = (lam * (x1 - x3) - y1) % mod\n    63\t    return (x3, y3)\n    64\t\n    65\t\n    66\tdef w_mul(p, k, mod, a):\n    67\t    acc = None\n    68\t    while k:\n    69\t        if k & 1:\n    70\t            acc = w_add(acc, p, mod, a)\n    71\t        p = w_add(p, p, mod, a)\n    72\t        k >>= 1\n    73\t    return acc\n    74\t\n    75\t\n    76\tJUBJUB_G = ed_mul(JUBJUB_G_FULL, 8, R, JUBJUB_D)   # subgroup generator\n    77\t\n    78\t\n    79\tdef enc_foreign(x, mod, log2, nb):\n    80\t    e = (x - 1) % mod\n    81\t    per = 254 // log2\n    82\t    out = []\n    83\t    left = nb\n    84\t    while left > 0:\n    85\t        take = min(left, per)\n    86\t        out.append(e & ((1 << (log2 * take)) - 1))\n    87\t        e >>= log2 * take\n    88\t        left -= take\n    89\t    return out\n    90\t\n    91\t\n    92\tdef enc_wpoint(p, mod):\n    93\t    if p is None:\n    94\t        return enc_foreign(0, mod, 64, 4) * 2 + [1]\n    95\t    return enc_foreign(p[0], mod, 64, 4) + enc_foreign(p[1], mod, 64, 4) + [0]\n    96\t\n    97\t\n    98\tENCODED_LEN = {\n    99\t    'Scalar<BLS12-381>': 1, 'Bytes<32>': 2, 'Point<Jubjub>': 2, 'Scalar<Jubjub>': 1,\n   100\t    'Point<Secp256k1>': 5, 'Base<Secp256k1>': 2, 'Scalar<Secp256k1>': 2,\n   101\t    'Point<Secp256r1>': 5, 'Base<Secp256r1>': 2, 'Scalar<Secp256r1>': 2,\n   102\t    'Point<Curve25519>': 4, 'Base<Curve25519>': 2, 'Scalar<Curve25519>': 2,\n   103\t}\n   104\t\n   105\t\n   106\tdef random_encoded(ir_type: str, rng: random.Random) -> list[int]:\n   107\t    \"\"\"A valid raw encoding of a random value of the given type.\"\"\"\n   108\t    if ir_type == 'Bool':\n   109\t        return [rng.randrange(2)]\n   110\t    if ir_type == 'Byte':\n   111\t        return [rng.randrange(256)]\n   112\t    if ir_type.startswith('Bytes<') and ir_type != 'Bytes<32>':\n   113\t        n = int(ir_type[6:-1])\n   114\t        b = bytes(rng.randrange(256) for _ in range(n))\n   115\t        return [int.from_bytes(b[i:i + 31], 'little') for i in range(0, n, 31)]\n   116\t    match ir_type:\n   117\t        case 'Scalar<BLS12-381>':\n   118\t            return [rng.randrange(R)]\n   119\t        case 'Bytes<32>':\n   120\t            return [rng.randrange(1 << 248), rng.randrange(256)]\n   121\t        case 'Point<Jubjub>':\n   122\t            p = ed_mul(JUBJUB_G, rng.randrange(1, RJ), R, JUBJUB_D)\n   123\t            return [p[0], p[1]]\n   124\t        case 'Scalar<Jubjub>':\n   125\t            return [rng.randrange(RJ)]\n   126\t        case 'Point<Secp256k1>':\n   127\t            return enc_wpoint(w_mul(K256_G, rng.randrange(1, K256N), K256P, 0), K256P)\n   128\t        case 'Base<Secp256k1>':\n   129\t            return enc_foreign(rng.randrange(K256P), K256P, 64, 4)\n   130\t        case 'Scalar<Secp256k1>':\n   131\t            return enc_foreign(rng.randrange(K256N), K256N, 64, 4)\n   132\t        case 'Point<Secp256r1>':\n   133\t            return enc_wpoint(w_mul(P256_G, rng.randrange(1, P256N), P256P, P256P - 3), P256P)\n   134\t        case 'Base<Secp256r1>':\n   135\t            return enc_foreign(rng.randrange(P256P), P256P, 64, 4)\n   136\t        case 'Scalar<Secp256r1>':\n   137\t            return enc_foreign(rng.randrange(P256N), P256N, 64, 4)\n   138\t        case 'Point<Curve25519>':\n   139\t            p = ed_mul(C25519_G, rng.randrange(1, C25519L), C25519P, C25519_D)\n   140\t            return enc_foreign(p[0], C25519P, 64, 4) + enc_foreign(p[1], C25519P, 64, 4)\n   141\t        case 'Base<Curve25519>':\n   142\t            return enc_foreign(rng.randrange(C25519P), C25519P, 64, 4)\n   143\t        case 'Scalar<Curve25519>':\n   144\t            return enc_foreign(rng.randrange(C25519L), C25519L, 51, 5)\n   145\t    raise ValueError(ir_type)\n   146\t\n   147\t\n   148\tdef small_encoded(ir_type: str, rng: random.Random) -> list[int]:\n   149\t    \"\"\"Like random_encoded but native values are small booleans/bytes, which\n   150\t    keeps guards, bit bounds and assertions in the Compact-generated programs\n   151\t    plausible.\"\"\"\n   152\t    if ir_type == 'Scalar<BLS12-381>':\n   153\t        return [rng.choice([0, 1, 1, 1, 2, 7, 255])]\n   154\t    return random_encoded(ir_type, rng)\n","exit_code":0,"status":"completed"}}
