{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-field.k; nl -ba experiments/zkir-k/semantics/zkir-curves.k; nl -ba experiments/zkir-k/semantics/zkir-values.k'","aggregated_output":"     1\t// Prime-field arithmetic over K's arbitrary-precision Int (plan decision\n     2\t// CLM-0709). Every function takes the modulus explicitly; results are kept in\n     3\t// canonical range [0, p) with modInt (Euclidean, never negative).\n     4\t//\n     5\t// Moduli (midnight-curves 0.3.1):\n     6\t//   r      BLS12-381 scalar field = ZKIR native field = Jubjub base field\n     7\t//   rJ     Jubjub scalar field (prime-order subgroup order)\n     8\t//   k256P  secp256k1 base field, k256N its group order\n     9\t//   p256P  secp256r1 base field, p256N its group order\n    10\t//   c25519P = 2^255 - 19, c25519L = 2^252 + 27742317777372353535851937790883648493\n    11\tmodule ZKIR-FIELD\n    12\t  imports INT\n    13\t  imports BOOL\n    14\t  imports LIST\n    15\t  imports K-EQUAL\n    16\t\n    17\t  syntax Int ::= \"#r\"        [function, total]\n    18\t               | \"#rJ\"       [function, total]\n    19\t               | \"#k256P\"    [function, total]\n    20\t               | \"#k256N\"    [function, total]\n    21\t               | \"#p256P\"    [function, total]\n    22\t               | \"#p256N\"    [function, total]\n    23\t               | \"#c25519P\"  [function, total]\n    24\t               | \"#c25519L\"  [function, total]\n    25\t  rule #r       => 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    26\t  rule #rJ      => 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    27\t  rule #k256P   => 115792089237316195423570985008687907853269984665640564039457584007908834671663\n    28\t  rule #k256N   => 115792089237316195423570985008687907852837564279074904382605163141518161494337\n    29\t  rule #p256P   => 115792089210356248762697446949407573530086143415290314195533631308867097853951\n    30\t  rule #p256N   => 115792089210356248762697446949407573529996955224135760342422259061068512044369\n    31\t  rule #c25519P => 57896044618658097711785492504343953926634992332820282019728792003956564819949\n    32\t  rule #c25519L => 7237005577332262213973186563042994240857116359379907606001950938285454250989\n    33\t\n    34\t  syntax Int ::= fmod(Int, Int)         [function, total]\n    35\t               | fadd(Int, Int, Int)    [function, total]\n    36\t               | fsub(Int, Int, Int)    [function, total]\n    37\t               | fmul(Int, Int, Int)    [function, total]\n    38\t               | fneg(Int, Int)         [function, total]\n    39\t               | finv(Int, Int)         [function, total]   // inverse by Fermat; finv(0) = 0\n    40\t               | fdiv(Int, Int, Int)    [function, total]\n    41\t               | fpow(Int, Int, Int)    [function, total]\n    42\t               | fsq(Int, Int)          [function, total]\n    43\t  rule fmod(A, P)     => A modInt P\n    44\t  rule fadd(A, B, P)  => (A +Int B) modInt P\n    45\t  rule fsub(A, B, P)  => (A -Int B) modInt P\n    46\t  rule fmul(A, B, P)  => (A *Int B) modInt P\n    47\t  rule fneg(A, P)     => (0 -Int A) modInt P\n    48\t  rule finv(A, P)     => 0 requires A modInt P ==Int 0\n    49\t  rule finv(A, P)     => (A modInt P) ^%Int (P -Int 2) P requires A modInt P =/=Int 0\n    50\t  rule fdiv(A, B, P)  => fmul(A, finv(B, P), P)\n    51\t  rule fpow(A, E, P)  => (A modInt P) ^%Int E P requires E >=Int 0\n    52\t  rule fpow(_, E, _)  => 0 requires E <Int 0\n    53\t  rule fsq(A, P)      => fmul(A, A, P)\n    54\t\n    55\t  // Legendre symbol as 0, 1 or P-1 (i.e. -1); 0 counts as a residue, as in\n    56\t  // midnight-curves `ct_quadratic_non_residue` (legendre == -1).\n    57\t  syntax Int ::= legendre(Int, Int) [function, total]\n    58\t  rule legendre(A, P) => fpow(A, (P -Int 1) /Int 2, P)\n    59\t  syntax Bool ::= isQuadraticNonResidue(Int, Int) [function, total]\n    60\t  rule isQuadraticNonResidue(A, P) => legendre(A, P) ==Int P -Int 1\n    61\t\n    62\t  syntax Bool ::= isOddInt(Int) [function, total]\n    63\t  rule isOddInt(A) => A modInt 2 ==Int 1\n    64\t\n    65\t  // --- Square roots: Tonelli-Shanks ---------------------------------------\n    66\t  // fsqrt(A, P) is sqrtOk(X) with X*X = A mod P for some root, or noSqrt().\n    67\t  // Callers that need a specific root fix the parity themselves, as the Rust\n    68\t  // code does (Jubjub decompression, SVDW map).\n    69\t  syntax SqrtResult ::= sqrtOk(Int) | noSqrt()\n    70\t  syntax SqrtResult ::= fsqrt(Int, Int) [function, total]\n    71\t  rule fsqrt(A, P) => sqrtOk(0) requires A modInt P ==Int 0\n    72\t  rule fsqrt(A, P) => noSqrt() requires A modInt P =/=Int 0 andBool legendre(A, P) =/=Int 1\n    73\t  rule fsqrt(A, P) => #ts(A modInt P, P, #twoAdicity(P -Int 1, 0), #oddPart(P -Int 1), #nonResidue(P, 2))\n    74\t    requires A modInt P =/=Int 0 andBool legendre(A, P) ==Int 1\n    75\t\n    76\t  syntax Int ::= #twoAdicity(Int, Int) [function, total]   // #twoAdicity(N, 0) = s with N = 2^s * odd\n    77\t  rule #twoAdicity(N, S) => #twoAdicity(N /Int 2, S +Int 1) requires N >Int 0 andBool N modInt 2 ==Int 0\n    78\t  rule #twoAdicity(N, S) => S requires N <=Int 0 orBool N modInt 2 ==Int 1\n    79\t  syntax Int ::= #oddPart(Int) [function, total]\n    80\t  rule #oddPart(N) => #oddPart(N /Int 2) requires N >Int 0 andBool N modInt 2 ==Int 0\n    81\t  rule #oddPart(N) => N requires N <=Int 0 orBool N modInt 2 ==Int 1\n    82\t  syntax Int ::= #nonResidue(Int, Int) [function, total]   // smallest quadratic non-residue >= Z\n    83\t  rule #nonResidue(P, Z) => Z requires isQuadraticNonResidue(Z, P)\n    84\t  rule #nonResidue(P, Z) => #nonResidue(P, Z +Int 1) requires notBool isQuadraticNonResidue(Z, P) andBool Z <Int P\n    85\t  rule #nonResidue(P, Z) => 0 requires Z >=Int P\n    86\t\n    87\t  // #ts(A, P, S, Q, Z): standard loop with M = S, c = Z^Q, t = A^Q, R = A^((Q+1)/2)\n    88\t  syntax SqrtResult ::= #ts(Int, Int, Int, Int, Int) [function, total]\n    89\t  rule #ts(A, P, S, Q, Z) => #tsLoop(P, S, fpow(Z, Q, P), fpow(A, Q, P), fpow(A, (Q +Int 1) /Int 2, P))\n    90\t  syntax SqrtResult ::= #tsLoop(Int, Int, Int, Int, Int) [function, total]   // (P, M, c, t, R)\n    91\t  rule #tsLoop(_, _, _, 0, _) => noSqrt()\n    92\t  rule #tsLoop(_, _, _, 1, R) => sqrtOk(R)\n    93\t  rule #tsLoop(P, M, C, T, R) => #tsStep(P, M, C, T, R, #tsOrder(P, T, 0, M))\n    94\t    requires T =/=Int 0 andBool T =/=Int 1\n    95\t  // least i with t^(2^i) = 1\n    96\t  syntax Int ::= #tsOrder(Int, Int, Int, Int) [function, total]\n    97\t  rule #tsOrder(_, 1, I, _) => I\n    98\t  rule #tsOrder(P, T, I, M) => #tsOrder(P, fsq(T, P), I +Int 1, M) requires T =/=Int 1 andBool I <Int M\n    99\t  rule #tsOrder(_, T, I, M) => I requires T =/=Int 1 andBool I >=Int M\n   100\t  syntax SqrtResult ::= #tsStep(Int, Int, Int, Int, Int, Int) [function, total]\n   101\t  rule #tsStep(P, M, C, T, R, I) => noSqrt() requires I >=Int M\n   102\t  rule #tsStep(P, M, C, T, R, I) => #tsLoop(P, I, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P),\n   103\t                                            fmul(T, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P), P),\n   104\t                                            fmul(R, fpow(C, 2 ^Int (M -Int I -Int 1), P), P))\n   105\t    requires I <Int M\n   106\t\n   107\t  // --- Bit and byte helpers ------------------------------------------------\n   108\t  // Little-endian bit I of A (0 or 1).\n   109\t  syntax Int ::= bitAt(Int, Int) [function, total]\n   110\t  rule bitAt(A, I) => (A >>Int I) &Int 1 requires I >=Int 0 andBool A >=Int 0\n   111\t  rule bitAt(_, _) => 0 [owise]\n   112\t  // Low N bits and the rest.\n   113\t  syntax Int ::= lowBits(Int, Int) [function, total]\n   114\t  rule lowBits(A, N) => A &Int ((1 <<Int N) -Int 1) requires N >=Int 0 andBool A >=Int 0\n   115\t  rule lowBits(_, _) => 0 [owise]\n   116\t  syntax Int ::= highBits(Int, Int) [function, total]   // A >> N\n   117\t  rule highBits(A, N) => A >>Int N requires N >=Int 0 andBool A >=Int 0\n   118\t  rule highBits(_, _) => 0 [owise]\n   119\t  syntax Bool ::= fitsBits(Int, Int) [function, total]   // 0 <= A < 2^N\n   120\t  rule fitsBits(A, N) => A >=Int 0 andBool A <Int (1 <<Int N) requires N >=Int 0\n   121\t  rule fitsBits(_, _) => false [owise]\n   122\tendmodule\n     1\t// Affine elliptic-curve arithmetic for the four ZKIR curves.\n     2\t//\n     3\t//   Jubjub      twisted Edwards, a = -1, over r;   subgroup order rJ, cofactor 8\n     4\t//   Curve25519  twisted Edwards, a = -1, over 2^255-19; subgroup order c25519L, cofactor 8\n     5\t//   secp256k1   short Weierstrass y^2 = x^3 + 7 over k256P; prime order k256N\n     6\t//   secp256r1   short Weierstrass y^2 = x^3 - 3x + b over p256P; prime order p256N\n     7\t//\n     8\t// A point is pt(X, Y) or inf(). Edwards curves never use inf(): their identity\n     9\t// is pt(0, 1). Formulas are the complete unified Edwards addition (d is a\n    10\t// non-square on both curves) and the textbook affine Weierstrass addition.\n    11\t// Sources: midnight-curves 0.3.1 (jubjub/curve.rs, curve25519/), curve25519-dalek\n    12\t// 4.1.3 for the Curve25519 base point, the SEC 2 and FIPS 186-4 generators.\n    13\trequires \"zkir-field.k\"\n    14\t\n    15\tmodule ZKIR-CURVES\n    16\t  imports ZKIR-FIELD\n    17\t  imports STRING\n    18\t\n    19\t  syntax Point ::= pt(Int, Int) [symbol(pt)]\n    20\t                 | inf()        [symbol(inf)]\n    21\t\n    22\t  // --- Curve descriptors --------------------------------------------------------\n    23\t  // edwards(p, d, order)   weierstrass(p, a, b, order)\n    24\t  syntax Curve ::= edwards(Int, Int, Int) | weierstrass(Int, Int, Int, Int)\n    25\t\n    26\t  syntax Curve ::= \"#jubjub\" [function, total]\n    27\t                 | \"#curve25519\" [function, total]\n    28\t                 | \"#secp256k1\" [function, total]\n    29\t                 | \"#secp256r1\" [function, total]\n    30\t  // Jubjub d = -(10240/10241) mod r (midnight-curves jubjub/curve.rs EDWARDS_D)\n    31\t  rule #jubjub     => edwards(#r, fneg(fdiv(10240, 10241, #r), #r), #rJ)\n    32\t  // Curve25519 d = -(121665/121666) mod p\n    33\t  rule #curve25519 => edwards(#c25519P, fneg(fdiv(121665, 121666, #c25519P), #c25519P), #c25519L)\n    34\t  rule #secp256k1  => weierstrass(#k256P, 0, 7, #k256N)\n    35\t  rule #secp256r1  => weierstrass(#p256P, #p256P -Int 3,\n    36\t                        41058363725152142129326129780047268409114441015993725554835256314039467401291, #p256N)\n    37\t\n    38\t  syntax Int ::= curveField(Curve) [function, total]\n    39\t  rule curveField(edwards(P, _, _)) => P\n    40\t  rule curveField(weierstrass(P, _, _, _)) => P\n    41\t  syntax Int ::= curveOrder(Curve) [function, total]\n    42\t  rule curveOrder(edwards(_, _, N)) => N\n    43\t  rule curveOrder(weierstrass(_, _, _, N)) => N\n    44\t\n    45\t  // --- Generators ---------------------------------------------------------------\n    46\t  // Jubjub: JubjubAffine::generator() (u, v) of midnight-curves; the subgroup\n    47\t  // generator used by `JubjubSubgroup::generator()` is its cofactor clearing, 8*G.\n    48\t  syntax Point ::= \"#jubjubGenerator\" [function, total]\n    49\t  rule #jubjubGenerator => ecMul(#jubjub,\n    50\t    pt(44746807950788659978687200207992930935149218647843500701850233404325651525118, 11), 8)\n    51\t  // Curve25519: ED25519_BASEPOINT_POINT (already in the prime-order subgroup).\n    52\t  syntax Point ::= \"#curve25519Generator\" [function, total]\n    53\t  rule #curve25519Generator => pt(15112221349535400772501151409588531511454012693041857206046113283949847762202,\n    54\t                                  46316835694926478169428394003475163141307993866256225615783033603165251855960)\n    55\t  syntax Point ::= \"#secp256k1Generator\" [function, total]\n    56\t  rule #secp256k1Generator => pt(55066263022277343669578718895168534326250603453777594175500187360389116729240,\n    57\t                                 32670510020758816978083085130507043184471273380659243275938904335757337482424)\n    58\t  syntax Point ::= \"#secp256r1Generator\" [function, total]\n    59\t  rule #secp256r1Generator => pt(48439561293906451759052585252797914202762949526041747995844080717082404635286,\n    60\t                                 36134250956749795798585127919587881956611106672985015071877198253568414405109)\n    61\t\n    62\t  // --- Membership -----------------------------------------------------------------\n    63\t  syntax Bool ::= onCurve(Curve, Point) [function, total]\n    64\t  rule onCurve(_, inf()) => true\n    65\t  // -x^2 + y^2 = 1 + d x^2 y^2\n    66\t  rule onCurve(edwards(P, D, _), pt(X, Y))\n    67\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    68\t       fsub(fsq(Y, P), fsq(X, P), P) ==Int fadd(1, fmul(D, fmul(fsq(X, P), fsq(Y, P), P), P), P)\n    69\t  rule onCurve(weierstrass(P, A, B, _), pt(X, Y))\n    70\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    71\t       fsq(Y, P) ==Int fadd(fadd(fmul(fsq(X, P), X, P), fmul(A, X, P), P), B, P)\n    72\t\n    73\t  syntax Point ::= identity(Curve) [function, total]\n    74\t  rule identity(edwards(_, _, _)) => pt(0, 1)\n    75\t  rule identity(weierstrass(_, _, _, _)) => inf()\n    76\t\n    77\t  syntax Bool ::= isIdentity(Curve, Point) [function, total]\n    78\t  rule isIdentity(C, Q) => Q ==K identity(C)\n    79\t\n    80\t  // In the prime-order subgroup: order * Q = identity (Weierstrass groups are\n    81\t  // prime order, so any curve point qualifies).\n    82\t  syntax Bool ::= inSubgroup(Curve, Point) [function, total]\n    83\t  rule inSubgroup(edwards(P, D, N), Q) => isIdentity(edwards(P, D, N), ecMul(edwards(P, D, N), Q, N))\n    84\t  rule inSubgroup(weierstrass(_, _, _, _), _) => true\n    85\t\n    86\t  // --- Group law ------------------------------------------------------------------\n    87\t  syntax Point ::= ecNeg(Curve, Point) [function, total]\n    88\t  rule ecNeg(edwards(P, _, _), pt(X, Y)) => pt(fneg(X, P), Y)\n    89\t  rule ecNeg(weierstrass(P, _, _, _), pt(X, Y)) => pt(X, fneg(Y, P))\n    90\t  rule ecNeg(_, inf()) => inf()\n    91\t\n    92\t  syntax Point ::= ecAdd(Curve, Point, Point) [function, total]\n    93\t  rule ecAdd(edwards(P, D, _), pt(X1, Y1), pt(X2, Y2))\n    94\t    => pt(fdiv(fadd(fmul(X1, Y2, P), fmul(Y1, X2, P), P),\n    95\t              fadd(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P),\n    96\t          fdiv(fadd(fmul(Y1, Y2, P), fmul(X1, X2, P), P),\n    97\t              fsub(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P))\n    98\t  rule ecAdd(edwards(_, _, _), _, inf()) => inf()   // never reached for valid values\n    99\t  rule ecAdd(edwards(_, _, _), inf(), _) => inf()\n   100\t  rule ecAdd(weierstrass(_, _, _, _), inf(), Q) => Q\n   101\t  rule ecAdd(weierstrass(_, _, _, _), Q, inf()) => Q\n   102\t  rule ecAdd(weierstrass(P, A, B, N), pt(X1, Y1), pt(X2, Y2))\n   103\t    => ecDouble(weierstrass(P, A, B, N), pt(X1, Y1))\n   104\t    requires X1 ==Int X2 andBool Y1 ==Int Y2\n   105\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2)) => inf()\n   106\t    requires X1 ==Int X2 andBool Y1 =/=Int Y2\n   107\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2))\n   108\t    => #wChord(P, X1, Y1, X2, fdiv(fsub(Y2, Y1, P), fsub(X2, X1, P), P))\n   109\t    requires X1 =/=Int X2\n   110\t  syntax Point ::= #wChord(Int, Int, Int, Int, Int) [function, total]   // (P, X1, Y1, X2, lambda)\n   111\t  rule #wChord(P, X1, Y1, X2, L) => pt(fsub(fsub(fsq(L, P), X1, P), X2, P),\n   112\t                                       fsub(fmul(L, fsub(X1, fsub(fsub(fsq(L, P), X1, P), X2, P), P), P), Y1, P))\n   113\t\n   114\t  syntax Point ::= ecDouble(Curve, Point) [function, total]\n   115\t  rule ecDouble(edwards(P, D, N), Q) => ecAdd(edwards(P, D, N), Q, Q)\n   116\t  rule ecDouble(weierstrass(_, _, _, _), inf()) => inf()\n   117\t  rule ecDouble(weierstrass(_, _, _, _), pt(_, 0)) => inf()\n   118\t  rule ecDouble(weierstrass(P, A, _, _), pt(X, Y))\n   119\t    => #wChord(P, X, Y, X, fdiv(fadd(fmul(3, fsq(X, P), P), A, P), fmul(2, Y, P), P))\n   120\t    requires Y =/=Int 0\n   121\t\n   122\t  // Double-and-add over the bits of K (K >= 0; callers pass canonical scalars).\n   123\t  syntax Point ::= ecMul(Curve, Point, Int) [function, total]\n   124\t  rule ecMul(C, _, K) => identity(C) requires K <=Int 0\n   125\t  rule ecMul(C, Q, K) => #ecMulAcc(C, Q, K, identity(C)) requires K >Int 0\n   126\t  syntax Point ::= #ecMulAcc(Curve, Point, Int, Point) [function, total]\n   127\t  rule #ecMulAcc(_, _, 0, Acc) => Acc\n   128\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, ecAdd(C, Acc, Q))\n   129\t    requires K >Int 0 andBool K modInt 2 ==Int 1\n   130\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, Acc)\n   131\t    requires K >Int 0 andBool K modInt 2 ==Int 0\n   132\t  rule #ecMulAcc(_, _, K, Acc) => Acc requires K <Int 0\n   133\t\n   134\t  // --- Constructors from coordinates -------------------------------------------------\n   135\t  syntax PointResult ::= ptOk(Point) | ptErr(String)\n   136\t\n   137\t  // Exact membership test (secp256k1, secp256r1 via SEC1 decoding; Curve25519\n   138\t  // via the curve equation in midnight-curves Curve25519Affine::from_xy).\n   139\t  syntax PointResult ::= fromXY(Curve, Int, Int) [function, total]\n   140\t  rule fromXY(C, X, Y) => ptOk(pt(X, Y)) requires onCurve(C, pt(X, Y))\n   141\t  rule fromXY(C, X, Y) => ptErr(\"point is not on the curve\") requires notBool onCurve(C, pt(X, Y))\n   142\t\n   143\t  // Jubjub `from_xy` of midnight-circuits (ecc/curves.rs): compresses (y, parity\n   144\t  // of x) and decompresses with JubjubAffine::from_bytes, so only the low bit\n   145\t  // of x is used; the recovered x is the root of (y^2-1)/(1+d y^2) with that\n   146\t  // parity. Fails when y is not the v-coordinate of any point, or when\n   147\t  // (ZIP 216) u = 0 with the sign bit set.\n   148\t  syntax PointResult ::= jubjubFromXY(Int, Int) [function, total]\n   149\t  rule jubjubFromXY(X, Y) => ptErr(\"coordinate out of range\") requires Y <Int 0 orBool Y >=Int #r orBool X <Int 0 orBool X >=Int #r\n   150\t  rule jubjubFromXY(X, Y) => #jubjubDecompress(X modInt 2, Y, fsqrt(fdiv(fsub(fsq(Y, #r), 1, #r), fadd(1, fmul(#jubjubD, fsq(Y, #r), #r), #r), #r), #r))\n   151\t    requires Y >=Int 0 andBool Y <Int #r andBool X >=Int 0 andBool X <Int #r\n   152\t  syntax Int ::= \"#jubjubD\" [function, total]\n   153\t  rule #jubjubD => fneg(fdiv(10240, 10241, #r), #r)\n   154\t  syntax PointResult ::= #jubjubDecompress(Int, Int, SqrtResult) [function, total]\n   155\t  rule #jubjubDecompress(_, _, noSqrt()) => ptErr(\"y is not on Jubjub\")\n   156\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(U, Y)) requires U modInt 2 ==Int Sign\n   157\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptErr(\"invalid Jubjub encoding: -0\")\n   158\t    requires U modInt 2 =/=Int Sign andBool U ==Int 0\n   159\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(fneg(U, #r), Y))\n   160\t    requires U modInt 2 =/=Int Sign andBool U =/=Int 0\n   161\tendmodule\n     1\t// ZKIR v3 runtime values (ir_types.rs `IrValue`) and their encoding as raw\n     2\t// native field elements (ir_instructions/encode.rs, midnight-circuits 7.2.4\n     3\t// `Instantiable::as_public_input` / `from_public_input`).\n     4\t//\n     5\t//   Native            [x]\n     6\t//   Bytes32           [int_le(bytes[0..31]), bytes[31]]\n     7\t//   JubjubPoint       [x, y]  (affine twisted-Edwards coordinates)\n     8\t//   JubjubScalar      [s]     (252-bit scalar, one element)\n     9\t//   Foreign field K   limbs of (x - 1 mod p) in base 2^LOG2_BASE, NB_LIMBS limbs,\n    10\t//                     grouped 254/LOG2_BASE limbs per element:\n    11\t//                       secp256k1/secp256r1 base and scalar, Curve25519 base:\n    12\t//                         LOG2_BASE 64, 4 limbs, 3 per element  -> 2 elements\n    13\t//                       Curve25519 scalar: LOG2_BASE 51, 5 limbs, 4 per element -> 2 elements\n    14\t//   Weierstrass point enc(x) ++ enc(y) ++ [is_identity]; identity encodes (0,0),\n    15\t//                     i.e. enc(p-1) twice, then 1\n    16\t//   Curve25519 point  enc(x) ++ enc(y)\n    17\trequires \"zkir-syntax.k\"\n    18\trequires \"zkir-curves.k\"\n    19\t\n    20\tmodule ZKIR-VALUES\n    21\t  imports ZKIR-SYNTAX\n    22\t  imports ZKIR-CURVES\n    23\t  imports BYTES\n    24\t  imports LIST\n    25\t  imports STRING\n    26\t\n    27\t  syntax Value ::= native(Int)            [symbol(nativeV)]\n    28\t                 | bytes32(Bytes)         [symbol(bytes32V)]\n    29\t                 | jubjubPoint(Point)     [symbol(jubjubPointV)]\n    30\t                 | jubjubScalar(Int)      [symbol(jubjubScalarV)]\n    31\t                 | secp256k1Point(Point)  [symbol(secp256k1PointV)]\n    32\t                 | secp256k1Base(Int)     [symbol(secp256k1BaseV)]\n    33\t                 | secp256k1Scalar(Int)   [symbol(secp256k1ScalarV)]\n    34\t                 | secp256r1Point(Point)  [symbol(secp256r1PointV)]\n    35\t                 | secp256r1Base(Int)     [symbol(secp256r1BaseV)]\n    36\t                 | secp256r1Scalar(Int)   [symbol(secp256r1ScalarV)]\n    37\t                 | curve25519Point(Point) [symbol(curve25519PointV)]\n    38\t                 | curve25519Base(Int)    [symbol(curve25519BaseV)]\n    39\t                 | curve25519Scalar(Int)  [symbol(curve25519ScalarV)]\n    40\t\n    41\t  syntax IrType ::= typeOf(Value) [function, total]\n    42\t  rule typeOf(native(_))          => native()\n    43\t  rule typeOf(bytes32(_))         => bytes32()\n    44\t  rule typeOf(jubjubPoint(_))     => jubjubPoint()\n    45\t  rule typeOf(jubjubScalar(_))    => jubjubScalar()\n    46\t  rule typeOf(secp256k1Point(_))  => secp256k1Point()\n    47\t  rule typeOf(secp256k1Base(_))   => secp256k1Base()\n    48\t  rule typeOf(secp256k1Scalar(_)) => secp256k1Scalar()\n    49\t  rule typeOf(secp256r1Point(_))  => secp256r1Point()\n    50\t  rule typeOf(secp256r1Base(_))   => secp256r1Base()\n    51\t  rule typeOf(secp256r1Scalar(_)) => secp256r1Scalar()\n    52\t  rule typeOf(curve25519Point(_)) => curve25519Point()\n    53\t  rule typeOf(curve25519Base(_))  => curve25519Base()\n    54\t  rule typeOf(curve25519Scalar(_))=> curve25519Scalar()\n    55\t\n    56\t  // `IrValue::default(t)`: zero / identity of each type.\n    57\t  syntax Value ::= defaultValue(IrType) [function, total]\n    58\t  rule defaultValue(native())          => native(0)\n    59\t  rule defaultValue(bytes32())         => bytes32(padRightBytes(.Bytes, 32, 0))\n    60\t  rule defaultValue(jubjubPoint())     => jubjubPoint(pt(0, 1))\n    61\t  rule defaultValue(jubjubScalar())    => jubjubScalar(0)\n    62\t  rule defaultValue(secp256k1Point())  => secp256k1Point(inf())\n    63\t  rule defaultValue(secp256k1Base())   => secp256k1Base(0)\n    64\t  rule defaultValue(secp256k1Scalar()) => secp256k1Scalar(0)\n    65\t  rule defaultValue(secp256r1Point())  => secp256r1Point(inf())\n    66\t  rule defaultValue(secp256r1Base())   => secp256r1Base(0)\n    67\t  rule defaultValue(secp256r1Scalar()) => secp256r1Scalar(0)\n    68\t  rule defaultValue(curve25519Point()) => curve25519Point(pt(0, 1))\n    69\t  rule defaultValue(curve25519Base())  => curve25519Base(0)\n    70\t  rule defaultValue(curve25519Scalar())=> curve25519Scalar(0)\n    71\t\n    72\t  // Debug-style names matching the Rust variant names (used by the oracle).\n    73\t  syntax String ::= typeName(IrType) [function, total]\n    74\t  rule typeName(native())          => \"Native\"\n    75\t  rule typeName(bytes32())         => \"Bytes32\"\n    76\t  rule typeName(jubjubPoint())     => \"JubjubPoint\"\n    77\t  rule typeName(jubjubScalar())    => \"JubjubScalar\"\n    78\t  rule typeName(secp256k1Point())  => \"Secp256k1Point\"\n    79\t  rule typeName(secp256k1Base())   => \"Secp256k1Base\"\n    80\t  rule typeName(secp256k1Scalar()) => \"Secp256k1Scalar\"\n    81\t  rule typeName(secp256r1Point())  => \"Secp256r1Point\"\n    82\t  rule typeName(secp256r1Base())   => \"Secp256r1Base\"\n    83\t  rule typeName(secp256r1Scalar()) => \"Secp256r1Scalar\"\n    84\t  rule typeName(curve25519Point()) => \"Curve25519Point\"\n    85\t  rule typeName(curve25519Base())  => \"Curve25519Base\"\n    86\t  rule typeName(curve25519Scalar())=> \"Curve25519Scalar\"\n    87\t\n    88\t  // --- Foreign-field limb encoding -------------------------------------------------\n    89\t  // encForeign(x, p, log2Base, nbLimbs): list of native elements.\n    90\t  syntax List ::= encForeign(Int, Int, Int, Int) [function, total]\n    91\t  rule encForeign(X, P, L, NB) => #groupLimbs(fsub(X, 1, P), L, NB, 254 /Int L)\n    92\t  // #groupLimbs(e, log2Base, limbsLeft, perBatch): successive batches of perBatch limbs\n    93\t  syntax List ::= #groupLimbs(Int, Int, Int, Int) [function, total]\n    94\t  rule #groupLimbs(_, _, NB, _) => .List requires NB <=Int 0\n    95\t  rule #groupLimbs(E, L, NB, B) => ListItem(lowBits(E, L *Int minInt(NB, B))) #groupLimbs(highBits(E, L *Int minInt(NB, B)), L, NB -Int minInt(NB, B), B)\n    96\t    requires NB >Int 0\n    97\t\n    98\t  // decForeign(fields, p, log2Base, nbLimbs): the element, or -1 when the\n    99\t  // encoding is invalid (wrong count, batch too large, non-zero tail limbs).\n   100\t  syntax Int ::= decForeign(List, Int, Int, Int) [function, total]\n   101\t  rule decForeign(Fs, P, L, NB) => -1\n   102\t    requires size(Fs) =/=Int (NB +Int (254 /Int L) -Int 1) /Int (254 /Int L)\n   103\t  rule decForeign(Fs, P, L, NB) => #decForeign(Fs, P, L, NB, 254 /Int L, 0, 0)\n   104\t    requires size(Fs) ==Int (NB +Int (254 /Int L) -Int 1) /Int (254 /Int L)\n   105\t  // #decForeign(fields, p, log2, nb, perBatch, accumulated, limbsSeen)\n   106\t  syntax Int ::= #decForeign(List, Int, Int, Int, Int, Int, Int) [function, total]\n   107\t  rule #decForeign(.List, P, L, NB, _, Acc, _) => fadd(Acc, 1, P)\n   108\t    requires fitsBits(Acc, L *Int NB)\n   109\t  rule #decForeign(.List, _, L, NB, _, Acc, _) => -1\n   110\t    requires notBool fitsBits(Acc, L *Int NB)\n   111\t  rule #decForeign(ListItem(F) Fs, P, L, NB, B, Acc, Seen) => -1\n   112\t    requires notBool fitsBits(F, L *Int B)\n   113\t  rule #decForeign(ListItem(F) Fs, P, L, NB, B, Acc, Seen)\n   114\t    => #decForeign(Fs, P, L, NB, B, Acc +Int (F <<Int (L *Int Seen)), Seen +Int B)\n   115\t    requires fitsBits(F, L *Int B)\n   116\t\n   117\t  // Curve-specific parameters (LOG2_BASE, NB_LIMBS) over the BLS12-381 scalar field.\n   118\t  syntax List ::= encField64(Int, Int) [function, total]    // 64-bit limbs, 4 limbs\n   119\t  rule encField64(X, P) => encForeign(X, P, 64, 4)\n   120\t  syntax Int ::= decField64(List, Int) [function, total]\n   121\t  rule decField64(Fs, P) => decForeign(Fs, P, 64, 4)\n   122\t\n   123\t  // --- Points ----------------------------------------------------------------------\n   124\t  syntax List ::= encWPoint(Point, Int) [function, total]\n   125\t  rule encWPoint(inf(), P) => encField64(0, P) encField64(0, P) ListItem(1)\n   126\t  rule encWPoint(pt(X, Y), P) => encField64(X, P) encField64(Y, P) ListItem(0)\n   127\t  syntax List ::= encEPointForeign(Point, Int) [function, total]\n   128\t  rule encEPointForeign(pt(X, Y), P) => encField64(X, P) encField64(Y, P)\n   129\t  rule encEPointForeign(inf(), P) => encField64(0, P) encField64(1, P)\n   130\t\n   131\t  // --- Value encoding (encode_offcircuit) ---------------------------------------------\n   132\t  syntax List ::= encodeValue(Value) [function, total]\n   133\t  rule encodeValue(native(X))            => ListItem(X)\n   134\t  rule encodeValue(bytes32(B))           => ListItem(Bytes2Int(substrBytes(B, 0, 31), LE, Unsigned)) ListItem(B[31])\n   135\t  rule encodeValue(jubjubPoint(pt(X, Y))) => ListItem(X) ListItem(Y)\n   136\t  rule encodeValue(jubjubPoint(inf()))   => ListItem(0) ListItem(1)\n   137\t  rule encodeValue(jubjubScalar(S))      => ListItem(S)\n   138\t  rule encodeValue(secp256k1Point(Q))    => encWPoint(Q, #k256P)\n   139\t  rule encodeValue(secp256k1Base(X))     => encField64(X, #k256P)\n   140\t  rule encodeValue(secp256k1Scalar(X))   => encField64(X, #k256N)\n   141\t  rule encodeValue(secp256r1Point(Q))    => encWPoint(Q, #p256P)\n   142\t  rule encodeValue(secp256r1Base(X))     => encField64(X, #p256P)\n   143\t  rule encodeValue(secp256r1Scalar(X))   => encField64(X, #p256N)\n   144\t  rule encodeValue(curve25519Point(Q))   => encEPointForeign(Q, #c25519P)\n   145\t  rule encodeValue(curve25519Base(X))    => encField64(X, #c25519P)\n   146\t  rule encodeValue(curve25519Scalar(X))  => encForeign(X, #c25519L, 51, 5)\n   147\t\n   148\t  // --- Value decoding (decode_offcircuit) -------------------------------------------------\n   149\t  syntax DecodeResult ::= decOk(Value) | decErr(String)\n   150\t\n   151\t  syntax DecodeResult ::= decodeValue(List, IrType) [function, total]\n   152\t  rule decodeValue(ListItem(X), native()) => decOk(native(X))\n   153\t  rule decodeValue(Fs, native()) => decErr(\"Failed to decode as Native\") requires size(Fs) =/=Int 1\n   154\t\n   155\t  // Bytes32: the Rust decoder asserts (panics) when the low element uses byte\n   156\t  // 31 or the high element exceeds one byte; both are errors here.\n   157\t  rule decodeValue(ListItem(Lo) ListItem(Hi), bytes32())\n   158\t    => decOk(bytes32(replaceAtBytes(Int2Bytes(32, Lo, LE), 31, Int2Bytes(1, Hi, LE))))\n   159\t    requires fitsBits(Lo, 248) andBool fitsBits(Hi, 8)\n   160\t  rule decodeValue(ListItem(Lo) ListItem(Hi), bytes32()) => decErr(\"Bytes32 decoding assertion failed\")\n   161\t    requires notBool (fitsBits(Lo, 248) andBool fitsBits(Hi, 8))\n   162\t  rule decodeValue(Fs, bytes32()) => decErr(\"Failed to decode as Bytes32\") requires size(Fs) =/=Int 2\n   163\t\n   164\t  rule decodeValue(ListItem(X) ListItem(Y), jubjubPoint()) => #decJubjub(jubjubFromXY(X, Y))\n   165\t  rule decodeValue(Fs, jubjubPoint()) => decErr(\"Failed to decode as JubjubPoint\") requires size(Fs) =/=Int 2\n   166\t  syntax DecodeResult ::= #decJubjub(PointResult) [function, total]\n   167\t  rule #decJubjub(ptErr(_)) => decErr(\"Failed to decode as JubjubPoint\")\n   168\t  rule #decJubjub(ptOk(Q)) => decOk(jubjubPoint(Q)) requires inSubgroup(#jubjub, Q)\n   169\t  rule #decJubjub(ptOk(Q)) => decErr(\"Failed to decode as JubjubPoint\") requires notBool inSubgroup(#jubjub, Q)\n   170\t\n   171\t  // JubjubScalar: one element below 2^254; its low 252 bits must be a canonical\n   172\t  // scalar (AssignedScalarOfNativeCurve::from_public_input).\n   173\t  rule decodeValue(ListItem(F), jubjubScalar()) => decOk(jubjubScalar(lowBits(F, 252)))\n   174\t    requires fitsBits(F, 254) andBool lowBits(F, 252) <Int #rJ\n   175\t  rule decodeValue(ListItem(F), jubjubScalar()) => decErr(\"Failed to decode as JubjubScalar\")\n   176\t    requires notBool (fitsBits(F, 254) andBool lowBits(F, 252) <Int #rJ)\n   177\t  rule decodeValue(Fs, jubjubScalar()) => decErr(\"Failed to decode as JubjubScalar\") requires size(Fs) =/=Int 1\n   178\t\n   179\t  rule decodeValue(Fs, secp256k1Base())   => #decField(decField64(Fs, #k256P), secp256k1Base())\n   180\t  rule decodeValue(Fs, secp256k1Scalar()) => #decField(decField64(Fs, #k256N), secp256k1Scalar())\n   181\t  rule decodeValue(Fs, secp256r1Base())   => #decField(decField64(Fs, #p256P), secp256r1Base())\n   182\t  rule decodeValue(Fs, secp256r1Scalar()) => #decField(decField64(Fs, #p256N), secp256r1Scalar())\n   183\t  rule decodeValue(Fs, curve25519Base())  => #decField(decField64(Fs, #c25519P), curve25519Base())\n   184\t  rule decodeValue(Fs, curve25519Scalar())=> #decField(decForeign(Fs, #c25519L, 51, 5), curve25519Scalar())\n   185\t  syntax DecodeResult ::= #decField(Int, IrType) [function, total]\n   186\t  rule #decField(-1, T) => decErr(\"Failed to decode as \" +String typeName(T))\n   187\t  rule #decField(X, secp256k1Base())    => decOk(secp256k1Base(X))    requires X >=Int 0\n   188\t  rule #decField(X, secp256k1Scalar())  => decOk(secp256k1Scalar(X))  requires X >=Int 0\n   189\t  rule #decField(X, secp256r1Base())    => decOk(secp256r1Base(X))    requires X >=Int 0\n   190\t  rule #decField(X, secp256r1Scalar())  => decOk(secp256r1Scalar(X))  requires X >=Int 0\n   191\t  rule #decField(X, curve25519Base())   => decOk(curve25519Base(X))   requires X >=Int 0\n   192\t  rule #decField(X, curve25519Scalar()) => decOk(curve25519Scalar(X)) requires X >=Int 0\n   193\t  rule #decField(_, T) => decErr(\"Failed to decode as \" +String typeName(T)) [owise]\n   194\t\n   195\t  // Weierstrass points: 5 elements; last == 1 means identity.\n   196\t  rule decodeValue(Fs, secp256k1Point()) => #decWPoint(Fs, #secp256k1, secp256k1Point())\n   197\t  rule decodeValue(Fs, secp256r1Point()) => #decWPoint(Fs, #secp256r1, secp256r1Point())\n   198\t  syntax DecodeResult ::= #decWPoint(List, Curve, IrType) [function, total]\n   199\t  rule #decWPoint(Fs, C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires size(Fs) =/=Int 5\n   200\t  rule #decWPoint(Fs, C, T) => decOk(#wrapPoint(inf(), T)) requires size(Fs) ==Int 5 andBool Fs[4] ==K 1\n   201\t  rule #decWPoint(Fs, C, T) => #decWPointXY(decField64(range(Fs, 0, 3), curveField(C)), decField64(range(Fs, 2, 1), curveField(C)), C, T)\n   202\t    requires size(Fs) ==Int 5 andBool Fs[4] =/=K 1\n   203\t  syntax DecodeResult ::= #decWPointXY(Int, Int, Curve, IrType) [function, total]\n   204\t  rule #decWPointXY(X, Y, C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires X <Int 0 orBool Y <Int 0\n   205\t  rule #decWPointXY(X, Y, C, T) => #decPointResult(fromXY(C, X, Y), C, T) requires X >=Int 0 andBool Y >=Int 0\n   206\t  syntax DecodeResult ::= #decPointResult(PointResult, Curve, IrType) [function, total]\n   207\t  rule #decPointResult(ptErr(_), _, T) => decErr(\"Failed to decode as \" +String typeName(T))\n   208\t  rule #decPointResult(ptOk(Q), C, T) => decOk(#wrapPoint(Q, T)) requires inSubgroup(C, Q)\n   209\t  rule #decPointResult(ptOk(Q), C, T) => decErr(\"Failed to decode as \" +String typeName(T)) requires notBool inSubgroup(C, Q)\n   210\t\n   211\t  // Curve25519 points: 4 elements, exact curve check then subgroup check.\n   212\t  rule decodeValue(Fs, curve25519Point()) => decErr(\"Failed to decode as Curve25519Point\") requires size(Fs) =/=Int 4\n   213\t  rule decodeValue(Fs, curve25519Point())\n   214\t    => #decWPointXY(decField64(range(Fs, 0, 2), #c25519P), decField64(range(Fs, 2, 0), #c25519P), #curve25519, curve25519Point())\n   215\t    requires size(Fs) ==Int 4\n   216\t\n   217\t  syntax Value ::= #wrapPoint(Point, IrType) [function, total]\n   218\t  rule #wrapPoint(Q, secp256k1Point())  => secp256k1Point(Q)\n   219\t  rule #wrapPoint(Q, secp256r1Point())  => secp256r1Point(Q)\n   220\t  rule #wrapPoint(Q, curve25519Point()) => curve25519Point(Q)\n   221\t  rule #wrapPoint(Q, jubjubPoint())     => jubjubPoint(Q)\n   222\t  rule #wrapPoint(_, _)                 => native(0) [owise]\n   223\t\n   224\t  // Strict decoding re-encodes the value and demands the original elements\n   225\t  // (midnight-zkir 2ffe2d1 `decode_offcircuit`); 92e8bdd3 does not check.\n   226\t  syntax DecodeResult ::= decodeStrict(List, IrType, Bool) [function, total]\n   227\t  rule decodeStrict(L, T, false) => decodeValue(L, T)\n   228\t  rule decodeStrict(L, T, true) => #canonical(decodeValue(L, T), L, T)\n   229\t  syntax DecodeResult ::= #canonical(DecodeResult, List, IrType) [function, total]\n   230\t  rule #canonical(decErr(S), _, _) => decErr(S)\n   231\t  rule #canonical(decOk(V), L, _) => decOk(V) requires encodeValue(V) ==K L\n   232\t  rule #canonical(decOk(V), L, T) => decErr(\"The encoded value of type \" +String typeName(T) +String \" is not in canonical form\") requires encodeValue(V) =/=K L\n   233\t\n   234\t  // Decode a whole raw vector by a list of types (inputs of a program):\n   235\t  // decodeMany(raw, types) is decManyOk(values) or decErr; the Rust code\n   236\t  // reports running out of inputs and leftover inputs as separate errors.\n   237\t  syntax DecodeMany ::= decManyOk(List) | decManyErr(String)\n   238\t  syntax DecodeMany ::= decodeInputs(List, TypedIds, Int, Bool) [function, total]   // (raw, inputs, index, strict)\n   239\t  rule decodeInputs(Raw, .TypedIds, Idx, _) => decManyOk(.List) requires Idx ==Int size(Raw)\n   240\t  rule decodeInputs(Raw, .TypedIds, Idx, _) => decManyErr(\"Expected \" +String Int2String(Idx) +String \" raw inputs, received \" +String Int2String(size(Raw)))\n   241\t    requires Idx =/=Int size(Raw)\n   242\t  rule decodeInputs(Raw, (typedId(N, T), _), Idx, _)\n   243\t    => decManyErr(\"Not enough raw inputs: ran out at index \" +String Int2String(Idx) +String \" while decoding \" +String N)\n   244\t    requires Idx +Int encodedLen(T) >Int size(Raw)\n   245\t  rule decodeInputs(Raw, (typedId(N, T), Rest), Idx, Strict)\n   246\t    => #consDecoded(decodeStrict(range(Raw, Idx, size(Raw) -Int Idx -Int encodedLen(T)), T, Strict), N, decodeInputs(Raw, Rest, Idx +Int encodedLen(T), Strict))\n   247\t    requires Idx +Int encodedLen(T) <=Int size(Raw)\n   248\t  syntax DecodeMany ::= #consDecoded(DecodeResult, String, DecodeMany) [function, total]\n   249\t  rule #consDecoded(decErr(S), _, _) => decManyErr(S)\n   250\t  rule #consDecoded(decOk(_), _, decManyErr(S)) => decManyErr(S)\n   251\t  rule #consDecoded(decOk(V), N, decManyOk(L)) => decManyOk(ListItem(binding(N, V)) L)\n   252\t  syntax Binding ::= binding(String, Value)\n   253\t\n   254\t  // --- Bytes32 helpers ------------------------------------------------------------------\n   255\t  // Canonical little-endian 32-byte form of a field element (into_bytes32).\n   256\t  syntax Bytes ::= intToBytes32(Int) [function, total]\n   257\t  rule intToBytes32(X) => Int2Bytes(32, X, LE) requires X >=Int 0\n   258\t  rule intToBytes32(_) => padRightBytes(.Bytes, 32, 0) [owise]\n   259\t  syntax Int ::= bytes32ToInt(Bytes) [function, total]\n   260\t  rule bytes32ToInt(B) => Bytes2Int(B, LE, Unsigned)\n   261\tendmodule\n","exit_code":0,"status":"completed"}}
