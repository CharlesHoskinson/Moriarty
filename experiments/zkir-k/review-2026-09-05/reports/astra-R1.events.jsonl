OUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\t//! Map to curve parameter traits and implementations.\n    15\t\n    16\tuse midnight_curves::{Fq as JubjubBase, JubjubExtended as Jubjub};\n    17\t\n    18\tuse crate::CircuitField;\n    19\t\n    20\t/// Constants for the Shallue-van de Woestijne (SVDW) map to Weierstrass curve.\n    21\tpub trait MapToWeierstrassParams<BaseField: CircuitField> {\n    22\t    /// Z constant of the SVDW method.\n    23\t    const SVDW_Z: BaseField;\n    24\t\n    25\t    /// Parameter `a` in the curve equation `y^2 = x^3 + a*x + b`.\n    26\t    const A: BaseField;\n    27\t\n    28\t    /// Parameter `b` in the curve equation `y^2 = x^3 + a*x + b`.\n    29\t    const B: BaseField;\n    30\t\n    31\t    /// Right-hand side evaluation of the curve equation.\n    32\t    fn g(x: BaseField) -> BaseField {\n    33\t        x * x * x + Self::A * x + Self::B\n    34\t    }\n    35\t\n    36\t    /// g(Z).\n    37\t    fn c1() -> BaseField {\n    38\t        Self::g(Self::SVDW_Z)\n    39\t    }\n    40\t\n    41\t    /// -Z / 2.\n    42\t    fn c2() -> BaseField {\n    43\t        -Self::SVDW_Z * BaseField::TWO_INV\n    44\t    }\n    45\t\n    46\t    /// sqrt(-g(Z) * (3 * Z^2 + 4 * A)) with zero sgn0.\n    47\t    fn c3() -> BaseField {\n    48\t        let den =\n    49\t            BaseField::from(3u64) * Self::SVDW_Z * Self::SVDW_Z + BaseField::from(4u64) * Self::A;\n    50\t        let a = -Self::c1() * den;\n    51\t        let sqrt = a\n    52\t            .sqrt()\n    53\t            .expect(\"This value should be a quadratic residue. Check SVDW_Z parameter.\");\n    54\t        if bool::from(sqrt.is_even()) {\n    55\t            sqrt\n    56\t        } else {\n    57\t            -sqrt\n    58\t        }\n    59\t    }\n    60\t\n    61\t    /// -4 * g(Z) / (3 * Z^2 + 4 * A).\n    62\t    fn c4() -> BaseField {\n    63\t        let four = BaseField::from(4u64);\n    64\t        let det = BaseField::from(3u64) * Self::SVDW_Z * Self::SVDW_Z + four * Self::A;\n    65\t        -four * Self::c1() * (det.invert().unwrap())\n    66\t    }\n    67\t}\n    68\t\n    69\t/// Constants for the Shallue-van de Woestijne (SVDW) map to twisted Edwards\n    70\t/// curve, through Montgomery form.\n    71\tpub trait MapToEdwardsParams<BaseField: CircuitField>: MapToWeierstrassParams<BaseField> {\n    72\t    /// `J` constant of Montgomery curve: `K * y^2 = x^3 + J * x^2 + x`.\n    73\t    const MONT_J: BaseField;\n    74\t\n    75\t    /// `K` constant of Montgomery curve: `K * y^2 = x^3 + J * x^2 + x`.\n    76\t    const MONT_K: BaseField;\n    77\t}\n    78\t\n    79\t// The script about deriving these constants can be found:\n    80\t// `scripts/hash_to_jubjub_params.sage`\n    81\timpl MapToWeierstrassParams<JubjubBase> for Jubjub {\n    82\t    const SVDW_Z: JubjubBase = JubjubBase::from_raw([\n    83\t        0xfffffffeffffffff,\n    84\t        0x53bda402fffe5bfe,\n    85\t        0x3339d80809a1d805,\n    86\t        0x73eda753299d7d48,\n    87\t    ]);\n    88\t\n    89\t    const A: JubjubBase = JubjubBase::from_raw([\n    90\t        0xc50d34dcd4c20942,\n    91\t        0x20535e745e639334,\n    92\t        0x976220a0378a2328,\n    93\t        0x739e8acf6e7266e8,\n    94\t    ]);\n    95\t\n    96\t    const B: JubjubBase = JubjubBase::from_raw([\n    97\t        0x7120c33b4c6628e1,\n    98\t        0xbbf51483ff8366ac,\n    99\t        0xf4c60001b55614b0,\n   100\t        0x6ae5ca3c3f667667,\n   101\t    ]);\n   102\t}\n   103\t\n   104\timpl MapToEdwardsParams<JubjubBase> for Jubjub {\n   105\t    const MONT_J: JubjubBase = JubjubBase::from_raw([\n   106\t        0x000000000000a002,\n   107\t        0x0000000000000000,\n   108\t        0x0000000000000000,\n   109\t        0x0000000000000000,\n   110\t    ]);\n   111\t\n   112\t    const MONT_K: JubjubBase = JubjubBase::from_raw([\n   113\t        0xfffffffeffff5ffd,\n   114\t        0x53bda402fffe5bfe,\n   115\t        0x3339d80809a1d805,\n   116\t        0x73eda753299d7d48,\n   117\t    ]);\n   118\t}\n   119\t\n   120\t#[cfg(test)]\n   121\tmod test {\n   122\t    use ff::{Field, PrimeField};\n   123\t\n   124\t    use super::*;\n   125\t    use crate::ecc::curves::CircuitCurve;\n   126\t\n   127\t    fn test_params<C>()\n   128\t    where\n   129\t        C: CircuitCurve + MapToWeierstrassParams<C::Base>,\n   130\t    {\n   131\t        // g(Z) != 0.\n   132\t        assert_ne!(C::c1(), C::Base::ZERO);\n   133\t\n   134\t        // -(3 * Z^2 + 4 * A) / (4 * g(Z)) != 0.\n   135\t        assert_ne!(C::c4(), C::Base::ZERO);\n   136\t\n   137\t        // -(3 * Z^2 + 4 * A) / (4 * g(Z)) is square.\n   138\t        assert!(bool::from(C::c4().sqrt().is_some()));\n   139\t\n   140\t        // At least one of g(Z) and g(-Z / 2) is square.\n   141\t        assert!(bool::from(C::c1().sqrt().is_some()) | bool::from(C::g(C::c2()).sqrt().is_some()));\n   142\t\n   143\t        // C3 is the \"positive\" solution of the square root.\n   144\t        assert!(bool::from(C::c3().is_even()));\n   145\t    }\n   146\t\n   147\t    #[test]\n   148\t    fn test_jubjub_params() {\n   149\t        test_params::<Jubjub>()\n   150\t    }\n   151\t}\n     1\t// This file is part of MIDNIGHT-ZK.\n     2\t// Copyright (C) Midnight Foundation\n     3\t// SPDX-License-Identifier: Apache-2.0\n     4\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t// You may not use this file except in compliance with the License.\n     6\t// You may obtain a copy of the License at\n     7\t// http://www.apache.org/licenses/LICENSE-2.0\n     8\t// Unless required by applicable law or agreed to in writing, software\n     9\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    10\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\t//! Map to curve off-circuit implementations.\n    15\t\n    16\tuse ff::{Field, PrimeField};\n    17\tuse group::cofactor::CofactorGroup;\n    18\tuse midnight_curves::{ff_ext::Legendre, JubjubExtended as Jubjub, JubjubSubgroup};\n    19\tuse subtle::{ConditionallySelectable, ConstantTimeEq};\n    20\t\n    21\t// use crate::instructions::ecc::EdwardsCurve;\n    22\tuse super::mtc_params::{MapToEdwardsParams, MapToWeierstrassParams};\n    23\tuse crate::ecc::curves::CircuitCurve;\n    24\t\n    25\t/// The set of off-circuit instructions for map-to-curve.\n    26\tpub trait MapToCurveCPU<C: CircuitCurve> {\n    27\t    /// Map an element of the base field (a coordinate) to a pair of coordinates\n    28\t    /// that satisfy the underlying curve equation.\n    29\t    fn map_to_curve(u: &C::Base) -> C::CryptographicGroup;\n    30\t}\n    31\t\n    32\timpl MapToCurveCPU<Jubjub> for Jubjub {\n    33\t    fn map_to_curve(u: &<Jubjub as CircuitCurve>::Base) -> JubjubSubgroup {\n    34\t        let (x, y) = svdw_map_to_curve::<Jubjub>(u);\n    35\t        let (x, y) = weierstrass_to_montgomery::<Jubjub>(&x, &y);\n    36\t        let (x, y) = montgomery_to_edwards::<Jubjub>(&x, &y);\n    37\t        let extended_point = Jubjub::from_xy(x, y).unwrap();\n    38\t        <Jubjub as CofactorGroup>::clear_cofactor(&extended_point)\n    39\t    }\n    40\t}\n    41\t\n    42\t/// Map to Curve function.\n    43\t/// Adapted from halo2curves:\n    44\t/// <https://github.com/privacy-scaling-explorations/halo2curves/blob/9fff22c5f72cc54fac1ef3a844e1072b08cfecdf/src/hash_to_curve.rs#L197>\n    45\tfn svdw_map_to_curve<C>(u: &C::Base) -> (C::Base, C::Base)\n    46\twhere\n    47\t    C: CircuitCurve + MapToWeierstrassParams<C::Base>,\n    48\t    C::Base: Legendre,\n    49\t{\n    50\t    // 1. tv1 = u^2\n    51\t    let tv1 = u.square();\n    52\t    // 2. tv1 = tv1 * c1\n    53\t    let tv1 = tv1 * C::c1();\n    54\t    // 3. tv2 = 1 + tv1\n    55\t    let tv2 = C::Base::ONE + tv1;\n    56\t    // 4. tv1 = 1 - tv1\n    57\t    let tv1 = C::Base::ONE - tv1;\n    58\t    // 5. tv3 = tv1 * tv2\n    59\t    let tv3 = tv1 * tv2;\n    60\t    // 6. tv3 = inv0(tv3)\n    61\t    let tv3 = tv3.invert().unwrap_or(C::Base::ZERO);\n    62\t    // 7. tv4 = u * tv1\n    63\t    let tv4 = *u * tv1;\n    64\t    // 8. tv4 = tv4 * tv3\n    65\t    let tv4 = tv4 * tv3;\n    66\t    // 9. tv4 = tv4 * c3\n    67\t    let tv4 = tv4 * C::c3();\n    68\t    // 10. x1 = c2 - tv4\n    69\t    let x1 = C::c2() - tv4;\n    70\t    // 11. gx1 = x1^2\n    71\t    let gx1 = x1.square();\n    72\t    // 12. gx1 = gx1 + A\n    73\t    let gx1 = gx1 + C::A;\n    74\t    // 13. gx1 = gx1 * x1\n    75\t    let gx1 = gx1 * x1;\n    76\t    // 14. gx1 = gx1 + B\n    77\t    let gx1 = gx1 + C::B;\n    78\t    // 15. e1 = is_square(gx1)\n    79\t    let e1 = !gx1.ct_quadratic_non_residue();\n    80\t    // 16. x2 = c2 + tv4\n    81\t    let x2 = C::c2() + tv4;\n    82\t    // 17. gx2 = x2^2\n    83\t    let gx2 = x2.square();\n    84\t    // 18. gx2 = gx2 + A\n    85\t    let gx2 = gx2 + C::A;\n    86\t    // 19. gx2 = gx2 * x2\n    87\t    let gx2 = gx2 * x2;\n    88\t    // 20. gx2 = gx2 + B\n    89\t    let gx2 = gx2 + C::B;\n    90\t    // 21. e2 = is_square(gx2) AND NOT e1    # Avoid short-circuit logic ops\n    91\t    let e2 = !gx2.ct_quadratic_non_residue() & (!e1);\n    92\t    // 22. x3 = tv2^2\n    93\t    let x3 = tv2.square();\n    94\t    // 23. x3 = x3 * tv3\n    95\t    let x3 = x3 * tv3;\n    96\t    // 24. x3 = x3^2\n    97\t    let x3 = x3.square();\n    98\t    // 25. x3 = x3 * c4\n    99\t    let x3 = x3 * C::c4();\n   100\t    // 26. x3 = x3 + Z\n   101\t    let x3 = x3 + C::SVDW_Z;\n   102\t    // 27. x = CMOV(x3, x1, e1)    # x = x1 if gx1 is square, else x = x3\n   103\t    let x = C::Base::conditional_select(&x3, &x1, e1);\n   104\t    // 28. x = CMOV(x, x2, e2)    # x = x2 if gx2 is square and gx1 is not\n   105\t    let x = C::Base::conditional_select(&x, &x2, e2);\n   106\t    // 29. gx = x^2\n   107\t    let gx = x.square();\n   108\t    // 30. gx = gx + A\n   109\t    let gx = gx + C::A;\n   110\t    // 31. gx = gx * x\n   111\t    let gx = gx * x;\n   112\t    // 32. gx = gx + B\n   113\t    let gx = gx + C::B;\n   114\t    // 33. y = sqrt(gx)\n   115\t    let y = gx.sqrt().unwrap();\n   116\t    // 34. e3 = sgn0(u) == sgn0(y)\n   117\t    let e3 = u.is_odd().ct_eq(&y.is_odd());\n   118\t    // 35. y = CMOV(-y, y, e3)    # Select correct sign of y\n   119\t    let y = C::Base::conditional_select(&-y, &y, e3);\n   120\t    // 36. return (x, y)\n   121\t    (x, y)\n   122\t}\n   123\t\n   124\t/// Maps a pair of Weierstrass coordinates into Montgomery form.\n   125\tfn weierstrass_to_montgomery<C>(x: &C::Base, y: &C::Base) -> (C::Base, C::Base)\n   126\twhere\n   127\t    C: CircuitCurve + MapToEdwardsParams<C::Base>,\n   128\t{\n   129\t    let x_prime = *x * C::MONT_K;\n   130\t    let x_prime = x_prime - C::MONT_J * C::Base::from(3).invert().unwrap();\n   131\t    let y_prime = *y * C::MONT_K;\n   132\t\n   133\t    (x_prime, y_prime)\n   134\t}\n   135\t\n   136\t/// Maps a pair of coordinates in Montgomery form into Edwards coordinates.\n   137\tfn montgomery_to_edwards<C>(x: &C::Base, y: &C::Base) -> (C::Base, C::Base)\n   138\twhere\n   139\t    C: CircuitCurve + MapToEdwardsParams<C::Base>,\n   140\t{\n   141\t    // 1. tv1 = s + 1\n   142\t    let mut tv1 = *x + C::Base::ONE;\n   143\t    // 2. tv2 = tv1 * t\n   144\t    let mut tv2 = tv1 * *y;\n   145\t    // 3. tv2 = inv0(tv2)\n   146\t    tv2 = tv2.invert().unwrap_or(C::Base::ZERO);\n   147\t    // 4. v = tv2 * tv1\n   148\t    let mut x_prime = tv2 * tv1;\n   149\t    // 5. v = v * s\n   150\t    x_prime *= *x;\n   151\t    // 6. w = tv2 * t\n   152\t    let mut y_prime = tv2 * *y;\n   153\t    // 7. tv1 = s - 1\n   154\t    tv1 = *x - C::Base::ONE;\n   155\t    // 8. w = w * tv1\n   156\t    y_prime *= tv1;\n   157\t    // 9. e = t2 == 0\n   158\t    let e = tv2 == C::Base::ZERO;\n   159\t    // 10. w = CMOV(w, 1, e)\n   160\t    y_prime = C::Base::conditional_select(&y_prime, &C::Base::ONE, (e as u8).into());\n   161\t    // 11. return (v, w)\n   162\t    (x_prime, y_prime)\n   163\t}\n","exit_code":0,"status":"completed"}}
