{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-hash.k'","aggregated_output":"     1\t// Hash primitives used by ZKIR v3, computed concretely.\n     2\t//\n     3\t//   poseidonHash(List)      transient_hash: Poseidon sponge over the BLS12-381\n     4\t//                           scalar field, t = 3, rate 2, R_F = 8, R_P = 60, with\n     5\t//                           the fixed-length domain (capacity element = input\n     6\t//                           length). midnight-circuits 7.2.4 hash/poseidon/*.\n     7\t//   hashToCurve(List)       transient_crypto::hash::hash_to_curve: variable-length\n     8\t//                           Poseidon sponge (capacity 2^64, length padding),\n     9\t//                           two squeezes, Shallue-van de Woestijne map to the\n    10\t//                           Weierstrass form of Jubjub, conversion to Edwards,\n    11\t//                           cofactor clearing, sum of the two points.\n    12\t//   sha256(Bytes)           FIPS 180-4.\n    13\t//   keccak256(Bytes)        Keccak-f[1600], rate 1088, pad 0x01 .. 0x80 (pre-NIST).\n    14\t//\n    15\t// The Rust Poseidon CPU code folds partial rounds in pairs (\"round skips\"); that\n    16\t// is an algebraic rewrite of the plain round function implemented here, and the\n    17\t// differential tests against the crate confirm the outputs agree.\n    18\trequires \"zkir-field.k\"\n    19\trequires \"zkir-curves.k\"\n    20\trequires \"zkir-constants.k\"\n    21\t\n    22\tmodule ZKIR-HASH\n    23\t  imports ZKIR-FIELD\n    24\t  imports ZKIR-CURVES\n    25\t  imports ZKIR-CONSTANTS\n    26\t  imports BYTES\n    27\t  imports LIST\n    28\t\n    29\t  // ---------------------------------------------------------------------------\n    30\t  // Poseidon permutation on a 3-element state (s0, s1, s2), all mod r.\n    31\t  syntax PState ::= ps(Int, Int, Int)\n    32\t\n    33\t  syntax Int ::= sbox(Int) [function, total]\n    34\t  rule sbox(X) => fmul(fsq(fsq(X, #r), #r), X, #r)\n    35\t\n    36\t  // new[i] = rc[i] + sum_j MDS[i][j] * s[j]\n    37\t  syntax PState ::= linear(PState, Int) [function, total]   // (state, round index for RC[round+1]; -1 = zero constants)\n    38\t  rule linear(ps(S0, S1, S2), R) => ps(\n    39\t      fadd(#rc(R, 0), fadd(fadd(fmul(poseidonMDS(0, 0), S0, #r), fmul(poseidonMDS(0, 1), S1, #r), #r), fmul(poseidonMDS(0, 2), S2, #r), #r), #r),\n    40\t      fadd(#rc(R, 1), fadd(fadd(fmul(poseidonMDS(1, 0), S0, #r), fmul(poseidonMDS(1, 1), S1, #r), #r), fmul(poseidonMDS(1, 2), S2, #r), #r), #r),\n    41\t      fadd(#rc(R, 2), fadd(fadd(fmul(poseidonMDS(2, 0), S0, #r), fmul(poseidonMDS(2, 1), S1, #r), #r), fmul(poseidonMDS(2, 2), S2, #r), #r), #r))\n    42\t  syntax Int ::= #rc(Int, Int) [function, total]\n    43\t  rule #rc(R, J) => poseidonRC(R +Int 1, J) requires R >=Int 0 andBool R <Int 67\n    44\t  rule #rc(_, _) => 0 [owise]\n    45\t\n    46\t  syntax PState ::= fullRound(PState, Int) [function, total]\n    47\t  rule fullRound(ps(S0, S1, S2), R) => linear(ps(sbox(S0), sbox(S1), sbox(S2)), R)\n    48\t  syntax PState ::= partialRound(PState, Int) [function, total]\n    49\t  rule partialRound(ps(S0, S1, S2), R) => linear(ps(S0, S1, sbox(S2)), R)\n    50\t\n    51\t  syntax PState ::= permute(PState) [function, total]\n    52\t  rule permute(ps(S0, S1, S2)) => #rounds(ps(fadd(S0, poseidonRC(0, 0), #r), fadd(S1, poseidonRC(0, 1), #r), fadd(S2, poseidonRC(0, 2), #r)), 0)\n    53\t  syntax PState ::= #rounds(PState, Int) [function, total]\n    54\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R <Int 4\n    55\t  rule #rounds(S, R) => #rounds(partialRound(S, R), R +Int 1) requires R >=Int 4 andBool R <Int 64\n    56\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R >=Int 64 andBool R <Int 68\n    57\t  rule #rounds(S, R) => S requires R >=Int 68\n    58\t\n    59\t  // Absorb a queue of elements in chunks of two, permuting after each chunk.\n    60\t  syntax PState ::= absorbAll(PState, List) [function, total]\n    61\t  rule absorbAll(S, .List) => S\n    62\t  rule absorbAll(ps(S0, S1, S2), ListItem(A) ListItem(B) Rest) => absorbAll(permute(ps(fadd(S0, A, #r), fadd(S1, B, #r), S2)), Rest)\n    63\t  rule absorbAll(ps(S0, S1, S2), ListItem(A)) => permute(ps(fadd(S0, A, #r), S1, S2))\n    64\t\n    65\t  // Fixed-length Poseidon hash (transient_hash).\n    66\t  syntax Int ::= poseidonHash(List) [function, total]\n    67\t  rule poseidonHash(Xs) => #ps0(absorbAll(ps(0, 0, size(Xs) modInt #r), Xs))\n    68\t  syntax Int ::= #ps0(PState) [function, total]\n    69\t  rule #ps0(ps(S0, _, _)) => S0\n    70\t  syntax Int ::= #ps1(PState) [function, total]\n    71\t  rule #ps1(ps(_, S1, _)) => S1\n    72\t\n    73\t  // transient_commit(values, opening) = poseidonHash([opening] ++ values)\n    74\t  syntax Int ::= transientCommit(List, Int) [function, total]\n    75\t  rule transientCommit(Vs, Rand) => poseidonHash(ListItem(Rand) Vs)\n    76\t\n    77\t  // Variable-length sponge used by hash_to_curve: capacity 2^64, the input\n    78\t  // length appended as padding, then two squeezes (register 0 and 1).\n    79\t  syntax PState ::= varLenSponge(List) [function, total]\n    80\t  rule varLenSponge(Xs) => absorbAll(ps(0, 0, 18446744073709551616), Xs ListItem(size(Xs)))\n    81\t\n    82\t  // ---------------------------------------------------------------------------\n    83\t  // Hash to curve (Jubjub subgroup).\n    84\t  syntax Point ::= hashToCurve(List) [function, total]\n    85\t  rule hashToCurve(Xs) => #htc(varLenSponge(Xs))\n    86\t  syntax Point ::= #htc(PState) [function, total]\n    87\t  rule #htc(ps(X1, X2, _)) => ecAdd(#jubjub, mapToCurve(X1), mapToCurve(X2))\n    88\t\n    89\t  // SVDW constants (mtc_params.rs), all mod r\n    90\t  syntax Int ::= \"#svdwC1\" [function, total]   // g(Z)\n    91\t  rule #svdwC1 => #g(#svdwZ)\n    92\t  syntax Int ::= #g(Int) [function, total]\n    93\t  rule #g(X) => fadd(fadd(fmul(fmul(X, X, #r), X, #r), fmul(#svdwA, X, #r), #r), #svdwB, #r)\n    94\t  syntax Int ::= \"#svdwC2\" [function, total]   // -Z / 2\n    95\t  rule #svdwC2 => fneg(fmul(#svdwZ, finv(2, #r), #r), #r)\n    96\t  syntax Int ::= \"#svdwC3\" [function, total]   // sqrt(-g(Z) * (3 Z^2 + 4 A)), even root\n    97\t  rule #svdwC3 => #evenRoot(fsqrt(fneg(fmul(#svdwC1, fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r))\n    98\t  syntax Int ::= #evenRoot(SqrtResult) [function, total]\n    99\t  rule #evenRoot(sqrtOk(S)) => S requires S modInt 2 ==Int 0\n   100\t  rule #evenRoot(sqrtOk(S)) => fneg(S, #r) requires S modInt 2 ==Int 1\n   101\t  rule #evenRoot(noSqrt()) => 0\n   102\t  syntax Int ::= \"#svdwC4\" [function, total]   // -4 g(Z) / (3 Z^2 + 4 A)\n   103\t  rule #svdwC4 => fneg(fmul(fmul(4, #svdwC1, #r), finv(fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r)\n   104\t\n   105\t  syntax Point ::= mapToCurve(Int) [function, total]\n   106\t  rule mapToCurve(U) => ecMul(#jubjub, #edFromMont(#wToMont(#svdw(U))), 8)\n   107\t\n   108\t  // svdw_map_to_curve: returns pt(x, y) on the Weierstrass form\n   109\t  syntax Point ::= #svdw(Int) [function, total]\n   110\t  rule #svdw(U) => #svdw1(U, fmul(fsq(U, #r), #svdwC1, #r))\n   111\t  syntax Point ::= #svdw1(Int, Int) [function, total]   // (u, tv1 = u^2 c1)\n   112\t  rule #svdw1(U, T) => #svdw2(U, fadd(1, T, #r), fsub(1, T, #r))\n   113\t  syntax Point ::= #svdw2(Int, Int, Int) [function, total]   // (u, tv2 = 1 + t, tv1 = 1 - t)\n   114\t  rule #svdw2(U, TV2, TV1) => #svdw3(U, TV2, TV1, finv(fmul(TV1, TV2, #r), #r))\n   115\t  syntax Point ::= #svdw3(Int, Int, Int, Int) [function, total]   // (u, tv2, tv1, tv3 = inv(tv1 tv2))\n   116\t  rule #svdw3(U, TV2, TV1, TV3) => #svdw4(U, TV2, TV3, fmul(fmul(fmul(U, TV1, #r), TV3, #r), #svdwC3, #r))\n   117\t  syntax Point ::= #svdw4(Int, Int, Int, Int) [function, total]   // (u, tv2, tv3, tv4)\n   118\t  rule #svdw4(U, TV2, TV3, TV4) => #svdwPick(U,\n   119\t      fsub(#svdwC2, TV4, #r), fadd(#svdwC2, TV4, #r),\n   120\t      fadd(fmul(fsq(fmul(fsq(TV2, #r), TV3, #r), #r), #svdwC4, #r), #svdwZ, #r))\n   121\t  // e1 = g(x1) residue; e2 = g(x2) residue and not e1; x = e1 ? x1 : e2 ? x2 : x3\n   122\t  syntax Point ::= #svdwPick(Int, Int, Int, Int) [function, total]\n   123\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X1) requires notBool isQuadraticNonResidue(#g(X1), #r)\n   124\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X2) requires isQuadraticNonResidue(#g(X1), #r) andBool notBool isQuadraticNonResidue(#g(X2), #r)\n   125\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X3) requires isQuadraticNonResidue(#g(X1), #r) andBool isQuadraticNonResidue(#g(X2), #r)\n   126\t  syntax Point ::= #svdwY(Int, Int) [function, total]\n   127\t  rule #svdwY(U, X) => #svdwSign(U, X, fsqrt(#g(X), #r))\n   128\t  syntax Point ::= #svdwSign(Int, Int, SqrtResult) [function, total]\n   129\t  rule #svdwSign(U, X, sqrtOk(Y)) => pt(X, Y) requires (U modInt 2) ==Int (Y modInt 2)\n   130\t  rule #svdwSign(U, X, sqrtOk(Y)) => pt(X, fneg(Y, #r)) requires (U modInt 2) =/=Int (Y modInt 2)\n   131\t  rule #svdwSign(_, X, noSqrt()) => pt(X, 0)   // unreachable: g(x) is a residue by construction\n   132\t\n   133\t  // weierstrass_to_montgomery: x' = x K - J/3, y' = y K\n   134\t  syntax Point ::= #wToMont(Point) [function, total]\n   135\t  rule #wToMont(pt(X, Y)) => pt(fsub(fmul(X, #montK, #r), fmul(#montJ, finv(3, #r), #r), #r), fmul(Y, #montK, #r))\n   136\t  rule #wToMont(inf()) => inf()\n   137\t  // montgomery_to_edwards: tv1 = x + 1; tv2 = inv(tv1 y); x' = tv2 tv1 x; y' = tv2 y (x - 1); y' = 1 if tv2 = 0\n   138\t  syntax Point ::= #edFromMont(Point) [function, total]\n   139\t  rule #edFromMont(pt(X, Y)) => #edFromMont2(X, Y, fadd(X, 1, #r), finv(fmul(fadd(X, 1, #r), Y, #r), #r))\n   140\t  rule #edFromMont(inf()) => pt(0, 1)\n   141\t  syntax Point ::= #edFromMont2(Int, Int, Int, Int) [function, total]\n   142\t  rule #edFromMont2(X, Y, TV1, TV2) => pt(fmul(fmul(TV2, TV1, #r), X, #r), fmul(fmul(TV2, Y, #r), fsub(X, 1, #r), #r)) requires TV2 =/=Int 0\n   143\t  rule #edFromMont2(X, Y, TV1, TV2) => pt(fmul(fmul(TV2, TV1, #r), X, #r), 1) requires TV2 ==Int 0\n   144\t\n   145\t  // ---------------------------------------------------------------------------\n   146\t  // SHA-256\n   147\t  syntax Int ::= \"#m32\" [function, total]\n   148\t  rule #m32 => 4294967295\n   149\t  syntax Int ::= rotr32(Int, Int) [function, total]\n   150\t  rule rotr32(X, N) => ((X >>Int N) |Int (X <<Int (32 -Int N))) &Int #m32\n   151\t  syntax Int ::= add32(Int, Int) [function, total]\n   152\t  rule add32(A, B) => (A +Int B) &Int #m32\n   153\t\n   154\t  syntax List ::= \"#shaKs\" [function, total]\n   155\t  rule #shaKs => ListItem(1116352408) ListItem(1899447441) ListItem(3049323471) ListItem(3921009573) ListItem(961987163) ListItem(1508970993) ListItem(2453635748) ListItem(2870763221) ListItem(3624381080) ListItem(310598401) ListItem(607225278) ListItem(1426881987) ListItem(1925078388) ListItem(2162078206) ListItem(2614888103) ListItem(3248222580) ListItem(3835390401) ListItem(4022224774) ListItem(264347078) ListItem(604807628) ListItem(770255983) ListItem(1249150122) ListItem(1555081692) ListItem(1996064986) ListItem(2554220882) ListItem(2821834349) ListItem(2952996808) ListItem(3210313671) ListItem(3336571891) ListItem(3584528711) ListItem(113926993) ListItem(338241895) ListItem(666307205) ListItem(773529912) ListItem(1294757372) ListItem(1396182291) ListItem(1695183700) ListItem(1986661051) ListItem(2177026350) ListItem(2456956037) ListItem(2730485921) ListItem(2820302411) ListItem(3259730800) ListItem(3345764771) ListItem(3516065817) ListItem(3600352804) ListItem(4094571909) ListItem(275423344) ListItem(430227734) ListItem(506948616) ListItem(659060556) ListItem(883997877) ListItem(958139571) ListItem(1322822218) ListItem(1537002063) ListItem(1747873779) ListItem(1955562222) ListItem(2024104815) ListItem(2227730452) ListItem(2361852424) ListItem(2428436474) ListItem(2756734187) ListItem(3204031479) ListItem(3329325298)\n   156\t  syntax Int ::= shaK(Int) [function, total]\n   157\t  rule shaK(I) => {#shaKs[I]}:>Int\n   158\t\n   159\t  syntax Bytes ::= sha256Bytes(Bytes) [function, total]\n   160\t  rule sha256Bytes(M) => #shaBlocks(#shaPad(M), 0,\n   161\t      ListItem(1779033703) ListItem(3144134277) ListItem(1013904242) ListItem(2773480762)\n   162\t      ListItem(1359893119) ListItem(2600822924) ListItem(528734635) ListItem(1541459225))\n   163\t  syntax Bytes ::= #shaPad(Bytes) [function, total]\n   164\t  rule #shaPad(M) => padRightBytes(M +Bytes Int2Bytes(1, 128, BE), ((lengthBytes(M) +Int 9 +Int 63) /Int 64) *Int 64 -Int 8, 0) +Bytes Int2Bytes(8, lengthBytes(M) *Int 8, BE)\n   165\t  syntax Bytes ::= #shaBlocks(Bytes, Int, List) [function, total]   // (padded, offset, H)\n   166\t  rule #shaBlocks(P, Off, H) => #shaOut(H) requires Off >=Int lengthBytes(P)\n   167\t  rule #shaBlocks(P, Off, H) => #shaBlocks(P, Off +Int 64, #shaCompress(#shaSchedule(substrBytes(P, Off, Off +Int 64), 0, .List), H))\n   168\t    requires Off <Int lengthBytes(P)\n   169\t  syntax Bytes ::= #shaOut(List) [function, total]\n   170\t  rule #shaOut(.List) => .Bytes\n   171\t  rule #shaOut(ListItem(W) Ws) => Int2Bytes(4, W, BE) +Bytes #shaOut(Ws)\n   172\t\n   173\t  // message schedule W[0..63]\n   174\t  syntax List ::= #shaSchedule(Bytes, Int, List) [function, total]\n   175\t  rule #shaSchedule(B, T, W) => #shaSchedule(B, T +Int 1, W ListItem(Bytes2Int(substrBytes(B, 4 *Int T, 4 *Int T +Int 4), BE, Unsigned)))\n   176\t    requires T <Int 16\n   177\t  rule #shaSchedule(B, T, W) => #shaSchedule(B, T +Int 1, W ListItem(add32(add32(#s1({W[T -Int 2]}:>Int), {W[T -Int 7]}:>Int), add32(#s0({W[T -Int 15]}:>Int), {W[T -Int 16]}:>Int))))\n   178\t    requires T >=Int 16 andBool T <Int 64\n   179\t  rule #shaSchedule(_, T, W) => W requires T >=Int 64\n   180\t  syntax Int ::= #s0(Int) [function, total]\n   181\t  rule #s0(X) => rotr32(X, 7) xorInt rotr32(X, 18) xorInt (X >>Int 3)\n   182\t  syntax Int ::= #s1(Int) [function, total]\n   183\t  rule #s1(X) => rotr32(X, 17) xorInt rotr32(X, 19) xorInt (X >>Int 10)\n   184\t  syntax Int ::= #S0(Int) [function, total]\n   185\t  rule #S0(X) => rotr32(X, 2) xorInt rotr32(X, 13) xorInt rotr32(X, 22)\n   186\t  syntax Int ::= #S1(Int) [function, total]\n   187\t  rule #S1(X) => rotr32(X, 6) xorInt rotr32(X, 11) xorInt rotr32(X, 25)\n   188\t\n   189\t  syntax List ::= #shaCompress(List, List) [function, total]   // (W, H) -> H'\n   190\t  rule #shaCompress(W, H) => #shaAddH(#shaRound(W, 0, H), H)\n   191\t  // working variables carried as a List [a,b,c,d,e,f,g,h]\n   192\t  syntax List ::= #shaRound(List, Int, List) [function, total]\n   193\t  rule #shaRound(_, T, V) => V requires T >=Int 64\n   194\t  rule #shaRound(W, T, ListItem(A) ListItem(B) ListItem(C) ListItem(D) ListItem(E) ListItem(F) ListItem(G) ListItem(HH))\n   195\t    => #shaRound(W, T +Int 1, #shaNext(A, B, C, D, E, F, G,\n   196\t         add32(add32(add32(add32(HH, #S1(E)), (E &Int F) xorInt ((E xorInt #m32) &Int G)), shaK(T)), {W[T]}:>Int),\n   197\t         add32(#S0(A), (A &Int B) xorInt (A &Int C) xorInt (B &Int C))))\n   198\t    requires T <Int 64\n   199\t  syntax List ::= #shaNext(Int, Int, Int, Int, Int, Int, Int, Int, Int) [function, total]   // (a..g, T1, T2)\n   200\t  rule #shaNext(A, B, C, D, E, F, G, T1, T2)\n   201\t    => ListItem(add32(T1, T2)) ListItem(A) ListItem(B) ListItem(C) ListItem(add32(D, T1)) ListItem(E) ListItem(F) ListItem(G)\n   202\t  syntax List ::= #shaAddH(List, List) [function, total]\n   203\t  rule #shaAddH(.List, .List) => .List\n   204\t  rule #shaAddH(ListItem(X) Xs, ListItem(Y) Ys) => ListItem(add32(X, Y)) #shaAddH(Xs, Ys)\n   205\t  rule #shaAddH(_, _) => .List [owise]\n   206\t\n   207\t  // ---------------------------------------------------------------------------\n   208\t  // Keccak-256. State: List of 25 lanes, index x + 5*y, 64-bit little-endian lanes.\n   209\t  syntax Int ::= \"#m64\" [function, total]\n   210\t  rule #m64 => 18446744073709551615\n   211\t  syntax Int ::= rotl64(Int, Int) [function, total]\n   212\t  rule rotl64(X, 0) => X\n   213\t  rule rotl64(X, N) => ((X <<Int N) |Int (X >>Int (64 -Int N))) &Int #m64 requires N >Int 0\n   214\t\n   215\t  syntax List ::= \"#keccakRCs\" [function, total]\n   216\t  rule #keccakRCs => ListItem(1) ListItem(32898) ListItem(9223372036854808714) ListItem(9223372039002292224) ListItem(32907) ListItem(2147483649) ListItem(9223372039002292353) ListItem(9223372036854808585) ListItem(138) ListItem(136) ListItem(2147516425) ListItem(2147483658) ListItem(2147516555) ListItem(9223372036854775947) ListItem(9223372036854808713) ListItem(9223372036854808579) ListItem(9223372036854808578) ListItem(9223372036854775936) ListItem(32778) ListItem(9223372039002259466) ListItem(9223372039002292353) ListItem(9223372036854808704) ListItem(2147483649) ListItem(9223372039002292232)\n   217\t  syntax Int ::= keccakRC(Int) [function, total]\n   218\t  rule keccakRC(I) => {#keccakRCs[I]}:>Int\n   219\t  syntax List ::= \"#keccakRots\" [function, total]\n   220\t  rule #keccakRots => ListItem(0) ListItem(1) ListItem(62) ListItem(28) ListItem(27) ListItem(36) ListItem(44) ListItem(6) ListItem(55) ListItem(20) ListItem(3) ListItem(10) ListItem(43) ListItem(25) ListItem(39) ListItem(41) ListItem(45) ListItem(15) ListItem(21) ListItem(8) ListItem(18) ListItem(2) ListItem(61) ListItem(56) ListItem(14)\n   221\t  syntax Int ::= keccakRot(Int) [function, total]   // rotation offset for lane index x + 5y\n   222\t  rule keccakRot(I) => {#keccakRots[I]}:>Int\n   223\t\n   224\t  syntax Int ::= lane(List, Int, Int) [function, total]   // (state, x, y)\n   225\t  rule lane(S, X, Y) => {S[(X modInt 5) +Int 5 *Int (Y modInt 5)]}:>Int\n   226\t\n   227\t  syntax Bytes ::= keccak256Bytes(Bytes) [function, total]\n   228\t  rule keccak256Bytes(M) => substrBytes(#kOut(#kAbsorb(#kPad(M), 0, #kZero(25)), 0, .Bytes), 0, 32)\n   229\t  syntax Bytes ::= #kPad(Bytes) [function, total]\n   230\t  rule #kPad(M) => #kPadEnd(padRightBytes(M +Bytes Int2Bytes(1, 1, BE), ((lengthBytes(M) +Int 1 +Int 135) /Int 136) *Int 136, 0))\n   231\t  syntax Bytes ::= #kPadEnd(Bytes) [function, total]\n   232\t  rule #kPadEnd(P) => replaceAtBytes(P, lengthBytes(P) -Int 1, Int2Bytes(1, P[lengthBytes(P) -Int 1] |Int 128, BE))\n   233\t  syntax List ::= #kZero(Int) [function, total]\n   234\t  rule #kZero(0) => .List\n   235\t  rule #kZero(N) => ListItem(0) #kZero(N -Int 1) requires N >Int 0\n   236\t  rule #kZero(N) => .List requires N <Int 0\n   237\t\n   238\t  syntax List ::= #kAbsorb(Bytes, Int, List) [function, total]\n   239\t  rule #kAbsorb(P, Off, S) => S requires Off >=Int lengthBytes(P)\n   240\t  rule #kAbsorb(P, Off, S) => #kAbsorb(P, Off +Int 136, keccakF(#kXorBlock(S, substrBytes(P, Off, Off +Int 136), 0)))\n   241\t    requires Off <Int lengthBytes(P)\n   242\t  syntax List ::= #kXorBlock(List, Bytes, Int) [function, total]\n   243\t  rule #kXorBlock(S, B, I) => S requires I >=Int 17\n   244\t  rule #kXorBlock(S, B, I) => #kXorBlock(S[I <- ({S[I]}:>Int xorInt Bytes2Int(substrBytes(B, 8 *Int I, 8 *Int I +Int 8), LE, Unsigned))], B, I +Int 1)\n   245\t    requires I <Int 17\n   246\t  syntax Bytes ::= #kOut(List, Int, Bytes) [function, total]\n   247\t  rule #kOut(S, I, Acc) => Acc requires I >=Int 4\n   248\t  rule #kOut(S, I, Acc) => #kOut(S, I +Int 1, Acc +Bytes Int2Bytes(8, {S[I]}:>Int, LE)) requires I <Int 4\n   249\t\n   250\t  syntax List ::= keccakF(List) [function, total]\n   251\t  rule keccakF(S) => #kRounds(S, 0)\n   252\t  syntax List ::= #kRounds(List, Int) [function, total]\n   253\t  rule #kRounds(S, R) => S requires R >=Int 24\n   254\t  rule #kRounds(S, R) => #kRounds(#kIota(#kChi(#kRhoPi(#kTheta(S))), R), R +Int 1) requires R <Int 24\n   255\t\n   256\t  // theta\n   257\t  syntax List ::= #kTheta(List) [function, total]\n   258\t  rule #kTheta(S) => #kThetaApply(S, #kColumns(S, 0), 0)\n   259\t  syntax List ::= #kColumns(List, Int) [function, total]   // C[x] = xor of column x\n   260\t  rule #kColumns(_, X) => .List requires X >=Int 5\n   261\t  rule #kColumns(S, X) => ListItem(lane(S, X, 0) xorInt lane(S, X, 1) xorInt lane(S, X, 2) xorInt lane(S, X, 3) xorInt lane(S, X, 4)) #kColumns(S, X +Int 1)\n   262\t    requires X <Int 5\n   263\t  syntax List ::= #kThetaApply(List, List, Int) [function, total]\n   264\t  rule #kThetaApply(S, _, I) => S requires I >=Int 25\n   265\t  rule #kThetaApply(S, C, I) => #kThetaApply(S[I <- ({S[I]}:>Int xorInt ({C[(I +Int 4) modInt 5]}:>Int xorInt rotl64({C[(I +Int 1) modInt 5]}:>Int, 1)))], C, I +Int 1)\n   266\t    requires I <Int 25\n   267\t\n   268\t  // rho + pi: B[y, 2x+3y] = rotl(A[x, y], r[x, y])\n   269\t  syntax List ::= #kRhoPi(List) [function, total]\n   270\t  rule #kRhoPi(S) => #kRhoPiApply(S, #kZero(25), 0)\n   271\t  syntax List ::= #kRhoPiApply(List, List, Int) [function, total]\n   272\t  rule #kRhoPiApply(_, B, I) => B requires I >=Int 25\n   273\t  rule #kRhoPiApply(S, B, I) => #kRhoPiApply(S, B[((I modInt 5) *Int 0 +Int (I /Int 5)) +Int 5 *Int ((2 *Int (I modInt 5) +Int 3 *Int (I /Int 5)) modInt 5) <- rotl64({S[I]}:>Int, keccakRot(I))], I +Int 1)\n   274\t    requires I <Int 25\n   275\t\n   276\t  // chi\n   277\t  syntax List ::= #kChi(List) [function, total]\n   278\t  rule #kChi(S) => #kChiApply(S, 0)\n   279\t  syntax List ::= #kChiApply(List, Int) [function, total]\n   280\t  rule #kChiApply(_, I) => .List requires I >=Int 25\n   281\t  rule #kChiApply(S, I) => ListItem(lane(S, I modInt 5, I /Int 5) xorInt ((lane(S, I modInt 5 +Int 1, I /Int 5) xorInt #m64) &Int lane(S, I modInt 5 +Int 2, I /Int 5))) #kChiApply(S, I +Int 1)\n   282\t    requires I <Int 25\n   283\t\n   284\t  // iota\n   285\t  s