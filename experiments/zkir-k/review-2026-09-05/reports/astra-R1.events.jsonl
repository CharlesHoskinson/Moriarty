{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/charl/Moriarty/repos/_build/ledger-92e8bdd3/zkir-oracle/src/main.rs | sed -n '1,130p'; nl -ba /home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/p256-0.13.2/src/arithmetic.rs | sed -n '32,68p'; nl -ba /home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/k256-0.13.4/src/arithmetic/affine.rs | sed -n '60,77p'; nl -ba /home/charl/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/curve25519-dalek-4.1.3/src/constants.rs | sed -n '46,86p'; nl -ba /home/charl/Moriarty/repos/input-output-hk/arc-zkir/src/zkir-v3/Assumptions.agda | sed -n '1,105p'\"","aggregated_output":"     1\t//! Differential-testing oracle for the ZKIR-in-K semantics.\n     2\t//! Runs `IrSource::preprocess` (made `pub` by a one-line patch in this\n     3\t//! worktree) on a .zkir file and a preimage, and prints the resulting memory,\n     4\t//! public-input vector and skip vector as JSON. Field elements are decimal\n     5\t//! strings; memory values are given by their `encode_offcircuit` vectors and\n     6\t//! their variant name.\n     7\tuse std::borrow::Cow;\n     8\tuse std::collections::BTreeMap;\n     9\tuse std::fs::File;\n    10\tuse std::io::BufReader;\n    11\t\n    12\tuse midnight_zkir_v3::IrSource;\n    13\tuse midnight_zkir_v3::ir_instructions::encode::encode_offcircuit;\n    14\tuse num_bigint::BigUint;\n    15\tuse serde::{Deserialize, Serialize};\n    16\tuse transient_crypto::curve::Fr;\n    17\tuse transient_crypto::proofs::{KeyLocation, ProofPreimage};\n    18\t\n    19\t#[derive(Deserialize)]\n    20\tstruct PreimageJson {\n    21\t    inputs: Vec<String>,\n    22\t    binding_input: String,\n    23\t    #[serde(default)]\n    24\t    communications_commitment: Option<(String, String)>,\n    25\t    #[serde(default)]\n    26\t    private_transcript: Vec<String>,\n    27\t    #[serde(default)]\n    28\t    public_transcript_inputs: Vec<String>,\n    29\t    #[serde(default)]\n    30\t    public_transcript_outputs: Vec<String>,\n    31\t}\n    32\t\n    33\t#[derive(Serialize)]\n    34\tstruct MemValue {\n    35\t    variant: String,\n    36\t    encoded: Vec<String>,\n    37\t}\n    38\t\n    39\t#[derive(Serialize)]\n    40\tstruct Output {\n    41\t    status: &'static str,\n    42\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    43\t    error: Option<String>,\n    44\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    45\t    memory: Option<BTreeMap<String, MemValue>>,\n    46\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    47\t    pis: Option<Vec<String>>,\n    48\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n    49\t    pi_skips: Option<Vec<Option<usize>>>,\n    50\t}\n    51\t\n    52\tfn fr_from_dec(s: &str) -> anyhow::Result<Fr> {\n    53\t    let n: BigUint = s.parse().map_err(|e| anyhow::anyhow!(\"bad decimal {s}: {e}\"))?;\n    54\t    let mut bytes = n.to_bytes_le();\n    55\t    if bytes.len() > 32 {\n    56\t        anyhow::bail!(\"{s} does not fit in 32 bytes\");\n    57\t    }\n    58\t    bytes.resize(32, 0);\n    59\t    Fr::from_le_bytes(&bytes).ok_or_else(|| anyhow::anyhow!(\"{s} is not a canonical field element\"))\n    60\t}\n    61\t\n    62\tfn fr_to_dec(x: &Fr) -> String {\n    63\t    BigUint::from_bytes_le(&x.as_le_bytes()).to_string()\n    64\t}\n    65\t\n    66\tfn main() -> anyhow::Result<()> {\n    67\t    let args: Vec<String> = std::env::args().collect();\n    68\t    if args.len() != 3 {\n    69\t        eprintln!(\"usage: zkir-oracle IR.zkir PREIMAGE.json\");\n    70\t        std::process::exit(2);\n    71\t    }\n    72\t    let ir = IrSource::load(BufReader::new(File::open(&args[1])?))?;\n    73\t    let pj: PreimageJson = serde_json::from_reader(BufReader::new(File::open(&args[2])?))?;\n    74\t    let vec_fr = |v: &Vec<String>| -> anyhow::Result<Vec<Fr>> { v.iter().map(|s| fr_from_dec(s)).collect() };\n    75\t    let preimage = ProofPreimage {\n    76\t        binding_input: fr_from_dec(&pj.binding_input)?,\n    77\t        communications_commitment: match &pj.communications_commitment {\n    78\t            Some((c, r)) => Some((fr_from_dec(c)?, fr_from_dec(r)?)),\n    79\t            None => None,\n    80\t        },\n    81\t        inputs: vec_fr(&pj.inputs)?,\n    82\t        private_transcript: vec_fr(&pj.private_transcript)?,\n    83\t        public_transcript_inputs: vec_fr(&pj.public_transcript_inputs)?,\n    84\t        public_transcript_outputs: vec_fr(&pj.public_transcript_outputs)?,\n    85\t        key_location: KeyLocation(Cow::Borrowed(\"builtin\")),\n    86\t    };\n    87\t    let out = match ir.preprocess(&preimage) {\n    88\t        Ok(p) => {\n    89\t            let mut memory = BTreeMap::new();\n    90\t            for (id, v) in p.memory.iter() {\n    91\t                let dbg = format!(\"{v:?}\");\n    92\t                let variant = dbg.split('(').next().unwrap_or(\"\").to_string();\n    93\t                let encoded = encode_offcircuit(v)\n    94\t                    .into_iter()\n    95\t                    .map(|e| {\n    96\t                        let f: Fr = e.try_into().expect(\"encode yields Native\");\n    97\t                        fr_to_dec(&f)\n    98\t                    })\n    99\t                    .collect();\n   100\t                memory.insert(id.0.clone(), MemValue { variant, encoded });\n   101\t            }\n   102\t            Output {\n   103\t                status: \"ok\",\n   104\t                error: None,\n   105\t                memory: Some(memory),\n   106\t                pis: Some(p.pis.iter().map(|x| fr_to_dec(&Fr(*x))).collect()),\n   107\t                pi_skips: Some(p.pi_skips.clone()),\n   108\t            }\n   109\t        }\n   110\t        Err(e) => Output { status: \"error\", error: Some(format!(\"{e:#}\")), memory: None, pis: None, pi_skips: None },\n   111\t    };\n   112\t    println!(\"{}\", serde_json::to_string(&out)?);\n   113\t    Ok(())\n   114\t}\n    32\t}\n    33\t\n    34\t/// Adapted from [NIST SP 800-186] § G.1.2: Curve P-256.\n    35\t///\n    36\t/// [NIST SP 800-186]: https://csrc.nist.gov/publications/detail/sp/800-186/final\n    37\timpl PrimeCurveParams for NistP256 {\n    38\t    type FieldElement = FieldElement;\n    39\t    type PointArithmetic = point_arithmetic::EquationAIsMinusThree;\n    40\t\n    41\t    /// a = -3\n    42\t    const EQUATION_A: FieldElement = FieldElement::from_u64(3).neg();\n    43\t\n    44\t    const EQUATION_B: FieldElement =\n    45\t        FieldElement::from_hex(\"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\");\n    46\t\n    47\t    /// Base point of P-256.\n    48\t    ///\n    49\t    /// Defined in NIST SP 800-186 § G.1.2:\n    50\t    ///\n    51\t    /// ```text\n    52\t    /// Gₓ = 6b17d1f2 e12c4247 f8bce6e5 63a440f2 77037d81 2deb33a0 f4a13945 d898c296\n    53\t    /// Gᵧ = 4fe342e2 fe1a7f9b 8ee7eb4a 7c0f9e16 2bce3357 6b315ece cbb64068 37bf51f5\n    54\t    /// ```\n    55\t    const GENERATOR: (FieldElement, FieldElement) = (\n    56\t        FieldElement::from_hex(\"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296\"),\n    57\t        FieldElement::from_hex(\"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\"),\n    58\t    );\n    59\t}\n    60\t    /// Gₓ = 79be667e f9dcbbac 55a06295 ce870b07 029bfcdb 2dce28d9 59f2815b 16f81798\n    61\t    /// Gᵧ = 483ada77 26a3c465 5da4fbfc 0e1108a8 fd17b448 a6855419 9c47d08f fb10d4b8\n    62\t    /// ```\n    63\t    pub const GENERATOR: Self = Self {\n    64\t        x: FieldElement::from_bytes_unchecked(&[\n    65\t            0x79, 0xbe, 0x66, 0x7e, 0xf9, 0xdc, 0xbb, 0xac, 0x55, 0xa0, 0x62, 0x95, 0xce, 0x87,\n    66\t            0x0b, 0x07, 0x02, 0x9b, 0xfc, 0xdb, 0x2d, 0xce, 0x28, 0xd9, 0x59, 0xf2, 0x81, 0x5b,\n    67\t            0x16, 0xf8, 0x17, 0x98,\n    68\t        ]),\n    69\t        y