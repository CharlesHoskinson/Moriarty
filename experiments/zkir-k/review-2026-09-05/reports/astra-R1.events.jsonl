nst EIGHT_TORSION: [EdwardsPoint; 8] = EIGHT_TORSION_INNER_DOC_HIDDEN;\n   185\t\n   186\t/// Inner item used to hide limb constants from cargo doc output.\n   187\t#[doc(hidden)]\n   138\t    // argument the representation of the input variables as `Expression`. The\n   139\t    // argument `vars` has length `WIDTH + self.nb_skips`.\n   140\t    // Note: does *not* include the `self.constant` component in the conversion.\n   141\t    fn to_expression(self, vars: &[Expression<F>]) -> Expression<F> {\n   142\t        let (lin_coeffs, pow_coeffs) = self.var_coeffs.split_at(WIDTH - 1);\n   143\t        let (lin_vars, pow_vars) = vars.split_at(WIDTH - 1);\n   144\t\n   145\t        let expr = lin_coeffs.iter().zip(lin_vars).fold(\n   146\t            Expression::Constant(F::ZERO),\n   147\t            |accu, (coeff, x)| {\n   148\t                if coeff.is_zero_vartime() {\n   149\t                    accu\n   150\t                } else {\n   151\t                    accu + Expression::Constant(*coeff) * x.clone()\n   152\t                }\n   153\t            },\n   154\t        );\n   155\t        pow_coeffs.iter().zip(pow_vars).fold(expr, |accu, (coeff, x)| {\n   156\t            if coeff.is_zero_vartime() {\n   157\t                accu\n   158\t            } else {\n   159\t                accu + Expression::Constant(*coeff) * sbox(x.clone())\n   160\t            }\n   161\t        })\n   162\t    }\n   163\t}\n   164\t\n   165\timpl<F: PoseidonField> RoundId<F> {\n   166\t    // Generates a new trivial identity. The linear variables are initialised to\n   167\t    // themselves (\"x = x\"), and the exponentiated variables are initialised to 0\n   168\t    // (\"x = 0\"). The latter will be overwritten during the identity generation\n   169\t    // anyway, so their initialisation does not matter.\n   170\t    fn init(nb_skips: usize) -> Self {\n   171\t        RoundId {\n   172\t            nb_skips,\n   173\t            ids: core::array::from_fn(|i| {\n   174\t                if i < WIDTH {\n   175\t                    let mut id = RoundVarId::init();\n   176\t                    id.var_coeffs[i] = F::ONE;\n   177\t                    id\n   178\t                } else {\n   179\t                    RoundVarId::init()\n   180\t                }\n   181\t            }),\n   182\t        }\n   183\t    }\n   184\t\n   185\t    // Reconstructs the identity of the current row, assuming that the identities of\n   186\t    // its linear variables are stored in `self.ids[..WIDTH-1]`. This function\n   187\t    // basically copies `self.ids[..WIDTH-1]` in the first `WIDTH-1` elements of the\n   188\t    // result, and adds a trivial identity (\"x = x\") in the last exponentiated slot.\n   189\t    fn row_id(&self, row: &usize) -> [RoundVarId<F>; WIDTH] {\n   190\t        let mut last = RoundVarId::init();\n   191\t        last.var_coeffs[WIDTH - 1 + *row] = F::ONE;\n   192\t        core::array::from_fn(|i| if i == WIDTH - 1 { last } else { self.ids[i] })\n   193\t    }\n   194\t\n   195\t    // Updates the identity from the current row to the next one by applying a\n   196\t    // partial round.\n   197\t    fn update_row(self: &mut RoundId<F>, round_offset: &usize) {\n   198\t        let current_row = self.row_id(round_offset);\n   199\t        #[allow(clippy::needless_range_loop)]\n   200\t        for i in 0..WIDTH - 1 {\n   201\t            self.ids[i] = RoundVarId::from_constant_index(round_offset, &i);\n   202\t            for j in 0..WIDTH {\n   203\t                self.ids[i].add_and_mul(&current_row[j], &F::MDS[i][j]);\n   204\t            }\n   205\t        }\n   206\t        self.ids[WIDTH + *round_offset] =\n   207\t            RoundVarId::from_constant_index(round_offset, &(WIDTH - 1));\n   208\t        #[allow(clippy::needless_range_loop)]\n   209\t        for j in 0..WIDTH {\n   210\t            self.ids[WIDTH + *round_offset].add_and_mul(&current_row[j], &F::MDS[WIDTH - 1][j]);\n   211\t        }\n   212\t    }\n   213\t\n   214\t    /// Generates the final identities for an optimised partial rounds, i.e.,\n   215\t    /// applies `1+nb_skips` times the function `ids.update_row`.\n   216\t    fn generate(nb_skips: usize) -> Self {\n   217\t        let mut ids = RoundId::<F>::init(nb_skips);\n   218\t        for row in 0..1 + nb_skips {\n   219\t            ids.update_row(&row);\n   220\t        }\n   221\t        ids\n   222\t    }\n   223\t\n   224\t    // Uplifting of the function `RoundVarId<F>::eval_constants` to sets of\n   225\t    // identities. The `instances` argument has length `1 + self.nb_skips`, and the\n   226\t    // result has length `WIDTH + self.nb_skips`. Mutates the `arg` argument to\n   227\t    // store the result.\n   228\t    fn eval_constants(&self, round: usize, arg: &mut [F]) {\n   229\t        let instances = &F::ROUND_CONSTANTS[round + 1..round + 2 + self.nb_skips];\n   230\t        self.ids[..WIDTH - 1]\n   231\t            .iter()\n   232\t            .chain(self.ids[WIDTH..].iter())\n   233\t            .map(|id| id.eval_constants(instances))\n   234\t            .zip(arg.iter_mut())\n   235\t            .for_each(|(c, x)| *x = c)\n   236\t    }\n   237\t\n   238\t    /// Uplifting of the function `RoundVarId<F>::eval_vars` to sets of\n   239\t    /// identities, and adds the output of `self.eval_constants` to the result\n   240\t    /// (taken as the `round_constants` argument). Returns the value of\n   241\t    /// the last column of the skipped rows (length `self.nb_skips`, passed as\n   242\t    /// the parameter `NB_SKIPS` so that it can be used as array's length).\n   243\t    pub(crate) fn eval<const NB_SKIPS: usize>(\n   244\t        &self,\n   245\t        round_constants: &[F], // Length `WIDTH + self.nb_skips`.\n   246\t        instances: &mut [F],   // Length `WIDTH`.\n   247\t    ) -> [F; NB_SKIPS] {\n   248\t        let mut pow_instances = [F::ZERO; NB_SKIPS];\n   249\t        instances[WIDTH - 1] *= instances[WIDTH - 1].square().square();\n   250\t        let mut pow_instances_exp = instances\n   251\t            .iter()\n   252\t            .chain(std::iter::repeat_n(&F::ZERO, NB_SKIPS))\n   253\t            .copied()\n   254\t            .collect::<Vec<_>>();\n   255\t\n   256\t        #[allow(clippy::reversed_empty_ranges)]\n   257\t        for i in 0..self.nb_skips {\n   258\t            let next =\n   259\t                self.ids[WIDTH + i].eval_vars(&pow_instances_exp, round_constants[WIDTH - 1 + i]);\n   260\t            pow_instances[i] = next;\n   261\t            pow_instances_exp[WIDTH + i] = next.square().square() * next;\n   262\t        }\n   263\t        let mut output = [F::ZERO; WIDTH];\n   264\t        for i in 0..WIDTH - 1 {\n   265\t            output[i] = self.ids[i].eval_vars(&pow_instances_exp, round_constants[i]);\n   266\t        }\n   267\t        output[WIDTH - 1] = self.ids[WIDTH + NB_SKIPS]\n   268\t            .eval_vars(&pow_instances_exp, round_constants[WIDTH + NB_SKIPS - 1]);\n   269\t        instances.copy_from_slice(&output);\n   270\t        pow_instances\n   271\t    }\n   272\t\n   273\t    // Computes the round constants necessary for partial-round (cpu) with\n   274\t    // round skips.\n   275\t    fn round_constants_cpu(&self) -> RoundContantsCPU<F> {\n   276\t        let mut v = [[F::ZERO; WIDTH + NB_SKIPS_CPU]; NB_PARTIAL_ROUNDS / (1 + NB_SKIPS_CPU)];\n   277\t        for (round, main_round) in (NB_FULL_ROUNDS / 2..)\n   278\t            .take(NB_PARTIAL_ROUNDS - NB_PARTIAL_ROUNDS % (1 + NB_SKIPS_CPU))\n   279\t            .step_by(1 + NB_SKIPS_CPU)\n   280\t            .zip(0..)\n   281\t        {\n   282\t            self.eval_constants(round, &mut v[main_round])\n   283\t        }\n   284\t        v\n   285\t    }\n   286\t\n   287\t    // Computes the round constants necessary for partial-round (circuit) with\n   170\t#[cfg(feature = \"dev-curves\")]\n   171\timpl FieldEmulationParams<bn256::Fr, k256::Fp> for MultiEmulationParams {\n   172\t    const LOG2_BASE: u32 = 64;\n   173\t    const NB_LIMBS: u32 = 4;\n   174\t    fn moduli() -> Vec<BigInt> {\n   175\t        vec![BigInt::from(2).pow(128)]\n   176\t    }\n   177\t    const RC_LIMB_SIZE: u32 = 16;\n   178\t}\n   179\t\n   180\t/// Secp256k1's Base field over BLS12-381's Scalar field.\n   181\timpl FieldEmulationParams<midnight_curves::Fq, k256::Fp> for MultiEmulationParams {\n   182\t    const LOG2_BASE: u32 = 64;\n   183\t    const NB_LIMBS: u32 = 4;\n   184\t    fn moduli() -> Vec<BigInt> {\n   185\t        vec![BigInt::from(2).pow(128)]\n   186\t    }\n   187\t    const RC_LIMB_SIZE: u32 = 16;\n   188\t}\n   189\t\n   190\t/*\n   191\t====================================================\n   192\tEmulated: Secp256k1's Scalar field\n   207\t    }\n   208\t    const RC_LIMB_SIZE: u32 = 14;\n   209\t}\n   210\t\n   211\t/// Secp256k1's Scalar field over BLS12-381's Scalar field.\n   212\timpl FieldEmulationParams<midnight_curves::Fq, k256::Fq> for MultiEmulationParams {\n   213\t    const LOG2_BASE: u32 = 64;\n   214\t    const NB_LIMBS: u32 = 4;\n   215\t    fn moduli() -> Vec<BigInt> {\n   216\t        vec![\n   217\t            BigInt::from(2).pow(118),\n   218\t            BigInt::from(2).pow(118) - BigInt::one(),\n   219\t        ]\n   220\t    }\n   221\t    const RC_LIMB_SIZE: u32 = 17;\n   222\t}\n   223\t\n   224\t/*\n   225\t====================================================\n   226\tEmulated: Secp256r1's Base field\n   227\t\n   228\tNative fields supported:\n   229\t - BLS12-381's Scalar field\n   230\t====================================================\n   231\t*/\n   232\t\n   233\t/// Secp256r1's Base field over BLS12-381's Scalar field.\n   234\timpl FieldEmulationParams<midnight_curves::Fq, p256::Fp> for MultiEmulationParams {\n   235\t    const LOG2_BASE: u32 = 64;\n   236\t    const NB_LIMBS: u32 = 4;\n   237\t    fn moduli() -> Vec<BigInt> {\n   238\t        vec![\n   239\t            BigInt::from(2).pow(122),\n   240\t   