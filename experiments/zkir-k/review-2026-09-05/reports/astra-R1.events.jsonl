ue, IrType, IrValue},\n    32\t};\n    33\tuse anyhow::anyhow;\n    34\t\n    35\t/// Encodes the given off-circuit value as a vector of IrValue::Native.\n    36\tpub fn encode_offcircuit(value: &IrValue) -> Vec<IrValue> {\n    37\t    let encoded = match value {\n    38\t        IrValue::Native(x) => AssignedNative::<F>::as_public_input(&x.0),\n    39\t        IrValue::Bytes32(bs) => {\n    40\t            let mut low: [u8; 32] = *bs;\n    41\t            low[31] = 0;\n    42\t\n    43\t            let mut high = [0u8; 32];\n    44\t            high[0] = bs[31];\n    45\t\n    46\t            vec![\n    47\t                F::from_bytes_le(&low).unwrap(),\n    48\t                F::from_bytes_le(&high).unwrap(),\n    49\t            ]\n    50\t        }\n    51\t        IrValue::JubjubPoint(p) => AssignedNativePoint::<JubjubExtended>::as_public_input(p),\n    52\t        IrValue::JubjubScalar(s) => {\n    53\t            let encoded = AssignedScalarOfNativeCurve::<JubjubExtended>::as_public_input(s);\n    54\t            // In ZKIRv3, an assigned scalar can only originate from a circuit\n    55\t            // input (PublicInput or PrivateInput), which yields canonical assigned\n    56\t            // scalars (whose internal representation uses at most 252 bits).\n    57\t            assert_eq!(encoded.len(), 1);\n    58\t            encoded\n    59\t        }\n    60\t\n    61\t        IrValue::Secp256k1Point(p) => {\n    62\t            AssignedForeignPoint::<F, k256::K256, MEP>::as_public_input(p)\n    63\t        }\n    64\t        IrValue::Secp256k1Base(s) => AssignedField::<F, k256::Fp, MEP>::as_public_input(s),\n    65\t        IrValue::Secp256k1Scalar(s) => AssignedField::<F, k256::Fq, MEP>::as_public_input(s),\n    66\t\n    67\t        IrValue::Secp256r1Point(p) => AssignedForeignPoint::<F, p256::P256, MEP>::as_public_input(p),\n    68\t        IrValue::Secp256r1Base(s) => AssignedField::<F, p256::Fp, MEP>::as_public_input(s),\n    69\t        IrValue::Secp256r1Scalar(s) => AssignedField::<F, p256::Fq, MEP>::as_public_input(s),\n    70\t\n    71\t        IrValue::Curve25519Point(p) => {\n    72\t            AssignedForeignEdwardsPoint::<F, curve25519::Curve25519, MEP>::as_public_input(p)\n    73\t        }\n    74\t        IrValue::Curve25519Base(s) => AssignedField::<F, curve25519::Fp, MEP>::as_public_input(s),\n    75\t        IrValue::Curve25519Scalar(s) => {\n    76\t            AssignedField::<F, curve25519::Scalar, MEP>::as_public_input(s)\n    77\t        }\n    78\t    };\n    79\t    encoded\n    80\t        .into_iter()\n    81\t        .map(|s| IrValue::Native(Fr(s)))\n    82\t        .collect()\n    83\t}\n    84\t\n    85\t/// Encodes the given in-circuit value as a vector of CircuitValue::Native.\n    86\tpub fn encode_incircuit(\n    87\t    std_lib: &ZkStdLib,\n    88\t    layouter: &mut impl Layouter<F>,\n    89\t    value: &CircuitValue,\n    90\t) -> Result<Vec<CircuitValue>, Error> {\n    91\t    let encoded = match value {\n    92\t        CircuitValue::Native(x) => std_lib.as_public_input(layouter, x),\n    93\t        CircuitValue::Bytes32(bs) => Ok(vec![\n    94\t            std_lib.assigned_from_le_bytes(layouter, &bs[..31])?,\n    95\t            bs[31].clone().into(),\n    96\t        ]),\n    97\t        CircuitValue::JubjubPoint(p) => std_lib.jubjub().as_public_input(layouter, p),\n    98\t        CircuitValue::JubjubScalar(s) => {\n    99\t            // Jubjub::Scalar::NUM_BITS is incorrectly set to 255 (instead of 252)\n   100\t            // in midnight-curves v0.2.0. Consequently, Jubjub scalars may be encoded\n   101\t            // unnecessarily as 2 native field values instead of one.\n   102\t            // We return the first only and make sure the rest (supposedly one more)\n   103\t            // are zero.\n   104\t            let encoded = std_lib.jubjub().as_public_input(layouter, s)?;\n   105\t            for x in encoded[1..].iter() {\n   106\t                std_lib.assert_zero(layouter, x)?;\n   107\t            }\n   108\t            Ok(encoded[..1].to_vec())\n   109\t        }\n   110\t\n   111\t        CircuitValue::Secp256k1Point(p) => std_lib.secp256k1().as_public_input(layouter, p),\n   112\t        CircuitValue::Secp256k1Base(s) => {\n   113\t            (std_lib.secp256k1().base_field_chip()).as_public_input(layouter, s)\n   114\t        }\n   115\t        CircuitValue::Secp256k1Scalar(s) => {\n   116\t            (std_lib.secp256k1().scalar_field_chip()).as_public_input(layouter, s)\n   117\t        }\n   118\t\n   119\t        CircuitValue::Secp256r1Point(p) => std_lib.p256().as_public_input(layouter, p),\n   120\t        CircuitValue::Secp256r1Base(s) => {\n   121\t            (std_lib.p256().base_field_chip()).as_public_input(layouter, s)\n   122\t        }\n   123\t        CircuitValue::Secp256r1Scalar(s) => {\n   124\t            (std_lib.p256().scalar_field_chip()).as_public_input(layouter, s)\n   125\t        }\n   126\t\n   127\t        CircuitValue::Curve25519Point(p) => std_lib.curve25519().as_public_input(layouter, p),\n   128\t        CircuitValue::Curve25519Base(s) => {\n   129\t            (std_lib.curve25519().base_field_chip()).as_public_input(layouter, s)\n   130\t        }\n   131\t        CircuitValue::Curve25519Scalar(s) => {\n   132\t            (std_lib.curve25519().scalar_field_chip()).as_public_input(layouter, s)\n   133\t        }\n   134\t    }?;\n   135\t    Ok(encoded.into_iter().map(CircuitValue::Native).collect())\n   136\t}\n   137\t\n   138\t/// Decodes the given Fr values as an IrValue of the given type.\n   139\t///\n   140\t/// # Errors\n   141\t///\n   142\t/// Returns an error if the provided raw values cannot be decoded as the given type.\n   143\tpub fn decode_offcircuit(encoded: &[Fr], val_t: &IrType) -> Result<IrValue, anyhow::Error> {\n   144\t    let encoded: Vec<F> = encoded.iter().map(|f| f.0).collect();\n   145\t    match val_t {\n   146\t        IrType::Native => AssignedNative::<F>::from_public_input(&encoded)\n   147\t            .map(Fr)\n   148\t            .map(IrValue::Native),\n   149\t\n   150\t        IrType::Bytes32 => {\n   151\t            if encoded.len() != 2 {\n   152\t                None\n   153\t            } else {\n   154\t                let mut bytes = encoded[0].to_bytes_le();\n   155\t                assert_eq!(bytes[31], 0);\n   156\t\n   157\t                let high = encoded[1].to_bytes_le();\n   158\t                for b in high.iter().skip(1) {\n   159\t                    assert_eq!(*b, 0);\n   160\t                }\n   161\t\n   162\t                bytes[31] = high[0];\n   163\t                Some(IrValue::Bytes32(bytes))\n   164\t            }\n   165\t        }\n   166\t\n   167\t        IrType::JubjubPoint => AssignedNativePoint::<JubjubExtended>::from_public_input(&encoded)\n   168\t            .map(IrValue::JubjubPoint),\n   169\t\n   170\t        IrType::JubjubScalar => {\n   171\t            AssignedScalarOfNativeCurve::<JubjubExtended>::from_public_input(&encoded)\n   172\t                .map(IrValue::JubjubScalar)\n   173\t        }\n   174\t\n   175\t        IrType::Secp256k1Point => {\n   176\t            AssignedForeignPoint::<F, k256::K256, MEP>::from_public_input(&encoded)\n   177\t                .map(IrValue::Secp256k1Point)\n   178\t        }\n   179\t\n   180\t        IrType::Secp256k1Base => AssignedField::<F, k256::Fp, MEP>::from_public_input(&encoded)\n   181\t            .map(IrValue::Secp256k1Base),\n   182\t\n   183\t        IrType::Secp256k1Scalar => AssignedField::<F, k256::Fq, MEP>::from_public_input(&encoded)\n   184\t            .map(IrValue::Secp256k1Scalar),\n   185\t\n   186\t        IrType::Secp256r1Point => {\n   187\t            AssignedForeignPoint::<F, p256::P256, MEP>::from_public_input(&encoded)\n   188\t                .map(IrValue::Secp256r1Point)\n   189\t        }\n   190\t\n   191\t        IrType::Secp256r1Base => AssignedField::<F, p256::Fp, MEP>::from_public_input(&encoded)\n   192\t            .map(IrValue::Secp256r1Base),\n   193\t\n   194\t        IrType::Secp256r1Scalar => AssignedField::<F, p256::Fq, MEP>::from_public_input(&encoded)\n   195\t            .map(IrValue::Secp256r1Scalar),\n   196\t\n   197\t        IrType::Curve25519Point => {\n   198\t            AssignedForeignEdwardsPoint::<F, curve25519::Curve25519, MEP>::from_public_input(\n   199\t                &encoded,\n   200\t            )\n   201\t            .map(IrValue::Curve25519Point)\n   202\t        }\n   203\t\n   204\t        IrType::Curve25519Base => {\n   205\t            AssignedField::<F, curve25519::Fp, MEP>::from_public_input(&encoded)\n   206\t                .map(IrValue::Curve25519Base)\n   207\t        }\n   208\t\n   209\t        IrType::Curve25519Scalar => {\n   210\t            AssignedField::<F, curve25519::Scalar, MEP>::from_public_input(&encoded)\n   211\t                .map(IrValue::Curve25519Scalar)\n   212\t        }\n   213\t    }\n   214\t    .ok_or_else(|| anyhow!(\"Failed to decode {encoded:?} as {val_t:?}\"))\n   215\t}\n   216\t\n   217\t/// Converts a native field element to a Jubjub scalar by reducing modulo\n   218\t/// the Jubjub scalar field order if necessary.\n   219\tpub fn native_to_jubjub_scalar(native: &Fr) -> JubjubFr {\n   220\t    let mut bytes = [0u8; 64];\n   221\t    bytes[..32].copy_from_slice(&native.0.to_bytes_le());\n   222\t    JubjubFr::from_bytes_wide(&bytes)\n   223\t}\n   224\t\n   225\t/// Reduces the given biguint modulo the Jubjub scalar field order and returns the\n   226\t/// result as an `AssignedScalarOfNativeCurve<JubjubExtended>` of exactly 252 bits.\n   227\tpub fn jubjub_scalar_from_biguint(\n   228\t    std_lib: &ZkStdLib,\n   229\t    layouter: &mut impl Layouter<F>,\n   230\t    x: AssignedBigUint<F>,\n   231\t) -> Result<AssignedScalarOfNativeCurve<JubjubExtended>, Error> {\n   232\t    let jubjub_order = {\n   233\t        let p = JubjubFr::modulus();\n   234\t        std_lib.biguint().assign_fixed_biguint(layouter, p)?\n   235\t    };\n   236\t    let (_q, r) = std_lib.biguint().div_rem(layouter, &x, &jubjub_order)?;\n   237\t\n   238\t    let r_le_bytes = std_lib.biguint().to_le_bytes(layouter, &r)?;\n   239\t    std_lib.jubjub().scalar_from_le_bytes(layouter, &r_le_bytes)\n   240\t}\n     1\t// This file is part of MIDNIGHT-ZK.\n     2\t// Copyright (C) Midnight Foundation\n     3\t// SPDX-License-Identifier: Apache-2.0\n     4\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     5\t// You may not use this file except in compliance with the License.\n     6\t// You may obtain a copy of the License at\n     7\t// http://www.apache.org/licenses/LICENSE-2.0\n     8\t// Unless required by applicable law or agreed to in writing, software\n     9\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    10\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    11\t// See the License for the specific language governing permissions and\n    12\t// limitations under the License.\n    13\t\n    14\tuse std::io::{self, Read};\n    15\t\n    16\tuse group::GroupEncoding;\n    17\tuse midnight_proofs::transcript::{Hashable, Sampleable, TranscriptHash};\n    18\t#[cfg(feature = \"dev-curves\")]\n    19\tuse {ff::PrimeField, midnight_curves::bn256};\n    20\t\n    21\tuse super::{\n    22\t    constants::{PoseidonField, NB_FULL_ROUNDS, NB_PARTIAL_ROUNDS, RATE, WIDTH},\n    23\t    round_skips::{PreComputedRoundCPU, PreComputedRoundCircuit},\n    24\t    PoseidonChip, NB_SKIPS_CIRCUIT,\n    25\t};\n    26\tuse crate::{\n    27\t    field::foreign::params::MultiEmulationParams as MEP,\n    28\t    instructions::SpongeCPU,\n    29\t    types::{AssignedForeignPoint, Instantiable},\n    30\t    CircuitField,\n    31\t};\n    32\t\n    33\t/// Number of times the linear part of the partial rounds is skipped in the\n    34\t/// Poseidon cpu implemetation (0 is the default implementation without skips at\n    35\t/// all).\n    36\tpub(crate) const NB_SKIPS_CPU: usize = 2;\n    37\t\n    38\t/// Off-circuit Poseidon state.\n    39\t#[derive(Clone, Debug)]\n    40\tpub struct PoseidonState<F: PoseidonField> {\n    41\t    pre_computed: PreComputedRoundCPU<F>,\n    42\t    register: [F; WIDTH],\n    43\t    queue: Vec<F>,\n    44\t    squeeze_position: usize,\n    45\t    input_len: Option<usize>,\n    46\t}\n    47\t\n    48\t// Applies the MDS matrix to a state and adds the round constants. All arguments\n    49\t// have length `WIDTH`. To save the addition cost, the implementation is done by\n    50\t// mutating the `constants` slice, and eventually copying it into `state`.\n    51\tfn linear_layer<F: PoseidonField>(state: &mut [F], constants: &mut [F]) {\n    52\t    #[allow(clippy::needless_range_loop)]\n    53\t    for i in 0..WIDTH {\n    54\t        for j in 0..WIDTH {\n    55\t            constants[i] += F::MDS[i][j] * state[j];\n    56\t        }\n    57\t    }\n    58\t    state.copy_from_slice(constants);\n    59\t}\n    60\t\n    61\t/// A cpu version of the full round of Poseidon's permutation. Operates by\n    62\t/// mutating the `state` argument (length `WIDTH`).\n    63\tpub(crate) fn full_round_cpu<F: PoseidonField>(round_index: usize, state: &mut [F]) {\n    64\t    state.iter_mut().for_each(|x| *x = x.square().square() * *x);\n    65\t    let mut new_state = if round_index == NB_FULL_ROUNDS + NB_PARTIAL_ROUNDS - 1 {\n    66\t        [F::ZERO; WIDTH]\n    67\t    } else {\n    68\t        F::ROUND_CONSTANTS[round_index + 1]\n    69\t    };\n    70\t    linear_layer(state, &mut new_state);\n    71\t}\n    72\t\n    73\t// A cpu version of Poseidon with `1 + NB_SKIPS_CIRCUIT` partial rounds.\n    74\tfn partial_round_cpu<F: PoseidonField>(\n    75\t    pre_computed: &PreComputedRoundCPU<F>,\n    76\t    round_batch_index: usize,\n    77\t    state: &mut [F], // Length `WIDTH`.\n    78\t) {\n    79\t    pre_computed\n    80\t        .partial_round_id\n    81\t        .eval::<NB_SKIPS_CPU>(&pre_computed.round_constants[round_batch_index], state);\n    82\t}\n    83\t\n    84\t/// A cpu version of Poseidon with `1 + NB_SKIPS_CIRCUIT` partial rounds. Also\n    85\t/// returns the values of the last column of the skipped rows\n    86\t/// (`NB_SKIPS_CIRCUIT` elements) as needed to fill the circuit's rows.\n    87\tpub(crate) fn partial_round_cpu_for_circuits<F: PoseidonField>(\n    88\t    pre_computed: &PreComputedRoundCircuit<F>,\n    89\t    round_batch_index: usize,\n    90\t    state: &mut [F], // Length `WIDTH`.\n    91\t) -> [F; NB_SKIPS_CIRCUIT] {\n    92\t    pre_computed\n    93\t        .partial_round_id\n    94\t        .eval::<NB_SKIPS_CIRCUIT>(&pre_computed.round_constants[round_batch_index], state)\n    95\t}\n    96\t\n    97\t// Alternative partial round version, without any skips.\n    98\tfn partial_round_cpu_raw<F: PoseidonField>(round: usize, state: &mut [F]) {\n    99\t    state[WIDTH - 1] *= state[WIDTH - 1].square().square();\n   100\t    let mut new_state = F::ROUND_CONSTANTS[round + 1];\n   101\t    linear_layer(state, &mut new_state)\n   102\t}\n   103\t\n   104\t/// A cpu version of the full Poseidon's permutation with partial-round skips.\n   105\tpub fn permutation_cpu<F: PoseidonField>(pre_computed: &PreComputedRoundCPU<F>, state: &mut [F]) {\n   106\t    let nb_skips = pre_computed.partial_round_id.nb_skips;\n   107\t    let nb_main_partial_rounds = NB_PARTIAL_ROUNDS / (1 + nb_skips);\n   108\t    let remainder_partial_rounds = NB_PARTIAL_ROUNDS % (1 + nb_skips);\n   109\t\n   110\t    for (x, k0) in state.iter_mut().zip(F::ROUND_CONSTANTS[0]) {\n   111\t        *x += k0;\n   112\t    }\n   113\t    (0..NB_FULL_ROUNDS / 2).for_each(|round_index| full_round_cpu(round_index, state));\n   114\t    (0..nb_main_partial_rounds)\n   115\t        .for_each(|round_batch_index| partial_round_cpu(pre_computed, round_batch_index, state));\n   116\t    (NB_FULL_ROUNDS / 2 + NB_PARTIAL_ROUNDS - remainder_partial_rounds..)\n   117\t        .take(remainder_partial_rounds)\n   118\t        .for_each(|round_index| partial_round_cpu_raw(round_index, state));\n   119\t    (NB_FULL_ROUNDS / 2 + NB_PARTIAL_ROUNDS..)\n   120\t        .take(NB_FULL_ROUNDS / 2)\n   121\t        .for_each(|round_index| {\n   122\t            full_round_cpu(round_index, state);\n   123\t        })\n   124\t}\n   125\t\n   126\t// A cpu implementation of the sponge operations, building on the Poseidon's\n   127\t// permutation.\n   128\timpl<F: PoseidonField> SpongeCPU<F, F> for PoseidonChip<F> {\n   129\t    type StateCPU = PoseidonState<F>;\n   130\t\n   131\t    fn init(input_len: Option<usize>) -> Self::StateCPU {\n   132\t        let mut register = [F::ZERO; WIDTH];\n   133\t        register[RATE] = F::from_u128(input_len.map(|l| l as u128).unwrap_or(1 << 64));\n   134\t        let pre_computed = PreComputedRoundCPU::init();\n   135\t        PoseidonState {\n   136\t            pre_computed,\n   137\t            register,\n   138\t            queue: Vec::new(),\n   139\t            squeeze_position: 0,\n   140\t            input_len,\n   141\t        }\n   142\t    }\n   143\t\n   144\t    fn absorb(state: &mut Self::StateCPU, inputs: &[F]) {\n   145\t        state.queue.extend(inputs);\n   146\t        state.squeeze_position = 0;\n   147\t    }\n   148\t\n   149\t    fn squeeze(state: &mut Self::StateCPU) -> F {\n   150\t        if state.squeeze_position > 0 {\n   151\t            // If `input_len` was specified, we only allow 1 squeeze.\n   152\t            if state.input_len.is_some() {\n   153\t                panic!(\"Attempting to squeeze multiple times a fixed-size Poseidon sponge (CPU).\")\n   154\t            };\n   155\t            debug_assert!(state.queue.is_empty());\n   156\t            let output = state.register[state.squeeze_position % RATE];\n   157\t            state.squeeze_position = (state.squeeze_position + 1) % RATE;\n   158\t            return output;\n   159\t        }\n   160\t\n   161\t        match state.input_len {\n   162\t            None => {\n   163\t                let padding = F::from(state.queue.len() as u64);\n   164\t                state.queue.push(padding);\n   165\t            }\n   166\t            Some(len) => {\n   167\t                if state.queue.len() != len {\n   168\t                    panic!(\"Inconsistent lengths in fixed-size Poseidon sponge (CPU). Expected: {}, found: {}.\", len, state.queue.len())\n   169\t                };\n   170\t            }\n   171\t        }\n   172\t\n   173\t        for chunk in state.queue.chunks(RATE) {\n   174\t            for (entry, value) in state.register.iter_mut().zip(chunk.iter()) {\n   175\t                *entry += value;\n   176\t            }\n   177\t            permutation_cpu(&state.pre_computed, &mut state.register);\n   178\t        }\n   179\t\n   180\t        state.queue = Vec::new();\n   181\t        state.squeeze_position = 1 % RATE;\n   182\t        state.register[0]\n   183\t    }\n   184\t}\n   185\t\n   186\timpl<F: PoseidonField> TranscriptHash for PoseidonState<F> {\n   187\t    type Input = Vec<F>;\n   188\t    type Output = F;\n   189\t\n   190\t    fn init() -> Self {\n   191\t        PoseidonChip::init(None)\n   192\t    }\n   193\t\n   194\t    fn absorb(&mut self, input: &Self::Input) {\n   195\t        PoseidonChip::absorb(self, input)\n   196\t    }\n   197\t\n   198\t    fn squeeze(&mut self) -> Self::Output {\n   199\t        PoseidonChip::squeeze(self)\n   200\t    }\n   201\t}\n   202\t\n   203\t// /////////////////////////////////////////////////////////////\n   204\t// /// Implementation of Hashable for BLS12-381 with Poseidon //\n   205\t// /////////////////////////////////////////////////////////////\n   206\t\n   207\timpl Hashable<PoseidonState<midnight_curves::Fq>> for midnight_curves::G1Projective {\n   208\t    fn to_input(&self) -> Vec<midnight_curves::Fq> {\n   209\t        AssignedForeignPoint::<midnight_curves::Fq, midnight_curves::G1Projective, MEP>::as_public_input(self)\n   210\t    }\n   211\t\n   212\t    fn to_bytes(&self) -> Vec<u8> {\n   213\t        <midnight_curves::G1Affine as GroupEncoding>::to_bytes(&self.into())\n   214\t            .as_ref()\n   215\t            .to_vec()\n   216\t    }\n   217\t\n   218\t    fn read(buffer: &mut impl Read) -> io::Result<Self> {\n   219\t        let mut bytes = <midnight_curves::G1Affine as GroupEncoding>::Repr::default();\n   220\t\n   221\t        buffer.read_exact(bytes.as_mut())?;\n   222\t\n   223\t        Option::from(midnight_curves::G1Affine::from_bytes(&bytes))\n   224\t            .ok_or_else(|| io::Error::other(\"Invalid BLS12-381 point encoding in proof\"))\n   225\t            .map(|p: midnight_curves::G1Affine| p.into())\n   226\t    }\n   227\t}\n   228\t\n   229\timpl Hashable<PoseidonState<midnight_curves::Fq>> for midnight_curves::Fq {\n   230\t    fn to_input(&self) -> Vec<midnight_curves::Fq> {\n   231\t        vec![*self]\n   232\t    }\n   233\t\n   234\t    fn to_bytes(&self) -> Vec<u8> {\n   235\t        self.to_bytes_le().as_ref().to_vec()\n   236\t    }\n   237\t\n   238\t    fn read(buffer: &mut impl Read) -> io::Result<Self> {\n   239\t        use midnight_curves::Fq;\n   240\t        let mut bytes = [0u8; <Fq as CircuitField>::NUM_BYTES];\n   241\t\n   242\t        buffer.read_exact(bytes.as_mut())?;\n   243\t\n   244\t        <Fq as CircuitField>::from_bytes_le(&bytes)\n   245\t            .ok_or_else(|| io::Error::other(\"Invalid BLS12-381 scalar encoding in proof\"))\n   246\t    }\n   247\t}\n   248\t\n   249\timpl Sampleable<PoseidonState<midnight_curves::Fq>> for midnight_curves::Fq {\n   250\t    fn sample(out: midnight_curves::Fq) -> Self {\n   251\t        out\n   252\t    }\n   253\t}\n   254\t\n   255\t// /////////////////////////////////////////////////////////\n   256\t// /// Implementation of Hashable for BN256 with Poseidon //\n   257\t// /////////////////////////////////////////////////////////\n   258\t\n   259\t#[cfg(feature = \"dev-curves\")]\n   260\timpl Hashable<PoseidonState<bn256::Fr>> for bn256::G1 {\n   261\t    fn to_input(&self) -> Vec<bn256::Fr> {\n   262\t        AssignedForeignPoint::<bn256::Fr, bn256::G1, MEP>::as_public_input(self)\n   263\t    }\n   264\t\n   265\t    fn to_bytes(&self) -> Vec<u8> {\n   266\t        <bn256::G1Affine as GroupEncoding>::to_bytes(&self.into()).as_ref().to_vec()\n   267\t    }\n   268\t\n   269\t    fn read(buffer: &mut impl Read) -> io::Result<Self> {\n   270\t        let mut bytes = <bn256::G1Affine as GroupEncoding>::Repr::default();\n   271\t\n   272\t        buffer.read_exact(bytes.as_mut())?;\n   273\t\n   274\t        Option::from(bn256::G1Affine::from_bytes(&bytes))\n   275\t            .ok_or_else(|| io::Error::other(\"Invalid BN256 point encoding in proof\"))\n   276\t            .map(|p: bn256::G1Affine| p.into())\n   277\t    }\n   278\t}\n   279\t\n   280\t#[cfg(feature = \"dev-curves\")]\n   281\timpl Hashable<PoseidonState<bn256::Fr>> for bn256::Fr {\n   282\t    fn to_input(&self) -> Vec<bn256::Fr> {\n   283\t        vec![*self]\n   284\t    }\n   285\t\n   286\t    fn to_bytes(&self) -> Vec<u8> {\n   287\t        self.to_bytes().to_vec()\n   288\t    }\n   289\t\n   290\t    fn read(buffer: &mut impl Read) -> io::Result<Self> {\n   291\t        let mut bytes = <Self as PrimeField>::Repr::default();\n   292\t\n   293\t        buffer.read_exact(bytes.as_mut())?;\n   294\t\n   295\t        Option::from(Self::from_repr(bytes))\n   296\t            .ok_or_else(|| io::Error::other(\"Invalid BN256 scalar encoding in proof\"))\n   297\t    }\n   298\t}\n   299\t\n   300\t#[cfg(feature = \"dev-curves\")]\n   301\timpl Sampleable<PoseidonState<bn256::Fr>> for bn256::Fr {\n   302\t    fn sample(out: bn256::Fr) -> Self {\n   303\t        out\n   304\t    }\n   305\t}\n   306\t\n   307\t#[cfg(test)]\n   308\tmod tests {\n   309\t    use rand::SeedableRng;\n   310\t    use rand_chacha::ChaCha12Rng;\n   311\t\n   312\t    use super::*;\n   313\t    use crate::hash::poseidon::permutation_cpu;\n   314\t\n   315\t    // A version of Poseidon's permutation, without round skips. Has been tested\n   316\t    // against the previous version of Poseidon (replaced since Merge request #521).\n   317\t    fn permutation_cpu_raw<F: PoseidonField>(state: &mut [F]) {\n   318\t        for (x, k0) in state.iter_mut().zip(F::ROUND_CONSTANTS[0]) {\n   319\t            *x += k0;\n   320\t        }\n   321\t        for round_index in 0..NB_FULL_ROUNDS / 2 {\n   322\t            full_round_cpu(round_index, state);\n   323\t        }\n   324\t        for round_index in (NB_FULL_ROUNDS / 2..).take(NB_PARTIAL_ROUNDS) {\n   325\t            partial_round_cpu_raw(round_index, state);\n   326\t        }\n   327\t        for round_index in (NB_FULL_ROUNDS / 2 + NB_PARTIAL_ROUNDS..).take(NB_FULL_ROUNDS / 2) {\n   328\t            full_round_cpu(round_index, state);\n   329\t        }\n   330\t    }\n   331\t    // Tests the performances of the cpu version of Poseidon. In debug mode, also\n   332\t    // tests the consistency between the version with and without round skips.\n   333\t    fn consistency_cpu<F: PoseidonField + ff::FromUniformBytes<64>>(nb_samples: usize) {\n   334\t        println!(\n   335\t            \">> Testing the consistency between the two cpu implementations of the permutation ({NB_SKIPS_CPU} round skips VS no round skips).\"\n   336\t        );\n   337\t\n   338\t        let pre_computed = PreComputedRoundCPU::init();\n   339\t        let mut rng = ChaCha12Rng::seed_from_u64(0xf007ba11);\n   340\t        (0..nb_samples)\n   341\t            .for_each(|_| {\n   342\t                let input: [F; WIDTH] =\n   343\t                    core::array::from_fn(|_| F::random(&mut rng));\n   344\t                let mut res1 = input;\n   345\t                let mut res2 = input;\n   346\t                permutation_cpu_raw(&mut res1);\n   347\t                permutation_cpu(&pre_computed, &mut res2);\n   348\t                if res1 != res2 {\n   349\t                    panic!(\"=> Inconsistencies between the cpu implementations of the permutations.\\n\\nOn input x = {:?},\\n\\npermutation_cpu_no_skip(x) = {:?}\\n\\npermutation_cpu_with_skips(x) = {:?}\\n\", input, res1, res2)\n   350\t                }\n   351\t            });\n   352\t        println!(\"=> No internal inconsistency found.\")\n   353\t    }\n   354\t\n   355\t    #[test]\n   356\t    fn cpu_test() {\n   357\t        // Testing cpu performances. In debug mode, also tests the consistency between\n   358\t        // the optimised and non-optimised cpu implementations of the permutation.\n   359\t        consistency_cpu::<midnight_curves::Fq>(1);\n   360\t    }\n   361\t}\n","exit_code":0,"status":"completed"}}
