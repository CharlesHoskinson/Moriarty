$repr_size:expr) => {\n   231\t        impl CircuitField for $field {\n   232\t            const NUM_BYTES: usize = $repr_size;\n   233\t            type Bytes = [u8; $repr_size];\n   234\t\n   235\t            fn to_biguint(&self) -> BigUint {\n   340\t        EmbeddedFr::from_le_bytes(&val.as_le_bytes()).ok_or(())\n   341\t    }\n   342\t}\n   343\t\n   344\timpl Fr {\n   345\t    /// Interpret a little-endiang byte-string as an [Fr].\n   346\t    pub fn from_le_bytes(bytes: &[u8]) -> Option<Self> {\n   347\t        let mut repr = [0u8; FR_BYTES];\n   348\t        if bytes.len() <= repr.len() {\n   349\t            repr[..bytes.len()].copy_from_slice(bytes)\n   350\t        } else {\n   351\t            return None;\n   352\t        }\n   353\t        outer::Scalar::from_repr(repr).map(Fr).into()\n   354\t    }\n   355\t\n   356\t    /// Initialize an [Fr] from arbitrary 64 bytes (little-endian)\n   357\t    /// ensuring the result falls into the space by taking modulo.\n   358\t    pub fn from_uniform_bytes(bytes: &[u8; 64]) -> Self {\n   359\t        Fr(outer::Scalar::from_uniform_bytes(bytes))\n   360\t    }\n   361\t\n   362\t    /// Output an [Fr] as a little-endian bytes-string\n   363\t    ///\n   364\t    /// # Examples\n17:use super::{sbox, PoseidonField, NB_SKIPS_CPU};\n20:    NB_SKIPS_CIRCUIT,\n23:/// Maximal number of partial-round skips performed during Poseidon.\n24:pub(crate) const NB_SKIPS_MAX: usize = if NB_SKIPS_CIRCUIT < NB_SKIPS_CPU {\n25:    NB_SKIPS_CPU\n27:    NB_SKIPS_CIRCUIT\n31:type RoundContantsCPU<F> = [[F; WIDTH + NB_SKIPS_CPU]; NB_PARTIAL_ROUNDS / (1 + NB_SKIPS_CPU)];\n34:    [[F; WIDTH + NB_SKIPS_CIRCUIT]; NB_PARTIAL_ROUNDS / (1 + NB_SKIPS_CIRCUIT)];\n44:/// Note: the size of the array are overapproximated by using `NB_SKIPS_MAX` to\n45:/// avoid having to deal with different types for `NB_SKIPS_CPU` and\n46:/// `NB_SKIPS_CIRCUIT`. This will be the case for all similar types that are\n50:    var_coeffs: [F; WIDTH + NB_SKIPS_MAX], // Length WIDTH + number of round skips.\n51:    const_coeffs: [F; WIDTH * (1 + NB_SKIPS_MAX)], // Length 1 + number of round skips.\n66:    ids: [RoundVarId<F>; WIDTH + 1 + NB_SKIPS_MAX], // Real length `WIDTH + 1 + self.nb_skips`.\n71:/// self.partial_round_id.nb_skips]; NB_FULL_ROUNDS + NB_PARTIAL_ROUNDS / (1 +\n72:/// self.partial_round_id.nb_skips)]`.\n76:    pub(crate) partial_round_id: RoundId<F>,\n83:    pub(crate) partial_round_id: RoundId<F>,\n99:            var_coeffs: [F::ZERO; WIDTH + NB_SKIPS_MAX],\n100:            const_coeffs: [F::ZERO; WIDTH * (1 + NB_SKIPS_MAX)],\n115:    fn eval_constants(&self, instances: &[[F; WIDTH]]) -> F {\n126:    fn eval_vars(\n228:    fn eval_constants(&self, round: usize, arg: &mut [F]) {\n242:    /// the parameter `NB_SKIPS` so that it can be used as array's length).\n243:    pub(crate) fn eval<const NB_SKIPS: usize>(\n247:    ) -> [F; NB_SKIPS] {\n248:        let mut pow_instances = [F::ZERO; NB_SKIPS];\n252:            .chain(std::iter::repeat_n(&F::ZERO, NB_SKIPS))\n","exit_code":0,"status":"completed"}}
