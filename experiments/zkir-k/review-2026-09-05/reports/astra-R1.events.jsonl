{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -u - <<'PY'\nimport sys,json,subprocess,os,re,random\nfrom pathlib import Path\nfrom pyk.ktool.krun import KRun\nfrom pyk.kast.inner import KApply,KSort,KToken,KSequence\nfrom pyk.kast.prelude.kint import intToken as I\nfrom pyk.kore.parser import KoreParser\nr=KRun(Path('experiments/zkir-k/semantics/zkir-test-kompiled'))\ndef K(s,*a):\n h=[x for x in r.definition.symbols if x==s or x.startswith(s+'(') or x.startswith(s+'_')];return KApply(s if s in h else h[0],list(a))\ndef ev(t):\n q=r.kast_to_kore(KApply('<k>',[KSequence([t])]),KSort('KCell'))\n p=subprocess.run([str(r.definition_dir/'interpreter'),'/dev/stdin','-1','/dev/stdout'],input=q.text,text=True,capture_output=True,timeout=30);assert p.returncode==0,p.stderr\n return r.kore_to_kast(KoreParser(p.stdout).pattern()).args[0].items[0]\ndef L(xs):\n t=KApply('.List')\n for x in reversed(xs):t=KApply('_List_',[KApply('ListItem',[I(x)]),t])\n return t\nbase={'version':{'major':3,'minor':0},'outputs':[],'do_communications_commitment':False}\ndef oracle(instrs,values):\n p=base|{'inputs':[{'name':'%x'+str(i),'type':'Scalar<BLS12-381>'} for i in range(len(values))],'instructions':instrs}\n rd,wr=os.pipe();os.write(wr,json.dumps(p).encode());os.close(wr)\n o=subprocess.run(['/home/charl/Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle',f'/dev/fd/{rd}','/dev/stdin'],pass_fds=(rd,),input=json.dumps({'inputs':list(map(str,values)),'binding_input':'0'}),capture_output=True,text=True,timeout=30);os.close(rd);assert o.returncode==0,o.stderr\n return json.loads(o.stdout)['memory']\nR=int(ev(K('#r')).token)\nfor n in [0,1,2,3,4,5,8,9,16]:\n xs=[(R-1-i*i)%R for i in range(n)];names=['%x'+str(i) for i in range(n)]\n m=oracle([{'op':op,'inputs':names,'output':out} for op,out in [('transient_hash','%h'),('hash_to_curve','%p')]],xs)\n h=int(ev(K('poseidonHash',L(xs))).token); p=ev(K('hashToCurve',L(xs)))\n assert str(h)==m['%h']['encoded'][0];assert [x.token for x in p.args]==m['%p']['encoded'];print('Poseidon/HTC boundary',n,'PASS')\nfor n in [0,134,135,136,137,271,272]:\n b=bytes(i%256 for i in range(n));full=n//31;xs=([int.from_bytes(b[31*full:],'little')] if n%31 else [])+[int.from_bytes(b[31*i:31*(i+1)],'little') for i in reversed(range(full))]\n m=oracle([{'op':'keccak256','alignment':[{'tag':'atom','value':{'tag':'bytes','length':n}}],'inputs':['%x'+str(i) for i in range(len(xs))],'output':'%h'}],xs)\n kb=KToken('b\\\"'+''.join('\\\\\\\\x%02x'%x for x in b)+'\\\"',KSort('Bytes'))\n actual=ev(K('encodeValue',K('bytes32V',K('keccak256Bytes',kb))))\n assert actual==ev(L(list(map(int,m['%h']['encoded']))));print('Keccak boundary',n,'PASS')\nfor key,p in re.findall(r'rule #(\\\\w+)\\\\s*=> (\\\\d+)',Path('experiments/zkir-k/semantics/zkir-field.k').read_text()):\n p=int(p);rng=random.Random(19);vals=[0,1,4,p-1,p,p+1,-1]+[rng.randrange(p) for _ in range(5)]\n for a in vals:\n  o=ev(K('fsqrt',I(a),I(p)));leg=pow(a%p,(p-1)//2,p)\n  if o.args:assert int(o.args[0].token)**2%p==a%p\n  else:assert leg==p-1\n print('sqrt',key,len(vals),'PASS')\nfor typ,xs in [('JubjubScalar',[]),('JubjubScalar',[0,0]),('Secp256k1Point',[1]),('Secp256r1Point',[1])]:\n print('K helper',typ,xs,r.pretty_print(ev(K('decodeValue',L(xs),K(typ)))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
