    /// The input may have fewer bits than `Self::NUM_BITS`; missing high bits\n   141\t    /// are treated as zero.\n   142\t    ///\n   143\t    /// Returns `None` if `bits.len() > Self::NUM_BITS`, or if the encoded value\n   144\t    /// is not in the canonical range `[0, modulus)`.\n   145\t    fn try_from_bits_le(bits: &[bool]) -> Option<Self> {\n   146\t        if bits.len() as u32 > Self::NUM_BITS {\n   147\t            return None;\n   148\t        }\n   149\t        let mut bytes = vec![0u8; Self::NUM_BYTES];\n   150\t        for (i, chunk) in bits.chunks(8).enumerate() {\n   151\t            bytes[i] = chunk\n   152\t                .iter()\n   153\t                .enumerate()\n   154\t                .fold(0u8, |acc, (j, b)| acc + if *b { 1 << j } else { 0 });\n   155\t        }\n   156\t        Self::from_bytes_le(&bytes)\n   157\t    }\n   158\t\n   159\t    /// Creates a field element from a little-endian bitstring.\n   160\t    ///\n   161\t    /// The input may have fewer bits than `Self::NUM_BITS`; missing high bits\n   162\t    /// are treated as zero.\n   163\t    ///\n   164\t    /// # Panics\n   165\t    ///\n   166\t    /// If `bits.len() > Self::NUM_BITS`, or if the encoded value is not in the\n   167\t    /// canonical range `[0, modulus)`. Use [Self::try_from_bits_le] for a\n   168\t    /// fallible version.\n   169\t    fn from_bits_le(bits: &[bool]) -> Self {\n   170\t        Self::try_from_bits_le(bits).expect(\"bits do not encode a canonical field element\")\n   171\t    }\n   172\t\n   173\t    /// All the bits of the field representation, in little-endian order. The\n   174\t    /// output has length `8 * Self::NUM_BYTES`.\n   175\t    fn all_bits_le(&self) -> Vec<bool> {\n   176\t        self.to_bytes_le()\n   177\t            .as_ref()\n   178\t            .iter()\n   179\t            .flat_map(|byte| (0..8).map(move |j| byte & (1 << j) != 0))\n   180\t            .collect()\n   181\t    }\n   182\t}\n   183\t\n   184\t// Macros for