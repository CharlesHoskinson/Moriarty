{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-hash.k'","aggregated_output":"     1\t// Hash primitives used by ZKIR v3, computed concretely.\n     2\t//\n     3\t//   poseidonHash(List)      transient_hash: Poseidon sponge over the BLS12-381\n     4\t//                           scalar field, t = 3, rate 2, R_F = 8, R_P = 60, with\n     5\t//                           the fixed-length domain (capacity element = input\n     6\t//                           length). midnight-circuits 7.2.4 hash/poseidon/*.\n     7\t//   hashToCurve(List)       transient_crypto::hash::hash_to_curve: variable-length\n     8\t//                           Poseidon sponge (capacity 2^64, length padding),\n     9\t//                           two squeezes, Shallue-van de Woestijne map to the\n    10\t//                           Weierstrass form of Jubjub, conversion to Edwards,\n    11\t//                           cofactor clearing, sum of the two points.\n    12\t//   sha256(Bytes)           FIPS 180-4.\n    13\t//   keccak256(Bytes)        Keccak-f[1600], rate 1088, pad 0x01 .. 0x80 (pre-NIST).\n    14\t//\n    15\t// The Rust Poseidon CPU code folds partial rounds in pairs (\"round skips\"); that\n    16\t// is an algebraic rewrite of the plain round function implemented here, and the\n    17\t// differential tests against the crate confirm the outputs agree.\n    18\trequires \"zkir-field.k\"\n    19\trequires \"zkir-curves.k\"\n    20\trequires \"zkir-constants.k\"\n    21\t\n    22\tmodule ZKIR-HASH\n    23\t  imports ZKIR-FIELD\n    24\t  imports ZKIR-CURVES\n    25\t  imports ZKIR-CONSTANTS\n    26\t  imports BYTES\n    27\t  imports LIST\n    28\t\n    29\t  // ---------------------------------------------------------------------------\n    30\t  // Poseidon permutation on a 3-element state (s0, s1, s2), all mod r.\n    31\t  syntax PState ::= ps(Int, Int, Int)\n    32\t\n    33\t  syntax Int ::= sbox(Int) [function, total]\n    34\t  rule sbox(X) => fmul(fsq(fsq(X, #r), #r), X, #r)\n    35\t\n    36\t  // new[i] = rc[i] + sum_j MDS[i][j] * s[j]\n    37\t  syntax PState ::= linear(PState, Int) [function, total]   // (state, round index for RC[round+1]; -1 = zero constants)\n    38\t  rule linear(ps(S0, S1, S2), R) => ps(\n    39\t      fadd(#rc(R, 0), fadd(fadd(fmul(poseidonMDS(0, 0), S0, #r), fmul(poseidonMDS(0, 1), S1, #r), #r), fmul(poseidonMDS(0, 2), S2, #r), #r), #r),\n    40\t      fadd(#rc(R, 1), fadd(fadd(fmul(poseidonMDS(1, 0), S0, #r), fmul(poseidonMDS(1, 1), S1, #r), #r), fmul(poseidonMDS(1, 2), S2, #r), #r), #r),\n    41\t      fadd(#rc(R, 2), fadd(fadd(fmul(poseidonMDS(2, 0), S0, #r), fmul(poseidonMDS(2, 1), S1, #r), #r), fmul(poseidonMDS(2, 2), S2, #r), #r), #r))\n    42\t  syntax Int ::= #rc(Int, Int) [function, total]\n    43\t  rule #rc(R, J) => poseidonRC(R +Int 1, J) requires R >=Int 0 andBool R <Int 67\n    44\t  rule #rc(_, _) => 0 [owise]\n    45\t\n    46\t  syntax PState ::= fullRound(PState, Int) [function, total]\n    47\t  rule fullRound(ps(S0, S1, S2), R) => linear(ps(sbox(S0), sbox(S1), sbox(S2)), R)\n    48\t  syntax PState ::= partialRound(PState, Int) [function, total]\n    49\t  rule partialRound(ps(S0, S1, S2), R) => linear(ps(S0, S1, sbox(S2)), R)\n    50\t\n    51\t  syntax PState ::= permute(PState) [function, total]\n    52\t  rule permute(ps(S0, S1, S2)) => #rounds(ps(fadd(S0, poseidonRC(0, 0), #r), fadd(S1, poseidonRC(0, 1), #r), fadd(S2, poseidonRC(0, 2), #r)), 0)\n    53\t  syntax PState ::= #rounds(PState, Int) [function, total]\n    54\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R <Int 4\n    55\t  rule #rounds(S, R) => #rounds(partialRound(S, R), R +Int 1) requires R >=Int 4 andBool R <Int 64\n    56\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R >=Int 64 andBool R <Int 68\n    57\t  rule #rounds(S, R) => S requires R >=Int 68\n    58\t\n    59\t  // Absorb a queue of elements in chunks of two, permuting after each chunk.\n    60\t  syntax PState ::= absorbAll(PState, List) [function, total]\n    61\t  rule absorbAll(S, .List) => S\n    62\t  rule absorbAll(ps(S0, S1, S2), ListItem(A) ListItem(B) Rest) => absorbAll(permute(ps(fadd(S0, A, #r), fadd(S1, B, #r), S2)), Rest)\n    63\t  rule absorbAll(ps(S0, S1, S2), ListItem(A)) => permute(ps(fadd(S0, A, #r), S1, S2))\n    64\t\n    65\t  // Fixed-length Poseidon hash (transient_hash).\n    66\t  syntax Int ::= poseidonHash(List) [function, total]\n    67\t  rule poseidonHash(Xs) => #ps0(absorbAll(ps(0, 0, size(Xs) modInt #r), Xs))\n    68\t  syntax Int ::= #ps0(PState) [function, total]\n    69\t  rule #ps0(ps(S0, _, _)) => S0\n    70\t  syntax Int ::= #ps1(PState) [function, total]\n    71\t  rule #ps1(ps(_, S1, _)) => S1\n    72\t\n    73\t  // transient_commit(values, opening) = poseidonHash([opening] ++ values)\n    74\t  syntax Int ::= transientCommit(List, Int) [function, total]\n    75\t  rule transientCommit(Vs, Rand) => poseidonHash(ListItem(Rand) Vs)\n    76\t\n    77\t  // Variable-length sponge used by hash_to_curve: capacity 2^64, the input\n    78\t  // length appended as padding, then two squeezes (register 0 and 1).\n    79\t  syntax PState ::= varLenSponge(List) [function, total]\n    80\t  rule varLenSponge(Xs) => absorbAll(ps(0, 0, 18446744073709551616), Xs ListItem(size(Xs)))\n    81\t\n    82\t  // ---------------------------------------------------------------------------\n    83\t  // Hash to curve (Jubjub subgroup).\n    84\t  syntax Point ::= hashToCurve(List) [function, total]\n    85\t  rule hashToCurve(Xs) => #htc(varLenSponge(Xs))\n    86\t  syntax Point ::= #htc(PState) [function, total]\n    87\t  rule #htc(ps(X1, X2, _)) => ecAdd(#jubjub, mapToCurve(X1), mapToCurve(X2))\n    88\t\n    89\t  // SVDW constants (mtc_params.rs), all mod r\n    90\t  syntax Int ::= \"#svdwC1\" [function, total]   // g(Z)\n    91\t  rule #svdwC1 => #g(#svdwZ)\n    92\t  syntax Int ::= #g(Int) [function, total]\n    93\t  rule #g(X) => fadd(fadd(fmul(fmul(X, X, #r), X, #r), fmul(#svdwA, X, #r), #r), #svdwB, #r)\n    94\t  syntax Int ::= \"#svdwC2\" [function, total]   // -Z / 2\n    95\t  rule #svdwC2 => fneg(fmul(#svdwZ, finv(2, #r), #r), #r)\n    96\t  syntax Int ::= \"#svdwC3\" [function, total]   // sqrt(-g(Z) * (3 Z^2 + 4 A)), even root\n    97\t  rule #svdwC3 => #evenRoot(fsqrt(fneg(fmul(#svdwC1, fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r))\n    98\t  syntax Int ::= #evenRoot(SqrtResult) [function, total]\n    99\t  rule #evenRoot(sqrtOk(S)) => S requires S modInt 2 ==Int 0\n   100\t  rule #evenRoot(sqrtOk(S)) => fneg(S, #r) requires S modInt 2 ==Int 1\n   101\t  rule #evenRoot(noSqrt()) => 0\n   102\t  syntax Int ::= \"#svdwC4\" [function, total]   // -4 g(Z) / (3 Z^2 + 4 A)\n   103\t  rule #svdwC4 => fneg(fmul(fmul(4, #svdwC1, #r), finv(fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r)\n   104\t\n   105\t  syntax Point ::= mapToCurve(Int) [function, total]\n   106\t  rule mapToCurve(U) => ecMul(#jubjub, #edFromMont(#wToMont(#svdw(U))), 8)\n   107\t\n   108\t  // svdw_map_to_curve: returns pt(x, y) on the Weierstrass form\n   109\t  syntax Point ::= #svdw(Int) [function, total]\n   110\t  rule #svdw(U) => #svdw1(U, fmul(fsq(U, #r), #svdwC1, #r))\n   111\t  syntax Point ::= #svdw1(Int, Int) [function, total]   // (u, tv1 = u^2 c1)\n   112\t  rule #svdw1(U, T) => #svdw2(U, fadd(1, T, #r), fsub(1, T, #r))\n   113\t  syntax Point ::= #svdw2(Int, Int, Int) [function, total]   // (u, tv2 = 1 + t, tv1 = 1 - t)\n   114\t  rule #svdw2(U, TV2, TV1) => #svdw3(U, TV2, TV1, finv(fmul(TV1, TV2, #r), #r))\n   115\t  syntax Point ::= #svdw3(Int, Int, Int, Int) [function, total]   // (u, tv2, tv1, tv3 = inv(tv1 tv2))\n   116\t  rule #svdw3(U, TV2, TV1, TV3) => #svdw4(U, TV2, TV3, fmul(fmul(fmul(U, TV1, #r), TV3, #r), #svdwC3, #r))\n   117\t  syntax Point ::= #svdw4(Int, Int, Int, Int) [function, total]   // (u, tv2, tv3, tv4)\n   118\t  rule #svdw4(U, TV2, TV3, TV4) => #svdwPick(U,\n   119\t      fsub(#svdwC2, TV4, #r), fadd(#svdwC2, TV4, #r),\n   120\t      fadd(fmul(fsq(fmul(fsq(TV2, #r), TV3, #r), #r), #svdwC4, #r), #svdwZ, #r))\n   121\t  // e1 = g(x1) residue; e2 = g(x2) residue and not e1; x = e1 ? x1 : e2 ? x2 : x3\n   122\t  syntax Point ::= #svdwPick(Int, Int, Int, Int) [function, total]\n   123\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X1) requires notBool isQuadraticNonResidue(#g(X1), #r)\n   124\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X2) requires isQuadraticNonResidue(#g(X1), #r) andBool notBool isQuadraticNonResidue(#g(X2), #r)\n   125\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X3) requires isQuadraticNonResidue(#g(X1), #r) andBool isQuadraticNonResidue(#g(X2), #r)\n   126\t  syntax Point ::= #svdwY(Int, Int) [function, total]\n   127\t  rule #svdwY(U, X) => #svdwSign(U, X, fsqrt(#g(X), #r))\n   128\t  syntax Point ::= #svdwSign(Int, Int, SqrtResult) [function, total]\n   129\t  rule #svdwSign(U, X, sqrtOk(Y)) => pt(X, Y) requires (U modInt 2) ==Int (Y modInt 2)\n   130\t  rule #svdwSign(U, X, sqrtOk(Y)) => pt(X, fneg(Y, #r)) requires (U modInt 2) =/=Int (Y modInt 2)\n   131\t  rule #svdwSign(_, X, noSqrt()) => pt(X, 0)   // unreachable: g(x) is a residue by construction\n   132\t\n   133\t  // weierstrass_to_montgomery: x' = x K - J/3, y' = y K\n   134\t  syntax Point ::= #wToMont(Point) [function, total]\n   135\t  rule #wToMont(pt(X, Y)) => pt(fsub(fmul(X, #montK, #r), fmul(#montJ, finv(3, #r), #r), #r), fmul(Y, #montK, #r))\n   136\t  rule #wToMont(inf()) => inf()\n   137\t  // montgomery_to_edwards: tv1 = x + 1; tv2 = inv(tv1 y); x' = tv2 tv1 x; y' = tv2 y (x - 1); y' = 1 if tv2 = 0\n   138\t  syntax Point ::= #edFromMont(Point) [function, total]\n   139\t  rule #edFromMont(pt(X, Y)) => #edFromMont2(X, Y, fadd(X, 1, #r), finv(fmul(fadd(X, 1, #r), Y, #r), #r))\n   140\t  rule #edFromMont(inf()) => pt(0, 1)\n   141\t  syntax Point ::= #edFromMont2(Int, Int, Int, Int) [function, total]\n   142\t  rule #edFromMont2(X, Y, TV1, TV2) => pt(fmul(fmul(TV2, TV1, #r), X, #r), fmul(fmul(TV2, Y, #r), fsub(X, 1, #r), #r)) requires TV2 =/=Int 0\n   143\t  rule #edFromMont2(X, Y, TV1, TV2) => pt(fmul(fmul(TV2, TV1, #r), X, #r), 1) requires TV2 ==Int 0\n   144\t\n   145\t  // ---------------------------------------------------------------------------\n   146\t  // SHA-256\n   147\t  syntax Int ::= \"#m32\" [function, total]\n   148\t  rule #m32 => 4294967295\n   149\t  syntax Int ::= rotr32(Int, Int) [function, total]\n   150\t  rule rotr32(X, N) => ((X >>Int N) |Int (X <<Int (32 -Int N))) &Int #m32\n   151\t  syntax Int ::= add32(Int, Int) [function, total]\n   152\t  rule add32(A, B) => (A +Int B) &Int #m32\n   153\t\n   154\t  syntax List ::= \"#shaKs\" [function, total]\n   155\t  rule #shaKs => ListItem(1116352408) ListItem(1899447441) ListItem(3049323471) ListItem(3921009573) ListItem(961987163) ListItem(1508970993) ListItem(2453635748) ListItem(2870763221) ListItem(3624381080) ListItem(310598401) ListItem(607225278) ListItem(1426881987) ListItem(1925078388) ListItem(2162078206) ListItem(2614888103) ListItem(3248222580) ListItem(3835390401) ListItem(4022224774) ListItem(264347078) ListItem(604807628) ListItem(770255983) ListItem(1249150122) ListItem(1555081692) ListItem(1996064986) ListItem(2554220882) ListItem(2821834349) ListItem(2952996808) ListItem(3210313671) ListItem(3336571891) ListItem(3584528711) ListItem(113926993) ListItem(338241895) ListItem(666307205) ListItem(773529912) ListItem(1294757372) ListItem(1396182291) ListItem(1695183700) ListItem(1986661051) ListItem(2177026350) ListItem(2456956037) ListItem(2730485921) ListItem(2820302411) ListItem(3259730800) ListItem(3345764771) ListItem(3516065817) ListItem(3600352804) ListItem(4094571909) ListItem(275423344) ListItem(430227734) ListItem(506948616) ListItem(659060556) ListItem(883997877) ListItem(958139571) ListItem(1322822218) ListItem(1537002063) ListItem(1747873779) ListItem(1955562222) ListItem(2024104815) ListItem(2227730452) ListItem(2361852424) ListItem(2428436474) ListItem(2756734187) ListItem(3204031479) ListItem(3329325298)\n   156\t  syntax Int ::= shaK(Int) [function, total]\n   157\t  rule shaK(I) => {#shaKs[I]}:>Int\n   158\t\n   159\t  syntax Bytes ::= sha256Bytes(Bytes) [function, total]\n   160\t  rule sha256Bytes(M) => #shaBlocks(#shaPad(M), 0,\n   161\t      ListItem(1779033703) ListItem(3144134277) ListItem(1013904242) ListItem(2773480762)\n   162\t      ListItem(1359893119) ListItem(2600822924) ListItem(528734635) ListItem(1541459225))\n   163\t  syntax Bytes ::= #shaPad(Bytes) [function, total]\n   164\t  rule #shaPad(M) => padRightBytes(M +Bytes Int2Bytes(1, 128, BE), ((lengthBytes(M) +Int 9 +Int 63) /Int 64) *Int 64 -Int 8, 0) +Bytes Int2Bytes(8, lengthBytes(M) *Int 8, BE)\n   165\t  syntax Bytes ::= #shaBlocks(Bytes, Int, List) [function, total]   // (padded, offset, H)\n   166\t  rule #shaBlocks(P, Off, H) => #shaOut(H) requires Off >=Int lengthBytes(P)\n   167\t  rule #shaBlocks(P, Off, H) => #shaBlocks(P, Off +Int 64, #shaCompress(#shaSchedule(substrBytes(P, Off, Off +Int 64), 0, .List), H))\n   168\t    requires Off <Int lengthBytes(P)\n   169\t  syntax Bytes ::= #shaOut(List) [function, total]\n   170\t  rule #shaOut(.List) => .Bytes\n   171\t  rule #shaOut(ListItem(W) Ws) => Int2Bytes(4, W, BE) +Bytes #shaOut(Ws)\n   172\t\n   173\t  // message schedule W[0..63]\n   174\t  syntax List ::= #shaSchedule(Bytes, Int, List) [function, total]\n   175\t  rule #shaSchedule(B, T, W) => #shaSchedule(B, T +Int 1, W ListItem(Bytes2Int(substrBytes(B, 4 *Int T, 4 *Int T +Int 4), BE, Unsigned)))\n   176\t    requires T <Int 16\n   177\t  rule #shaSchedule(B, T, W) => #shaSchedule(B, T +Int 1, W ListItem(add32(add32(#s1({W[T -Int 2]}:>Int), {W[T -Int 7]}:>Int), add32(#s0({W[T -Int 15]}:>Int), {W[T -Int 16]}:>Int))))\n   178\t    requires T >=Int 16 andBool T <Int 64\n   179\t  rule #shaSchedule(_, T, W) => W requires T >=Int 64\n   180\t  syntax Int ::= #s0(Int) [function, total]\n   181\t  rule #s0(X) => rotr32(X, 7) xorInt rotr32(X, 18) xorInt (X >>Int 3)\n   182\t  syntax Int ::= #s1(Int) [function, total]\n   183\t  rule #s1(X) => rotr32(X, 17) xorInt rotr32(X, 19) xorInt (X >>Int 10)\n   184\t  syntax Int ::= #S0(Int) [function, total]\n   185\t  rule #S0(X) => rotr32(X, 2) xorInt rotr32(X, 13) xorInt rotr32(X, 22)\n   186\t  syntax Int ::= #S1(Int) [function, total]\n   187\t  rule #S1(X) => rotr32(X, 6) xorInt rotr32(X, 11) xorInt rotr32(X, 25)\n   188\t\n   189\t  syntax List ::= #shaCompress(List, List) [function, total]   // (W, H) -> H'\n   190\t  rule #shaCompress(W, H) => #shaAddH(#shaRound(W, 0, H), H)\n   191\t  // working variables carried as a List [a,b,c,d,e,f,g,h]\n   192\t  syntax List ::= #shaRound(List, Int, List) [function, total]\n   193\t  rule #shaRound(_, T, V) => V requires T >=Int 64\n   194\t  rule #shaRound(W, T, ListItem(A) ListItem(B) ListItem(C) ListItem(D) ListItem(E) ListItem(F) ListItem(G) ListItem(HH))\n   195\t    => #shaRound(W, T +Int 1, #shaNext(A, B, C, D, E, F, G,\n   196\t         add32(add32(add32(add32(HH, #S1(E)), (E &Int F) xorInt ((E xorInt #m32) &Int G)), shaK(T)), {W[T]}:>Int),\n   197\t         add32(#S0(A), (A &Int B) xorInt (A &Int C) xorInt (B &Int C))))\n   198\t    requires T <Int 64\n   199\t  syntax List ::= #shaNext(Int, Int, Int, Int, Int, Int, Int, Int, Int) [function, total]   // (a..g, T1, T2)\n   200\t  rule #shaNext(A, B, C, D, E, F, G, T1, T2)\n   201\t    => ListItem(add32(T1, T2)) ListItem(A) ListItem(B) ListItem(C) ListItem(add32(D, T1)) ListItem(E) ListItem(F) ListItem(G)\n   202\t  syntax List ::= #shaAddH(List, List) [function, total]\n   203\t  rule #shaAddH(.List, .List) => .List\n   204\t  rule #shaAddH(ListItem(X) Xs, ListItem(Y) Ys) => ListItem(add32(X, Y)) #shaAddH(Xs, Ys)\n   205\t  rule #shaAddH(_, _) => .List [owise]\n   206\t\n   207\t  // ---------------------------------------------------------------------------\n   208\t  // Keccak-256. State: List of 25 lanes, index x + 5*y, 64-bit little-endian lanes.\n   209\t  syntax Int ::= \"#m64\" [function, total]\n   210\t  rule #m64 => 18446744073709551615\n   211\t  syntax Int ::= rotl64(Int, Int) [function, total]\n   212\t  rule rotl64(X, 0) => X\n   213\t  rule rotl64(X, N) => ((X <<Int N) |Int (X >>Int (64 -Int N))) &Int #m64 requires N >Int 0\n   214\t\n   215\t  syntax List ::= \"#keccakRCs\" [function, total]\n   216\t  rule #keccakRCs => ListItem(1) ListItem(32898) ListItem(9223372036854808714) ListItem(9223372039002292224) ListItem(32907) ListItem(2147483649) ListItem(9223372039002292353) ListItem(9223372036854808585) ListItem(138) ListItem(136) ListItem(2147516425) ListItem(2147483658) ListItem(2147516555) ListItem(9223372036854775947) ListItem(9223372036854808713) ListItem(9223372036854808579) ListItem(9223372036854808578) ListItem(9223372036854775936) ListItem(32778) ListItem(9223372039002259466) ListItem(9223372039002292353) ListItem(9223372036854808704) ListItem(2147483649) ListItem(9223372039002292232)\n   217\t  syntax Int ::= keccakRC(Int) [function, total]\n   218\t  rule keccakRC(I) => {#keccakRCs[I]}:>Int\n   219\t  syntax List ::= \"#keccakRots\" [function, total]\n   220\t  rule #keccakRots => ListItem(0) ListItem(1) ListItem(62) ListItem(28) ListItem(27) ListItem(36) ListItem(44) ListItem(6) ListItem(55) ListItem(20) ListItem(3) ListItem(10) ListItem(43) ListItem(25) ListItem(39) ListItem(41) ListItem(45) ListItem(15) ListItem(21) ListItem(8) ListItem(18) ListItem(2) ListItem(61) ListItem(56) ListItem(14)\n   221\t  syntax Int ::= keccakRot(Int) [function, total]   // rotation offset for lane index x + 5y\n   222\t  rule keccakRot(I) => {#keccakRots[I]}:>Int\n   223\t\n   224\t  syntax Int ::= lane(List, Int, Int) [function, total]   // (state, x, y)\n   225\t  rule lane(S, X, Y) => {S[(X modInt 5) +Int 5 *Int (Y modInt 5)]}:>Int\n   226\t\n   227\t  syntax Bytes ::= keccak256Bytes(Bytes) [function, total]\n   228\t  rule keccak256Bytes(M) => substrBytes(#kOut(#kAbsorb(#kPad(M), 0, #kZero(25)), 0, .Bytes), 0, 32)\n   229\t  syntax Bytes ::= #kPad(Bytes) [function, total]\n   230\t  rule #kPad(M) => #kPadEnd(padRightBytes(M +Bytes Int2Bytes(1, 1, BE), ((lengthBytes(M) +Int 1 +Int 135) /Int 136) *Int 136, 0))\n   231\t  syntax Bytes ::= #kPadEnd(Bytes) [function, total]\n   232\t  rule #kPadEnd(P) => replaceAtBytes(P, lengthBytes(P) -Int 1, Int2Bytes(1, P[lengthBytes(P) -Int 1] |Int 128, BE))\n   233\t  syntax List ::= #kZero(Int) [function, total]\n   234\t  rule #kZero(0) => .List\n   235\t  rule #kZero(N) => ListItem(0) #kZero(N -Int 1) requires N >Int 0\n   236\t  rule #kZero(N) => .List requires N <Int 0\n   237\t\n   238\t  syntax List ::= #kAbsorb(Bytes, Int, List) [function, total]\n   239\t  rule #kAbsorb(P, Off, S) => S requires Off >=Int lengthBytes(P)\n   240\t  rule #kAbsorb(P, Off, S) => #kAbsorb(P, Off +Int 136, keccakF(#kXorBlock(S, substrBytes(P, Off, Off +Int 136), 0)))\n   241\t    requires Off <Int lengthBytes(P)\n   242\t  syntax List ::= #kXorBlock(List, Bytes, Int) [function, total]\n   243\t  rule #kXorBlock(S, B, I) => S requires I >=Int 17\n   244\t  rule #kXorBlock(S, B, I) => #kXorBlock(S[I <- ({S[I]}:>Int xorInt Bytes2Int(substrBytes(B, 8 *Int I, 8 *Int I +Int 8), LE, Unsigned))], B, I +Int 1)\n   245\t    requires I <Int 17\n   246\t  syntax Bytes ::= #kOut(List, Int, Bytes) [function, total]\n   247\t  rule #kOut(S, I, Acc) => Acc requires I >=Int 4\n   248\t  rule #kOut(S, I, Acc) => #kOut(S, I +Int 1, Acc +Bytes Int2Bytes(8, {S[I]}:>Int, LE)) requires I <Int 4\n   249\t\n   250\t  syntax List ::= keccakF(List) [function, total]\n   251\t  rule keccakF(S) => #kRounds(S, 0)\n   252\t  syntax List ::= #kRounds(List, Int) [function, total]\n   253\t  rule #kRounds(S, R) => S requires R >=Int 24\n   254\t  rule #kRounds(S, R) => #kRounds(#kIota(#kChi(#kRhoPi(#kTheta(S))), R), R +Int 1) requires R <Int 24\n   255\t\n   256\t  // theta\n   257\t  syntax List ::= #kTheta(List) [function, total]\n   258\t  rule #kTheta(S) => #kThetaApply(S, #kColumns(S, 0), 0)\n   259\t  syntax List ::= #kColumns(List, Int) [function, total]   // C[x] = xor of column x\n   260\t  rule #kColumns(_, X) => .List requires X >=Int 5\n   261\t  rule #kColumns(S, X) => ListItem(lane(S, X, 0) xorInt lane(S, X, 1) xorInt lane(S, X, 2) xorInt lane(S, X, 3) xorInt lane(S, X, 4)) #kColumns(S, X +Int 1)\n   262\t    requires X <Int 5\n   263\t  syntax List ::= #kThetaApply(List, List, Int) [function, total]\n   264\t  rule #kThetaApply(S, _, I) => S requires I >=Int 25\n   265\t  rule #kThetaApply(S, C, I) => #kThetaApply(S[I <- ({S[I]}:>Int xorInt ({C[(I +Int 4) modInt 5]}:>Int xorInt rotl64({C[(I +Int 1) modInt 5]}:>Int, 1)))], C, I +Int 1)\n   266\t    requires I <Int 25\n   267\t\n   268\t  // rho + pi: B[y, 2x+3y] = rotl(A[x, y], r[x, y])\n   269\t  syntax List ::= #kRhoPi(List) [function, total]\n   270\t  rule #kRhoPi(S) => #kRhoPiApply(S, #kZero(25), 0)\n   271\t  syntax List ::= #kRhoPiApply(List, List, Int) [function, total]\n   272\t  rule #kRhoPiApply(_, B, I) => B requires I >=Int 25\n   273\t  rule #kRhoPiApply(S, B, I) => #kRhoPiApply(S, B[((I modInt 5) *Int 0 +Int (I /Int 5)) +Int 5 *Int ((2 *Int (I modInt 5) +Int 3 *Int (I /Int 5)) modInt 5) <- rotl64({S[I]}:>Int, keccakRot(I))], I +Int 1)\n   274\t    requires I <Int 25\n   275\t\n   276\t  // chi\n   277\t  syntax List ::= #kChi(List) [function, total]\n   278\t  rule #kChi(S) => #kChiApply(S, 0)\n   279\t  syntax List ::= #kChiApply(List, Int) [function, total]\n   280\t  rule #kChiApply(_, I) => .List requires I >=Int 25\n   281\t  rule #kChiApply(S, I) => ListItem(lane(S, I modInt 5, I /Int 5) xorInt ((lane(S, I modInt 5 +Int 1, I /Int 5) xorInt #m64) &Int lane(S, I modInt 5 +Int 2, I /Int 5))) #kChiApply(S, I +Int 1)\n   282\t    requires I <Int 25\n   283\t\n   284\t  // iota\n   285\t  syntax List ::= #kIota(List, Int) [function, total]\n   286\t  rule #kIota(S, R) => S[0 <- ({S[0]}:>Int xorInt keccakRC(R))]\n   287\tendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-field.k; nl -ba experiments/zkir-k/semantics/zkir-curves.k'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-field.k; nl -ba experiments/zkir-k/semantics/zkir-curves.k'","aggregated_output":"     1\t// Prime-field arithmetic over K's arbitrary-precision Int (plan decision\n     2\t// CLM-0709). Every function takes the modulus explicitly; results are kept in\n     3\t// canonical range [0, p) with modInt (Euclidean, never negative).\n     4\t//\n     5\t// Moduli (midnight-curves 0.3.1):\n     6\t//   r      BLS12-381 scalar field = ZKIR native field = Jubjub base field\n     7\t//   rJ     Jubjub scalar field (prime-order subgroup order)\n     8\t//   k256P  secp256k1 base field, k256N its group order\n     9\t//   p256P  secp256r1 base field, p256N its group order\n    10\t//   c25519P = 2^255 - 19, c25519L = 2^252 + 27742317777372353535851937790883648493\n    11\tmodule ZKIR-FIELD\n    12\t  imports INT\n    13\t  imports BOOL\n    14\t  imports LIST\n    15\t  imports K-EQUAL\n    16\t\n    17\t  syntax Int ::= \"#r\"        [function, total]\n    18\t               | \"#rJ\"       [function, total]\n    19\t               | \"#k256P\"    [function, total]\n    20\t               | \"#k256N\"    [function, total]\n    21\t               | \"#p256P\"    [function, total]\n    22\t               | \"#p256N\"    [function, total]\n    23\t               | \"#c25519P\"  [function, total]\n    24\t               | \"#c25519L\"  [function, total]\n    25\t  rule #r       => 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    26\t  rule #rJ      => 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    27\t  rule #k256P   => 115792089237316195423570985008687907853269984665640564039457584007908834671663\n    28\t  rule #k256N   => 115792089237316195423570985008687907852837564279074904382605163141518161494337\n    29\t  rule #p256P   => 115792089210356248762697446949407573530086143415290314195533631308867097853951\n    30\t  rule #p256N   => 115792089210356248762697446949407573529996955224135760342422259061068512044369\n    31\t  rule #c25519P => 57896044618658097711785492504343953926634992332820282019728792003956564819949\n    32\t  rule #c25519L => 7237005577332262213973186563042994240857116359379907606001950938285454250989\n    33\t\n    34\t  syntax Int ::= fmod(Int, Int)         [function, total]\n    35\t               | fadd(Int, Int, Int)    [function, total]\n    36\t               | fsub(Int, Int, Int)    [function, total]\n    37\t               | fmul(Int, Int, Int)    [function, total]\n    38\t               | fneg(Int, Int)         [function, total]\n    39\t               | finv(Int, Int)         [function, total]   // inverse by Fermat; finv(0) = 0\n    40\t               | fdiv(Int, Int, Int)    [function, total]\n    41\t               | fpow(Int, Int, Int)    [function, total]\n    42\t               | fsq(Int, Int)          [function, total]\n    43\t  rule fmod(A, P)     => A modInt P\n    44\t  rule fadd(A, B, P)  => (A +Int B) modInt P\n    45\t  rule fsub(A, B, P)  => (A -Int B) modInt P\n    46\t  rule fmul(A, B, P)  => (A *Int B) modInt P\n    47\t  rule fneg(A, P)     => (0 -Int A) modInt P\n    48\t  rule finv(A, P)     => 0 requires A modInt P ==Int 0\n    49\t  rule finv(A, P)     => (A modInt P) ^%Int (P -Int 2) P requires A modInt P =/=Int 0\n    50\t  rule fdiv(A, B, P)  => fmul(A, finv(B, P), P)\n    51\t  rule fpow(A, E, P)  => (A modInt P) ^%Int E P requires E >=Int 0\n    52\t  rule fpow(_, E, _)  => 0 requires E <Int 0\n    53\t  rule fsq(A, P)      => fmul(A, A, P)\n    54\t\n    55\t  // Legendre symbol as 0, 1 or P-1 (i.e. -1); 0 counts as a residue, as in\n    56\t  // midnight-curves `ct_quadratic_non_residue` (legendre == -1).\n    57\t  syntax Int ::= legendre(Int, Int) [function, total]\n    58\t  rule legendre(A, P) => fpow(A, (P -Int 1) /Int 2, P)\n    59\t  syntax Bool ::= isQuadraticNonResidue(Int, Int) [function, total]\n    60\t  rule isQuadraticNonResidue(A, P) => legendre(A, P) ==Int P -Int 1\n    61\t\n    62\t  syntax Bool ::= isOddInt(Int) [function, total]\n    63\t  rule isOddInt(A) => A modInt 2 ==Int 1\n    64\t\n    65\t  // --- Square roots: Tonelli-Shanks ---------------------------------------\n    66\t  // fsqrt(A, P) is sqrtOk(X) with X*X = A mod P for some root, or noSqrt().\n    67\t  // Callers that need a specific root fix the parity themselves, as the Rust\n    68\t  // code does (Jubjub decompression, SVDW map).\n    69\t  syntax SqrtResult ::= sqrtOk(Int) | noSqrt()\n    70\t  syntax SqrtResult ::= fsqrt(Int, Int) [function, total]\n    71\t  rule fsqrt(A, P) => sqrtOk(0) requires A modInt P ==Int 0\n    72\t  rule fsqrt(A, P) => noSqrt() requires A modInt P =/=Int 0 andBool legendre(A, P) =/=Int 1\n    73\t  rule fsqrt(A, P) => #ts(A modInt P, P, #twoAdicity(P -Int 1, 0), #oddPart(P -Int 1), #nonResidue(P, 2))\n    74\t    requires A modInt P =/=Int 0 andBool legendre(A, P) ==Int 1\n    75\t\n    76\t  syntax Int ::= #twoAdicity(Int, Int) [function, total]   // #twoAdicity(N, 0) = s with N = 2^s * odd\n    77\t  rule #twoAdicity(N, S) => #twoAdicity(N /Int 2, S +Int 1) requires N >Int 0 andBool N modInt 2 ==Int 0\n    78\t  rule #twoAdicity(N, S) => S requires N <=Int 0 orBool N modInt 2 ==Int 1\n    79\t  syntax Int ::= #oddPart(Int) [function, total]\n    80\t  rule #oddPart(N) => #oddPart(N /Int 2) requires N >Int 0 andBool N modInt 2 ==Int 0\n    81\t  rule #oddPart(N) => N requires N <=Int 0 orBool N modInt 2 ==Int 1\n    82\t  syntax Int ::= #nonResidue(Int, Int) [function, total]   // smallest quadratic non-residue >= Z\n    83\t  rule #nonResidue(P, Z) => Z requires isQuadraticNonResidue(Z, P)\n    84\t  rule #nonResidue(P, Z) => #nonResidue(P, Z +Int 1) requires notBool isQuadraticNonResidue(Z, P) andBool Z <Int P\n    85\t  rule #nonResidue(P, Z) => 0 requires Z >=Int P\n    86\t\n    87\t  // #ts(A, P, S, Q, Z): standard loop with M = S, c = Z^Q, t = A^Q, R = A^((Q+1)/2)\n    88\t  syntax SqrtResult ::= #ts(Int, Int, Int, Int, Int) [function, total]\n    89\t  rule #ts(A, P, S, Q, Z) => #tsLoop(P, S, fpow(Z, Q, P), fpow(A, Q, P), fpow(A, (Q +Int 1) /Int 2, P))\n    90\t  syntax SqrtResult ::= #tsLoop(Int, Int, Int, Int, Int) [function, total]   // (P, M, c, t, R)\n    91\t  rule #tsLoop(_, _, _, 0, _) => noSqrt()\n    92\t  rule #tsLoop(_, _, _, 1, R) => sqrtOk(R)\n    93\t  rule #tsLoop(P, M, C, T, R) => #tsStep(P, M, C, T, R, #tsOrder(P, T, 0, M))\n    94\t    requires T =/=Int 0 andBool T =/=Int 1\n    95\t  // least i with t^(2^i) = 1\n    96\t  syntax Int ::= #tsOrder(Int, Int, Int, Int) [function, total]\n    97\t  rule #tsOrder(_, 1, I, _) => I\n    98\t  rule #tsOrder(P, T, I, M) => #tsOrder(P, fsq(T, P), I +Int 1, M) requires T =/=Int 1 andBool I <Int M\n    99\t  rule #tsOrder(_, T, I, M) => I requires T =/=Int 1 andBool I >=Int M\n   100\t  syntax SqrtResult ::= #tsStep(Int, Int, Int, Int, Int, Int) [function, total]\n   101\t  rule #tsStep(P, M, C, T, R, I) => noSqrt() requires I >=Int M\n   102\t  rule #tsStep(P, M, C, T, R, I) => #tsLoop(P, I, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P),\n   103\t                                            fmul(T, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P), P),\n   104\t                                            fmul(R, fpow(C, 2 ^Int (M -Int I -Int 1), P), P))\n   105\t    requires I <Int M\n   106\t\n   107\t  // --- Bit and byte helpers ------------------------------------------------\n   108\t  // Little-endian bit I of A (0 or 1).\n   109\t  syntax Int ::= bitAt(Int, Int) [function, total]\n   110\t  rule bitAt(A, I) => (A >>Int I) &Int 1 requires I >=Int 0 andBool A >=Int 0\n   111\t  rule bitAt(_, _) => 0 [owise]\n   112\t  // Low N bits and the rest.\n   113\t  syntax Int ::= lowBits(Int, Int) [function, total]\n   114\t  rule lowBits(A, N) => A &Int ((1 <<Int N) -Int 1) requires N >=Int 0 andBool A >=Int 0\n   115\t  rule lowBits(_, _) => 0 [owise]\n   116\t  syntax Int ::= highBits(Int, Int) [function, total]   // A >> N\n   117\t  rule highBits(A, N) => A >>Int N requires N >=Int 0 andBool A >=Int 0\n   118\t  rule highBits(_, _) => 0 [owise]\n   119\t  syntax Bool ::= fitsBits(Int, Int) [function, total]   // 0 <= A < 2^N\n   120\t  rule fitsBits(A, N) => A >=Int 0 andBool A <Int (1 <<Int N) requires N >=Int 0\n   121\t  rule fitsBits(_, _) => false [owise]\n   122\tendmodule\n     1\t// Affine elliptic-curve arithmetic for the four ZKIR curves.\n     2\t//\n     3\t//   Jubjub      twisted Edwards, a = -1, over r;   subgroup order rJ, cofactor 8\n     4\t//   Curve25519  twisted Edwards, a = -1, over 2^255-19; subgroup order c25519L, cofactor 8\n     5\t//   secp256k1   short Weierstrass y^2 = x^3 + 7 over k256P; prime order k256N\n     6\t//   secp256r1   short Weierstrass y^2 = x^3 - 3x + b over p256P; prime order p256N\n     7\t//\n     8\t// A point is pt(X, Y) or inf(). Edwards curves never use inf(): their identity\n     9\t// is pt(0, 1). Formulas are the complete unified Edwards addition (d is a\n    10\t// non-square on both curves) and the textbook affine Weierstrass addition.\n    11\t// Sources: midnight-curves 0.3.1 (jubjub/curve.rs, curve25519/), curve25519-dalek\n    12\t// 4.1.3 for the Curve25519 base point, the SEC 2 and FIPS 186-4 generators.\n    13\trequires \"zkir-field.k\"\n    14\t\n    15\tmodule ZKIR-CURVES\n    16\t  imports ZKIR-FIELD\n    17\t  imports STRING\n    18\t\n    19\t  syntax Point ::= pt(Int, Int) [symbol(pt)]\n    20\t                 | inf()        [symbol(inf)]\n    21\t\n    22\t  // --- Curve descriptors --------------------------------------------------------\n    23\t  // edwards(p, d, order)   weierstrass(p, a, b, order)\n    24\t  syntax Curve ::= edwards(Int, Int, Int) | weierstrass(Int, Int, Int, Int)\n    25\t\n    26\t  syntax Curve ::= \"#jubjub\" [function, total]\n    27\t                 | \"#curve25519\" [function, total]\n    28\t                 | \"#secp256k1\" [function, total]\n    29\t                 | \"#secp256r1\" [function, total]\n    30\t  // Jubjub d = -(10240/10241) mod r (midnight-curves jubjub/curve.rs EDWARDS_D)\n    31\t  rule #jubjub     => edwards(#r, fneg(fdiv(10240, 10241, #r), #r), #rJ)\n    32\t  // Curve25519 d = -(121665/121666) mod p\n    33\t  rule #curve25519 => edwards(#c25519P, fneg(fdiv(121665, 121666, #c25519P), #c25519P), #c25519L)\n    34\t  rule #secp256k1  => weierstrass(#k256P, 0, 7, #k256N)\n    35\t  rule #secp256r1  => weierstrass(#p256P, #p256P -Int 3,\n    36\t                        41058363725152142129326129780047268409114441015993725554835256314039467401291, #p256N)\n    37\t\n    38\t  syntax Int ::= curveField(Curve) [function, total]\n    39\t  rule curveField(edwards(P, _, _)) => P\n    40\t  rule curveField(weierstrass(P, _, _, _)) => P\n    41\t  syntax Int ::= curveOrder(Curve) [function, total]\n    42\t  rule curveOrder(edwards(_, _, N)) => N\n    43\t  rule curveOrder(weierstrass(_, _, _, N)) => N\n    44\t\n    45\t  // --- Generators ---------------------------------------------------------------\n    46\t  // Jubjub: JubjubAffine::generator() (u, v) of midnight-curves; the subgroup\n    47\t  // generator used by `JubjubSubgroup::generator()` is its cofactor clearing, 8*G.\n    48\t  syntax Point ::= \"#jubjubGenerator\" [function, total]\n    49\t  rule #jubjubGenerator => ecMul(#jubjub,\n    50\t    pt(44746807950788659978687200207992930935149218647843500701850233404325651525118, 11), 8)\n    51\t  // Curve25519: ED25519_BASEPOINT_POINT (already in the prime-order subgroup).\n    52\t  syntax Point ::= \"#curve25519Generator\" [function, total]\n    53\t  rule #curve25519Generator => pt(15112221349535400772501151409588531511454012693041857206046113283949847762202,\n    54\t                                  46316835694926478169428394003475163141307993866256225615783033603165251855960)\n    55\t  syntax Point ::= \"#secp256k1Generator\" [function, total]\n    56\t  rule #secp256k1Generator => pt(55066263022277343669578718895168534326250603453777594175500187360389116729240,\n    57\t                                 32670510020758816978083085130507043184471273380659243275938904335757337482424)\n    58\t  syntax Point ::= \"#secp256r1Generator\" [function, total]\n    59\t  rule #secp256r1Generator => pt(48439561293906451759052585252797914202762949526041747995844080717082404635286,\n    60\t                                 36134250956749795798585127919587881956611106672985015071877198253568414405109)\n    61\t\n    62\t  // --- Membership -----------------------------------------------------------------\n    63\t  syntax Bool ::= onCurve(Curve, Point) [function, total]\n    64\t  rule onCurve(_, inf()) => true\n    65\t  // -x^2 + y^2 = 1 + d x^2 y^2\n    66\t  rule onCurve(edwards(P, D, _), pt(X, Y))\n    67\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    68\t       fsub(fsq(Y, P), fsq(X, P), P) ==Int fadd(1, fmul(D, fmul(fsq(X, P), fsq(Y, P), P), P), P)\n    69\t  rule onCurve(weierstrass(P, A, B, _), pt(X, Y))\n    70\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    71\t       fsq(Y, P) ==Int fadd(fadd(fmul(fsq(X, P), X, P), fmul(A, X, P), P), B, P)\n    72\t\n    73\t  syntax Point ::= identity(Curve) [function, total]\n    74\t  rule identity(edwards(_, _, _)) => pt(0, 1)\n    75\t  rule identity(weierstrass(_, _, _, _)) => inf()\n    76\t\n    77\t  syntax Bool ::= isIdentity(Curve, Point) [function, total]\n    78\t  rule isIdentity(C, Q) => Q ==K identity(C)\n    79\t\n    80\t  // In the prime-order subgroup: order * Q = identity (Weierstrass groups are\n    81\t  // prime order, so any curve point qualifies).\n    82\t  syntax Bool ::= inSubgroup(Curve, Point) [function, total]\n    83\t  rule inSubgroup(edwards(P, D, N), Q) => isIdentity(edwards(P, D, N), ecMul(edwards(P, D, N), Q, N))\n    84\t  rule inSubgroup(weierstrass(_, _, _, _), _) => true\n    85\t\n    86\t  // --- Group law ------------------------------------------------------------------\n    87\t  syntax Point ::= ecNeg(Curve, Point) [function, total]\n    88\t  rule ecNeg(edwards(P, _, _), pt(X, Y)) => pt(fneg(X, P), Y)\n    89\t  rule ecNeg(weierstrass(P, _, _, _), pt(X, Y)) => pt(X, fneg(Y, P))\n    90\t  rule ecNeg(_, inf()) => inf()\n    91\t\n    92\t  syntax Point ::= ecAdd(Curve, Point, Point) [function, total]\n    93\t  rule ecAdd(edwards(P, D, _), pt(X1, Y1), pt(X2, Y2))\n    94\t    => pt(fdiv(fadd(fmul(X1, Y2, P), fmul(Y1, X2, P), P),\n    95\t              fadd(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P),\n    96\t          fdiv(fadd(fmul(Y1, Y2, P), fmul(X1, X2, P), P),\n    97\t              fsub(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P))\n    98\t  rule ecAdd(edwards(_, _, _), _, inf()) => inf()   // never reached for valid values\n    99\t  rule ecAdd(edwards(_, _, _), inf(), _) => inf()\n   100\t  rule ecAdd(weierstrass(_, _, _, _), inf(), Q) => Q\n   101\t  rule ecAdd(weierstrass(_, _, _, _), Q, inf()) => Q\n   102\t  rule ecAdd(weierstrass(P, A, B, N), pt(X1, Y1), pt(X2, Y2))\n   103\t    => ecDouble(weierstrass(P, A, B, N), pt(X1, Y1))\n   104\t    requires X1 ==Int X2 andBool Y1 ==Int Y2\n   105\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2)) => inf()\n   106\t    requires X1 ==Int X2 andBool Y1 =/=Int Y2\n   107\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2))\n   108\t    => #wChord(P, X1, Y1, X2, fdiv(fsub(Y2, Y1, P), fsub(X2, X1, P), P))\n   109\t    requires X1 =/=Int X2\n   110\t  syntax Point ::= #wChord(Int, Int, Int, Int, Int) [function, total]   // (P, X1, Y1, X2, lambda)\n   111\t  rule #wChord(P, X1, Y1, X2, L) => pt(fsub(fsub(fsq(L, P), X1, P), X2, P),\n   112\t                                       fsub(fmul(L, fsub(X1, fsub(fsub(fsq(L, P), X1, P), X2, P), P), P), Y1, P))\n   113\t\n   114\t  syntax Point ::= ecDouble(Curve, Point) [function, total]\n   115\t  rule ecDouble(edwards(P, D, N), Q) => ecAdd(edwards(P, D, N), Q, Q)\n   116\t  rule ecDouble(weierstrass(_, _, _, _), inf()) => inf()\n   117\t  rule ecDouble(weierstrass(_, _, _, _), pt(_, 0)) => inf()\n   118\t  rule ecDouble(weierstrass(P, A, _, _), pt(X, Y))\n   119\t    => #wChord(P, X, Y, X, fdiv(fadd(fmul(3, fsq(X, P), P), A, P), fmul(2, Y, P), P))\n   120\t    requires Y =/=Int 0\n   121\t\n   122\t  // Double-and-add over the bits of K (K >= 0; callers pass canonical scalars).\n   123\t  syntax Point ::= ecMul(Curve, Point, Int) [function, total]\n   124\t  rule ecMul(C, _, K) => identity(C) requires K <=Int 0\n   125\t  rule ecMul(C, Q, K) => #ecMulAcc(C, Q, K, identity(C)) requires K >Int 0\n   126\t  syntax Point ::= #ecMulAcc(Curve, Point, Int, Point) [function, total]\n   127\t  rule #ecMulAcc(_, _, 0, Acc) => Acc\n   128\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, ecAdd(C, Acc, Q))\n   129\t    requires K >Int 0 andBool K modInt 2 ==Int 1\n   130\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, Acc)\n   131\t    requires K >Int 0 andBool K modInt 2 ==Int 0\n   132\t  rule #ecMulAcc(_, _, K, Acc) => Acc requires K <Int 0\n   133\t\n   134\t  // --- Constructors from coordinates -------------------------------------------------\n   135\t  syntax PointResult ::= ptOk(Point) | ptErr(String)\n   136\t\n   137\t  // Exact membership test (secp256k1, secp256r1 via SEC1 decoding; Curve25519\n   138\t  // via the curve equation in midnight-curves Curve25519Affine::from_xy).\n   139\t  syntax PointResult ::= fromXY(Curve, Int, Int) [function, total]\n   140\t  rule fromXY(C, X, Y) => ptOk(pt(X, Y)) requires onCurve(C, pt(X, Y))\n   141\t  rule fromXY(C, X, Y) => ptErr(\"point is not on the curve\") requires notBool onCurve(C, pt(X, Y))\n   142\t\n   143\t  // Jubjub `from_xy` of midnight-circuits (ecc/curves.rs): compresses (y, parity\n   144\t  // of x) and decompresses with JubjubAffine::from_bytes, so only the low bit\n   145\t  // of x is used; the recovered x is the root of (y^2-1)/(1+d y^2) with that\n   146\t  // parity. Fails when y is not the v-coordinate of any point, or when\n   147\t  // (ZIP 216) u = 0 with the sign bit set.\n   148\t  syntax PointResult ::= jubjubFromXY(Int, Int) [function, total]\n   149\t  rule jubjubFromXY(X, Y) => ptErr(\"coordinate out of range\") requires Y <Int 0 orBool Y >=Int #r orBool X <Int 0 orBool X >=Int #r\n   150\t  rule jubjubFromXY(X, Y) => #jubjubDecompress(X modInt 2, Y, fsqrt(fdiv(fsub(fsq(Y, #r), 1, #r), fadd(1, fmul(#jubjubD, fsq(Y, #r), #r), #r), #r), #r))\n   151\t    requires Y >=Int 0 andBool Y <Int #r andBool X >=Int 0 andBool X <Int #r\n   152\t  syntax Int ::= \"#jubjubD\" [function, total]\n   153\t  rule #jubjubD => fneg(fdiv(10240, 10241, #r), #r)\n   154\t  syntax PointResult ::= #jubjubDecompress(Int, Int, SqrtResult) [function, total]\n   155\t  rule #jubjubDecompress(_, _, noSqrt()) => ptErr(\"y is not on Jubjub\")\n   156\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(U, Y)) requires U modInt 2 ==Int Sign\n   157\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptErr(\"invalid Jubjub encoding: -0\")\n   158\t    requires U modInt 2 =/=Int Sign andBool U ==Int 0\n   159\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(fneg(U, #r), Y))\n   160\t    requires U modInt 2 =/=Int Sign andBool U =/=Int 0\n   161\tendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/tools/gen_constants.py; nl -ba experiments/zkir-k/tools/unit_values.py; nl -ba experiments/zkir-k/tools/unit_hash.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/tools/gen_constants.py; nl -ba experiments/zkir-k/tools/unit_values.py; nl -ba experiments/zkir-k/tools/unit_hash.py'","aggregated_output":"     1\t\"\"\"Generate semantics/zkir-constants.k from midnight-circuits 7.2.4 sources.\n     2\t\n     3\tReads the Poseidon round constants and MDS matrix for the BLS12-381 scalar\n     4\tfield (hash/poseidon/constants/blstrs.rs, produced by the pasta-hadeshash grain\n     5\tscript for t=3, R_F=8, R_P=60) and the Jubjub map-to-curve parameters\n     6\t(ecc/hash_to_curve/mtc_params.rs). `Fq::from_raw([a, b, c, d])` are the four\n     7\tlittle-endian 64-bit limbs of the canonical integer.\n     8\t\n     9\tUsage: python gen_constants.py <midnight-circuits-src-dir> > ../semantics/zkir-constants.k\n    10\t\"\"\"\n    11\timport re\n    12\timport sys\n    13\tfrom pathlib import Path\n    14\t\n    15\tsrc = Path(sys.argv[1])\n    16\tFROM_RAW = re.compile(r'from_raw\\(\\s*\\[([^\\]]*)\\]\\s*\\)', re.S)\n    17\t\n    18\t\n    19\tdef limbs_to_int(text: str) -> int:\n    20\t    limbs = [int(x.replace('_', ''), 16) for x in re.findall(r'0x[0-9a-fA-F_]+', text)]\n    21\t    assert len(limbs) == 4, limbs\n    22\t    return sum(l << (64 * i) for i, l in enumerate(limbs))\n    23\t\n    24\t\n    25\tblstrs = (src / 'hash/poseidon/constants/blstrs.rs').read_text()\n    26\trc_start = blstrs.index('const ROUND_CONSTANTS')\n    27\tmds_start = blstrs.index('const MDS')\n    28\trc_text, mds_text = (blstrs[rc_start:mds_start], blstrs[mds_start:]) if rc_start < mds_start else (blstrs[rc_start:], blstrs[mds_start:rc_start])\n    29\trcs = [limbs_to_int(m) for m in FROM_RAW.findall(rc_text)]\n    30\tmds = [limbs_to_int(m) for m in FROM_RAW.findall(mds_text)]\n    31\tassert len(rcs) == 68 * 3, len(rcs)\n    32\tassert len(mds) == 9, len(mds)\n    33\t\n    34\tmtc = (src / 'ecc/hash_to_curve/mtc_params.rs').read_text()\n    35\tconsts = {}\n    36\tfor name in ['SVDW_Z', 'A', 'B', 'MONT_J', 'MONT_K']:\n    37\t    m = re.search(r'const %s: JubjubBase = JubjubBase::from_raw\\(\\s*\\[([^\\]]*)\\]' % name, mtc, re.S)\n    38\t    consts[name] = limbs_to_int(m.group(1))\n    39\t\n    40\tout = []\n    41\tout.append('// GENERATED by tools/gen_constants.py from midnight-circuits 7.2.4; do not edit.')\n    42\tout.append('// Poseidon (BLS12-381 scalar field, t=3, R_F=8, R_P=60) round constants and MDS,')\n    43\tout.append('// and the Jubjub Shallue-van de Woestijne map-to-curve parameters.')\n    44\tout.append('module ZKIR-CONSTANTS')\n    45\tout.append('  imports INT')\n    46\tout.append('  syntax Int ::= poseidonRC(Int, Int) [function, total]   // round 0..67, position 0..2')\n    47\tfor r in range(68):\n    48\t    for j in range(3):\n    49\t        out.append(f'  rule poseidonRC({r}, {j}) => {rcs[r * 3 + j]}')\n    50\tout.append('  rule poseidonRC(_, _) => 0 [owise]')\n    51\tout.append('  syntax Int ::= poseidonMDS(Int, Int) [function, total]')\n    52\tfor i in range(3):\n    53\t    for j in range(3):\n    54\t        out.append(f'  rule poseidonMDS({i}, {j}) => {mds[i * 3 + j]}')\n    55\tout.append('  rule poseidonMDS(_, _) => 0 [owise]')\n    56\tfor name, k in [('SVDW_Z', 'svdwZ'), ('A', 'svdwA'), ('B', 'svdwB'), ('MONT_J', 'montJ'), ('MONT_K', 'montK')]:\n    57\t    out.append(f'  syntax Int ::= \"#{k}\" [function, total]')\n    58\t    out.append(f'  rule #{k} => {consts[name]}')\n    59\tout.append('endmodule')\n    60\tprint('\\n'.join(out))\n     1\t\"\"\"Unit tests for ZKIR-FIELD, ZKIR-CURVES and ZKIR-VALUES (milestone 3).\n     2\t\n     3\tEvaluates K function terms through the ZKIR-TEST definition and compares with\n     4\tan independent Python implementation of the same textbook formulas and of the\n     5\tmidnight-circuits public-input encodings. Prints one line per check; exit 1 on\n     6\tany mismatch.\n     7\t\n     8\tUsage: uv run --group zkir-k python experiments/zkir-k/tools/unit_values.py\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport sys\n    13\tfrom pathlib import Path\n    14\t\n    15\tfrom pyk.kast.inner import KApply, KInner, KSort, KToken\n    16\tfrom pyk.kast.prelude.kint import intToken\n    17\tfrom pyk.kore.parser import KoreParser\n    18\tfrom pyk.ktool.krun import KRun\n    19\t\n    20\tDEF = Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-test-kompiled'\n    21\t\n    22\t# --- Python reference -------------------------------------------------------------\n    23\tR = 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    24\tRJ = 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    25\tK256P = 2**256 - 2**32 - 977\n    26\tK256N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\n    27\tP256P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF\n    28\tP256N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551\n    29\tP256B = 0x5AC635D8AA3A93E7B3EBBD55769886BC651D06B0CC53B0F63BCE3C3E27D2604B\n    30\tC25519P = 2**255 - 19\n    31\tC25519L = 2**252 + 27742317777372353535851937790883648493\n    32\tJUBJUB_D = (-10240 * pow(10241, -1, R)) % R\n    33\tC25519_D = (-121665 * pow(121666, -1, C25519P)) % C25519P\n    34\tJUBJUB_G = (44746807950788659978687200207992930935149218647843500701850233404325651525118, 11)\n    35\tC25519_G = (15112221349535400772501151409588531511454012693041857206046113283949847762202,\n    36\t            46316835694926478169428394003475163141307993866256225615783033603165251855960)\n    37\tK256_G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,\n    38\t          0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\n    39\tP256_G = (0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,\n    40\t          0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5)\n    41\t\n    42\t\n    43\tdef ed_add(p, q, mod, d):\n    44\t    (x1, y1), (x2, y2) = p, q\n    45\t    t = d * x1 * x2 * y1 * y2 % mod\n    46\t    x3 = (x1 * y2 + y1 * x2) * pow(1 + t, -1, mod) % mod\n    47\t    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, mod) % mod\n    48\t    return (x3, y3)\n    49\t\n    50\t\n    51\tdef ed_mul(p, k, mod, d):\n    52\t    acc = (0, 1)\n    53\t    while k:\n    54\t        if k & 1:\n    55\t            acc = ed_add(acc, p, mod, d)\n    56\t        p = ed_add(p, p, mod, d)\n    57\t        k >>= 1\n    58\t    return acc\n    59\t\n    60\t\n    61\tdef w_add(p, q, mod, a):\n    62\t    if p is None:\n    63\t        return q\n    64\t    if q is None:\n    65\t        return p\n    66\t    (x1, y1), (x2, y2) = p, q\n    67\t    if x1 == x2 and (y1 + y2) % mod == 0:\n    68\t        return None\n    69\t    if p == q:\n    70\t        lam = (3 * x1 * x1 + a) * pow(2 * y1, -1, mod) % mod\n    71\t    else:\n    72\t        lam = (y2 - y1) * pow(x2 - x1, -1, mod) % mod\n    73\t    x3 = (lam * lam - x1 - x2) % mod\n    74\t    y3 = (lam * (x1 - x3) - y1) % mod\n    75\t    return (x3, y3)\n    76\t\n    77\t\n    78\tdef w_mul(p, k, mod, a):\n    79\t    acc = None\n    80\t    while k:\n    81\t        if k & 1:\n    82\t            acc = w_add(acc, p, mod, a)\n    83\t        p = w_add(p, p, mod, a)\n    84\t        k >>= 1\n    85\t    return acc\n    86\t\n    87\t\n    88\tdef enc_foreign(x, mod, log2, nb):\n    89\t    e = (x - 1) % mod\n    90\t    per = 254 // log2\n    91\t    out = []\n    92\t    left = nb\n    93\t    while left > 0:\n    94\t        take = min(left, per)\n    95\t        out.append(e & ((1 << (log2 * take)) - 1))\n    96\t        e >>= log2 * take\n    97\t        left -= take\n    98\t    return out\n    99\t\n   100\t\n   101\t# --- K side ---------------------------------------------------------------------------\n   102\tkrun = KRun(DEF)\n   103\t\n   104\t\n   105\tdef run(term: KInner) -> str:\n   106\t    kore = krun.kast_to_kore(term, KSort('KItem'))\n   107\t    res = krun.run_process(kore)\n   108\t    assert res.returncode == 0, res.stderr\n   109\t    out = krun.pretty_print(krun.kore_to_kast(KoreParser(res.stdout).pattern()))\n   110\t    # strip the <k> cell wrapper\n   111\t    start = out.find('<k>') + 3\n   112\t    end = out.rfind('~> .K')\n   113\t    return out[start:end].strip()\n   114\t\n   115\t\n   116\t_SYMBOLS = list(krun.definition.symbols.keys())\n   117\t\n   118\t\n   119\tdef resolve(label: str) -> str:\n   120\t    \"\"\"Symbol name for a production: exact `symbol(_)` name, else the unique\n   121\t    mangled label whose base name matches (e.g. finv -> finv(_,_)_ZKIR-FIELD_...).\"\"\"\n   122\t    if label in krun.definition.symbols:\n   123\t        return label\n   124\t    hits = [s for s in _SYMBOLS if s.startswith(label + '(') or s.startswith(label + '_') or s == label]\n   125\t    if len(hits) != 1:\n   126\t        raise KeyError(f'{label}: {hits}')\n   127\t    return hits[0]\n   128\t\n   129\t\n   130\tdef K(label: str, *args: KInner) -> KInner:\n   131\t    return KApply(resolve(label), list(args))\n   132\t\n   133\t\n   134\tdef I(n: int) -> KInner:\n   135\t    return intToken(n)\n   136\t\n   137\t\n   138\tdef pt(x, y):\n   139\t    return K('pt', I(x), I(y))\n   140\t\n   141\t\n   142\tdef klist(items):\n   143\t    t = KApply('.List')\n   144\t    for it in reversed(items):\n   145\t        t = KApply('_List_', [KApply('ListItem', [it]), t])\n   146\t    return t\n   147\t\n   148\t\n   149\tdef pretty_pt(p):\n   150\t    return 'inf ( )' if p is None else f'pt ( {p[0]} , {p[1]} )'\n   151\t\n   152\t\n   153\tdef pretty_list(items):\n   154\t    return ' '.join(f'ListItem ( {i} )' for i in items) if items else '.List'\n   155\t\n   156\t\n   157\tchecks = []\n   158\t\n   159\t\n   160\tdef check(name, term, expected):\n   161\t    actual = run(term)\n   162\t    ok = ' '.join(actual.split()) == ' '.join(expected.split())\n   163\t    checks.append(ok)\n   164\t    print(('PASS' if ok else 'FAIL'), name, '' if ok else f'\\n   expected: {expected}\\n   actual:   {actual}')\n   165\t\n   166\t\n   167\t# field\n   168\tcheck('finv', K('finv', I(12345), K('#r')), str(pow(12345, -1, R)))\n   169\tcheck('fsqrt 4', K('fsqrt', I(4), K('#r')), 'sqrtOk ( 2 )' if run(K('fsqrt', I(4), K('#r'))) == 'sqrtOk ( 2 )' else f'sqrtOk ( {R - 2} )')\n   170\tsq = run(K('fsqrt', I(JUBJUB_D), K('#r')))\n   171\tcheck('jubjub d is a non-residue', K('fsqrt', I(JUBJUB_D), K('#r')), 'noSqrt ( )')\n   172\tcheck('curve25519 d is a non-residue', K('fsqrt', I(C25519_D), K('#c25519P')), 'noSqrt ( )')\n   173\tcheck('legendre 3 mod r', K('legendre', I(3), K('#r')), str(pow(3, (R - 1) // 2, R)))\n   174\t# curves\n   175\tcheck('jubjub d', K('#jubjubD'), str(JUBJUB_D))\n   176\tcheck('jubjub G on curve', K('onCurve', K('#jubjub'), pt(*JUBJUB_G)), 'true')\n   177\tG8 = ed_mul(JUBJUB_G, 8, R, JUBJUB_D)\n   178\tcheck('jubjub subgroup generator = 8G', K('#jubjubGenerator'), pretty_pt(G8))\n   179\tcheck('jubjub 8G in subgroup', K('inSubgroup', K('#jubjub'), pt(*G8)), 'true')\n   180\tcheck('jubjub G not in subgroup', K('inSubgroup', K('#jubjub'), pt(*JUBJUB_G)), 'false')\n   181\tcheck('jubjub 12345 * 8G', K('ecMul', K('#jubjub'), pt(*G8), I(12345)), pretty_pt(ed_mul(G8, 12345, R, JUBJUB_D)))\n   182\tcheck('curve25519 B on curve', K('onCurve', K('#curve25519'), pt(*C25519_G)), 'true')\n   183\tcheck('curve25519 B in subgroup', K('inSubgroup', K('#curve25519'), pt(*C25519_G)), 'true')\n   184\tcheck('curve25519 7 * B', K('ecMul', K('#curve25519'), pt(*C25519_G), I(7)), pretty_pt(ed_mul(C25519_G, 7, C25519P, C25519_D)))\n   185\tcheck('secp256k1 G on curve', K('onCurve', K('#secp256k1'), pt(*K256_G)), 'true')\n   186\tcheck('secp256k1 n * G = inf', K('ecMul', K('#secp256k1'), pt(*K256_G), I(K256N)), 'inf ( )')\n   187\tcheck('secp256k1 999 * G', K('ecMul', K('#secp256k1'), pt(*K256_G), I(999)), pretty_pt(w_mul(K256_G, 999, K256P, 0)))\n   188\tcheck('secp256r1 G on curve', K('onCurve', K('#secp256r1'), pt(*P256_G)), 'true')\n   189\tcheck('secp256r1 n * G = inf', K('ecMul', K('#secp256r1'), pt(*P256_G), I(P256N)), 'inf ( )')\n   190\tcheck('secp256r1 31 * G', K('ecMul', K('#secp256r1'), pt(*P256_G), I(31)), pretty_pt(w_mul(P256_G, 31, P256P, P256P - 3)))\n   191\t# Jubjub decompression: from_xy(x, y) with x's parity only\n   192\tcheck('jubjubFromXY exact', K('jubjubFromXY', I(G8[0]), I(G8[1])), f'ptOk ( pt ( {G8[0]} , {G8[1]} ) )')\n   193\txneg = (-G8[0]) % R\n   194\tcheck('jubjubFromXY negated x', K('jubjubFromXY', I(xneg), I(G8[1])), f'ptOk ( pt ( {xneg} , {G8[1]} ) )')\n   195\t# a wrong x with the same parity as the real one recovers the real point\n   196\twrong = (G8[0] + 2) % R\n   197\tcheck('jubjubFromXY wrong x same parity', K('jubjubFromXY', I(wrong), I(G8[1])), f'ptOk ( pt ( {G8[0]} , {G8[1]} ) )')\n   198\t# encodings\n   199\tx = 0x1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF % K256P\n   200\tcheck('enc secp256k1Base', K('encodeValue', K('secp256k1BaseV', I(x))), pretty_list(enc_foreign(x, K256P, 64, 4)))\n   201\tcheck('enc secp256k1Base 0', K('encodeValue', K('secp256k1BaseV', I(0))), pretty_list(enc_foreign(0, K256P, 64, 4)))\n   202\tcheck('dec secp256k1Base', K('decodeValue', klist([I(v) for v in enc_foreign(x, K256P, 64, 4)]), K('Secp256k1Base')), f'decOk ( secp256k1Base ( {x} ) )')\n   203\ts = 0xABCDEF % C25519L\n   204\tcheck('enc curve25519Scalar', K('encodeValue', K('curve25519ScalarV', I(s))), pretty_list(enc_foreign(s, C25519L, 51, 5)))\n   205\tcheck('dec curve25519Scalar', K('decodeValue', klist([I(v) for v in enc_foreign(s, C25519L, 51, 5)]), K('Curve25519Scalar')), f'decOk ( curve25519Scalar ( {s} ) )')\n   206\tencG = enc_foreign(K256_G[0], K256P, 64, 4) + enc_foreign(K256_G[1], K256P, 64, 4) + [0]\n   207\tcheck('enc secp256k1Point G', K('encodeValue', K('secp256k1PointV', pt(*K256_G))), pretty_list(encG))\n   208\tcheck('dec secp256k1Point G', K('decodeValue', klist([I(v) for v in encG]), K('Secp256k1Point')), f'decOk ( secp256k1Point ( pt ( {K256_G[0]} , {K256_G[1]} ) ) )')\n   209\tencInf = enc_foreign(0, K256P, 64, 4) * 2 + [1]\n   210\tcheck('enc secp256k1Point inf', K('encodeValue', K('secp256k1PointV', K('inf'))), pretty_list(encInf))\n   211\tcheck('dec secp256k1Point inf', K('decodeValue', klist([I(v) for v in encInf]), K('Secp256k1Point')), 'decOk ( secp256k1Point ( inf ( ) ) )')\n   212\tencB = enc_foreign(C25519_G[0], C25519P, 64, 4) + enc_foreign(C25519_G[1], C25519P, 64, 4)\n   213\tcheck('enc curve25519Point B', K('encodeValue', K('curve25519PointV', pt(*C25519_G))), pretty_list(encB))\n   214\tcheck('dec curve25519Point B', K('decodeValue', klist([I(v) for v in encB]), K('Curve25519Point')), f'decOk ( curve25519Point ( pt ( {C25519_G[0]} , {C25519_G[1]} ) ) )')\n   215\tcheck('dec jubjubPoint 8G', K('decodeValue', klist([I(G8[0]), I(G8[1])]), K('JubjubPoint')), f'decOk ( jubjubPoint ( pt ( {G8[0]} , {G8[1]} ) ) )')\n   216\tcheck('dec jubjubPoint G (not subgroup)', K('decodeValue', klist([I(JUBJUB_G[0]), I(JUBJUB_G[1])]), K('JubjubPoint')), 'decErr ( \"Failed to decode as JubjubPoint\" )')\n   217\tcheck('dec jubjubScalar', K('decodeValue', klist([I(RJ - 1)]), K('JubjubScalar')), f'decOk ( jubjubScalar ( {RJ - 1} ) )')\n   218\tcheck('dec jubjubScalar too big', K('decodeValue', klist([I(RJ)]), K('JubjubScalar')), 'decErr ( \"Failed to decode as JubjubScalar\" )')\n   219\tb = bytes(range(1, 33))\n   220\tlo = int.from_bytes(b[:31], 'little')\n   221\tcheck('enc bytes32', K('encodeValue', K('bytes32V', KToken(f'b\"{\"\".join(chr(c) for c in b)}\"', KSort('Bytes')))), pretty_list([lo, 32]))\n   222\tcheck('dec bytes32', K('decodeValue', klist([I(lo), I(32)]), K('Bytes32')), f'decOk ( bytes32 ( {run(KToken(\"b\" + chr(34) + \"\".join(chr(92) + \"x%02x\" % c for c in b) + chr(34), KSort(\"Bytes\")))} ) )')\n   223\tcheck('dec bytes32 bad high', K('decodeValue', klist([I(lo), I(256)]), K('Bytes32')), 'decErr ( \"Bytes32 decoding assertion failed\" )')\n   224\t\n   225\tprint(f'\\n{sum(checks)}/{len(checks)} checks passed')\n   226\tsys.exit(0 if all(checks) else 1)\n     1\t\"\"\"Known-answer tests for ZKIR-HASH against the Rust oracle (milestone 3/4).\n     2\t\n     3\tRuns the crate's `preprocess` (zkir-oracle, built from midnight-ledger 92e8bdd3\n     4\tin repos/_build/ledger-92e8bdd3) on corpus/handmade/{transient_hash,std_hashes}.zkir\n     5\tand checks that K's poseidonHash, hashToCurve, sha256 and keccak256 give the\n     6\tsame register values. Also checks sha256 against hashlib.\n     7\t\n     8\tUsage: uv run --group zkir-k python experiments/zkir-k/tools/unit_hash.py\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport hashlib\n    13\timport json\n    14\timport subprocess\n    15\timport sys\n    16\timport tempfile\n    17\tfrom pathlib import Path\n    18\t\n    19\tfrom pyk.kast.inner import KApply, KInner, KSort, KToken\n    20\tfrom pyk.kast.prelude.kint import intToken\n    21\tfrom pyk.kore.parser import KoreParser\n    22\tfrom pyk.ktool.krun import KRun\n    23\t\n    24\tHERE = Path(__file__).resolve().parent\n    25\tDEF = HERE.parent / 'semantics' / 'zkir-test-kompiled'\n    26\tCORPUS = HERE.parent / 'corpus' / 'handmade'\n    27\tORACLE = Path.home() / 'Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle'\n    28\t\n    29\tkrun = KRun(DEF)\n    30\t_SYMBOLS = list(krun.definition.symbols.keys())\n    31\t\n    32\t\n    33\tdef resolve(label: str) -> str:\n    34\t    if label in krun.definition.symbols:\n    35\t        return label\n    36\t    hits = [s for s in _SYMBOLS if s.startswith(label + '(') or s.startswith(label + '_') or s == label]\n    37\t    if len(hits) != 1:\n    38\t        raise KeyError(f'{label}: {hits}')\n    39\t    return hits[0]\n    40\t\n    41\t\n    42\tdef K(label: str, *args: KInner) -> KInner:\n    43\t    return KApply(resolve(label), list(args))\n    44\t\n    45\t\n    46\tdef I(n: int) -> KInner:\n    47\t    return intToken(n)\n    48\t\n    49\t\n    50\tdef klist(items):\n    51\t    t = KApply('.List')\n    52\t    for it in reversed(items):\n    53\t        t = KApply('_List_', [KApply('ListItem', [it]), t])\n    54\t    return t\n    55\t\n    56\t\n    57\tdef kbytes(b: bytes) -> KInner:\n    58\t    esc = ''.join('\\\\x%02x' % c for c in b)\n    59\t    return KToken(f'b\"{esc}\"', KSort('Bytes'))\n    60\t\n    61\t\n    62\tdef run(term: KInner) -> str:\n    63\t    kore = krun.kast_to_kore(term, KSort('KItem'))\n    64\t    res = krun.run_process(kore)\n    65\t    assert res.returncode == 0, res.stderr\n    66\t    out = krun.pretty_print(krun.kore_to_kast(KoreParser(res.stdout).pattern()))\n    67\t    start = out.find('<k>') + 3\n    68\t    end = out.rfind('~> .K')\n    69\t    return ' '.join(out[start:end].split())\n    70\t\n    71\t\n    72\tdef oracle(program: Path, inputs: list[int]) -> dict:\n    73\t    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:\n    74\t        json.dump({'inputs': [str(i) for i in inputs], 'binding_input': '42'}, f)\n    75\t    res = subprocess.run([str(ORACLE), str(program), f.name], capture_output=True, text=True, check=True)\n    76\t    return json.loads(res.stdout)\n    77\t\n    78\t\n    79\tdef pretty_list(items):\n    80\t    return ' '.join(f'ListItem ( {i} )' for i in items) if items else '.List'\n    81\t\n    82\t\n    83\tchecks = []\n    84\t\n    85\t\n    86\tdef check(name, actual, expected):\n    87\t    ok = actual == expected\n    88\t    checks.append(ok)\n    89\t    print(('PASS' if ok else 'FAIL'), name, '' if ok else f'\\n   expected: {expected}\\n   actual:   {actual}')\n    90\t\n    91\t\n    92\ta, b, c = 5, 123456789, 987654321987654321\n    93\tmem = oracle(CORPUS / 'transient_hash.zkir', [a, b, c])\n    94\tassert mem['status'] == 'ok', mem\n    95\tm = mem['memory']\n    96\tcheck('poseidon [a,b,c]', run(K('poseidonHash', klist([I(a), I(b), I(c)]))), m['%h3']['encoded'][0])\n    97\tcheck('poseidon [a]', run(K('poseidonHash', klist([I(a)]))), m['%h1']['encoded'][0])\n    98\tcheck('poseidon []', run(K('poseidonHash', klist([]))), m['%h0']['encoded'][0])\n    99\tcheck('poseidon [a,b]', run(K('poseidonHash', klist([I(a), I(b)]))), m['%h2']['encoded'][0])\n   100\tfor name, xs in [('%p3', [a, b, c]), ('%p1', [a]), ('%p0', [])]:\n   101\t    x, y = m[name]['encoded']\n   102\t    check(f'hash_to_curve {xs}', run(K('hashToCurve', klist([I(v) for v in xs]))), f'pt ( {x} , {y} )')\n   103\t\n   104\t# sha256 / keccak256 through the alignment layer\n   105\tmem = oracle(CORPUS / 'std_hashes.zkir', [a, b, c])\n   106\tassert mem['status'] == 'ok', mem\n   107\tm = mem['memory']\n   108\tdigest = hashlib.sha256(bytes([a])).digest()\n   109\tcheck('sha256 hashlib', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(bytes([a])))))),\n   110\t      pretty_list([int.from_bytes(digest[:31], 'little'), digest[31]]))\n   111\tcheck('sha256 bytes(1) vs oracle', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(bytes([a])))))), pretty_list(m['%s1']['encoded']))\n   112\tcheck('keccak256 bytes(1) vs oracle', run(K('encodeValue', K('bytes32V', K('keccak256Bytes', kbytes(bytes([a])))))), pretty_list(m['%k1']['encoded']))\n   113\t# bytes(32) from [a, c]: stray byte first (a), then 31 bytes of c\n   114\tpre32 = c.to_bytes(31, 'little') + bytes([a])\n   115\tdigest32 = hashlib.sha256(pre32).digest()\n   116\tcheck('sha256 bytes(32) alignment vs hashlib', pretty_list(m['%s32']['encoded']), pretty_list([int.from_bytes(digest32[:31], 'little'), digest32[31]]))\n   117\talign32 = K('alignment', K('segments', K('atom', K('bytesAtom', I(32))), K('.segments')))\n   118\tcheck('alignedBytes bytes(32)', run(K('alignedBytes', align32, klist([I(a), I(c)]))), f'bOk ( {run(kbytes(pre32))} )')\n   119\tcheck('sha256 bytes(32) vs oracle', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(pre32))))), pretty_list(m['%s32']['encoded']))\n   120\tcheck('keccak256 bytes(32) vs oracle', run(K('encodeValue', K('bytes32V', K('keccak256Bytes', kbytes(pre32))))), pretty_list(m['%k32']['encoded']))\n   121\t# field + bytes(6): 32 LE bytes of c, then 6 bytes of a\n   122\tpref = c.to_bytes(32, 'little') + a.to_bytes(6, 'little')\n   123\talignf = K('alignment', K('segments', K('atom', K('fieldAtom')), K('segments', K('atom', K('bytesAtom', I(6))), K('.segments'))))\n   124\tcheck('alignedBytes field+bytes(6)', run(K('alignedBytes', alignf, klist([I(c), I(a)]))), f'bOk ( {run(kbytes(pref))} )')\n   125\tcheck('sha256 field+bytes(6) vs oracle', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(pref))))), pretty_list(m['%sf']['encoded']))\n   126\t# bytes(200) from 7 elements + field: six 31-byte chunks (elements 1..6 reversed), then 200 % 31 = 14 stray bytes from element 0\n   127\tels = [a, b, c, a, b, c, a]\n   128\t# bytes_from_field_repr: the 31-byte chunks come first (elements after the stray one, reversed), the stray bytes last\n   129\tpre200 = b''.join(e.to_bytes(31, 'little') for e in reversed(els[1:])) + els[0].to_bytes(14, 'little') + c.to_bytes(32, 'little')\n   130\tassert len(pre200) == 232\n   131\tcheck('keccak256 bytes(200)+field vs oracle', run(K('encodeValue', K('bytes32V', K('keccak256Bytes', kbytes(pre200))))), pretty_list(m['%k200']['encoded']))\n   132\talign200 = K('alignment', K('segments', K('atom', K('bytesAtom', I(200))), K('segments', K('atom', K('fieldAtom')), K('.segments'))))\n   133\tcheck('alignedBytes bytes(200)+field', run(K('alignedBytes', align200, klist([I(v) for v in els + [c]]))), f'bOk ( {run(kbytes(pre200))} )')\n   134\t\n   135\tprint(f'\\n{sum(checks)}/{len(checks)} checks passed')\n   136\tsys.exit(0 if all(checks) else 1)\n","exit_code":0,"status":"completed"}}
