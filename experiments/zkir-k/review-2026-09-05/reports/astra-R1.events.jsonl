{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -u - <<'PY'\nfrom pathlib import Path\nimport subprocess,sys,os,json\nfrom pyk.ktool.krun import KRun\nfrom pyk.kast.inner import KApply,KSort,KToken,KSequence\nfrom pyk.kast.prelude.kint import intToken as I\nfrom pyk.kore.parser import KoreParser\nr=KRun(Path('experiments/zkir-k/semantics/zkir-test-kompiled'))\ndef K(s,*a):\n h=[x for x in r.definition.symbols if x==s or x.startswith(s+'(') or x.startswith(s+'_')];return KApply(s if s in h else h[0],list(a))\ndef L(xs):\n t=KApply('.List')\n for x in reversed(xs):t=KApply('_List_',[KApply('ListItem',[I(x)]),t])\n return t\ndef ev(t):\n q=r.kast_to_kore(KApply('<k>',[KSequence([t])]),KSort('KCell'));p=subprocess.run([str(r.definition_dir/'interpreter'),'/dev/stdin','-1','/dev/stdout'],input=q.text,capture_output=True,text=True,timeout=30);assert p.returncode==0,p.stderr\n return r.kore_to_kast(KoreParser(p.stdout).pattern()).args[0].items[0]\ndef oracle(typ,xs):\n p={'version':{'major':3,'minor':0},'inputs':[{'name':'%x','type':typ}],'outputs':[],'do_communications_commitment':False,'instructions':[]}\n rd,wr=os.pipe();os.write(wr,json.dumps(p).encode());os.close(wr)\n out=subprocess.run(['/home/charl/Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle',f'/dev/fd/{rd}','/dev/stdin'],pass_fds=(rd,),input=json.dumps({'inputs':list(map(str,xs)),'binding_input':'0'}),text=True,capture_output=True,timeout=30);os.close(rd);assert out.returncode==0,out.stderr;return json.loads(out.stdout)\ncases=[]\nfor sort,ty,mod,bits in [('Secp256k1Base','Base<Secp256k1>','#k256P',192),('Curve25519Scalar','Scalar<Curve25519>','#c25519L',204)]:\n p=int(ev(K(mod)).token)\n for label,xs in [('modulus',[p%2**bits,p//2**bits]),('batch overflow',[2**bits,0]),('tail overflow',[0,2**(256-bits if bits==192 else 255-bits)])]:cases.append((sort,ty,label,xs))\nfor f in [0,2**252,3*2**252+5,2**254]:cases.append(('JubjubScalar','Scalar<Jubjub>','scalar '+str(f),[f]))\nR=int(ev(K('#r')).token)\nfor xs in [[0,1],[1,1],[0,R-1],[1,R-1]]:cases.append(('JubjubPoint','Point<Jubjub>','ZIP216 '+str(xs),xs))\nfor sort,ty,label,xs in cases:\n out=ev(K('decodeValue',L(xs),K(sort)));j=oracle(ty,xs)\n if j['status']=='ok':\n  assert len(out.args)==1 and isinstance(out.args[0],KApply);assert ev(K('encodeValue',out.args[0]))==ev(L(list(map(int,j['memory']['%x']['encoded']))))\n else:assert 'decErr' in out.label.name\n print(ty,label,'MATCH',j['status'])\nfor c in ['#jubjub','#curve25519','#secp256k1','#secp256r1']:\n for n in [0,1,13]:assert ev(K('ecMul',K(c),K('identity',K(c)),I(n)))==ev(K('identity',K(c)))\n print('identity multiplication',c,'PASS')\nassert ev(K('ecDouble',K('weierstrass',I(5),I(1),I(0),I(4)),K('pt',I(0),I(0))))==ev(K('inf'))\nprint('Weierstrass y=0 synthetic domain PASS')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
