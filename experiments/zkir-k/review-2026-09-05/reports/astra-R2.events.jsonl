t    fn parse_field_repr(&self, mut repr: &[Fr]) -> Option<AlignedValue> {\n   338\t        let mut value = Vec::new();\n   339\t        parse_field_repr_inner(&self.0, &mut repr, &mut value)?;\n   340\t        Some(AlignedValue {\n   341\t            value: Value(value),\n   342\t            alignment: self.clone(),\n   343\t        })\n   344\t    }\n   345\t\n   346\t    fn max_aligned_size(&self) -> usize {\n   347\t        1 + int_size(self.0.len())\n   348\t            + self\n   349\t                .0\n   350\t                .iter()\n   351\t                .map(AlignmentSegment::max_aligned_size)\n   352\t                .sum::<usize>()\n   353\t    }\n   354\t\n   355\t    fn field_len(&self) -> usize {\n   537\t    fn field_len(&self) -> usize;\n   538\t    fn bin_len(&self) -> usize;\n   539\t}\n   540\t\n   541\timpl AlignmentAtomExt for AlignmentAtom {\n   542\t    fn parse_field_repr(&self, repr: &mut &[Fr]) -> Option<ValueAtom> {\n   543\t        match self {\n   544\t            // Impossible to parse compress from a field!\n   545\t            AlignmentAtom::Compress => None,\n   546\t            AlignmentAtom::Field => {\n   547\t                let res = repr.first()?;\n   548\t                *repr = &repr[1..];\n   549\t                Some(ValueAtom(res.as_le_bytes()).normalize())\n   550\t            }\n   551\t            AlignmentAtom::Bytes { length } => {\n   552\t                bytes_from_field_repr(repr, *length as usize).map(ValueAtom)\n   553\t            }\n   554\t        }\n   555\t    }\n   556\t\n   557\t    fn sample_value_atom<R: Rng + ?Sized>(&self, rng: &mut R) -> ValueAtom\n   558\t    where\n   559\t        Standard: Distribution<Fr>,\n   560\t    {\n   561\t        match self {\n   562\t            Self::Compress | Self::Field => {\n   563\t                let val = rng.r#gen::<Fr>().as_le_bytes();\n   564\t                ValueAtom(val).normalize()\n   565\t            }\n   566\t            Self::Bytes { length } => {\n   567\t                let mut bytes: Vec<u8> = vec![0; *length as usize];\n   568\t                rng.fill_bytes(&mut bytes);\n   569\t                ValueAtom(bytes).normalize()\n   570\t            }\n   571\t        }\n   572\t    }\n   573\t\n   574\t    fn max_aligned_size(&self) -> usize {\n   575\t        match self {\n   576\t            AlignmentAtom::Compress | AlignmentAtom::Field => 2 + FR_BYTES,\n   577\t            AlignmentAtom::Bytes { length } => 2 + int_size(*length as usize) + *length as usize,\n   578\t        }\n1:[topCellInitializer{}(LblinitGeneratedTopCell{}()), org'Stop'kframework'Stop'attributes'Stop'Source{}(\"Source(/home/charl/Moriarty/.worktrees/zkir-k-semantics/experiments/zkir-k/semantics/zkir.k)\")]\n654:  symbol LblinitChipsCell{}() : SortChipsCell{} [function{}(), functional{}(), total{}()]\n655:  symbol LblinitConstraintsCell{}() : SortConstraintsCell{} [function{}(), functional{}(), total{}()]\n656:  symbol LblinitDeadPisCell{}() : SortDeadPisCell{} [function{}(), functional{}(), total{}()]\n657:  symbol LblinitDoCommCell{}() : SortDoCommCell{} [function{}(), functional{}(), total{}()]\n/home/charl/Moriarty/repos/_build/ledger-92e8bdd3/zkir-oracle/Cargo.toml\n/home/charl/Moriarty/repos/_build/ledger-92e8bdd3/zkir-oracle/src/main.rs\n","exit_code":0,"status":"completed"}}
