om pyk.ktool.krun import KRun\n   395\t    krun = KRun(args.definition or default_definition())\n   396\t    kore = krun.kast_to_kore(term, KSort('Program'))\n   397\t    if args.command == 'kore':\n   398\t        print(kore.text)\n   399\t        return 0\n   400\t    from pyk.kore.parser import KoreParser\n   401\t    res = krun.run_process(kore)\n   402\t    if res.returncode not in (0,):\n   403\t        print(res.stderr, file=sys.stderr)\n   404\t        return res.returncode\n   405\t    out = krun.pretty_print(krun.kore_to_kast(KoreParser(res.stdout).pattern()))\n   406\t    print(wf_result(out))\n   407\t    return 0\n   408\t\n   409\t\n   410\tif __name__ == '__main__':\n   242\t  syntax BytesResult ::= #bffrChunks(List, Int, Int, Bytes) [function, total]\n   243\t  rule #bffrChunks(_, Chunks, I, Acc) => bOk(Acc) requires I >=Int Chunks\n   244\t  rule #bffrChunks(Fs, Chunks, I, Acc) => #bffrChunks(Fs, Chunks, I +Int 1, Acc +Bytes Int2Bytes(31, {Fs[Chunks -Int 1 -Int I]}:>Int, LE))\n   245\t    requires I <Int Chunks andBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   246\t  rule #bffrChunks(Fs, Chunks, I, _) => bErr(\"Inputs did not match alignment\")\n   247\t    requires I <Int Chunks andBool notBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   248\t\n   249\t  // --- bits ---------------------------------------------------------------------------\n   250\t  // resolve_operand_bits with a bound: value must be Native and fit in N bits;\n   251\t  // N >= FR_BITS is \"Excessive bit bound\".\n   252\t  syntax CheckResult ::= checkBits(Value, Int) [function, total]\n   253\t  rule checkBits(_, N) => cErr(\"Excessive bit bound\") requires N >=Int #frBits\n   254\t  rule checkBits(native(V), N) => cOk() requires N <Int #frBits andBool fitsBits(V, N)\n   255\t  rule checkBits(native(V), N) => cErr(\"Bit bound failed: \" +String Int2String(V) +String \" is not \" +String Int2String(N) +String \"-bit\")\n   256\t    requires N <Int #frBits andBool notBool fitsBits(V, N)\n   257\t  rule checkBits(V, N) => cErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires N <Int #frBits andBool notBool isNative(V)\n   258\t  syntax Bool ::= isNative(Value) [function, total]\n   259\t  rule isNative(native(_)) => true\n   260\t  rule isNative(_) => false [owise]\n   261\t\n   262\t  // resolve_operand_bool: Native 0 or 1\n   263\t  syntax BoolResult ::= boolOk(Bool) | boolErr(String)\n   264\t  syntax BoolResult ::= asBool(Value) [function, total]\n   265\t  rule asBool(native(0)) => boolOk(false)\n   266\t  rule asBool(native(1)) => boolOk(true)\n   267\t  rule asBool(native(V)) => boolErr(\"Expected boolean, found: \" +String Int2String(V)) requires V =/=Int 0 andBool V =/=Int 1\n   268\t  rule asBool(V) => boolErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires notBool isNative(V)\n   269\tendmodule\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/mod.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/mul.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/ec_mul.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/neg.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/inv.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/encode.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/from_bytes32.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/add.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/eq.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/assign.rs\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zki