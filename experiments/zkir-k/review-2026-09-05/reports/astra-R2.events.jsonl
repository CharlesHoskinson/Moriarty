{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"ls -l .venv/bin/python experiments/zkir-k/semantics/zkir-kompiled/interpreter; command -v krun; sed -n '1,120p' experiments/zkir-k/tools/divergence_tests.py; nl -ba experiments/zkir-k/semantics/zkir-values.k | sed -n '1,115p'; nl -ba /home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_types.rs | sed -n '175,210p'\"","aggregated_output":"lrwxrwxrwx 1 charl charl       79 Sep  3 13:23 .venv/bin/python -> /home/charl/.local/share/uv/python/cpython-3.13-linux-x86_64-gnu/bin/python3.13\n-rwxr-xr-x 1 charl charl 15223040 Sep  5 13:00 experiments/zkir-k/semantics/zkir-kompiled/interpreter\n/home/charl/.nix-profile/bin/krun\n\"\"\"Milestone 5: the divergence findings as executable tests (oracle 2).\n\nEach case is a small ZKIR v3 program written here, a preimage, and the expected\npattern: the off-circuit status on both sides (K witness and Rust\n`preprocess`), and the outcome the constraint checker must assign to one\nspecific gate. Findings refer to arc-zkir docs/zkir-v3-divergence-review.md at\nmidnight-ledger 92e8bdd3 (wiki/zkir/zkir-v3-divergence-review.md); \"K1\" is a\ncandidate found while writing the K semantics.\n\nUsage: uv run --group zkir-k python experiments/zkir-k/tools/divergence_tests.py\nWrites the programs to corpus/divergence/ and exits 0 iff every case matches.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport zkir_kast  # noqa: E402\nimport zkir_values as zv  # noqa: E402\nfrom zkir_run import Runner  # noqa: E402\n\nHERE = Path(__file__).resolve().parent\nOUT = HERE.parent / 'corpus' / 'divergence'\nORACLE = Path.home() / 'Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle'\n\nNATIVE = 'Scalar<BLS12-381>'\n\n\ndef program(inputs, instructions, outputs=(), comm=False):\n    return {'version': {'major': 3, 'minor': 0},\n            'inputs': [{'name': n, 'type': t} for n, t in inputs],\n            'outputs': list(outputs), 'do_communications_commitment': comm,\n            'instructions': instructions}\n\n\ndef hexle(n: int) -> str:\n    b = n.to_bytes((n.bit_length() + 7) // 8 or 1, 'little')\n    return '0x' + b.hex()\n\n\n# --- cases -----------------------------------------------------------------------------\n# (name, finding, program, raw inputs, expected K status, expected Rust status,\n#  gate substring, expected outcome kind, note)\nG8 = zv.JUBJUB_G\nCASES = []\n\nCASES.append(('f02_assert_non_boolean', 'Finding 2',\n    program([('%c', NATIVE)], [{'op': 'assert', 'cond': '%c'}]), [2],\n    'error', 'error', 'assert', 'holds',\n    'off-circuit demands cond == 1, the circuit only cond != 0'))\n\nCASES.append(('f03_guard_uncoupled', 'Finding 3',\n    program([('%g', NATIVE)], [\n        {'op': 'public_input', 'guard': '%g', 'type': NATIVE, 'output': '%x'},\n        {'op': 'add', 'a': '%x', 'b': '0x01', 'output': '%y'}]), [0],\n    'ok', 'ok', 'public_input', 'holds',\n    'an inactive guard yields the default value off-circuit; the gate never mentions the guard'))\n\nCASES.append(('f04_less_than_odd_bits', 'Finding 4',\n    program([('%a', NATIVE), ('%b', NATIVE)], [\n        {'op': 'less_than', 'a': '%a', 'b': '%b', 'bits': 3, 'output': '%lt'}]), [8, 9],\n    'error', 'error', 'less_than', 'unknown',\n    'a = 8 exceeds 3 bits off-circuit; the chip would accept the padded 4-bit bound (output absent, so unknown)'))\n\nCASES.append(('f05_noncanonical_foreign_limbs', 'Finding 5',\n    program([('%x', 'Base<Secp256k1>')], [\n        {'op': 'add', 'a': '%x', 'b': '%x', 'output': '%y'}]),\n    [((zv.K256P + 5 - 1) & ((1 << 192) - 1)), ((zv.K256P + 5 - 1) >> 192)],\n    'ok', 'ok', 'add', 'holds',\n    'limbs encoding p + 5 decode (reduced) as 5 on both sides'))\n\nCASES.append(('f06_cond_select_bytes32', 'Finding 6',\n    program([('%bit', NATIVE), ('%a', 'Bytes<32>'), ('%b', 'Bytes<32>')], [\n        {'op': 'cond_select', 'bit': '%bit', 'a': '%a', 'b': '%b', 'output': '%o'}]),\n    [1, 12345, 7, 999, 0],\n    'ok', 'ok', 'cond_select', 'synthErr',\n    'cond_select on Bytes32 is accepted off-circuit but has no in-circuit arm'))\n\nCASES.append(('f07_constrain_eq_jubjub_scalar', 'Finding 7',\n    program([('%s', 'Scalar<Jubjub>'), ('%t', 'Scalar<Jubjub>')], [\n        {'op': 'constrain_eq', 'a': '%s', 'b': '%t'}]), [42, 42],\n    'ok', 'ok', 'constrain_eq', 'synthErr',\n    'constrain_eq on JubjubScalar is accepted off-circuit but has no in-circuit arm'))\n\nCASES.append(('f08_bytes32_from_low_high_foreign_high', 'Finding 8',\n    program([('%lo', NATIVE), ('%hi', 'Base<Secp256k1>')], [\n        {'op': 'bytes32_from_low_high', 'inputs': ['%lo', '%hi'], 'output': '%b'}]),\n    [12345] + zv.enc_foreign(200, zv.K256P, 64, 4),\n    'ok', 'ok', 'bytes32_from_low_high', 'synthErr',\n    'a foreign high operand is accepted off-circuit, the circuit requires Native'))\n\nCASES.append(('f10_reconstitute_bits_256', 'Finding 10',\n    program([('%d', NATIVE), ('%m', NATIVE)], [\n        {'op': 'reconstitute_field', 'divisor': '%d', 'modulus': '%m', 'bits': 256, 'output': '%o'}]), [1, 1],\n    'wfError', 'error', 'reconstitute_field', 'n/a',\n    'bits >= 256 is rejected statically (Rust off-circuit: Excessive bit count; keygen would underflow)'))\n\n# a Curve25519 point on the curve but outside the prime-order subgroup: (x, -y) of a torsion\n# point... simplest: the order-2 point (0, -1)\nCASES.append(('f11_curve25519_torsion_point', 'Finding 11',\n    program([('%x', 'Base<Curve25519>'), ('%y', 'Base<Curve25519>')], [\n        {'op': 'from_coordinates', 'inputs': ['%x', '%y'], 'output': '%p'}]),\n    zv.enc_foreign(0, zv.C25519P, 64, 4) + zv.enc_foreign(zv.C25519P - 1, zv.C25519P, 64, 4),\n    'error', 'error', 'from_coordinates', 'violated',\n    '(0, -1) has order 2: on the curve, not in the subgroup; off-circuit both sides error, in circuit the cofactor-cleared point is unsatisfiable'))\n\nCASES.append(('f12_ec_mul_generator_p256', 'Finding 12',\n    program([('%s', 'Scalar<Secp256r1>')], [\n        {'op': 'ec_mul_generator', 'scalar': '%s', 'output': '%p'}]),\n    zv.enc_foreign(7, zv.P256N, 64, 4),\n    'error', 'error', 'ec_mul_generator', 'synthErr',\n    'no generator for secp256r1 scalars on either side'))\n\nCASES.append(('f13_chip_gating_from_bytes32', 'Finding 13',\n    program([('%b', 'Bytes<32>')], [\n        {'op': 'from_bytes32', 'bytes': '%b', 'type': 'Base<Secp256k1>', 'output': '%x'},\n     1\t// ZKIR v3 runtime values (ir_types.rs `IrValue`) and their encoding as raw\n     2\t// native field elements (ir_instructions/encode.rs, midnight-circuits 7.2.4\n     3\t// `Instantiable::as_public_input` / `from_public_input`).\n     4\t//\n     5\t//   Native            [x]\n     6\t//   Bytes32           [int_le(bytes[0..31]), bytes[31]]\n     7\t//   JubjubPoint       [x, y]  (affine twisted-Edwards coordinates)\n     8\t//   JubjubScalar      [s]     (252-bit scalar, one element)\n     9\t//   Foreign field K   limbs of (x - 1 mod p) in base 2^LOG2_BASE, NB_LIMBS limbs,\n    10\t//                     grouped 254/LOG2_BASE limbs per element:\n    11\t//                       secp256k1/secp256r1 base and scalar, Curve25519 base:\n    12\t//                         LOG2_BASE 64, 4 limbs, 3 per element  -> 2 elements\n    13\t//                       Curve25519 scalar: LOG2_BASE 51, 5 limbs, 4 per element -> 2 elements\n    14\t//   Weierstrass point enc(x) ++ enc(y) ++ [is_identity]; identity encodes (0,0),\n    15\t//                     i.e. enc(p-1) twice, then 1\n    16\t//   Curve25519 point  enc(x) ++ enc(y)\n    17\trequires \"zkir-syntax.k\"\n    18\trequires \"zkir-curves.k\"\n    19\t\n    20\tmodule ZKIR-VALUES\n    21\t  imports ZKIR-SYNTAX\n    22\t  imports ZKIR-CURVES\n    23\t  imports BYTES\n    24\t  imports LIST\n    25\t  imports STRING\n    26\t\n    27\t  syntax Value ::= native(Int)            [symbol(nativeV)]\n    28\t                 | bytes32(Bytes)         [symbol(bytes32V)]\n    29\t                 | jubjubPoint(Point)     [symbol(jubjubPointV)]\n    30\t                 | jubjubScalar(Int)      [symbol(jubjubScalarV)]\n    31\t                 | secp256k1Point(Point)  [symbol(secp256k1PointV)]\n    32\t                 | secp256k1Base(Int)     [symbol(secp256k1BaseV)]\n    33\t                 | secp256k1Scalar(Int)   [symbol(secp256k1ScalarV)]\n    34\t                 | secp256r1Point(Point)  [symbol(secp256r1PointV)]\n    35\t                 | secp256r1Base(Int)     [symbol(secp256r1BaseV)]\n    36\t                 | secp256r1Scalar(Int)   [symbol(secp256r1ScalarV)]\n    37\t                 | curve25519Point(Point) [symbol(curve25519PointV)]\n    38\t                 | curve25519Base(Int)    [symbol(curve25519BaseV)]\n    39\t                 | curve25519Scalar(Int)  [symbol(curve25519ScalarV)]\n    40\t\n    41\t  syntax IrType ::= typeOf(Value) [function, total]\n    42\t  rule typeOf(native(_))          => native()\n    43\t  rule typeOf(bytes32(_))         => bytes32()\n    44\t  rule typeOf(jubjubPoint(_))     => jubjubPoint()\n    45\t  rule typeOf(jubjubScalar(_))    => jubjubScalar()\n    46\t  rule typeOf(secp256k1Point(_))  => secp256k1Point()\n    47\t  rule typeOf(secp256k1Base(_))   => secp256k1Base()\n    48\t  rule typeOf(secp256k1Scalar(_)) => secp256k1Scalar()\n    49\t  rule typeOf(secp256r1Point(_))  => secp256r1Point()\n    50\t  rule typeOf(secp256r1Base(_))   => secp256r1Base()\n    51\t  rule typeOf(secp256r1Scalar(_)) => secp256r1Scalar()\n    52\t  rule typeOf(curve25519Point(_)) => curve25519Point()\n    53\t  rule typeOf(curve25519Base(_))  => curve25519Base()\n    54\t  rule typeOf(curve25519Scalar(_))=> curve25519Scalar()\n    55\t\n    56\t  // `IrValue::default(t)`: zero / identity of each type.\n    57\t  syntax Value ::= defaultValue(IrType) [function, total]\n    58\t  rule defaultValue(native())          => native(0)\n    59\t  rule defaultValue(bytes32())         => bytes32(padRightBytes(.Bytes, 32, 0))\n    60\t  rule defaultValue(jubjubPoint())     => jubjubPoint(pt(0, 1))\n    61\t  rule defaultValue(jubjubScalar())    => jubjubScalar(0)\n    62\t  rule defaultValue(secp256k1Point())  => secp256k1Point(inf())\n    63\t  rule defaultValue(secp256k1Base())   => secp256k1Base(0)\n    64\t  rule defaultValue(secp256k1Scalar()) => secp256k1Scalar(0)\n    65\t  rule defaultValue(secp256r1Point())  => secp256r1Point(inf())\n    66\t  rule defaultValue(secp256r1Base())   => secp256r1Base(0)\n    67\t  rule defaultValue(secp256r1Scalar()) => secp256r1Scalar(0)\n    68\t  rule defaultValue(curve25519Point()) => curve25519Point(pt(0, 1))\n    69\t  rule defaultValue(curve25519Base())  => curve25519Base(0)\n    70\t  rule defaultValue(curve25519Scalar())=> curve25519Scalar(0)\n    71\t\n    72\t  // Debug-style names matching the Rust variant names (used by the oracle).\n    73\t  syntax String ::= typeName(IrType) [function, total]\n    74\t  rule typeName(native())          => \"Native\"\n    75\t  rule typeName(bytes32())         => \"Bytes32\"\n    76\t  rule typeName(jubjubPoint())     => \"JubjubPoint\"\n    77\t  rule typeName(jubjubScalar())    => \"JubjubScalar\"\n    78\t  rule typeName(secp256k1Point())  => \"Secp256k1Point\"\n    79\t  rule typeName(secp256k1Base())   => \"Secp256k1Base\"\n    80\t  rule typeName(secp256k1Scalar()) => \"Secp256k1Scalar\"\n    81\t  rule typeName(secp256r1Point())  => \"Secp256r1Point\"\n    82\t  rule typeName(secp256r1Base())   => \"Secp256r1Base\"\n    83\t  rule typeName(secp256r1Scalar()) => \"Secp256r1Scalar\"\n    84\t  rule typeName(curve25519Point()) => \"Curve25519Point\"\n    85\t  rule typeName(curve25519Base())  => \"Curve25519Base\"\n    86\t  rule typeName(curve25519Scalar())=> \"Curve25519Scalar\"\n    87\t\n    88\t  // --- Foreign-field limb encoding -------------------------------------------------\n    89\t  // encForeign(x, p, log2Base, nbLimbs): list of native elements.\n    90\t  syntax List ::= encForeign(Int, Int, Int, Int) [function, total]\n    91\t  rule encForeign(X, P, L, NB) => #groupLimbs(fsub(X, 1, P), L, NB, 254 /Int L)\n    92\t  // #groupLimbs(e, log2Base, limbsLeft, perBatch): successive batches of perBatch limbs\n    93\t  syntax List ::= #groupLimbs(Int, Int, Int, Int) [function, total]\n    94\t  rule #groupLimbs(_, _, NB, _) => .List requires NB <=Int 0\n    95\t  rule #groupLimbs(E, L, NB, B) => ListItem(lowBits(E, L *Int minInt(NB, B))) #groupLimbs(highBits(E, L *Int minInt(NB, B)), L, NB -Int minInt(NB, B), B)\n    96\t    requires NB >Int 0\n    97\t\n    98\t  // decForeign(fields, p, log2Base, nbLimbs): the element, or -1 when the\n    99\t  // encoding is invalid (wrong count, batch too large, non-zero tail limbs).\n   100\t  syntax Int ::= decForeign(List, Int, Int, Int) [function, total]\n   101\t  rule decForeign(Fs, P, L, NB) => -1\n   102\t    requires size(Fs) =/=Int (NB +Int (254 /Int L) -Int 1) /Int (254 /Int L)\n   103\t  rule decForeign(Fs, P, L, NB) => #decForeign(Fs, P, L, NB, 254 /Int L, 0, 0)\n   104\t    requires size(Fs) ==Int (NB +Int (254 /Int L) -Int 1) /Int (254 /Int L)\n   105\t  // #decForeign(fields, p, log2, nb, perBatch, accumulated, limbsSeen)\n   106\t  syntax Int ::= #decForeign(List, Int, Int, Int, Int, Int, Int) [function, total]\n   107\t  rule #decForeign(.List, P, L, NB, _, Acc, _) => fadd(Acc, 1, P)\n   108\t    requires fitsBits(Acc, L *Int NB)\n   109\t  rule #decForeign(.List, _, L, NB, _, Acc, _) => -1\n   110\t    requires notBool fitsBits(Acc, L *Int NB)\n   111\t  rule #decForeign(ListItem(F) Fs, P, L, NB, B, Acc, Seen) => -1\n   112\t    requires notBool fitsBits(F, L *Int B)\n   113\t  rule #decForeign(ListItem(F) Fs, P, L, NB, B, Acc, Seen)\n   114\t    => #decForeign(Fs, P, L, NB, B, Acc +Int (F <<Int (L *Int Seen)), Seen +Int B)\n   115\t    requires fitsBits(F, L *Int B)\n   175\t\n   176\t            IrValue::Curve25519Point(_) => IrType::Curve25519Point,\n   177\t            IrValue::Curve25519Base(_) => IrType::Curve25519Base,\n   178\t            IrValue::Curve25519Scalar(_) => IrType::Curve25519Scalar,\n   179\t        }\n   180\t    }\n   181\t\n   182\t    pub(crate) fn default(val_t: &IrType) -> Self {\n   183\t        match val_t {\n   184\t            IrType::Native => IrValue::Native(Fr::default()),\n   185\t            IrType::Bytes32 => IrValue::Bytes32([u8::default(); 32]),\n   186\t            IrType::JubjubPoint => IrValue::JubjubPoint(JubjubSubgroup::default()),\n   187\t            IrType::JubjubScalar => IrValue::JubjubScalar(JubjubFr::default()),\n   188\t\n   189\t            IrType::Secp256k1Point => IrValue::Secp256k1Point(k256::K256::default()),\n   190\t            IrType::Secp256k1Base => IrValue::Secp256k1Base(k256::Fp::default()),\n   191\t            IrType::Secp256k1Scalar => IrValue::Secp256k1Scalar(k256::Fq::default()),\n   192\t\n   193\t            IrType::Secp256r1Point => IrValue::Secp256r1Point(p256::P256::default()),\n   194\t            IrType::Secp256r1Base => IrValue::Secp256r1Base(p256::Fp::default()),\n   195\t            IrType::Secp256r1Scalar => IrValue::Secp256r1Scalar(p256::Fq::default()),\n   196\t\n   197\t            IrType::Curve25519Point => {\n   198\t                IrValue::Curve25519Point(curve25519::Curve25519Subgroup::default())\n   199\t            }\n   200\t            IrType::Curve25519Base => IrValue::Curve25519Base(curve25519::Fp::default()),\n   201\t            IrType::Curve25519Scalar => IrValue::Curve25519Scalar(curve25519::Scalar::default()),\n   202\t        }\n   203\t    }\n   204\t}\n   205\t\n   206\t/// In-circuit IR value, this is a placeholder for an [IrValue], a circuit\n   207\t/// variable that does not necessarily carry actual data (it will carry data\n   208\t/// during the proving process, but not dur