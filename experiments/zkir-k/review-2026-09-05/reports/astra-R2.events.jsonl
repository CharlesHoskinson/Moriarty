  x.get_type(),\n64:         )),\n65:     }\n66: }\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/inv.rs\n39: pub fn inv_offcircuit(x: &IrValue) -> Result<IrValue, anyhow::Error> {\n40:     use IrValue::*;\n41:     let zero_err = || anyhow::anyhow!(\"cannot invert zero of type {:?}\", x.get_type());\n42:     match x {\n43:         Native(a) => Option::from(a.0.invert())\n44:             .ok_or_else(zero_err)\n45:             .map(Fr)\n46:             .map(Native),\n47: \n48:         Secp256k1Base(s) => Option::from(s.invert())\n49:             .ok_or_else(zero_err)\n50:             .map(Secp256k1Base),\n51: \n52:         Secp256k1Scalar(s) => Option::from(s.invert())\n53:             .ok_or_else(zero_err)\n54:             .map(Secp256k1Scalar),\n55: \n56:         Secp256r1Base(s) => Option::from(s.invert()).ok_or_else(zero_err).map(Secp256r1Base),\n57: \n58:         Secp256r1Scalar(s) => Option::from(s.invert())\n59:             .ok_or_else(zero_err)\n60:             .map(Secp256r1Scalar),\n61: \n62:         Curve25519Base(s) => Option::from(s.invert())\n63:             .ok_or_else(zero_err)\n64:             .map(Curve25519Base),\n65: \n66:         // Nb. dalek's inherent `Scalar::invert` (which is not a `CtOption`)\n67:         // would shadow `Field::invert` here, hence the qualified call.\n68:         Curve25519Scalar(s) => Option::from(Field::invert(s))\n69:             .ok_or_else(zero_err)\n70:             .map(Curve25519Scalar),\n71: \n72:         _ => Err(anyhow::anyhow!(\n73:             \"Unsupported inversion of {:?}\",\n74:             x.get_type(),\n75:         )),\n76:     }\n77: }\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/eq.rs\n42: pub fn test_eq_offcircuit(a: &IrValue, b: &IrValue) -> Result<bool, anyhow::Error> {\n43:     use IrValue::*;\n44:     match (a, b) {\n45:         (Native(x), Native(y)) => Ok(x == y),\n46:         (Bytes32(xs), Bytes32(ys)) => Ok(xs == ys),\n47:         (JubjubPoint(p), JubjubPoint(q)) => Ok(p == q),\n48: \n49:         (Secp256k1Point(p), Secp256k1Point(q)) => Ok(p == q),\n50:         (Secp256k1Base(s), Secp256k1Base(r)) => Ok(s == r),\n51:         (Secp256k1Scalar(s), Secp256k1Scalar(r)) => Ok(s == r),\n52: \n53:         (Secp256r1Point(p), Secp256r1Point(q)) => Ok(p == q),\n54:         (Secp256r1Base(s), Secp256r1Base(r)) => Ok(s == r),\n55:         (Secp256r1Scalar(s), Secp256r1Scalar(r)) => Ok(s == r),\n56: \n57:         (Curve25519Point(p), Curve25519Point(q)) => Ok(p == q),\n58:         (Curve25519Base(s), Curve25519Base(r)) => Ok(s == r),\n59:         (Curve25519Scalar(s), Curve25519Scalar(r)) => Ok(s == r),\n60: \n61:         _ => Err(anyhow::anyhow!(\n62:             \"Unsupported test_eq: {:?} == {:?}\",\n63:             a.get_type(),\n64:             b.get_type()\n65:         )),\n66:     }\n67: }\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/constrain_eq.rs\n42: pub fn constrain_eq_offcircuit(a: &IrValue, b: &IrValue) -> Result<(), anyhow::Error> {\n43:     if a.get_type() != b.get_type() {\n44:         return Err(anyhow::anyhow!(\n45:             \"Unsupported constrain_eq: {:?} == {:?}\",\n46:             a.get_type(),\n47:             b.get_type()\n48:         ));\n49:     }\n50: \n51:     if a != b {\n52:         return Err(anyhow::anyhow!(\n53:             \"Equality constraint failed: {a:?} != {b:?}\"\n54:         ));\n55:     }\n56: \n57:     Ok(())\n58: }\n/home/charl/Moriarty/repos/_extracts/ledger9-92e8bdd3-zkir-v3-src/zkir-v3/src/ir_instructions/select.rs\n43: pub fn select_offcircuit(bit: bool, a: &IrValue, b: &IrValue) -> Result<IrValue, anyhow::Error> {\n44:     if a.get_type() != b.get_type() {\n45:         return Err(anyhow::anyhow!(\n46:             \"Unsupported cond_select: {:?} ? {:?}\",\n47:             a.get_type(),\n48:             b.get_type()\n49:         ));\n50:     }\n51:     Ok(if bit { a.clone(