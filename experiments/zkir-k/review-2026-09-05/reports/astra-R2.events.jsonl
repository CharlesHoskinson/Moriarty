.K256_G, lambda k: zv.w_mul(zv.K256_G, k, zv.K256P, 0), [], True),\n    29\t    'secp256r1': ('Point<Secp256r1>', 'Scalar<Secp256r1>', 'Base<Secp256r1>', zv.P256_G, lambda k: zv.w_mul(zv.P256_G, k, zv.P256P, zv.P256P - 3), [], False),\n    30\t    'curve25519': ('Point<Curve25519>', 'Scalar<Curve25519>', 'Base<Curve25519>', zv.C25519_G, lambda k: zv.ed_mul(zv.C25519_G, k, zv.C25519P, zv.C25519_D), [], False),\n    31\t}\n    32\tfor name, (pt, sc, base, g, mul, _, has_gen) in CURVES.items():\n    33\t    p = mul(7)\n    34\t    q = mul(11)\n    35\t    if name == 'jubjub':\n    36\t        raw = [p[0], p[1], q[0], q[1], 5, p[0], p[1]]\n    37\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', NATIVE), ('%y', NATIVE)]\n    38\t    elif name == 'curve25519':\n    39\t        raw = zv.enc_foreign(p[0], zv.C25519P, 64, 4) + zv.enc_foreign(p[1], zv.C25519P, 64, 4) + zv.enc_foreign(q[0], zv.C25519P, 64, 4) + zv.enc_foreign(q[1], zv.C25519P, 64, 4) + zv.enc_foreign(5, zv.C25519L, 51, 5) + zv.enc_foreign(p[0], zv.C25519P, 64, 4) + zv.enc_foreign(p[1], zv.C25519P, 64, 4)\n    40\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', base), ('%y', base)]\n    41\t    else:\n    42\t        mod, order = (zv.K256P, zv.K256N) if name == 'secp256k1' else (zv.P256P, zv.P256N)\n    43\t        raw = zv.enc_wpoint(p, mod) + zv.enc_wpoint(q, mod) + zv.enc_foreign(5, order, 64, 4) + zv.enc_foreign(p[0], mod, 64, 4) + zv.enc_foreign(p[1], mod, 64, 4)\n    44\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', base), ('%y', base)]\n    45\t    ins = [\n    46\t        {'op': 'add', 'a': '%p', 'b': '%q', 'output': '%sum'},\n    47\t        {'op': 'neg', 'a': '%p', 'output': '%negp'},\n    48\t        {'op': 'add', 'a': '%sum', 'b': '%negp', 'output': '%q2'},\n    49\t        {'op': 'test_eq', 'a': '%q2', 'b': '%q', 'output': '%eq'},\n    50\t        {'op': 'assert', 'cond': '%eq'},\n    51\t        {'op': 'constrain_eq', 'a': '%q2', 'b': '%q'},\n    52\t        {'op': 'ec