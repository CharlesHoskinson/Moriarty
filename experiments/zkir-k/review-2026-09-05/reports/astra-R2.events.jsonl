{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-ops.k'","aggregated_output":"     1\t// Off-circuit value operations of ZKIR v3 (`ir_instructions/*.rs` at\n     2\t// midnight-ledger 92e8bdd3), one function per Rust `*_offcircuit` function.\n     3\t// Every function returns vOk(value) or vErr(message); the messages follow the\n     4\t// Rust `anyhow!` texts closely enough to recognise them.\n     5\trequires \"zkir-values.k\"\n     6\trequires \"zkir-hash.k\"\n     7\t\n     8\tmodule ZKIR-OPS\n     9\t  imports ZKIR-VALUES\n    10\t  imports ZKIR-HASH\n    11\t  imports STRING\n    12\t\n    13\t  syntax ValueResult ::= vOk(Value) | vErr(String)\n    14\t  syntax PairResult  ::= pOk(Value, Value) | pErr(String)\n    15\t  syntax CheckResult ::= cOk() | cErr(String)\n    16\t\n    17\t  // --- helpers -------------------------------------------------------------------\n    18\t  syntax String ::= tn(Value) [function, total]\n    19\t  rule tn(V) => typeName(typeOf(V))\n    20\t\n    21\t  syntax Bool ::= sameType(Value, Value) [function, total]\n    22\t  rule sameType(A, B) => typeOf(A) ==K typeOf(B)\n    23\t\n    24\t  // `TryFrom<IrValue> for Fr`\n    25\t  syntax IntResult ::= iOk(Int) | iErr(String)\n    26\t  syntax IntResult ::= asNative(Value) [function, total]\n    27\t  rule asNative(native(X)) => iOk(X)\n    28\t  rule asNative(V) => iErr(\"cannot convert \" +String tn(V) +String \" to Native\") [owise]\n    29\t  syntax BytesResult ::= bOk(Bytes) | bErr(String)\n    30\t  syntax BytesResult ::= asBytes32(Value) [function, total]\n    31\t  rule asBytes32(bytes32(B)) => bOk(B)\n    32\t  rule asBytes32(V) => bErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n    33\t\n    34\t  // --- add ---------------------------------------------------------------------------\n    35\t  syntax ValueResult ::= addV(Value, Value) [function, total]\n    36\t  rule addV(native(A), native(B))                   => vOk(native(fadd(A, B, #r)))\n    37\t  rule addV(jubjubPoint(P), jubjubPoint(Q))         => vOk(jubjubPoint(ecAdd(#jubjub, P, Q)))\n    38\t  rule addV(secp256k1Point(P), secp256k1Point(Q))   => vOk(secp256k1Point(ecAdd(#secp256k1, P, Q)))\n    39\t  rule addV(secp256k1Base(A), secp256k1Base(B))     => vOk(secp256k1Base(fadd(A, B, #k256P)))\n    40\t  rule addV(secp256k1Scalar(A), secp256k1Scalar(B)) => vOk(secp256k1Scalar(fadd(A, B, #k256N)))\n    41\t  rule addV(secp256r1Point(P), secp256r1Point(Q))   => vOk(secp256r1Point(ecAdd(#secp256r1, P, Q)))\n    42\t  rule addV(secp256r1Base(A), secp256r1Base(B))     => vOk(secp256r1Base(fadd(A, B, #p256P)))\n    43\t  rule addV(secp256r1Scalar(A), secp256r1Scalar(B)) => vOk(secp256r1Scalar(fadd(A, B, #p256N)))\n    44\t  rule addV(curve25519Point(P), curve25519Point(Q)) => vOk(curve25519Point(ecAdd(#curve25519, P, Q)))\n    45\t  rule addV(curve25519Base(A), curve25519Base(B))   => vOk(curve25519Base(fadd(A, B, #c25519P)))\n    46\t  rule addV(curve25519Scalar(A), curve25519Scalar(B)) => vOk(curve25519Scalar(fadd(A, B, #c25519L)))\n    47\t  rule addV(A, B) => vErr(\"Unsupported addition: \" +String tn(A) +String \" + \" +String tn(B)) [owise]\n    48\t\n    49\t  // --- mul ---------------------------------------------------------------------------\n    50\t  syntax ValueResult ::= mulV(Value, Value) [function, total]\n    51\t  rule mulV(native(A), native(B))                   => vOk(native(fmul(A, B, #r)))\n    52\t  rule mulV(secp256k1Base(A), secp256k1Base(B))     => vOk(secp256k1Base(fmul(A, B, #k256P)))\n    53\t  rule mulV(secp256k1Scalar(A), secp256k1Scalar(B)) => vOk(secp256k1Scalar(fmul(A, B, #k256N)))\n    54\t  rule mulV(secp256r1Base(A), secp256r1Base(B))     => vOk(secp256r1Base(fmul(A, B, #p256P)))\n    55\t  rule mulV(secp256r1Scalar(A), secp256r1Scalar(B)) => vOk(secp256r1Scalar(fmul(A, B, #p256N)))\n    56\t  rule mulV(curve25519Base(A), curve25519Base(B))   => vOk(curve25519Base(fmul(A, B, #c25519P)))\n    57\t  rule mulV(curve25519Scalar(A), curve25519Scalar(B)) => vOk(curve25519Scalar(fmul(A, B, #c25519L)))\n    58\t  rule mulV(A, B) => vErr(\"Unsupported multiplication: \" +String tn(A) +String \" x \" +String tn(B)) [owise]\n    59\t\n    60\t  // --- neg ---------------------------------------------------------------------------\n    61\t  syntax ValueResult ::= negV(Value) [function, total]\n    62\t  rule negV(native(A))          => vOk(native(fneg(A, #r)))\n    63\t  rule negV(jubjubPoint(P))     => vOk(jubjubPoint(ecNeg(#jubjub, P)))\n    64\t  rule negV(secp256k1Point(P))  => vOk(secp256k1Point(ecNeg(#secp256k1, P)))\n    65\t  rule negV(secp256k1Base(A))   => vOk(secp256k1Base(fneg(A, #k256P)))\n    66\t  rule negV(secp256k1Scalar(A)) => vOk(secp256k1Scalar(fneg(A, #k256N)))\n    67\t  rule negV(secp256r1Point(P))  => vOk(secp256r1Point(ecNeg(#secp256r1, P)))\n    68\t  rule negV(secp256r1Base(A))   => vOk(secp256r1Base(fneg(A, #p256P)))\n    69\t  rule negV(secp256r1Scalar(A)) => vOk(secp256r1Scalar(fneg(A, #p256N)))\n    70\t  rule negV(curve25519Point(P)) => vOk(curve25519Point(ecNeg(#curve25519, P)))\n    71\t  rule negV(curve25519Base(A))  => vOk(curve25519Base(fneg(A, #c25519P)))\n    72\t  rule negV(curve25519Scalar(A))=> vOk(curve25519Scalar(fneg(A, #c25519L)))\n    73\t  rule negV(A) => vErr(\"Unsupported negation of \" +String tn(A)) [owise]\n    74\t\n    75\t  // --- inv ---------------------------------------------------------------------------\n    76\t  syntax ValueResult ::= invV(Value) [function, total]\n    77\t  rule invV(native(0))          => vErr(\"cannot invert zero of type Native\")\n    78\t  rule invV(native(A))          => vOk(native(finv(A, #r))) requires A =/=Int 0\n    79\t  rule invV(secp256k1Base(A))   => #invField(A, #k256P, secp256k1Base())\n    80\t  rule invV(secp256k1Scalar(A)) => #invField(A, #k256N, secp256k1Scalar())\n    81\t  rule invV(secp256r1Base(A))   => #invField(A, #p256P, secp256r1Base())\n    82\t  rule invV(secp256r1Scalar(A)) => #invField(A, #p256N, secp256r1Scalar())\n    83\t  rule invV(curve25519Base(A))  => #invField(A, #c25519P, curve25519Base())\n    84\t  rule invV(curve25519Scalar(A))=> #invField(A, #c25519L, curve25519Scalar())\n    85\t  rule invV(A) => vErr(\"Unsupported inversion of \" +String tn(A)) [owise]\n    86\t  syntax ValueResult ::= #invField(Int, Int, IrType) [function, total]\n    87\t  rule #invField(0, _, T) => vErr(\"cannot invert zero of type \" +String typeName(T))\n    88\t  rule #invField(A, P, T) => vOk(#wrapField(finv(A, P), T)) requires A =/=Int 0\n    89\t  syntax Value ::= #wrapField(Int, IrType) [function, total]\n    90\t  rule #wrapField(X, native())          => native(X)\n    91\t  rule #wrapField(X, secp256k1Base())   => secp256k1Base(X)\n    92\t  rule #wrapField(X, secp256k1Scalar()) => secp256k1Scalar(X)\n    93\t  rule #wrapField(X, secp256r1Base())   => secp256r1Base(X)\n    94\t  rule #wrapField(X, secp256r1Scalar()) => secp256r1Scalar(X)\n    95\t  rule #wrapField(X, curve25519Base())  => curve25519Base(X)\n    96\t  rule #wrapField(X, curve25519Scalar())=> curve25519Scalar(X)\n    97\t  rule #wrapField(X, jubjubScalar())    => jubjubScalar(X)\n    98\t  rule #wrapField(X, _)                 => native(X) [owise]\n    99\t\n   100\t  // --- test_eq / constrain_eq / cond_select --------------------------------------------\n   101\t  syntax Bool ::= eqSupported(Value, Value) [function, total]\n   102\t  rule eqSupported(A, B) => sameType(A, B)\n   103\t  syntax ValueResult ::= testEqV(Value, Value) [function, total]\n   104\t  rule testEqV(A, B) => vOk(native(bool2Word(A ==K B))) requires sameType(A, B)\n   105\t  rule testEqV(A, B) => vErr(\"Unsupported test_eq: \" +String tn(A) +String \" == \" +String tn(B)) requires notBool sameType(A, B)\n   106\t  syntax Int ::= bool2Word(Bool) [function, total]\n   107\t  rule bool2Word(true) => 1\n   108\t  rule bool2Word(false) => 0\n   109\t\n   110\t  syntax CheckResult ::= constrainEqV(Value, Value) [function, total]\n   111\t  rule constrainEqV(A, B) => cErr(\"Unsupported constrain_eq: \" +String tn(A) +String \" == \" +String tn(B)) requires notBool sameType(A, B)\n   112\t  rule constrainEqV(A, B) => cOk() requires sameType(A, B) andBool A ==K B\n   113\t  rule constrainEqV(A, B) => cErr(\"Equality constraint failed\") requires sameType(A, B) andBool A =/=K B\n   114\t\n   115\t  syntax ValueResult ::= selectV(Bool, Value, Value) [function, total]\n   116\t  rule selectV(_, A, B) => vErr(\"Unsupported cond_select: \" +String tn(A) +String \" ? \" +String tn(B)) requires notBool sameType(A, B)\n   117\t  rule selectV(true, A, B) => vOk(A) requires sameType(A, B)\n   118\t  rule selectV(false, A, B) => vOk(B) requires sameType(A, B)\n   119\t\n   120\t  // --- curves ------------------------------------------------------------------------\n   121\t  syntax ValueResult ::= ecMulV(Value, Value) [function, total]\n   122\t  rule ecMulV(jubjubPoint(P), jubjubScalar(S))         => vOk(jubjubPoint(ecMul(#jubjub, P, S)))\n   123\t  rule ecMulV(secp256k1Point(P), secp256k1Scalar(S))   => vOk(secp256k1Point(ecMul(#secp256k1, P, S)))\n   124\t  rule ecMulV(secp256r1Point(P), secp256r1Scalar(S))   => vOk(secp256r1Point(ecMul(#secp256r1, P, S)))\n   125\t  rule ecMulV(curve25519Point(P), curve25519Scalar(S)) => vOk(curve25519Point(ecMul(#curve25519, P, S)))\n   126\t  rule ecMulV(A, B) => vErr(\"Unsupported EC multiplication: \" +String tn(A) +String \" x \" +String tn(B)) [owise]\n   127\t\n   128\t  syntax ValueResult ::= ecMulGeneratorV(Value) [function, total]\n   129\t  rule ecMulGeneratorV(jubjubScalar(S))    => vOk(jubjubPoint(ecMul(#jubjub, #jubjubGenerator, S)))\n   130\t  rule ecMulGeneratorV(secp256k1Scalar(S)) => vOk(secp256k1Point(ecMul(#secp256k1, #secp256k1Generator, S)))\n   131\t  rule ecMulGeneratorV(A) => vErr(\"Unsupported EcMulGenerator for scalar of type \" +String tn(A)) [owise]\n   132\t\n   133\t  syntax PairResult ::= intoCoordinatesV(Value) [function, total]\n   134\t  rule intoCoordinatesV(jubjubPoint(pt(X, Y)))     => pOk(native(X), native(Y))\n   135\t  rule intoCoordinatesV(jubjubPoint(inf()))        => pOk(native(0), native(1))\n   136\t  rule intoCoordinatesV(secp256k1Point(inf()))     => pErr(\"Cannot extract coordinates of the Secp256k1 identity\")\n   137\t  rule intoCoordinatesV(secp256k1Point(pt(X, Y)))  => pOk(secp256k1Base(X), secp256k1Base(Y))\n   138\t  rule intoCoordinatesV(secp256r1Point(inf()))     => pErr(\"Cannot extract coordinates of the Secp256r1 identity\")\n   139\t  rule intoCoordinatesV(secp256r1Point(pt(X, Y)))  => pOk(secp256r1Base(X), secp256r1Base(Y))\n   140\t  rule intoCoordinatesV(curve25519Point(pt(X, Y))) => pOk(curve25519Base(X), curve25519Base(Y))\n   141\t  rule intoCoordinatesV(curve25519Point(inf()))    => pOk(curve25519Base(0), curve25519Base(1))\n   142\t  rule intoCoordinatesV(A) => pErr(\"Unsupported coordinate extraction of \" +String tn(A)) [owise]\n   143\t\n   144\t  syntax ValueResult ::= fromCoordinatesV(Value, Value) [function, total]\n   145\t  rule fromCoordinatesV(native(X), native(Y))                 => #ptToValue(jubjubFromXY(X, Y), #jubjub, jubjubPoint(), \"Cannot build a Jubjub point\")\n   146\t  rule fromCoordinatesV(secp256k1Base(X), secp256k1Base(Y))   => #ptToValue(fromXY(#secp256k1, X, Y), #secp256k1, secp256k1Point(), \"Cannot build a Secp256k1Point point\")\n   147\t  rule fromCoordinatesV(secp256r1Base(X), secp256r1Base(Y))   => #ptToValue(fromXY(#secp256r1, X, Y), #secp256r1, secp256r1Point(), \"Cannot build a Secp256r1Point point\")\n   148\t  rule fromCoordinatesV(curve25519Base(X), curve25519Base(Y)) => #ptToValue(fromXY(#curve25519, X, Y), #curve25519, curve25519Point(), \"Cannot build a Curve25519Point point\")\n   149\t  rule fromCoordinatesV(A, B) => vErr(\"Unsupported `from_coordinates` on (\" +String tn(A) +String \", \" +String tn(B) +String \")\") [owise]\n   150\t  syntax ValueResult ::= #ptToValue(PointResult, Curve, IrType, String) [function, total]\n   151\t  rule #ptToValue(ptErr(_), _, _, Msg) => vErr(Msg)\n   152\t  rule #ptToValue(ptOk(Q), C, T, _) => vOk(#wrapPoint(Q, T)) requires inSubgroup(C, Q)\n   153\t  rule #ptToValue(ptOk(Q), C, _, Msg) => vErr(Msg) requires notBool inSubgroup(C, Q)\n   154\t\n   155\t  // --- bytes -----------------------------------------------------------------------------\n   156\t  syntax ValueResult ::= intoBytes32V(Value) [function, total]\n   157\t  rule intoBytes32V(native(X))          => vOk(bytes32(intToBytes32(X)))\n   158\t  rule intoBytes32V(secp256k1Base(X))   => vOk(bytes32(intToBytes32(X)))\n   159\t  rule intoBytes32V(secp256k1Scalar(X)) => vOk(bytes32(intToBytes32(X)))\n   160\t  rule intoBytes32V(secp256r1Base(X))   => vOk(bytes32(intToBytes32(X)))\n   161\t  rule intoBytes32V(secp256r1Scalar(X)) => vOk(bytes32(intToBytes32(X)))\n   162\t  rule intoBytes32V(curve25519Base(X))  => vOk(bytes32(intToBytes32(X)))\n   163\t  rule intoBytes32V(curve25519Scalar(X))=> vOk(bytes32(intToBytes32(X)))\n   164\t  rule intoBytes32V(A) => vErr(\"Unsupported into_bytes32 for \" +String tn(A)) [owise]\n   165\t\n   166\t  // from_bytes32: little-endian integer reduced modulo the target field\n   167\t  syntax ValueResult ::= fromBytes32V(IrType, Bytes) [function, total]\n   168\t  rule fromBytes32V(native(), B)          => vOk(native(bytes32ToInt(B) modInt #r))\n   169\t  rule fromBytes32V(secp256k1Base(), B)   => vOk(secp256k1Base(bytes32ToInt(B) modInt #k256P))\n   170\t  rule fromBytes32V(secp256k1Scalar(), B) => vOk(secp256k1Scalar(bytes32ToInt(B) modInt #k256N))\n   171\t  rule fromBytes32V(secp256r1Base(), B)   => vOk(secp256r1Base(bytes32ToInt(B) modInt #p256P))\n   172\t  rule fromBytes32V(secp256r1Scalar(), B) => vOk(secp256r1Scalar(bytes32ToInt(B) modInt #p256N))\n   173\t  rule fromBytes32V(curve25519Base(), B)  => vOk(curve25519Base(bytes32ToInt(B) modInt #c25519P))\n   174\t  rule fromBytes32V(curve25519Scalar(), B)=> vOk(curve25519Scalar(bytes32ToInt(B) modInt #c25519L))\n   175\t  rule fromBytes32V(T, _) => vErr(\"Unsupported from_bytes32 for type \" +String typeName(T)) [owise]\n   176\t\n   177\t  // bytes32_into_low_high: low = first 31 bytes as a native element, high = byte 31\n   178\t  syntax PairResult ::= bytes32IntoLowHighV(Bytes) [function, total]\n   179\t  rule bytes32IntoLowHighV(B) => pOk(native(Bytes2Int(substrBytes(B, 0, 31), LE, Unsigned) modInt #r), native(B[31]))\n   180\t\n   181\t  // bytes32_from_low_high: both operands must be native; low < 2^248, high < 256\n   182\t  syntax ValueResult ::= bytes32FromLowHighV(Value, Value) [function, total]\n   183\t  rule bytes32FromLowHighV(native(L), native(H)) => vOk(bytes32(replaceAtBytes(intToBytes32(L), 31, Int2Bytes(1, H, LE))))\n   184\t    requires fitsBits(L, 248) andBool fitsBits(H, 8)\n   185\t  rule bytes32FromLowHighV(native(L), native(H)) => vErr(\"Bytes32FromLowHigh: low operand must fit in 31 bytes (be less than 2^248) and high operand must fit in a single byte (be less than 256)\")\n   186\t    requires notBool (fitsBits(L, 248) andBool fitsBits(H, 8))\n   187\t  // Rust: into_bytes32_offcircuit on each operand first, so non-field operands fail there\n   188\t  rule bytes32FromLowHighV(A, B) => #lowHighErr(intoBytes32V(A), intoBytes32V(B)) [owise]\n   189\t  syntax ValueResult ::= #lowHighErr(ValueResult, ValueResult) [function, total]\n   190\t  rule #lowHighErr(vErr(S), _) => vErr(S)\n   191\t  rule #lowHighErr(vOk(_), vErr(S)) => vErr(S)\n   192\t  rule #lowHighErr(vOk(bytes32(BL)), vOk(bytes32(BH))) => vOk(bytes32(replaceAtBytes(BL, 31, substrBytes(BH, 0, 1))))\n   193\t    requires BL[31] ==Int 0 andBool Bytes2Int(substrBytes(BH, 1, 32), LE, Unsigned) ==Int 0\n   194\t  rule #lowHighErr(vOk(_), vOk(_)) => vErr(\"Bytes32FromLowHigh: low operand must fit in 31 bytes (be less than 2^248) and high operand must fit in a single byte (be less than 256)\") [owise]\n   195\t\n   196\t  // --- hashes --------------------------------------------------------------------------\n   197\t  // All inputs of transient_hash / hash_to_curve must be Native.\n   198\t  syntax IntsResult ::= isOk(List) | isErr(String)\n   199\t  syntax IntsResult ::= asNatives(List) [function, total]\n   200\t  rule asNatives(.List) => isOk(.List)\n   201\t  rule asNatives(ListItem(V) Vs) => #consNative(asNative(V), asNatives(Vs))\n   202\t  syntax IntsResult ::= #consNative(IntResult, IntsResult) [function, total]\n   203\t  rule #consNative(iErr(S), _) => isErr(S)\n   204\t  rule #consNative(iOk(_), isErr(S)) => isErr(S)\n   205\t  rule #consNative(iOk(X), isOk(L)) => isOk(ListItem(X) L)\n   206\t\n   207\t  // persistent_hash / keccak256 preimage: parse the field elements by the\n   208\t  // alignment (transient-crypto AlignmentAtomExt::parse_field_repr) and lay\n   209\t  // the atoms out as bytes (ValueAtomExt::binary_repr_unchecked). Only atom\n   210\t  // segments are supported; `option` segments and `compress` atoms are\n   211\t  // reported as unsupported.\n   212\t  syntax BytesResult ::= alignedBytes(Alignment, List) [function, total]\n   213\t  rule alignedBytes(alignment(Segs), Fs) => #alignedBytes(Segs, Fs, .Bytes)\n   214\t  syntax BytesResult ::= #alignedBytes(Segments, List, Bytes) [function, total]\n   215\t  rule #alignedBytes(.Segments, .List, Acc) => bOk(Acc)\n   216\t  rule #alignedBytes(.Segments, Fs, _) => bErr(\"Inputs did not match alignment\") requires size(Fs) >Int 0\n   217\t  rule #alignedBytes((atom(fieldAtom()), Segs), ListItem(F) Fs, Acc) => #alignedBytes(Segs, Fs, Acc +Bytes Int2Bytes(32, F, LE))\n   218\t  rule #alignedBytes((atom(fieldAtom()), _), .List, _) => bErr(\"Inputs did not match alignment\")\n   219\t  rule #alignedBytes((atom(bytesAtom(N)), Segs), Fs, Acc) => #alignedBytesAtom(N, Segs, Fs, Acc, bytesFromFieldRepr(Fs, N))\n   220\t  rule #alignedBytes((atom(compressAtom()), _), _, _) => bErr(\"Inputs did not match alignment\")   // Compress atoms cannot be parsed from field elements\n   221\t  rule #alignedBytes((option(_), _), _, _) => bErr(\"unsupported: alignment option segment\")\n   222\t  syntax BytesResult ::= #alignedBytesAtom(Int, Segments, List, Bytes, BytesResult) [function, total]\n   223\t  rule #alignedBytesAtom(_, _, _, _, bErr(S)) => bErr(S)\n   224\t  rule #alignedBytesAtom(N, Segs, Fs, Acc, bOk(B)) => #alignedBytes(Segs, range(Fs, (N +Int 30) /Int 31, 0), Acc +Bytes B)\n   225\t\n   226\t  // bytes_from_field_repr(repr, n): stray = n mod 31 bytes come first (from\n   227\t  // repr[0]), then the 31-byte chunks in reverse order of the elements.\n   228\t  syntax BytesResult ::= bytesFromFieldRepr(List, Int) [function, total]\n   229\t  rule bytesFromFieldRepr(Fs, N) => bErr(\"Inputs did not match alignment\") requires size(Fs) <Int (N +Int 30) /Int 31\n   230\t  rule bytesFromFieldRepr(Fs, N) => #bffr(Fs, N, N modInt 31, N /Int 31) requires size(Fs) >=Int (N +Int 30) /Int 31\n   231\t  syntax BytesResult ::= #bffr(List, Int, Int, Int) [function, total]   // (fields, n, stray, chunks)\n   232\t  rule #bffr(Fs, N, 0, Chunks) => #bffrChunks(Fs, Chunks, 0, .Bytes)\n   233\t  rule #bffr(ListItem(F) Fs, N, Stray, Chunks) => #bffrStray(#bffrChunks(Fs, Chunks, 0, .Bytes), F, Stray)\n   234\t    requires Stray >Int 0 andBool fitsBits(F, 8 *Int Stray)\n   235\t  rule #bffr(ListItem(F) _, _, Stray, _) => bErr(\"Inputs did not match alignment\")\n   236\t    requires Stray >Int 0 andBool notBool fitsBits(F, 8 *Int Stray)\n   237\t  rule #bffr(.List, _, Stray, _) => bErr(\"Inputs did not match alignment\") requires Stray >Int 0\n   238\t  syntax BytesResult ::= #bffrStray(BytesResult, Int, Int) [function, total]\n   239\t  rule #bffrStray(bErr(S), _, _) => bErr(S)\n   240\t  rule #bffrStray(bOk(B), F, Stray) => bOk(B +Bytes Int2Bytes(Stray, F, LE))\n   241\t  // chunk i takes fields[chunks - 1 - i]\n   242\t  syntax BytesResult ::= #bffrChunks(List, Int, Int, Bytes) [function, total]\n   243\t  rule #bffrChunks(_, Chunks, I, Acc) => bOk(Acc) requires I >=Int Chunks\n   244\t  rule #bffrChunks(Fs, Chunks, I, Acc) => #bffrChunks(Fs, Chunks, I +Int 1, Acc +Bytes Int2Bytes(31, {Fs[Chunks -Int 1 -Int I]}:>Int, LE))\n   245\t    requires I <Int Chunks andBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   246\t  rule #bffrChunks(Fs, Chunks, I, _) => bErr(\"Inputs did not match alignment\")\n   247\t    requires I <Int Chunks andBool notBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   248\t\n   249\t  // --- bits ---------------------------------------------------------------------------\n   250\t  // resolve_operand_bits with a bound: value must be Native and fit in N bits;\n   251\t  // N >= FR_BITS is \"Excessive bit bound\".\n   252\t  syntax CheckResult ::= checkBits(Value, Int) [function, total]\n   253\t  rule checkBits(_, N) => cErr(\"Excessive bit bound\") requires N >=Int #frBits\n   254\t  rule checkBits(native(V), N) => cOk() requires N <Int #frBits andBool fitsBits(V, N)\n   255\t  rule checkBits(native(V), N) => cErr(\"Bit bound failed: \" +String Int2String(V) +String \" is not \" +String Int2String(N) +String \"-bit\")\n   256\t    requires N <Int #frBits andBool notBool fitsBits(V, N)\n   257\t  rule checkBits(V, N) => cErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires N <Int #frBits andBool notBool isNative(V)\n   258\t  syntax Bool ::= isNative(Value) [function, total]\n   259\t  rule isNative(native(_)) => true\n   260\t  rule isNative(_) => false [owise]\n   261\t\n   262\t  // resolve_operand_bool: Native 0 or 1\n   263\t  syntax BoolResult ::= boolOk(Bool) | boolErr(String)\n   264\t  syntax BoolResult ::= asBool(Value) [function, total]\n   265\t  rule asBool(native(0)) => boolOk(false)\n   266\t  rule asBool(native(1)) => boolOk(true)\n   267\t  rule asBool(native(V)) => boolErr(\"Expected boolean, found: \" +String Int2String(V)) requires V =/=Int 0 andBool V =/=Int 1\n   268\t  rule asBool(V) => boolErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires notBool isNative(V)\n   269\tendmodule\n","exit_code":0,"status":"completed"}}
