n    29\t    into_coordinates_incircuit, into_coordinates_offcircuit,\n    30\t};\n    31\tuse crate::ir_instructions::inv::{inv_incircuit, inv_offcircuit};\n    32\tuse crate::ir_instructions::mul::{mul_incircuit, mul_offcircuit};\n    33\tuse crate::ir_instructions::neg::{neg_incircuit, neg_offcircuit};\n    34\tuse crate::ir_instructions::select::{select_incircuit, select_offcircuit};\n    35\tuse crate::ir_types::{CircuitValue, IrType, IrValue};\n    36\t\n    37\tuse super::ir::{Identifier, Instruction as I, IrSource, Operand};\n    38\tuse anyhow::{anyhow, bail};\n    39\tuse base_crypto::fab::{Alignment, AlignmentAtom, AlignmentSegment};\n    40\tuse base_crypto::repr::BinaryHashRepr;\n    41\tuse group::Group;\n    42\tuse midnight_circuits::instructions::{\n    43\t    ArithInstructions, AssertionInstructions, AssignmentInstructions, BinaryInstructions,\n    44\t    ControlFlowInstructions, ConversionInstructions, DecompositionInstructions,\n    45\t    PublicInputInstructions, RangeCheckInstructions, ZeroInstructions,\n    46\t};\n    47\tuse midnight_circuits::types::{AssignedBit, AssignedByte, AssignedNative, InnerValue};\n    48\tuse midnight_curves::{JubjubSubgroup, k256};\n    49\tuse midnight_proofs::{\n    50\t    circuit::{Layouter, Value},\n    51\t    plonk::Error,\n    52\t};\n    53\tuse midnight_zk_stdlib::{Relation, ZkStdLib, ZkStdLibArch};\n    54\tuse num_bigint::BigUint;\n    55\tuse serialize::{Deserializable, Serializable, VecExt, tagged_deserialize, tagged_serialize};\n    56\tuse sha2::Sha256;\n    57\tuse sha3::{Digest, Keccak256};\n    58\tuse std::cmp::Ordering;\n    59\tuse std::collections::HashMap;\n    60\tuse transient_crypto::curve::outer;\n    61\tuse transient_crypto::curve::{FR_BITS, FR_BYTES_STORED, Fr};\n    62\tuse transient_crypto::fab::{AlignmentExt, ValueReprAlignedValue};\n    63\tuse transient_crypto::hash::{hash_to_curve, transient_commit, transient_hash};\n    64\tuse transient_crypto::proofs::{ProofPreimage, ProvingError};\n    65\t\n    66\t/// The raw data prior to proving. Note that this should *not* be considered part of the public\n    67\t/// API, and is subject to change at any time. It may be used in combination with\n    68\t/// [`IrSource::prove_unchecked`] to test malicious prover behavior.\n    69\t#[derive(Clone, Debug)]\n    70\t#[allow(missing_docs)]\n    71\tpub struct Preprocessed {\n    72\t    pub memory: HashMap<Identifier, IrValue>,\n    73\t    pub pis: Vec<outer::Scalar>,\n    74\t    pub pi_skips: Vec<Option<usize>>,\n    75\t    pub binding_input: outer::Scalar,\n    76\t    pub comm_comm: Option<(outer::Scalar, outer::Scalar)>,\n    77\t}\n    78\t\n    79\tfn fab_decode_to_bytes(\n    80\t    std: &ZkStdLib,\n    81\t    layouter: &mut impl Layouter<outer::Scalar>,\n    82\t    align: &Alignment,\n    83\t    mut inputs: &[AssignedNative<outer::Scalar>],\n    84\t) -> Result<Vec<AssignedByte<outer::Scalar>>, Error> {\n    85\t    let mut res = Vec::with_bounded_capacity(align.bin_len());\n    86\t    let _ = fab_decode_to_bytes_inner(std, layouter, align, &mut inputs, &mut res)?;\n    87\t    let mut debug_values: Vec<u8> = Vec::new();\n    88\t    for value in res.iter() {\n    89\t        value.value().assert_if_known(|v| {\n    90\t            debug_values.push(*v);\n    91\t            true\n    92\t        })\n    93\t    }\n    94\t    if !debug_values.is_empty() {\n    95\t        trace!(bytes = ?debug_values, len = debug_values.len(), \"bytes decoded in-circuit\");\n    96\t    }\n    97\t    Ok(res)\n    98\t}\n    99\t\n   100\tfn fab_decode_to_bytes_inner(\n   101\t    std: &ZkStdLib,\n   102\t    layouter: &mut impl Layouter<outer::Scalar>,\n   103\t    align: &Alignment,\n   104\t    inputs: &mut &[AssignedNative<outer::Scalar>],\n   105\t    res: &mut Vec<AssignedByte<outer::Scalar>>,\n   106\t) -> Result<AssignedNative<outer::Scalar>, Error> {\n   107\t    let mut acc = std.assign_fixed(layouter, 0.into())?;\n   108\t    for segment in align.0.iter() {\n   109\t        match segment {\n   110\t            AlignmentSegment::Atom(atom) => {\n   111\t                fab_decode_to_bytes_atom(std, layouter, atom, inputs, res)?;\n   112\t                acc = std.add_constant(layouter, &acc, 1.into())?;\n   113\t            }\n   114\t            AlignmentSegment::Option(_) => {\n   115\t                error!(\"in-circuit decoding of alignment options is not yet implemented!\");\n   116\t                return Err(Error::Synthesis(\n   117\t                    \"in-circuit decoding of alignment options is not yet implemented!\".into(),\n   118\t                ));\n   119\t            }\n   120\t        }\n   121\t    }\n   122\t    Ok(acc)\n   123\t}\n   124\t\n   125\tfn fab_decode_to_bytes_atom(\n   126\t    std: &ZkStdLib,\n   127\t    layouter: &mut impl Layouter<outer::Scalar>,\n   128\t    align: &AlignmentAtom,\n   129\t    inputs: &mut &[AssignedNative<outer::Scalar>],\n   130\t    res: &mut Vec<AssignedByte<outer::Scalar>>,\n   131\t) -> Result<(), Error> {\n   132\t    match align {\n   133\t        AlignmentAtom::Field => {\n   134\t            if inputs.is_empty() {\n   135\t                return Err(Error::Synthesis(\n   136\t                    \"cannot decode field element from no data\".into(),\n   137\t                ));\n   138\t            }\n   139\t            let value = &inputs[0];\n   140\t            *inputs = &inputs[1..];\n   141\t            res.extend(std.assigned_to_le_bytes(layouter, value, None)?);\n   142\t            Ok(())\n   143\t        }\n   144\t        AlignmentAtom::Bytes { length } => {\n   145\t            let stray = *length as usize % FR_BYTES_STORED;\n   146\t            let chunks = *length as usize / FR_BYTES_STORED;\n   147\t            let expected_size = chunks + (stray != 0) as usize;\n   148\t            let mut bytes_from =\n   149\t                |slice: &mut Vec<AssignedByte<outer::Scalar>>,\n   150\t                 k,\n   151\t                 f: AssignedNative<outer::Scalar>| {\n   152\t                    let repr = std.assigned_to_le_bytes(layouter, &f, Some(k))?;\n   153\t                    slice.extend(repr[..k].iter().cloned());\n   154\t                    Ok::<_, Error>(())\n   155\t                };\n   156\t            if inputs.len() < expected_size {\n   157\t                return Err(Error::Synthesis(\n   158\t                    \"cannot decode bytes from to little data\".into(),\n   159\t                ));\n   160\t            }\n   161\t            let mut res_vec = Vec::with_bounded_capacity(*length as usize - stray);\n   162\t            if stray > 0 {\n   163\t                bytes_from(&mut res_vec, stray, inputs[0].clone())?;\n   164\t                *inputs = &inputs[1..];\n   165\t            }\n   166\t            for i in 0..chunks {\n   167\t                bytes_from(res, FR_BYTES_STORED, inputs[chunks - 1 - i].clone())?;\n   168\t            }\n   169\t            *inputs = &inputs[chunks..];\n   170\t            res.extend(res_vec);\n   171\t            Ok(())\n   172\t        }\n   173\t        AlignmentAtom::Compress => {\n   174\t            error!(\"Cannot decode compressed value from field elements\");\n   175\t            Err(Error::Synthesis(\n   176\t                \"Cannot decode compressed value from field elements\".into(),\n   177\t            ))\n   178\t        }\n   179\t    }\n   180\t}\n   181\t\n   182\timpl IrSource {\n   183\t    /// Performs a non-ZK run of a circuit, to ensure that constraints hold, and\n   184\t    /// to produce a public input vector, and public input skip information.\n   185\t    pub(crate) fn preprocess(\n   186\t        &self,\n   187\t        preimage: &ProofPreimage,\n   188\t    ) -> Result<Preprocessed, ProvingError> {\n   189\t        let mut memory: HashMap<Identifier, IrValue> = HashMap::new();\n   190\t\n   191\t        let mut idx = 0;\n   192\t        for input_id in self.inputs.iter() {\n   193\t            let w = input_id.val_t.encoded_len();\n   194\t            if idx + w > preimage.inputs.len() {\n   195\t                bail!(\n   196\t                    \"Not enough raw inputs: ran out at index {} while decoding {:?}\",\n   197\t                    idx,\n   198\t                    input_id.name\n   199\t                );\n   200\t            }\n   201\t            let value = decode_offcircuit(&preimage.inputs[idx..idx + w], &input_id.val_t)?;\n   202\t            memory.insert(input_id.name.clone(), value);\n   203\t            idx += w;\n   204\t        }\n   205\t        if idx != preimage.inputs.len() {\n   206\t            bail!(\n   207\t                \"Expected {} raw inputs, received {}\",\n   208\t                idx,\n   209\t                preimage.inputs.len()\n   210\t            );\n   211\t        }\n   212\t\n   213\t        let mut pis = vec![preimage.binding_input];\n   214\t        if self.do_communications_commitment {\n   215\t            pis.push(\n   216\t                preimage\n   217\t                    .communications_commitment\n   218\t                    .ok_or(anyhow!(\"Expected communications commitment\"))?\n   219\t                    .0,\n   220\t            );\n   221\t        }\n   222\t        let mut pi_skips = Vec::new();\n   223\t        let mut public_transcript_inputs_idx: usize = 0;\n   224\t        let mut public_transcript_outputs_idx: usize = 0;\n   225\t        let mut private_transcript_outputs_idx: usize = 0;\n   226\t        let mut outputs = Vec::new();\n   227\t        let idx = |memory: &HashMap<Identifier, IrValue>, id: &Identifier| {\n   228\t            let res = memory\n   229\t                .get(id)\n   230\t                .cloned()\n   231\t                .ok_or(anyhow!(\"variable not found: {:?}\", id));\n   232\t            trace!(?res, \"retrieved from {:?}\", id);\n   233\t            res\n   234\t        };\n   235\t        let resolve_operand =\n   236\t            |memory: &HashMap<Identifier, IrValue>, operand: &Operand| match operand {\n   237\t                Operand::Variable(id) => idx(memory, id),\n   238\t                Operand::Immediate(imm) => Ok(IrValue::Native(*imm)),\n   239\t            };\n   240\t        let resolve_operand_bool = |memory: &HashMap<Identifier, IrValue>, operand: &Operand| {\n   241\t            resolve_operand(memory, operand).and_then(|val| {\n   242\t                let val: Fr = val.try_into()?;\n   243\t                if val == 0.into() {\n   244\t                    Ok(false)\n   245\t                } else if val == 1.into() {\n   246\t                    Ok(true)\n   247\t                } else {\n   248\t                    bail!(\"Expected boolean, found: {val:?}\");\n   249\t                }\n   250\t            })\n   251\t        };\n   252\t\n   253\t        let resolve_operand_bits =\n   254\t            |memory: &HashMap<Identifier, IrValue>, operand: &Operand, constrain: Option<u32>| {\n   255\t                resolve_operand(memory, operand).and_then(|val| {\n   256\t                    let val: Fr = val.try_into()?;\n   257\t                    let mut bits = val\n   258\t                        .0\n   259\t                        .to_bytes_le()\n   260\t                        .into_iter()\n   261\t                        .flat_map(|byte| {\n   262\t                            [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80]\n   263\t                                .into_iter()\n   264\t                                .map(move |mask| byte & mask != 0)\n   265\t                        })\n   266\t                        .collect::<Vec<_>>();\n   267\t                    if let Some(n) = constrain {\n   268\t                        if n as usize >= FR_BITS {\n   269\t                            bail!(\"Excessive bit bound\");\n   270\t                        }\n   271\t                        if bits[n as usize..].iter().any(|b| *b) {\n   272\t                            bail!(\"Bit bound failed: {val:?} is not {n}-bit\");\n   273\t                        }\n   274\t                        bits.truncate(n as usize);\n   275\t                    }\n   276\t                    Ok(bits)\n   277\t                })\n   278\t            };\n   279\t\n   280\t        fn from_bits<I: DoubleEndedIterator<Item = bool>>(bits: I) -> Fr {\n   281\t            bits.rev()\n   282\t                .fold(0.into(), |acc, bit| acc * 2.into() + bit.into())\n   283\t        }\n   284\t        for ins in self.instructions.iter() {\n   285\t            trace!(?ins, \"preprocess gate\");\n   286\t            match ins {\n   287\t                I::Encode { input, outputs } => {\n   288\t                    let val = resolve_operand(&memory, input)?;\n   289\t                    let encoded = encode_offcircuit(&val);\n   290\t                    if encoded.len() != outputs.len() {\n   291\t                        return Err(anyhow::Error::msg(format!(\n   292\t                            \"Unexpected output length of encode instruction: {:?}\",\n   293\t                            val.get_type()\n   294\t                        )));\n   295\t                    }\n   296\t                    for (out_id, enc_val) in outputs.iter().zip(encoded) {\n   297\t                        memory.insert(out_id.clone(), enc_val);\n   298\t                    }\n   299\t                }\n   300\t                I::Add { a, b, output } => {\n   301\t                    let a = resolve_operand(&memory, a)?;\n   302\t                    let b = resolve_operand(&memory, b)?;\n   303\t                    let result = add_offcircuit(&a, &b)?;\n   304\t                    memory.insert(output.clone(), result);\n   305\t                }\n   306\t                I::Mul { a, b, output } => {\n   307\t                    let a = resolve_operand(&memory, a)?;\n   308\t                    let b = resolve_operand(&memory, b)?;\n   309\t                    let result = mul_offcircuit(&a, &b)?;\n   310\t                    memory.insert(output.clone(), result);\n   311\t                }\n   312\t                I::Neg { a, output } => {\n   313\t                    let a = resolve_operand(&memory, a)?;\n   314\t                    let result = neg_offcircuit(&a)?;\n   315\t                    memory.insert(output.clone(), result);\n   316\t                }\n   317\t                I::Inv { a, output } => {\n   318\t                    let a = resolve_operand(&memory, a)?;\n   319\t                    let result = inv_offcircuit(&a)?;\n   320\t                    memory.insert(output.clone(), result);\n   321\t                }\n   322\t                I::Not { a, output } => {\n   323\t                    let result = IrValue::Native((!resolve_operand_bool(&memory, a)?).into());\n   324\t                    memory.insert(output.clone(), result);\n   325\t                }\n   326\t                I::ConstrainEq { a, b } => {\n   327\t                    let a = resolve_operand(&memory, a)?;\n   328\t                    let b = resolve_operand(&memory, b)?;\n   329\t                    constrain_eq_offcircuit(&a, &b)?;\n   330\t                }\n   331\t                I::CondSelect { bit, a, b, output } => {\n   332\t                    let bit_val = resolve_operand_bool(&memory, bit)?;\n   333\t                    let a_val = resolve_operand(&memory, a)?;\n   334\t                    let b_val = resolve_operand(&memory, b)?;\n   335\t                    memory.insert(output.clone(), select_offcircuit(bit_val, &a_val, &b_val)?);\n   336\t                }\n   337\t                I::Assert { cond } => {\n   338\t                    if !resolve_operand_bool(&memory, cond)? {\n   339\t                        bail!(\"Failed direct assertion\");\n   340\t                    }\n   341\t                }\n   342\t                I::TestEq { a, b, output } => {\n   343\t                    let a = resolve_operand(&memory, a)?;\n   344\t                    let b = resolve_operand(&memory, b)?;\n   345\t                    let result = test_eq_offcircuit(&a, &b)?;\n   346\t                    memory.insert(output.clone(), IrValue::Native(result.into()));\n   347\t                }\n   348\t                I::PublicInput {\n   349\t                    guard,\n   350\t                    val_t,\n   351\t                    output,\n   352\t                } => {\n   353\t                    let val = match guard {\n   354\t                        Some(guard) if !resolve_operand_bool(&memory, guard)? => {\n   355\t                            IrValue::default(val_t)\n   356\t                        }\n   357\t                        _ => {\n   358\t                            let w = val_t.encoded_len();\n   359\t                            let raw_outputs = &preimage.public_transcript_outputs\n   360\t                                [public_transcript_outputs_idx..public_transcript_outputs_idx + w];\n   361\t                            public_transcript_outputs_idx += w;\n   362\t                            decode_offcircuit(raw_outputs, val_t)?\n   363\t                        }\n   364\t                    };\n   365\t                    memory.insert(output.clone(), val);\n   366\t                }\n   367\t                I::PrivateInput {\n   368\t                    guard,\n   369\t                    val_t,\n   370\t                    output,\n   371\t                } => {\n   372\t                    let val = match guard {\n   373\t                        Some(guard) if !resolve_operand_bool(&memory, guard)? => {\n   374\t                            IrValue::default(val_t)\n   375\t                        }\n   376\t                        _ => {\n   377\t                            let w = val_t.encoded_len();\n   378\t                            let raw_outputs = &preimage.private_transcript\n   379\t                                [private_transcript_outputs_idx\n   380\t                                    ..private_transcript_outputs_idx + w];\n   381\t                            private_transcript_outputs_idx += w;\n   382\t                            decode_offcircuit(raw_outputs, val_t)?\n   383\t                        }\n   384\t                    };\n   385\t                    memory.insert(output.clone(), val);\n   386\t                }\n   387\t                I::Copy { val, output } => {\n   388\t                    let val = resolve_operand(&memory, val)?;\n   389\t                    memory.insert(output.clone(), val);\n   390\t                }\n   391\t                I::ConstrainToBoolean { val } => drop(resolve_operand_bool(&memory, val)?),\n   392\t                I::ConstrainBits { val, bits } => {\n   393\t                    drop(resolve_operand_bits(&memory, val, Some(*bits))?)\n   394\t                }\n   395\t                I::DivModPowerOfTwo { val, bits, outputs } => {\n   396\t                    if outputs.len() != 2 {\n   397\t                        bail!(\"DivModPowerOfTwo requires exactly 2 outputs\");\n   398\t                    }\n   399\t                    if *bits as usize > FR_BYTES_STORED * 8 {\n   400\t                        bail!(\"Excessive bit count\");\n   401\t                    }\n   402\t                    let val_bits = resolve_operand_bits(&memory, val, None)?;\n   403\t                    memory.insert(\n   404\t                        outputs[0].clone(),\n   405\t                        IrValue::Native(from_bits(val_bits[*bits as usize..].iter().copied())),\n   406\t                    );\n   407\t                    memory.insert(\n   408\t                        outputs[1].clone(),\n   409\t                        IrValue::Native(from_bits(val_bits[..*bits as usize].iter().copied())),\n   410\t                    );\n   411\t                }\n   412\t                I::ReconstituteField {\n   413\t                    divisor,\n   414\t                    modulus,\n   415\t                    bits,\n   416\t                    output,\n   417\t                } => {\n   418\t                    if *bits as usize > FR_BYTES_STORED * 8 {\n   419\t                        bail!(\"Excessive bit count\");\n   420\t                    }\n   421\t                    let fr_max = Fr::from(-1);\n   422\t                    let max_bits: Vec<bool> = fr_max\n   423\t                        .0\n   424\t                        .to_bytes_le()\n   425\t                        .into_iter()\n   426\t                        .flat_map(|byte| {\n   427\t                            [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80]\n   428\t                                .into_iter()\n   429\t                                .map(move |mask| byte & mask != 0)\n   430\t                        })\n   431\t                        .collect();\n   432\t                    let modulus_bits = resolve_operand_bits(&memory, modulus, Some(*bits))?;\n   433\t                    let divisor_bits =\n   434\t                        resolve_operand_bits(&memory, divisor, Some(FR_BITS as u32 - *bits))?;\n   435\t                    let cmp = modulus_bits\n   436\t                        .iter()\n   437\t                        .chain(divisor_bits.iter())\n   438\t                        .rev()\n   439\t                        .zip(max_bits[..FR_BITS].iter().rev())\n   440\t                        .map(|(ab, max)| ab.cmp(max))\n   441\t                        .fold(\n   442\t                            Ordering::Equal,\n   443\t                            |prefix, local| if prefix.is_eq() { local } else { prefix },\n   444\t                        );\n   445\t                    if cmp.is_gt() {\n   446\t                        bail!(\"Reconstituted element overflows field\");\n   447\t                    }\n   448\t                    let power = (0..*bits).fold(Fr::from(1), |acc, _| Fr::from(2) * acc);\n   449\t                    let modulus: Fr = resolve_operand(&memory, modulus)?.try_into()?;\n   450\t                    let divisor: Fr = resolve_operand(&memory, divisor)?.try_into()?;\n   451\t                    let result = IrValue::Native(power * divisor + modulus);\n   452\t                    memory.insert(output.clone(), result);\n   453\t                }\n   454\t                I::LessThan { a, b, bits, output } => {\n   455\t                    let result =\n   456\t                        (from_bits(resolve_operand_bits(&memory, a, Some(*bits))?.into_iter())\n   457\t                            < from_bits(\n   458\t                                resolve_operand_bits(&memory, b, Some(*bits))?.into_iter(),\n   459\t                            ))\n   460\t                        .into();\n   461\t                    memory.insert(output.clone(), IrValue::Native(result));\n   462\t                }\n   463\t                I::JubjubScalarFromNative { native, output } => {\n   464\t                    let x: Fr = resolve_operand(&memory, native)?.try_into()?;\n   465\t                    let s = native_to_jubjub_scalar(&x);\n   466\t                    memory.insert(output.clone(), IrValue::JubjubScalar(s));\n   467\t                }\n   468\t                I::TransientHash { inputs, output } => {\n   469\t                    let result = transient_hash(\n   470\t                        &inputs\n   471\t                            .iter()\n   472\t                            .map(|i| resolve_operand(&memory, i))\n   473\t                            .map(|r| r.and_then(|v| v.try_into()))\n   474\t                            .collect::<Result<Vec<Fr>, _>>()?,\n   475\t                    );\n   476\t                    memory.insert(output.clone(), IrValue::Native(result));\n   477\t                }\n   478\t                I::PersistentHash {\n   479\t                    alignment,\n   480\t                    inputs,\n   481\t                    output,\n   482\t                }\n   483\t                | I::Keccak256 {\n   484\t                    alignment,\n   485\t                    inputs,\n   486\t                    output,\n   487\t                } => {\n   488\t                    let inputs = inputs\n   489\t                        .iter()\n   490\t                        .map(|i| resolve_operand(&memory, i))\n   491\t                        .map(|r| r.and_then(|v| v.try_into()))\n   492\t                        .collect::<Result<Vec<_>, _>>()?;\n   493\t                    let value = alignment.parse_field_repr(&inputs).ok_or_else(|| {\n   494\t                        error!(\"Inputs did not match alignment (inputs: {inputs:?}, alignment: {alignment:?})\");\n   495\t                        anyhow!(\"Inputs did not match alignment (inputs: {inputs:?}, alignment: {alignment:?})\")\n   496\t                    })?;\n   497\t                    let mut repr = Vec::new();\n   498\t                    ValueReprAlignedValue(value).binary_repr(&mut repr);\n   499\t                    trace!(bytes = ?repr, \"bytes decoded out-of-circuit\");\n   500\t                    let hash_output: [u8; 32] = match ins {\n   501\t                        I::PersistentHash { .. } => Sha256::digest(&repr).into(),\n   502\t                        I::Keccak256 { .. } => Keccak256::digest(&repr).into(),\n   503\t                        _ => unreachable!(),\n   504\t                    };\n   505\t                    memory.insert(output.clone(), IrValue::Bytes32(hash_output));\n   506\t                }\n   507\t                I::Impact { guard, inputs } => {\n   508\t                    let count = inputs.len();\n   509\t                    if !resolve_operand_bool(&memory, guard)? {\n   510\t                        // A guarded-off impact contributes zeroed public inputs,\n   511\t                        // matching the in-circuit `select(guard, x, 0)` of the\n   512\t                        // `synthesize` run, and is recorded as skipped.\n   513\t                        for _ in inputs {\n   514\t                            pis.push(0.into());\n   515\t                        }\n   516\t                        pi_skips.push(Some(count));\n   517\t                    } else {\n   518\t                        for input in inputs {\n   519\t                            let x: Fr = resolve_operand(&memory, input)?.try_into()?;\n   520\t                            pis.push(x);\n   521\t                            public_transcript_inputs_idx += 1;\n   522\t                        }\n   523\t                        pi_skips.push(None);\n   524\t                        for i in 0..count {\n   525\t                            let idx = public_transcript_inputs_idx - count + i;\n   526\t                            let expected = preimage.public_transcript_inputs.get(idx).copied();\n   527\t                            let computed = Some(pis[pis.len() - count + i]);\n   528\t                            if expected != computed {\n   529\t                                error!(\n   530\t                                    ?idx,\n   531\t                                    ?expected,\n   532\t                                    ?computed,\n   533\t                                    ?memory,\n   534\t                                    ?pis,\n   535\t                                    \"Public transcript input mismatch\"\n   536\t                                );\n   537\t                                bail!(\n   538\t                                    \"Public transcript input mismatch for input {idx}; expected: {expected:?}, computed: {computed:?}\"\n   539\t                                );\n   540\t                            }\n   541\t                        }\n   542\t                    }\n   543\t                }\n   544\t                I::HashToCurve { inputs, output } => {\n   545\t                    let inputs = inputs\n   546\t                        .iter()\n   547\t                        .map(|var| resolve_operand(&memory, var))\n   548\t                        .map(|r| r.and_then(|v| v.try_into()))\n   549\t                        .collect::<Result<Vec<Fr>, _>>()?;\n   550\t                    let point = hash_to_curve(&inputs);\n   551\t                    memory.insert(output.clone(), IrValue::JubjubPoint(point.0));\n   552\t                }\n   553\t                I::EcMul { a, scalar, output } => {\n   554\t                    let p = resolve_operand(&memory, a)?;\n   555\t                    let s = resolve_operand(&memory, scalar)?;\n   556\t                    let r = ec_mul_offcircuit(&p, &s)?;\n   557\t                    memory.insert(output.clone(), r);\n   558\t                }\n   559\t                I::EcMulGenerator { scalar, output } => {\n   560\t                    let s = resolve_operand(&memory, scalar)?;\n   561\t                    let p = match s.get_type() {\n   562\t                        IrType::JubjubScalar => IrValue::JubjubPoint(JubjubSubgroup::generator()),\n   563\t                        IrType::Secp256k1Scalar => IrValue::Secp256k1Point(k256::K256::generator()),\n   564\t                        t => bail!(\"Unsupported EcMulGenerator for scalar of type {t:?}\"),\n   565\t                    };\n   566\t                    let r = ec_mul_offcircuit(&p, &s)?;\n   567\t                    memory.insert(output.clone(), r);\n   568\t                }\n   569\t                I::IntoCoordinates { point, outputs } => {\n   570\t                    let p = resolve_operand(&memory, point)?;\n   571\t                    let coordinates = into_coordinates_offcircuit(&p)?;\n   572\t                    memory.insert(outputs.0.clone(), coordinates.0);\n   573\t                    memory.insert(outputs.1.clone(), coordinates.1);\n   574\t                }\n   575\t                I::FromCoordinates { inputs, output } => {\n   576\t                    let x = resolve_operand(&memory, &inputs.0)?;\n   577\t                    let y = resolve_operand(&memory, &inputs.1)?;\n   578\t                    let p = from_coordinates_offcircuit(&x, &y)?;\n   579\t                    memory.insert(output.clone(), p);\n   580\t                }\n   581\t                I::IntoBytes32 { input, output } => {\n   582\t                    let x = resolve_operand(&memory, input)?;\n   583\t                    let bytes = into_bytes32_offcircuit(&x)?;\n   584\t                    memory.insert(output.clone(), bytes);\n   585\t                }\n   586\t                I::FromBytes32 {\n   587\t                    val_t,\n   588\t                    bytes,\n   589\t                    output,\n   590\t                } => {\n   591\t                    let bytes = resolve_operand(&memory, bytes)?;\n   592\t                    let bytes: [u8; 32] = bytes.try_into()?;\n   593\t                    let x = from_bytes32_offcircuit(val_t, &bytes)?;\n   594\t                    memory.insert(output.clone(), x);\n   595\t                }\n   596\t                I::ReverseBytes { bytes, output } => {\n   597\t                    let bytes = resolve_operand(&memory, bytes)?;\n   598\t                    let mut bytes: [u8; 32] = bytes.try_into()?;\n   599\t                    bytes.reverse();\n   600\t                    memory.insert(output.clone(), IrValue::Bytes32(bytes));\n   601\t                }\n   602\t                I::Bytes32IntoLowHigh { bytes, outputs } => {\n   603\t                    let bytes = resolve_operand(&memory, bytes)?;\n   604\t                    let mut bytes: [u8; 32] = bytes.try_into()?;\n   605\t                    let high = IrValue::Native(Fr::from(bytes[31]));\n   606\t                    bytes[31] = 0;\n   607\t                    let low = from_bytes32_offcircuit(&IrType::Native, &bytes)?;\n   608\t                    memory.insert(outputs.0.clone(), low);\n   609\t                    memory.insert(outputs.1.clone(), high);\n   610\t                }\n   611\t                I::Bytes32FromLowHigh { inputs, output } => {\n   612\t                    let low = resolve_operand(&memory, &inputs.0)?;\n   613\t                    let high = resolve_operand(&memory, &inputs.1)?;\n   614\t                    let bytes_low: [u8; 32] = into_bytes32_offcircuit(&low)?.try_into()?;\n   615\t                    let bytes_high: [u8; 32] = into_bytes32_offcircuit(&high)?.try_into()?;\n   616\t                    if bytes_low[31] != 0 || bytes_high[1..].iter().any(|b| *b != 0) {\n   617\t                        bail!(\n   618\t                            \"Bytes32FromLowHigh: low operand must fit in 31 bytes (be less than 2^248) and high operand must fit in a single byte (be less than 256)\"\n   619\t                        );\n   620\t                    }\n   621\t                    let mut out_bytes = bytes_low;\n   622\t                    out_bytes[31] = bytes_high[0];\n   623\t                    memory.insert(output.clone(), IrValue::Bytes32(out_bytes));\n   624\t                }\n   625\t                I::Output { vals } => {\n   626\t                    if vals.len() != self.outputs.len() {\n   627\t                        bail!(\n   628\t                            \"Output: signature declares {} return values but instruction has {}\",\n   629\t                            self.outputs.len(),\n   630\t                            vals.len()\n   631\t                        );\n   632\t                    }\n   633\t                    for (i, (val, expected_t)) in vals.iter().zip(self.outputs.iter()).enumerate() {\n   634\t                        let value = resolve_operand(&memory, val)?;\n   635\t                        if value.get_type() != *expected_t {\n   636\t                            bail!(\n   637\t                                \"Output position {i}: signature declares {:?} but operand has runtime type {:?}\",\n   638\t                                expected_t,\n   639\t                                value.get_type()\n   640\t                            );\n   641\t                        }\n   642\t                        outputs.push(value);\n   643\t                    }\n   644\t                }\n   645\t            }\n   646\t        }\n   647\t        trace!(?outputs, \"Finished instructions with output\");\n   648\t        if preimage.public_transcript_inputs.len() != public_transcript_inputs_idx\n   649\t            || preimage.public_transcript_outputs.len() != public_transcript_outputs_idx\n   650\t            || preimage.private_transcript.len() != private_transcript_outputs_idx\n   651\t        {\n   652\t            error!(\n   653\t                public_transcript_inputs = ?preimage.public_transcript_inputs,\n   654\t                public_transcript_outputs = ?preimage.public_transcript_outputs,\n   655\t                private_transcript_outputs = ?preimage.private_transcript,\n   656\t                ?public_transcript_inputs_idx,\n   657\t                ?public_transcript_outputs_idx,\n   658\t                ?private_transcript_outputs_idx,\n   659\t                \"Transcripts not fully consumed\");\n   660\t            bail!(\"Transcripts not fully consumed\");\n   661\t        }\n   662\t        if self.do_communications_commitment {\n   663\t            let comm_comm = preimage\n   664\t                .communications_commitment\n   665\t                .ok_or(anyhow!(\"Expected communications randomness\"))?;\n   666\t            let mut comm_comm_inputs: Vec<Fr> = Vec::new();\n   667\t            comm_comm_inputs.extend(preimage.inputs.iter());\n   668\t            for value in outputs.iter() {\n   669\t                for ir_val in encode_offcircuit(value) {\n   670\t                    comm_comm_inputs.push(ir_val.try_into()?);\n   671\t                }\n   672\t            }\n   673\t            if comm_comm.0 != transient_commit(&comm_comm_inputs[..], comm_comm.1) {\n   674\t                error!(\n   675\t                    ?comm_comm,\n   676\t                    ?comm_comm_inputs,\n   677\t                    \"Communications commitment mismatch\"\n   678\t                );\n   679\t                bail!(\"Communications commitment mismatch\");\n   680\t            }\n   681\t        }\n   682\t        Ok(Preprocessed {\n   683\t            memory,\n   684\t            pis: pis.into_iter().map(|x| x.0).collect(),\n   685\t            pi_skips,\n   686\t            binding_input: preimage.binding_input.0,\n   687\t            comm_comm: preimage\n   688\t                .communications_commitment\n   689\t                .map(|(comm, rand)| (comm.0, rand.0)),\n   690\t        })\n   691\t    }\n   692\t}\n   693\t\n   694\timpl Relation for IrSource {\n   695\t    type Instance = Vec<outer::Scalar>;\n   696\t    type Witness = Preprocessed;\n   697\t    type Error = midnight_proofs::plonk::Error;\n   698\t\n   699\t    fn format_instance(\n   700\t        instance: &Self::Instance,\n   701\t    ) -> Result<Vec<outer::Scalar>, midnight_proofs::plonk::Error> {\n   702\t        Ok(instance.clone())\n   703\t    }\n   704\t\n   705\t    fn circuit(\n   706\t        &self,\n   707\t        std: &ZkStdLib,\n   708\t        layouter: &mut impl Layouter<outer::Scalar>,\n   709\t        _instance: Value<Self::Instance>,\n   710\t        witness: Value<Self::Witness>,\n   711\t    ) -> Result<(), Error> {\n   712\t        let mut input_values = Vec::new();\n   713\t        for id in &self.inputs {\n   714\t            let value = witness.as_ref().map(|preproc| {\n   715\t                preproc\n   716\t                    .memory\n   717\t                    .get(&id.name)\n   718\t                    .cloned()\n   719\t                    .unwrap_or(IrValue::Native(0.into()))\n   720\t            });\n   721\t            input_values.push(value);\n   722\t        }\n   723\t\n   724\t        let binding_input_value = witness.as_ref().map(|preproc| preproc.binding_input);\n   725\t        let comm_comm_value = witness.as_ref().map(|preproc| preproc.comm_comm);\n   726\t\n   727\t        let mut memory: HashMap<Identifier, CircuitValue> = HashMap::new();\n   728\t\n   729\t        for (id, value) in self.inputs.iter().zip(input_values) {\n   730\t            let assigned = assign_incircuit(std, layouter, &id.val_t, &[value])?[0].clone();\n   731\t            memory.insert(id.name.clone(), assigned);\n   732\t        }\n   733\t\n   734\t        let binding_input = std.assign(layouter, binding_input_value)?;\n   735\t\n   736\t        let mut outputs = Vec::new();\n   737\t\n   738\t        fn idx<'a>(\n   739\t            memory: &'a HashMap<Identifier, CircuitValue>,\n   740\t            id: &Identifier,\n   741\t        ) -> Result<&'a CircuitValue, Error> {\n   742\t            memory\n   743\t                .get(id)\n   744\t                .ok_or(Error::Synthesis(format!(\"value {id:?} not in memory\")))\n   745\t        }\n   746\t\n   747\t        fn resolve_operand<'a>(\n   748\t            std: &ZkStdLib,\n   749\t            layouter: &mut impl Layouter<outer::Scalar>,\n   750\t            memory: &'a HashMap<Identifier, CircuitValue>,\n   751\t            operand: &'a Operand,\n   752\t        ) -> Result<CircuitValue, Error> {\n   753\t            match operand {\n   754\t                Operand::Variable(id) => idx(memory, id).cloned(),\n   755\t                Operand::Immediate(imm) => {\n   756\t                    std.assign_fixed(layouter, imm.0).map(CircuitValue::Native)\n   757\t                }\n   758\t            }\n   759\t        }\n   760\t\n   761\t        let mem_insert = |id: Identifier,\n   762\t                          cell: CircuitValue,\n   763\t                          mem: &mut HashMap<Identifier, CircuitValue>|\n   764\t         -> Result<(), Error> {\n   765\t            // If id exists in the witness memory, make sure the value that\n   766\t            // we are inserting is the same.\n   767\t            // Miguel: This seems unnecessary to me. I would fail when calling\n   768\t            // `mem_insert` with an id that exists in the witness memory.\n   769\t            witness.as_ref()\n   770\t                .zip(cell.value())\n   771\t                .error_if_known_and(|(preproc, v)| {\n   772\t                    if let Some(expected) = preproc.memory.get(&id) && *expected != *v  {\n   773\t                        error!(id = ?id, expected = ?expected, actual = ?v, \"Misalignment between `prepare` and `synthesize` runs. This is a bug.\");\n   774\t                        return true;\n   775\t                    }\n   776\t                    false\n   777\t                })?;\n   778\t\n   779\t            mem.insert(id, cell);\n   780\t            Ok(())\n   781\t        };\n   782\t\n   783\t        let pi_push = |cell: AssignedNative<outer::Scalar>,\n   784\t                       pis: &mut Vec<AssignedNative<outer::Scalar>>|\n   785\t         -> Result<(), Error> {\n   786\t            let idx = pis.len();\n   787\t            witness.as_ref()\n   788\t                .zip(cell.value())\n   789\t                .error_if_known_and(|(preproc, v)| {\n   790\t                    if idx < preproc.pis.len() && preproc.pis[idx] != **v {\n   791\t                        error!(prepare = ?preproc.pis, ?idx, ?v, \"Misalignment between `prepare` and `synthesize` runs. This is a bug.\");\n   792\t                        true\n   793\t                    } else {\n   794\t                        false\n   795\t                    }\n   796\t                })?;\n   797\t            pis.push(cell);\n   798\t            Ok(())\n   799\t        };\n   800\t\n   801\t        let mut public_inputs = vec![];\n   802\t        pi_push(binding_input, &mut public_inputs)?;\n   803\t\n   804\t        if self.do_communications_commitment {\n   805\t            let comm_comm_value = comm_comm_value.map(|c| {\n   806\t                c.ok_or_else(|| {\n   807\t                    error!(\"Communication commitment not present despite preproc. This is a bug.\");\n   808\t                    Error::Synthesis(\"Communication commitment not present despite preproc.\".into())\n   809\t                })\n   810\t                .unwrap()\n   811\t                .0\n   812\t            });\n   813\t            let comm_comm = std.assign(layouter, comm_comm_value)?;\n   814\t            pi_push(comm_comm, &mut public_inputs)?;\n   815\t        }\n   816\t        for ins in self.instructions.iter() {\n   817\t            match ins {\n   818\t                I::Encode { input, outputs } => {\n   819\t                    let val = resolve_operand(std, layouter, &memory, input)?;\n   820\t                    let encoded = encode_incircuit(std, layouter, &val)?;\n   821\t                    if encoded.len() != outputs.len() {\n   822\t                        return Err(Error::Synthesis(\n   823\t                            \"Unexpected output length of encode instruction\".into(),\n   824\t                        ));\n   825\t                    }\n   826\t                    for (out_id, enc_val) in outputs.iter().zip(encoded) {\n   827\t                        mem_insert(out_id.clone(), enc_val, &mut memory)?;\n   828\t                    }\n   829\t                }\n   830\t                I::Assert { cond } => {\n   831\t                    let cond_val = resolve_operand(std, layouter, &memory, cond)?;\n   832\t                    let cond: AssignedNative<_> = cond_val.try_into()?;\n   833\t                    std.assert_non_zero(layouter, &cond)?;\n   834\t                }\n   835\t                I::CondSelect { bit, a, b, output } => {\n   836\t                    let bit_val = resolve_operand(std, layouter, &memory, bit)?;\n   837\t                    let bit: AssignedNative<_> = bit_val.try_into()?;\n   838\t                    let bit: AssignedBit<outer::Scalar> = std.convert(layouter, &bit)?;\n   839\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   840\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   841\t                    let result = select_incircuit(std, layouter, &bit, &a_val, &b_val)?;\n   842\t                    mem_insert(output.clone(), result, &mut memory)?;\n   843\t                }\n   844\t                I::ConstrainBits { val, bits } => {\n   845\t                    let val_assigned = resolve_operand(std, layouter, &memory, val)?;\n   846\t                    let x: AssignedNative<_> = val_assigned.try_into()?;\n   847\t                    drop(std.assigned_to_le_bits(\n   848\t                        layouter,\n   849\t                        &x,\n   850\t                        Some(*bits as usize),\n   851\t                        *bits as usize >= FR_BITS,\n   852\t                    )?);\n   853\t                }\n   854\t                I::ConstrainEq { a, b } => {\n   855\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   856\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   857\t                    constrain_eq_incircuit(std, layouter, &a_val, &b_val)?;\n   858\t                }\n   859\t                I::ConstrainToBoolean { val } => {\n   860\t                    // Yes, this does insert a constraint.\n   861\t                    let val_assigned = resolve_operand(std, layouter, &memory, val)?;\n   862\t                    let x: AssignedNative<_> = val_assigned.try_into()?;\n   863\t                    let _: AssignedBit<_> = std.convert(layouter, &x)?;\n   864\t                }\n   865\t                I::Copy { val, output } => {\n   866\t                    let val = resolve_operand(std, layouter, &memory, val)?;\n   867\t                    mem_insert(output.clone(), val, &mut memory)?;\n   868\t                }\n   869\t                I::Impact { guard, inputs } => {\n   870\t                    let zero = std.assign_fixed(layouter, outer::Scalar::from(0))?;\n   871\t                    let guard: AssignedBit<_> = {\n   872\t                        let guard = resolve_operand(std, layouter, &memory, guard)?;\n   873\t                        let guard: AssignedNative<_> = guard.try_into()?;\n   874\t                        std.convert(layouter, &guard)?\n   875\t                    };\n   876\t                    for input in inputs {\n   877\t                        let val_assigned = resolve_operand(std, layouter, &memory, input)?;\n   878\t                        let x: AssignedNative<_> = val_assigned.try_into()?;\n   879\t                        let guarded_x = std.select(layouter, &guard, &x, &zero)?;\n   880\t                        pi_push(guarded_x, &mut public_inputs)?;\n   881\t                    }\n   882\t                }\n   883\t                I::TransientHash { inputs, output } => {\n   884\t                    let mut resolved_inputs = Vec::new();\n   885\t                    for inp in inputs {\n   886\t                        let x = resolve_operand(std, layouter, &memory, inp)?;\n   887\t                        let x: AssignedNative<_> = x.try_into()?;\n   888\t                        resolved_inputs.push(x);\n   889\t                    }\n   890\t                    let result = CircuitValue::Native(std.poseidon(layouter, &resolved_inputs)?);\n   891\t                    mem_insert(output.clone(), result, &mut memory)?;\n   892\t                }\n   893\t                I::PersistentHash {\n   894\t                    alignment,\n   895\t                    inputs,\n   896\t                    output,\n   897\t                }\n   898\t                | I::Keccak256 {\n   899\t                    alignment,\n   900\t                    inputs,\n   901\t                    output,\n   902\t                } => {\n   903\t                    let mut resolved_inputs = Vec::new();\n   904\t                    for inp in inputs {\n   905\t                        let x = resolve_operand(std, layouter, &memory, inp)?;\n   906\t                        let x: AssignedNative<_> = x.try_into()?;\n   907\t                        resolved_inputs.push(x);\n   908\t                    }\n   909\t                    let inputs = resolved_inputs;\n   910\t                    let bytes = fab_decode_to_bytes(std, layouter, alignment, &inputs)?;\n   911\t                    let hash_output = match ins {\n   912\t                        I::PersistentHash { .. } => std.sha2_256(layouter, &bytes)?,\n   913\t                        I::Keccak256 { .. } => std.keccak_256(layouter, &bytes)?,\n   914\t                        _ => unreachable!(),\n   915\t                    };\n   916\t                    mem_insert(\n   917\t                        output.clone(),\n   918\t                        CircuitValue::Bytes32(hash_output),\n   919\t                        &mut memory,\n   920\t                    )?;\n   921\t                }\n   922\t                I::TestEq { a, b, output } => {\n   923\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   924\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   925\t                    let bit = test_eq_incircuit(std, layouter, &a_val, &b_val)?;\n   926\t                    let result = CircuitValue::Native(std.convert(layouter, &bit)?);\n   927\t                    mem_insert(output.clone(), result, &mut memory)?;\n   928\t                }\n   929\t                I::Add { a, b, output } => {\n   930\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   931\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   932\t                    let result = add_incircuit(std, layouter, &a_val, &b_val)?;\n   933\t                    mem_insert(output.clone(), result, &mut memory)?;\n   934\t                }\n   935\t                I::Mul { a, b, output } => {\n   936\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   937\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   938\t                    let result = mul_incircuit(std, layouter, &a_val, &b_val)?;\n   939\t                    mem_insert(output.clone(), result, &mut memory)?;\n   940\t                }\n   941\t                I::Neg { a, output } => {\n   942\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   943\t                    let result = neg_incircuit(std, layouter, &a_val)?;\n   944\t                    mem_insert(output.clone(), result, &mut memory)?;\n   945\t                }\n   946\t                I::Inv { a, output } => {\n   947\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   948\t                    let result = inv_incircuit(std, layouter, &a_val)?;\n   949\t                    mem_insert(output.clone(), result, &mut memory)?;\n   950\t                }\n   951\t                I::Not { a, output } => {\n   952\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   953\t                    let a: AssignedNative<_> = a_val.try_into()?;\n   954\t                    let bit: AssignedBit<_> = std.convert(layouter, &a)?;\n   955\t                    let neg_bit = std.not(layouter, &bit)?;\n   956\t                    let result = CircuitValue::Native(std.convert(layouter, &neg_bit)?);\n   957\t                    mem_insert(output.clone(), result, &mut memory)?;\n   958\t                }\n   959\t                I::LessThan { a, b, bits, output } => {\n   960\t                    // Adding mod 2 to meet library constraint that this is even\n   961\t                    // Hidden req that this is >= 4\n   962\t                    let a_val = resolve_operand(std, layouter, &memory, a)?;\n   963\t                    let b_val = resolve_operand(std, layouter, &memory, b)?;\n   964\t                    let a: AssignedNative<_> = a_val.try_into()?;\n   965\t                    let b: AssignedNative<_> = b_val.try_into()?;\n   966\t                    let bit = std.lower_than(layouter, &a, &b, u32::max(*bits + *bits % 2, 4))?;\n   967\t                    let result = CircuitValue::Native(std.convert(layouter, &bit)?);\n   968\t                    mem_insert(output.clone(), result, &mut memory)?;\n   969\t                }\n   970\t                I::JubjubScalarFromNative { native, output } => {\n   971\t                    let x: AssignedNative<_> =\n   972\t                        resolve_operand(std, layouter, &memory, native)?.try_into()?;\n   973\t                    let x_bytes = std.assigned_to_le_bytes(layouter, &x, None)?;\n   974\t                    let x_big = std.biguint().from_le_bytes(layouter, &x_bytes)?;\n   975\t                    let s = jubjub_scalar_from_biguint(std, layouter, x_big)?;\n   976\t                    mem_insert(output.clone(), CircuitValue::JubjubScalar(s), &mut memory)?;\n   977\t                }\n   978\t                I::PublicInput {\n   979\t                    guard: _,\n   980\t                    val_t,\n   981\t                    output,\n   982\t                }\n   983\t                | I::PrivateInput {\n   984\t                    guard: _,\n   985\t                    val_t,\n   986\t                    output,\n   987\t                } => {\n   988\t                    let value = witness.as_ref().map_with_result(|preproc| {\n   989\t                        preproc\n   990\t                            .memory\n   991\t                            .get(output)\n   992\t                            .cloned()\n   993\t                            .ok_or(Error::Synthesis(format!(\n   994\t                                \"Output {:?} not found in witness memory\",\n   995\t                                output\n   996\t                            )))\n   997\t                    })?;\n   998\t\n   999\t                    mem_insert(\n  1000\t                        output.clone(),\n  1001\t                        assign_incircuit(std, layouter, val_t, &[value])?[0].clone(),\n  1002\t                        &mut memory,\n  1003\t                    )?;\n  1004\t                }\n  1005\t                I::DivModPowerOfTwo { val, bits, outputs } => {\n  1006\t                    if outputs.len() != 2 {\n  1007\t                        return Err(Error::Synthesis(\n  1008\t                            \"Unexpected output length of DivModPowerOfTwo instruction\".into(),\n  1009\t                        ));\n  1010\t                    }\n  1011\t                    let val = resolve_operand(std, layouter, &memory, val)?;\n  1012\t                    let val: AssignedNative<_> = val.try_into()?;\n  1013\t                    let val_bits = std.assigned_to_le_bits(layouter, &val, None, true)?;\n  1014\t                    let modulus = CircuitValue::Native(\n  1015\t                        std.assigned_from_le_bits(layouter, &val_bits[..*bits as usize])?,\n  1016\t                    );\n  1017\t\n  1018\t                    let divisor = CircuitValue::Native(\n  1019\t                        std.assigned_from_le_bits(layouter, &val_bits[*bits as usize..])?,\n  1020\t                    );\n  1021\t\n  1022\t                    mem_insert(outputs[0].clone(), divisor, &mut memory)?;\n  1023\t                    mem_insert(outputs[1].clone(), modulus, &mut memory)?;\n  1024\t                }\n  1025\t                I::ReconstituteField {\n  1026\t                    divisor,\n  1027\t                    modulus,\n  1028\t                    bits,\n  1029\t                    output,\n  1030\t                } => {\n  1031\t                    let divisor_val = resolve_operand(std, layouter, &memory, divisor)?;\n  1032\t                    let modulus_val = resolve_operand(std, layouter, &memory, modulus)?;\n  1033\t                    let divisor: AssignedNative<_> = divisor_val.try_into()?;\n  1034\t                    let modulus: AssignedNative<_> = modulus_val.try_into()?;\n  1035\t\n  1036\t                    std.assert_lower_than_fixed(\n  1037\t                        layouter,\n  1038\t                        &divisor,\n  1039\t                        &(BigUint::from(1u32) << (FR_BITS as u32 - *bits)),\n  1040\t                    )?;\n  1041\t                    std.assert_lower_than_fixed(\n  1042\t                        layouter,\n  1043\t                        &modulus,\n  1044\t                        &(BigUint::from(1u32) << *bits),\n  1045\t                    )?;\n  1046\t\n  1047\t                    use group::ff::Field;\n  1048\t                    let result = CircuitValue::Native(std.linear_combination(\n  1049\t                        layouter,\n  1050\t                        &[\n  1051\t                            (outer::Scalar::from(1), modulus),\n  1052\t                            (outer::Scalar::from(2).pow([*bits as u64]), divisor),\n  1053\t                        ],\n  1054\t                        outer::Scalar::from(0),\n  1055\t                    )?);\n  1056\t                    mem_insert(output.clone(), result, &mut memory)?;\n  1057\t                }\n  1058\t                I::EcMul { a, scalar, output } => {\n  1059\t                    let p = resolve_operand(std, layouter, &memory, a)?;\n  1060\t                    let s = resolve_operand(std, layouter, &memory, scalar)?;\n  1061\t                    let r = ec_mul_incircuit(std, layouter, &p, &s)?;\n  1062\t                    mem_insert(output.clone(), r, &mut memory)?;\n  1063\t                }\n  1064\t                I::EcMulGenerator { scalar, output } => {\n  1065\t                    let s = resolve_operand(std, layouter, &memory, scalar)?;\n  1066\t                    let p = match s.get_type() {\n  1067\t                        IrType::JubjubScalar => CircuitValue::JubjubPoint(\n  1068\t                            std.jubjub()\n  1069\t                                .assign_fixed(layouter, JubjubSubgroup::generator())?,\n  1070\t                        ),\n  1071\t                        IrType::Secp256k1Scalar => CircuitValue::Secp256k1Point(\n  1072\t                            std.secp256k1()\n  1073\t                                .assign_fixed(layouter, k256::K256::generator())?,\n  1074\t                        ),\n  1075\t                        t => {\n  1076\t                            return Err(Error::Synthesis(format!(\n  1077\t                                \"Unsupported EcMulGenerator for scalar of type {t:?}\"\n  1078\t                            )));\n  1079\t                        }\n  1080\t                    };\n  1081\t                    let r = ec_mul_incircuit(std, layouter, &p, &s)?;\n  1082\t                    mem_insert(output.clone(), r, &mut memory)?;\n  1083\t                }\n  1084\t                I::HashToCurve { inputs, output } => {\n  1085\t                    let mut resolved_inputs = Vec::new();\n  1086\t                    for inp in inputs {\n  1087\t                        let x = resolve_operand(std, layouter, &memory, inp)?;\n  1088\t                        let x: AssignedNative<_> = x.try_into()?;\n  1089\t                        resolved_inputs.push(x);\n  1090\t                    }\n  1091\t                    let point = std.hash_to_curve(layouter, &resolved_inputs)?;\n  1092\t                    mem_insert(\n  1093\t                        output.clone(),\n  1094\t                        CircuitValue::JubjubPoint(point),\n  1095\t                        &mut memory,\n  1096\t                    )?;\n  1097\t                }\n  1098\t                I::IntoCoordinates { point, outputs } => {\n  1099\t                    let p = resolve_operand(std, layouter, &memory, point)?;\n  1100\t                    let coordinates = into_coordinates_incircuit(std, layouter, &p)?;\n  1101\t                    mem_insert(outputs.0.clone(), coordinates.0, &mut memory)?;\n  1102\t                    mem_insert(outputs.1.clone(), coordinates.1, &mut memory)?;\n  1103\t                }\n  1104\t                I::FromCoordinates { inputs, output } => {\n  1105\t                    let x = resolve_operand(std, layouter, &memory, &inputs.0)?;\n  1106\t                    let y = resolve_operand(std, layouter, &memory, &inputs.1)?;\n  1107\t                    let p = from_coordinates_incircuit(std, layouter, &x, &y)?;\n  1108\t                    mem_insert(output.clone(), p, &mut memory)?;\n  1109\t                }\n  1110\t                I::IntoBytes32 { input, output } => {\n  1111\t                    let x = resolve_operand(std, layouter, &memory, input)?;\n  1112\t                    let bytes = into_bytes32_incircuit(std, layouter, &x)?;\n  1113\t                    mem_insert(output.clone(), bytes, &mut memory)?;\n  1114\t                }\n  1115\t                I::FromBytes32 {\n  1116\t                    val_t,\n  1117\t                    bytes,\n  1118\t                    output,\n  1119\t                } => {\n  1120\t                    let bytes = resolve_operand(std, layouter, &memory, bytes)?;\n  1121\t                    let bytes: [AssignedByte<outer::Scalar>; 32] = bytes.try_into()?;\n  1122\t                    let x = from_bytes32_incircuit(std, layouter, val_t, &bytes)?;\n  1123\t                    memory.insert(output.clone(), x);\n  1124\t                }\n  1125\t                I::ReverseBytes { bytes, output } => {\n  1126\t                    let bytes = resolve_operand(std, layouter, &memory, bytes)?;\n  1127\t                    let mut bytes: [AssignedByte<outer::Scalar>; 32] = bytes.try_into()?;\n  1128\t                    bytes.reverse();\n  1129\t                    memory.insert(output.clone(), CircuitValue::Bytes32(bytes));\n  1130\t                }\n  1131\t                I::Bytes32IntoLowHigh { bytes, outputs } => {\n  1132\t                    let bytes = resolve_operand(std, layouter, &memory, bytes)?;\n  1133\t                    let mut bytes: [AssignedByte<outer::Scalar>; 32] = bytes.try_into()?;\n  1134\t                    let high = CircuitValue::Native(std.convert(layouter, &bytes[31])?);\n  1135\t                    bytes[31] = std.assign_fixed(layouter, 0u8)?;\n  1136\t                    let low = from_bytes32_incircuit(std, layouter, &IrType::Native, &bytes)?;\n  1137\t                    memory.insert(outputs.0.clone(), low);\n  1138\t                    memory.insert(outputs.1.clone(), high);\n  1139\t                }\n  1140\t                I::Bytes32FromLowHigh { inputs, output } => {\n  1141\t                    let low = resolve_operand(std, layouter, &memory, &inputs.0)?;\n  1142\t                    let high: AssignedNative<_> =\n  1143\t                        resolve_operand(std, layouter, &memory, &inputs.1)?.try_into()?;\n  1144\t                    let bytes_low: [AssignedByte<outer::Scalar>; 32] =\n  1145\t                        into_bytes32_incircuit(std, layouter, &low)?.try_into()?;\n  1146\t                    std.assert_equal_to_fixed(layouter, &bytes_low[31], 0u8)?;\n  1147\t                    let mut out_bytes = bytes_low;\n  1148\t                    out_bytes[31] = std.convert(layouter, &high)?;\n  1149\t                    memory.insert(output.clone(), CircuitValue::Bytes32(out_bytes));\n  1150\t                }\n  1151\t                I::Output { vals } => {\n  1152\t                    if vals.len() != self.outputs.len() {\n  1153\t                        return Err(Error::Synthesis(format!(\n  1154\t                            \"Output: signature declares {} return values but instruction has {}\",\n  1155\t                            self.outputs.len(),\n  1156\t                            vals.len()\n  1157\t                        )));\n  1158\t                    }\n  1159\t                    for (i, (val, expected_t)) in vals.iter().zip(self.outputs.iter()).enumerate() {\n  1160\t                        let value = resolve_operand(std, layouter, &memory, val)?;\n  1161\t                        if value.get_type() != *expected_t {\n  1162\t                            return Err(Error::Synthesis(format!(\n  1163\t                                \"Output position {i}: signature declares {:?} but operand has runtime type {:?}\",\n  1164\t                                expected_t,\n  1165\t                                value.get_type()\n  1166\t                            )));\n  1167\t                        }\n  1168\t                        outputs.push(value);\n  1169\t                    }\n  1170\t                }\n  1171\t            }\n  1172\t        }\n  1173\t        if self.do_communications_commitment {\n  1174\t            let comm_comm_rand_value = comm_comm_value.map(|c| {\n  1175\t                c.ok_or_else(|| {\n  1176\t                    error!(\"Communication commitment not present despite preproc. This is a bug.\");\n  1177\t                    Error::Synthesis(\"Communication commitment not present despite preproc.\".into())\n  1178\t                })\n  1179\t                .unwrap()\n  1180\t                .1\n  1181\t            });\n  1182\t            let comm_comm_rand = std.assign(layouter, comm_comm_rand_value)?;\n  1183\t\n  1184\t            let mut preimage = vec![comm_comm_rand];\n  1185\t            for id in &self.inputs {\n  1186\t                if let Some(val) = memory.get(&id.name) {\n  1187\t                    for cv in encode_incircuit(std, layouter, val)? {\n  1188\t                        let x: AssignedNative<_> = cv.try_into()?;\n  1189\t                        preimage.push(x);\n  1190\t                    }\n  1191\t                }\n  1192\t            }\n  1193\t\n  1194\t            for value in &outputs {\n  1195\t                for cv in encode_incircuit(std, layouter, value)? {\n  1196\t                    let x: AssignedNative<_> = cv.try_into()?;\n  1197\t                    preimage.push(x);\n  1198\t                }\n  1199\t            }\n  1200\t\n  1201\t            let comm_comm = std.poseidon(layouter, &preimage)?;\n  1202\t            // Nb. The communications commitment is the second public input\n  1203\t            // by convention\n  1204\t            std.assert_equal(layouter, &comm_comm, &public_inputs[1])?;\n  1205\t        }\n  1206\t\n  1207\t        public_inputs\n  1208\t            .iter()\n  1209\t            .try_for_each(|x| std.constrain_as_public_input(layouter, x))\n  1210\t    }\n  1211\t\n  1212\t    fn used_chips(&self) -> ZkStdLibArch {\n  1213\t        let involves_types = |target_types: &[IrType]| -> bool {\n  1214\t            let types_in_inputs = self\n  1215\t                .inputs\n  1216\t                .iter()\n  1217\t                .any(|id| target_types.contains(&id.val_t));\n  1218\t\n  1219\t            // We can figure out if a type is used in the circuit by looking at the entry\n  1220\t            // points, currently: PublicInput or PrivateInput.\n  1221\t            let types_in_instructions = self.instructions.iter().any(|op| match op {\n  1222\t                I::PublicInput { val_t, .. } | I::PrivateInput { val_t, .. } => {\n  1223\t                    target_types.contains(val_t)\n  1224\t                }\n  1225\t                _ => false,\n  1226\t            });\n  1227\t\n  1228\t            types_in_inputs || types_in_instructions\n  1229\t        };\n  1230\t\n  1231\t        let involves_instructions = |match_predicate: &dyn Fn(&I) -> bool| -> bool {\n  1232\t            self.instructions.iter().any(match_predicate)\n  1233\t        };\n  1234\t\n  1235\t        ZkStdLibArch {\n  1236\t            jubjub: involves_types(&[IrType::JubjubPoint, IrType::JubjubScalar])\n  1237\t                || involves_instructions(&|op| matches!(op, I::HashToCurve { .. })),\n  1238\t            poseidon: self.do_communications_commitment\n  1239\t                || involves_instructions(&|op| {\n  1240\t                    matches!(op, I::TransientHash { .. } | I::HashToCurve { .. })\n  1241\t                }),\n  1242\t            sha2_256: involves_instructions(&|op| matches!(op, I::PersistentHash { .. })),\n  1243\t            sha2_512: false,\n  1244\t            keccak_256: involves_instructions(&|op| matches!(op, I::Keccak256 { .. })),\n  1245\t            sha3_256: false,\n  1246\t            blake2b: false,\n  1247\t            nr_pow2range_cols: 4,\n  1248\t            secp256k1: involves_types(&[\n  1249\t                IrType::Secp256k1Point,\n  1250\t                IrType::Secp256k1Base,\n  1251\t                IrType::Secp256k1Scalar,\n  1252\t            ]),\n  1253\t            p256: involves_types(&[IrType::Secp256r1Point, IrType::Secp256r1Base, IrType::Secp256r1Scalar]),\n  1254\t            bls12_381: false,\n  1255\t            curve25519: involves_types(&[\n  1256\t                IrType::Curve25519Point,\n  1257\t                IrType::Curve25519Base,\n  1258\t                IrType::Curve25519Scalar,\n  1259\t            ]),\n  1260\t            base64: false,\n  1261\t            automaton: false,\n  1262\t        }\n  1263\t    }\n  1264\t\n  1265\t    fn write_relation<W: std::io::Write>(&self, writer: &mut W) -> std::io::Result<()> {\n  1266\t        let mut raw = Vec::new();\n  1267\t        tagged_serialize(&self, &mut raw)?;\n  1268\t        raw.serialize(writer)\n  1269\t    }\n  1270\t\n  1271\t    fn read_relation<R: std::io::Read>(reader: &mut R) -> std::io::Result<Self> {\n  1272\t        let raw: Vec<u8> = Deserializable::deserialize(reader, 0)?;\n  1273\t        tagged_deserialize(&mut &raw[..])\n  1274\t    }\n  1275\t}\n","exit_code":0,"status":"completed"}}
