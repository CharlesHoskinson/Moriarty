{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"nl -ba experiments/zkir-k/tools/diff_test.py | sed -n '1,118p'; nl -ba experiments/zkir-k/semantics/zkir-syntax.k | sed -n '110,315p'; nl -ba experiments/zkir-k/semantics/zkir-values.k | sed -n '215,265p'\"","aggregated_output":"     1\t\"\"\"Oracle 1: differential test of the K semantics against the Rust crate.\n     2\t\n     3\tFor every version-3 program in the corpus:\n     4\t  1. draw raw inputs of the declared types (seeded per program);\n     5\t  2. run the K semantics in generation mode until the transcript needs are\n     6\t     stable (public/private transcript values of the requested types are\n     7\t     appended, impact values become public_transcript_inputs, and the\n     8\t     communications commitment is taken from the run);\n     9\t  3. run the real K semantics and the Rust `preprocess` (zkir-oracle) on the\n    10\t     same preimage and compare status, memory (variant and encoding of every\n    11\t     register), public inputs and skips;\n    12\t  4. repeat step 3 with one perturbed preimage (first raw input replaced), so\n    13\t     that error paths are compared too.\n    14\t\n    15\tUsage: uv run --group zkir-k python experiments/zkir-k/tools/diff_test.py [--only SUBSTR] [--seed N]\n    16\tExit 0 iff every comparison agrees.\n    17\t\"\"\"\n    18\tfrom __future__ import annotations\n    19\t\n    20\timport argparse\n    21\timport json\n    22\timport random\n    23\timport subprocess\n    24\timport sys\n    25\timport tempfile\n    26\timport time\n    27\tfrom pathlib import Path\n    28\t\n    29\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    30\timport zkir_kast  # noqa: E402\n    31\timport zkir_values as zv  # noqa: E402\n    32\tfrom zkir_run import Runner  # noqa: E402\n    33\t\n    34\tHERE = Path(__file__).resolve().parent\n    35\tROOT = HERE.parent\n    36\tREPO = ROOT.parent.parent\n    37\tORACLE = Path.home() / 'Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle'\n    38\tORACLE_EXT = Path.home() / 'Moriarty/repos/_build/midnight-zkir-2ffe2d1/target/release/zkir-oracle'\n    39\t\n    40\tCORPORA = {\n    41\t    'ledger9-92e8bdd3-tests': ROOT / 'corpus' / 'ledger9-92e8bdd3-tests',\n    42\t    'midnight-zkir-2ffe2d1-precompiles': ROOT / 'corpus' / 'midnight-zkir-2ffe2d1-precompiles',\n    43\t    'moriarty-compact-escrow': REPO / 'experiments' / 'moriarty-compact-escrow' / 'output' / 'zkir',\n    44\t    'moriarty-core-swap': REPO / 'experiments' / 'moriarty-core-swap' / 'output' / 'zkir',\n    45\t    'handmade': ROOT / 'corpus' / 'handmade',\n    46\t}\n    47\t\n    48\t\n    49\tORACLE_BIN = ORACLE\n    50\t\n    51\t\n    52\tdef oracle(program: Path, preimage: dict) -> dict:\n    53\t    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:\n    54\t        json.dump(preimage, f)\n    55\t    res = subprocess.run([str(ORACLE_BIN), str(program), f.name], capture_output=True, text=True)\n    56\t    if res.returncode != 0:\n    57\t        return {'status': 'oracle-failed', 'error': res.stderr[-500:]}\n    58\t    return json.loads(res.stdout)\n    59\t\n    60\t\n    61\tdef strs(xs):\n    62\t    return [str(x) for x in xs]\n    63\t\n    64\t\n    65\tdef build_preimage(runner: Runner, program, doc: dict, rng: random.Random, small: bool, seed_pre: dict | None = None) -> tuple[dict, int]:\n    66\t    gen = zv.small_encoded if small else zv.random_encoded\n    67\t    inputs = [x for entry in doc['inputs'] for x in gen(entry['type'], rng)]\n    68\t    rand = rng.randrange(zv.R)\n    69\t    pre = {'inputs': strs(inputs), 'binding_input': str(rng.randrange(zv.R)),\n    70\t           'private_transcript': [], 'public_transcript_inputs': [], 'public_transcript_outputs': []}\n    71\t    if seed_pre:\n    72\t        # the crate's own test values, when they are literals (manifest test_preimage)\n    73\t        for key in ('inputs', 'private_transcript', 'public_transcript_outputs', 'binding_input'):\n    74\t            if key in seed_pre:\n    75\t                pre[key] = seed_pre[key]\n    76\t    if doc['do_communications_commitment']:\n    77\t        pre['communications_commitment'] = ['0', str(rand)]\n    78\t    passes = 0\n    79\t    for _ in range(8):\n    80\t        passes += 1\n    81\t        res = runner.run(program, pre, gen=True)\n    82\t        if res['status'] == 'krun-failed':\n    83\t            raise RuntimeError(res['error'])\n    84\t        needs = res['needs']\n    85\t        new_out = [t for kind, t in needs if kind == 'pubOut']\n    86\t        new_priv = [t for kind, t in needs if kind == 'priv']\n    87\t        pre['public_transcript_inputs'] = strs(x for kind, x in needs if kind == 'pubIn')\n    88\t        comm = [x for kind, x in needs if kind == 'comm']\n    89\t        if comm:\n    90\t            pre['communications_commitment'] = [str(comm[0]), str(rand)]\n    91\t        if not new_out and not new_priv:\n    92\t            break\n    93\t        pre['public_transcript_outputs'] += strs(x for t in new_out for x in gen(t, rng))\n    94\t        pre['private_transcript'] += strs(x for t in new_priv for x in gen(t, rng))\n    95\t    return pre, passes\n    96\t\n    97\t\n    98\tdef compare(k: dict, r: dict) -> list[str]:\n    99\t    diffs = []\n   100\t    if k['status'] != r['status']:\n   101\t        return [f\"status K={k['status']} ({k.get('error', '')[:80]}) Rust={r['status']} ({r.get('error', '')[:80]})\"]\n   102\t    if k['status'] != 'ok':\n   103\t        return diffs\n   104\t    if k['pis'] != r['pis']:\n   105\t        diffs.append(f\"pis differ: K={k['pis'][:6]} Rust={r['pis'][:6]}\")\n   106\t    if k['pi_skips'] != r['pi_skips']:\n   107\t        diffs.append(f\"pi_skips differ: K={k['pi_skips']} Rust={r['pi_skips']}\")\n   108\t    km, rm = k['memory'], r['memory']\n   109\t    for name in sorted(set(km) | set(rm)):\n   110\t        if name not in km:\n   111\t            diffs.append(f'{name}: missing in K')\n   112\t        elif name not in rm:\n   113\t            diffs.append(f'{name}: missing in Rust')\n   114\t        elif km[name] != rm[name]:\n   115\t            diffs.append(f\"{name}: K={km[name]} Rust={rm[name]}\")\n   116\t    return diffs\n   117\t\n   118\t\n   110\t                 | add(Operand, Operand, String)                   [symbol(add)]\n   111\t                 | mul(Operand, Operand, String)                   [symbol(mul)]\n   112\t                 | neg(Operand, String)                            [symbol(neg)]\n   113\t                 | inv(Operand, String)                            [symbol(inv)]\n   114\t                 | not(Operand, String)                            [symbol(not)]\n   115\t                 | lessThan(Operand, Operand, Int, String)         [symbol(less_than)]     // a, b, bits, output\n   116\t                 | jubjubScalarFromNative(Operand, String)         [symbol(jubjub_scalar_from_native)]\n   117\t                 | publicInput(Guard, IrType, String)              [symbol(public_input)]\n   118\t                 | privateInput(Guard, IrType, String)             [symbol(private_input)]\n   119\t                 | output(Operands)                                [symbol(output)]\n   120\t\n   121\t  // --- Field constants --------------------------------------------------------\n   122\t  // BLS12-381 scalar field modulus r (the native field), FR_BITS = 255,\n   123\t  // FR_BYTES_STORED = 31 (transient-crypto/src/curve.rs).\n   124\t  syntax Int ::= \"#blsScalarModulus\" [function, total]\n   125\t  rule #blsScalarModulus => 52435875175126190479447740508185965837690552500527637822603658699938581184513\n   126\t  syntax Int ::= \"#frBits\" [function, total]\n   127\t  rule #frBits => 255\n   128\t  syntax Int ::= \"#frBytesStored\" [function, total]\n   129\t  rule #frBytesStored => 31\n   130\t\n   131\t  // --- Reads and writes of an instruction -----------------------------------\n   132\t  // reads(I): every operand the instruction resolves off-circuit, in the order\n   133\t  // `IrSource::preprocess` resolves them. writes(I): identifiers it defines.\n   134\t  syntax Operands ::= reads(Instr) [function, total]\n   135\t  rule reads(encode(X, _))                     => X, .Operands\n   136\t  rule reads(assert(C))                        => C, .Operands\n   137\t  rule reads(condSelect(B, A, C, _))           => B, A, C, .Operands\n   138\t  rule reads(constrainBits(V, _))              => V, .Operands\n   139\t  rule reads(constrainEq(A, B))                => A, B, .Operands\n   140\t  rule reads(constrainToBoolean(V))            => V, .Operands\n   141\t  rule reads(copy(V, _))                       => V, .Operands\n   142\t  rule reads(impact(G, Is))                    => G, Is\n   143\t  rule reads(ecMul(A, S, _))                   => A, S, .Operands\n   144\t  rule reads(ecMulGenerator(S, _))             => S, .Operands\n   145\t  rule reads(hashToCurve(Is, _))               => Is\n   146\t  rule reads(intoCoordinates(P, _, _))         => P, .Operands\n   147\t  rule reads(fromCoordinates(X, Y, _))         => X, Y, .Operands\n   148\t  rule reads(intoBytes32(X, _))                => X, .Operands\n   149\t  rule reads(fromBytes32(B, _, _))             => B, .Operands\n   150\t  rule reads(reverseBytes(B, _))               => B, .Operands\n   151\t  rule reads(bytes32IntoLowHigh(B, _, _))      => B, .Operands\n   152\t  rule reads(bytes32FromLowHigh(L, H, _))      => L, H, .Operands\n   153\t  rule reads(divModPowerOfTwo(V, _, _))        => V, .Operands\n   154\t  rule reads(reconstituteField(D, M, _, _))    => M, D, .Operands\n   155\t  rule reads(transientHash(Is, _))             => Is\n   156\t  rule reads(persistentHash(_, Is, _))         => Is\n   157\t  rule reads(keccak256(_, Is, _))              => Is\n   158\t  rule reads(testEq(A, B, _))                  => A, B, .Operands\n   159\t  rule reads(add(A, B, _))                     => A, B, .Operands\n   160\t  rule reads(mul(A, B, _))                     => A, B, .Operands\n   161\t  rule reads(neg(A, _))                        => A, .Operands\n   162\t  rule reads(inv(A, _))                        => A, .Operands\n   163\t  rule reads(not(A, _))                        => A, .Operands\n   164\t  rule reads(lessThan(A, B, _, _))             => A, B, .Operands\n   165\t  rule reads(jubjubScalarFromNative(N, _))     => N, .Operands\n   166\t  rule reads(publicInput(noGuard(), _, _))     => .Operands\n   167\t  rule reads(publicInput(guard(G), _, _))      => G, .Operands\n   168\t  rule reads(privateInput(noGuard(), _, _))    => .Operands\n   169\t  rule reads(privateInput(guard(G), _, _))     => G, .Operands\n   170\t  rule reads(output(Vs))                       => Vs\n   171\t\n   172\t  syntax Ids ::= writes(Instr) [function, total]\n   173\t  rule writes(encode(_, Os))                   => Os\n   174\t  rule writes(assert(_))                       => .Ids\n   175\t  rule writes(condSelect(_, _, _, O))          => O, .Ids\n   176\t  rule writes(constrainBits(_, _))             => .Ids\n   177\t  rule writes(constrainEq(_, _))               => .Ids\n   178\t  rule writes(constrainToBoolean(_))           => .Ids\n   179\t  rule writes(copy(_, O))                      => O, .Ids\n   180\t  rule writes(impact(_, _))                    => .Ids\n   181\t  rule writes(ecMul(_, _, O))                  => O, .Ids\n   182\t  rule writes(ecMulGenerator(_, O))            => O, .Ids\n   183\t  rule writes(hashToCurve(_, O))               => O, .Ids\n   184\t  rule writes(intoCoordinates(_, X, Y))        => X, Y, .Ids\n   185\t  rule writes(fromCoordinates(_, _, O))        => O, .Ids\n   186\t  rule writes(intoBytes32(_, O))               => O, .Ids\n   187\t  rule writes(fromBytes32(_, _, O))            => O, .Ids\n   188\t  rule writes(reverseBytes(_, O))              => O, .Ids\n   189\t  rule writes(bytes32IntoLowHigh(_, L, H))     => L, H, .Ids\n   190\t  rule writes(bytes32FromLowHigh(_, _, O))     => O, .Ids\n   191\t  rule writes(divModPowerOfTwo(_, _, Os))      => Os\n   192\t  rule writes(reconstituteField(_, _, _, O))   => O, .Ids\n   193\t  rule writes(transientHash(_, O))             => O, .Ids\n   194\t  rule writes(persistentHash(_, _, O))         => O, .Ids\n   195\t  rule writes(keccak256(_, _, O))              => O, .Ids\n   196\t  rule writes(testEq(_, _, O))                 => O, .Ids\n   197\t  rule writes(add(_, _, O))                    => O, .Ids\n   198\t  rule writes(mul(_, _, O))                    => O, .Ids\n   199\t  rule writes(neg(_, O))                       => O, .Ids\n   200\t  rule writes(inv(_, O))                       => O, .Ids\n   201\t  rule writes(not(_, O))                       => O, .Ids\n   202\t  rule writes(lessThan(_, _, _, O))            => O, .Ids\n   203\t  rule writes(jubjubScalarFromNative(_, O))    => O, .Ids\n   204\t  rule writes(publicInput(_, _, O))            => O, .Ids\n   205\t  rule writes(privateInput(_, _, O))           => O, .Ids\n   206\t  rule writes(output(_))                       => .Ids\n   207\t\n   208\t  // --- List lengths -----------------------------------------------------------\n   209\t  syntax Int ::= lenOperands(Operands) [function, total]\n   210\t  rule lenOperands(.Operands)  => 0\n   211\t  rule lenOperands(_, Os)      => 1 +Int lenOperands(Os)\n   212\t  syntax Int ::= lenIds(Ids) [function, total]\n   213\t  rule lenIds(.Ids)            => 0\n   214\t  rule lenIds(_, Xs)           => 1 +Int lenIds(Xs)\n   215\t  syntax Int ::= lenIrTypes(IrTypes) [function, total]\n   216\t  rule lenIrTypes(.IrTypes)    => 0\n   217\t  rule lenIrTypes(_, Ts)       => 1 +Int lenIrTypes(Ts)\n   218\t  syntax Int ::= lenInstrs(Instrs) [function, total]\n   219\t  rule lenInstrs(.Instrs)      => 0\n   220\t  rule lenInstrs(_ ; Is)       => 1 +Int lenInstrs(Is)\n   221\tendmodule\n   222\t\n   223\t\n   224\t// Static well-formedness, checked before execution. The checks are those that\n   225\t// hold for every run regardless of inputs:\n   226\t//   1. minor version is 0 (`IrSource::load` accepts 3.0 only);\n   227\t//   2. no identifier is defined twice: not among the inputs, and not by an\n   228\t//      instruction once defined (single assignment, plan decision CLM-0711;\n   229\t//      the Rust preprocess does not enforce this and silently overwrites);\n   230\t//   3. every variable operand is defined by an earlier input or instruction\n   231\t//      (the Rust preprocess reports \"variable not found\" at run time);\n   232\t//   4. immediates lie in [0, r);\n   233\t//   5. arities that the Rust code checks structurally: `output` supplies\n   234\t//      exactly as many values as the signature declares, `div_mod_power_of_two`\n   235\t//      names exactly two outputs, `encode` names exactly encodedLen(type)\n   236\t//      outputs (checked at run time, since the type is dynamic; not here);\n   237\t//   6. bit widths: constrain_bits < FR_BITS; div_mod_power_of_two,\n   238\t//      reconstitute_field and less_than at most FR_BYTES_STORED * 8 = 248\n   239\t//      (the Rust bounds, `ir_vm.rs`).\n   240\t// Everything else (types of operands, guard values, transcript lengths) is\n   241\t// dynamic and belongs to ZKIR-VM.\n   242\tmodule ZKIR-WF\n   243\t  imports ZKIR-SYNTAX\n   244\t  imports SET\n   245\t  imports K-EQUAL\n   246\t\n   247\t  syntax WfResult ::= wfOk()            [symbol(wfOk)]\n   248\t                    | wfError(String)   [symbol(wfError)]\n   249\t\n   250\t  syntax WfResult ::= wf(Program) [function, total]\n   251\t  rule wf(program(Minor, _, _, _, _)) => wfError(\"unsupported minor version \" +String Int2String(Minor))\n   252\t    requires Minor =/=Int 0\n   253\t  rule wf(program(0, Ins, Outs, _, Is)) => #wfInputs(Ins, .Set, Is, lenIrTypes(Outs))\n   254\t\n   255\t  // Inputs: distinct identifiers, then walk the instructions.\n   256\t  syntax WfResult ::= #wfInputs(TypedIds, Set, Instrs, Int) [function, total]\n   257\t  rule #wfInputs(.TypedIds, Defined, Is, N) => #wfInstrs(Is, Defined, N)\n   258\t  rule #wfInputs((typedId(X, _), _), Defined, _, _) => wfError(\"duplicate input \" +String X)\n   259\t    requires X in Defined\n   260\t  rule #wfInputs((typedId(X, _), Rest), Defined, Is, N) => #wfInputs(Rest, Defined |Set SetItem(X), Is, N)\n   261\t    requires notBool (X in Defined)\n   262\t\n   263\t  syntax WfResult ::= #wfInstrs(Instrs, Set, Int) [function, total]\n   264\t  rule #wfInstrs(.Instrs, _, _) => wfOk()\n   265\t  rule #wfInstrs((I ; Is), Defined, N) => #wfAfterReads(#checkReads(reads(I), Defined), I, Is, Defined, N)\n   266\t\n   267\t  syntax WfResult ::= #wfAfterReads(WfResult, Instr, Instrs, Set, Int) [function, total]\n   268\t  rule #wfAfterReads(wfError(S), _, _, _, _) => wfError(S)\n   269\t  rule #wfAfterReads(wfOk(), I, Is, Defined, N) => #wfAfterArity(#checkArity(I, N), I, Is, Defined, N)\n   270\t\n   271\t  syntax WfResult ::= #wfAfterArity(WfResult, Instr, Instrs, Set, Int) [function, total]\n   272\t  rule #wfAfterArity(wfError(S), _, _, _, _) => wfError(S)\n   273\t  rule #wfAfterArity(wfOk(), I, Is, Defined, N) => #wfWrites(writes(I), Is, Defined, N)\n   274\t\n   275\t  syntax WfResult ::= #wfWrites(Ids, Instrs, Set, Int) [function, total]\n   276\t  rule #wfWrites(.Ids, Is, Defined, N) => #wfInstrs(Is, Defined, N)\n   277\t  rule #wfWrites((X, _), _, Defined, _) => wfError(\"reassignment of \" +String X)\n   278\t    requires X in Defined\n   279\t  rule #wfWrites((X, Xs), Is, Defined, N) => #wfWrites(Xs, Is, Defined |Set SetItem(X), N)\n   280\t    requires notBool (X in Defined)\n   281\t\n   282\t  syntax WfResult ::= #checkReads(Operands, Set) [function, total]\n   283\t  rule #checkReads(.Operands, _) => wfOk()\n   284\t  rule #checkReads((imm(V), Os), Defined) => #checkReads(Os, Defined)\n   285\t    requires V >=Int 0 andBool V <Int #blsScalarModulus\n   286\t  rule #checkReads((imm(V), _), _) => wfError(\"immediate out of field range: \" +String Int2String(V))\n   287\t    requires V <Int 0 orBool V >=Int #blsScalarModulus\n   288\t  rule #checkReads((var(X), Os), Defined) => #checkReads(Os, Defined)\n   289\t    requires X in Defined\n   290\t  rule #checkReads((var(X), _), Defined) => wfError(\"undefined variable \" +String X)\n   291\t    requires notBool (X in Defined)\n   292\t\n   293\t  syntax WfResult ::= #checkArity(Instr, Int) [function, total]\n   294\t  rule #checkArity(output(Vs), N) => wfError(\"output: signature declares \" +String Int2String(N) +String \" return values but instruction has \" +String Int2String(lenOperands(Vs)))\n   295\t    requires lenOperands(Vs) =/=Int N\n   296\t  rule #checkArity(divModPowerOfTwo(_, _, Os), _) => wfError(\"div_mod_power_of_two requires exactly 2 outputs\")\n   297\t    requires lenIds(Os) =/=Int 2\n   298\t  rule #checkArity(divModPowerOfTwo(_, B, _), _) => wfError(\"div_mod_power_of_two: excessive bit count\")\n   299\t    requires B >Int #frBytesStored *Int 8\n   300\t  rule #checkArity(reconstituteField(_, _, B, _), _) => wfError(\"reconstitute_field: excessive bit count\")\n   301\t    requires B >Int #frBytesStored *Int 8\n   302\t  rule #checkArity(constrainBits(_, B), _) => wfError(\"constrain_bits: excessive bit bound\")\n   303\t    requires B >=Int #frBits\n   304\t  rule #checkArity(lessThan(_, _, B, _), _) => wfError(\"less_than: excessive bit bound\")\n   305\t    requires B >=Int #frBits\n   306\t  rule #checkArity(_, _) => wfOk() [owise]\n   307\tendmodule\n   215\t    requires size(Fs) ==Int 4\n   216\t\n   217\t  syntax Value ::= #wrapPoint(Point, IrType) [function, total]\n   218\t  rule #wrapPoint(Q, secp256k1Point())  => secp256k1Point(Q)\n   219\t  rule #wrapPoint(Q, secp256r1Point())  => secp256r1Point(Q)\n   220\t  rule #wrapPoint(Q, curve25519Point()) => curve25519Point(Q)\n   221\t  rule #wrapPoint(Q, jubjubPoint())     => jubjubPoint(Q)\n   222\t  rule #wrapPoint(_, _)                 => native(0) [owise]\n   223\t\n   224\t  // Strict decoding re-encodes the value and demands the original elements\n   225\t  // (midnight-zkir 2ffe2d1 `decode_offcircuit`); 92e8bdd3 does not check.\n   226\t  syntax DecodeResult ::= decodeStrict(List, IrType, Bool) [function, total]\n   227\t  rule decodeStrict(L, T, false) => decodeValue(L, T)\n   228\t  rule decodeStrict(L, T, true) => #canonical(decodeValue(L, T), L, T)\n   229\t  syntax DecodeResult ::= #canonical(DecodeResult, List, IrType) [function, total]\n   230\t  rule #canonical(decErr(S), _, _) => decErr(S)\n   231\t  rule #canonical(decOk(V), L, _) => decOk(V) requires encodeValue(V) ==K L\n   232\t  rule #canonical(decOk(V), L, T) => decErr(\"The encoded value of type \" +String typeName(T) +String \" is not in canonical form\") requires encodeValue(V) =/=K L\n   233\t\n   234\t  // Decode a whole raw vector by a list of types (inputs of a program):\n   235\t  // decodeMany(raw, types) is decManyOk(values) or decErr; the Rust code\n   236\t  // reports running out of inputs and leftover inputs as separate errors.\n   237\t  syntax DecodeMany ::= decManyOk(List) | decManyErr(String)\n   238\t  syntax DecodeMany ::= decodeInputs(List, TypedIds, Int, Bool) [function, total]   // (raw, inputs, index, strict)\n   239\t  rule decodeInputs(Raw, .TypedIds, Idx, _) => decManyOk(.List) requires Idx ==Int size(Raw)\n   240\t  rule decodeInputs(Raw, .TypedIds, Idx, _) => decManyErr(\"Expected \" +String Int2String(Idx) +String \" raw inputs, received \" +String Int2String(size(Raw)))\n   241\t    requires Idx =/=Int size(Raw)\n   242\t  rule decodeInputs(Raw, (typedId(N, T), _), Idx, _)\n   243\t    => decManyErr(\"Not enough raw inputs: ran out at index \" +String Int2String(Idx) +String \" while decoding \" +String N)\n   244\t    requires Idx +Int encodedLen(T) >Int size(Raw)\n   245\t  rule decodeInputs(Raw, (typedId(N, T), Rest), Idx, Strict)\n   246\t    => #consDecoded(decodeStrict(range(Raw, Idx, size(Raw) -Int Idx -Int encodedLen(T)), T, Strict), N, decodeInputs(Raw, Rest, Idx +Int encodedLen(T), Strict))\n   247\t    requires Idx +Int encodedLen(T) <=Int size(Raw)\n   248\t  syntax DecodeMany ::= #consDecoded(DecodeResult, String, DecodeMany) [function, total]\n   249\t  rule #consDecoded(decErr(S), _, _) => decManyErr(S)\n   250\t  rule #consDecoded(decOk(_), _, decManyErr(S)) => decManyErr(S)\n   251\t  rule #consDecoded(decOk(V), N, decManyOk(L)) => decManyOk(ListItem(binding(N, V)) L)\n   252\t  syntax Binding ::= binding(String, Value)\n   253\t\n   254\t  // --- Bytes32 helpers ------------------------------------------------------------------\n   255\t  // Canonical little-endian 32-byte form of a field element (into_bytes32).\n   256\t  syntax Bytes ::= intToBytes32(Int) [function, total]\n   257\t  rule intToBytes32(X) => Int2Bytes(32, X, LE) requires X >=Int 0\n   258\t  rule intToBytes32(_) => padRightBytes(.Bytes, 32, 0) [owise]\n   259\t  syntax Int ::= bytes32ToInt(Bytes) [function, total]\n   260\t  rule bytes32ToInt(B) => Bytes2Int(B, LE, Unsigned)\n   261\tendmodule\n","exit_code":0,"status":"completed"}}
