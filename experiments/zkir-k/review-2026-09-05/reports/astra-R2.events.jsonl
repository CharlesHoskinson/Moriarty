es']), u32(ins['index'], 'index'), identifier(ins['output'])])\n   263\t        case 'reverse' if EXT:\n   264\t            _need(ins, 'bytes', 'output')\n   265\t            return KApply('reverse', [operand(ins['bytes']), identifier(ins['output'])])\n   266\t        case 'load_constant' if EXT:\n   267\t            _need(ins, 'type', 'encoding', 'output')\n   268\t            if not isinstance(ins['encoding'], list):\n   269\t                raise ZkirFormatError('load_constant encoding must be a list of hex immediates')\n   270\t            enc = klist('operands', '.operands', [KApply('imm', [intToken(immediate(e))]) for e in ins['encoding']])\n   271\t            return KApply('load_constant', [ir_type(ins['type']), enc, identifier(ins['output'])])\n   272\t        case 'sha512' if EXT:\n   273\t            _need(ins, 'alignment', 'inputs', 'output')\n   274\t            return KApply('sha512', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   275\t        case 'bytes32_into_low_high':\n   276\t            _need(ins, 'bytes', 'outputs')\n   277\t            lo, hi = pair(ins['outputs'], 'bytes32_into_low_high outputs')\n   278\t            return KApply('bytes32_into_low_high', [operand(ins['bytes']), identifier(lo), identifier(hi)])\n   279\t        case 'bytes32_from_low_high':\n   280\t            _need(ins, 'inputs', 'output')\n   281\t            lo, hi = pair(ins['inputs'], 'bytes32_from_low_high inputs')\n   282\t            return KApply('bytes32_from_low_high', [operand(lo), operand(hi), identifier(ins['output'])])\n   283\t        case 'div_mod_power_of_two':\n   284\t            _need(ins, 'val', 'bits', 'outputs')\n   285\t            return KApply('div_mod_power_of_two', [operand(ins['val']), u32(ins['bits'], 'bits'), identifiers(ins['outputs'])])\n   286\t        case 'reconstitute_field':\n   287\t            _need(ins, 'divisor', 'modulus', 'bits', 'output')\n   288\t            return KApply('reconstitute_field', [operand(ins['divisor']), operand(ins['modulus']), u32(ins['bits'], 'bits'), identifier(ins['output'])])\n   289\t        case 'transient_hash':\n   290\t            _need(ins, 'inputs', 'output')\n   291\t            return KApply('transient_hash', [operands(ins['inputs']), identifier(ins['output'])])\n   292\t        case 'persistent_hash':\n   293\t            _need(ins, 'alignment', 'inputs', 'output')\n   294\t            return KApply('persistent_hash', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   295\t        case 'keccak256':\n   296\t            _need(ins, 'alignment', 'inputs', 'output')\n   297\t            return KApply('keccak256', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   298\t        case 'test_eq':\n   299\t            _need(ins, 'a', 'b', 'output')\n   300\t            return KApply('test_eq', [operand(ins['a']), operand(ins['b']), identifier(ins['output'])])\n   301\t        case 'add' | 'mul':\n   302\t            _need(ins, 'a', 'b', 'output')\n   303\t            return KApply(op, [operand(ins['a']), operand(ins['b']), identifier(ins['output'])])\n   304\t        case 'neg' | 'inv' | 'not':\n   305\t            _need(ins, 'a', 'output')\n   306\t            return KApply(op, [operand(ins['a']), identifier(ins['output'])])\n   307\t        case 'less_than':\n   308\t            _need(ins, 'a', 'b', 'bits', 'output')\n   309\t            return KApply('less_than', [operand(ins['a']), operand(ins['b']), u32(ins['bits'], 'bits'), identifier(ins['output'])])\n   310\t        case 'jubjub_scalar_from_native':\n   311\t            _need(ins, 'native', 'output')\n   312\t            return KApply('jubjub_scalar_from_native', [operand(ins['native']), identifier(ins['output'])])\n   313\t        case 'public_input' | 'private_input':\n   314\t            _need(ins, 'guard', 'type', 'output')\n   315\t            return KApply(op, [guard(ins['guard']), ir_type(ins['type']), identifier(ins['output'])])\n   316\t        case 'output':\n   317\t            _need(ins, 'vals')\n   318\t            return KApply('output', [operands(ins['vals'])])\n   319\t        case _:\n   320\t            raise ZkirFormatError(f'unknown instruction op {op!r}')\n   321\t\n   322\t\n   323\t# --- program -------------------------------------------------------------------\n   324\t\n   325\tdef program(doc: Any) -> KInner:\n   326\t    \"\"\"`IrSource::load`: version {major: 3, minor: 0..=0}, then serde fields.\"\"\"\n   327\t    if not isinstance(doc, dict):\n   328\t        raise ZkirFormatError('expected a JSON object')\n   329\t    version = doc.get('version')\n   330\t    if not isinstance(version, dict) or 'major' not in version or 'minor' not in version:\n   331\t        raise ZkirFormatError('expected a version entry')\n   332\t    if version['major'] != 3 or not (0 <= version['minor'] <= 0):\n   333\t        raise ZkirFormatError(f\"unhandled version: {version['major']}.{version['minor']}\")\n   334\t    for key in ('inputs', 'outputs', 'do_communications_commitment', 'instructions'):\n   335\t        if key not in doc:\n   336\t            raise ZkirFormatError(f'missing field {key!r}')\n   337\t    inputs = []\n   338\t    for entry in doc['inputs']:\n   339\t        if not isinstance(entry, dict) or set(entry) != {'name', 'type'}:\n   340\t            raise ZkirFormatError(f'input must have name and type, got {entry!r}')\n   341\t        inputs.append(KApply('typedId', [identifier(entry['name']), ir_type(entry['type'])]))\n   342\t    outputs = [ir_type(t) for t in doc['outputs']]\n   343\t    if not isinstance(doc['do_communications_commitment'], bool):\n   344\t        raise ZkirFormatError('do_communications_commitment must be a boolean')\n   345\t    instrs = [instruction(i) for i in doc['instructions']]\n   346\t    return KApply('program', [\n   347\t        intToken(version['minor']),\n   348\t        klist('typedIds', '.typedIds'