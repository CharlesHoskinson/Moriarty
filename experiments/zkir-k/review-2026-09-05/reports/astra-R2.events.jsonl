{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/tools/diff_test.py; nl -ba experiments/zkir-k/tools/zkir_run.py'","aggregated_output":"     1\t\"\"\"Oracle 1: differential test of the K semantics against the Rust crate.\n     2\t\n     3\tFor every version-3 program in the corpus:\n     4\t  1. draw raw inputs of the declared types (seeded per program);\n     5\t  2. run the K semantics in generation mode until the transcript needs are\n     6\t     stable (public/private transcript values of the requested types are\n     7\t     appended, impact values become public_transcript_inputs, and the\n     8\t     communications commitment is taken from the run);\n     9\t  3. run the real K semantics and the Rust `preprocess` (zkir-oracle) on the\n    10\t     same preimage and compare status, memory (variant and encoding of every\n    11\t     register), public inputs and skips;\n    12\t  4. repeat step 3 with one perturbed preimage (first raw input replaced), so\n    13\t     that error paths are compared too.\n    14\t\n    15\tUsage: uv run --group zkir-k python experiments/zkir-k/tools/diff_test.py [--only SUBSTR] [--seed N]\n    16\tExit 0 iff every comparison agrees.\n    17\t\"\"\"\n    18\tfrom __future__ import annotations\n    19\t\n    20\timport argparse\n    21\timport json\n    22\timport random\n    23\timport subprocess\n    24\timport sys\n    25\timport tempfile\n    26\timport time\n    27\tfrom pathlib import Path\n    28\t\n    29\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    30\timport zkir_kast  # noqa: E402\n    31\timport zkir_values as zv  # noqa: E402\n    32\tfrom zkir_run import Runner  # noqa: E402\n    33\t\n    34\tHERE = Path(__file__).resolve().parent\n    35\tROOT = HERE.parent\n    36\tREPO = ROOT.parent.parent\n    37\tORACLE = Path.home() / 'Moriarty/repos/_build/ledger-92e8bdd3/target/release/zkir-oracle'\n    38\tORACLE_EXT = Path.home() / 'Moriarty/repos/_build/midnight-zkir-2ffe2d1/target/release/zkir-oracle'\n    39\t\n    40\tCORPORA = {\n    41\t    'ledger9-92e8bdd3-tests': ROOT / 'corpus' / 'ledger9-92e8bdd3-tests',\n    42\t    'midnight-zkir-2ffe2d1-precompiles': ROOT / 'corpus' / 'midnight-zkir-2ffe2d1-precompiles',\n    43\t    'moriarty-compact-escrow': REPO / 'experiments' / 'moriarty-compact-escrow' / 'output' / 'zkir',\n    44\t    'moriarty-core-swap': REPO / 'experiments' / 'moriarty-core-swap' / 'output' / 'zkir',\n    45\t    'handmade': ROOT / 'corpus' / 'handmade',\n    46\t}\n    47\t\n    48\t\n    49\tORACLE_BIN = ORACLE\n    50\t\n    51\t\n    52\tdef oracle(program: Path, preimage: dict) -> dict:\n    53\t    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:\n    54\t        json.dump(preimage, f)\n    55\t    res = subprocess.run([str(ORACLE_BIN), str(program), f.name], capture_output=True, text=True)\n    56\t    if res.returncode != 0:\n    57\t        return {'status': 'oracle-failed', 'error': res.stderr[-500:]}\n    58\t    return json.loads(res.stdout)\n    59\t\n    60\t\n    61\tdef strs(xs):\n    62\t    return [str(x) for x in xs]\n    63\t\n    64\t\n    65\tdef build_preimage(runner: Runner, program, doc: dict, rng: random.Random, small: bool, seed_pre: dict | None = None) -> tuple[dict, int]:\n    66\t    gen = zv.small_encoded if small else zv.random_encoded\n    67\t    inputs = [x for entry in doc['inputs'] for x in gen(entry['type'], rng)]\n    68\t    rand = rng.randrange(zv.R)\n    69\t    pre = {'inputs': strs(inputs), 'binding_input': str(rng.randrange(zv.R)),\n    70\t           'private_transcript': [], 'public_transcript_inputs': [], 'public_transcript_outputs': []}\n    71\t    if seed_pre:\n    72\t        # the crate's own test values, when they are literals (manifest test_preimage)\n    73\t        for key in ('inputs', 'private_transcript', 'public_transcript_outputs', 'binding_input'):\n    74\t            if key in seed_pre:\n    75\t                pre[key] = seed_pre[key]\n    76\t    if doc['do_communications_commitment']:\n    77\t        pre['communications_commitment'] = ['0', str(rand)]\n    78\t    passes = 0\n    79\t    for _ in range(8):\n    80\t        passes += 1\n    81\t        res = runner.run(program, pre, gen=True)\n    82\t        if res['status'] == 'krun-failed':\n    83\t            raise RuntimeError(res['error'])\n    84\t        needs = res['needs']\n    85\t        new_out = [t for kind, t in needs if kind == 'pubOut']\n    86\t        new_priv = [t for kind, t in needs if kind == 'priv']\n    87\t        pre['public_transcript_inputs'] = strs(x for kind, x in needs if kind == 'pubIn')\n    88\t        comm = [x for kind, x in needs if kind == 'comm']\n    89\t        if comm:\n    90\t            pre['communications_commitment'] = [str(comm[0]), str(rand)]\n    91\t        if not new_out and not new_priv:\n    92\t            break\n    93\t        pre['public_transcript_outputs'] += strs(x for t in new_out for x in gen(t, rng))\n    94\t        pre['private_transcript'] += strs(x for t in new_priv for x in gen(t, rng))\n    95\t    return pre, passes\n    96\t\n    97\t\n    98\tdef compare(k: dict, r: dict) -> list[str]:\n    99\t    diffs = []\n   100\t    if k['status'] != r['status']:\n   101\t        return [f\"status K={k['status']} ({k.get('error', '')[:80]}) Rust={r['status']} ({r.get('error', '')[:80]})\"]\n   102\t    if k['status'] != 'ok':\n   103\t        return diffs\n   104\t    if k['pis'] != r['pis']:\n   105\t        diffs.append(f\"pis differ: K={k['pis'][:6]} Rust={r['pis'][:6]}\")\n   106\t    if k['pi_skips'] != r['pi_skips']:\n   107\t        diffs.append(f\"pi_skips differ: K={k['pi_skips']} Rust={r['pi_skips']}\")\n   108\t    km, rm = k['memory'], r['memory']\n   109\t    for name in sorted(set(km) | set(rm)):\n   110\t        if name not in km:\n   111\t            diffs.append(f'{name}: missing in K')\n   112\t        elif name not in rm:\n   113\t            diffs.append(f'{name}: missing in Rust')\n   114\t        elif km[name] != rm[name]:\n   115\t            diffs.append(f\"{name}: K={km[name]} Rust={rm[name]}\")\n   116\t    return diffs\n   117\t\n   118\t\n   119\tdef main() -> int:\n   120\t    ap = argparse.ArgumentParser()\n   121\t    ap.add_argument('--only', default='')\n   122\t    ap.add_argument('--seed', type=int, default=2026)\n   123\t    ap.add_argument('--no-perturb', action='store_true')\n   124\t    ap.add_argument('--attempts', type=int, default=8)\n   125\t    ap.add_argument('--ext', action='store_true', help='ZKIR-EXT definition, midnight-zkir 2ffe2d1 oracle and corpus')\n   126\t    args = ap.parse_args()\n   127\t    global ORACLE_BIN, CORPORA\n   128\t    if args.ext:\n   129\t        ORACLE_BIN = ORACLE_EXT\n   130\t        CORPORA = {\n   131\t            'midnight-zkir-2ffe2d1-tests': ROOT / 'corpus' / 'midnight-zkir-2ffe2d1-tests',\n   132\t            'midnight-zkir-2ffe2d1-precompiles': ROOT / 'corpus' / 'midnight-zkir-2ffe2d1-precompiles',\n   133\t            'handmade': ROOT / 'corpus' / 'handmade',\n   134\t        }\n   135\t    runner = Runner(ext=args.ext)\n   136\t    rows = []\n   137\t    failures = 0\n   138\t    t0 = time.time()\n   139\t    for corpus, directory in CORPORA.items():\n   140\t        for path in sorted(directory.glob('*.zkir')):\n   141\t            if args.only and args.only not in path.name:\n   142\t                continue\n   143\t            doc = json.loads(path.read_text())\n   144\t            if doc.get('version', {}).get('major') != 3:\n   145\t                continue\n   146\t            try:\n   147\t                program = zkir_kast.load_program(path, ext=args.ext)\n   148\t            except zkir_kast.ZkirFormatError:\n   149\t                continue   # rejected before preprocess by both sides\n   150\t            rng = random.Random(f'{args.seed}:{path.name}')\n   151\t            manifest = directory / 'manifest.json'\n   152\t            seed_pre = None\n   153\t            if manifest.exists():\n   154\t                for entry in json.loads(manifest.read_text()).get('programs', []):\n   155\t                    if entry['file'] == path.name:\n   156\t                        seed_pre = entry.get('test_preimage')\n   157\t            # Up to MAX_ATTEMPTS preimages with small native inputs; stop after the\n   158\t            # first one both sides accept. Every attempt is compared.\n   159\t            t1 = time.time()\n   160\t            for attempt in range(args.attempts):\n   161\t                try:\n   162\t                    pre, passes = build_preimage(runner, program, doc, rng, small=True, seed_pre=seed_pre if attempt == 0 else None)\n   163\t                except RuntimeError as e:\n   164\t                    rows.append((corpus, path.name, f'gen{attempt}', 'krun failed', [str(e)[-300:]]))\n   165\t                    failures += 1\n   166\t                    break\n   167\t                k = runner.run(program, pre)\n   168\t                r = oracle(path, pre)\n   169\t                diffs = compare(k, r)\n   170\t                failures += bool(diffs)\n   171\t                note = ''\n   172\t                if k['status'] == 'error':\n   173\t                    same = k.get('error', '')[:20] == r.get('error', '')[:20]\n   174\t                    note = f\" msg K='{k.get('error', '')[:70]}'\" + ('' if same else f\" Rust='{r.get('error', '')[:70]}'\")\n   175\t                viol = k.get('violations', [])\n   176\t                vnote = f\" verdicts={k.get('verdicts', 0)}\" + (f\" NON-HOLDING={len(viol)}: \" + '; '.join(f'{o}[{m}] {g[:50]}' for o, m, g in viol[:3]) if viol else '')\n   177\t                rows.append((corpus, path.name, f'run{attempt}', f\"K={k['status']} Rust={r['status']} regs={len(k.get('memory', {}))} pis={len(k.get('pis', []))} passes={passes} {time.time() - t1:.1f}s{note}{vnote}\", diffs))\n   178\t                if k['status'] == 'ok' and r['status'] == 'ok':\n   179\t                    if not args.no_perturb and pre['inputs']:\n   180\t                        pert = json.loads(json.dumps(pre))\n   181\t                        pert['inputs'][0] = str(rng.randrange(zv.R))\n   182\t                        k2 = runner.run(program, pert)\n   183\t                        r2 = oracle(path, pert)\n   184\t                        d2 = compare(k2, r2)\n   185\t                        failures += bool(d2)\n   186\t                        rows.append((corpus, path.name, 'perturbed', f\"K={k2['status']} Rust={r2['status']} regs={len(k2.get('memory', {}))}\", d2))\n   187\t                    break\n   188\t    for corpus, name, label, summary, diffs in rows:\n   189\t        print(f\"{'PASS' if not diffs else 'FAIL'}  {corpus:34} {name:52} {label:9} {summary}\")\n   190\t        for d in diffs[:8]:\n   191\t            print(f'        {d}')\n   192\t    oks = sum(1 for r in rows if r[3].startswith('K=ok Rust=ok'))\n   193\t    print(f'\\n{len(rows)} comparisons ({oks} successful runs), {len(rows) - failures} agree, {failures} disagree, {time.time() - t0:.0f}s')\n   194\t    return 1 if failures else 0\n   195\t\n   196\t\n   197\tif __name__ == '__main__':\n   198\t    sys.exit(main())\n     1\t\"\"\"Run a ZKIR v3 program through the K semantics (ZKIR-VM) and read the result.\n     2\t\n     3\t`run_job(program_path, preimage)` builds job(Program, Preimage), runs krun on\n     4\tthe ZKIR definition, and returns a dict shaped like the Rust oracle's output:\n     5\t  {status: 'ok'|'error', error?: str, memory: {id: {variant, encoded}},\n     6\t   pis: [str], pi_skips: [None|int], cursors: (pubIn, pubOut, priv),\n     7\t   constraints: int}\n     8\tMemory values are re-encoded on the Python side with the same encoding as\n     9\t`encode_offcircuit` (the encodings are unit-tested against K in unit_values.py).\n    10\t\n    11\tUsage: zkir_run.py FILE.zkir PREIMAGE.json [--definition DIR]\n    12\t\"\"\"\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport sys\n    18\tfrom pathlib import Path\n    19\tfrom typing import Any\n    20\t\n    21\tfrom pyk.kast.inner import KApply, KInner, KSort, KToken, top_down\n    22\tfrom pyk.kast.prelude.kint import intToken\n    23\tfrom pyk.kore.parser import KoreParser\n    24\tfrom pyk.ktool.krun import KRun\n    25\t\n    26\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    27\timport zkir_kast  # noqa: E402\n    28\t\n    29\tR = 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    30\tRJ = 6554484396890773809930967563523245729705921265872317281365359162392183254199\n    31\tK256P = 2**256 - 2**32 - 977\n    32\tK256N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\n    33\tP256P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF\n    34\tP256N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551\n    35\tC25519P = 2**255 - 19\n    36\tC25519L = 2**252 + 27742317777372353535851937790883648493\n    37\t\n    38\t\n    39\tdef default_definition() -> Path:\n    40\t    return Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-kompiled'\n    41\t\n    42\t\n    43\tdef default_ext_definition() -> Path:\n    44\t    return Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-ext-kompiled'\n    45\t\n    46\t\n    47\t# --- preimage term ---------------------------------------------------------------------\n    48\t\n    49\tdef klist(items: list[KInner]) -> KInner:\n    50\t    t: KInner = KApply('.List')\n    51\t    for it in reversed(items):\n    52\t        t = KApply('_List_', [KApply('ListItem', [it]), t])\n    53\t    return t\n    54\t\n    55\t\n    56\tdef ints(values) -> KInner:\n    57\t    return klist([intToken(int(v)) for v in values])\n    58\t\n    59\t\n    60\tdef preimage_term(p: dict[str, Any]) -> KInner:\n    61\t    cc = p.get('communications_commitment')\n    62\t    comm = KApply('noComm') if cc is None else KApply('comm', [intToken(int(cc[0])), intToken(int(cc[1]))])\n    63\t    return KApply('preimage', [\n    64\t        ints(p.get('inputs', [])),\n    65\t        intToken(int(p.get('binding_input', 0))),\n    66\t        comm,\n    67\t        ints(p.get('private_transcript', [])),\n    68\t        ints(p.get('public_transcript_inputs', [])),\n    69\t        ints(p.get('public_transcript_outputs', [])),\n    70\t    ])\n    71\t\n    72\t\n    73\t# --- result extraction --------------------------------------------------------------------\n    74\t\n    75\tdef find_cell(term: KInner, name: str) -> KInner:\n    76\t    found: list[KInner] = []\n    77\t\n    78\t    def visit(t: KInner) -> KInner:\n    79\t        if isinstance(t, KApply) and t.label.name == name:\n    80\t            found.append(t.args[0])\n    81\t        return t\n    82\t\n    83\t    top_down(visit, term)\n    84\t    if not found:\n    85\t        raise KeyError(name)\n    86\t    return found[0]\n    87\t\n    88\t\n    89\tdef list_items(term: KInner) -> list[KInner]:\n    90\t    items: list[KInner] = []\n    91\t\n    92\t    def walk(t: KInner) -> None:\n    93\t        if isinstance(t, KApply):\n    94\t            if t.label.name == '_List_':\n    95\t                for a in t.args:\n    96\t                    walk(a)\n    97\t            elif t.label.name == 'ListItem':\n    98\t                items.append(t.args[0])\n    99\t            elif t.label.name == '.List':\n   100\t                pass\n   101\t            else:\n   102\t                raise ValueError(f'not a list: {t.label.name}')\n   103\t    walk(term)\n   104\t    return items\n   105\t\n   106\t\n   107\tdef map_items(term: KInner) -> list[tuple[KInner, KInner]]:\n   108\t    items: list[tuple[KInner, KInner]] = []\n   109\t\n   110\t    def walk(t: KInner) -> None:\n   111\t        if isinstance(t, KApply):\n   112\t            if t.label.name == '_Map_':\n   113\t                for a in t.args:\n   114\t                    walk(a)\n   115\t            elif t.label.name == '_|->_':\n   116\t                items.append((t.args[0], t.args[1]))\n   117\t            elif t.label.name == '.Map':\n   118\t                pass\n   119\t            else:\n   120\t                raise ValueError(f'not a map: {t.label.name}')\n   121\t    walk(term)\n   122\t    return items\n   123\t\n   124\t\n   125\tdef tok_int(t: KInner) -> int:\n   126\t    assert isinstance(t, KToken), t\n   127\t    return int(t.token)\n   128\t\n   129\t\n   130\tdef tok_str(t: KInner) -> str:\n   131\t    assert isinstance(t, KToken) and t.sort.name == 'String', t\n   132\t    return json.loads(t.token)\n   133\t\n   134\t\n   135\t_ESC = {'t': 9, 'n': 10, 'r': 13, 'f': 12, '\"': 34, '\\\\': 92}\n   136\t\n   137\t\n   138\tdef tok_bytes(t: KInner) -> bytes:\n   139\t    assert isinstance(t, KToken) and t.sort.name == 'Bytes', t\n   140\t    s = t.token\n   141\t    assert s.startswith('b\"') and s.endswith('\"'), s\n   142\t    body = s[2:-1]\n   143\t    out = bytearray()\n   144\t    i = 0\n   145\t    while i < len(body):\n   146\t        ch = body[i]\n   147\t        if ch == '\\\\':\n   148\t            nxt = body[i + 1]\n   149\t            if nxt == 'x':\n   150\t                out.append(int(body[i + 2:i + 4], 16))\n   151\t                i += 4\n   152\t            elif nxt == 'u':\n   153\t                out.append(int(body[i + 2:i + 6], 16))\n   154\t                i += 6\n   155\t            else:\n   156\t                out.append(_ESC[nxt])\n   157\t                i += 2\n   158\t        else:\n   159\t            out.append(ord(ch))\n   160\t            i += 1\n   161\t    return bytes(out)\n   162\t\n   163\t\n   164\tdef enc_foreign(x: int, mod: int, log2: int, nb: int) -> list[int]:\n   165\t    e = (x - 1) % mod\n   166\t    per = 254 // log2\n   167\t    out = []\n   168\t    left = nb\n   169\t    while left > 0:\n   170\t        take = min(left, per)\n   171\t        out.append(e & ((1 << (log2 * take)) - 1))\n   172\t        e >>= log2 * take\n   173\t        left -= take\n   174\t    return out\n   175\t\n   176\t\n   177\tdef point(t: KInner):\n   178\t    assert isinstance(t, KApply)\n   179\t    if t.label.name == 'inf':\n   180\t        return None\n   181\t    assert t.label.name == 'pt', t\n   182\t    return (tok_int(t.args[0]), tok_int(t.args[1]))\n   183\t\n   184\t\n   185\tdef enc_chunks(b: bytes) -> list[int]:\n   186\t    return [int.from_bytes(b[i:i + 31], 'little') for i in range(0, len(b), 31)]\n   187\t\n   188\t\n   189\tdef encode_value(t: KInner, ext: bool = False) -> tuple[str, list[int]]:\n   190\t    assert isinstance(t, KApply), t\n   191\t    lbl = t.label.name\n   192\t    a = t.args\n   193\t    match lbl:\n   194\t        case 'nativeV':\n   195\t            return 'Native', [tok_int(a[0])]\n   196\t        case 'bytes32V':\n   197\t            b = tok_bytes(a[0])\n   198\t            return ('Bytes' if ext else 'Bytes32'), [int.from_bytes(b[:31], 'little'), b[31]]\n   199\t        case 'boolV':\n   200\t            return 'Bool', [1 if (a[0].token if isinstance(a[0], KToken) else a[0].label.name) == 'true' else 0]\n   201\t        case 'byteV':\n   202\t            return 'Byte', [tok_int(a[0])]\n   203\t        case 'bytesV':\n   204\t            return 'Bytes', enc_chunks(tok_bytes(a[0]))\n   205\t        case 'jubjubPointV':\n   206\t            p = point(a[0]) or (0, 1)\n   207\t            return 'JubjubPoint', [p[0], p[1]]\n   208\t        case 'jubjubScalarV':\n   209\t            return 'JubjubScalar', [tok_int(a[0])]\n   210\t        case 'secp256k1PointV' | 'secp256r1PointV':\n   211\t            mod = K256P if lbl.startswith('secp256k1') else P256P\n   212\t            p = point(a[0])\n   213\t            if p is None:\n   214\t                return lbl[:-1].capitalize().replace('point', 'Point'), enc_foreign(0, mod, 64, 4) * 2 + [1]\n   215\t            return ('Secp256k1Point' if mod == K256P else 'Secp256r1Point'), enc_foreign(p[0], mod, 64, 4) + enc_foreign(p[1], mod, 64, 4) + [0]\n   216\t        case 'secp256k1BaseV':\n   217\t            return 'Secp256k1Base', enc_foreign(tok_int(a[0]), K256P, 64, 4)\n   218\t        case 'secp256k1ScalarV':\n   219\t            return 'Secp256k1Scalar', enc_foreign(tok_int(a[0]), K256N, 64, 4)\n   220\t        case 'secp256r1BaseV':\n   221\t            return 'Secp256r1Base', enc_foreign(tok_int(a[0]), P256P, 64, 4)\n   222\t        case 'secp256r1ScalarV':\n   223\t            return 'Secp256r1Scalar', enc_foreign(tok_int(a[0]), P256N, 64, 4)\n   224\t        case 'curve25519PointV':\n   225\t            p = point(a[0]) or (0, 1)\n   226\t            return 'Curve25519Point', enc_foreign(p[0], C25519P, 64, 4) + enc_foreign(p[1], C25519P, 64, 4)\n   227\t        case 'curve25519BaseV':\n   228\t            return 'Curve25519Base', enc_foreign(tok_int(a[0]), C25519P, 64, 4)\n   229\t        case 'curve25519ScalarV':\n   230\t            return 'Curve25519Scalar', enc_foreign(tok_int(a[0]), C25519L, 51, 5)\n   231\t    raise ValueError(lbl)\n   232\t\n   233\t\n   234\tSYMBOL_TO_TYPE = {v: k for k, v in zkir_kast.TYPE_SYMBOLS.items()}\n   235\tSYMBOL_TO_TYPE.update({'Bool': 'Bool', 'Byte': 'Byte'})\n   236\t\n   237\t\n   238\tdef type_of_symbol(t: KInner) -> str:\n   239\t    assert isinstance(t, KApply)\n   240\t    if t.label.name == 'BytesN':\n   241\t        return f'Bytes<{tok_int(t.args[0])}>'\n   242\t    return SYMBOL_TO_TYPE[t.label.name]\n   243\t\n   244\t\n   245\tdef need(t: KInner) -> tuple[str, Any]:\n   246\t    assert isinstance(t, KApply)\n   247\t    match t.label.name:\n   248\t        case 'needPubOut':\n   249\t            return ('pubOut', type_of_symbol(t.args[0]))\n   250\t        case 'needPriv':\n   251\t            return ('priv', type_of_symbol(t.args[0]))\n   252\t        case 'needPubIn':\n   253\t            return ('pubIn', tok_int(t.args[0]))\n   254\t        case 'needComm':\n   255\t            return ('comm', tok_int(t.args[0]))\n   256\t    raise ValueError(t.label.name)\n   257\t\n   258\t\n   259\tdef skip(t: KInner):\n   260\t    assert isinstance(t, KApply)\n   261\t    if t.label.name == 'skipNone':\n   262\t        return None\n   263\t    return tok_int(t.args[0])\n   264\t\n   265\t\n   266\tclass Runner:\n   267\t    def __init__(self, definition: Path | None = None, ext: bool = False):\n   268\t        self.ext = ext\n   269\t        self.krun = KRun(definition or (default_ext_definition() if ext else default_definition()))\n   270\t\n   271\t    def run(self, program: KInner, preimage: dict[str, Any], depth: int | None = None, gen: bool = False) -> dict[str, Any]:\n   272\t        job = KApply('genJob' if gen else 'job', [program, preimage_term(preimage)])\n   273\t        kore = self.krun.kast_to_kore(job, KSort('Job'))\n   274\t        res = self.krun.run_process(kore, depth=depth)\n   275\t        if res.returncode != 0:\n   276\t            return {'status': 'krun-failed', 'error': res.stderr[-2000:]}\n   277\t        cfg = self.krun.kore_to_kast(KoreParser(res.stdout).pattern())\n   278\t        status = find_cell(cfg, '<status>')\n   279\t        assert isinstance(status, KApply)\n   280\t        out: dict[str, Any] = {}\n   281\t        if status.label.name == 'ok':\n   282\t            out['status'] = 'ok'\n   283\t        else:\n   284\t            out['status'] = 'error'\n   285\t            out['error'] = tok_str(status.args[0])\n   286\t        memory = {}\n   287\t        for k, v in map_items(find_cell(cfg, '<mem>')):\n   288\t            variant, enc = encode_value(v, self.ext)\n   289\t            memory[tok_str(k)] = {'variant': variant, 'encoded': [str(e) for e in enc]}\n   290\t        out['memory'] = memory\n   291\t        out['pis'] = [str(tok_int(x)) for x in list_items(find_cell(cfg, '<pi>'))]\n   292\t        out['pi_skips'] = [skip(x) for x in list_items(find_cell(cfg, '<skips>'))]\n   293\t        out['cursors'] = (tok_int(find_cell(cfg, '<pubInIdx>')), tok_int(find_cell(cfg, '<pubOutIdx>')), tok_int(find_cell(cfg, '<privIdx>')))\n   294\t        out['constraints'] = len(list_items(find_cell(cfg, '<constraints>')))\n   295\t        out['k_cell'] = self.krun.pretty_print(find_cell(cfg, '<k>')).strip()\n   296\t        out['needs'] = [need(x) for x in list_items(find_cell(cfg, '<needs>'))]\n   297\t        verdicts = list_items(find_cell(cfg, '<verdicts>'))\n   298\t        bad = []\n   299\t        for v in verdicts:\n   300\t            assert isinstance(v, KApply) and v.label.name == 'verdict'\n   301\t            outcome = v.args[1]\n   302\t            assert isinstance(outcome, KApply)\n   303\t            if outcome.label.name != 'holds':\n   304\t                gate = self.krun.pretty_print(v.args[0]).replace('\\n', ' ')\n   305\t                gate = ' '.join(gate.split())\n   306\t                bad.append((outcome.label.name, tok_str(outcome.args[0]) if outcome.args else '', gate[:120]))\n   307\t        out['verdicts'] = len(verdicts)\n   308\t        out['violations'] = bad\n   309\t        return out\n   310\t\n   311\t    def run_file(self, path: Path, preimage: dict[str, Any], gen: bool = False) -> dict[str, Any]:\n   312\t        return self.run(zkir_kast.load_program(path, ext=self.ext), preimage, gen=gen)\n   313\t\n   314\t\n   315\tdef main() -> int:\n   316\t    ap = argparse.ArgumentParser()\n   317\t    ap.add_argument('file', type=Path)\n   318\t    ap.add_argument('preimage', type=Path)\n   319\t    ap.add_argument('--definition', type=Path, default=None)\n   320\t    ap.add_argument('--ext', action='store_true')\n   321\t    args = ap.parse_args()\n   322\t    runner = Runner(args.definition, ext=args.ext)\n   323\t    with open(args.preimage) as f:\n   324\t        pre = json.load(f)\n   325\t    print(json.dumps(runner.run_file(args.file, pre), indent=1))\n   326\t    return 0\n   327\t\n   328\t\n   329\tif __name__ == '__main__':\n   330\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The K rules follow the successful transcript flow closely, but their batch processing appears to change partial state and error precedence on failures. I’m also checking whether the harness detects those differences and distinguishes a completed run from a stuck configuration.\n"}}
