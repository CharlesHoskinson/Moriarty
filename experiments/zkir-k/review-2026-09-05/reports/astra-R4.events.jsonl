  872\t    /// the type `val_t`. The `guard` DOES NOT participate in in-circuit constraints.\n   873\t    ///\n   874\t    /// NB: This instruction is essentially identical to `PrivateInput` except that\n   875\t    /// the `preprocessing` pass will consume the value from a different source\n   876\t    /// (the public transcript outputs in this case).\n   877\t    PublicInput {\n   878\t        /// An optional condition for retrieving the next public transcript\n   879\t        /// output\n   880\t        guard: Option<Operand>,\n   881\t        /// The type of this input\n   882\t        #[serde(rename = \"type\")]\n   883\t        val_t: IrType,\n   884\t        /// The output variable name\n   885\t        output: Identifier,\n   886\t    },\n   887\t\n   888\t    /// Off-circuit (preprocessing):\n   889\t    /// Retrieves an input from the private transcript outputs.\n   890\t    /// Outputs one element, the next private transcript output, or a default value\n   891\t    /// if the `guard` fails.\n   892\t    ///\n   893\t    /// In-circuit:\n   894\t    /// Allows the prover to witness a free value, only constrained to respect\n   895\t    /// the type `val_t`. The `guard` DOES NOT participate in in-circuit constraints.\n   896\t    ///\n   897\t    /// NB: This instruction is essentially identical to `PublicInput` except that\n   898\t    /// the `preprocessing` pass will consume the value from a different source\n   899\t    /// (the private transcript outputs in this case).\n   900\t    PrivateInput {\n   901\t        /// An optional condition for retrieving the next private transcript\n   902\t        /// output\n   903\t        guard: Option<Operand>,\n   904\t        /// The type of this input\n   905\t        #[serde(rename = \"type\")]\n   906\t        val_t: IrType,\n   907\t        /// The output variable name\n   908\t        output: Identifier,\n   909\t    },\n   910\t    /// Circuit terminator. Produces the circuit's return values, in\n   950\t            model: midnight_zk_stdlib::cost_model(self, None),\n   951\t        }\n   952\t    }\n   953\t\n   954\t    /// Attempts to parse an arbitrary input as IR.\n   955\t    pub fn load<R: Read>(reader: R) -> io::Result<Self> {\n   956\t        let value: serde_json::Value = serde_json::from_reader(reader)?;\n   957\t        match value {\n   958\t            serde_json::Value::Object(mut obj) => {\n   959\t                let ver = serde_json::from_value(\n   960\t                    obj.get(\"version\")\n   961\t                        .ok_or(io::Error::new(\n   962\t                            io::ErrorKind::InvalidData,\n   963\t                            \"Expected a version entry\",\n   964\t                        ))?\n   965\t                        .clone(),\n   966\t                )?;\n   967\t                match ver {\n   968\t                    SerdeVersion {\n   969\t                        major: 3,\n   970\t                        minor: 0..=0,\n   971\t                    } => {\n   972\t                        obj.insert(\n   973\t                            \"version\".into(),\n   974\t                            serde_json::Value::Number(ver.minor.into()),\n   975\t                        );\n   976\t                        Ok(serde_json::from_value(serde_json::Value::Object(obj))?)\n   977\t                    }\n   978\t                    SerdeVersion { major, minor } => Err(io::Error::new(\n   979\t                        io::ErrorKind::InvalidData,\n   980\t                        format!(\"Unhandled version: {major}.{minor}\"),\n   981\t                    )),\n   982\t                }\n   983\t            }\n   984\t            _ => Err(io::Error::new(\n   985\t                io::ErrorKind::InvalidData,\n   986\t                \"Expected a JSON object\",\n   987\t            )),\n   988\t        }\n   989\t    }\n   990\t\nnl: /home/charl/Moriarty/repos/_build/midnight-zkir-2ffe2d1/zkir/src/ir_instructions/cond_select.rs: No su