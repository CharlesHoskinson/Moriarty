{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-syntax.k'","aggregated_output":"     1\t// ZKIR v3 abstract syntax and static well-formedness.\n     2\t//\n     3\t// Surface: the 34 instructions and 13 types of `zkir-v3/src/ir.rs` and\n     4\t// `zkir-v3/src/ir_types.rs` in midnightntwrk/midnight-ledger at commit\n     5\t// 92e8bdd3 (the surface mechanized by input-output-hk/arc-zkir). Every\n     6\t// production carries a `symbol(_)` whose name is the JSON `op` of the\n     7\t// instruction (or the JSON key of the type), so that the pyk preprocessor in\n     8\t// tools/zkir_kast.py can build terms without a concrete K grammar.\n     9\t//\n    10\t// Programs do not enter K through a concrete syntax: tools/zkir_kast.py reads\n    11\t// the JSON artifact and produces the `Program` term (plan decision CLM-0712).\n    12\t\n    13\tmodule ZKIR-SYNTAX\n    14\t  imports INT\n    15\t  imports STRING\n    16\t  imports BOOL\n    17\t\n    18\t  // --- Program -------------------------------------------------------------\n    19\t  // program(minorVersion, inputs, outputTypes, doCommunicationsCommitment, instructions)\n    20\t  syntax Program ::= program(Int, TypedIds, IrTypes, Bool, Instrs) [symbol(program)]\n    21\t\n    22\t  // Identifiers are the JSON strings verbatim (`Identifier(pub String)`).\n    23\t  syntax TypedId  ::= typedId(String, IrType)                           [symbol(typedId)]\n    24\t  syntax TypedIds ::= List{TypedId, \",\"}   [symbol(typedIds), terminator-symbol(.typedIds)]\n    25\t  syntax IrTypes  ::= List{IrType, \",\"}    [symbol(irTypes),  terminator-symbol(.irTypes)]\n    26\t  syntax Ids      ::= List{String, \",\"}    [symbol(ids),      terminator-symbol(.ids)]\n    27\t  syntax Instrs   ::= List{Instr, \";\"}     [symbol(instrs),   terminator-symbol(.instrs)]\n    28\t  syntax Operands ::= List{Operand, \",\"}   [symbol(operands), terminator-symbol(.operands)]\n    29\t\n    30\t  // --- Types (ir_types.rs, serde names in comments) -----------------------\n    31\t  syntax IrType ::= native()          [symbol(Native)]          // \"Scalar<BLS12-381>\"\n    32\t                  | bytes32()         [symbol(Bytes32)]         // \"Bytes<32>\"\n    33\t                  | jubjubPoint()     [symbol(JubjubPoint)]     // \"Point<Jubjub>\"\n    34\t                  | jubjubScalar()    [symbol(JubjubScalar)]    // \"Scalar<Jubjub>\"\n    35\t                  | secp256k1Point()  [symbol(Secp256k1Point)]  // \"Point<Secp256k1>\"\n    36\t                  | secp256k1Base()   [symbol(Secp256k1Base)]   // \"Base<Secp256k1>\"\n    37\t                  | secp256k1Scalar() [symbol(Secp256k1Scalar)] // \"Scalar<Secp256k1>\"\n    38\t                  | secp256r1Point()  [symbol(Secp256r1Point)]  // \"Point<Secp256r1>\"\n    39\t                  | secp256r1Base()   [symbol(Secp256r1Base)]   // \"Base<Secp256r1>\"\n    40\t                  | secp256r1Scalar() [symbol(Secp256r1Scalar)] // \"Scalar<Secp256r1>\"\n    41\t                  | curve25519Point() [symbol(Curve25519Point)] // \"Point<Curve25519>\"\n    42\t                  | curve25519Base()  [symbol(Curve25519Base)]  // \"Base<Curve25519>\"\n    43\t                  | curve25519Scalar()[symbol(Curve25519Scalar)]// \"Scalar<Curve25519>\"\n    44\t\n    45\t  // Number of raw field elements that encode a value of each type\n    46\t  // (`IrType::encoded_len`).\n    47\t  syntax Int ::= encodedLen(IrType) [function, total]\n    48\t  rule encodedLen(native())          => 1\n    49\t  rule encodedLen(bytes32())         => 2\n    50\t  rule encodedLen(jubjubPoint())     => 2\n    51\t  rule encodedLen(jubjubScalar())    => 1\n    52\t  rule encodedLen(secp256k1Point())  => 5\n    53\t  rule encodedLen(secp256k1Base())   => 2\n    54\t  rule encodedLen(secp256k1Scalar()) => 2\n    55\t  rule encodedLen(secp256r1Point())  => 5\n    56\t  rule encodedLen(secp256r1Base())   => 2\n    57\t  rule encodedLen(secp256r1Scalar()) => 2\n    58\t  rule encodedLen(curve25519Point()) => 4\n    59\t  rule encodedLen(curve25519Base())  => 2\n    60\t  rule encodedLen(curve25519Scalar())=> 2\n    61\t\n    62\t  // --- Operands -------------------------------------------------------------\n    63\t  // `Operand::Variable(Identifier)` | `Operand::Immediate(Fr)`; the immediate is\n    64\t  // already reduced into [0, r) by the preprocessor.\n    65\t  syntax Operand ::= var(String) [symbol(var)]\n    66\t                   | imm(Int)    [symbol(imm)]\n    67\t\n    68\t  // Optional guard of public_input / private_input (`Option<Operand>`).\n    69\t  syntax Guard ::= noGuard()       [symbol(noGuard)]\n    70\t                 | guard(Operand)  [symbol(guard)]\n    71\t\n    72\t  // --- Alignments (base_crypto::fab::Alignment) -----------------------------\n    73\t  // JSON: [{\"tag\":\"atom\",\"value\":{\"tag\":\"bytes\",\"length\":32}}, ...]\n    74\t  syntax Alignment  ::= alignment(Segments)   [symbol(alignment)]\n    75\t  syntax Segments   ::= List{Segment, \",\"}    [symbol(segments),   terminator-symbol(.segments)]\n    76\t  syntax Segment    ::= atom(Atom)            [symbol(atom)]\n    77\t                      | option(Alignments)    [symbol(option)]\n    78\t  syntax Alignments ::= List{Alignment, \"|\"}  [symbol(alignments), terminator-symbol(.alignments)]\n    79\t  syntax Atom       ::= fieldAtom()           [symbol(fieldAtom)]\n    80\t                      | bytesAtom(Int)        [symbol(bytesAtom)]\n    81\t                      | compressAtom()        [symbol(compressAtom)]\n    82\t\n    83\t  // --- Instructions (ir.rs `enum Instruction`, JSON `op` in the symbol) -----\n    84\t  // Argument order follows the Rust field order; identifiers written by the\n    85\t  // instruction come last.\n    86\t  syntax Instr ::= encode(Operand, Ids)                            [symbol(encode)]\n    87\t                 | assert(Operand)                                 [symbol(assert)]\n    88\t                 | condSelect(Operand, Operand, Operand, String)   [symbol(cond_select)]   // bit, a, b, output\n    89\t                 | constrainBits(Operand, Int)                     [symbol(constrain_bits)]\n    90\t                 | constrainEq(Operand, Operand)                   [symbol(constrain_eq)]\n    91\t                 | constrainToBoolean(Operand)                     [symbol(constrain_to_boolean)]\n    92\t                 | copy(Operand, String)                           [symbol(copy)]\n    93\t                 | impact(Operand, Operands)                       [symbol(impact)]        // guard, inputs\n    94\t                 | ecMul(Operand, Operand, String)                 [symbol(ec_mul)]        // a, scalar, output\n    95\t                 | ecMulGenerator(Operand, String)                 [symbol(ec_mul_generator)]\n    96\t                 | hashToCurve(Operands, String)                   [symbol(hash_to_curve)]\n    97\t                 | intoCoordinates(Operand, String, String)        [symbol(into_coordinates)] // point, x, y\n    98\t                 | fromCoordinates(Operand, Operand, String)       [symbol(from_coordinates)] // x, y, output\n    99\t                 | intoBytes32(Operand, String)                    [symbol(into_bytes32)]\n   100\t                 | fromBytes32(Operand, IrType, String)            [symbol(from_bytes32)]  // bytes, type, output\n   101\t                 | reverseBytes(Operand, String)                   [symbol(reverse_bytes)]\n   102\t                 | bytes32IntoLowHigh(Operand, String, String)     [symbol(bytes32_into_low_high)] // bytes, low, high\n   103\t                 | bytes32FromLowHigh(Operand, Operand, String)    [symbol(bytes32_from_low_high)] // low, high, output\n   104\t                 | divModPowerOfTwo(Operand, Int, Ids)             [symbol(div_mod_power_of_two)] // val, bits, [div, mod]\n   105\t                 | reconstituteField(Operand, Operand, Int, String)[symbol(reconstitute_field)]  // divisor, modulus, bits, output\n   106\t                 | transientHash(Operands, String)                 [symbol(transient_hash)]\n   107\t                 | persistentHash(Alignment, Operands, String)     [symbol(persistent_hash)]\n   108\t                 | keccak256(Alignment, Operands, String)          [symbol(keccak256)]\n   109\t                 | testEq(Operand, Operand, String)                [symbol(test_eq)]\n   110\t                 | add(Operand, Operand, String)                   [symbol(add)]\n   111\t                 | mul(Operand, Operand, String)                   [symbol(mul)]\n   112\t                 | neg(Operand, String)                            [symbol(neg)]\n   113\t                 | inv(Operand, String)                            [symbol(inv)]\n   114\t                 | not(Operand, String)                            [symbol(not)]\n   115\t                 | lessThan(Operand, Operand, Int, String)         [symbol(less_than)]     // a, b, bits, output\n   116\t                 | jubjubScalarFromNative(Operand, String)         [symbol(jubjub_scalar_from_native)]\n   117\t                 | publicInput(Guard, IrType, String)              [symbol(public_input)]\n   118\t                 | privateInput(Guard, IrType, String)             [symbol(private_input)]\n   119\t                 | output(Operands)                                [symbol(output)]\n   120\t\n   121\t  // --- Field constants --------------------------------------------------------\n   122\t  // BLS12-381 scalar field modulus r (the native field), FR_BITS = 255,\n   123\t  // FR_BYTES_STORED = 31 (transient-crypto/src/curve.rs).\n   124\t  syntax Int ::= \"#blsScalarModulus\" [function, total]\n   125\t  rule #blsScalarModulus => 52435875175126190479447740508185965837690552500527637822603658699938581184513\n   126\t  syntax Int ::= \"#frBits\" [function, total]\n   127\t  rule #frBits => 255\n   128\t  syntax Int ::= \"#frBytesStored\" [function, total]\n   129\t  rule #frBytesStored => 31\n   130\t\n   131\t  // --- Reads and writes of an instruction -----------------------------------\n   132\t  // reads(I): every operand the instruction resolves off-circuit, in the order\n   133\t  // `IrSource::preprocess` resolves them. writes(I): identifiers it defines.\n   134\t  syntax Operands ::= reads(Instr) [function, total]\n   135\t  rule reads(encode(X, _))                     => X, .Operands\n   136\t  rule reads(assert(C))                        => C, .Operands\n   137\t  rule reads(condSelect(B, A, C, _))           => B, A, C, .Operands\n   138\t  rule reads(constrainBits(V, _))              => V, .Operands\n   139\t  rule reads(constrainEq(A, B))                => A, B, .Operands\n   140\t  rule reads(constrainToBoolean(V))            => V, .Operands\n   141\t  rule reads(copy(V, _))                       => V, .Operands\n   142\t  rule reads(impact(G, Is))                    => G, Is\n   143\t  rule reads(ecMul(A, S, _))                   => A, S, .Operands\n   144\t  rule reads(ecMulGenerator(S, _))             => S, .Operands\n   145\t  rule reads(hashToCurve(Is, _))               => Is\n   146\t  rule reads(intoCoordinates(P, _, _))         => P, .Operands\n   147\t  rule reads(fromCoordinates(X, Y, _))         => X, Y, .Operands\n   148\t  rule reads(intoBytes32(X, _))                => X, .Operands\n   149\t  rule reads(fromBytes32(B, _, _))             => B, .Operands\n   150\t  rule reads(reverseBytes(B, _))               => B, .Operands\n   151\t  rule reads(bytes32IntoLowHigh(B, _, _))      => B, .Operands\n   152\t  rule reads(bytes32FromLowHigh(L, H, _))      => L, H, .Operands\n   153\t  rule reads(divModPowerOfTwo(V, _, _))        => V, .Operands\n   154\t  rule reads(reconstituteField(D, M, _, _))    => M, D, .Operands\n   155\t  rule reads(transientHash(Is, _))             => Is\n   156\t  rule reads(persistentHash(_, Is, _))         => Is\n   157\t  rule reads(keccak256(_, Is, _))              => Is\n   158\t  rule reads(testEq(A, B, _))                  => A, B, .Operands\n   159\t  rule reads(add(A, B, _))                     => A, B, .Operands\n   160\t  rule reads(mul(A, B, _))                     => A, B, .Operands\n   161\t  rule reads(neg(A, _))                        => A, .Operands\n   162\t  rule reads(inv(A, _))                        => A, .Operands\n   163\t  rule reads(not(A, _))                        => A, .Operands\n   164\t  rule reads(lessThan(A, B, _, _))             => A, B, .Operands\n   165\t  rule reads(jubjubScalarFromNative(N, _))     => N, .Operands\n   166\t  rule reads(publicInput(noGuard(), _, _))     => .Operands\n   167\t  rule reads(publicInput(guard(G), _, _))      => G, .Operands\n   168\t  rule reads(privateInput(noGuard(), _, _))    => .Operands\n   169\t  rule reads(privateInput(guard(G), _, _))     => G, .Operands\n   170\t  rule reads(output(Vs))                       => Vs\n   171\t\n   172\t  syntax Ids ::= writes(Instr) [function, total]\n   173\t  rule writes(encode(_, Os))                   => Os\n   174\t  rule writes(assert(_))                       => .Ids\n   175\t  rule writes(condSelect(_, _, _, O))          => O, .Ids\n   176\t  rule writes(constrainBits(_, _))             => .Ids\n   177\t  rule writes(constrainEq(_, _))               => .Ids\n   178\t  rule writes(constrainToBoolean(_))           => .Ids\n   179\t  rule writes(copy(_, O))                      => O, .Ids\n   180\t  rule writes(impact(_, _))                    => .Ids\n   181\t  rule writes(ecMul(_, _, O))                  => O, .Ids\n   182\t  rule writes(ecMulGenerator(_, O))            => O, .Ids\n   183\t  rule writes(hashToCurve(_, O))               => O, .Ids\n   184\t  rule writes(intoCoordinates(_, X, Y))        => X, Y, .Ids\n   185\t  rule writes(fromCoordinates(_, _, O))        => O, .Ids\n   186\t  rule writes(intoBytes32(_, O))               => O, .Ids\n   187\t  rule writes(fromBytes32(_, _, O))            => O, .Ids\n   188\t  rule writes(reverseBytes(_, O))              => O, .Ids\n   189\t  rule writes(bytes32IntoLowHigh(_, L, H))     => L, H, .Ids\n   190\t  rule writes(bytes32FromLowHigh(_, _, O))     => O, .Ids\n   191\t  rule writes(divModPowerOfTwo(_, _, Os))      => Os\n   192\t  rule writes(reconstituteField(_, _, _, O))   => O, .Ids\n   193\t  rule writes(transientHash(_, O))             => O, .Ids\n   194\t  rule writes(persistentHash(_, _, O))         => O, .Ids\n   195\t  rule writes(keccak256(_, _, O))              => O, .Ids\n   196\t  rule writes(testEq(_, _, O))                 => O, .Ids\n   197\t  rule writes(add(_, _, O))                    => O, .Ids\n   198\t  rule writes(mul(_, _, O))                    => O, .Ids\n   199\t  rule writes(neg(_, O))                       => O, .Ids\n   200\t  rule writes(inv(_, O))                       => O, .Ids\n   201\t  rule writes(not(_, O))                       => O, .Ids\n   202\t  rule writes(lessThan(_, _, _, O))            => O, .Ids\n   203\t  rule writes(jubjubScalarFromNative(_, O))    => O, .Ids\n   204\t  rule writes(publicInput(_, _, O))            => O, .Ids\n   205\t  rule writes(privateInput(_, _, O))           => O, .Ids\n   206\t  rule writes(output(_))                       => .Ids\n   207\t\n   208\t  // --- List lengths -----------------------------------------------------------\n   209\t  syntax Int ::= lenOperands(Operands) [function, total]\n   210\t  rule lenOperands(.Operands)  => 0\n   211\t  rule lenOperands(_, Os)      => 1 +Int lenOperands(Os)\n   212\t  syntax Int ::= lenIds(Ids) [function, total]\n   213\t  rule lenIds(.Ids)            => 0\n   214\t  rule lenIds(_, Xs)           => 1 +Int lenIds(Xs)\n   215\t  syntax Int ::= lenIrTypes(IrTypes) [function, total]\n   216\t  rule lenIrTypes(.IrTypes)    => 0\n   217\t  rule lenIrTypes(_, Ts)       => 1 +Int lenIrTypes(Ts)\n   218\t  syntax Int ::= lenInstrs(Instrs) [function, total]\n   219\t  rule lenInstrs(.Instrs)      => 0\n   220\t  rule lenInstrs(_ ; Is)       => 1 +Int lenInstrs(Is)\n   221\tendmodule\n   222\t\n   223\t\n   224\t// Static well-formedness, checked before execution. The checks are those that\n   225\t// hold for every run regardless of inputs:\n   226\t//   1. minor version is 0 (`IrSource::load` accepts 3.0 only);\n   227\t//   2. no identifier is defined twice: not among the inputs, and not by an\n   228\t//      instruction once defined (single assignment, plan decision CLM-0711;\n   229\t//      the Rust preprocess does not enforce this and silently overwrites);\n   230\t//   3. every variable operand is defined by an earlier input or instruction\n   231\t//      (the Rust preprocess reports \"variable not found\" at run time);\n   232\t//   4. immediates lie in [0, r);\n   233\t//   5. arities that the Rust code checks structurally: `output` supplies\n   234\t//      exactly as many values as the signature declares, `div_mod_power_of_two`\n   235\t//      names exactly two outputs, `encode` names exactly encodedLen(type)\n   236\t//      outputs (checked at run time, since the type is dynamic; not here);\n   237\t//   6. bit widths: constrain_bits < FR_BITS; div_mod_power_of_two,\n   238\t//      reconstitute_field and less_than at most FR_BYTES_STORED * 8 = 248\n   239\t//      (the Rust bounds, `ir_vm.rs`).\n   240\t// Everything else (types of operands, guard values, transcript lengths) is\n   241\t// dynamic and belongs to ZKIR-VM.\n   242\tmodule ZKIR-WF\n   243\t  imports ZKIR-SYNTAX\n   244\t  imports SET\n   245\t  imports K-EQUAL\n   246\t\n   247\t  syntax WfResult ::= wfOk()            [symbol(wfOk)]\n   248\t                    | wfError(String)   [symbol(wfError)]\n   249\t\n   250\t  syntax WfResult ::= wf(Program) [function, total]\n   251\t  rule wf(program(Minor, _, _, _, _)) => wfError(\"unsupported minor version \" +String Int2String(Minor))\n   252\t    requires Minor =/=Int 0\n   253\t  rule wf(program(0, Ins, Outs, _, Is)) => #wfInputs(Ins, .Set, Is, lenIrTypes(Outs))\n   254\t\n   255\t  // Inputs: distinct identifiers, then walk the instructions.\n   256\t  syntax WfResult ::= #wfInputs(TypedIds, Set, Instrs, Int) [function, total]\n   257\t  rule #wfInputs(.TypedIds, Defined, Is, N) => #wfInstrs(Is, Defined, N)\n   258\t  rule #wfInputs((typedId(X, _), _), Defined, _, _) => wfError(\"duplicate input \" +String X)\n   259\t    requires X in Defined\n   260\t  rule #wfInputs((typedId(X, _), Rest), Defined, Is, N) => #wfInputs(Rest, Defined |Set SetItem(X), Is, N)\n   261\t    requires notBool (X in Defined)\n   262\t\n   263\t  syntax WfResult ::= #wfInstrs(Instrs, Set, Int) [function, total]\n   264\t  rule #wfInstrs(.Instrs, _, _) => wfOk()\n   265\t  rule #wfInstrs((I ; Is), Defined, N) => #wfAfterReads(#checkReads(reads(I), Defined), I, Is, Defined, N)\n   266\t\n   267\t  syntax WfResult ::= #wfAfterReads(WfResult, Instr, Instrs, Set, Int) [function, total]\n   268\t  rule #wfAfterReads(wfError(S), _, _, _, _) => wfError(S)\n   269\t  rule #wfAfterReads(wfOk(), I, Is, Defined, N) => #wfAfterArity(#checkArity(I, N), I, Is, Defined, N)\n   270\t\n   271\t  syntax WfResult ::= #wfAfterArity(WfResult, Instr, Instrs, Set, Int) [function, total]\n   272\t  rule #wfAfterArity(wfError(S), _, _, _, _) => wfError(S)\n   273\t  rule #wfAfterArity(wfOk(), I, Is, Defined, N) => #wfWrites(writes(I), Is, Defined, N)\n   274\t\n   275\t  syntax WfResult ::= #wfWrites(Ids, Instrs, Set, Int) [function, total]\n   276\t  rule #wfWrites(.Ids, Is, Defined, N) => #wfInstrs(Is, Defined, N)\n   277\t  rule #wfWrites((X, _), _, Defined, _) => wfError(\"reassignment of \" +String X)\n   278\t    requires X in Defined\n   279\t  rule #wfWrites((X, Xs), Is, Defined, N) => #wfWrites(Xs, Is, Defined |Set SetItem(X), N)\n   280\t    requires notBool (X in Defined)\n   281\t\n   282\t  syntax WfResult ::= #checkReads(Operands, Set) [function, total]\n   283\t  rule #checkReads(.Operands, _) => wfOk()\n   284\t  rule #checkReads((imm(V), Os), Defined) => #checkReads(Os, Defined)\n   285\t    requires V >=Int 0 andBool V <Int #blsScalarModulus\n   286\t  rule #checkReads((imm(V), _), _) => wfError(\"immediate out of field range: \" +String Int2String(V))\n   287\t    requires V <Int 0 orBool V >=Int #blsScalarModulus\n   288\t  rule #checkReads((var(X), Os), Defined) => #checkReads(Os, Defined)\n   289\t    requires X in Defined\n   290\t  rule #checkReads((var(X), _), Defined) => wfError(\"undefined variable \" +String X)\n   291\t    requires notBool (X in Defined)\n   292\t\n   293\t  syntax WfResult ::= #checkArity(Instr, Int) [function, total]\n   294\t  rule #checkArity(output(Vs), N) => wfError(\"output: signature declares \" +String Int2String(N) +String \" return values but instruction has \" +String Int2String(lenOperands(Vs)))\n   295\t    requires lenOperands(Vs) =/=Int N\n   296\t  rule #checkArity(divModPowerOfTwo(_, _, Os), _) => wfError(\"div_mod_power_of_two requires exactly 2 outputs\")\n   297\t    requires lenIds(Os) =/=Int 2\n   298\t  rule #checkArity(divModPowerOfTwo(_, B, _), _) => wfError(\"div_mod_power_of_two: excessive bit count\")\n   299\t    requires B >Int #frBytesStored *Int 8\n   300\t  rule #checkArity(reconstituteField(_, _, B, _), _) => wfError(\"reconstitute_field: excessive bit count\")\n   301\t    requires B >Int #frBytesStored *Int 8\n   302\t  rule #checkArity(constrainBits(_, B), _) => wfError(\"constrain_bits: excessive bit bound\")\n   303\t    requires B >=Int #frBits\n   304\t  rule #checkArity(lessThan(_, _, B, _), _) => wfError(\"less_than: excessive bit bound\")\n   305\t    requires B >=Int #frBits\n   306\t  rule #checkArity(_, _) => wfOk() [owise]\n   307\tendmodule\n","exit_code":0,"status":"completed"}}
