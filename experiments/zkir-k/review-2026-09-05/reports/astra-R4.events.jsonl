{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"rg -n 'def __init__|Temporary|def kast_to_kore' .venv/lib/python3.13/site-packages/pyk/ktool/kprint.py; nl -ba experiments/zkir-k/tools/gen_handmade.py; nl -ba /home/charl/Moriarty/repos/_build/midnight-zkir-2ffe2d1/zkir/src/ir_types.rs | sed -n '156,190p'; nl -ba /home/charl/Moriarty/repos/_build/midnight-zkir-2ffe2d1/zkir/src/ir_instructions/assign_constant.rs | sed -n '20,120p'; rg -n 'Warning|non.exhaust|unused|Total|total' evidence/zkir-k* experiments/zkir-k/*.sh\"","aggregated_output":"9:from tempfile import NamedTemporaryFile\n27:    from tempfile import _TemporaryFileWrapper\n181:    def __init__(\n207:    def _temp_file(self, prefix: str | None = None, suffix: str | None = None) -> Iterator[_TemporaryFileWrapper]:\n208:        with NamedTemporaryFile(\n274:    def kast_to_kore(self, kast: KInner, sort: KSort | None = None, *, force_kast: bool = False) -> Pattern:\n     1\t\"\"\"Generate handmade positive programs (corpus/handmade/) with matching test\n     2\tpreimages (manifest.json), so that every value-level instruction has at least\n     3\tone successful differential run on every type it supports.\n     4\t\n     5\tUsage: python gen_handmade.py   (idempotent)\n     6\t\"\"\"\n     7\timport json\n     8\tfrom pathlib import Path\n     9\t\n    10\timport zkir_values as zv\n    11\t\n    12\tOUT = Path(__file__).resolve().parent.parent / 'corpus' / 'handmade'\n    13\tNATIVE = 'Scalar<BLS12-381>'\n    14\tprograms = {}\n    15\t\n    16\t\n    17\tdef prog(name, inputs, instructions, raw, outputs=(), comm=False):\n    18\t    programs[name] = ({'version': {'major': 3, 'minor': 0},\n    19\t                       'inputs': [{'name': n, 'type': t} for n, t in inputs],\n    20\t                       'outputs': list(outputs), 'do_communications_commitment': comm,\n    21\t                       'instructions': instructions},\n    22\t                      [str(x) for x in raw])\n    23\t\n    24\t\n    25\t# --- curves: from/into coordinates, ec_mul, ec_mul_generator, add, neg, test_eq, constrain_eq, encode\n    26\tCURVES = {\n    27\t    'jubjub': ('Point<Jubjub>', 'Scalar<Jubjub>', NATIVE, zv.JUBJUB_G, lambda k: zv.ed_mul(zv.JUBJUB_G, k, zv.R, zv.JUBJUB_D), [], True),\n    28\t    'secp256k1': ('Point<Secp256k1>', 'Scalar<Secp256k1>', 'Base<Secp256k1>', zv.K256_G, lambda k: zv.w_mul(zv.K256_G, k, zv.K256P, 0), [], True),\n    29\t    'secp256r1': ('Point<Secp256r1>', 'Scalar<Secp256r1>', 'Base<Secp256r1>', zv.P256_G, lambda k: zv.w_mul(zv.P256_G, k, zv.P256P, zv.P256P - 3), [], False),\n    30\t    'curve25519': ('Point<Curve25519>', 'Scalar<Curve25519>', 'Base<Curve25519>', zv.C25519_G, lambda k: zv.ed_mul(zv.C25519_G, k, zv.C25519P, zv.C25519_D), [], False),\n    31\t}\n    32\tfor name, (pt, sc, base, g, mul, _, has_gen) in CURVES.items():\n    33\t    p = mul(7)\n    34\t    q = mul(11)\n    35\t    if name == 'jubjub':\n    36\t        raw = [p[0], p[1], q[0], q[1], 5, p[0], p[1]]\n    37\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', NATIVE), ('%y', NATIVE)]\n    38\t    elif name == 'curve25519':\n    39\t        raw = zv.enc_foreign(p[0], zv.C25519P, 64, 4) + zv.enc_foreign(p[1], zv.C25519P, 64, 4) + zv.enc_foreign(q[0], zv.C25519P, 64, 4) + zv.enc_foreign(q[1], zv.C25519P, 64, 4) + zv.enc_foreign(5, zv.C25519L, 51, 5) + zv.enc_foreign(p[0], zv.C25519P, 64, 4) + zv.enc_foreign(p[1], zv.C25519P, 64, 4)\n    40\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', base), ('%y', base)]\n    41\t    else:\n    42\t        mod, order = (zv.K256P, zv.K256N) if name == 'secp256k1' else (zv.P256P, zv.P256N)\n    43\t        raw = zv.enc_wpoint(p, mod) + zv.enc_wpoint(q, mod) + zv.enc_foreign(5, order, 64, 4) + zv.enc_foreign(p[0], mod, 64, 4) + zv.enc_foreign(p[1], mod, 64, 4)\n    44\t        xs = [('%p', pt), ('%q', pt), ('%s', sc), ('%x', base), ('%y', base)]\n    45\t    ins = [\n    46\t        {'op': 'add', 'a': '%p', 'b': '%q', 'output': '%sum'},\n    47\t        {'op': 'neg', 'a': '%p', 'output': '%negp'},\n    48\t        {'op': 'add', 'a': '%sum', 'b': '%negp', 'output': '%q2'},\n    49\t        {'op': 'test_eq', 'a': '%q2', 'b': '%q', 'output': '%eq'},\n    50\t        {'op': 'assert', 'cond': '%eq'},\n    51\t        {'op': 'constrain_eq', 'a': '%q2', 'b': '%q'},\n    52\t        {'op': 'ec_mul', 'a': '%p', 'scalar': '%s', 'output': '%ps'},\n    53\t        {'op': 'into_coordinates', 'point': '%p', 'outputs': ['%px', '%py']},\n    54\t        {'op': 'from_coordinates', 'inputs': ['%x', '%y'], 'output': '%p2'},\n    55\t        {'op': 'constrain_eq', 'a': '%p2', 'b': '%p'},\n    56\t        {'op': 'encode', 'input': '%ps', 'outputs': [f'%e{i}' for i in range(zv.ENCODED_LEN[pt])]},\n    57\t        {'op': 'cond_select', 'bit': '%eq', 'a': '%p', 'b': '%q', 'output': '%sel'},\n    58\t    ]\n    59\t    if has_gen:\n    60\t        ins.append({'op': 'ec_mul_generator', 'scalar': '%s', 'output': '%gs'})\n    61\t    if name != 'jubjub':\n    62\t        ins += [\n    63\t            {'op': 'add', 'a': '%x', 'b': '%y', 'output': '%bx'},\n    64\t            {'op': 'mul', 'a': '%x', 'b': '%y', 'output': '%bm'},\n    65\t            {'op': 'neg', 'a': '%x', 'output': '%bn'},\n    66\t            {'op': 'inv', 'a': '%x', 'output': '%bi'},\n    67\t            {'op': 'into_bytes32', 'input': '%x', 'output': '%xb'},\n    68\t            {'op': 'from_bytes32', 'bytes': '%xb', 'type': base, 'output': '%x2'},\n    69\t            {'op': 'constrain_eq', 'a': '%x2', 'b': '%x'},\n    70\t            {'op': 'encode', 'input': '%x', 'outputs': ['%ex0', '%ex1']},\n    71\t            {'op': 'test_eq', 'a': '%x', 'b': '%y', 'output': '%bxeq'},\n    72\t        ]\n    73\t    prog(f'curve_{name}', xs, ins, raw)\n    74\t\n    75\t# --- native and bytes: arithmetic, bits, bytes32 conversions\n    76\tb = bytes(range(1, 33))\n    77\tlo, hi = int.from_bytes(b[:31], 'little'), b[31]\n    78\tprog('native_bytes', [('%a', NATIVE), ('%b', NATIVE), ('%bs', 'Bytes<32>'), ('%c', 'Scalar<Jubjub>')], [\n    79\t    {'op': 'add', 'a': '%a', 'b': '%b', 'output': '%s'},\n    80\t    {'op': 'mul', 'a': '%a', 'b': '%b', 'output': '%m'},\n    81\t    {'op': 'neg', 'a': '%a', 'output': '%n'},\n    82\t    {'op': 'inv', 'a': '%a', 'output': '%i'},\n    83\t    {'op': 'mul', 'a': '%a', 'b': '%i', 'output': '%one'},\n    84\t    {'op': 'constrain_eq', 'a': '%one', 'b': '0x01'},\n    85\t    {'op': 'not', 'a': '0x00', 'output': '%t'},\n    86\t    {'op': 'assert', 'cond': '%t'},\n    87\t    {'op': 'constrain_to_boolean', 'val': '%t'},\n    88\t    {'op': 'constrain_bits', 'val': '%a', 'bits': 16},\n    89\t    {'op': 'less_than', 'a': '%a', 'b': '%b', 'bits': 16, 'output': '%lt'},\n    90\t    {'op': 'div_mod_power_of_two', 'val': '%b', 'bits': 4, 'outputs': ['%q', '%r']},\n    91\t    {'op': 'reconstitute_field', 'divisor': '%q', 'modulus': '%r', 'bits': 4, 'output': '%b2'},\n    92\t    {'op': 'constrain_eq', 'a': '%b2', 'b': '%b'},\n    93\t    {'op': 'copy', 'val': '%a', 'output': '%a2'},\n    94\t    {'op': 'into_bytes32', 'input': '%a', 'output': '%ab'},\n    95\t    {'op': 'from_bytes32', 'bytes': '%ab', 'type': NATIVE, 'output': '%a3'},\n    96\t    {'op': 'constrain_eq', 'a': '%a3', 'b': '%a'},\n    97\t    {'op': 'reverse_bytes', 'bytes': '%bs', 'output': '%rev'},\n    98\t    {'op': 'reverse_bytes', 'bytes': '%rev', 'output': '%rev2'},\n    99\t    {'op': 'constrain_eq', 'a': '%rev2', 'b': '%bs'},\n   100\t    {'op': 'test_eq', 'a': '%rev', 'b': '%bs', 'output': '%beq'},\n   101\t    {'op': 'bytes32_into_low_high', 'bytes': '%bs', 'outputs': ['%lo', '%hi']},\n   102\t    {'op': 'bytes32_from_low_high', 'inputs': ['%lo', '%hi'], 'output': '%bs2'},\n   103\t    {'op': 'constrain_eq', 'a': '%bs2', 'b': '%bs'},\n   104\t    {'op': 'encode', 'input': '%bs', 'outputs': ['%e0', '%e1']},\n   105\t    {'op': 'jubjub_scalar_from_native', 'native': '%a', 'output': '%js'},\n   106\t    {'op': 'ec_mul_generator', 'scalar': '%c', 'output': '%gc'},\n   107\t    {'op': 'encode', 'input': '%c', 'outputs': ['%ec']},\n   108\t    {'op': 'cond_select', 'bit': '%lt', 'a': '%a', 'b': '%b', 'output': '%sel'},\n   109\t    {'op': 'transient_hash', 'inputs': ['%a', '%b'], 'output': '%h'},\n   110\t    {'op': 'hash_to_curve', 'inputs': ['%h'], 'output': '%hp'},\n   111\t    {'op': 'output', 'vals': ['%s', '%hp']},\n   112\t], [1234, 60000, lo, hi, 987654321], outputs=[NATIVE, 'Point<Jubjub>'])\n   113\t\n   114\t# --- transcripts, impacts, guards, commitment\n   115\tprog('transcripts', [('%a', NATIVE)], [\n   116\t    {'op': 'public_input', 'guard': None, 'type': NATIVE, 'output': '%p1'},\n   117\t    {'op': 'private_input', 'guard': None, 'type': 'Bytes<32>', 'output': '%s1'},\n   118\t    {'op': 'test_eq', 'a': '%a', 'b': '0x01', 'output': '%g'},\n   119\t    {'op': 'public_input', 'guard': '%g', 'type': 'Point<Jubjub>', 'output': '%pp'},\n   120\t    {'op': 'private_input', 'guard': '%g', 'type': 'Scalar<Secp256k1>', 'output': '%ps'},\n   121\t    {'op': 'impact', 'guard': '0x01', 'inputs': ['%a', '%p1']},\n   122\t    {'op': 'impact', 'guard': '%g', 'inputs': ['0x07', '0x08', '0x09']},\n   123\t    {'op': 'not', 'a': '%g', 'output': '%ng'},\n   124\t    {'op': 'impact', 'guard': '%ng', 'inputs': ['0x0a']},\n   125\t    {'op': 'encode', 'input': '%pp', 'outputs': ['%x', '%y']},\n   126\t    {'op': 'output', 'vals': ['%p1', '%s1']},\n   127\t], [1], outputs=[NATIVE, 'Bytes<32>'], comm=True)\n   128\tprog('transcripts_guard_off', programs['transcripts'][0]['inputs'] and [('%a', NATIVE)], programs['transcripts'][0]['instructions'], [0], outputs=[NATIVE, 'Bytes<32>'], comm=True)\n   129\t\n   130\tmanifest = {'note': 'handmade positive programs generated by tools/gen_handmade.py', 'programs': []}\n   131\tfor name, (doc, raw) in programs.items():\n   132\t    (OUT / f'{name}.zkir').write_text(json.dumps(doc, indent=1) + '\\n')\n   133\t    manifest['programs'].append({'file': f'{name}.zkir', 'ops': sorted({i['op'] for i in doc['instructions']}), 'test_preimage': {'inputs': raw}})\n   134\tfor extra in ['transient_hash.zkir', 'std_hashes.zkir']:\n   135\t    manifest['programs'].append({'file': extra, 'test_preimage': {'inputs': ['5', '123456789', '987654321987654321']}})\n   136\t(OUT / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\\n')\n   137\tprint('wrote', len(programs), 'programs')\n   156\t    /// Parses the canonical string representation. Returns `None` for unknown\n   157\t    /// or non-canonical strings, including `Bytes<0>`, non-canonical integer\n   158\t    /// forms (e.g. leading zeros), and lengths outside `1..=`[`MAX_BYTES_LEN`].\n   159\t    fn from_type_string(s: &str) -> Option<Self> {\n   160\t        Some(match s {\n   161\t            \"Scalar<BLS12-381>\" => IrType::Native,\n   162\t            \"Bool\" => IrType::Bool,\n   163\t            \"Byte\" => IrType::Byte,\n   164\t            \"Point<Jubjub>\" => IrType::JubjubPoint,\n   165\t            \"Scalar<Jubjub>\" => IrType::JubjubScalar,\n   166\t            \"Point<Secp256k1>\" => IrType::Secp256k1Point,\n   167\t            \"Base<Secp256k1>\" => IrType::Secp256k1Base,\n   168\t            \"Scalar<Secp256k1>\" => IrType::Secp256k1Scalar,\n   169\t            \"Point<Secp256r1>\" => IrType::Secp256r1Point,\n   170\t            \"Base<Secp256r1>\" => IrType::Secp256r1Base,\n   171\t            \"Scalar<Secp256r1>\" => IrType::Secp256r1Scalar,\n   172\t            \"Point<Curve25519>\" => IrType::Curve25519Point,\n   173\t            \"Base<Curve25519>\" => IrType::Curve25519Base,\n   174\t            \"Scalar<Curve25519>\" => IrType::Curve25519Scalar,\n   175\t            other => {\n   176\t                let inner = other.strip_prefix(\"Bytes<\")?.strip_suffix('>')?;\n   177\t                // Reject non-canonical integers: empty, non-digits, or a\n   178\t                // leading zero (which also rules out \"0\" itself).\n   179\t                let canonical = !inner.is_empty()\n   180\t                    && inner.bytes().all(|b| b.is_ascii_digit())\n   181\t                    && !inner.starts_with('0');\n   182\t                if !canonical {\n   183\t                    return None;\n   184\t                }\n   185\t                let n: u32 = inner.parse().ok()?;\n   186\t                if n > MAX_BYTES_LEN {\n   187\t                    return None;\n   188\t                }\n   189\t                IrType::Bytes(n)\n   190\t            }\n    20\t    ir_types::{CircuitValue, IrValue},\n    21\t};\n    22\t\n    23\t/// Assigns a fixed (constant) in-circuit value from a concrete [`IrValue`].\n    24\t///\n    25\t/// Unlike [`assign_incircuit`](crate::ir_instructions::assign::assign_incircuit),\n    26\t/// which assigns (possibly secret) witness values supplied by the prover, this\n    27\t/// bakes `value` into the circuit as a constant via `assign_fixed`. The value is\n    28\t/// known at keygen time and is therefore part of the circuit definition.\n    29\t///\n    30\t/// Supported on every value type.\n    31\tpub fn assign_constant_incircuit(\n    32\t    std_lib: &ZkStdLib,\n    33\t    layouter: &mut impl Layouter<F>,\n    34\t    value: &IrValue,\n    35\t) -> Result<CircuitValue, Error> {\n    36\t    match value {\n    37\t        IrValue::Native(x) => std_lib\n    38\t            .assign_fixed(layouter, x.0)\n    39\t            .map(CircuitValue::Native),\n    40\t\n    41\t        IrValue::Bool(b) => std_lib.assign_fixed(layouter, *b).map(CircuitValue::Bool),\n    42\t\n    43\t        IrValue::Byte(b) => std_lib.assign_fixed(layouter, *b).map(CircuitValue::Byte),\n    44\t\n    45\t        IrValue::Bytes(bs) => std_lib\n    46\t            .assign_many_fixed(layouter, bs)\n    47\t            .map(CircuitValue::Bytes),\n    48\t\n    49\t        IrValue::JubjubPoint(p) => std_lib\n    50\t            .jubjub()\n    51\t            .assign_fixed(layouter, *p)\n    52\t            .map(CircuitValue::JubjubPoint),\n    53\t\n    54\t        IrValue::JubjubScalar(s) => std_lib\n    55\t            .jubjub()\n    56\t            .assign_fixed(layouter, *s)\n    57\t            .map(CircuitValue::JubjubScalar),\n    58\t\n    59\t        IrValue::Secp256k1Point(p) => std_lib\n    60\t            .secp256k1()\n    61\t            .assign_fixed(layouter, *p)\n    62\t            .map(CircuitValue::Secp256k1Point),\n    63\t\n    64\t        IrValue::Secp256k1Base(s) => (std_lib.secp256k1().base_field_chip())\n    65\t            .assign_fixed(layouter, *s)\n    66\t            .map(CircuitValue::Secp256k1Base),\n    67\t\n    68\t        IrValue::Secp256k1Scalar(s) => (std_lib.secp256k1().scalar_field_chip())\n    69\t            .assign_fixed(layouter, *s)\n    70\t            .map(CircuitValue::Secp256k1Scalar),\n    71\t\n    72\t        IrValue::Secp256r1Point(p) => std_lib\n    73\t            .p256()\n    74\t            .assign_fixed(layouter, *p)\n    75\t            .map(CircuitValue::Secp256r1Point),\n    76\t\n    77\t        IrValue::Secp256r1Base(s) => (std_lib.p256().base_field_chip())\n    78\t            .assign_fixed(layouter, *s)\n    79\t            .map(CircuitValue::Secp256r1Base),\n    80\t\n    81\t        IrValue::Secp256r1Scalar(s) => (std_lib.p256().scalar_field_chip())\n    82\t            .assign_fixed(layouter, *s)\n    83\t            .map(CircuitValue::Secp256r1Scalar),\n    84\t\n    85\t        IrValue::Curve25519Point(p) => std_lib\n    86\t            .curve25519()\n    87\t            .assign_fixed(layouter, *p)\n    88\t            .map(CircuitValue::Curve25519Point),\n    89\t\n    90\t        IrValue::Curve25519Base(s) => (std_lib.curve25519().base_field_chip())\n    91\t            .assign_fixed(layouter, *s)\n    92\t            .map(CircuitValue::Curve25519Base),\n    93\t\n    94\t        IrValue::Curve25519Scalar(s) => (std_lib.curve25519().