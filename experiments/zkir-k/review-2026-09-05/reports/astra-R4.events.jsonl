ast}')\n        kast_json = {'format': 'KAST', 'version': KAst.version(), 'term': kast.to_dict()}\n        proc_res = self._expression_kast(\n            json.dumps(kast_json),\n            input=KAstInput.JSON,\n            output=KAstOutput.KORE,\n            sort=sort.name if sort is not None else None,\n        )\n        return KoreParser(proc_res.stdout).pattern()\n\n    def _add_sort_injection(self, pat: Pattern, isort: KSort, osort: KSort) -> Pattern:\n        if isort == osort:\n            return pat\n        if isort not in self.definition.subsorts(osort):\n            raise ValueError(\n                f'Could not find injection from subsort to supersort {isort} -> {osort} for pattern: {pat}'\n            )\n        return App('inj', [SortApp('Sort' + isort.name), SortApp('Sort' + osort.name)], [pat])\n\n    def pretty_print(\n        self, kast: KAst, *, in_module: str | None = None, unalias: bool = True, sort_collections: bool = False\n    ) -> str:\n        defn = self.definition.let(main_module_name=in_module)\n\n        return PrettyPrinter(\n            defn,\n            extra_unparsing_modules=self._extra_unparsing_modules,\n            patch_symbol_table=self._patch_symbol_table,\n            unalias=unalias,\n            sort_collections=sort_collections,\n        ).print(kast)\n\n    def _expression_kast(\n        self,\n148:LBL_INIT_GENERATED_TOP_CELL: Final = SymbolId('LblinitGeneratedTopCell')\n159:def init_generated_top_cell(pattern: Pattern) -> App:\n195:def k_config_var(var: str) -> DV:\n199:def top_cell_initializer(config: Mapping[str, Pattern]) -> App:\nrg: .venv/lib/python3.13/site-packages/pyk/kllvm/interpreter.py: IO error for operation on .venv/lib/python3.13/site-packages/pyk/kllvm/interpreter.py: No such file or directory (os error 2)\n     1\t// Hash primitives used by ZKIR v3, computed concretely.\n     2\t//\n     3\t//   poseidonHash(List)      transient_hash: Poseidon sponge over the BLS12-381\n     4\t//                           scalar field, t = 3, rate 2, R_F = 8, R_P = 60, with\n     5\t//                           the fixed-length domain (capacity element = input\n     6\t//                           length). midnight-circuits 7.2.4 hash/poseidon/*.\n     7\t//   hashToCurve(List)       transient_crypto::hash::hash_to_curve: variable-length\n     8\t//                           Poseidon sponge (capacity 2^64, length padding),\n     9\t//                           two squeezes, Shallue-van de Woestijne map to the\n    10\t//                           Weierstrass form of Jubjub, conversion to Edwards,\n    11\t//                           cofactor clearing, sum of the two points.\n    12\t//   sha256(Bytes)           FIPS 180-4.\n    13\t//   keccak256(Bytes)        Keccak-f[1600], rate 1088, pad 0x01 .. 0x80 (pre-NIST).\n    14\t//\n    15\t// The Rust Poseidon CPU code folds partial rounds in pairs (\"round skips\"); that\n    16\t// is an algebraic rewrite of the plain round function implemented here, and the\n    17\t// differential tests against the crate confirm the outputs agree.\n    18\trequires \"zkir-field.k\"\n    19\trequires \"zkir-curves.k\"\n    20\trequires \"zkir-constants.k\"\n    21\t\n    22\tmodule ZKIR-HASH\n    23\t  imports ZKIR-FIELD\n    24\t  imports ZKIR-CURVES\n    25\t  imports ZKIR-CONSTANTS\n    26\t  imports BYTES\n    27\t  imports LIST\n    28\t\n    29\t  // ---------------------------------------------------------------------------\n    30\t  // Poseidon permutation on a 3-element state (s0, s1, s2), all mod r.\n    31\t  syntax PState ::= ps(Int, Int, Int)\n    32\t\n    33\t  syntax Int ::= sbox(Int) [function, total]\n    34\t  rule sbox(X) => fmul(fsq(fsq(X, #r), #r), X, #r)\n    35\t\n    36\t  // new[i] = rc[i] + sum_j MDS[i][j] * s[j]\n    37\t  syntax PState ::= linear(PState, Int) [function, total]   // (state, round index for RC[round+1]; -1 = zero constants)\n    38\t  rule linear(ps(S0, S1, S2), R) => ps(\n    39\t      fadd(#rc(R, 0), fadd(fadd(fmul(poseidonMDS(0, 0), S0, #r), fmul(poseidonMDS(0, 1), S1, #r), #r), fmul(poseidonMDS(0, 2), S2, #r), #r), #r),\n    40\t      fadd(#rc(R, 1), fadd(fadd(fmul(poseidonMDS(1, 0), S0, #r), fmul(poseidonMDS(1, 1), S1, #r), #r), fmul(poseidonMDS(1, 2), S2, #r), #r), #r),\n    41\t      fadd(#rc(R, 2), fadd(fadd(fmul(poseidonMDS(2, 0), S0, #r), fmul(poseidonMDS(2, 1), S1, #r), #r), fmul(poseidonMDS(2, 2), S2, #r), #r), #r))\n    42\t  syntax Int ::= #rc(Int, Int) [function, total]\n    43\t  rule #rc(R, J) => poseidonRC(R +Int 1, J) requires R >=Int 0 andBool R <Int 67\n    44\t  rule #rc(_, _) => 0 [owise]\n    45\t\n    46\t  syntax PState ::= fullRound(PState, Int) [function, total]\n    47\t  rule fullRound(ps(S0, S1, S2), R) => linear(ps(sbox(S0), sbox(S1), sbox(S2)), R)\n    48\t  syntax PState ::= partialRound(PState, Int) [function, total]\n    49\t  rule partialRound(ps(S0, S1, S2), R) => linear(ps(S0, S1, sbox(S2)), R)\n    50\t\n    51\t  syntax PState ::= permute(PState) [function, total]\n    52\t  rule permute(ps(S0, S1, S2)) => #rounds(ps(fadd(S0, poseidonRC(0, 0), #r), fadd(S1, poseidonRC(0, 1), #r), fadd(S2, poseidonRC(0, 2), #r)), 0)\n    53\t  syntax PState ::= #rounds(PState, Int) [function, total]\n    54\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R <Int 4\n    55\t  rule #rounds(S, R) => #rounds(partialRound(S, R), R +Int 1) requires R >=Int 4 andBool R <Int 64\n    56\t  rule #rounds(S, R) => #rounds(fullRound(S, R), R +Int 1) requires R >=Int 64 andBool R <Int 68\n    57\t  rule #rounds(S, R) => S requires R >=Int 68\n    58\t\n    59\t  // Absorb a queue of elements in chunks of two, permuting after each chunk.\n    60\t  syntax PState ::= absorbAll(PState, List) [function, total]\n    61\t  rule absorbAll(S, .List) => S\n    62\t  rule absorbAll(ps(S0, S1, S2), ListItem(A) ListItem(B) Rest) => absorbAll(permute(ps(fadd(S0, A, #r), fadd(S1, B, #r), S2)), Rest)\n    63\t  rule absorbAll(ps(S0, S1, S2), ListItem(A)) => permute(ps(fadd(S0, A, #r), S1, S2))\n    64\t\n    65\t  // Fixed-length Poseidon hash (transient_hash).\n    66\t  syntax Int ::= poseidonHash(List) [function, total]\n    67\t  rule poseidonHash(Xs) => #ps0(absorbAll(ps(0, 0, size(Xs) modInt #r), Xs))\n    68\t  syntax Int ::= #ps0(PState) [function, total]\n    69\t  rule #ps0(ps(S0, _, _)) => S0\n    70\t  syntax Int ::= #ps1(PState) [function, total]\n    71\t  rule #ps1(ps(_, S1, _)) => S1\n    72\t\n    73\t  // transient_commit(values, opening) = poseidonHash([opening] ++ values)\n    74\t  syntax Int ::= transientCommit(List, Int) [function, total]\n    75\t  rule transientCommit(Vs, Rand) => poseidonHash(ListItem(Rand) Vs)\n    76\t\n    77\t  // Variable-length sponge used by hash_to_curve: capacity 2^64, the input\n    78\t  // length appended as padding, then two squeezes (register 0 and 1).\n    79\t  syntax PState ::= varLenSponge(List) [function, total]\n    80\t  rule varLenSponge(Xs) => absorbAll(ps(0, 0, 18446744073709551616), Xs ListItem(size(Xs)))\n    81\t\n    82\t  // ---------------------------------------------------------------------------\n    83\t  // Hash to curve (Jubjub subgroup).\n    84\t  syntax Point ::= hashToCurve(List) [function, total]\n    85\t  rule hashToCurve(Xs) => #htc(varLenSponge(Xs))\n    86\t  syntax Point ::= #htc(PState) [function, total]\n    87\t  rule #htc(ps(X1, X2, _)) => ecAdd(#jubjub, mapToCurve(X1), mapToCurve(X2))\n    88\t\n    89\t  // SVDW constants (mtc_params.rs), all mod r\n    90\t  syntax Int ::= \"#svdwC1\" [function, total]   // g(Z)\n    91\t  rule #svdwC1 => #g(#svdwZ)\n    92\t  syntax Int ::= #g(Int) [function, total]\n    93\t  rule #g(X) => fadd(fadd(fmul(fmul(X, X, #r), X, #r), fmul(#svdwA, X, #r), #r), #svdwB, #r)\n    94\t  syntax Int ::= \"#svdwC2\" [function, total]   // -Z / 2\n    95\t  rule #svdwC2 => fneg(fmul(#svdwZ, finv(2, #r), #r), #r)\n    96\t  syntax Int ::= \"#svdwC3\" [function, total]   // sqrt(-g(Z) * (3 Z^2 + 4 A)), even root\n    97\t  rule #svdwC3 => #evenRoot(fsqrt(fneg(fmul(#svdwC1, fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r))\n    98\t  syntax Int ::= #evenRoot(SqrtResult) [function, total]\n    99\t  rule #evenRoot(sqrtOk(S)) => S requires S modInt 2 ==Int 0\n   100\t  rule #evenRoot(sqrtOk(S)) => fneg(S, #r) requires S modInt 2 ==Int 1\n   101\t  rule #evenRoot(noSqrt()) => 0\n   102\t  syntax Int ::= \"#svdwC4\" [function, total]   // -4 g(Z) / (3 Z^2 + 4 A)\n   103\t  rule #svdwC4 => fneg(fmul(fmul(4, #svdwC1, #r), finv(fadd(fmul(3, fsq(#svdwZ, #r), #r), fmul(4, #svdwA, #r), #r), #r), #r), #r)\n   104\t\n   105\t  syntax Point ::= mapToCurve(Int) [function, total]\n   106\t  rule mapToCurve(U) => ecMul(#jubjub, #edFromMont(#wToMont(#svdw(U))), 8)\n   107\t\n   108\t  // svdw_map_to_curve: returns pt(x, y) on the Weierstrass form\n   109\t  syntax Point ::= #svdw(Int) [function, total]\n   110\t  rule #svdw(U) => #svdw1(U, fmul(fsq(U, #r), #svdwC1, #r))\n   111\t  syntax Point ::= #svdw1(Int, Int) [function, total]   // (u, tv1 = u^2 c1)\n   112\t  rule #svdw1(U, T) => #svdw2(U, fadd(1, T, #r), fsub(1, T, #r))\n   113\t  syntax Point ::= #svdw2(Int, Int, Int) [function, total]   // (u, tv2 = 1 + t, tv1 = 1 - t)\n   114\t  rule #svdw2(U, TV2, TV1) => #svdw3(U, TV2, TV1, finv(fmul(TV1, TV2, #r), #r))\n   115\t  syntax Point ::= #svdw3(Int, Int, Int, Int) [function, total]   // (u, tv2, tv1, tv3 = inv(tv1 tv2))\n   116\t  rule #svdw3(U, TV2, TV1, TV3) => #svdw4(U, TV2, TV3, fmul(fmul(fmul(U, TV1, #r), TV3, #r), #svdwC3, #r))\n   117\t  syntax Point ::= #svdw4(Int, Int, Int, Int) [function, total]   // (u, tv2, tv3, tv4)\n   118\t  rule #svdw4(U, TV2, TV3, TV4) => #svdwPick(U,\n   119\t      fsub(#svdwC2, TV4, #r), fadd(#svdwC2, TV4, #r),\n   120\t      fadd(fmul(fsq(fmul(fsq(TV2, #r), TV3, #r), #r), #svdwC4, #r), #svdwZ, #r))\n   121\t  // e1 = g(x1) residue; e2 = g(x2) residue and not e1; x = e1 ? x1 : e2 ? x2 : x3\n   122\t  syntax Point ::= #svdwPick(Int, Int, Int, Int) [function, total]\n   123\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X1) requires notBool isQuadraticNonResidue(#g(X1), #r)\n   124\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X2) requires isQuadraticNonResidue(#g(X1), #r) andBool notBool isQuadraticNonResidue(#g(X2), #r)\n   125\t  rule #svdwPick(U, X1, X2, X3) => #svdwY(U, X3) requires isQuadraticNonResidue(#g(X1), #r) andBool isQuadraticNonResidue(#g(X2), #r)\n   390\t    requires Idx +Int encodedLen(T) >Int size(#prePrivate(Pre))\n   391\t  rule <k> #input(boolOk(true), T, O, \"private\") => .K ... </k> <mem> M => M[O <- defaultValue(T)] </mem>\n   392\t       <pre> Pre </pre> <privIdx> Idx => Idx +Int encodedLen(T) </privIdx> <genMode> true </genMode>\n   393\t       <needs> N => N ListItem(needPriv(T)) </needs>\n   394\t    requires Idx +Int encodedLen(T) >Int size(#prePrivate(Pre))\n   395\t  // The Rust code indexes the slice directly and panics past the end; we report it.\n   396\t  // (The Rust code indexes the transcript slice directly and panics with an\n   397\t  // index-out-of-range when it is too short; here that is an error.)\n   398\t  syntax ValueResult ::= #decodeSlice(List, Int, IrType, Bool) [function, total]\n   399\t  rule #decodeSlice(L, Idx, T, _) => vErr(\"transcript index out of range\") requires Idx +Int encodedLen(T) >Int size(L)\n   400\t  rule #decodeSlice(L, Idx, T, Strict) => #toValue(decodeStrict(range(L, Idx, size(L) -Int Idx -Int encodedLen(T)), T, Strict))\n   401\t    requires Idx +Int encodedLen(T) <=Int size(L)\n   402\t  syntax ValueResult ::= #toValue(DecodeResult) [function, total]\n   403\t  rule #toValue(decOk(V)) => vOk(V)\n   404\t  rule #toValue(decErr(S)) => vErr(S)\n   405\t\n   406\t  // impact\n   407\t  rule <k> #exec(impact(G, Xs)) => #impact(resolveBool(G, M), Xs) ... </k> <mem> M </mem> <status> ok() </status>\n   408\t  syntax KItem ::= #impact(BoolResult, Operands)\n   409\t  rule <k> #impact(boolErr(S), _) => #fail(S) ... </k>\n   410\t  rule <k> #impact(boolOk(false), Xs) => .K ... </k>\n   411\t       <pi> Pi => Pi #zeros(lenOperands(Xs)) </pi>\n   412\t       <skips> Sk => Sk ListItem(skipSome(lenOperands(Xs))) </skips>\n   413\t  rule <k> #impact(boolOk(true), Xs) => #impactPush(resolveAll(Xs, M)) ... </k> <mem> M </mem>\n   414\t  syntax KItem ::= #impactPush(ValuesResult)\n   415\t  rule <k> #impactPush(vsErr(S)) => #fail(S) ... </k>\n   416\t  rule <k> #impactPush(vsOk(Vs)) => #impactNatives(asNatives(Vs)) ... </k>\n   417\t  syntax KItem ::= #impactNatives(IntsResult)\n   418\t  rule <k> #impactNatives(isErr(S)) => #fail(S) ... </k>\n   419\t  rule <k> #impactNatives(isOk(L)) => #impactCheck(L, Idx) ... </k>\n   420\t       <pi> Pi => Pi L </pi>\n   421\t       <skips> Sk => Sk ListItem(skipNone()) </skips>\n   422\t       <pubInIdx> Idx => Idx +Int size(L) </pubInIdx>\n   423\t  // every pushed value must equal the expected public transcript input at its index\n   424\t  syntax KItem ::= #impactCheck(List, Int)\n   425\t  rule <k> #impactCheck(.List, _) => .K ... </k>\n   426\t  rule <k> #impactCheck(ListItem(X) L, Idx) => #impactCheck(L, Idx +Int 1) ... </k> <pre> Pre </pre> <genMode> false </genMode>\n   427\t    requires Idx <Int size(#prePubIn(Pre)) andBool {#prePubIn(Pre)[Idx]}:>Int ==Int X\n   428\t  rule <k> #impactCheck(ListItem(X) _, Idx) => #fail(\"Public transcript input mismatch for input \" +String Int2String(Idx)) ... </k> <pre> Pre </pre> <genMode> false </genMode>\n   429\t    requires notBool (Idx <Int size(#prePubIn(Pre)) andBool {#prePubIn(Pre)[Idx]}:>Int ==Int X)\n   430\t  rule <k> #impactCheck(ListItem(X) L, Idx) => #impactCheck(L, Idx +Int 1) ... </k> <genMode> true </genMode>\n   431\t       <needs> N => N ListItem(needPubIn(X)) </needs>\n   432\t  syntax List ::= #zeros(Int) [function, total]\n   433\t  rule #zeros(N) => .List requires N <=Int 0\n   434\t  rule #zeros(N) => ListItem(0) #zeros(N -Int 1) requires N >Int 0\n   435\t\n   436\t  // output\n   437\t  rule <k> #exec(output(Vs)) => #output(resolveAll(Vs, M), Ts, 0) ... </k> <mem> M </mem> <outTypes> Ts </outTypes> <status> ok() </status>\n   438\t  syntax KItem ::= #output(ValuesResult, IrTypes, Int)\n   439\t  rule <k> #output(vsErr(S), _, _) => #fail(S) ... </k>\n   440\t  rule <k> #output(vsOk(L), Ts, _) => #fail(\"Output: signature declares \" +String Int2String(lenIrTypes(Ts)) +String \" return values but instruction has \" +String Int2String(size(L))) ... </k>\n   441\t    requires size(L) =/=Int lenIrTypes(Ts)\n   442\t  rule <k> #output(vsOk(.List), .IrTypes, _) => .K ... </k>\n   443\t  rule <k> #output(vsOk(ListItem(V) L), (T, Ts), I) => #output(vsOk(L), Ts, I +Int 1) ... </k> <outputs> Os => Os ListItem(V) </outputs>\n   444\t    requires size(L) ==Int lenIrTypes(Ts) andBool typeOf(V) ==K T\n   445\t  rule <k> #output(vsOk(ListItem(V) L), (T, Ts), I) => #fail(\"Output position \" +String Int2String(I) +String \": signature declares \" +String typeName(T) +String \" but operand has runtime type \" +String tn(V)) ... </k>\n   446\t    requires size(L) ==Int lenIrTypes(Ts) andBool typeOf(V) =/=K T\n   447\t\n   448\t  // --- After the run: evaluate every emitted constraint against the witness ---------------------\n   449\t  syntax KItem ::= \"#verdicts\"\n   450\t  rule <k> #verdicts => .K ... </k> <constraints> Cs </constraints> <mem> M </mem> <pi> Pi </pi> <chips> Chips </chips>\n   451\t       <verdicts> _ => verdicts(Cs, M, Pi, Chips) </verdicts>\n   452\t\n   453\t  // --- End of program: transcript exhaustion and communications commitment ------------------\n   454\t  syntax KItem ::= \"#finish\"\n   455\t  rule <k> #finish => .K ... </k> <status> error(_) </status>\n   456\t  rule <k> #finish => .K ... </k> <status> ok() </status> <genMode> true </genMode> <doComm> false </doComm>\n   457\t  rule <k> #finish => .K ... </k> <status> ok() </status> <genMode> true </genMode> <doComm> true </doComm> <pre> Pre </pre> <outputs> Os </outputs>\n   458\t       <needs> N => N ListItem(needComm(transientCommit(#preInputs(Pre) #encodeAll(Os), #commRand(#preComm(Pre))))) </needs>\n   459\t  syntax Int ::= #commRand(CommOpt) [function, total]\n   460\t  rule #commRand(comm(_, Rand)) => Rand\n   461\t  rule #commRand(noComm()) => 0\n   462\t  rule <k> #finish => #fail(\"Transcripts not fully consumed\") ... </k> <status> ok() </status> <pre> Pre </pre> <genMode> false </genMode>\n   463\t       <pubInIdx> A </pubInIdx> <pubOutIdx> B </pubOutIdx> <privIdx> C </privIdx>\n   464\t    requires size(#prePubIn(Pre)) =/=Int A orBool size(#prePubOut(Pre)) =/=Int B orBool size(#prePrivate(Pre)) =/=Int C\n   465\t  rule <k> #finish => .K ... </k> <status> ok() </status> <pre> Pre </pre> <doComm> false </doComm> <genMode> false </genMode>\n   466\t       <pubInIdx> A </pubInIdx> <pubOutIdx> B </pubOutIdx> <privIdx> C </privIdx>\n   467\t    requires size(#prePubIn(Pre)) ==Int A andBool size(#prePubOut(Pre)) ==Int B andBool size(#prePrivate(Pre)) ==Int C\n   468\t  rule <k> #finish => #commCheck(#preComm(Pre), Os) ... </k> <status> ok() </status> <pre> Pre </pre> <doComm> true </doComm> <outputs> Os </outputs> <genMode> false </genMode>\n   469\t       <pubInIdx> A </pubInIdx> <pubOutIdx> B </pubOutIdx> <privIdx> C </privIdx>\n   470\t    requires size(#prePubIn(Pre)) ==Int A andBool size(#prePubOut(Pre)) ==Int B andBool size(#prePrivate(Pre)) ==Int C\n   471\t  syntax KItem ::= #commCheck(CommOpt, List)\n   472\t  rule <k> #commCheck(noComm(), _) => #fail(\"Expected communications randomness\") ... </k>\n   473\t  rule <k> #commCheck(comm(Cm, Rand), Os) => .K ... </k> <pre> Pre </pre>\n   474\t    requires Cm ==Int transientCommit(#preInputs(Pre) #encodeAll(Os), Rand)\n   475\t  rule <k> #commCheck(comm(Cm, Rand), Os) => #fail(\"Communications commitment mismatch\") ... </k> <pre> Pre </pre>\n   476\t    requires Cm =/=Int transientCommit(#preInputs(Pre) #encodeAll(Os), Rand)\n   477\t  syntax List ::= #encodeA