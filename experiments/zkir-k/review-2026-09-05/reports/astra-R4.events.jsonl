{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba experiments/zkir-k/tools/zkir_kast.py | sed -n '1,245p'; nl -ba experiments/zkir-k/semantics/zkir-syntax.k | sed -n '282,307p'\"","aggregated_output":"     1\t\"\"\"ZKIR v3 JSON -> K term (pyk) preprocessor.\n     2\t\n     3\tReads a `.zkir` artifact (JSON, version 3.0) and builds the `Program` term of\n     4\tsemantics/zkir-syntax.k as a pyk KInner. Mirrors the serde layer of\n     5\t`zkir-v3/src/ir.rs` at midnight-ledger 92e8bdd3:\n     6\t\n     7\t- operands: strings starting with \"%\" are variables; \"0x…\"/\"-0x…\" are\n     8\t  little-endian hex immediates that must fit the BLS12-381 scalar field\n     9\t  (`Fr::from_le_bytes` returns None otherwise); anything else is rejected;\n    10\t- `guard: null` on public_input/private_input is `noGuard()`;\n    11\t- alignments: `[{\"tag\":\"atom\",\"value\":{\"tag\":\"bytes\",\"length\":n}} …]`.\n    12\t\n    13\tUsage:\n    14\t  zkir_kast.py kore  FILE.zkir            print the Program term as KORE text\n    15\t  zkir_kast.py kast  FILE.zkir            print the Program term as KAST JSON\n    16\t  zkir_kast.py check FILE.zkir [--definition DIR]\n    17\t                                          run ZKIR-CHECK, print wfOk/wfError\n    18\t\"\"\"\n    19\tfrom __future__ import annotations\n    20\t\n    21\timport argparse\n    22\timport json\n    23\timport sys\n    24\tfrom pathlib import Path\n    25\tfrom typing import Any\n    26\t\n    27\tfrom pyk.kast.inner import KApply, KInner, KSort, KToken\n    28\tfrom pyk.kast.prelude.kbool import boolToken\n    29\tfrom pyk.kast.prelude.kint import intToken\n    30\tfrom pyk.kast.prelude.string import stringToken\n    31\t\n    32\tBLS_SCALAR_MODULUS = 52435875175126190479447740508185965837690552500527637822603658699938581184513\n    33\t\n    34\tTYPE_SYMBOLS = {\n    35\t    'Scalar<BLS12-381>': 'Native',\n    36\t    'Bytes<32>': 'Bytes32',\n    37\t    'Point<Jubjub>': 'JubjubPoint',\n    38\t    'Scalar<Jubjub>': 'JubjubScalar',\n    39\t    'Point<Secp256k1>': 'Secp256k1Point',\n    40\t    'Base<Secp256k1>': 'Secp256k1Base',\n    41\t    'Scalar<Secp256k1>': 'Secp256k1Scalar',\n    42\t    'Point<Secp256r1>': 'Secp256r1Point',\n    43\t    'Base<Secp256r1>': 'Secp256r1Base',\n    44\t    'Scalar<Secp256r1>': 'Secp256r1Scalar',\n    45\t    'Point<Curve25519>': 'Curve25519Point',\n    46\t    'Base<Curve25519>': 'Curve25519Base',\n    47\t    'Scalar<Curve25519>': 'Curve25519Scalar',\n    48\t}\n    49\t\n    50\t\n    51\tclass ZkirFormatError(ValueError):\n    52\t    \"\"\"The JSON does not deserialize as ZKIR 3.0 (mirrors serde errors).\"\"\"\n    53\t\n    54\t\n    55\t# Surface selection: False = midnight-ledger 92e8bdd3 (34 instructions, 13 types);\n    56\t# True = midnight-zkir 2ffe2d1 (ZKIR-EXT: Bool, Byte, Bytes<n>, nine more instructions,\n    57\t# reverse_bytes removed).\n    58\tEXT = False\n    59\tEXT_TYPES = {'Bool': 'Bool', 'Byte': 'Byte'}\n    60\tEXT_OPS = {'and', 'or', 'xor', 'concat', 'slice', 'nth', 'reverse', 'load_constant', 'sha512'}\n    61\t\n    62\t\n    63\t# --- leaf builders -----------------------------------------------------------\n    64\t\n    65\tdef klist(cons: str, nil: str, items: list[KInner]) -> KInner:\n    66\t    term: KInner = KApply(nil)\n    67\t    for item in reversed(items):\n    68\t        term = KApply(cons, [item, term])\n    69\t    return term\n    70\t\n    71\t\n    72\tdef ir_type(name: Any) -> KInner:\n    73\t    if isinstance(name, str) and name in TYPE_SYMBOLS:\n    74\t        return KApply(TYPE_SYMBOLS[name])\n    75\t    if EXT and isinstance(name, str):\n    76\t        if name in EXT_TYPES:\n    77\t            return KApply(EXT_TYPES[name])\n    78\t        if name.startswith('Bytes<') and name.endswith('>') and name[6:-1].isdigit():\n    79\t            n = int(name[6:-1])\n    80\t            if 1 <= n <= (1 << 24):\n    81\t                return KApply('BytesN', [intToken(n)])\n    82\t    raise ZkirFormatError(f'unknown IR type {name!r}')\n    83\t\n    84\t\n    85\tdef immediate(text: str) -> int:\n    86\t    \"\"\"`Operand::deserialize` for hex immediates: little-endian bytes, optional\n    87\t    leading '-', value must be < r.\"\"\"\n    88\t    negate = text.startswith('-')\n    89\t    body = text[1:] if negate else text\n    90\t    if not (body.startswith('0x') or body.startswith('0X')):\n    91\t        raise ZkirFormatError(f'invalid operand format: {text!r}')\n    92\t    hex_str = body[2:]\n    93\t    if not hex_str:\n    94\t        raise ZkirFormatError(\"hex immediate must have at least one digit after '0x'\")\n    95\t    try:\n    96\t        raw = bytes.fromhex(hex_str)\n    97\t    except ValueError as e:\n    98\t        raise ZkirFormatError(f'invalid hex immediate {text!r}: {e}') from e\n    99\t    if len(raw) > 32:\n   100\t        raise ZkirFormatError(f'immediate {text!r} out of range for field element')\n   101\t    value = int.from_bytes(raw, 'little')\n   102\t    if value >= BLS_SCALAR_MODULUS:\n   103\t        raise ZkirFormatError(f'immediate {text!r} out of range for field element')\n   104\t    return (-value) % BLS_SCALAR_MODULUS if negate else value\n   105\t\n   106\t\n   107\tdef operand(text: Any) -> KInner:\n   108\t    if not isinstance(text, str):\n   109\t        raise ZkirFormatError(f'operand must be a string, got {text!r}')\n   110\t    body = text[1:] if text.startswith('-') else text\n   111\t    if body.startswith('0x') or body.startswith('0X'):\n   112\t        return KApply('imm', [intToken(immediate(text))])\n   113\t    if not text.startswith('%'):\n   114\t        raise ZkirFormatError(\n   115\t            f\"invalid operand format: {text!r}. Variables must start with '%', immediates must start with '0x'\"\n   116\t        )\n   117\t    return KApply('var', [stringToken(text)])\n   118\t\n   119\t\n   120\tdef operands(items: Any) -> KInner:\n   121\t    if not isinstance(items, list):\n   122\t        raise ZkirFormatError(f'expected a list of operands, got {items!r}')\n   123\t    return klist('operands', '.operands', [operand(x) for x in items])\n   124\t\n   125\t\n   126\tdef identifier(text: Any) -> KInner:\n   127\t    if not isinstance(text, str):\n   128\t        raise ZkirFormatError(f'identifier must be a string, got {text!r}')\n   129\t    return stringToken(text)\n   130\t\n   131\t\n   132\tdef identifiers(items: Any) -> KInner:\n   133\t    if not isinstance(items, list):\n   134\t        raise ZkirFormatError(f'expected a list of identifiers, got {items!r}')\n   135\t    return klist('ids', '.ids', [identifier(x) for x in items])\n   136\t\n   137\t\n   138\tdef pair(items: Any, what: str) -> tuple[Any, Any]:\n   139\t    if not isinstance(items, list) or len(items) != 2:\n   140\t        raise ZkirFormatError(f'{what} must be a pair, got {items!r}')\n   141\t    return items[0], items[1]\n   142\t\n   143\t\n   144\tdef u32(value: Any, what: str) -> KInner:\n   145\t    if not isinstance(value, int) or isinstance(value, bool) or value < 0 or value >= 2**32:\n   146\t        raise ZkirFormatError(f'{what} must be a u32, got {value!r}')\n   147\t    return intToken(value)\n   148\t\n   149\t\n   150\tdef guard(value: Any) -> KInner:\n   151\t    if value is None:\n   152\t        return KApply('noGuard')\n   153\t    return KApply('guard', [operand(value)])\n   154\t\n   155\t\n   156\tdef alignment(value: Any) -> KInner:\n   157\t    if not isinstance(value, list):\n   158\t        raise ZkirFormatError(f'alignment must be a list of segments, got {value!r}')\n   159\t    segs = []\n   160\t    for seg in value:\n   161\t        tag = seg.get('tag') if isinstance(seg, dict) else None\n   162\t        if tag == 'atom':\n   163\t            atom = seg.get('value')\n   164\t            atag = atom.get('tag') if isinstance(atom, dict) else None\n   165\t            if atag == 'field':\n   166\t                segs.append(KApply('atom', [KApply('fieldAtom')]))\n   167\t            elif atag == 'bytes':\n   168\t                segs.append(KApply('atom', [KApply('bytesAtom', [u32(atom.get('length'), 'bytes length')])]))\n   169\t            elif atag == 'compress':\n   170\t                segs.append(KApply('atom', [KApply('compressAtom')]))\n   171\t            else:\n   172\t                raise ZkirFormatError(f'unknown alignment atom {atom!r}')\n   173\t        elif tag == 'option':\n   174\t            alts = seg.get('value')\n   175\t            if not isinstance(alts, list):\n   176\t                raise ZkirFormatError(f'alignment option must carry a list, got {alts!r}')\n   177\t            segs.append(KApply('option', [klist('alignments', '.alignments', [alignment(a) for a in alts])]))\n   178\t        else:\n   179\t            raise ZkirFormatError(f'unknown alignment segment {seg!r}')\n   180\t    return KApply('alignment', [klist('segments', '.segments', segs)])\n   181\t\n   182\t\n   183\t# --- instructions ------------------------------------------------------------\n   184\t\n   185\tdef _need(ins: dict, *keys: str) -> None:\n   186\t    missing = [k for k in keys if k not in ins]\n   187\t    if missing:\n   188\t        raise ZkirFormatError(f\"{ins.get('op')}: missing field(s) {missing}\")\n   189\t    extra = sorted(set(ins) - set(keys) - {'op'})\n   190\t    if extra:\n   191\t        raise ZkirFormatError(f\"{ins.get('op')}: unknown field(s) {extra}\")\n   192\t\n   193\t\n   194\tdef instruction(ins: Any) -> KInner:\n   195\t    if not isinstance(ins, dict) or 'op' not in ins:\n   196\t        raise ZkirFormatError(f'instruction must be an object with \"op\", got {ins!r}')\n   197\t    op = ins['op']\n   198\t    match op:\n   199\t        case 'encode':\n   200\t            _need(ins, 'input', 'outputs')\n   201\t            return KApply('encode', [operand(ins['input']), identifiers(ins['outputs'])])\n   202\t        case 'assert':\n   203\t            _need(ins, 'cond')\n   204\t            return KApply('assert', [operand(ins['cond'])])\n   205\t        case 'cond_select':\n   206\t            _need(ins, 'bit', 'a', 'b', 'output')\n   207\t            return KApply('cond_select', [operand(ins['bit']), operand(ins['a']), operand(ins['b']), identifier(ins['output'])])\n   208\t        case 'constrain_bits':\n   209\t            _need(ins, 'val', 'bits')\n   210\t            return KApply('constrain_bits', [operand(ins['val']), u32(ins['bits'], 'bits')])\n   211\t        case 'constrain_eq':\n   212\t            _need(ins, 'a', 'b')\n   213\t            return KApply('constrain_eq', [operand(ins['a']), operand(ins['b'])])\n   214\t        case 'constrain_to_boolean':\n   215\t            _need(ins, 'val')\n   216\t            return KApply('constrain_to_boolean', [operand(ins['val'])])\n   217\t        case 'copy':\n   218\t            _need(ins, 'val', 'output')\n   219\t            return KApply('copy', [operand(ins['val']), identifier(ins['output'])])\n   220\t        case 'impact':\n   221\t            _need(ins, 'guard', 'inputs')\n   222\t            return KApply('impact', [operand(ins['guard']), operands(ins['inputs'])])\n   223\t        case 'ec_mul':\n   224\t            _need(ins, 'a', 'scalar', 'output')\n   225\t            return KApply('ec_mul', [operand(ins['a']), operand(ins['scalar']), identifier(ins['output'])])\n   226\t        case 'ec_mul_generator':\n   227\t            _need(ins, 'scalar', 'output')\n   228\t            return KApply('ec_mul_generator', [operand(ins['scalar']), identifier(ins['output'])])\n   229\t        case 'hash_to_curve':\n   230\t            _need(ins, 'inputs', 'output')\n   231\t            return KApply('hash_to_curve', [operands(ins['inputs']), identifier(ins['output'])])\n   232\t        case 'into_coordinates':\n   233\t            _need(ins, 'point', 'outputs')\n   234\t            x, y = pair(ins['outputs'], 'into_coordinates outputs')\n   235\t            return KApply('into_coordinates', [operand(ins['point']), identifier(x), identifier(y)])\n   236\t        case 'from_coordinates':\n   237\t            _need(ins, 'inputs', 'output')\n   238\t            x, y = pair(ins['inputs'], 'from_coordinates inputs')\n   239\t            return KApply('from_coordinates', [operand(x), operand(y), identifier(ins['output'])])\n   240\t        case 'into_bytes32':\n   241\t            _need(ins, 'input', 'output')\n   242\t            return KApply('into_bytes32', [operand(ins['input']), identifier(ins['output'])])\n   243\t        case 'from_bytes32':\n   244\t            _need(ins, 'bytes', 'type', 'output')\n   245\t            return KApply('from_bytes32', [operand(ins['bytes']), ir_type(ins['type']), identifier(ins['output'])])\n   282\t  syntax WfResult ::= #checkReads(Operands, Set) [function, total]\n   283\t  rule #checkReads(.Operands, _) => wfOk()\n   284\t  rule #checkReads((imm(V), Os), Defined) => #checkReads(Os, Defined)\n   285\t    requires V >=Int 0 andBool V <Int #blsScalarModulus\n   286\t  rule #checkReads((imm(V), _), _) => wfError(\"immediate out of field range: \" +String Int2String(V))\n   287\t    requires V <Int 0 orBool V >=Int #blsScalarModulus\n   288\t  rule #checkReads((var(X), Os), Defined) => #checkReads(Os, Defined)\n   289\t    requires X in Defined\n   290\t  rule #checkReads((var(X), _), Defined) => wfError(\"undefined variable \" +String X)\n   291\t    requires notBool (X in Defined)\n   292\t\n   293\t  syntax WfResult ::= #checkArity(Instr, Int) [function, total]\n   294\t  rule #checkArity(output(Vs), N) => wfError(\"output: signature declares \" +String Int2String(N) +String \" return values but instruction has \" +String Int2String(lenOperands(Vs)))\n   295\t    requires lenOperands(Vs) =/=Int N\n   296\t  rule #checkArity(divModPowerOfTwo(_, _, Os), _) => wfError(\"div_mod_power_of_two requires exactly 2 outputs\")\n   297\t    requires lenIds(Os) =/=Int 2\n   298\t  rule #checkArity(divModPowerOfTwo(_, B, _), _) => wfError(\"div_mod_power_of_two: excessive bit count\")\n   299\t    requires B >Int #frBytesStored *Int 8\n   300\t  rule #checkArity(reconstituteField(_, _, B, _), _) => wfError(\"reconstitute_field: excessive bit count\")\n   301\t    requires B >Int #frBytesStored *Int 8\n   302\t  rule #checkArity(constrainBits(_, B), _) => wfError(\"constrain_bits: excessive bit bound\")\n   303\t    requires B >=Int #frBits\n   304\t  rule #checkArity(lessThan(_, _, B, _), _) => wfError(\"less_than: excessive bit bound\")\n   305\t    requires B >=Int #frBits\n   306\t  rule #checkArity(_, _) => wfOk() [owise]\n   307\tendmodule\n","exit_code":0,"status":"completed"}}
