> #encode(resolve(X, M), Os) ... </k> <mem> M </mem> <status> ok() </status>\n   269\t  syntax KItem ::= #encode(ValueResult, Ids)\n   270\t  rule <k> #encode(vErr(S), _) => #fail(S) ... </k>\n   271\t  rule <k> #encode(vOk(V), Os) => #fail(\"Unexpected output length of encode instruction: \" +String tn(V)) ... </k>\n   272\t    requires size(encodeValue(V)) =/=Int lenIds(Os)\n   273\t  rule <k> #encode(vOk(V), Os) => #bindEncoded(Os, encodeValue(V)) ... </k>\n   274\t    requires size(encodeValue(V)) ==Int lenIds(Os)\n   275\t  syntax KItem ::= #bindEncoded(Ids, List)\n   276\t  rule <k> #bindEncoded(.Ids, _) => .K ... </k>\n   277\t  rule <k> #bindEncoded((O, Os), ListItem(X) L) => #bindEncoded(Os, L) ... </k> <mem> M => M[O <- native(X)] </mem>\n   278\t  rule <k> #bindEncoded((_, _), .List) => .K ... </k>\n   279\t\n   280\t  rule <k> #exec(intoCoordinates(P, X, Y)) => #put2(X, Y, #coords(resolve(P, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   281\t  syntax PairResult ::= #coords(ValueResult) [function, total]\n   282\t  rule #coords(vErr(S)) => pErr(S)\n   283\t  rule #coords(vOk(V)) => intoCoordinatesV(V)\n   284\t\n   285\t  rule <k> #exec(bytes32IntoLowHigh(B, L, H)) => #put2(L, H, #lowHigh(resolve(B, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   286\t  syntax PairResult ::= #lowHigh(ValueResult) [function, total]\n   287\t  rule #lowHigh(vErr(S)) => pErr(S)\n   288\t  rule #lowHigh(vOk(V)) => #lowHigh2(asBytes32(V))\n   289\t  syntax PairResult ::= #lowHigh2(BytesResult) [function, total]\n   290\t  rule #lowHigh2(bErr(S)) => pErr(S)\n   291\t  rule #lowHigh2(bOk(B)) => bytes32IntoLowHighV(B)\n   292\t\n   293\t  rule <k> #exec(fromBytes32(B, T, O)) => #put(O, #fromB32(resolve(B, M), T)) ... </k> <mem> M </mem> <status> ok() </status>\n   294\t  syntax ValueResult ::= #fromB32(ValueResult, IrType) [function, total]\n   295\t  rule #fromB32(vErr(S), _) => vErr(S)\n   296\t  rule #fromB32(vOk(V), T) => #fromB32b(asBytes32(V), T)\n   297