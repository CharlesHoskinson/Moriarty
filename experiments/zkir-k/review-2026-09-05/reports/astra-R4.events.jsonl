(B) modInt #p256P))\n   172\t  rule fromBytes32V(secp256r1Scalar(), B) => vOk(secp256r1Scalar(bytes32ToInt(B) modInt #p256N))\n   173\t  rule fromBytes32V(curve25519Base(), B)  => vOk(curve25519Base(bytes32ToInt(B) modInt #c25519P))\n   174\t  rule fromBytes32V(curve25519Scalar(), B)=> vOk(curve25519Scalar(bytes32ToInt(B) modInt #c25519L))\n   175\t  rule fromBytes32V(T, _) => vErr(\"Unsupported from_bytes32 for type \" +String typeName(T)) [owise]\n   176\t\n   177\t  // bytes32_into_low_high: low = first 31 bytes as a native element, high = byte 31\n   178\t  syntax PairResult ::= bytes32IntoLowHighV(Bytes) [function, total]\n   179\t  rule bytes32IntoLowHighV(B) => pOk(native(Bytes2Int(substrBytes(B, 0, 31), LE, Unsigned) modInt #r), native(B[31]))\n   180\t\n   181\t  // bytes32_from_low_high: both operands must be native; low < 2^248, high < 256\n   182\t  syntax ValueResult ::= bytes32FromLowHighV(Value, Value) [function, total]\n   183\t  rule bytes32FromLowHighV(native(L), native(H)) => vOk(bytes32(replaceAtBytes(intToBytes32(L), 31, Int2Bytes(1, H, LE))))\n   184\t    requires fitsBits(L, 248) andBool fitsBits(H, 8)\n   185\t  rule bytes32FromLowHighV(native(L), native(H)) => vErr(\"Bytes32FromLowHigh: low operand must fit in 31 bytes (be less than 2^248) and high operand must fit in a single byte (be less than 256)\")\n   186\t    requires notBool (fitsBits(L, 248) andBool fitsBits(H, 8))\n   187\t  // Rust: into_bytes32_offcircuit on each operand first, so non-field operands fail there\n   188\t  rule bytes32FromLowHighV(A, B) => #lowHighErr(intoBytes32V(A), intoBytes32V(B)) [owise]\n   189\t  syntax ValueResult ::= #lowHighErr(ValueResult, ValueResult) [function, total]\n   190\t  rule #lowHighErr(vErr(S), _) => vErr(S)\n   191\t  rule #lowHighErr(vOk(_), vErr(S)) => vErr(S)\n   192\t  rule #lowHighErr(vOk(bytes32(BL)), vOk(bytes32(BH))) => vOk(bytes32(replaceAtBytes(BL, 31, substrBytes(BH, 0, 1))))\n   193\t    requires BL[31] ==Int 0 andBool Bytes2Int(substrBytes(BH, 1, 32), LE, Unsigned) ==Int 0\n   194\t  rule #lowHighErr(vOk(_), vOk(_)) => vErr(\"Bytes32FromLowHigh: low operand must fit in 31 bytes (be less than 2^248) and high operand must fit in a single byte (be less than 256)\") [owise]\n   195\t\n   196\t  // --- hashes --------------------------------------------------------------------------\n   197\t  // All inputs of transient_hash / hash_to_curve must be Native.\n   198\t  syntax IntsResult ::= isOk(List) | isErr(String)\n   199\t  syntax IntsResult ::= asNatives(List) [function, total]\n   200\t  rule asNatives(.List) => isOk(.List)\n   201\t  rule asNatives(ListItem(V) Vs) => #consNative(asNative(V), asNatives(Vs))\n   202\t  syntax IntsResult ::= #consNative(IntResult, IntsResult) [function, total]\n   203\t  rule #consNative(iErr(S), _) => isErr(S)\n   204\t  rule #consNative(iOk(_), isErr(S)) => isErr(S)\n   205\t  rule #consNative(iOk(X), isOk(L)) => isOk(ListItem(X) L)\n   206\t\n   207\t  // persistent_hash / keccak256 preimage: parse the field elements by the\n   208\t  // alignment (transient-crypto AlignmentAtomExt::parse_field_repr) and lay\n   209\t  // the atoms out as bytes (ValueAtomExt::binary_repr_unchecked). Only atom\n   210\t  // segments are supported; `option` segments and `compress` atoms are\n   211\t  // reported as unsupported.\n   212\t  syntax BytesResult ::= alignedBytes(Alignment, List) [function, total]\n   213\t  rule alignedBytes(alignment(Segs), Fs) => #alignedBytes(Segs, Fs, .Bytes)\n   214\t  syntax BytesResult ::= #alignedBytes(Segments, List, Bytes) [function, total]\n   215\t  rule #alignedBytes(.Segments, .List, Acc) => bOk(Acc)\n   216\t  rule #alignedBytes(.Segments, Fs, _) => bErr(\"Inputs did not match alignment\") requires size(Fs) >Int 0\n   217\t  rule #alignedBytes((atom(fieldAtom()), Segs), ListItem(F) Fs, Acc) => #alignedBytes(Segs, Fs, Acc +Bytes Int2Bytes(32, F, LE))\n   218\t  rule #alignedBytes((atom(fieldAtom()), _), .List, _) => bErr(\"Inputs did not match alignment\")\n   219\t  rule #alignedBytes((atom(bytesAtom(N)), Segs), Fs, Acc) => #alignedBytesAtom(N, Segs, Fs, Acc, bytesFromFieldRepr(Fs, N))\n   220\t  rule #alignedBytes((atom(compressAtom()), _), _, _) => bErr(\"Inputs did not match alignment\")   // Compress atoms cannot be parsed from field elements\n   221\t  rule #alignedBytes((option(_), _), _, _) => bErr(\"unsupported: alignment option segment\")\n   222\t  syntax BytesResult ::= #alignedBytesAtom(Int, Segments, List, Bytes, BytesResult) [function, total]\n   223\t  rule #alignedBytesAtom(_, _, _, _, bErr(S)) => bErr(S)\n   224\t  rule #alignedBytesAtom(N, Segs, Fs, Acc, bOk(B)) => #alignedBytes(Segs, range(Fs, (N +Int 30) /Int 31, 0), Acc +Bytes B)\n   225\t\n   226\t  // bytes_from_field_repr(repr, n): stray = n mod 31 bytes come first (from\n   227\t  // repr[0]), then the 31-byte chunks in reverse order of the elements.\n   228\t  syntax BytesResult ::= bytesFromFieldRepr(List, Int) [function, total]\n   229\t  rule bytesFromFieldRepr(Fs, N) => bErr(\"Inputs did not match alignment\") requires size(Fs) <Int (N +Int 30) /Int 31\n   230\t  rule bytesFromFieldRepr(Fs, N) => #bffr(Fs, N, N modInt 31, N /Int 31) requires size(Fs) >=Int (N +Int 30) /Int 31\n   231\t  syntax BytesResult ::= #bffr(List, Int, Int, Int) [function, total]   // (fields, n, stray, chunks)\n   232\t  rule #bffr(Fs, N, 0, Chunks) => #bffrChunks(Fs, Chunks, 0, .Bytes)\n   233\t  rule #bffr(ListItem(F) Fs, N, Stray, Chunks) => #bffrStray(#bffrChunks(Fs, Chunks, 0, .Bytes), F, Stray)\n   234\t    requires Stray >Int 0 andBool fitsBits(F, 8 *Int Stray)\n   235\t  rule #bffr(ListItem(F) _, _, Stray, _) => bErr(\"Inputs did not match alignment\")\n   236\t    requires Stray >Int 0 andBool notBool fitsBits(F, 8 *Int Stray)\n   237\t  rule #bffr(.List, _, Stray, _) => bErr(\"Inputs did not match alignment\") requires Stray >Int 0\n   238\t  syntax BytesResult ::= #bffrStray(BytesResult, Int, Int) [function, total]\n   239\t  rule #bffrStray(bErr(S), _, _) => bErr(S)\n   240\t  rule #bffrStray(bOk(B), F, Stray) => bOk(B +Bytes Int2Bytes(Stray, F, LE))\n   241\t  // chunk i takes fields[chunks - 1 - i]\n   242\t  syntax BytesResult ::= #bffrChunks(List, Int, Int, Bytes) [function, total]\n   243\t  rule #bffrChunks(_, Chunks, I, Acc) => bOk(Acc) requires I >=Int Chunks\n   244\t  rule #bffrChunks(Fs, Chunks, I, Acc) => #bffrChunks(Fs, Chunks, I +Int 1, Acc +Bytes Int2Bytes(31, {Fs[Chunks -Int 1 -Int I]}:>Int, LE))\n   245\t    requires I <Int Chunks andBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   246\t  rule #bffrChunks(Fs, Chunks, I, _) => bErr(\"Inputs did not match alignment\")\n   247\t    requires I <Int Chunks andBool notBool fitsBits({Fs[Chunks -Int 1 -Int I]}:>Int, 248)\n   248\t\n   249\t  // --- bits ---------------------------------------------------------------------------\n   250\t  // resolve_operand_bits with a bound: value must be Native and fit in N bits;\n   251\t  // N >= FR_BITS is \"Excessive bit bound\".\n   252\t  syntax CheckResult ::= checkBits(Value, Int) [function, total]\n   253\t  rule checkBits(_, N) => cErr(\"Excessive bit bound\") requires N >=Int #frBits\n   254\t  rule checkBits(native(V), N) => cOk() requires N <Int #frBits andBool fitsBits(V, N)\n   255\t  rule checkBits(native(V), N) => cErr(\"Bit bound failed: \" +String Int2String(V) +String \" is not \" +String Int2String(N) +String \"-bit\")\n   256\t    requires N <Int #frBits andBool notBool fitsBits(V, N)\n   257\t  rule checkBits(V, N) => cErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires N <Int #frBits andBool notBool isNative(V)\n   258\t  syntax Bool ::= isNative(Value) [function, total]\n   259\t  rule isNative(native(_)) => true\n   260\t  rule isNative(_) => false [owise]\n   261\t\n   262\t  // resolve_operand_bool: Native 0 or 1\n   263\t  syntax BoolResult ::= boolOk(Bool) | boolErr(String)\n   264\t  syntax BoolResult ::= asBool(Value) [function, total]\n   265\t  rule asBool(native(0)) => boolOk(false)\n   266\t  rule asBool(native(1)) => boolOk(true)\n   267\t  rule asBool(native(V)) => boolErr(\"Expected boolean, found: \" +String Int2String(V)) requires V =/=Int 0 andBool V =/=Int 1\n   268\t  rule asBool(V) => boolErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires notBool isNative(V)\n   269\tendmodule\n   290\t  syntax Outcome ::= #coordsMatch(ValueResult, String, String, Map) [function, total]\n   291\t  rule #coordsMatch(vOk(secp256k1Point(inf())), _, _, _) => violated(\"into_coordinates of the identity is unsatisfiable\")\n   292\t  rule #coordsMatch(vOk(secp256r1Point(inf())), _, _, _) => violated(\"into_coordinates of the identity is unsatisfiable\")\n   293\t  rule #coordsMatch(vOk(V), X, Y, M) => #pairMatch(intoCoordinatesV(V), X, Y, M) [owise]\n   294\t  rule #coordsMatch(vErr(S), _, _, _) => unknown(S)\n   295\t  syntax Outcome ::= #pairMatch(PairResult, String, String, Map) [function, total]\n   296\t  rule #pairMatch(pErr(S), _, _, _) => synthErr(S)\n   297\t  rule #pairMatch(pOk(A, B), X, Y, M) => #and(#matches(vOk(A), rdId(X, M), \"first output\"), #matches(vOk(B), rdId(Y, M), \"second output\"))\n   298\t\n   299\t  // from_coordinates in circuit: point_from_coordinates constrains the exact\n   300\t  // (x, y) to lie on the curve; the off-circuit Jubjub path goes through\n   301\t  // decompression instead (only the parity of x is used)\n   302\t  rule eval(gate(fromCoordinates(X, Y, O)), M, _, Chips) => #and(#need(rd(X, M)), #and(#need(rd(Y, M)), #and(#chipsForValues(#vals(rd(X, M), rd(Y, M)), Chips),\n   303\t      #fromCoordsGate(rd(X, M), rd(Y, M), rdId(O, M)))))\n   304\t  // curve and type dispatch of point_from_coordinates: the exact (x, y) must lie\n   305\t  // on the curve and (after cofactor clearing) in the prime-order subgroup\n   306\t  syntax Outcome ::= #fromCoordsGate(ValueResult, ValueResult, ValueResult) [function, total]\n   307\t  rule #fromCoordsGate(vOk(native(X)), vOk(native(Y)), O) => #fromCoordsPt(fromXY(#jubjub, X, Y), #jubjub, jubjubPoint(), O)\n   308\t  rule #fromCoordsGate(vOk(secp256k1Base(X)), vOk(secp256k1Base(Y)), O) => #fromCoordsPt(fromXY(#secp256k1, X, Y), #secp256k1, secp256k1Point(), O)\n   309\t  rule #fromCoordsGate(vOk(secp256r1Base(X)), vOk(secp256r1Base(Y)), O) => #fromCoordsPt(fromXY(#secp256r1, X, Y), #secp256r1, secp256r1Point(), O)\n   310\t  rule #fromCoordsGate(vOk(curve25519Base(X)), vOk(curve25519Base(Y)), O) => #fromCoordsPt(fromXY(#curve25519, X, Y), #curve25519, curve25519Point(), O)\n   311\t  rule #fromCoordsGate(vOk(A), vOk(B), _) => synthErr(\"Unsupported `from_coordinates` on (\" +String tn(A) +String \", \" +String tn(B) +String \")\") [owise]\n   312\t  rule #fromCoordsGate(vErr(S), _, _) => unknown(S)\n   313\t  rule #fromCoordsGate(vOk(_), vErr(S), _) => unknown(S)\n   314\t  syntax Outcome ::= #fromCoordsPt(PointResult, Curve, IrType, ValueResult) [function, total]\n   315\t  rule #fromCoordsPt(ptErr(_), _, _, _) => violated(\"from_coordinates: (x, y) is not on the curve\")\n   316\t  rule #fromCoordsPt(ptOk(Q), C, _, _) => violated(\"from_coordinates: point is not in the prime-order subgroup\") requires notBool inSubgroup(C, Q)\n   317\t  rule #fromCoordsPt(ptOk(Q), C, T, O) => #matches(vOk(#wrapPoint(Q, T)), O, \"from_coordinates output\") requires inSubgroup(C, Q)\n   318\t\n   319\t  // bytes\n   320\t  rule eval(gate(intoBytes32(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"into_bytes32\"), rdId(O, M), \"into_bytes32 output\")))\n   321\t  rule eval(gate(fromBytes32(B, T, O)), M, _, Chips) => #and(#need(rd(B, M)), #and(#chipFor(T, Chips), #matches(#fromB32c(rd(B, M), T), rdId(O, M), \"from_bytes32 output\")))\n   322\t  syntax ValueResult ::= #fromB32c(ValueResult, IrType) [function, total]\n   323\t  rule #fromB32c(vOk(bytes32(B)), T) => fromBytes32V(T, B)\n   324\t  rule #fromB32c(vOk(V), _) => vErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   325\t  rule #fromB32c(vErr(S), _) => vErr(S)\n   326\t  rule eval(gate(reverseBytes(B, O)), M, _, _) => #and(#need(rd(B, M)), #matches(#revOf(rd(B, M)), rdId(O, M), \"reverse_bytes output\"))\n   327\t  syntax ValueResult ::= #revOf(ValueResult) [function, total]\n   328\t  rule #revOf(vOk(bytes32(B))) => vOk(bytes32(reverseBytes(B)))\n   329\t  rule #revOf(vOk(V)) => vErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   330\t  rule #revOf(vErr(S)) => vErr(S)\n   331\t  rule eval(gate(bytes32IntoLowHigh(B, L, H)), M, _, _) => #and(#need(rd(B, M)), #lowHighMatch(rd(B, M), L, H, M))\n   332\t  syntax Outcome ::= #lowHighMatch(ValueResult, String, String, Map) [function, total]\n   333\t  rule #lowHighMatch(vOk(bytes32(B)), L, H, M) => #pairMatch(bytes32IntoLowHighV(B), L, H, M)\n   334\t  rule #lowHighMatch(vOk(V), _, _, _) => synthErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n   335\t  rule #lowHighMatch(vErr(S), _, _, _) => unknown(S)\n   336\t  // bytes32_from_low_high: high must be Native in circuit, low may be any\n   337\t  // field element (finding 8); low's byte 31 must be zero\n   338\t  rule eval(gate(bytes32FromLowHigh(L, H, O)), M, _, _) => #and(#need(rd(L, M)), #and(#native(rd(H, M), \"bytes32_from_low_high high\"),\n   339\t      #matches(#bin2(rd(L, M), rd(H, M), \"bytes32_from_low_high\"), rdId(O, M), \"bytes32_from_low_high output\")))\n   340\t  syntax ValueResult ::= #lowHighInCircuit(Value, Value) [function, total]\n   341\t  rule #lowHighInCircuit(L, native(H)) => #lowHighIC2(intoBytes32V(L), H)\n   342\t  rule #lowHighInCircuit(_, H) => vErr(\"cannot convert \" +String tn(H) +String \" to Native\") [owise]\n   343\t  syntax ValueResult ::= #lowHighIC2(ValueResult, Int) [function, total]\n   344\t  rule #lowHighIC2(vErr(S), _) => vErr(S)\n   345\t  rule #lowHighIC2(vOk(bytes32(BL)), H) => vOk(bytes32(replaceAtBytes(BL, 31, Int2Bytes(1, H, LE)))) requires BL[31] ==Int 0 andBool fitsBits(H, 8)\n   346\t  rule #lowHighIC2(vOk(bytes32(BL)), _) => vErr(\"low operand uses byte 31\") requires BL[31] =/=Int 0\n   347\t  rule #lowHighIC2(vOk(bytes32(_)), H) => vErr(\"high operand is not a byte\") requires notBool fitsBits(H, 8)\n   348\t  rule #lowHighIC2(vOk(_), _) => vErr(\"not bytes\") [owise]\n   349\t\n   350\t  // hashes\n   351\t  rule eval(gate(transientHash(Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"poseidon\", Chips), #matches(#th3(#natives(Xs, M)), rdId(O, M), \"transient_hash output\")))\n   352\t  rule eval(gate(hashToCurve(Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"poseidon\", Chips), #and(#chipNamed(\"jubjub\", Chips), #matches(#htc3(#natives(Xs, M)), rdId(O, M), \"hash_to_curve output\"))))\n   353\t  rule eval(gate(persistentHash(Al, Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"sha2_256\", Chips), #matches(#std3(#natives(Xs, M), Al, \"sha256\"), rdId(O, M), \"persistent_hash output\")))\n   354\t  rule eval(gate(keccak256(Al, Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"keccak_256\", Chips), #matches(#std3(#natives(Xs, M), Al, \"keccak256\"), rdId(O, M), \"keccak256 output\")))\n   355\t  syntax Outcome ::= #chipNamed(String, Set) [function, total]\n   356\t  rule #chipNamed(N, Chips) => holds() requires N in Chips\n   357\t  rule #chipNamed(N, Chips) => synthErr(\"chip not initialised: \" +String N) requires notBool (N in Chips)\n   358\t  syntax Outcome ::= #needAll(Operands, Map) [function, total]\n   359\t  rule #needAll(.Operands, _) => holds()\n   360\t  rule #needAll((X, Xs), M) => #and(#native(rd(X, M), \"hash input\"), #needAll(Xs, M))\n   361\t  syntax IntsResult ::= #natives(Operands, Map) [function, total]\n   362\t  rule #natives(.Operands, _) => isOk(.List)\n   363\t  rule #natives((X, Xs), M) => #consNat(rd(X, M), #natives(Xs, M))\n   364\t  syntax IntsResult ::= #consNat(ValueResult, IntsResult) [function, total]\n   365\t  rule #consNat(vOk(native(X)), isOk(L)) => isOk(ListItem(X) L)\n   366\t  rule #consNat(vOk(V), _) => isErr(\"cannot convert \" +String tn(V) +String \" to Native\") requires notBool isNative(V)\n   367\t  rule #consNat(vErr(S), _) => isErr(S)\n   368\t  rule #consNat(_, isErr(S)) => isErr(S) [owise]\n   369\t  syntax ValueResult ::= #th3(IntsResult) [function, total]\n   370\t  rule #th3(isErr(S)) => vErr(S)\n   371\t  rule #th3(isOk(L)) => vOk(native(poseidonHash(L)))\n   372\t  syntax ValueResult ::= #htc3(IntsResult) [function, total]\n   373\t  rule #htc3(isErr(S)) => vErr(S)\n   374\t  rule #htc3(isOk(L)) => vOk(jubjubPoint(hashToCurve(L)))\n   375\t  syntax ValueResult ::= #std3(IntsResult, Alignment, String) [function, total]\n   376\t  rule #std3(isErr(S), _, _) => vErr(S)\n   377\t  rule #std3(isOk(L), Al, H) => #std4(alignedBytes(Al, L), H)\n   378\t  syntax ValueResult ::= #std4(BytesResult, String) [function, total]\n   379\t  rule #std4(bErr(S), _) => vErr(S)\n   380\t  rule #std4(bOk(B), \"sha256\") => vOk(bytes32(sha256Bytes(B)))\n   381\t  rule #std4(bOk(B), _) => vOk(bytes32(keccak256Bytes(B))) [owise]\n   382\t\n   383\t  // output: the signature types are checked at synthesis\n   384\t  rule eval(gate(output(_)), _, _, _) => holds()\n   385\t  rule eval(gate(_), _, _, _) => holds() [owise]\n   386\tendmodule\n   206\t  rule #bin(vOk(A), vOk(B), \"ec_mul\") => ecMulV(A, B)\n   207\t  rule #bin(vOk(A), vOk(B), \"from_coordinates\") => fromCoordinatesV(A, B)\n   208\t  rule #bin(vOk(A), vOk(B), \"bytes32_from_low_high\") => bytes32FromLowHighV(A, B)\n   209\t  rule #bin(vOk(_), vOk(_), Op) => vErr(\"unknown binary op \" +String Op) [owise]\n   210\t\n   211\t  rule <k> #exec(neg(A, O)) => #put(O, #un(resolve(A, M), \"neg\")) ... </k> <mem> M </mem> <status> ok() </status>\n   212\t  rule <k> #exec(inv(A, O)) => #put(O, #un(resolve(A, M), \"inv\")) ... </k> <mem> M </mem> <status> ok() </stat