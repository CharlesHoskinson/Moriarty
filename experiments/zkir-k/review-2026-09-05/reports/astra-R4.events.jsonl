  269\t                raise ZkirFormatError('load_constant encoding must be a list of hex immediates')\n   270\t            enc = klist('operands', '.operands', [KApply('imm', [intToken(immediate(e))]) for e in ins['encoding']])\n   271\t            return KApply('load_constant', [ir_type(ins['type']), enc, identifier(ins['output'])])\n   272\t        case 'sha512' if EXT:\n   273\t            _need(ins, 'alignment', 'inputs', 'output')\n   274\t            return KApply('sha512', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   275\t        case 'bytes32_into_low_high':\n   276\t            _need(ins, 'bytes', 'outputs')\n   277\t            lo, hi = pair(ins['outputs'], 'bytes32_into_low_high outputs')\n   278\t            return KApply('bytes32_into_low_high', [operand(ins['bytes']), identifier(lo), identifier(hi)])\n   279\t        case 'bytes32_from_low_high':\n   280\t            _need(ins, 'inputs', 'output')\n   281\t            lo, hi = pair(ins['inputs'], 'bytes32_from_low_high inputs')\n   282\t            return KApply('bytes32_from_low_high', [operand(lo), operand(hi), identifier(ins['output'])])\n   283\t        case 'div_mod_power_of_two':\n   284\t            _need(ins, 'val', 'bits', 'outputs')\n   285\t            return KApply('div_mod_power_of_two', [operand(ins['val']), u32(ins['bits'], 'bits'), identifiers(ins['outputs'])])\n   286\t        case 'reconstitute_field':\n   287\t            _need(ins, 'divisor', 'modulus', 'bits', 'output')\n   288\t            return KApply('reconstitute_field', [operand(ins['divisor']), operand(ins['modulus']), u32(ins['bits'], 'bits'), identifier(ins['output'])])\n   289\t        case 'transient_hash':\n   290\t            _need(ins, 'inputs', 'output')\n   291\t            return KApply('transient_hash', [operands(ins['inputs']), identifier(ins['output'])])\n   292\t        case 'persistent_hash':\n   293\t            _need(ins, 'alignment', 'inputs', 'output')\n   294\t            return KApply('persistent_hash', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   295\t        case 'keccak256':\n   296\t            _need(ins, 'alignment', 'inputs', 'output')\n   297\t            return KApply('keccak256', [alignment(ins['alignment']), operands(ins['inputs']), identifier(ins['output'])])\n   298\t        case 'test_eq':\n   299\t            _need(ins, 'a', 'b', 'output')\n   300\t            return KApply('test_eq', [operand(ins['a']), operand(ins['b']), identifier(ins['output'])])\n   301\t        case 'add' | 'mul':\n   302\t            _need(ins, 'a', 'b', 'output')\n   303\t            return KApply(op, [operand(ins['a']), operand(ins['b']), identifier(ins['output'])])\n   304\t        case 'neg' | 'inv' | 'not':\n   305\t            _need(ins, 'a', 'output')\n   306\t            return KApply(op, [operand(ins['a']), identifier(ins['output'])])\n   307\t        case 'less_than':\n   308\t            _need(ins, 'a', 'b', 'bits', 'output')\n   309\t            return KApply('less_than', [operand(ins['a']), operand(ins['b']), u32(ins['bits'], 'bits'), identifier(ins['output'])])\n   310\t        case 'jubjub_scalar_from_native':\n   311\t            _need(ins, 'native', 'output')\n   312\t            return KApply('jubjub_scalar_from_native', [operand(ins['native']), identifier(ins['output'])])\n   313\t        case 'public_input' | 'private_input':\n   314\t            _need(ins, 'guard', 'type', 'output')\n   315\t            return KApply(op, [guard(ins['guard']), ir_type(ins['type']), identifier(ins['output'])])\n   316\t        case 'output':\n   317\t            _need(ins, 'vals')\n   318\t            return KApply('output', [operands(ins['vals'])])\n   319\t        case _:\n   320\t            raise ZkirFormatError(f'unknown instruction op {op!r}')\n   321\t\n   322\t\n   323\t# --- program -------------------------------------------------------------------\n   324\t\n   325\tdef program(doc: Any) -> KInner:\n   326\t    \"\"\"`IrSource::load`: version {major: 3, minor: 0..=0}, then serde fields.\"\"\"\n   327\t    if not isinstance(doc, dict):\n   328\t        raise ZkirFormatError('expected a JSON object')\n   329\t    version = doc.get('version')\n   330\t    if not isinstance(version, dict) or 'major' not in version or 'minor' not in version:\n   331\t        raise ZkirFormatError('expected a version entry')\n   332\t    if version['major'] != 3 or not (0 <= version['minor'] <= 0):\n   333\t        raise ZkirFormatError(f\"unhandled version: {version['major']}.{version['minor']}\")\n   334\t    for key in ('inputs', 'outputs', 'do_communications_commitment', 'instructions'):\n   335\t        if key not in doc:\n   336\t            raise ZkirFormatError(f'missing field {key!r}')\n   337\t    inputs = []\n   338\t    for entry in doc['inputs']:\n   339\t        if not isinstance(entry, dict) or set(entry) != {'name', 'type'}:\n   340\t            raise ZkirFormatError(f'input must have name and type, got {entry!r}')\n   341\t        inputs.append(KApply('typedId', [identifier(entry['name']), ir_type(entry['type'])]))\n   342\t    outputs = [ir_type(t) for t in doc['outputs']]\n   343\t    if not isinstance(doc['do_communications_commitment'], bool):\n   344\t        raise ZkirFormatError('do_communications_commitment must be a boolean')\n   345\t    instrs = [instruction(i) for i in doc['instructions']]\n   346\t    return KApply('program', [\n   347\t        intToken(version['minor']),\n   348\t        klist('typedIds', '.typedIds', inputs),\n   349\t        klist('irTypes', '.irTypes', outputs),\n   350\t        boolToken(doc['do_communications_commitment']),\n   351\t        klist('instrs', '.instrs', instrs),\n   352\t    ])\n   353\t\n   354\t\n   355\tdef load_program(path: Path, ext: bool | None = None) -> KInner:\n   356\t    global EXT\n   357\t    if ext is not None:\n   358\t        EXT = ext\n   359\t    with open(path) as f:\n   360\t        return program(json.load(f))\n   361\t\n   362\t\n   363\t# --- CLI ------------------------------------------------------------------------\n   364\t\n   365\tdef default_definition() -> Path:\n   366\t    return Path(__file__).resolve().parent.parent / 'semantics' / 'zkir-check-kompiled'\n   367\t\n   368\t\n   369\tdef wf_result(pretty: str) -> str:\n   370\t    if 'wfOk ( )' in pretty:\n   371\t        return 'wfOk'\n   372\t    start = pretty.find('wfError (')\n   373\t    if start >= 0:\n   374\t        end = pretty.find(')', start)\n   375\t        return pretty[start:end + 1].replace('\\n', ' ')\n   376\t    return 'unexpected: ' + pretty.replace('\\n', ' ')[:200]\n   377\t\n   378\t\n   379\tdef main(argv: list[str] | None = None) -> int:\n   380\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   381\t    ap.add_argument('command', choices=['kore', 'kast', 'check'])\n   382\t    ap.add_argument('file', type=Path)\n   383\t    ap.add_argument('--definition', type=Path, default=None)\n   384\t    ap.add_argument('--ext', action='store_true', help='accept the midnight-zkir 2ffe2d1 surface (ZKIR-EXT)')\n   385\t    args = ap.parse_args(argv)\n   386\t    try:\n   387\t        term = load_program(args.file, ext=args.ext)\n   388\t    except ZkirFormatError as e:\n   389\t        print(f'format error: {e}', file=sys.stderr)\n   390\t        return 2\n   391\t    if args.command == 'kast':\n   392\t        print(json.dumps(term.to_dict()))\n   393\t        return 0\n   394\t    from pyk.ktool.krun import KRun\n   395\t    krun = KRun(args.definition or default_definition())\n   396\t    kore = krun.kast_to_kore(term, KSort('Program'))\n   397\t    if args.command == 'kore':\n   398\t        print(kore.text)\n   399\t        return 0\n   400\t    from pyk.kore.parser import KoreParser\n   401\t    res = krun.run_process(kore)\n   402\t    if res.returncode not in (0,):\n   403\t        print(res.stderr, file=sys.stderr)\n   404\t        return res.returncode\n   405\t    out = krun.pretty_print(krun.kore_to_kast(KoreParser(res.stdout).pattern()))\n   406\t    print(wf_result(out))\n   407\t    return 0\n   408\t\n   409\t\n   410\tif __name__ == '__main__':\n   411\t    sys.exit(main())\n     1\t\"\"\"Milestone 2 test: every ZKIR v3 program in the corpus parses and is well formed.\n     2\t\n     3\tFor each program: build the Program term with zkir_kast.py, run ZKIR-CHECK, and\n     4\tcompare the outcome with the expectation table below (default: wfOk). Programs\n     5\twhose expected outcome is a format error never reach K; that mirrors\n     6\t`IrSource::load` rejecting them before `preprocess`.\n     7\t\n     8\tUsage: uv run --group zkir-k python experiments/zkir-k/tools/check_corpus.py [--definition DIR]\n     9\tExit status 0 iff every program matches its expectation.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport argparse\n    14\timport json\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tfrom pyk.kast.inner import KSort\n    20\tfrom pyk.kore.parser import KoreParser\n    21\tfrom pyk.ktool.krun import KRun\n    22\t\n    23\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    24\timport zkir_kast  # noqa: E402\n    25\t\n    26\tHERE = Path(__file__).resolve().parent\n    27\tROOT = HERE.parent  # experiments/zkir-k\n    28\tREPO = ROOT.parent.parent\n    29\t\n    30\tCORPORA = {\n    31\t    'ledger9-92e8bdd3-tests': ROOT / 'corpus' / 'ledger9-92e8bdd3-tests',\n    32\t    'midnight-zkir-2ffe2d1-precompiles': ROOT / 'corpus' / 'midnight-zkir-2ffe2d1-precompiles',\n    33\t    'moriarty-compact-escrow': REPO / 'experiments' / 'moriarty-compact-escrow' / 'output' / 'zkir',\n    34\t    'moriarty-core-swap': REPO / 'experiments' / 'moriarty-core-swap' / 'output' / 'zkir',\n    35\t    'handmade-negative': ROOT / 'corpus' / 'handmade-negative',\n    36\t}\n    37\t\n    38\t# Expected outcome when it is not wfOk. 'format' = rejected by the preprocessor\n    39\t# (serde-level), 'wfError:<substring>' = static check fails with that message.\n    40\tEXPECTED = {\n    41\t    'output_arity_mismatch.zkir': 'wfError:signature declares 1 return values but instruction has 2',\n    42\t    # The type mismatch is dynamic (runtime types); statically the program is fine.\n    43\t    'output_operand_type_mismatch.zkir': 'wfOk',\n    44\t    'test_invalid_operand_no_percent_prefix.zkir': 'format',\n    45\t    'test_invalid_operand_malformed_identifier.zkir': 'format',\n    46\t    'test_invalid_operand_odd_length_hex.zkir': 'format',\n    47\t    # handmade negatives (corpus/handmade-negative)\n    48\t    'reassignment.zkir': 'wfError:reassignment of %b',\n    49\t    'undefined_variable.zkir': 'wfError:undefined variable %c',\n    50\t    'duplicate_input.zkir': 'wfError:duplicate input %a',\n    51\t    'excessive_bits.zkir': 'wfError:constrain_bits: excessive bit bound',\n    52\t    'immediate_out_of_range.zkir': 'format',\n    53\t    'divmod_outputs.zkir': 'wfError:div_mod_power_of_two requires exactly 2 outputs',\n    54\t    'wrong_version.zkir': 'format',\n    55\t}\n    56\t\n    57\t\n    58\tdef outcome(krun: KRun, path: Path) -> str:\n    59\t    try:\n    60\t        term = zkir_kast.load_program(path)\n    61\t    except zkir_kast.ZkirFormatError as e:\n    62\t        return f'format: {e}'\n    63\t    kore = krun.kast_to_kore(term, KSort('Program'))\n    64\t    res = krun.run_process(kore)\n    65\t    if res.returncode != 0:\n    66\t        return f'krun failed: {res.stderr.strip()[:200]}'\n    67\t    pretty = krun.pretty_print(krun.kore_to_kast(KoreParser(res.stdout).pattern()))\n    68\t    return zkir_kast.wf_result(pretty)\n    69\t\n    70\t\n    71\tdef matches(expected: str, actual: str) -> bool:\n    72\t    if expected == 'wfOk':\n    73\t        return actual == 'wfOk'\n    74\t    if expected == 'format':\n    75\t        return actual.startswith('format')\n    76\t    if expected.startswith('wfError:'):\n    77\t        return actual.startswith('wfError') and expected[len('wfError:'):] in actual\n    78\t    return False\n    79\t\n    80\t\n    81\tdef main() -> int:\n    82\t    ap = argparse.ArgumentParser()\n    83\t    ap.add_argument('--definition', type=Path, default=zkir_kast.default_definition())\n    84\t    args = ap.parse_args()\n    85\t    krun = KRun(args.definition)\n    86\t    rows = []\n    87\t    failures = 0\n    88\t    t0 = time.time()\n    89\t    for corpus, directory in CORPORA.items():\n    90\t        for path in sorted(directory.glob('*.zkir')):\n    91\t            doc = json.loads(path.read_text())\n    92\t            if doc.get('version', {}).get('major') != 3:\n    93\t                continue\n    94\t            expected = EXPECTED.get(path.name, 'wfOk')\n    95\t            actual = outcome(krun, path)\n    96\t            ok = matches(expected, actual)\n    97\t            failures += not ok\n    98\t            rows.append((corpus, path.name, len(doc['instructions']), expected, actual, ok))\n    99\t    width = max(len(r[1]) for r in rows)\n   100\t    for corpus, name, n, expected, actual, ok in rows:\n   101\t        print(f\"{'PASS' if ok else 'FAIL'}  {corpus:34} {name:{width}} {n:4d}  {actual}\")\n   102\t    print(f'\\n{len(rows)} programs, {len(rows) - failures} as expected, {failures} unexpected, {time.time() - t0:.1f}s')\n   103\t    return 1 if failures else 0\n   104\t\n   105\t\n   106\tif __name__ == '__main__':\n   107\t    sys.exit(main())\n     1\t\"\"\"Attach the crate's own test preimages to corpus/ledger9-92e8bdd3-tests/manifest.json.\n     2\t\n     3\tFor every program extracted from zkir-v3/tests/*.rs at midnight-ledger 92e8bdd3,\n     4\tfind the `ProofPreimage { .. }` literal (or `assert_*` call) that follows it in\n     5\tthe same test function and record the integer-literal parts of `inputs`,\n     6\t`private_transcript`, `public_transcript_inputs`, `public_transcript_outputs`\n     7\tand `binding_input`. Vectors that contain computed values (point coordinates,\n     8\thashes) are left out; the differential harness then falls back to generated\n     9\tinputs for those programs.\n    10\t\"\"\"\n    11\timport json\n    12\timport re\n    13\timport subprocess\n    14\tfrom pathlib import Path\n    15\t\n    16\tHERE = Path(__file__).resolve().parent\n    17\tMANIFEST = HERE.parent / 'corpus' / 'ledger9-92e8bdd3-tests' / 'manifest.json'\n    18\tLEDGER = Path.home() / 'Moriarty/repos/midnightntwrk/midnight-ledger'\n    19\tFIELDS = ['inputs', 'private_transcript', 'public_transcript_inputs', 'public_transcript_outputs']\n    20\tLIT = re.compile(r'^\\s*\\(?(-?\\d+)\\)?\\s*\\.into\\(\\)\\s*$')\n    21\t\n    22\t\n    23\tdef literal_vec(text: str):\n    24\t    text = text.strip()\n    25\t    if text == '':\n    26\t        return []\n    27\t    parts = [p for p in text.split(',') if p.strip()]\n    28\t    out = []\n    29\t    for p in parts:\n    30\t        m = LIT.match(p)\n    31\t        if not m:\n    32\t            return None\n    33\t        out.append(int(m.group(1)))\n    34\t    return out\n    35\t\n    36\t\n    37\tmanifest = json.loads(MANIFEST.read_text())\n    38\tsources = {}\n    39\tfor entry in manifest['programs']:\n    40\t    f = entry['source']\n    41\t    if f not in sources:\n    42\t        sources[f] = subprocess.run(['git', '-C', str(LEDGER), 'show', f'92e8bdd3:{f}'], capture_output=True, text=True, check=True).stdout\n    43\t    src = sources[f]\n    44\t    lines = src.split('\\n')\n    45\t    start = entry['line'] - 1\n    46\t    # the test function body: up to the next `fn ` after the program\n    47\t    end = next((i for i in range(start + 1, len(lines)) if re.match(r'\\s*(async )?fn ', lines[i])), len(lines))\n    48\t    body = '\\n'.join(lines[start:end])\n    49\t    pre = {}\n    50\t    for field in FIELDS:\n    51\t        m = re.search(field + r':\\s*vec!\\[(.*?)\\]', body, re.S)\n    52\t        if m:\n    53\t            vals = literal_vec(m.group(1))\n    54\t            if vals is not None:\n    55\t                pre[field] = [str(v) for v in vals]\n    56\t    m = re.search(r'binding_input:\\s*\\(?(\\d+)\\)?\\.into\\(\\)', body)\n    57\t    if m:\n    58\t        pre['binding_input'] = m.group(1)\n    59\t    # assert_check_err_contains(ir, vec![...], ..) / assert_typed_output_roundtrip(ir, vec![...], ..)\n    60\t    m = re.search(r'(assert_check_err_contains|assert_typed_output_roundtrip)\\(\\s*r#\"', body)\n    61\t    if m and 'inputs' not in pre:\n    62\t        m2 = re.search(r'\"#,\\s*vec!\\[(.*?)\\]', body, re.S)\n    63\t        if m2:\n    64\t            vals = literal_vec(m2.group(1))\n    65\t            if vals is not None:\n    66\t                pre['inputs'] = [str(v) for v in vals]\n    67\t    if 'inputs' in pre:\n    68\t        entry['test_preimage'] = pre\n    69\t    else:\n    70\t        entry.pop('test_preimage', None)\n    71\tMANIFEST.write_text(json.dumps(manifest, indent=2) + '\\n')\n    72\thave = [e['file'] for e in manifest['programs'] if 'test_preimage' in e]\n    73\tprint(len(have), 'programs with literal test inputs:', ', '.join(have))\n","exit_code":0,"status":"completed"}}
