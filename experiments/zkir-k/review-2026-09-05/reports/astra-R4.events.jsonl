   statistics: bool = False,\n    ) -> CompletedProcess:\n        with self._temp_file() as ntf:\n            pgm.write(ntf)\n            ntf.flush()\n\n            return _krun(\n                command=self.command,\n                input_file=Path(ntf.name),\n                definition_dir=self.definition_dir,\n                output=KRunOutput.KORE,\n                depth=depth,\n                parser='cat',\n                cmap=cmap,\n                pmap=pmap,\n                term=term,\n                temp_dir=self.use_directory,\n                save_temps=save_temps,\n                statistics=statistics,\n                no_expand_macros=not expand_macros,\n                search_final=search_final,\n                no_pattern=no_pattern,\n                bug_report=self._bug_report,\n                check=False,\n                pipe_stderr=pipe_stderr,\n                debugger=debugger,\n            )\n\n    def run_proof_hint(\n        self,\n        pgm: Pattern,\n        *,\n        cmap: Mapping[str, str] | None = None,\n        pmap: Mapping[str, str] | None = None,\n        output: KRunOutput | None = None,\n        parser: str | None = None,\n        term: bool = False,\n        temp_dir: Path | None = None,\n        save_temps: bool = False,\n        statistics: bool = False,\n        depth: int | None = None,\n        expand_macros: bool = True,\n        search_final: bool = False,\n        no_pattern: bool = False,\n        check: bool = False,\n        pipe_stderr: bool = True,\n        debugger: bool = False,\n        proof_hint: bool = False,\n    ) -> bytes:\n        with self._temp_file() as ntf:\n            pgm.write(ntf)\n            ntf.flush()\n\n            args = _build_arg_list(\n                command='krun',\n                input_file=Path(ntf.name),\n                definition_dir=self.definition_dir,\n                output=output,\n                parser=parser,\n                depth=depth,\n                pmap=pmap,\n                cmap=cmap,\n                term=term,\n                temp_dir=temp_dir,\n                save_temps=save_temps,\n                statistics=statistics,\n                no_expand_macros=not expand_macros,\n                search_final=search_final,\n                no_pattern=no_pattern,\n                debugger=debugger,\n                proof_hint=proof_hint,\n            )\n\n            hints_bytes = self.__run_proof_hint_process(\n    25\t/// If `bit` is true, returns `a`; otherwise returns `b`.\n    26\t///\n    27\t/// Supported on:\n    28\t///   - `Native`\n    29\t///   - `Bool`\n    30\t///   - `Byte`\n    31\t///   - `JubjubPoint`\n    32\t///   - `Secp256k1Point`\n    33\t///   - `Secp256k1Base`\n    34\t///   - `Secp256k1Scalar`\n    35\t///   - `Secp256r1Point`\n    36\t///   - `Secp256r1Base`\n    37\t///   - `Secp256r1Scalar`\n    38\t///   - `Curve25519Point`\n    39\t///   - `Curve25519Base`\n    40\t///   - `Curve25519Scalar`\n    41\t///\n    42\t/// # Errors\n    43\t///\n    44\t/// Returns an error if `a` and `b` do not have the same type.\n    45\tpub fn select_offcircuit(bit: bool, a: &IrValue, b: &IrValue) -> Result<IrValue, anyhow::Error> {\n    46\t    if a.get_type() != b.get_type() {\n    47\t        return Err(anyhow::anyhow!(\n    48\t            \"Unsupported cond_select: {:?} ? {:?}\",\n    49\t            a.get_type(),\n    50\t            b.get_type()\n    51\t        ));\n    52\t    }\n    53\t    Ok(if bit { a.clone() } else { b.clone() })\n    54\t}\n    55\t\n    56\t/// Conditionally selects in-circuit between two values.\n    57\t/// If `bit` is true, returns `a`; otherwise returns `b`.\n    58\t///\n    59\t/// Supported on:\n    60\t///   - `Native`\n    61\t///   - `Bool`\n    62\t///   - `Byte`\n    63\t///   - `JubjubPoint`\n    64\t///   - `Secp256k1Point`\n    65\t///   - `Secp256k1Base`\n    66\t///   - `Secp256k1Scalar`\n    67\t///   - `Secp256r1Point`\n    68\t///   - `Secp256r1Base`\n    69\t///   - `Secp256r1Scalar`\n    70\t///   - `Curve25519Point`\n    71\t///   - `Curve25519Base`\n    72\t///   - `Curve25519Scalar`\n    73\t///\n    74\t/// # Errors\n    75\t///\n    76\t/// This function results in an error if the input types are not supported.\n    77\tpub fn select_incircuit(\n    78\t    std_lib: &ZkStdLib,\n    79\t    layouter: &mut impl Layouter<F>,\n    80\t    bit: &AssignedBit<F>,\n    81\t    a: &CircuitValue,\n    82\t    b: &CircuitValue,\n    83\t) -> Result<CircuitValue, plonk::Error> {\n    84\t    use CircuitValue::*;\n    85\t    match (a, b) {\n    86\t        (Native(x), Native(y)) => Ok(Native(std_lib.select(layouter, bit, x, y)?)),\n    87\t        (Bool(a), Bool(b)) => Ok(Bool(std_lib.select(layouter, bit, a, b)?)),\n    88\t        (Byte(a), Byte(b)) => Ok(Byte(std_lib.select(layouter, bit, a, b)?)),\n    89\t        (JubjubPoint(p), JubjubPoint(q)) => {\n    90\t            Ok(JubjubPoint(std_lib.jubjub().select(layouter, bit, p, q)?))\n    91\t        }\n    92\t\n    93\t        (Secp256k1Point(p), Secp256k1Point(q)) => Ok(Secp256k1Point(\n    94\t            std_lib.secp256k1().select(layouter, bit, p, q)?,\n    95\t        )),\n    96\t        (Secp256k1Base(s), Secp256k1Base(r)) => Ok(Secp256k1Base(\n    97\t            (std_lib.secp256k1().base_field_chip()).select(layouter, bit, s, r)?,\n    98\t        )),\n    99\t        (Secp256k1Scalar(s), Secp256k1Scalar(r)) => Ok(Secp256k1Scalar(\n   100\t            (std_lib.secp256k1().scalar_field_chip()).select(layouter, bit, s, r)?,\n   101\t        )),\n   102\t\n   103\t        (Secp256r1Point(p), Secp256r1Point(q)) => Ok(Secp256r1Point(std_lib.p256().select(layouter, bit, p, q)?)),\n   104\t        (Secp256r1Base(s), Secp256r1Base(r)) => Ok(Secp256r1Base(\n   105\t            (std_lib.p256().base_field_chip()).select(layouter, bit, s, r)?,\n   106\t        )),\n   107\t        (Secp256r1Scalar(s), Secp256r1Scalar(r)) => Ok(Secp256r1Scalar(\n   108\t            (std_lib.p256().scalar_field_chip()).select(layouter, bit, s, r)?,\n   109\t        )),\n   110\t\n   111\t        (Curve25519Point(p), Curve25519Point(q)) => Ok(Curve25519Point(\n   112\t            std_lib.curve25519().select(layouter, bit, p, q)?,\n   113\t        )),\n   114\t        (Curve25519Base(s), Curve25519Base(r)) => Ok(Curve25519Base(\n   115\t            (std_lib.curve25519().base_field_chip()).select(layouter, bit, s, r)?,\n   116\t        )),\n   117\t        (Curve25519Scalar(s), Curve25519Scalar(r)) => Ok(Curve25519Scalar(\n   118\t            (std_lib.curve25519().scalar_field_chip()).select(layouter, bit, s, r)?,\n   119\t        )),\n   120\t\n   121\t        _ => Err(plonk::Error::Synthesis(format!(\n   122\t            \"Unsupported cond_select: {:?} ? {:?}\",\n   123\t            a.get_type(),\n   124\t            b.get_type()\n   125\t        ))),\n   126\t    }\n   127\t}\n   128\t\n   129\t#[cfg(test)]\n   130\tmod tests {\n   131\t    use super::*;\n   132\t\n   133\t    #[test]\n   134\t    fn select_offcircuit_behavior() {\n   135\t        use IrValue::*;\n   136\t\n   137\t        // `bit == true` returns `a`, `bit == false` returns `b`.\n   138\t        assert_eq!(\n   139\t            select_offcircuit(true, &Bool(true), &Bool(false)).unwrap(),\n   140\t            Bool(true)\n   141\t        );\n   142\t        assert_eq!(\n   143\t            select_offcircuit(false, &Bool(true), &Bool(false)).unwrap(),\n   144\t            Bool(false)\n   145\t        );\n   146\t\n   147\t        assert_eq!(\n   148\t            select_offcircuit(true, &Byte(1), &Byte(2)).unwrap(),\n   149\t            Byte(1)\n   150\t        );\n   151\t        assert_eq!(\n   152\t            select_offcircuit(false, &Byte(1), &Byte(2)).unwrap(),\n   153\t            Byte(2)\n   154\t        );\n   155\t\n   156\t        // Mismatched operand types are rejected.\n   157\t        assert!(select_offcircuit(true, &Bool(true), &Native(1.into())).is_err());\n   158\t        assert!(select_offcircuit(true, &Byte(1), &Bool(true)).is_err());\n   159\t    }\n   160\t}\n    25\t/// Equality testing is supported on:\n    26\t///   - `Native`\n    27\t///   - `Bool`\n    28\t///   - `Byte`\n    29\t///   - `Bytes(n)`\n    30\t///   - `JubjubPoint`\n    31\t///   - `Secp256k1Point`\n    32\t///   - `Secp256k1Base`\n    33\t///   - `Secp256k1Scalar`\n    34\t///   - `Secp256r1Point`\n    35\t///   - `Secp256r1Base`\n    36\t///   - `Secp256r1Scalar`\n    37\t///   - `Curve25519Point`\n    38\t///   - `Curve25519Base`\n    39\t///   - `Curve25519Scalar`\n    40\t///\n    41\t/// # Errors\n    42\t///\n    43\t/// This function results in an error if the input types are not supported.\n    44\tpub fn test_eq_offcircuit(a: &IrValue, b: &IrValue) -> Result<bool, anyhow::Error> {\n    45\t    use IrValue::*;\n    46\t    match (a, b) {\n    47\t        (Native(x), Native(y)) => Ok(x == y),\n    48\t        (Bool(a), Bool(b)) => Ok(a == b),\n    49\t        (Byte(a), Byte(b)) => Ok(a == b),\n    50\t        (Bytes(xs), Bytes(ys)) => Ok(xs == ys),\n    51\t        (JubjubPoint(p), JubjubPoint(q)) => Ok(p == q),\n    52\t\n    53\t        (Secp256k1Point(p), Secp256k1Point(q)) => Ok(p == q),\n    54\t        (Secp256k1Base(s), Secp256k1Base(r)) => Ok(s == r),\n    55\t        (Secp256k1Scalar(s), Secp256k1Scalar(r)) => Ok(s == r),\n    56\t\n    57\t        (Secp256r1Point(p), Secp256r1Point(q)) => Ok(p == q),\n    58\t        (Secp256r1Base(s), Secp256r1Base(r)) => Ok(s == r),\n    59\t        (Secp256r1Scalar(s), Secp256r1Scalar(r)) => Ok(s == r),\n    60\t\n    61\t        (Curve25519Point(p), Curve25519Point(q)) => Ok(p == q),\n    62\t        (Curve25519Base(s), Curve25519Base(r)) => Ok(s == r),\n    63\t        (Curve25519Scalar(s), Curve25519Scalar(r)) => Ok(s == r),\n    64\t\n    65\t        _ => Err(anyhow::anyhow!(\n    66\t            \"Unsupported test_eq: {:?} == {:?}\",\n    67\t            a.get_type(),\n    68\t            b.get_type()\n    69\t        )),\n    70\t    }\n    71\t}\n    72\t\n    73\t/// Tests in-circuit whether the given inputs are equal.\n    74\t/// Equality testing is supported on:\n    75\t///   - `Native`\n    76\t///   - `Bool`\n    77\t///   - `Byte`\n    78\t///   - `Bytes(n)` (both operands must have the same length)\n    79\t///   - `JubjubPoint`\n    80\t///   - `Secp256k1Point`\n    81\t///   - `Secp256k1Base`\n    82\t///   - `Secp256k1Scalar`\n    83\t///   - `Secp256r1Point`\n    84\t///   - `Secp256r1Base`\n    85\t///   - `Secp256r1Scalar`\n    86\t///   - `Curve25519Point`\n    87\t///   - `Curve25519Base`\n    88\t///   - `Curve25519Scalar`\n    89\t///\n    90\t/// # Errors\n    91\t///\n    92\t/// This function results in an error if the input types are not supported.\n    93\tpub fn test_eq_incircuit(\n    94\t    std_lib: &ZkStdLib,\n    95\t    layouter: &mut impl Layouter<F>,\n    96\t    a: &CircuitValue,\n    97\t    b: &CircuitValue,\n    98\t) -> Result<AssignedBit<F>, plonk::Error> {\n    99\t    use CircuitValue::*;\n   100\t    match (a, b) {\n   101\t        (Native(x), Native(y)) => std_lib.is_equal(layouter, x, y),\n   102\t\n   103\t        (Bool(x), Bool(y)) => std_lib.is_equal(layouter, x, y),\n   104\t\n   105\t        (Byte(x), Byte(y)) => std_lib.is_equal(layouter, x, y),\n   106\t\n   107\t        (Bytes(xs), Bytes(ys)) if xs.len() == ys.len() => {\n   108\t            let pair_wise_eqs = (xs.iter().zip(ys.iter()))\n   109\t                .map(|(x, y)| std_lib.is_equal(layouter, x, y))\n   110\t                .collect::<Result<Vec<_>, plonk::Error>>()?;\n   111\t            std_lib.and(layouter, &pair_wise_eqs)\n   112\t        }\n   113\t\n   114\t        (JubjubPoint(p), JubjubPoint(q)) => std_lib.jubjub().is_equal(layouter, p, q),\n   115\t\n   116\t        (Secp256k1Point(p), Secp256k1Point(q)) => std_lib.secp256k1().is_equal(layouter, p, q),\n   117\t        (Secp256k1Base(s), Secp256k1Base(r)) => {\n   118\t            (std_lib.secp256k1().base_field_chip()).is_equal(layouter, s, r)\n   119\t        }\n   120\t        (Secp256k1Scalar(s), Secp256k1Scalar(r)) => {\n   121\t            (std_lib.secp256k1().scalar_field_chip()).is_equal(layouter, s, r)\n   122\t        }\n   123\t\n   124\t        (Secp256r1Point(p), Secp256r1Point(q)) => std_lib.p256().is_equal(layouter, p, q),\n   125\t        (Secp256r1Base(s), Secp256r1Base(r)) => {\n   126\t            (std_lib.p256().base_field_chip()).is_equal(layouter, s, r)\n   127\t        }\n   128\t        (Secp256r1Scalar(s), Secp256r1Scalar(r)) => {\n   129\t            (std_lib.p256().scalar_field_chip()).is_equal(layouter, s, r)\n   130\t        }\n   131\t\n   132\t        (Curve25519Point(p), Curve25519Point(q)) => std_lib.curve25519().is_equal(layouter, p, q),\n   133\t        (Curve25519Base(s), Curve25519Base(r)) => {\n   134\t            (std_lib.curve25519().base_field_chip()).is_equal(layouter, s, r)\n   135\t        }\n   136\t        (Curve25519Scalar(s), Curve25519Scalar(r)) => {\n   137\t            (std_lib.curve25519().scalar_field_chip()).is_equal(layouter, s, r)\n   138\t        }\n   139\t        _ => Err(plonk::Error::Synthesis(format!(\n   140\t            \"Unsupported test_eq: {:?} == {:?}\",\n   141\t            a.get_type(),\n   142\t            b.get_type()\n   143\t        ))),\n   144\t    }\n   145\t}\n   146\t\n   147\t#[cfg(test)]\n   148\tmod tests {\n   149\t    use group::Group;\n   150\t    use group::ff::Field;\n221:                    \"Not enough raw inputs: ran out at index {} while decoding {:?}\",\n282:                bail!(\"Boolean gate requires at least one input\");\n290:                        .map_err(|_| anyhow!(\"Boolean gate expects Bool inputs, found {t:?}\"))\n364:                I::Not { a, output } => {\n370:                    memory.insert(output.clone(), IrValue::Bool(result));\n374:                    memory.insert(output.clone(), IrValue::Bool(result));\n380:                    memo