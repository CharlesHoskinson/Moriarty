json::to_string(&t).unwrap(), r#\"\"Bytes<32>\"\"#);\n    32\t  rule #c25519L => 7237005577332262213973186563042994240857116359379907606001950938285454250989\n    33\t\n    34\t  syntax Int ::= fmod(Int, Int)         [function, total]\n    35\t               | fadd(Int, Int, Int)    [function, total]\n    36\t               | fsub(Int, Int, Int)    [function, total]\n    37\t               | fmul(Int, Int, Int)    [function, total]\n    38\t               | fneg(Int, Int)         [function, total]\n    39\t               | finv(Int, Int)         [function, total]   // inverse by Fermat; finv(0) = 0\n    40\t               | fdiv(Int, Int, Int)    [function, total]\n    41\t               | fpow(Int, Int, Int)    [function, total]\n    42\t               | fsq(Int, Int)          [function, total]\n    43\t  rule fmod(A, P)     => A modInt P\n    44\t  rule fadd(A, B, P)  => (A +Int B) modInt P\n    45\t  rule fsub(A, B, P)  => (A -Int B) modInt P\n    46\t  rule fmul(A, B, P)  => (A *Int B) modInt P\n    47\t  rule fneg(A, P)     => (0 -Int A) modInt P\n    48\t  rule finv(A, P)     => 0 requires A modInt P ==Int 0\n    49\t  rule finv(A, P)     => (A modInt P) ^%Int (P -Int 2) P requires A modInt P =/=Int 0\n    50\t  rule fdiv(A, B, P)  => fmul(A, finv(B, P), P)\n    51\t  rule fpow(A, E, P)  => (A modInt P) ^%Int E P requires E >=Int 0\n    52\t  rule fpow(_, E, _)  => 0 requires E <Int 0\n    53\t  rule fsq(A, P)      => fmul(A, A, P)\n    54\t\n    55\t  // Legendre symbol as 0, 1 or P-1 (i.e. -1); 0 counts as a residue, as in\n    56\t  // midnight-curves `ct_quadratic_non_residue` (legendre == -1).\n    57\t  syntax Int ::= legendre(Int, Int) [function, total]\n    58\t  rule legendre(A, P) => fpow(A, (P -Int 1) /Int 2, P)\n    59\t  syntax Bool ::= isQuadraticNonResidue(Int, Int) [function, total]\n    60\t  rule isQuadraticNonResidue(A, P) => legendre(A, P) ==Int P -Int 1\n    61\t\n    62\t  syntax Bool ::= isOddInt(Int) [function, total]\n    63\t  rule isOddInt(A) => A modInt 2 ==Int 1\n    64\t\n    65\t  // --- Square roots: Tonelli-Shanks ---------------------------------------\n    66\t  // fsqrt(A, P) is sqrtOk(X) with X*X = A mod P for some root, or noSqrt().\n    67\t  // Callers that need a specific root fix the parity themselves, as the Rust\n    68\t  // code does (Jubjub decompression, SVDW map).\n    69\t  syntax SqrtResult ::= sqrtOk(Int) | noSqrt()\n    70\t  syntax SqrtResult ::= fsqrt(Int, Int) [function, total]\n    71\t  rule fsqrt(A, P) => sqrtOk(0) requires A modInt P ==Int 0\n    72\t  rule fsqrt(A, P) => noSqrt() requires A modInt P =/=Int 0 andBool legendre(A, P) =/=Int 1\n    73\t  rule fsqrt(A, P) => #ts(A modInt P, P, #twoAdicity(P -Int 1, 0), #oddPart(P -Int 1), #nonResidue(P, 2))\n    74\t    requires A modInt P =/=Int 0 andBool legendre(A, P) ==Int 1\n    75\t\n    76\t  syntax Int ::= #twoAdicity(Int, Int) [function, total]   // #twoAdicity(N, 0) = s with N = 2^s * odd\n    77\t  rule #twoAdicity(N, S) => #twoAdicity(N /Int 2, S +Int 1) requires N >Int 0 andBool N modInt 2 ==Int 0\n    78\t  rule #twoAdicity(N, S) => S requires N <=Int 0 orBool N modInt 2 ==Int 1\n    79\t  syntax Int ::= #oddPart(Int) [function, total]\n    80\t  rule #oddPart(N) => #oddPart(N /Int 2) requires N >Int 0 andBool N modInt 2 ==Int 0\n    81\t  rule #oddPart(N) => N requires N <=Int 0 orBool N modInt 2 ==Int 1\n    82\t  syntax Int ::= #nonResidue(Int, Int) [function, total]   // smallest quadratic non-residue >= Z\n    83\t  rule #nonResidue(P, Z) => Z requires isQuadraticNonResidue(Z, P)\n    84\t  rule #nonResidue(P, Z) => #nonResidue(P, Z +Int 1) requires notBool isQuadraticNonResidue(Z, P) andBool Z <Int P\n    85\t  rule #nonResidue(P, Z) => 0 requires Z >=Int P\n    86\t\n    87\t  // #ts(A, P, S, Q, Z): standard loop with M = S, c = Z^Q, t = A^Q, R = A^((Q+1)/2)\n    88\t  syntax SqrtResult ::= #ts(Int, Int, Int, Int, Int) [function, total]\n    89\t  rule #ts(A, P, S, Q, Z) => #tsLoop(P, S, fpow(Z, Q, P), fpow(A, Q, P), fpow(A, (Q +Int 1) /Int 2, P))\n    90\t  syntax SqrtResult ::= #tsLoop(Int, Int, Int, Int, Int) [function, total]   // (P, M, c, t, R)\n    91\t  rule #tsLoop(_, _, _, 0, _) => noSqrt()\n    92\t  rule #tsLoop(_, _, _, 1, R) => sqrtOk(R)\n    93\t  rule #tsLoop(P, M, C, T, R) => #tsStep(P, M, C, T, R, #tsOrder(P, T, 0, M))\n    94\t    requires T =/=Int 0 andBool T =/=Int 1\n    95\t  // least i with t^(2^i) = 1\n    96\t  syntax Int ::= #tsOrder(Int, Int, Int, Int) [function, total]\n    97\t  rule #tsOrder(_, 1, I, _) => I\n    98\t  rule #tsOrder(P, T, I, M) => #tsOrder(P, fsq(T, P), I +Int 1, M) requires T =/=Int 1 andBool I <Int M\n    99\t  rule #tsOrder(_, T, I, M) => I requires T =/=Int 1 andBool I >=Int M\n   100\t  syntax SqrtResult ::= #tsStep(Int, Int, Int, Int, Int, Int) [function, total]\n   101\t  rule #tsStep(P, M, C, T, R, I) => noSqrt() requires I >=Int M\n   102\t  rule #tsStep(P, M, C, T, R, I) => #tsLoop(P, I, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P),\n   103\t                                            fmul(T, fsq(fpow(C, 2 ^Int (M -Int I -Int 1), P), P), P),\n   104\t                                            fmul(R, fpow(C, 2 ^Int (M -Int I -Int 1), P), P))\n   105\t    requires I <Int M\n   106\t\n     1\t// Affine elliptic-curve arithmetic for the four ZKIR curves.\n     2\t//\n     3\t//   Jubjub      twisted Edwards, a = -1, over r;   subgroup order rJ, cofactor 8\n     4\t//   Curve25519  twisted Edwards, a = -1, over 2^255-19; subgroup order c25519L, cofactor 8\n     5\t//   secp256k1   short Weierstrass y^2 = x^3 + 7 over k256P; prime order k256N\n     6\t//   secp256r1   short Weierstrass y^2 = x^3 - 3x + b over p256P; prime order p256N\n     7\t//\n     8\t// A point is pt(X, Y) or inf(). Edwards curves never use inf(): their identity\n     9\t// is pt(0, 1). Formulas are the complete unified Edwards addition (d is a\n    10\t// non-square on both curves) and the textbook affine Weierstrass addition.\n    11\t// Sources: midnight-curves 0.3.1 (jubjub/curve.rs, curve25519/), curve25519-dalek\n    12\t// 4.1.3 for the Curve25519 base point, the SEC 2 and FIPS 186-4 generators.\n    13\trequires \"zkir-field.k\"\n    14\t\n    15\tmodule ZKIR-CURVES\n    16\t  imports ZKIR-FIELD\n    17\t  imports STRING\n    18\t\n    19\t  syntax Point ::= pt(Int, Int) [symbol(pt)]\n    20\t                 | inf()        [symbol(inf)]\n    21\t\n    22\t  // --- Curve descriptors --------------------------------------------------------\n    23\t  // edwards(p, d, order)   weierstrass(p, a, b, order)\n    24\t  syntax Curve ::= edwards(Int, Int, Int) | weierstrass(Int, Int, Int, Int)\n    25\t\n    26\t  syntax Curve ::= \"#jubjub\" [function, total]\n    27\t                 | \"#curve25519\" [function, total]\n    28\t                 | \"#secp256k1\" [function, total]\n    29\t                 | \"#secp256r1\" [function, total]\n    30\t  // Jubjub d = -(10240/10241) mod r (midnight-curves jubjub/curve.rs EDWARDS_D)\n    31\t  rule #jubjub     => edwards(#r, fneg(fdiv(10240, 10241, #r), #r), #rJ)\n    32\t  // Curve25519 d = -(121665/121666) mod p\n    33\t  rule #curve25519 => edwards(#c25519P, fneg(fdiv(121665, 121666, #c25519P), #c25519P), #c25519L)\n    34\t  rule #secp256k1  => weierstrass(#k256P, 0, 7, #k256N)\n    35\t  rule #secp256r1  => weierstrass(#p256P, #p256P -Int 3,\n    36\t                        41058363725152142129326129780047268409114441015993725554835256314039467401291, #p256N)\n    37\t\n    38\t  syntax Int ::= curveField(Curve) [function, total]\n    39\t  rule curveField(edwards(P, _, _)) => P\n    40\t  rule curveField(weierstrass(P, _, _, _)) => P\n    41\t  syntax Int ::= curveOrder(Curve) [function, total]\n    42\t  rule curveOrder(edwards(_, _, N)) => N\n    43\t  rule curveOrder(weierstrass(_, _, _, N)) => N\n    44\t\n    45\t  // --- Generators ---------------------------------------------------------------\n    46\t  // Jubjub: JubjubAffine::generator() (u, v) of midnight-curves; the subgroup\n    47\t  // generator used by `JubjubSubgroup::generator()` is its cofactor clearing, 8*G.\n    48\t  syntax Point ::= \"#jubjubGenerator\" [function, total]\n    49\t  rule #jubjubGenerator => ecMul(#jubjub,\n    50\t    pt(44746807950788659978687200207992930935149218647843500701850233404325651525118, 11), 8)\n    51\t  // Curve25519: ED25519_BASEPOINT_POINT (already in the prime-order subgroup).\n    52\t  syntax Point ::= \"#curve25519Generator\" [function, total]\n    53\t  rule #curve25519Generator => pt(15112221349535400772501151409588531511454012693041857206046113283949847762202,\n    54\t                                  46316835694926478169428394003475163141307993866256225615783033603165251855960)\n    55\t  syntax Point ::= \"#secp256k1Generator\" [function, total]\n    56\t  rule #secp256k1Generator => pt(55066263022277343669578718895168534326250603453777594175500187360389116729240,\n    57\t                                 32670510020758816978083085130507043184471273380659243275938904335757337482424)\n    58\t  syntax Point ::= \"#secp256r1Generator\" [function, total]\n    59\t  rule #secp256r1Generator => pt(48439561293906451759052585252797914202762949526041747995844080717082404635286,\n    60\t                                 36134250956749795798585127919587881956611106672985015071877198253568414405109)\n    61\t\n    62\t  // --- Membership -----------------------------------------------------------------\n    63\t  syntax Bool ::= onCurve(Curve, Point) [function, total]\n    64\t  rule onCurve(_, inf()) => true\n    65\t  // -x^2 + y^2 = 1 + d x^2 y^2\n    66\t  rule onCurve(edwards(P, D, _), pt(X, Y))\n    67\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    68\t       fsub(fsq(Y, P), fsq(X, P), P) ==Int fadd(1, fmul(D, fmul(fsq(X, P), fsq(Y, P), P), P), P)\n    69\t  rule onCurve(weierstrass(P, A, B, _), pt(X, Y))\n    70\t    => X >=Int 0 andBool X <Int P andBool Y >=Int 0 andBool Y <Int P andBool\n    71\t       fsq(Y, P) ==Int fadd(fadd(fmul(fsq(X, P), X, P), fmul(A, X, P), P), B, P)\n    72\t\n    73\t  syntax Point ::= identity(Curve) [function, total]\n    74\t  rule identity(edwards(_, _, _)) => pt(0, 1)\n    75\t  rule identity(weierstrass(_, _, _, _)) => inf()\n    76\t\n    77\t  syntax Bool ::= isIdentity(Curve, Point) [function, total]\n    78\t  rule isIdentity(C, Q) => Q ==K identity(C)\n    79\t\n    80\t  // In the prime-order subgroup: order * Q = identity (Weierstrass groups are\n    81\t  // prime order, so any curve point qualifies).\n    82\t  syntax Bool ::= inSubgroup(Curve, Point) [function, total]\n    83\t  rule inSubgroup(edwards(P, D, N), Q) => isIdentity(edwards(P, D, N), ecMul(edwards(P, D, N), Q, N))\n    84\t  rule inSubgroup(weierstrass(_, _, _, _), _) => true\n    85\t\n    86\t  // --- Group law ------------------------------------------------------------------\n    87\t  syntax Point ::= ecNeg(Curve, Point) [function, total]\n    88\t  rule ecNeg(edwards(P, _, _), pt(X, Y)) => pt(fneg(X, P), Y)\n    89\t  rule ecNeg(weierstrass(P, _, _, _), pt(X, Y)) => pt(X, fneg(Y, P))\n    90\t  rule ecNeg(_, inf()) => inf()\n    91\t\n    92\t  syntax Point ::= ecAdd(Curve, Point, Point) [function, total]\n    93\t  rule ecAdd(edwards(P, D, _), pt(X1, Y1), pt(X2, Y2))\n    94\t    => pt(fdiv(fadd(fmul(X1, Y2, P), fmul(Y1, X2, P), P),\n    95\t              fadd(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P),\n    96\t          fdiv(fadd(fmul(Y1, Y2, P), fmul(X1, X2, P), P),\n    97\t              fsub(1, fmul(D, fmul(fmul(X1, X2, P), fmul(Y1, Y2, P), P), P), P), P))\n    98\t  rule ecAdd(edwards(_, _, _), _, inf()) => inf()   // never reached for valid values\n    99\t  rule ecAdd(edwards(_, _, _), inf(), _) => inf()\n   100\t  rule ecAdd(weierstrass(_, _, _, _), inf(), Q) => Q\n   101\t  rule ecAdd(weierstrass(_, _, _, _), Q, inf()) => Q\n   102\t  rule ecAdd(weierstrass(P, A, B, N), pt(X1, Y1), pt(X2, Y2))\n   103\t    => ecDouble(weierstrass(P, A, B, N), pt(X1, Y1))\n   104\t    requires X1 ==Int X2 andBool Y1 ==Int Y2\n   105\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2)) => inf()\n   106\t    requires X1 ==Int X2 andBool Y1 =/=Int Y2\n   107\t  rule ecAdd(weierstrass(P, _, _, _), pt(X1, Y1), pt(X2, Y2))\n   108\t    => #wChord(P, X1, Y1, X2, fdiv(fsub(Y2, Y1, P), fsub(X2, X1, P), P))\n   109\t    requires X1 =/=Int X2\n   110\t  syntax Point ::= #wChord(Int, Int, Int, Int, Int) [function, total]   // (P, X1, Y1, X2, lambda)\n   111\t  rule #wChord(P, X1, Y1, X2, L) => pt(fsub(fsub(fsq(L, P), X1, P), X2, P),\n   112\t                                       fsub(fmul(L, fsub(X1, fsub(fsub(fsq(L, P), X1, P), X2, P), P), P), Y1, P))\n   113\t\n   114\t  syntax Point ::= ecDouble(Curve, Point) [function, total]\n   115\t  rule ecDouble(edwards(P, D, N), Q) => ecAdd(edwards(P, D, N), Q, Q)\n   116\t  rule ecDouble(weierstrass(_, _, _, _), inf()) => inf()\n   117\t  rule ecDouble(weierstrass(_, _, _, _), pt(_, 0)) => inf()\n   118\t  rule ecDouble(weierstrass(P, A, _, _), pt(X, Y))\n   119\t    => #wChord(P, X, Y, X, fdiv(fadd(fmul(3, fsq(X, P), P), A, P), fmul(2, Y, P), P))\n   120\t    requires Y =/=Int 0\n   121\t\n   122\t  // Double-and-add over the bits of K (K >= 0; callers pass canonical scalars).\n   123\t  syntax Point ::= ecMul(Curve, Point, Int) [function, total]\n   124\t  rule ecMul(C, _, K) => identity(C) requires K <=Int 0\n   125\t  rule ecMul(C, Q, K) => #ecMulAcc(C, Q, K, identity(C)) requires K >Int 0\n   126\t  syntax Point ::= #ecMulAcc(Curve, Point, Int, Point) [function, total]\n   127\t  rule #ecMulAcc(_, _, 0, Acc) => Acc\n   128\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, ecAdd(C, Acc, Q))\n   129\t    requires K >Int 0 andBool K modInt 2 ==Int 1\n   130\t  rule #ecMulAcc(C, Q, K, Acc) => #ecMulAcc(C, ecDouble(C, Q), K >>Int 1, Acc)\n   131\t    requires K >Int 0 andBool K modInt 2 ==Int 0\n   132\t  rule #ecMulAcc(_, _, K, Acc) => Acc requires K <Int 0\n   133\t\n   134\t  // --- Constructors from coordinates -------------------------------------------------\n   135\t  syntax PointResult ::= ptOk(Point) | ptErr(String)\n   136\t\n   137\t  // Exact membership test (secp256k1, secp256r1 via SEC1 decoding; Curve25519\n   138\t  // via the curve equation in midnight-curves Curve25519Affine::from_xy).\n   139\t  syntax PointResult ::= fromXY(Curve, Int, Int) [function, total]\n   140\t  rule fromXY(C, X, Y) => ptOk(pt(X, Y)) requires onCurve(C, pt(X, Y))\n   141\t  rule fromXY(C, X, Y) => ptErr(\"point is not on the curve\") requires notBool onCurve(C, pt(X, Y))\n   142\t\n   143\t  // Jubjub `from_xy` of midnight-circuits (ecc/curves.rs): compresses (y, parity\n   144\t  // of x) and decompresses with JubjubAffine::from_bytes, so only the low bit\n   145\t  // of x is used; the recovered x is the root of (y^2-1)/(1+d y^2) with that\n   146\t  // parity. Fails when y is not the v-coordinate of any point, or when\n   147\t  // (ZIP 216) u = 0 with the sign bit set.\n   148\t  syntax PointResult ::= jubjubFromXY(Int, Int) [function, total]\n   149\t  rule jubjubFromXY(X, Y) => ptErr(\"coordinate out of range\") requires Y <Int 0 orBool Y >=Int #r orBool X <Int 0 orBool X >=Int #r\n   150\t  rule jubjubFromXY(X, Y) => #jubjubDecompress(X modInt 2, Y, fsqrt(fdiv(fsub(fsq(Y, #r), 1, #r), fadd(1, fmul(#jubjubD, fsq(Y, #r), #r), #r), #r), #r))\n   151\t    requires Y >=Int 0 andBool Y <Int #r andBool X >=Int 0 andBool X <Int #r\n   152\t  syntax Int ::= \"#jubjubD\" [function, total]\n   153\t  rule #jubjubD => fneg(fdiv(10240, 10241, #r), #r)\n   154\t  syntax PointResult ::= #jubjubDecompress(Int, Int, SqrtResult) [function, total]\n   155\t  rule #jubjubDecompress(_, _, noSqrt()) => ptErr(\"y is not on Jubjub\")\n   156\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(U, Y)) requires U modInt 2 ==Int Sign\n   157\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptErr(\"invalid Jubjub encoding: -0\")\n   158\t    requires U modInt 2 =/=Int Sign andBool U ==Int 0\n   159\t  rule #jubjubDecompress(Sign, Y, sqrtOk(U)) => ptOk(pt(fneg(U, #r), Y))\n   160\t    requires U modInt 2 =/=Int Sign andBool U =/=Int 0\n   161\tendmodule\n","exit_code":0,"status":"completed"}}
