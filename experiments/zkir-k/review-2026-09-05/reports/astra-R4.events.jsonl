G[0]} , {K256_G[1]} ) ) )')\n   209\tencInf = enc_foreign(0, K256P, 64, 4) * 2 + [1]\n   210\tcheck('enc secp256k1Point inf', K('encodeValue', K('secp256k1PointV', K('inf'))), pretty_list(encInf))\n   211\tcheck('dec secp256k1Point inf', K('decodeValue', klist([I(v) for v in encInf]), K('Secp256k1Point')), 'decOk ( secp256k1Point ( inf ( ) ) )')\n   212\tencB = enc_foreign(C25519_G[0], C25519P, 64, 4) + enc_foreign(C25519_G[1], C25519P, 64, 4)\n   213\tcheck('enc curve25519Point B', K('encodeValue', K('curve25519PointV', pt(*C25519_G))), pretty_list(encB))\n   214\tcheck('dec curve25519Point B', K('decodeValue', klist([I(v) for v in encB]), K('Curve25519Point')), f'decOk ( curve25519Point ( pt ( {C25519_G[0]} , {C25519_G[1]} ) ) )')\n   215\tcheck('dec jubjubPoint 8G', K('decodeValue', klist([I(G8[0]), I(G8[1])]), K('JubjubPoint')), f'decOk ( jubjubPoint ( pt ( {G8[0]} , {G8[1]} ) ) )')\n   216\tcheck('dec jubjubPoint G (not subgroup)', K('decodeValue', klist([I(JUBJUB_G[0]), I(JUBJUB_G[1])]), K('JubjubPoint')), 'decErr ( \"Failed to decode as JubjubPoint\" )')\n   217\tcheck('dec jubjubScalar', K('decodeValue', klist([I(RJ - 1)]), K('JubjubScalar')), f'decOk ( jubjubScalar ( {RJ - 1} ) )')\n   218\tcheck('dec jubjubScalar too big', K('decodeValue', klist([I(RJ)]), K('JubjubScalar')), 'decErr ( \"Failed to decode as JubjubScalar\" )')\n   219\tb = bytes(range(1, 33))\n   220\tlo = int.from_bytes(b[:31], 'little')\n   221\tcheck('enc bytes32', K('encodeValue', K('bytes32V', KToken(f'b\"{\"\".join(chr(c) for c in b)}\"', KSort('Bytes')))), pretty_list([lo, 32]))\n   222\tcheck('dec bytes32', K('decodeValue', klist([I(lo), I(32)]), K('Bytes32')), f'decOk ( bytes32 ( {run(KToken(\"b\" + chr(34) + \"\".join(chr(92) + \"x%02x\" % c for c in b) + chr(34), KSort(\"Bytes\")))} ) )')\n   223\tcheck('dec bytes32 bad high', K('decodeValue', klist([I(lo), I(256)]), K('Bytes32')), 'decErr ( \"Bytes32 decoding assertion failed\" )')\n   224\t\n   225\tprint(f'\\n{sum(checks)}/{len(checks)} checks passed')\n   226\tsys.exit(0 if all(checks) else 1)\n     1\t#!/usr/bin/env bash\n     2\t# Milestone 1 toolchain check for the ZKIR-in-K plan (wiki/zkir-k-semantics-plan.md).\n     3\t# Compiles K tutorial lesson 1.2 with the LLVM backend, runs both programs, and\n     4\t# type-checks the same definition with the Haskell backend. Exits non-zero on any\n     5\t# mismatch. Writes a receipt to stdout; redirect it into evidence/.\n     6\tset -euo pipefail\n     7\tcd \"$(dirname \"$0\")\"\n     8\tEXPECTED_VERSION=\"${EXPECTED_K_VERSION:-7.1.337}\"\n     9\trm -rf lesson-02-a-kompiled lesson-02-a-haskell-kompiled\n    10\t\n    11\techo \"date: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n    12\techo \"host: $(uname -srm)\"\n    13\techo \"kompile: $(command -v kompile)\"\n    14\tKV=\"$(kompile --version)\"\n    15\techo \"kompile --version: $(tr '\\n' ' ' <<<\"$KV\")\"\n    16\tgrep -q \"$EXPECTED_VERSION\" <<<\"$KV\" || { echo \"FAIL: expected K $EXPECTED_VERSION, got: $KV\"; exit 1; }\n    17\t\n    18\techo \"--- kompile (llvm)\"\n    19\tkompile lesson-02-a.k --backend llvm --emit-json 2>&1 | grep -v \"^\\[Warning\\] Compiler: Could not find main syntax module\" || true\n    20\t[ -d lesson-02-a-kompiled ] || { echo \"FAIL: no kompiled dir\"; exit 1; }\n    21\t\n    22\techo \"--- krun banana.color\"\n    23\tOUT_B=$(krun banana.color --definition lesson-02-a-kompiled)\n    24\techo \"$OUT_B\"\n    25\techo \"$OUT_B\" | grep -q \"Yellow ( )\" || { echo \"FAIL: expected Yellow\"; exit 1; }\n    26\t\n    27\techo \"--- krun blueberry.color\"\n    28\tOUT_BB=$(krun blueberry.color --definition lesson-02-a-kompiled)\n    29\techo \"$OUT_BB\"\n    30\techo \"$OUT_BB\" | grep -q \"Blue ( )\" || { echo \"FAIL: expected Blue\"; exit 1; }\n    31\t\n    32\techo \"--- kompile (haskell)\"\n    33\tkompile lesson-02-a.k --backend haskell --output-definition lesson-02-a-haskell-kompiled 2>&1 | grep -v \"^\\[Warning\\] Compiler: Could not find main syntax module\" || true\n    34\t[ -f lesson-02-a-haskell-kompiled/definition.kore ] || { echo \"FAIL: no haskell definition.kore\"; exit 1; }\n    35\techo \"--- krun banana.color (haskell)\"\n    36\tOUT_H=$(krun banana.color --definition lesson-02-a-haskell-kompiled)\n    37\techo \"$OUT_H\"\n    38\techo \"$OUT_H\" | grep -q \"Yellow ( )\" || { echo \"FAIL: haskell backend expected Yellow\"; exit 1; }\n    39\t\n    40\techo \"--- pyk (uv dependency group zkir-k of the Moriarty project)\"\n    41\tREPO_ROOT=\"$(git rev-parse --show-toplevel)\"\n    42\tPYK_VERSION=$(cd \"$REPO_ROOT\" && uv run --group zkir-k python -c 'import pyk; print(pyk.__version__)') || { echo \"FAIL: pyk import\"; exit 1; }\n    43\techo \"pyk: $PYK_VERSION\"\n    44\t[ \"$PYK_VERSION\" = \"$EXPECTED_VERSION\" ] || { echo \"FAIL: pyk $PYK_VERSION != K $EXPECTED_VERSION\"; exit 1; }\n    45\techo \"--- pyk kast round trip\"\n    46\t(cd \"$REPO_ROOT\" && uv run --group zkir-k python \"$OLDPWD/pyk_roundtrip.py\" \"$OLDPWD/lesson-02-a-kompiled\") || { echo \"FAIL: pyk round trip\"; exit 1; }\n    47\t\n    48\techo \"RESULT: PASS\"\ndiff --git a/zkir-v3/src/ir_vm.rs b/zkir-v3/src/ir_vm.rs\nindex 8ae6734..1ebfc60 100644\n--- a/zkir-v3/src/ir_vm.rs\n+++ b/zkir-v3/src/ir_vm.rs\n@@ -182,7 +182,7 @@ fn fab_decode_to_bytes_atom(\n impl IrSource {\n     /// Performs a non-ZK run of a circuit, to ensure that constraints hold, and\n     /// to produce a public input vector, and public input skip information.\n-    pub(crate) fn preprocess(\n+    pub fn preprocess(\n         &self,\n         preimage: &ProofPreimage,\n     ) -> Result<Preprocessed, ProvingError> {\ndiff --git a/zkir/src/ir_vm.rs b/zkir/src/ir_vm.rs\nindex 8207e4b..da1188f 100644\n--- a/zkir/src/ir_vm.rs\n+++ b/zkir/src/ir_vm.rs\n@@ -207,7 +207,7 @@ fn fab_decode_to_bytes_atom(\n impl IrSource {\n     /// Performs a non-ZK run of a circuit, to ensure that constraints hold, and\n     /// to produce a public input vector, and public input skip informati