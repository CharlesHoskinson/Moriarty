X)\n    28\t  rule asNative(V) => iErr(\"cannot convert \" +String tn(V) +String \" to Native\") [owise]\n    29\t  syntax BytesResult ::= bOk(Bytes) | bErr(String)\n    30\t  syntax BytesResult ::= asBytes32(Value) [function, total]\n    31\t  rule asBytes32(bytes32(B)) => bOk(B)\n    32\t  rule asBytes32(V) => bErr(\"cannot convert \" +String tn(V) +String \" to Bytes32\") [owise]\n    33\t\n    34\t  // --- add ---------------------------------------------------------------------------\n    35\t  syntax ValueResult ::= addV(Value, Value) [function, total]\n    36\t  rule addV(native(A), native(B))                   => vOk(native(fadd(A, B, #r)))\n    37\t  rule addV(jubjubPoint(P), jubjubPoint(Q))         => vOk(jubjubPoint(ecAdd(#jubjub, P, Q)))\n    38\t  rule addV(secp256k1Point(P), secp256k1Point(Q))   => vOk(secp256k1Point(ecAdd(#secp256k1, P, Q)))\n    39\t  rule addV(secp256k1Base(A), secp256k1Base(B))     => vOk(secp256k1Base(fadd(A, B, #k256P)))\n    40\t  rule addV(secp256k1Scalar(A), secp256k1Scalar(B)) => vOk(secp256k1Scalar(fadd(A, B, #k256N)))\n    41\t  rule addV(secp256r1Point(P), secp256r1Point(Q))   => vOk(secp256r1Point(ecAdd(#secp256r1, P, Q)))\n    42\t  rule addV(secp256r1Base(A), secp256r1Base(B))     => vOk(secp256r1Base(fadd(A, B, #p256P)))\n    43\t  rule addV(secp256r1Scalar(A), secp256r1Scalar(B)) => vOk(secp256r1Scalar(fadd(A, B, #p256N)))\n    44\t  rule addV(curve25519Point(P), curve25519Point(Q)) => vOk(curve25519Point(ecAdd(#curve25519, P, Q)))\n    45\t  rule addV(curve25519Base(A), curve25519Base(B))   => vOk(curve25519Base(fadd(A, B, #c25519P)))\n    46\t  rule addV(curve25519Scalar(A), curve25519Scalar(B)) => vOk(curve25519Scalar(fadd(A, B, #c25519L)))\n    47\t  rule addV(A, B) => vErr(\"Unsupported addition: \" +String tn(A) +String \" + \" +String tn(B)) [owise]\n    48\t\n    49\t  // --- mul ---------------------------------------------------------------------------\n    50\t  syntax ValueResult ::= mulV(Value, Value) [function, total]\n    51\t  rule mulV(native(A), native(B))                   => vOk(native(fmul(A, B, #r)))\n    52\t  rule mulV(secp256k1Base(A), secp256k1Base(B))     => vOk(secp256k1Base(fmul(A, B, #k256P)))\n    53\t  rule mulV(secp256k1Scalar(A), secp256k1Scalar(B)) => vOk(secp256k1Scalar(fmul(A, B, #k256N)))\n    54\t  rule mulV(secp256r1Base(A), secp256r1Base(B))     => vOk(secp256r1Base(fmul(A, B, #p256P)))\n    55\t  rule mulV(secp256r1Scalar(A), secp256r1Scalar(B)) => vOk(secp256r1Scalar(fmul(A, B, #p256N)))\n    56\t  rule mulV(curve25519Base(A), curve25519Base(B))   => vOk(curve25519Base(fmul(A, B, #c25519P)))\n    57\t  rule mulV(curve25519Scalar(A), curve25519Scalar(B)) => vOk(curve25519Scalar(fmul(A, B, #c25519L)))\n    58\t  rule mulV(A, B) => vErr(\"Unsupported multiplication: \" +String tn(A) +String \" x \" +String tn(B)) [owise]\n    59\t\n    60\t  // --- neg ---------------------------------------------------------------------------\n    61\t  syntax ValueResult ::= negV(Value) [function, total]\n    62\t  rule negV(native(A))          => vOk(native(fneg(A, #r)))\n    63\t  rule negV(jubjubPoint(P))     => vOk(jubjubPoint(ecNeg(#jubjub, P)))\n    64\t  rule negV(secp256k1Point(P))  => vOk(secp256k1Point(ecNeg(#secp256k1, P)))\n    65\t  rule negV(secp256k1Base(A))   => vOk(secp256k1Base(fneg(A, #k256P)))\n    66\t  rule negV(secp256k1Scalar(A)) => vOk(secp256k1Scalar(fneg(A, #k256N)))\n    67\t  rule negV(secp256r1Point(P))  => vOk(secp256r1Point(ecNeg(#secp256r1, P)))\n    68\t  rule negV(secp256r1Base(A))   => vOk(secp256r1Base(fneg(A, #p256P)))\n    69\t  rule negV(secp256r1Scalar(A)) => vOk(secp256r1Scalar(fneg(A, #p256N)))\n    70\t  rule negV(curve25519Point(P)) => vOk(curve25519Point(ecNeg(#curve25519, P)))\n    71\t  rule negV(curve25519Base(A))  => vOk(curve25519Base(fneg(A, #c25519P)))\n    72\t  rule negV(curve25519Scalar(A))=> vOk(curve25519Scalar(fneg(A, #c25519L)))\n    73\t  rule negV(A) => vErr(\"Unsupported negation of \" +String tn(A)) [owise]\n    74\t\n    75\t  // --- inv ---------------------------------------------------------------------------\n    76\t  syntax ValueResult ::= invV(Value) [function, total]\n    77\t  rule invV(native(0))          => vErr(\"cannot invert zero of type Native\")\n    78\t  rule invV(native(A))          => vOk(native(finv(A, #r))) requires A =/=Int 0\n    79\t  rule invV(secp256k1Base(A))   => #invField(A, #k256P, secp256k1Base())\n    80\t  rule invV(secp256k1Scalar(A)) => #invField(A, #k256N, secp256k1Scalar())\n    81\t  rule invV(secp256r1Base(A))   => #invField(A, #p256P, secp256r1Base())\n    82\t  rule invV(secp256r1Scalar(A)) => #invField(A, #p256N, secp256r1Scalar())\n    83\t  rule invV(curve25519Base(A))  => #invField(A, #c25519P, curve25519Base())\n    84\t  rule invV(curve25519Scalar(A))=> #invField(A, #c25519L, curve25519Scalar())\n    85\t  rule invV(A) => vErr(\"Unsupported inversion of \" +String tn(A)) [owise]\n    86\t  syntax ValueResult ::= #invField(Int, Int, IrType) [function, total]\n    87\t  rule #invField(0, _, T) => vErr(\"cannot invert zero of type \" +String typeName(T))\n    88\t  rule #invField(A, P, T) => vOk(#wrapField(finv(A, P), T)) requires A =/=Int 0\n    89\t  syntax Value ::= #wrapField(Int, IrType) [function, total]\n    90\t  rule #wrapField(X, native())          => native(X)\n    91\t  rule #wrapField(X, secp256k1Base())   => secp256k1Base(X)\n    92\t  rule #wrapField(X, secp256k1Scalar()) => secp256k1Scalar(X)\n    93\t  rule #wrapField(X, secp256r1Base())   => secp256r1Base(X)\n    94\t  rule #wrapField(X, secp256r1Scalar()) => secp256r1Scalar(X)\n    95\t  rule #wrapField(X, curve25519Base())  => curve25519Base(X)\n    96\t  rule #wrapField(X, curve25519Scalar())=> curve25519Scalar(X)\n    97\t  rule #wrapField(X, jubjubScalar())    => jubjubScalar(X)\n    98\t  rule #wrapField(X, _)                 => native(X) [owise]\n    99\t\n   100\t  // --- test_eq / constrain_eq / cond_select --------------------------------------------\n   101\t  syntax Bool ::= eqSupported(Value, Value) [function, total]\n   102\t  rule eqSupported(A, B) => sameType(A, B)\n   103\t  syntax ValueResult ::= testEqV(Value, Value) [function, total]\n   104\t  rule testEqV(A, B) => vOk(native(bool2Word(A ==K B))) requires sameType(A, B)\n   105\t  rule testEqV(A, B) => vErr(\"Unsupported test_eq: \" +String tn(A) +String \" == \" +String tn(B)) requires notBool sameType(A, B)\n   106\t  syntax Int ::= bool2Word(Bool) [function, total]\n   107\t  rule bool2Word(true) => 1\n   108\t  rule bool2Word(false) => 0\n   109\t\n   110\t  syntax CheckResult ::= constrainEqV(Value, Value) [function, total]\n   111\t  rule constrainEqV(A, B) => cErr(\"Unsupported constrain_eq: \" +String tn(A) +String \" == \" +String tn(B)) requires notBool sameType(A, B)\n   112\t  rule constrainEqV(A, B) => cOk() requires sameType(A, B) andBool A ==K B\n   113\t  rule constrainEqV(A, B) => cErr(\"Equality constraint failed\") requires sameType(A, B) andBool A =/=K B\n   114\t\n   115\t  syntax ValueResult ::= selectV(Bool, Value, Value) [function, total]\n   116\t  rule selectV(_, A, B) => vErr(\"Unsupported cond_select: \" +String tn(A) +String \" ? \" +String tn(B)) requires notBool sameType(A, B)\n   117\t  rule selectV(true, A, B) => vOk(A) requires sameType(A, B)\n   118\t  rule selectV(false, A, B) => vOk(B) requires sameType(A, B)\n   119\t\n   120\t  // --- curves ------------------------------------------------------------------------\n   121\t  syntax ValueResult ::= ecMulV(Value, Value) [function, total]\n   122\t  rule ecMulV(jubjubPoint(P), jubjubScalar(S))         => vOk(jubjubPoint(ecMul(#jubjub, P, S)))\n   123\t  rule ecMulV(secp256k1Point(P), secp256k1Scalar(S))   => vOk(secp256k1Point(ecMul(#secp256k1, P, S)))\n   124\t  rule ecMulV(secp256r1Point(P), secp256r1Scalar(S))   => vOk(secp256r1Point(ecMul(#secp256r1, P, S)))\n   125\t  rule ecMulV(curve25519Point(P), curve25519Scalar(S)) => vOk(curve25519Point(ecMul(#curve25519, P, S)))\n   126\t  rule ecMulV(A, B) => vErr(\"Unsupported EC multiplication: \" +String tn(A) +String \" x \" +String tn(B)) [owise]\n   127\t\n   128\t  syntax ValueResult ::= ecMulGeneratorV(Value) [function, total]\n   129\t  rule ecMulGeneratorV(jubjubScalar(S))    => vOk(jubjubPoint(ecMul(#jubjub, #jubjubGenerator, S)))\n   130\t  rule ecMulGeneratorV(secp256k1Scalar(S)) => vOk(secp256k1Point(ecMul(#secp256k1, #secp256k1Generator, S)))\n   131\t  rule ecMulGeneratorV(A) => vErr(\"Unsupported EcMulGenerator for scalar of type \" +String tn(A)) [owise]\n   132\t\n   133\t  syntax PairResult ::= intoCoordinatesV(Value) [function, total]\n   134\t  rule intoCoordinatesV(jubjubPoint(pt(X, Y)))     => pOk(native(X), native(Y))\n   135\t  rule intoCoordinatesV(jubjubPoint(inf()))        => pOk(native(0), native(1))\n   136\t  rule intoCoordinatesV(secp256k1Point(inf()))     => pErr(\"Cannot extract coordinates of the Secp256k1 identity\")\n   137\t  rule intoCoordinatesV(secp256k1Point(pt(X, Y)))  => pOk(secp256k1Base(X), secp256k1Base(Y))\n   138\t  rule intoCoordinatesV(secp256r1Point(inf()))     => pErr(\"Cannot extract coordinates of the Secp256r1 identity\")\n   139\t  rule intoCoordinatesV(secp256r1Point(pt(X, Y)))  => pOk(secp256r1Base(X), secp256r1Base(Y))\n   140\t  rule intoCoordinatesV(curve25519Point(pt(X, Y))) => pOk(curve25519Base(X), curve25519Base(Y))\n   141\t  rule intoCoordinatesV(curve25519Point(inf()))    => pOk(curve25519Base(0), curve25519Base(1))\n   142\t  rule intoCoordinatesV(A) => pErr(\"Unsupported coordinate extraction of \" +String tn(A)) [owise]\n   143\t\n   144\t  syntax ValueResult ::= fromCoordinatesV(Value, Value) [function, total]\n   145\t  rule fromCoordinatesV(native(X), native(Y))                 => #ptToValue(jubjubFromXY(X, Y), #jubjub, jubjubPoint(), \"Cannot build a Jubjub point\")\n   146\t  rule fromCoordinatesV(secp256k1Base(X), secp256k1Base(Y))   => #ptToValue(fromXY(#secp256k1, X, Y), #secp256k1, secp256k1Point(), \"Cannot build a Secp256k1Point point\")\n   147\t  rule fromCoordinatesV(secp256r1Base(X), secp256r1Base(Y))   => #ptToValue(fromXY(#secp256r1, X, Y), #secp256r1, secp256r1Point(), \"Cannot build a Secp256r1Point point\")\n   148\t  rule fromCoordinatesV(curve25519Base(X), curve25519Base(Y)) => #ptToValue(fromXY(#curve25519, X, Y), #curve25519, curve25519Point(), \"Cannot build a Curve25519Point point\")\n   149\t  rule fromCoordinatesV(A, B) => vErr(\"Unsupported `from_coordinates` on (\" +String tn(A) +String \", \" +String tn(B) +String \")\") [owise]\n   150\t  syntax ValueResult ::= #ptToValue(PointResult, Curve, IrType, String) [function, total]\n   199\t  syntax ValueResult ::= #bin2(ValueResult, ValueResult, String) [function, total]\n   200\t  rule #bin2(vErr(S), _, _) => vErr(S)\n   201\t  rule #bin2(vOk(_), vErr(S), _) => vErr(S)\n   202\t  rule #bin2(vOk(A), vOk(B), \"add\") => addV(A, B)\n   203\t  rule #bin2(vOk(A), vOk(B), \"mul\") => mulV(A, B)\n   204\t  rule #bin2(vOk(A), vOk(B), \"test_eq\") => testEqV(A, B)\n   205\t  rule #bin2(vOk(A), vOk(B), \"ec_mul\") => ecMulV(A, B)\n   206\t  rule #bin2(vOk(A), vOk(B), \"bytes32_from_low_high\") => #lowHighInCircuit(A, B)\n   207\t  rule #bin2(vOk(_), vOk(_), Op) => vErr(\"unknown op \" +String Op) [owise]\n   208\t\n   209\t  // arithmetic: output must equal the off-circuit result; unsupported types are\n   210\t  // synthesis errors (same dispatch as off-circuit for add/mul/neg/inv/ec_mul)\n   211\t  rule eval(gate(add(A, B, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)), #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips),\n   212\t      #matches(#bin2(rd(A, M), rd(B, M), \"add\"), rdId(O, M), \"add output\"))))\n   213\t  rule eval(gate(mul(A, B, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(B, M)), #and(#chipsForValues(#vals(rd(A, M), rd(B, M)), Chips),\n   214\t      #matches(#bin2(rd(A, M), rd(B, M), \"mul\"), rdId(O, M), \"mul output\"))))\n   215\t  rule eval(gate(ecMul(A, S, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#need(rd(S, M)), #and(#chipsForValues(#vals(rd(A, M), rd(S, M)), Chips),\n   216\t      #matches(#bin2(rd(A, M), rd(S, M), \"ec_mul\"), rdId(O, M), \"ec_mul output\"))))\n   217\t  rule eval(gate(neg(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"neg\"), rdId(O, M), \"neg output\")))\n   218\t  rule eval(gate(inv(A, O)), M, _, Chips) => #and(#need(rd(A, M)), #and(#chipsForValues(#vals(rd(A, M), vErr(\"\")), Chips), #matches(#un2(rd(A, M), \"inv\"), rdId(O, M), \"inv output (a * inv = 1)\")))\n   219\t  rule eval(gate(copy(A, O)), M, _, _) => #eqValues(rd(A, M), rdId(O, M), \"copy output\")\n   220\t  rule eval(gate(not(A, O)), M, _, _) => #and(#boolean(rd(A, M), \"not\"), #matches(#notOf(rd(A, M)), rdId(O, M), \"not output\"))\n   221\t  syntax ValueResult ::= #notOf(ValueResult) [function, total]\n   222\t  rule #notOf(vOk(native(X))) => vOk(native(1 -Int X)) requires X ==Int 0 orBool X ==Int 1\n   223\t  rule #notOf(_) => vErr(\"not boolean\") [owise]\n   224\t  syntax ValueResult ::= #un2(ValueResult, String) [function, total]\n   225\t  rule #un2(vErr(S), _) => vErr(S)\n   226\t  rule #un2(vOk(A), \"neg\") => negV(A)\n   227\t  rule #un2(vOk(A), \"inv\") => invV(A)\n   228\t  rule #un2(vOk(A), \"into_bytes32\") => intoBytes32V(A)\n   229\t  rule #un2(vOk(A), \"ec_mul_generator\") => ecMulGeneratorV(A)\n   230\t  rule #un2(vOk(_), Op) => vErr(\"unknown op \" +String Op) [owise]\n   231\t\n   232\t  rule eval(gate(ecMulGenerator(S, O)), M, _, Chips) => #and(#need(rd(S, M)), #and(#chipsForValues(#vals(rd(S, M), vErr(\"\")), Chips),\n   233\t      #matches(#un2(rd(S, M), \"ec_mul_generator\"), rdId(O, M), \"ec_mul_generator output\")))\n   234\t\n   235\t  // less_than: the chip rounds the bit width up to max(bits + bits % 2, 4) (finding 4)\n   236\t  rule eval(gate(lessThan(A, B, N, O)), M, _, _) => #and(#native(rd(A, M), \"less_than\"), #and(#native(rd(B, M), \"less_than\"),\n   237\t      #and(#bits(rd(A, M), #ltBits(N)), #and(#bits(rd(B, M), #ltBits(N)), #matches(#ltOf(rd(A, M), rd(B, M)), rdId(O, M), \"less_than output\")))))\n   238\t  syntax Int ::= #ltBits(Int) [function, total]\n   239\t  rule #ltBits(N) => maxInt(N +Int (N modInt 2), 4)\n   240\t  syntax ValueResult ::= #ltOf(ValueResult, ValueResult) [function, total]\n   241\t  rule #ltOf(vOk(native(A)), vOk(native(B))) => vOk(native(bool2Word(A <Int B)))\n   242\t  rule #ltOf(_, _) => vErr(\"not native\") [owise]\n   243\t\n   244\t  rule eval(gate(jubjubScalarFromNative(A, O)), M, _, Chips) => #and(#native(rd(A, M), \"jubjub_scalar_from_native\"), #and(#chipFor(jubjubScalar(), Chips),\n   245\t      #matches(#jjOf(rd(A, M)), rdId(O, M), \"jubjub_scalar_from_native output\")))\n   246\t  syntax ValueResult ::= #jjOf(ValueResult) [function, total]\n   247\t  rule #jjOf(vOk(native(X))) => vOk(jubjubScalar(X modInt #rJ))\n   248\t  rule #jjOf(_) => vErr(\"not native\") [owise]\n   249\t\n   250\t  // public_input / private_input: the register holds a value of the declared\n   251\t  // type (assign_incircuit); the guard plays no part (finding 3)\n   252\t  rule eval(gate(publicInput(_, T, O)), M, _, Chips) => #and(#need(rdId(O, M)), #and(#chipFor(T, Chips), #typed(rdId(O, M), T)))\n   253\t  rule eval(gate(privateInput(_, T, O)), M, _, Chips) => #and(#need(rdId(O, M)), #and(#chipFor(T, Chips), #typed(rdId(O, M), T)))\n   254\t  syntax Outcome ::= #typed(ValueResult, IrType) [function, total]\n   255\t  rule #typed(vOk(V), T) => holds() requires typeOf(V) ==K T\n   256\t  rule #typed(vOk(V), T) => violated(\"register has type \" +String tn(V) +String \", declared \" +String typeName(T)) requires typeOf(V) =/=K T\n   257\t  rule #typed(vErr(S), _) => unknown(S)\n   258\t\n   259\t  // div_mod_power_of_two: canonical decomposition of a native value\n   260\t  rule eval(gate(divModPowerOfTwo(V, N, (Q, (Rm, .Ids)))), M, _, _) => #and(#native(rd(V, M), \"div_mod_power_of_two\"),\n   261\t      #and(#matches(#hi(rd(V, M), N), rdId(Q, M), \"div_mod quotient\"), #matches(#lo(rd(V, M), N), rdId(Rm, M), \"div_mod remainder\")))\n   262\t  rule eval(gate(divModPowerOfTwo(_, _, _)), _, _, _) => synthErr(\"Unexpected output length of DivModPowerOfTwo instruction\") [owise]\n   263\t  syntax ValueResult ::= #hi(ValueResult, Int) [function, total]\n   264\t  rule #hi(vOk(native(X)), N) => vOk(native(highBits(X, N)))\n   265\t  rule #hi(_, _) => vErr(\"not native\") [owise]\n   266\t  syntax ValueResult ::= #lo(ValueResult, Int) [function, total]\n   267\t  rule #lo(vOk(native(X)), N) => vOk(native(lowBits(X, N)))\n   268\t  rule #lo(_, _) => vErr(\"not native\") [owise]\n   269\t\n   270\t  // reconstitute_field: divisor < 2^(255 - bits), modulus < 2^bits, output = 2^bits divisor + modulus mod r\n   271\t  rule eval(gate(reconstituteField(D, Mo, N, O)), M, _, _) => #and(#native(rd(D, M), \"reconstitute_field\"), #and(#native(rd(Mo, M), \"reconstitute_field\"),\n   272\t      #and(#bits(rd(D, M), #frBits -Int N), #and(#bits(rd(Mo, M), N), #matches(#recOf(rd(D, M), rd(Mo, M), N), rdId(O, M), \"reconstitute_field output\")))))\n   273\t  syntax ValueResult ::= #recOf(ValueResult, ValueResult, Int) [function, total]\n   274\t  rule #recOf(vOk(native(D)), vOk(native(Mo)), N) => vOk(native(((D <<Int N) +Int Mo) modInt #r))\n   275\t  rule #recOf(_, _, _) => vErr(\"not native\") [owise]\n   276\t\n   277\t  // encode\n   278\t  rule eval(gate(encode(X, Os)), M, _, Chips) => #and(#need(rd(X, M)), #and(#chipsForValues(#vals(rd(X, M), vErr(\"\")), Chips), #encMatch(rd(X, M), Os, M)))\n   279\t  syntax Outcome ::= #encMatch(ValueResult, Ids, Map) [function, total]\n   280\t  rule #encMatch(vOk(V), Os, M) => synthErr(\"Unexpected output length of encode instruction\") requires size(encodeValue(V)) =/=Int lenIds(Os)\n   281\t  rule #encMatch(vOk(V), Os, M) => #encEach(encodeValue(V), Os, M) requires size(encodeValue(V)) ==Int lenIds(Os)\n   282\t  rule #encMatch(vErr(S), _, _) => unknown(S)\n   283\t  syntax Outcome ::= #encEach(List, Ids, Map) [function, total]\n   284\t  rule #encEach(.List, .Ids, _) => holds()\n   285\t  rule #encEach(ListItem(X) L, (O, Os), M) => #and(#matches(vOk(native(X)), rdId(O, M), \"encode output\"), #encEach(L, Os, M))\n   286\t  rule #encEach(_, _, _) => holds() [owise]\n   287\t\n   288\t  // coordinates\n   289\t  rule eval(gate(intoCoordinates(P, X, Y)), M, _, Chips) => #and(#need(rd(P, M)), #and(#chipsForValues(#vals(rd(P, M), vErr(\"\")), Chips), #coordsMatch(rd(P, M), X, Y, M)))\n   290\t  syntax Outcome ::= #coordsMatch(ValueResult, String, String, Map) [function, total]\n//! Differential-testing oracle for the ZKIR-in-K semantics.\n//! Runs `IrSource::preprocess` (made `pub` by a one-line patch in this\n//! worktree) on a .zkir file and a preimage, and prints the resulting memory,\n//! public-input vector and skip vector as JSON. Field elements are decimal\n//! strings; memory values are given by their `encode_offcircuit` vectors and\n//! their variant name.\nuse std::borrow::Cow;\nuse std::collections::BTreeMap;\nuse std::fs::File;\nuse std::io::BufReader;\n\nuse midnight_zkir_v3::IrSource;\nuse midnight_zkir_v3::ir_instructions::encode::encode_offcircuit;\nuse num_bigint::BigUint;\nuse serde::{Deserialize, Serialize};\nuse transient_crypto::curve::Fr;\nuse transient_crypto::proofs::{KeyLocation, ProofPreimage};\n\n#[derive(Deserialize)]\nstruct PreimageJson {\n    inputs: Vec<String>,\n    binding_input: String,\n    #[serde(default)]\n    communications_commitment: Option<(String, String)>,\n    #[serde(default)]\n    private_transcript: Vec<String>,\n    #[serde(default)]\n    public_transcript_inputs: Vec<String>,\n    #[serde(default)]\n    public_transcript_outputs: Vec<String>,\n}\n\n#[derive(Serialize)]\nstruct MemValue {\n    variant: String,\n    encoded: Vec<String>,\n}\n\n#[derive(Serialize)]\nstruct Output