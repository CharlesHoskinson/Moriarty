erProvider, Proof, ProofPreimage, ProverKey, ProvingError, TranscriptHash, Zkir,\n    29\t};\n    30\t\n    31\tuse crate::ir_types::IrType;\n    32\t\n    33\t/// A low-level IR allowing the prover to populate circuit witnesses.\n    34\t#[cfg_attr(feature = \"proptest\", derive(Arbitrary))]\n    35\t#[derive(Default, Clone, Debug, PartialEq, Serialize, Deserialize, Serializable)]\n    36\t#[tag = \"ir-source[v3-generic]\"]\n    37\tpub struct IrSource {\n    38\t    /// The minor version of this IR.\n    39\t    pub version: IrMinorVersion,\n    40\t    /// The list of input identifiers for this circuit\n    41\t    pub inputs: Vec<TypedIdentifier>,\n    42\t    /// The output types this circuit returns, positionally. The actual\n    43\t    /// values are produced by an `Instruction::Output` terminator whose\n    44\t    /// operand list is type-checked against this signature.\n    45\t    pub outputs: Vec<IrType>,\n    46\t    /// Whether this IR should compile a communications commitment\n    47\t    pub do_communications_commitment: bool,\n    48\t    /// The sequence of instructions to run in-circuit\n    49\t    pub instructions: Arc<Vec<Instruction>>,\n    50\t}\n    51\ttag_enforcement_test!(IrSource);\n    52\ttag_enforcement_test!(ProverKey<IrSource>);\n    53\t\n    54\t#[cfg_attr(feature = \"proptest\", derive(Arbitrary))]\n    55\t#[derive(\n    56\t    Clone,\n    57\t    Debug,\n    58\t    Default,\n    59\t    PartialEq,\n    60\t    serde_repr::Serialize_repr,\n    61\t    serde_repr::Deserialize_repr,\n    62\t    Serializable,\n    63\t)]\n    64\t#[tag = \"ir-minor-version[v3]\"]\n    65\t#[repr(u8)]\n    66\t#[non_exhaustive]\n    67\tpub enum IrMinorVersion {\n    68\t    #[default]\n    69\t    V0,\n    70\t}\n    71\t\n    72\timpl Zkir for IrSource {\n    73\t    type ProverKey = midnight_zk_stdlib::MidnightPK<IrSource>;\n    74\t\n    75\t    fn check(\n    76\t        &self,\n    77\t        preimage: &ProofPreimage,\n    78\t    ) -> std::result::Result<Vec<Option<usize>>, transient_crypto::proofs::ProvingError> {\n    79\t        Ok(self.preprocess(preimage)?.pi_skips)\n    80\t    }\n    81\t\n    82\t    async fn prove(\n    83\t        &self,\n    84\t        rng: impl Rng + CryptoRng,\n    85\t        params: &impl ParamsProverProvider,\n    86\t        pk: ProverKey<Self>,\n    87\t        preimage: &ProofPreimage,\n    88\t    ) -> Result<(Proof, Vec<Fr>, Vec<Option<usize>>), ProvingError> {\n    89\t        use midnight_zk_stdlib::prove;\n    90\t\n    91\t        let params_k = params.get_params(pk.init()?.k()).await?;\n    92\t        let preproc = self.preprocess(preimage)?;\n    93\t        let pis = preproc.pis.clone();\n    94\t        let pi_skips = preproc.pi_skips.clone();\n    95\t\n    96\t        let pk = pk\n    97\t            .init()\n    98\t            .map_err(|_| anyhow::anyhow!(\"Could not init pk\"))?;\n    99\t\n   100\t        let proof = prove::<_, TranscriptHash>(params_k.as_ref(), &pk, self, &pis, preproc, rng)?;\n   101\t\n   102\t        Ok((Proof(proof), pis.into_iter().map(Fr).collect(), pi_skips))\n   103\t    }\n   104\t\n   105\t    fn k(&self) -> u8 {\n   106\t        midnight_zk_stdlib::optimal_k(self) as u8\n   107\t    }\n   108\t\n   109\t    async fn keygen_vk(\n   110\t        &self,\n   111\t        params: &impl ParamsProverProvider,\n   112\t    ) -> Result<transient_crypto::proofs::VerifierKey, anyhow::Error> {\n   113\t        use midnight_zk_stdlib::setup_vk;\n   114\t        Ok(transient_crypto::proofs::VerifierKey::from(setup_vk(\n   115\t            params.get_params(self.k()).await?.as_ref(),\n   116\t            self,\n   117\t        )))\n   118\t    }\n   119\t\n   120\t    async fn keygen(\n   121\t        &self,\n   122\t        params: &impl ParamsProverProvider,\n   123\t    ) -> Result<(ProverKey<Self>, transient_crypto::proofs::VerifierKey), anyhow::Error> {\n   124\t        use midnight_zk_stdlib::{setup_pk, setup_vk};\n   125\t        let vk = setup_vk(params.get_params(self.k()).await?.as_ref(), self);\n   126\t        let pk = setup_pk(self, &vk);\n   127\t        Ok((\n   128\t            ProverKey::from_raw(pk),\n   129\t            transient_crypto::proofs::VerifierKey::from(vk),\n   130\t        ))\n   131\t    }\n   132\t\n   133\t    fn load_ir_from_tagged(reader: impl Read + std::io::Seek) -> std::io::Result<Self> {\n   134\t        serialize::tagged_deserialize(reader)\n   135\t    }\n   136\t\n   137\t    fn load_prover_key_from_tagged(\n   138\t        reader: impl Read + std::io::Seek,\n   139\t    ) -> std::io::Result<ProverKey<Self>> {\n   140\t        serialize::tagged_deserialize(reader)\n   141\t    }\n   142\t\n   143\t    fn read_raw_pk(reader: impl Read) -> std::io::Result<Self::ProverKey> {\n   144\t        midnight_zk_stdlib::MidnightPK::<Self>::read(\n   145\t            &mut { reader },\n   146\t            midnight_proofs::utils::SerdeFormat::RawBytesUnchecked,\n   147\t        )\n   148\t    }\n   149\t\n   150\t    fn write_raw_pk(writer: impl std::io::Write, pk: &Self::ProverKey) -> std::io::Result<()> {\n   151\t        pk.write(\n   152\t            &mut { writer },\n   153\t            midnight_proofs::utils::SerdeFormat::RawBytesUnchecked,\n   154\t        )\n   155\t    }\n   156\t}\n   157\t\n   158\t/// An identifier for a variable in the circuit memory\n   159\t#[cfg_attr(feature = \"proptest\", derive(Arbitrary))]\n   160\t#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, Serializable)]\n   161\t#[tag = \"zkir-identifier[v1]\"]\n   162\tpub struct Identifier(pub String);\n   163\t\n   164\ttag_enforcement_test!(Identifier);\n   165\t\n   166\t/// A typed identifier for a variable in the circuit memory\n   167\t#[cfg_attr(feature = \"proptest\", derive(Arbitrary))]\n   168\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, Serializable)]\n   169\t#[tag = \"zkir-typed-identifier[v1]\"]\n   170\tpub struct TypedIdentifier {\n   171\t    pub(crate) name: Identifier,\n   172\t    #[serde(rename = \"type\")]\n   173\t    pub(crate) val_t: IrType,\n   174\t}\n   175\t\n   176\ttag_enforcement_test!(TypedIdentifier);\n   177\t\n   178\t/// An operand that can be either a variable reference or an immediate value\n   179\t#[cfg_attr(feature = \"proptest\", derive(Arbitrary))]\n   180\t#[derive(Clone, Debug, PartialEq)]\n   181\tpub enum Operand {\n   182\t    /// A reference to a variable in circuit memory\n   183\t    Variable(Identifier),\n   184\t    /// An immediate field element value\n   185\t    Immediate(Fr),\n   186\t}\n   187\t\n   188\timpl serde::Serialize for Operand {\n   189\t    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {\n   190\t        match self {\n   191\t            Operand::Variable(id) => serde::Serialize::serialize(&id.0, serializer),\n   192\t            Operand::Immediate(imm) => {\n   193\t                let mut repr = imm.as_le_bytes();\n   194\t                while repr.last() == Some(&0) && repr.len() > 1 {\n   195\t                    repr.pop();\n   196\t                }\n   197\t                serializer.serialize_str(&format!(\"0x{}\", const_hex::encode(&repr)))\n   198\t            }\n   199\t        }\n   200\t    }\n   201\t}\n   202\t\n   203\timpl<'de> serde::Deserialize<'de> for Operand {\n   204\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n   205\t    where\n   206\t        D: serde::Deserializer<'de>,\n   207\t    {\n   208\t        let s = <String as serde::Deserialize>::deserialize(deserializer)?;\n   209\t\n   210\t        // Check if this looks like a hex immediate (starts with \"0x\" or \"-0x\")\n   211\t        let mut repr = s.as_bytes();\n   212\t        let negate = if !repr.is_empty() && repr[0] == b'-' {\n   213\t            repr = &repr[1..];\n   214\t            true\n   215\t        } else {\n   216\t            false\n   217\t        };\n   218\t\n   219\t        if repr.starts_with(b\"0x\") || repr.starts_with(b\"0X\") {\n   220\t            let hex_str = &repr[2..];\n   221\t            if hex_str.is_empty() {\n   222\t                return Err(<D::Error as serde::de::Error>::custom(\n   223\t                    \"Invalid operand format: hex immediate must have at least one digit after '0x'\",\n   224\t                ));\n   225\t            }\n   226\t\n   227\t            let bytes = const_hex::decode(hex_str)\n   228\t                .map_err(<D::Error as serde::de::Error>::custom)?\n   229\t                .into_iter()\n   230\t                .collect::<Vec<_>>();\n   231\t            let field = Fr::from_le_bytes(&bytes).ok_or_else(|| {\n   232\t                <D::Error as serde::de::Error>::custom(\"Out of range for field element\")\n   233\t            })?;\n   234\t            Ok(Operand::Immediate(if negate { -field } else { field }))\n   235\t        } else {\n   236\t            // Variables must start with '%' in v3\n   237\t            if !s.starts_with('%') {\n   238\t                return Err(<D::Error as serde::de::Error>::custom(format!(\n   239\t                    \"Invalid operand format: '{}'. Variables must start with '%', immediates must start with '0x'\",\n   240\t                    s\n   241\t                )));\n   242\t            }\n   243\t            Ok(Operand::Variable(Identifier(s)))\n   244\t        }\n   245\t    }\n   246\t}\n   247\t\n   248\timpl Serializable for Operand {\n   249\t    fn serialize(&self, sink: &mut impl std::io::Write) -> Result<(), std::io::Error> {\n   250\t        match self {\n   251\t            Operand::Variable(id) => {\n   252\t                // Write variant tag 0 for Variable\n   253\t                Serializable::serialize(&0u8, sink)?;\n   254\t                Serializable::serialize(id, sink)\n   255\t            }\n   256\t            Operand::Immediate(imm) => {\n   257\t                // Write variant tag 1 for Immediate\n   258\t                Seriali