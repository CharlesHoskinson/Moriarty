{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba experiments/zkir-k/semantics/zkir-ext.k; cat experiments/zkir-k/semantics/zkir-check.k experiments/zkir-k/semantics/zkir-test.k experiments/zkir-k/semantics/zkir.k'","aggregated_output":"     1\t// ZKIR-EXT: the surface of the standalone midnightntwrk/midnight-zkir crate at\n     2\t// 2ffe2d1 (branch zkir-v3, midnight-zkir 3.0.0) on top of the 92e8bdd3\n     3\t// definition (plan decision CLM-0707). Differences from 92e8bdd3:\n     4\t//   types      Bool, Byte, Bytes<n> for any 1 <= n <= 2^24 (Bytes<32> is the old Bytes32;\n     5\t//              the value is kept as bytes32(_) so every base rule still applies)\n     6\t//   added      and, or, xor (Bool gates), concat, slice, nth, reverse (byte strings),\n     7\t//              load_constant (typed constant from its raw encoding), sha512\n     8\t//   removed    reverse_bytes (subsumed by reverse); tools/zkir_kast.py rejects it in --ext mode\n     9\t// Encodings (zkir/src/ir_instructions/encode.rs at 2ffe2d1): Bool and Byte are one\n    10\t// element each; Bytes<n> is ceil(n/31) elements, 31-byte little-endian chunks.\n    11\trequires \"zkir-vm.k\"\n    12\trequires \"zkir-ops.k\"\n    13\trequires \"zkir-sha512-constants.k\"\n    14\t\n    15\tmodule ZKIR-EXT-SYNTAX\n    16\t  imports ZKIR-SYNTAX\n    17\t\n    18\t  syntax IrType ::= boolT()       [symbol(Bool)]\n    19\t                  | byteT()       [symbol(Byte)]\n    20\t                  | bytesT(Int)   [symbol(BytesN)]     // Bytes<n> with n =/= 32\n    21\t  rule encodedLen(boolT())  => 1\n    22\t  rule encodedLen(byteT())  => 1\n    23\t  rule encodedLen(bytesT(N)) => (N +Int 30) /Int 31\n    24\t\n    25\t  syntax Instr ::= andI(Operands, String)                    [symbol(and)]\n    26\t                 | orI(Operands, String)                     [symbol(or)]\n    27\t                 | xorI(Operands, String)                    [symbol(xor)]\n    28\t                 | concat(Operands, String)                  [symbol(concat)]\n    29\t                 | slice(Operand, Int, Int, String)          [symbol(slice)]          // bytes, start, len, output\n    30\t                 | nth(Operand, Int, String)                 [symbol(nth)]            // bytes, index, output\n    31\t                 | reverse(Operand, String)                  [symbol(reverse)]\n    32\t                 | loadConstant(IrType, Operands, String)    [symbol(load_constant)]  // type, encoding (immediates), output\n    33\t                 | sha512(Alignment, Operands, String)       [symbol(sha512)]\n    34\t\n    35\t  rule reads(andI(Is, _))            => Is\n    36\t  rule reads(orI(Is, _))             => Is\n    37\t  rule reads(xorI(Is, _))            => Is\n    38\t  rule reads(concat(Is, _))          => Is\n    39\t  rule reads(slice(B, _, _, _))      => B, .Operands\n    40\t  rule reads(nth(B, _, _))           => B, .Operands\n    41\t  rule reads(reverse(B, _))          => B, .Operands\n    42\t  rule reads(loadConstant(_, Es, _)) => Es\n    43\t  rule reads(sha512(_, Is, _))       => Is\n    44\t  rule writes(andI(_, O))            => O, .Ids\n    45\t  rule writes(orI(_, O))             => O, .Ids\n    46\t  rule writes(xorI(_, O))            => O, .Ids\n    47\t  rule writes(concat(_, O))          => O, .Ids\n    48\t  rule writes(slice(_, _, _, O))     => O, .Ids\n    49\t  rule writes(nth(_, _, O))          => O, .Ids\n    50\t  rule writes(reverse(_, O))         => O, .Ids\n    51\t  rule writes(loadConstant(_, _, O)) => O, .Ids\n    52\t  rule writes(sha512(_, _, O))       => O, .Ids\n    53\tendmodule\n    54\t\n    55\tmodule ZKIR-EXT-VALUES\n    56\t  imports ZKIR-EXT-SYNTAX\n    57\t  imports ZKIR-VALUES\n    58\t  imports ZKIR-OPS\n    59\t\n    60\t  syntax Value ::= boolV(Bool)   [symbol(boolV)]\n    61\t                 | byteV(Int)    [symbol(byteV)]\n    62\t                 | bytesV(Bytes) [symbol(bytesV)]     // length =/= 32\n    63\t  rule typeOf(boolV(_))   => boolT()\n    64\t  rule typeOf(byteV(_))   => byteT()\n    65\t  rule typeOf(bytesV(B))  => bytesT(lengthBytes(B))\n    66\t  rule defaultValue(boolT())   => boolV(false)\n    67\t  rule defaultValue(byteT())   => byteV(0)\n    68\t  rule defaultValue(bytesT(N)) => bytesV(padRightBytes(.Bytes, N, 0))\n    69\t  rule typeName(boolT())   => \"Bool\"\n    70\t  rule typeName(byteT())   => \"Byte\"\n    71\t  rule typeName(bytesT(_)) => \"Bytes\"\n    72\t\n    73\t  // any byte string value, of either representation\n    74\t  syntax BytesResult ::= asBytesAny(Value) [function, total]\n    75\t  rule asBytesAny(bytes32(B)) => bOk(B)\n    76\t  rule asBytesAny(bytesV(B))  => bOk(B)\n    77\t  rule asBytesAny(V) => bErr(\"cannot convert \" +String tn(V) +String \" to Bytes\") [owise]\n    78\t  syntax Value ::= mkBytes(Bytes) [function, total]\n    79\t  rule mkBytes(B) => bytes32(B) requires lengthBytes(B) ==Int 32\n    80\t  rule mkBytes(B) => bytesV(B)  requires lengthBytes(B) =/=Int 32\n    81\t\n    82\t  rule encodeValue(boolV(true))  => ListItem(1)\n    83\t  rule encodeValue(boolV(false)) => ListItem(0)\n    84\t  rule encodeValue(byteV(X))     => ListItem(X)\n    85\t  rule encodeValue(bytesV(B))    => #encChunks(B)\n    86\t  syntax List ::= #encChunks(Bytes) [function, total]\n    87\t  rule #encChunks(B) => .List requires lengthBytes(B) ==Int 0\n    88\t  rule #encChunks(B) => ListItem(Bytes2Int(substrBytes(B, 0, minInt(31, lengthBytes(B))), LE, Unsigned)) #encChunks(substrBytes(B, minInt(31, lengthBytes(B)), lengthBytes(B)))\n    89\t    requires lengthBytes(B) >Int 0\n    90\t\n    91\t  rule decodeValue(ListItem(0), boolT()) => decOk(boolV(false))\n    92\t  rule decodeValue(ListItem(1), boolT()) => decOk(boolV(true))\n    93\t  rule decodeValue(Fs, boolT()) => decErr(\"Failed to decode as Bool\") [owise]\n    94\t  rule decodeValue(ListItem(X), byteT()) => decOk(byteV(X)) requires fitsBits(X, 8)\n    95\t  rule decodeValue(Fs, byteT()) => decErr(\"Failed to decode as Byte\") [owise]\n    96\t  rule decodeValue(Fs, bytesT(N)) => decErr(\"Failed to decode as Bytes\") requires size(Fs) =/=Int (N +Int 30) /Int 31\n    97\t  rule decodeValue(Fs, bytesT(N)) => #decChunks(Fs, N, .Bytes) requires size(Fs) ==Int (N +Int 30) /Int 31\n    98\t  syntax DecodeResult ::= #decChunks(List, Int, Bytes) [function, total]\n    99\t  rule #decChunks(.List, 0, Acc) => decOk(mkBytes(Acc))\n   100\t  rule #decChunks(.List, N, _) => decErr(\"Failed to decode as Bytes\") requires N =/=Int 0\n   101\t  rule #decChunks(ListItem(F) Fs, N, Acc) => #decChunks(Fs, N -Int minInt(31, N), Acc +Bytes Int2Bytes(minInt(31, N), F, LE))\n   102\t    requires N >Int 0 andBool fitsBits(F, 8 *Int minInt(31, N))\n   103\t  rule #decChunks(ListItem(F) _, N, _) => decErr(\"Failed to decode as Bytes\")\n   104\t    requires N <=Int 0 orBool notBool fitsBits(F, 8 *Int minInt(31, N))\n   105\tendmodule\n   106\t\n   107\t// SHA-512 (FIPS 180-4), 64-bit words, 80 rounds, 128-byte blocks.\n   108\tmodule ZKIR-SHA512\n   109\t  imports ZKIR-HASH\n   110\t  imports ZKIR-SHA512-CONSTANTS\n   111\t\n   112\t  syntax Int ::= rotr64(Int, Int) [function, total]\n   113\t  rule rotr64(X, N) => ((X >>Int N) |Int (X <<Int (64 -Int N))) &Int #m64\n   114\t  syntax Int ::= add64(Int, Int) [function, total]\n   115\t  rule add64(A, B) => (A +Int B) &Int #m64\n   116\t\n   117\t  syntax Bytes ::= sha512Bytes(Bytes) [function, total]\n   118\t  rule sha512Bytes(M) => #sha512Blocks(#sha512Pad(M), 0, #sha512H0)\n   119\t  syntax Bytes ::= #sha512Pad(Bytes) [function, total]\n   120\t  rule #sha512Pad(M) => padRightBytes(M +Bytes Int2Bytes(1, 128, BE), ((lengthBytes(M) +Int 17 +Int 127) /Int 128) *Int 128 -Int 16, 0) +Bytes Int2Bytes(16, lengthBytes(M) *Int 8, BE)\n   121\t  syntax Bytes ::= #sha512Blocks(Bytes, Int, List) [function, total]\n   122\t  rule #sha512Blocks(P, Off, H) => #sha512Out(H) requires Off >=Int lengthBytes(P)\n   123\t  rule #sha512Blocks(P, Off, H) => #sha512Blocks(P, Off +Int 128, #sha512Compress(#sha512Schedule(substrBytes(P, Off, Off +Int 128), 0, .List), H))\n   124\t    requires Off <Int lengthBytes(P)\n   125\t  syntax Bytes ::= #sha512Out(List) [function, total]\n   126\t  rule #sha512Out(.List) => .Bytes\n   127\t  rule #sha512Out(ListItem(W) Ws) => Int2Bytes(8, W, BE) +Bytes #sha512Out(Ws)\n   128\t  syntax List ::= #sha512Schedule(Bytes, Int, List) [function, total]\n   129\t  rule #sha512Schedule(B, T, W) => #sha512Schedule(B, T +Int 1, W ListItem(Bytes2Int(substrBytes(B, 8 *Int T, 8 *Int T +Int 8), BE, Unsigned)))\n   130\t    requires T <Int 16\n   131\t  rule #sha512Schedule(B, T, W) => #sha512Schedule(B, T +Int 1, W ListItem(add64(add64(#t1({W[T -Int 2]}:>Int), {W[T -Int 7]}:>Int), add64(#t0({W[T -Int 15]}:>Int), {W[T -Int 16]}:>Int))))\n   132\t    requires T >=Int 16 andBool T <Int 80\n   133\t  rule #sha512Schedule(_, T, W) => W requires T >=Int 80\n   134\t  syntax Int ::= #t0(Int) [function, total]\n   135\t  rule #t0(X) => rotr64(X, 1) xorInt rotr64(X, 8) xorInt (X >>Int 7)\n   136\t  syntax Int ::= #t1(Int) [function, total]\n   137\t  rule #t1(X) => rotr64(X, 19) xorInt rotr64(X, 61) xorInt (X >>Int 6)\n   138\t  syntax Int ::= #T0(Int) [function, total]\n   139\t  rule #T0(X) => rotr64(X, 28) xorInt rotr64(X, 34) xorInt rotr64(X, 39)\n   140\t  syntax Int ::= #T1(Int) [function, total]\n   141\t  rule #T1(X) => rotr64(X, 14) xorInt rotr64(X, 18) xorInt rotr64(X, 41)\n   142\t  syntax List ::= #sha512Compress(List, List) [function, total]\n   143\t  rule #sha512Compress(W, H) => #sha512AddH(#sha512Round(W, 0, H), H)\n   144\t  syntax List ::= #sha512Round(List, Int, List) [function, total]\n   145\t  rule #sha512Round(_, T, V) => V requires T >=Int 80\n   146\t  rule #sha512Round(W, T, ListItem(A) ListItem(B) ListItem(C) ListItem(D) ListItem(E) ListItem(F) ListItem(G) ListItem(HH))\n   147\t    => #sha512Round(W, T +Int 1, #sha512Next(A, B, C, D, E, F, G,\n   148\t         add64(add64(add64(add64(HH, #T1(E)), (E &Int F) xorInt ((E xorInt #m64) &Int G)), {#sha512Ks[T]}:>Int), {W[T]}:>Int),\n   149\t         add64(#T0(A), (A &Int B) xorInt (A &Int C) xorInt (B &Int C))))\n   150\t    requires T <Int 80\n   151\t  syntax List ::= #sha512Next(Int, Int, Int, Int, Int, Int, Int, Int, Int) [function, total]\n   152\t  rule #sha512Next(A, B, C, D, E, F, G, T1, T2)\n   153\t    => ListItem(add64(T1, T2)) ListItem(A) ListItem(B) ListItem(C) ListItem(add64(D, T1)) ListItem(E) ListItem(F) ListItem(G)\n   154\t  syntax List ::= #sha512AddH(List, List) [function, total]\n   155\t  rule #sha512AddH(.List, .List) => .List\n   156\t  rule #sha512AddH(ListItem(X) Xs, ListItem(Y) Ys) => ListItem(add64(X, Y)) #sha512AddH(Xs, Ys)\n   157\t  rule #sha512AddH(_, _) => .List [owise]\n   158\tendmodule\n   159\t\n   160\tmodule ZKIR-EXT\n   161\t  imports ZKIR-VM\n   162\t  imports ZKIR-EXT-VALUES\n   163\t  imports ZKIR-SHA512\n   164\t\n   165\t  // The 2ffe2d1 decoder re-encodes every decoded value and rejects\n   166\t  // non-canonical encodings; switch the base VM to strict decoding before the\n   167\t  // first job step (higher priority than the base job rule).\n   168\t  rule <k> job(P, Pre) => job(P, Pre) ... </k> <strictDecode> false => true </strictDecode> [priority(30)]\n   169\t  rule <k> genJob(P, Pre) => genJob(P, Pre) ... </k> <strictDecode> false => true </strictDecode> [priority(30)]\n   170\t\n   171\t  // neg on a Bool is logical negation at 2ffe2d1 (neg.rs)\n   172\t  rule negV(boolV(B)) => vOk(boolV(notBool B))\n   173\t\n   174\t  // --- boolean gates ---------------------------------------------------------------------\n   175\t  rule <k> #exec(andI(Is, O)) => #put(O, #boolGate(resolveAll(Is, M), \"and\")) ... </k> <mem> M </mem> <status> ok() </status>\n   176\t  rule <k> #exec(orI(Is, O))  => #put(O, #boolGate(resolveAll(Is, M), \"or\"))  ... </k> <mem> M </mem> <status> ok() </status>\n   177\t  rule <k> #exec(xorI(Is, O)) => #put(O, #boolGate(resolveAll(Is, M), \"xor\")) ... </k> <mem> M </mem> <status> ok() </status>\n   178\t  syntax ValueResult ::= #boolGate(ValuesResult, String) [function, total]\n   179\t  rule #boolGate(vsErr(S), _) => vErr(S)\n   180\t  rule #boolGate(vsOk(.List), _) => vErr(\"Boolean gate requires at least one input\")\n   181\t  rule #boolGate(vsOk(Vs), Op) => #boolFold(Vs, Op, #boolInit(Op)) requires size(Vs) >Int 0\n   182\t  syntax Bool ::= #boolInit(String) [function, total]\n   183\t  rule #boolInit(\"and\") => true\n   184\t  rule #boolInit(_) => false [owise]\n   185\t  syntax ValueResult ::= #boolFold(List, String, Bool) [function, total]\n   186\t  rule #boolFold(.List, _, Acc) => vOk(boolV(Acc))\n   187\t  rule #boolFold(ListItem(boolV(B)) Vs, \"and\", Acc) => #boolFold(Vs, \"and\", Acc andBool B)\n   188\t  rule #boolFold(ListItem(boolV(B)) Vs, \"or\", Acc)  => #boolFold(Vs, \"or\", Acc orBool B)\n   189\t  rule #boolFold(ListItem(boolV(B)) Vs, \"xor\", Acc) => #boolFold(Vs, \"xor\", Acc xorBool B)\n   190\t  rule #boolFold(ListItem(V:Value) _, _, _) => vErr(\"Boolean gate expects Bool inputs, found \" +String tn(V)) [owise]\n   191\t  rule #boolFold(ListItem(_) _, _, _) => vErr(\"Boolean gate expects Bool inputs\") [owise]\n   192\t\n   193\t  // --- byte strings ------------------------------------------------------------------------\n   194\t  rule <k> #exec(concat(Is, O)) => #put(O, #concat(resolveAll(Is, M), .Bytes)) ... </k> <mem> M </mem> <status> ok() </status>\n   195\t  syntax ValueResult ::= #concat(ValuesResult, Bytes) [function, total]\n   196\t  rule #concat(vsErr(S), _) => vErr(S)\n   197\t  rule #concat(vsOk(.List), Acc) => vErr(\"Concat requires at least one byte of input\") requires lengthBytes(Acc) ==Int 0\n   198\t  rule #concat(vsOk(.List), Acc) => vOk(mkBytes(Acc)) requires lengthBytes(Acc) >Int 0\n   199\t  rule #concat(vsOk(ListItem(byteV(X)) Vs), Acc) => #concat(vsOk(Vs), Acc +Bytes Int2Bytes(1, X, LE))\n   200\t  rule #concat(vsOk(ListItem(bytesV(B)) Vs), Acc) => #concat(vsOk(Vs), Acc +Bytes B)\n   201\t  rule #concat(vsOk(ListItem(bytes32(B)) Vs), Acc) => #concat(vsOk(Vs), Acc +Bytes B)\n   202\t  rule #concat(vsOk(ListItem(V:Value) _), _) => vErr(\"Concat expects Byte or Bytes inputs, found \" +String tn(V)) [owise]\n   203\t  rule #concat(vsOk(ListItem(_) _), _) => vErr(\"Concat expects Byte or Bytes inputs\") [owise]\n   204\t\n   205\t  rule <k> #exec(slice(B, S, L, O)) => #put(O, #slice(resolve(B, M), S, L)) ... </k> <mem> M </mem> <status> ok() </status>\n   206\t  syntax ValueResult ::= #slice(ValueResult, Int, Int) [function, total]\n   207\t  rule #slice(vErr(S), _, _) => vErr(S)\n   208\t  rule #slice(vOk(V), S, L) => #slice2(asBytesAny(V), S, L)\n   209\t  syntax ValueResult ::= #slice2(BytesResult, Int, Int) [function, total]\n   210\t  rule #slice2(bErr(S), _, _) => vErr(S)\n   211\t  rule #slice2(bOk(_), _, 0) => vErr(\"slice length must be at least 1\")\n   212\t  rule #slice2(bOk(B), S, L) => vErr(\"slice out of bounds\") requires L >Int 0 andBool S +Int L >Int lengthBytes(B)\n   213\t  rule #slice2(bOk(B), S, L) => vOk(mkBytes(substrBytes(B, S, S +Int L))) requires L >Int 0 andBool S +Int L <=Int lengthBytes(B)\n   214\t\n   215\t  rule <k> #exec(nth(B, I, O)) => #put(O, #nth(resolve(B, M), I)) ... </k> <mem> M </mem> <status> ok() </status>\n   216\t  syntax ValueResult ::= #nth(ValueResult, Int) [function, total]\n   217\t  rule #nth(vErr(S), _) => vErr(S)\n   218\t  rule #nth(vOk(V), I) => #nth2(asBytesAny(V), I)\n   219\t  syntax ValueResult ::= #nth2(BytesResult, Int) [function, total]\n   220\t  rule #nth2(bErr(S), _) => vErr(S)\n   221\t  rule #nth2(bOk(B), I) => vErr(\"nth out of bounds\") requires I >=Int lengthBytes(B)\n   222\t  rule #nth2(bOk(B), I) => vOk(byteV(B[I])) requires I <Int lengthBytes(B)\n   223\t\n   224\t  rule <k> #exec(reverse(B, O)) => #put(O, #rev(resolve(B, M))) ... </k> <mem> M </mem> <status> ok() </status>\n   225\t  syntax ValueResult ::= #rev(ValueResult) [function, total]\n   226\t  rule #rev(vErr(S)) => vErr(S)\n   227\t  rule #rev(vOk(V)) => #rev2(asBytesAny(V))\n   228\t  syntax ValueResult ::= #rev2(BytesResult) [function, total]\n   229\t  rule #rev2(bErr(S)) => vErr(S)\n   230\t  rule #rev2(bOk(B)) => vOk(mkBytes(reverseBytes(B)))\n   231\t\n   232\t  // --- constants and sha512 ------------------------------------------------------------------\n   233\t  rule <k> #exec(loadConstant(T, Es, O)) => #put(O, #toValue(decodeStrict(#immInts(Es), T, true))) ... </k> <status> ok() </status>\n   234\t  syntax List ::= #immInts(Operands) [function, total]\n   235\t  rule #immInts(.Operands) => .List\n   236\t  rule #immInts((imm(I), Es)) => ListItem(I) #immInts(Es)\n   237\t  rule #immInts((var(_), Es)) => #immInts(Es)\n   238\t\n   239\t  rule <k> #exec(sha512(Al, Xs, O)) => #put(O, #sha512V(resolveAll(Xs, M), Al)) ... </k> <mem> M </mem> <status> ok() </status>\n   240\t  syntax ValueResult ::= #sha512V(ValuesResult, Alignment) [function, total]\n   241\t  rule #sha512V(vsErr(S), _) => vErr(S)\n   242\t  rule #sha512V(vsOk(Vs), Al) => #sha512V2(asNatives(Vs), Al)\n   243\t  syntax ValueResult ::= #sha512V2(IntsResult, Alignment) [function, total]\n   244\t  rule #sha512V2(isErr(S), _) => vErr(S)\n   245\t  rule #sha512V2(isOk(L), Al) => #sha512V3(alignedBytes(Al, L))\n   246\t  syntax ValueResult ::= #sha512V3(BytesResult) [function, total]\n   247\t  rule #sha512V3(bErr(S)) => vErr(S)\n   248\t  rule #sha512V3(bOk(B)) => vOk(bytesV(sha512Bytes(B)))\n   249\t\n   250\t  // --- in-circuit relations of the extension gates ------------------------------------------------\n   251\t  // Boolean gates and sha512 are functional relations over their inputs;\n   252\t  // concat / slice / nth / reverse select wires and impose no constraints beyond\n   253\t  // the output being the selected bytes; load_constant fixes its output.\n   254\t  rule eval(gate(andI(Is, O)), M, _, _)   => #matches(#boolGate(resolveAll(Is, M), \"and\"), rdId(O, M), \"and output\")\n   255\t  rule eval(gate(orI(Is, O)), M, _, _)    => #matches(#boolGate(resolveAll(Is, M), \"or\"), rdId(O, M), \"or output\")\n   256\t  rule eval(gate(xorI(Is, O)), M, _, _)   => #matches(#boolGate(resolveAll(Is, M), \"xor\"), rdId(O, M), \"xor output\")\n   257\t  rule eval(gate(concat(Is, O)), M, _, _) => #matches(#concat(resolveAll(Is, M), .Bytes), rdId(O, M), \"concat output\")\n   258\t  rule eval(gate(slice(B, S, L, O)), M, _, _) => #matches(#slice(rd(B, M), S, L), rdId(O, M), \"slice output\")\n   259\t  rule eval(gate(nth(B, I, O)), M, _, _)  => #matches(#nth(rd(B, M), I), rdId(O, M), \"nth output\")\n   260\t  rule eval(gate(reverse(B, O)), M, _, _) => #matches(#rev(rd(B, M)), rdId(O, M), \"reverse output\")\n   261\t  rule eval(gate(loadConstant(T, Es, O)), M, _, _) => #matches(#toValue(decodeStrict(#immInts(Es), T, true)), rdId(O, M), \"load_constant output\")\n   262\t  rule eval(gate(sha512(Al, Xs, O)), M, _, Chips) => #and(#needAll(Xs, M), #and(#chipNamed(\"sha2_512\", Chips), #matches(#sha512V(resolveAll(Xs, M), Al), rdId(O, M), \"sha512 output\")))\n   263\t  rule #chipsOfInstrs((sha512(_, _, _) ; Is)) => SetItem(\"sha2_512\") |Set #chipsOfInstrs(Is)\n   264\tendmodule\n// Main module for milestone 2: parse (via pyk) and statically check a program.\n// krun over a Program term leaves wfOk() or wfError(msg) in the <k> cell.\nrequires \"zkir-syntax.k\"\n\nmodule ZKIR-CHECK\n  imports ZKIR-WF\n\n  configuration\n    <zkir-check>\n      <k> $PGM:Program </k>\n    </zkir-check>\n\n  rule <k> P:Program => wf(P) </k>\nendmodule\n// Function-evaluation harness for unit tests (tools/unit_values.py): the\n// program is any K term; krun normalises it.\nrequires \"zkir-values.k\"\nrequires \"zkir-constants.k\"\nrequires \"zkir-hash.k\"\nrequires \"zkir-ops.k\"\n\nmodule ZKIR-TEST\n  imports ZKIR-VALUES\n  imports ZKIR-CONSTANTS\n  imports ZKIR-HASH\n  imports ZKIR-OPS\n\n  configuration <zkir-test> <k> $PGM:KItem </k> </zkir-test>\nendmodule\n// Main module: run job(program, preimage) with ZKIR-VM.\nrequires \"zkir-vm.k\"\n\nmodule ZKIR\n  imports ZKIR-VM\nendmodule\n","exit_code":0,"status":"completed"}}
