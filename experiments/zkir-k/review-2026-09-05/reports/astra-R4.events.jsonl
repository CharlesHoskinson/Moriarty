 45\t\n    46\tdef I(n: int) -> KInner:\n    47\t    return intToken(n)\n    48\t\n    49\t\n    50\tdef klist(items):\n    51\t    t = KApply('.List')\n    52\t    for it in reversed(items):\n    53\t        t = KApply('_List_', [KApply('ListItem', [it]), t])\n    54\t    return t\n    55\t\n   115\tdigest32 = hashlib.sha256(pre32).digest()\n   116\tcheck('sha256 bytes(32) alignment vs hashlib', pretty_list(m['%s32']['encoded']), pretty_list([int.from_bytes(digest32[:31], 'little'), digest32[31]]))\n   117\talign32 = K('alignment', K('segments', K('atom', K('bytesAtom', I(32))), K('.segments')))\n   118\tcheck('alignedBytes bytes(32)', run(K('alignedBytes', align32, klist([I(a), I(c)]))), f'bOk ( {run(kbytes(pre32))} )')\n   119\tcheck('sha256 bytes(32) vs oracle', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(pre32))))), pretty_list(m['%s32']['encoded']))\n   120\tcheck('keccak256 bytes(32) vs oracle', run(K('encodeValue', K('bytes32V', K('keccak256Bytes', kbytes(pre32))))), pretty_list(m['%k32']['encoded']))\n   121\t# field + bytes(6): 32 LE bytes of c, then 6 bytes of a\n   122\tpref = c.to_bytes(32, 'little') + a.to_bytes(6, 'little')\n   123\talignf = K('alignment', K('segments', K('atom', K('fieldAtom')), K('segments', K('atom', K('bytesAtom', I(6))), K('.segments'))))\n   124\tcheck('alignedBytes field+bytes(6)', run(K('alignedBytes', alignf, klist([I(c), I(a)]))), f'bOk ( {run(kbytes(pref))} )')\n   125\tcheck('sha256 field+bytes(6) vs oracle', run(K('encodeValue', K('bytes32V', K('sha256Bytes', kbytes(pref))))), pretty_list(m['%sf']['encoded']))\n   126\t# bytes(200) from 7 elements + field: six 31-byte chunks (elements 1..6 reversed), then 200 % 31 = 14 stray bytes from element 0\n   127\tels = [a, b, c, a, b, c, a]\n   128\t# bytes_from_field_repr: the 31-byte chunks come first (elements after the stray one, reversed), the stray bytes last\n   129\tpre200 = b''.join(e.to_bytes(31, 'little') for e in reversed(els[1:])) + els[0].to_bytes(14, 'little') + c.to_bytes(32, 'little')\n   130\tassert len(pre200) == 232\n   131\tcheck('keccak256 bytes(200)+field vs oracle', run(K('encodeValue', K('bytes32V', K('keccak256Bytes', kbytes(pre200))))), pretty_list(m['%k200']['encoded']))\n   132\talign200 = K('alignment', K('segments', K('atom', K('bytesAtom', I(200))), K('segments', K('atom', K('fieldAtom')), K('.segments'))))\n   133\tcheck('alignedBytes bytes(200)+field', run(K('alignedBytes', align200, klist([I(v) for v in els + [c]]))), f'bOk ( {run(kbytes(pre200))} )')\n   134\t\n   135\tprint(f'\\n{sum(checks)}/{len(checks)} checks passed')\n   136\tsys.exit(0 if all(checks) else 1)\n   175\tcheck('jubjub d', K('#jubjubD'), str(JUBJUB_D))\n   176\tcheck('jubjub G on curve', K('onCurve', K('#jubjub'), pt(*JUBJUB_G)), 'true')\n   177\tG8 = ed_mul(JUBJUB_G, 8, R, JUBJUB_D)\n   178\tcheck('jubjub subgroup generator = 8G', K('#jubjubGenerator'), pretty_pt(G8))\n   179\tcheck('jubjub 8G in subgroup', K('inSubgroup', K('#jubjub'), pt(*G8)), 'true')\n   180\tcheck('jubjub G not in subgroup', K('inSubgroup', K('#jubjub'), pt(*JUBJUB_G)), 'false')\n   181\tcheck('jubjub 12345 * 8G', K('ecMul', K('#jubjub'), pt(*G8), I(12345)), pretty_pt(ed_mul(G8, 12345, R, JUBJUB_D)))\n   182\tcheck('curve25519 B on curve', K('onCurve', K('#curve25519'), pt(*C25519_G)), 'true')\n   183\tcheck('curve25519 B in subgroup', K('inSubgroup', K('#curve25519'), pt(*C25519_G)), 'true')\n   184\tcheck('curve25519 7 * B', K('ecMul', K('#curve25519'), pt(*C25519_G), I(7)), pretty_pt(ed_mul(C25519_G, 7, C25519P, C25519_D)))\n   185\tcheck('secp256k1 G on curve', K('onCurve', K('#secp256k1'), pt(*K256_G)), 'true')\n   186\tcheck('secp256k1 n * G = inf', K('ecMul', K('#secp256k1'), pt(*K256_G), I(K256N)), 'inf ( )')\n   187\tcheck('secp256k1 999 * G', K('ecMul', K('#secp256k1'), pt(*K256_G), I(999)), pretty_pt(w_mul(K256_G, 999, K256P, 0)))\n   188\tcheck('secp256r1 G on curve', K('onCurve', K('#secp256r1'), pt(*P256_G)), 'true')\n   189\tcheck('sec