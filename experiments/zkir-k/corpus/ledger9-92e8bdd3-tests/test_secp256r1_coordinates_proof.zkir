{
  "version": {
    "major": 3,
    "minor": 0
  },
  "inputs": [
    {
      "name": "%pp",
      "type": "Point<Secp256r1>"
    }
  ],
  "outputs": [],
  "do_communications_commitment": false,
  "instructions": [
    {
      "op": "into_coordinates",
      "point": "%pp",
      "outputs": [
        "%px",
        "%py"
      ]
    },
    {
      "op": "private_input",
      "type": "Base<Secp256r1>",
      "guard": null,
      "output": "%px_exp"
    },
    {
      "op": "private_input",
      "type": "Base<Secp256r1>",
      "guard": null,
      "output": "%py_exp"
    },
    {
      "op": "constrain_eq",
      "a": "%px",
      "b": "%px_exp"
    },
    {
      "op": "constrain_eq",
      "a": "%py",
      "b": "%py_exp"
    },
    {
      "op": "from_coordinates",
      "inputs": [
        "%px",
        "%py"
      ],
      "output": "%pp_reconstructed"
    },
    {
      "op": "constrain_eq",
      "a": "%pp_reconstructed",
      "b": "%pp"
    }
  ]
}
