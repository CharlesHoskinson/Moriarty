{
 "version": {
  "major": 3,
  "minor": 0
 },
 "inputs": [
  {
   "name": "%p",
   "type": "Point<Jubjub>"
  },
  {
   "name": "%q",
   "type": "Point<Jubjub>"
  },
  {
   "name": "%s",
   "type": "Scalar<Jubjub>"
  },
  {
   "name": "%x",
   "type": "Scalar<BLS12-381>"
  },
  {
   "name": "%y",
   "type": "Scalar<BLS12-381>"
  }
 ],
 "outputs": [],
 "do_communications_commitment": false,
 "instructions": [
  {
   "op": "add",
   "a": "%p",
   "b": "%q",
   "output": "%sum"
  },
  {
   "op": "neg",
   "a": "%p",
   "output": "%negp"
  },
  {
   "op": "add",
   "a": "%sum",
   "b": "%negp",
   "output": "%q2"
  },
  {
   "op": "test_eq",
   "a": "%q2",
   "b": "%q",
   "output": "%eq"
  },
  {
   "op": "assert",
   "cond": "%eq"
  },
  {
   "op": "constrain_eq",
   "a": "%q2",
   "b": "%q"
  },
  {
   "op": "ec_mul",
   "a": "%p",
   "scalar": "%s",
   "output": "%ps"
  },
  {
   "op": "into_coordinates",
   "point": "%p",
   "outputs": [
    "%px",
    "%py"
   ]
  },
  {
   "op": "from_coordinates",
   "inputs": [
    "%x",
    "%y"
   ],
   "output": "%p2"
  },
  {
   "op": "constrain_eq",
   "a": "%p2",
   "b": "%p"
  },
  {
   "op": "encode",
   "input": "%ps",
   "outputs": [
    "%e0",
    "%e1"
   ]
  },
  {
   "op": "cond_select",
   "bit": "%eq",
   "a": "%p",
   "b": "%q",
   "output": "%sel"
  },
  {
   "op": "ec_mul_generator",
   "scalar": "%s",
   "output": "%gs"
  }
 ]
}
