{
 "version": {
  "major": 3,
  "minor": 0
 },
 "inputs": [
  {
   "name": "%x",
   "type": "Scalar<BLS12-381>"
  },
  {
   "name": "%y",
   "type": "Scalar<BLS12-381>"
  },
  {
   "name": "%enable",
   "type": "Point<Jubjub>"
  }
 ],
 "outputs": [],
 "do_communications_commitment": false,
 "instructions": [
  {
   "op": "from_coordinates",
   "inputs": [
