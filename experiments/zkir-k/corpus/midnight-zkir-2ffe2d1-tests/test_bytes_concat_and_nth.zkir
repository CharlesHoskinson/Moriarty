{
  "version": {
    "major": 3,
    "minor": 0
  },
  "inputs": [
    {
      "name": "%a",
      "type": "Byte"
    },
    {
      "name": "%b",
      "type": "Byte"
    },
    {
      "name": "%s",
      "type": "Bytes<2>"
    }
  ],
  "outputs": [],
  "do_communications_commitment": false,
  "instructions": [
    {
      "op": "concat",
      "inputs": [
        "%a",
        "%b"
      ],
      "output": "%ab"
    },
    {
      "op": "concat",
      "inputs": [
        "%s",
        "%a"
      ],
      "output": "%sa"
    },
    {
      "op": "nth",
      "bytes": "%ab",
      "index": 0,
      "output": "%ab0"
    },
    {
      "op": "nth",
      "bytes": "%ab",
      "index": 1,
      "output": "%ab1"
    },
    {
      "op": "nth",
      "bytes": "%sa",
      "index": 2,
      "output": "%sa2"
    },
    {
      "op": "constrain_eq",
      "a": "%ab0",
      "b": "%a"
    },
    {
      "op": "constrain_eq",
      "a": "%ab1",
      "b": "%b"
    },
    {
      "op": "constrain_eq",
      "a": "%sa2",
      "b": "%a"
    },
    {
      "op": "private_input",
      "type": "Bytes<3>",
      "guard": null,
      "output": "%sa_exp"
    },
    {
      "op": "constrain_eq",
      "a": "%sa",
      "b": "%sa_exp"
    }
  ]
}
