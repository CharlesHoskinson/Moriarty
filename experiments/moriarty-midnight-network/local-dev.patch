diff --git a/src/public-wallet.ts b/src/public-wallet.ts
new file mode 100644
index 0000000..22fe22b
--- /dev/null
+++ b/src/public-wallet.ts
@@ -0,0 +1,25 @@
+import { readFile } from 'node:fs/promises';
+import { nativeToken } from '@midnight-ntwrk/midnight-js-protocol/ledger';
+import * as Rx from 'rxjs';
+import { PreprodConfig } from './config.js';
+import { buildWallet, closeWallet } from './wallet.js';
+
+const seedPath = process.argv[2];
+if (!seedPath) throw new Error('usage: npm run public-wallet -- /absolute/path/to/seed');
+
+const config = new PreprodConfig();
+const seed = (await readFile(seedPath, 'utf8')).trim();
+const ctx = await buildWallet(config, { kind: 'seed', value: seed });
+try {
+  const address = ctx.unshieldedKeystore.getBech32Address().asString();
+  console.log(JSON.stringify({ network: config.networkId, address, faucet: config.faucet, status: 'syncing' }));
+  const state = await Rx.firstValueFrom(ctx.wallet.state().pipe(
+    Rx.filter((s) => s.isSynced),
+    Rx.timeout({ first: 600_000 }),
+  ));
+  const night = state.unshielded.balances[nativeToken().raw] ?? 0n;
+  const dust = state.dust.balance(new Date());
+  console.log(JSON.stringify({ network: config.networkId, address, night: night.toString(), dust: dust.toString(), faucet: config.faucet }));
+} finally {
+  await closeWallet(ctx);
+}
