//// GENERATED by author-tools/p3s1r1_fixtures.py r1 (P3S1-R1, AUTH). Do not edit.
////
//// W1 hand edit (not regenerated): the named-component helpers now come from the
//// test-only `pvc2/diag` module instead of `pvc2/thread`/`pvc2/claim`. Test names,
//// bodies, expected lists and `fail` flags are unchanged.
////
//// Expected values are the R1 author's: the fixtures are rebuilt by the R1 author's
//// generator, and every expected `false_parts` list is the R1 author's source-trace
//// prediction of which named production gate components refuse. Not an independent
//// oracle; nothing here has been compiled or executed.
////
//// Evidence classes (EXPECTED-CASES-R1.json `r1.evidence`):
//// - POSITIVE: the production gate holds, no component is False, and (settle) the
////   production `settle_checks` returns one signature check per intent.
//// - BOOLEAN: the gate evaluates without error and exactly the listed components are
////   False (rule-level evidence for those components; a non-empty list also refuses).
//// - ERROR-PATH: an `expect` halts S2 before the gate exists. These remain `fail` tests:
////   an error is refusal evidence only, never isolation evidence.

use aiken/builtin
use aiken/collection/list
use cardano/transaction.{OutputReference, Transaction}
use pvc2/claim
use pvc2/diag.{SettleFactsV2}
use pvc2/fixtures_r1 as fx
use pvc2/test_ctx
use pvc2/thread
use pvc2/types.{
  Close, EnvV2, Genesis, Revoke, S2Mint, SettleRedeemerV2, ThreadDatumV2,
}

fn settle_parts(
  ctx: ByteArray,
) -> (ThreadDatumV2, OutputReference, SettleRedeemerV2, Transaction) {
  let (own_ref, raw, rd, tx) = test_ctx.spending_of(ctx)
  expect td: ThreadDatumV2 = raw
  expect r: SettleRedeemerV2 = rd
  (td, own_ref, r, tx)
}

fn facts_with(c2: ByteArray, ctx: ByteArray) -> SettleFactsV2 {
  let (td, own_ref, r, tx) = settle_parts(ctx)
  diag.settle_facts(c2, td, own_ref, r, tx)
}

fn facts(ctx: ByteArray) -> SettleFactsV2 {
  facts_with(fx.c2_hash, ctx)
}

/// POSITIVE settle: gate holds, no False component, and the production `settle_checks`
/// returns `n` signature checks.
fn accepted(ctx: ByteArray, n: Int) -> Bool {
  let f = facts(ctx)
  let (td, own_ref, r, tx) = settle_parts(ctx)
  and {
    f.gate,
    diag.false_parts(f.parts) == [],
    list.length(thread.settle_checks(fx.c2_hash, td, own_ref, r, tx)) == n,
  }
}

/// BOOLEAN settle refusal: exactly `names` are False.
fn refused_with(c2: ByteArray, ctx: ByteArray, names: List<ByteArray>) -> Bool {
  let f = facts_with(c2, ctx)
  and {
    !f.gate,
    diag.false_parts(f.parts) == names,
  }
}

/// ERROR-PATH settle: the production check list (`fail` tests pass on error or False).
fn checks_pass(ctx: ByteArray) -> Bool {
  let (td, own_ref, r, tx) = settle_parts(ctx)
  !list.is_empty(thread.settle_checks(fx.c2_hash, td, own_ref, r, tx))
}

fn full(ctx: ByteArray) -> Bool {
  let (td, own_ref, r, tx) = settle_parts(ctx)
  thread.settle(fx.c2_hash, td, own_ref, r, tx)
}

fn serialise(td: ThreadDatumV2) -> ByteArray {
  let d: Data = td
  builtin.serialise_data(d)
}

fn facts_match(
  ctx: ByteArray,
  stmt: ByteArray,
  stmt_digest: ByteArray,
  shape_digest: ByteArray,
  catalogue_digest: ByteArray,
  scenario_hash: ByteArray,
  intents_digest: ByteArray,
  datum_post: ByteArray,
  messages: List<(ByteArray, ByteArray)>,
) -> Bool {
  let f = facts(ctx)
  and {
    f.statement == stmt,
    f.statement_digest == stmt_digest,
    f.shape_digest == shape_digest,
    f.catalogue_digest == catalogue_digest,
    f.scenario_hash == scenario_hash,
    f.intents_digest == intents_digest,
    serialise(f.next) == datum_post,
    f.messages == messages,
    f.gate,
  }
}

fn genesis_false(ctx: ByteArray) -> List<ByteArray> {
  let (policy, rd, tx) = test_ctx.minting_of(ctx)
  expect m: S2Mint = rd
  expect Genesis { seed } = m
  diag.false_parts(diag.genesis_parts(fx.c2_hash, policy, seed, tx))
}

fn genesis_ok(ctx: ByteArray) -> Bool {
  let (policy, rd, tx) = test_ctx.minting_of(ctx)
  expect m: S2Mint = rd
  expect Genesis { seed } = m
  thread.genesis(fx.c2_hash, policy, seed, tx)
}

fn revoke_args(
  ctx: ByteArray,
) -> (ThreadDatumV2, OutputReference, ByteArray, ByteArray, Int, Transaction) {
  let (own_ref, raw, rd, tx) = test_ctx.spending_of(ctx)
  expect td: ThreadDatumV2 = raw
  expect r: SettleRedeemerV2 = rd
  expect Revoke { signer, signature, continuation } = r
  (td, own_ref, signer, signature, continuation, tx)
}

fn revoke_false(ctx: ByteArray) -> List<ByteArray> {
  let (td, own_ref, signer, signature, continuation, tx) = revoke_args(ctx)
  diag.false_parts(
    diag.revoke_parts(td, own_ref, signer, signature, continuation, tx),
  )
}

fn revoke_ok(ctx: ByteArray) -> Bool {
  let (td, own_ref, signer, signature, continuation, tx) = revoke_args(ctx)
  thread.revoke(td, own_ref, signer, signature, continuation, tx)
}

fn close_args(ctx: ByteArray) -> (ThreadDatumV2, OutputReference, Int, Transaction) {
  let (own_ref, raw, rd, tx) = test_ctx.spending_of(ctx)
  expect td: ThreadDatumV2 = raw
  expect r: SettleRedeemerV2 = rd
  expect Close { reserve_output } = r
  (td, own_ref, reserve_output, tx)
}

fn close_false(ctx: ByteArray) -> List<ByteArray> {
  let (td, own_ref, reserve_output, tx) = close_args(ctx)
  diag.false_parts(diag.close_parts(td, own_ref, reserve_output, tx))
}

fn close_ok(ctx: ByteArray) -> Bool {
  let (td, own_ref, reserve_output, tx) = close_args(ctx)
  thread.close(td, own_ref, reserve_output, tx)
}

fn release_false(ctx: ByteArray) -> List<ByteArray> {
  let (own_ref, raw, _, tx) = test_ctx.spending_of(ctx)
  expect env: EnvV2 = raw
  diag.false_parts(diag.release_parts(own_ref, raw, env, tx))
}

fn release_ok(ctx: ByteArray) -> Bool {
  let (own_ref, raw, _, tx) = test_ctx.spending_of(ctx)
  expect env: EnvV2 = raw
  claim.release(own_ref, raw, env, tx)
}

