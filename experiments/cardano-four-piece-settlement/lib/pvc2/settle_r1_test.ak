}

test h54_r1_refuses() fail {
  release_ok(fx.ctx_h54)
}

/// P13 ACCEPT (POSITIVE): claim refund after expiry
test p13_r1_accept() {
  release_ok(fx.ctx_p13) && release_false(fx.ctx_p13) == []
}

/// H55 CLAIM_REFUND_EARLY (BOOLEAN): refund with validity lower bound at expiry
test h55_r1_parts() {
