}

/// H53 CLAIM_RELEASE_SIGNER (BOOLEAN): claimant does not sign
test h53_r1_parts() {
  release_false(fx.ctx_h53) == ["claimant_signs"]
}

test h53_r1_refuses() fail {
  release_ok(fx.ctx_h53)
}

