/// Sequential composition: each step's spent datum equals the previous continuation.
test sequential_chain_invoice_r1() {
  let (td2, _, _, _) = settle_parts(fx.ctx_p02)
  let (td3, _, _, _) = settle_parts(fx.ctx_p03)
  serialise(td2) == fx.datum_post_p01 && serialise(td3) == fx.datum_post_p02
}

test sequential_chain_reserve_r1() {
  let (td5, _, _, _) = settle_parts(fx.ctx_p05)
  serialise(td5) == fx.datum_post_p04
}

