// ## Revocation message bytes (unchanged by R1)

test p10_r1_revocation_message_matches_fixture() {
  let (own_ref, raw, _, _) = test_ctx.spending_of(fx.ctx_p10)
  expect td: ThreadDatumV2 = raw
  thread.revocation_message(td, own_ref, "escrow") == fx.revoke_msg_p10
}
