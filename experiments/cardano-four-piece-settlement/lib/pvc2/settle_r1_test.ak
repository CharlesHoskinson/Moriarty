}

test h55_r1_refuses() fail {
  release_ok(fx.ctx_h55)
}

/// H56 SHAPE_CELLS (BOOLEAN): RR-01 regression: catalogue-pinned shape cells [(CASH, escrow), (CASH, escrow)], Transfer 0->1 of 50, forged digest; escrow intent (beneficiary escrow, gross_cap 50, net_floor 0) passes check_effects with net 0; under P3S1 every gate conjunct holds and custody falls by 50,000,000 lovelace with no payout
test h56_r1_parts() {
  refused_with(fx.c2_hash, fx.ctx_h56, ["shape_cells"])
}

/// H57 SHAPE_CELLS (BOOLEAN): distinct but unsorted cells [(CASH, seller), (CASH, escrow)] pinned by the catalogue; legitimate effects
test h57_r1_parts() {
  refused_with(fx.c2_hash, fx.ctx_h57, ["shape_cells"])
}

/// H60 SHAPE_DIGEST (BOOLEAN): isolating rebuild of H37: redeemer shape statement_count 9 instead of 8, forged digest over that shape
test h60_r1_parts() {
  refused_with(fx.c2_hash, fx.ctx_h60, ["shape_digest"])
}

/// P14 ACCEPT (POSITIVE): exclusive validity bounds (999,999, 2,000,001) normalise to the intent window [1,000,000, 2,000,000]
test p14_r1_accept() {
  accepted(fx.ctx_p14, 2)
}

/// H61 INTENT_WINDOW (BOOLEAN): exclusive upper bound 2,000,002 normalises to 2,000,001 > not_after 2,000,000
test h61_r1_parts() {
  refused_with(fx.c2_hash, fx.ctx_h61, ["intent_window"])
}

/// H62 INTENT_WINDOW (BOOLEAN): infinite upper validity bound
test h62_r1_parts() {
  refused_with(fx.c2_hash, fx.ctx_h62, ["intent_window"])
}

/// H64 CLAIM_DUPLICATE (ERROR-PATH): two claim inputs name the same outref
