// Generated lowering experiment for Moriarty Core escrow.
// This is research code, not an audited contract.

pragma language_version >= 0.26 && <= 0.26;
import CompactStandardLibrary;

export enum Phase { Waiting, Funded, Released, Refunded }
export new type PartySecret = Bytes<32>;

export sealed ledger buyer: UserAddress;
export sealed ledger seller: UserAddress;
export sealed ledger buyerAuthority: Bytes<32>;
export sealed ledger tokenColor: Bytes<32>;
export sealed ledger amount: Uint<128>;
export sealed ledger deadline: Uint<64>;
export ledger phase: Phase;

witness partySecret(): PartySecret;

constructor(
  initialBuyer: UserAddress,
  initialSeller: UserAddress,
  initialBuyerAuthority: Bytes<32>,
  initialTokenColor: Bytes<32>,
  initialAmount: Uint<128>,
  initialDeadline: Uint<64>
) {
  buyer = disclose(initialBuyer);
  seller = disclose(initialSeller);
  buyerAuthority = disclose(initialBuyerAuthority);
  tokenColor = disclose(initialTokenColor);
  amount = disclose(initialAmount);
  deadline = disclose(initialDeadline);
  assert(amount > 0, "Moriarty escrow amount must be positive");
  phase = Phase.Waiting;
}

circuit authorityOfWitness(): Bytes<32> {
  return persistentHash<PartySecret>(partySecret());
}

export circuit fund(): [] {
  assert(phase == Phase.Waiting, "Moriarty escrow is not waiting for funds");
  assert(buyerAuthority == authorityOfWitness(), "buyer authorization failed");
  receiveUnshielded(tokenColor, amount);
  phase = Phase.Funded;
}

export circuit release(): [] {
  assert(phase == Phase.Funded, "Moriarty escrow is not funded");
  assert(buyerAuthority == authorityOfWitness(), "buyer authorization failed");
  sendUnshielded(
    tokenColor,
    amount,
    right<ContractAddress, UserAddress>(seller)
  );
  phase = Phase.Released;
}

export circuit refundAfterTimeout(): [] {
  assert(phase == Phase.Funded, "Moriarty escrow is not funded");
  assert(blockTimeGte(deadline), "Moriarty escrow deadline has not passed");
  sendUnshielded(
    tokenColor,
    amount,
    right<ContractAddress, UserAddress>(buyer)
  );
  phase = Phase.Refunded;
}
