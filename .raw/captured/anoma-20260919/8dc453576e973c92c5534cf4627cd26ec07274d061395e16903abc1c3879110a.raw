error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"33:I[55169,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"TOCProvider\"]\n34:I[769,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"Sidebar\"]\n35:I[47486,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"ClientWrapper\"]\n36:T14e4,"])</script><script>self.__next_f.push([1,"# API Clients\n\nThe `api` module provides four typed HTTP clients for communicating with Anoma Pay backend services. All clients extend the `ApiClient` base class which handles response parsing and error wrapping.\n\n```ts\nimport {\n  TransferBackendClient,\n  IndexerClient,\n  EnvioClient,\n  FeedbackClient,\n} from \"@anomaorg/anoma-app-sdk\";\n```\n\n## TransferBackendClient\n\nCommunicates with the proving backend. This is the primary client for submitting transactions and monitoring their status.\n\n```ts\nconst backend = new TransferBackendClient(backendUrl);\n```\n\n### Methods\n\n#### `transfer(parameters)`\n\nSubmits a built `Parameters` payload to the backend for proving and on-chain submission.\n\n```ts\nconst { transaction_hash } = await backend.transfer(parameters);\n// transaction_hash is a UUID string identifying the job\n```\n\n#### `transactionStatus(uuid)`\n\nPolls the status of a submitted transaction. Call repeatedly until the status reaches a terminal state.\n\n```ts\nconst { status, hash } = await backend.transactionStatus(uuid);\n// status: \"New\" | \"Proving\" | \"Proven\" | \"Submitted\" | \"Failed\" | \"Unprocessable\"\n// hash: on-chain transaction hash (set once Proven)\n```\n\n#### `estimateFee(props)`\n\nReturns a fee breakdown before submission. The response includes a base fee, a per-resource fee, and a percentage of the transfer amount.\n\n```ts\nconst fee = await backend.estimateFee({\n  fee_token: \"USDC\",      // \"USDC\" | \"USDT\" | \"WETH\" | \"XAN\"\n  transaction: parameters,\n});\n// fee.base_fee, fee.base_fee_per_resource, fee.percentage_fee, fee.token_type\n```\n\n#### `tokenPrice(tokenAddress)`\n\nReturns the current USD price of a token.\n\n```ts\nconst { price } = await backend.tokenPrice(\"0xA0b86991...\"); // USDC contract\n```\n\n#### `tokenBalances(walletAddress)`\n\nReturns the ERC-20 token balances held by an EVM wallet address.\n\n```ts\nconst balances = await backend.tokenBalances(\"0xYourAddress\");\n```\n\n#### `statsQueue()`\n\nReturns the current proving queue statistics. Use this to detect heavy load.\n\n```ts\nconst { created, completed, processing } = await backend.statsQueue();\n```\n\n---\n\n## IndexerClient\n\nCommunicates with the Indexer service, which tracks and stores encrypted resource payloads on-chain.\n\n```ts\nconst indexer = new IndexerClient(indexerUrl);\n```\n\n### Methods\n\n#### `config()`\n\nReturns the Indexer's health status and the list of contracts it is currently indexing. Use this to get the `indexed_contracts` list to pass to `resources()`.\n\n```ts\nconst { status, version, indexed_contracts } = await indexer.config();\n```\n\nThe `indexed_contracts` array contains entries with `chain_id`, `contract_address`, and `last_block`.\n\n#### `addKeys(keypair)`\n\nRegisters a discovery key pair with the Indexer so it can route incoming resources to you. Call this once after creating a new keyring.\n\n```ts\nimport { toHex } from \"@anomaorg/anoma-app-sdk\";\n\nawait indexer.addKeys({\n  public_key: toHex(keyring.discoveryKeyPair.publicKey),\n  secret_key: toHex(keyring.discoveryKeyPair.privateKey),\n});\n```\n\n#### `resources(discoveryPrivateKey, contracts)`\n\nFetches encrypted resource blobs from the Indexer for each contract. The Indexer uses the discovery private key to look up blobs tagged for that key.\n\n```ts\nimport { toHex } from \"@anomaorg/anoma-app-sdk\";\n\nconst { resources } = await indexer.resources(\n  toHex(keyring.discoveryKeyPair.privateKey),\n  indexed_contracts\n);\n// resources: IndexerResource[] — each has resource_payload.blob and transaction_hash\n```\n\n---\n\n## EnvioClient\n\nQueries the Envio GraphQL endpoint for public nullifier records. These are used to determine which resources have been spent.\n\n```ts\nconst envio = new EnvioClient(envioUrl);\n```\n\n### Methods\n\n#### `publicNullifiers(logicRef, timestamp?)`\n\nReturns all public nullifiers for the given logic reference. Use `TRANSFER_LOGIC_VERIFYING_KEY` as the `logicRef` for standard transfer resources. Optionally pass a `timestamp` to fetch only nullifiers from that Unix timestamp onwards.\n\n```ts\nimport { TRANSFER_LOGIC_VERIFYING_KEY } from \"@anomaorg/anoma-app-sdk\";\n\nconst nullifiers = await envio.publicNullifiers(TRANSFER_LOGIC_VERIFYING_KEY);\n// nullifiers: NullifierRecord[] — each has id, nullifier (hex), transaction\n```\n\nThen pass the result to `buildTransactionLookup()`:\n\n```ts\nimport { buildTransactionLookup } from \"@anomaorg/anoma-app-sdk\";\n\nconst lookup = buildTransactionLookup(nullifiers);\n```\n\n---\n\n## FeedbackClient\n\nSubmits user feedback to the Anoma Pay feedback service.\n\n```ts\nconst feedback = new FeedbackClient(feedbackUrl);\n```\n\n### Methods\n\n#### `submit(props)`\n\n```ts\nconst { id } = await feedback.submit({\n  title: \"Bug report\",\n  description: \"Transaction failed unexpectedly.\",\n  tag: \"bug\",\n});\n```\n\n---\n\n## Error handling\n\nAll clients throw `ResponseError` when the server returns a non-2xx response:\n\n```ts\nimport { ResponseError } from \"@anomaorg/anoma-app-sdk\";\n\ntry {\n  await backend.transfer(parameters);\n} catch (err) {\n  if (err instanceof ResponseError) {\n    console.error(\"Status:\", err.status);\n    console.error(\"Response body:\", err.json);\n  }\n}\n```\n\nUse the `getFirstErrorMessage` utility to extract a user-readable message from any error type:\n\n```ts\nimport { getFirstErrorMessage } from \"@anomaorg/anoma-app-sdk\";\n\nconst message = getFirstErrorMessage(err);\n// Handles ResponseError, ZodError, and standard Error\n```"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"x:mx-auto x:flex x:max-w-(--nextra-content-width)\",\"children\":[\"$\",\"$L33\",null,{\"value\":[{\"value\":\"TransferBackendClient\",\"id\":\"transferbackendclient\",\"depth\":2},{\"value\":\"Methods\",\"id\":\"methods\",\"depth\":3},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"transfer(parameters)\"}]]}]],\"id\":\"transferparameters\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"transactionStatus(uuid)\"}]]}]],\"id\":\"transactionstatusuuid\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"estimateFee(props)\"}]]}]],\"id\":\"estimatefeeprops\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"tokenPrice(tokenAddress)\"}]]}]],\"id\":\"tokenpricetokenaddress\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"tokenBalances(walletAddress)\"}]]}]],\"id\":\"tokenbalanceswalletaddress\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"statsQueue()\"}]]}]],\"id\":\"statsqueue\",\"depth\":4},{\"value\":\"IndexerClient\",\"id\":\"indexerclient\",\"depth\":2},{\"value\":\"Methods\",\"id\":\"methods-1\",\"depth\":3},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"config()\"}]]}]],\"id\":\"config\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"addKeys(keypair)\"}]]}]],\"id\":\"addkeyskeypair\",\"depth\":4},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"resources(discoveryPrivateKey, contracts)\"}]]}]],\"id\":\"resourcesdiscoveryprivatekey-contracts\",\"depth\":4},{\"value\":\"EnvioClient\",\"id\":\"envioclient\",\"depth\":2},{\"value\":\"Methods\",\"id\":\"methods-2\",\"depth\":3},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"publicNullifiers(logicRef, timestamp?)\"}]]}]],\"id\":\"publicnullifierslogicref-timestamp\",\"depth\":4},{\"value\":\"FeedbackClient\",\"id\":\"feedbackclient\",\"depth\":2},{\"value\":\"Methods\",\"id\":\"methods-3\",\"depth\":3},{\"value\":[[\"$\",\"$1\",\".0\",{\"children\":[[\"$\",\"code\",\".0\",{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"submit(props)\"}]]}]],\"id\":\"submitprops\",\"depth\":4},{\"value\":\"Error handling\",\"id\":\"error-handling\",\"depth\":2}],\"children\":[[\"$\",\"$L34\",null,{}],[\"$\",\"$L35\",null,{\"metadata\":\"$2:props:children:1:props:children:props:children:props:children:2:props:pageMap:21:frontMatter\",\"bottomContent\":\"$undefined\",\"sourceCode\":\"$36\",\"children\":[\"$L37\",\"$L38\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"39:I[83987,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"ToggleWordWrapButton\"]\n3a:I[63894,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"HeadingAnchor\"]\n37:[\"$\",\"div\",null,{\"id\":\"nextra-skip-nav\"}]\n"])</script><script>self.__next_f.push([1,"38:[\"$\",\"main\",null,{\"data-pagefind-body\":true,\"children\":[[\"$\",\"h1\",null,{\"id\":\"$undefined\",\"className\":\"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-bold x:mt-2 x:text-4xl\",\"children\":[\"API Clients\",\"$undefined\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":[\"The \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"api\"}],\" module provides four typed HTTP clients for communicating with Anoma Pay backend services. All clients extend the \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"ApiClient\"}],\" base class which handles response parsing and error wrapping.\"]}],\"\\n\",[\"$\",\"div\",null,{\"data-pagefind-ignore\":\"all\",\"className\":\"nextra-code x:relative x:not-first:mt-[1.25em]\",\"children\":[\"$undefined\",[\"$\",\"pre\",null,{\"className\":\"x:group x:focus-visible:nextra-focus x:overflow-x-auto x:subpixel-ant