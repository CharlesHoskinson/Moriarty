<span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">const</span><span style="--shiki-light:#005CC5;--shiki-dark:#79B8FF"> nullifiers</span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583"> =</span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583"> await</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8"> envio.</span><span style="--shiki-light:#6F42C1;--shiki-dark:#B392F0">publicNullifiers</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">(</span><span style="--shiki-light:#005CC5;--shiki-dark:#79B8FF">TRANSFER_LOGIC_VERIFYING_KEY</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">);</span></span>
