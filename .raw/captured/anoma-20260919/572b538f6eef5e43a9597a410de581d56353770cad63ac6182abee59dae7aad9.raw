te-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border\",\"children\":[\"Transient custody\",[\"$\",\"$L39\",null,{\"id\":\"transient-custody\"}]]}]\n46:[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":\"The forwarder is a conduit, not a vault. Funds flow through it within a single atomic transaction, unwrapped in, traded, and pulled back out before the transaction ends. The contract itself documents the consequence:\"}]\n47:[\"$\",\"blockquote\",null,{\"className\":\"x:not-first:mt-[1.25em] x:border-gray-300 x:italic x:text-gray-700 x:dark:border-gray-700 x:dark:text-gray-400 x:border-s-2 x:ps-[1.5em]\",\"children\":[\"\\n\",[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":\"Because any caller can forward and execute arbitrary calls through this contract, funds and other state held by it are only under a given user’s control transiently, during the atomic execution of the transaction. Any funds or state remaining after the action may be modified by subsequent callers.\"}],\"\\n\"]}]\n48:[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":[\"In addition, the forwarder exposes a permissionless \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"sweep(token, to)\"}],\" that transfers its \",[\"$\",\"strong\",null,{\"children\":\"entire balance\"}],\" of any token (or native currency) to any address, so residual balances should be treated as donated to the public.\"]}]\n49:[\"$\",\"div\",null,{\"className\":\"[\u0026_p]:not-first:mt-1.5 [\u0026_p]:leading-snug mt-8 px-6 py-4 x:bg-primary-100 text-sm leading-snug rounded-md italic dark:!bg-neutral-700\",\"children\":[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":\"A well-formed generic call must leave zero residual balance in the forwarder. Anything left behind after the transaction (over-delivered swap output, unused approvals’ underlying funds, stray transfers to the forwarder address) is claimable by anyone.\"}]}]\n4a:[\"$\",\"h2\",null,{\"id\":\"deployments\",\"className\":\"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border\",\"children\":[\"Deployments\",[\"$\",\"$L39\",null,{\"id\":\"deployments\"}]]}]\n"])</script><script>self.__next_f.push([1,"4b:[\"$\",\"table\",null,{\"className\":\"x:block x:overflow-x-auto nextra-scrollbar x:not-first:mt-[1.25em] x:p-0\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"Chain\",\"className\":\"x:m-0 x:border x:border-gray-300 x:px-4 x:py-2 x:font-semibold x:dark:border-gray-600\"}],[\"$\",\"th\",null,{\"children\":\"Address\",\"className\":\"x:m-0 x:border x:border-gray-300 x:px-4 x:py-2 x:font-semibold x:dark:border-gray-600\"}]],\"className\":\"x:m-0 x:border-t x:border-gray-300 x:p-0 x:dark:border-gray-600 x:even:bg-gray-100 x:even:dark:bg-gray-600/20\"}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Ethereum\",\"className\":\"x:m-0 x:border x:border-gray-300 x:px-4 x:py-2 x:dark:border-gray-600\"}],[\"$\",\"td\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"https://etherscan.io/address/0x4220bcB4A9c755aeE676c675cCc8a113e2A48274\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma\",\"children\":[[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"0x4220bcB4A9c755aeE676c675cCc8a113e2A48274\"}],false]}],\"className\":\"x:m-0 x:border x:border-gray-300 x:px