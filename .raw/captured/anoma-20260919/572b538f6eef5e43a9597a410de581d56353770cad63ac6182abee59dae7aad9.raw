r. There is no other path to \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"forwardCall\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]\",\"children\":[\"The input is decoded as a \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"Call[]\"}],\" and executed \",[\"$\",\"strong\",null,{\"children\":\"in order\"}],\". A call with calldata is a contract call; a call with only a value transfers native tokens; an empty call reverts. There are no restrictions on targets or function selectors. The authorization model is that the signed action tree, not the contract, decides what runs.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]\",\"children\":[\"Nested \",[\"$\",\"code\",null,{\"className\":\"nextra-code\",\"dir\":\"ltr\",\"children\":\"forwardCall\"}],\"s are blocked by the reentrancy guard, but a single transaction may contain several sequential generic calls.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]\",\"children\":\"The protocol adapter verifies the returned bytes against an expected output committed in the transaction, so even the call results are covered by the commitment scheme.\"}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"43:[\"$\",\"h3\",null,{\"id\":\"signature-validation-by-commitment\",\"className\":\"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl\",\"children\":[\"Signature validation by commitment\",[\"$\",\"$L39\",null,{\"id\":\"signature-validation-by-commitment\"}]]}]\n"])</script><script>self.__next_f.push([1,"44:[\"$\",\"p\",null,{\"className\":\"not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200\",\"children\":[\"The forwarder implements \",[\"$\",\"a\",nul