-1.5 x:whitespace-nowrap x:opacity-0 x:text-xs x:font-medium x:transition x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100" aria-hidden="true" type="button" disabled="" data-headlessui-state="disabled" data-disabled="">Scroll to top<svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" height="1.1em" class="x:-rotate-90 x:border x:rounded-full x:border-current"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></nav><article class="x:w-full x:min-w-0 x:break-words x:min-h-[calc(100vh-var(--nextra-navbar-height))] x:text-slate-700 x:dark:text-slate-200 x:pb-8 x:px-4 x:pt-4 x:md:px-12"><div class="nextra-breadcrumb x:mt-1.5 x:flex x:items-center x:gap-1 x:overflow-hidden x:text-sm x:text-gray-600 x:dark:text-gray-400 x:contrast-more:text-current"><span class="x:whitespace-nowrap x:transition-colors x:font-medium x:text-black x:dark:text-gray-100" title="The Anoma Protocol Adapter"><span class="grid grid-cols-[max-content_auto] gap-2"><span class="inline-flex w-full h-[1.15em] mt-[0.1em]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M3.125 3.125H14.0625V14.0625H3.125V3.125Z" stroke="currentColor" stroke-width="1.25"></path><path d="M6.25 3.125V0" stroke="currentColor" stroke-width="1.25"></path><path d="M10.9375 3.125V0" stroke="currentColor" stroke-width="1.25"></path><path d="M6.25 17.1875V14.0625" stroke="currentColor" stroke-width="1.25"></path><path d="M10.9375 17.1875V14.0625" stroke="currentColor" stroke-width="1.25"></path><path d="M14.0625 6.25H17.1875" stroke="currentColor" stroke-width="1.25"></path><path d="M14.0625 10.9375H17.1875" stroke="currentColor" stroke-width="1.25"></path><path d="M0 6.25H3.125" stroke="currentColor" stroke-width="1.25"></path><path d="M0 10.9375H3.125" stroke="currentColor" stroke-width="1.25"></path><path d="M11.7188 10.9375H8.59375" stroke="currentColor" stroke-width="1.25"></path></svg></span>The Anoma Protocol Adapter</span></span></div><div class="x:border x:inline-flex x:rounded-md x:items-stretch nextra-border x:float-end x:overflow-hidden"><button class="x:transition x:cursor-pointer x:ps-2 x:pe-1 x:flex x:gap-2 x:text-sm x:font-medium x:items-center" type="button" data-headlessui-state=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4C2.89543 15 2 14.1046 2 13V4C2 2.89543 2.89543 2 4 2H13C14.1046 2 15 2.89543 15 4V5"></path></svg>Copy page</button><button class="x:cursor-pointer x:h-7 x:rounded-md x:px-2 x:text-xs x:font-medium x:transition-colors x:text-gray-600 x:dark:text-gray-400 x:rounded-none" id="headlessui-listbox-button-_R_6sl5fivblb_" type="button" aria-haspopup="listbox" aria-expanded="false" data-headlessui-state=""><svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" width="12" class="x:rotate-90"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div><div id="nextra-skip-nav"></div><main data-pagefind-body="true"><h1 class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-bold x:mt-2 x:text-4xl">The Anoma Protocol Adapter</h1>
<h2 id="what-is-the-anoma-protocol-adapter" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border">What is the Anoma Protocol Adapter?<a href="#what-is-the-anoma-protocol-adapter" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h2>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">The Anoma Protocol Adapter (PA) implements the Anoma DOS on an existing blockchain (L1s, L2s, etc.). It enables users, developers, and applications to access the Anoma Resource Machine (ARM) and all its features
<strong>without making any changes</strong>. This deployment also allows the upcoming Anoma applications, such as <a href="https://x.com/anomapay" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">AnomaPay<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>, to simply work on the base chain.</p>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">Dive deeper into the PA:</p>
<ul class="x:[:is(ol,ul)_&amp;]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]">
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://ethresear.ch/t/the-anoma-protocol-adapter-is-live-on-ethereum/23466?ref=docs.anoma.net" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">PA &amp; ARM on Ethereum post on Ethresear.ch<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a></li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://github.com/anoma/evm-protocol-adapter?ref=docs.anoma.net" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Implementation of the EVM PA<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a></li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://www.youtube.com/watch?v=rKFZsOw360U" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">“The EVM Protocol Adapter: Bringing Intent-Centric Apps to Ethereum” at Anoma Research Day<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a></li>
</ul>
<h2 id="deployments" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border">Deployments<a href="#deployments" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h2>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">The Anoma PA is currently live on the following mainnets:</p>
<ul class="x:[:is(ol,ul)_&amp;]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]">
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://x.com/anoma/status/1990798499563385222?s=20" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Ethereum<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> (<a href="https://etherscan.io/address/0x46E622226F93Ed52C584F3f66135CD06AF01c86c#code" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">contract<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>, <a href="https://etherscan.io/tx/0x3a0999f4f67e6c7ef7a22cb19f3b458b497fa29f69a653f776e77194c415a024" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">tx<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>)</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://x.com/anoma/status/1995523551018008777?s=20" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Arbitrum<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> (<a href="https://arbiscan.io/address/0x6d0a05e3535bd4d2c32aad37ffb28fd0e1e528c3#code" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">contract<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>, <a href="https://arbiscan.io/address/0x6d0a05e3535bd4d2c32aad37ffb28fd0e1e528c3#code" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">tx<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>)</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://x.com/anoma/status/1998776484714987854?s=20" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Base<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> (<a href="https://basescan.org/address/0x6d0A05E3535bd4D2C32AaD37FFB28fd0E1e528c3#code" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">contract<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>, <a href="https://basescan.org/tx/0xd742878a2ca7deb2bacbe86bcf8c903c4cb683f8512e5fdd0e97b6ba99d24f68" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">tx<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>)</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><a href="https://x.com/anoma/status/2019802605023609207?s=20" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Optimism<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> (<a href="https://optimistic.etherscan.io/address/0x094FCC095323080e71a037b2B1e3519c07dd84F8" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">contract<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>, <a href="https://optimistic.etherscan.io/tx/0xa763c3f9f66545503d4bd10d41bc9f8ed80aee5ed2fac22f58742fa0d90103ef" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">tx<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>)</li>
</ul>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">Dozens of additional deployments are planned, follow <a href="https://basescan.org/tx/0xd742878a2ca7deb2bacbe86bcf8c903c4cb683f8512e5fdd0e97b6ba99d24f68" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">@anoma on X<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> to stay up-to-date.</p>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">You can also use the <a href="http://explorer.anoma.net/" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">Anoma Explorer<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a> to view live Protocol Adapter deployments and explore indexed transactions across all deployed Protocol Adapters.</p>
<h2 id="how-to-deploy-your-own-pa" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border">How to deploy your own PA?<a href="#how-to-deploy-your-own-pa" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h2>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">Developers who are interested in deploying the Anoma PA can follow this <a href="https://github.com/anoma/evm-protocol-adapter/blob/main/README.md#deployment" target="_blank" rel="noreferrer" class="x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font] !text-anoma">README<!-- --> <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" height="1em" class="x:inline x:align-baseline x:shrink-0"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg></a>.</p></main><div class="x:mt-12 x:mb-8 x:text-xs x:text-gray-600 x:text-end x:dark:text-gray-400">Last updated on<!-- --> <time dateTime="2026-02-18T16:04:05.000Z">February 18, 2026</time></div><div class="x:mb-8 x:flex x:items-center x:border-t x:pt-8 nextra-border x:print:hidden"><a title="The Anoma Resource Machine" class="x:focus-visible:nextra-focus x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100 x:flex x:max-w-[50%] x:items-center x:gap-1 x:py-4 x:text-base x:font-medium x:transition-colors x:[word-break:break-word] x:md:text-lg x:pe-4" href="/anoma-resource-machine"><svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" height="20" class="x:inline x:shrink-0 x:ltr:rotate-180"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="grid grid-cols-[max-content_auto] gap-2"><span class="inline-flex w-full h-[1.15em] mt-[0.1em]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 17" fill="none"><path d="M16.25 3.79814L8.4375 6.92314L0.625 3.79814L8.4375 0.673141L16.25 3.79814Z" fill="currentColor" fill-opacity="0.2"></path><path d="M0.625 3.79814L8.4375 0.673141L16.25 3.79814V13.1731L8.4375 16.2981L0.625 