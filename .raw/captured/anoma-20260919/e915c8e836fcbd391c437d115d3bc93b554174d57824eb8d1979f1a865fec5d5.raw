.75zm1.75-.25a.25.25 0 00-.25.25v12.5c0 .138.112.25.25.25H9.5v-13H1.75zm12.5 13H11v-13h3.25a.25.25 0 01.25.25v12.5a.25.25 0 01-.25.25z"></path></svg></button></div></aside><nav class="nextra-toc x:order-last x:max-xl:hidden x:w-64 x:shrink-0 x:print:hidden" aria-label="table of contents"><div class="x:grid x:grid-rows-[min-content_1fr_min-content] x:sticky x:top-(--nextra-navbar-height) x:text-sm x:max-h-[calc(100vh-var(--nextra-navbar-height))]"><p class="x:pt-6 x:px-4 x:font-semibold x:tracking-tight">On This Page</p><ul class="x:p-4 nextra-scrollbar x:overscroll-y-contain x:overflow-y-auto x:hyphens-auto nextra-mask"><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#key-storage-and-security" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Key storage and security</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#never-expose-private-keys" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Never expose private keys</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#prefer-passkey-derivation" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Prefer passkey derivation</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#separate-storage-for-the-discovery-key-pair" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Separate storage for the discovery key pair</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#wasm-initialization" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">WASM initialization</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#initialize-once-at-app-startup" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Initialize once at app startup</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#initialize-transferbuilder-once-and-reuse" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Initialize <code class="nextra-code" dir="ltr">TransferBuilder</code> once and reuse</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#error-handling" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Error handling</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#catch-responseerror-from-api-clients" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Catch <code class="nextra-code" dir="ltr">ResponseError</code> from API clients</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#handle-insufficientresourceserror" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Handle <code class="nextra-code" dir="ltr">InsufficientResourcesError</code></a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#use-getfirsterrormessage-in-ui-error-boundaries" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Use <code class="nextra-code" dir="ltr">getFirstErrorMessage</code> in UI error boundaries</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#permit2-nonces" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Permit2 nonces</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#resource-polling" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Resource polling</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#refresh-resources-on-a-fixed-interval" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Refresh resources on a fixed interval</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#timestamp-filter-nullifier-queries" class="x:focus-visible:nextra-focus x:ms-3 x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Timestamp-filter nullifier queries</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#queue-load-monitoring" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Queue load monitoring</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#fee-fluctuation-tolerance" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Fee fluctuation tolerance</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#multi-receiver-transfers" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Multi-receiver transfers</a></li><li class="x:my-2 x:scroll-my-6 x:scroll-py-6"><a href="#retry-logic" class="x:focus-visible:nextra-focus x:font-semibold x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words">Retry logic</a></li></ul><div class="x:grid x:gap-2 x:py-4 x:mx-4 x:border-t nextra-border"><button class="x:transition x:cursor-pointer x:flex x:items-center x:gap-1.5 x:whitespace-nowrap x:opacity-0 x:text-xs x:font-medium x:transition x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100" aria-hidden="true" type="button" disabled="" data-headlessui-state="disabled" data-disabled="">Scroll to top<svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" height="1.1em" class="x:-rotate-90 x:border x:rounded-full x:border-current"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></nav><article class="x:w-full x:min-w-0 x:break-words x:min-h-[calc(100vh-var(--nextra-navbar-height))] x:text-slate-700 x:dark:text-slate-200 x:pb-8 x:px-4 x:pt-4 x:md:px-12"><div class="nextra-breadcrumb x:mt-1.5 x:flex x:items-center x:gap-1 x:overflow-hidden x:text-sm x:text-gray-600 x:dark:text-gray-400 x:contrast-more:text-current"><span class="x:whitespace-nowrap x:transition-colors x:font-medium x:text-black x:dark:text-gray-100" title="Best Practices"><span class="grid grid-cols-[max-content_auto] gap-2"><span class="inline-flex w-full h-[1.15em] mt-[0.1em]"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><g stroke="currentColor" stroke-width="1.5"><path d="M14 17h8v5h-8v-5ZM15.5 17v-2.5a2.5 2.5 0 0 1 5 0V17M2 1v6M2 9v6M9 17v6M13 1v6M17 1v6M6 2h3v4H6V2ZM6 10h3v4H6v-4ZM2 18h3v4H2v-4Z"></path></g></svg></span>Best Practices</span></span></div><div class="x:border x:inline-flex x:rounded-md x:items-stretch nextra-border x:float-end x:overflow-hidden"><button class="x:transition x:cursor-pointer x:ps-2 x:pe-1 x:flex x:gap-2 x:text-sm x:font-medium x:items-center" type="button" data-headlessui-state=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4C2.89543 15 2 14.1046 2 13V4C2 2.89543 2.89543 2 4 2H13C14.1046 2 15 2.89543 15 4V5"></path></svg>Copy page</button><button class="x:cursor-pointer x:h-7 x:rounded-md x:px-2 x:text-xs x:font-medium x:transition-colors x:text-gray-600 x:dark:text-gray-400 x:rounded-none" id="headlessui-listbox-button-_R_6sl5fivblb_" type="button" aria-haspopup="listbox" aria-expanded="false" data-headlessui-state=""><svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" width="12" class="x:rotate-90"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div><div id="nextra-skip-nav"></div><main data-pagefind-body="true"><h1 class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-bold x:mt-2 x:text-4xl">Best Practices</h1>
<h2 id="key-storage-and-security" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border">Key storage and security<a href="#key-storage-and-security" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h2>
<h3 id="never-expose-private-keys" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl">Never expose private keys<a href="#never-expose-private-keys" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h3>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">The keyring contains four private keys. Treat the serialized keyring with the same care as a wallet seed phrase:</p>
<ul class="x:[:is(ol,ul)_&amp;]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]">
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><strong>Use <code class="nextra-code" dir="ltr">sessionStorage</code></strong> for in-browser apps. Session storage is cleared when the tab closes, minimizing the window during which a stolen key is usable.</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><strong>Never put the serialized keyring in <code class="nextra-code" dir="ltr">localStorage</code></strong> unencrypted. LocalStorage persists indefinitely and is accessible to any script running on your origin.</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><strong>Never transmit the keyring over the network.</strong> All operations that require private keys (signing, decryption) must happen client-side.</li>
<li class="my-[1em] text-neutral-700 dark:text-neutral-200 leading-[1.65em]"><strong>Consider an encrypted vault.</strong> For persistent login, encrypt the serialized keyring with a user-derived key (e.g. from a passkey PRF output or a PBKDF2-stretched password) before storing it.</li>
</ul>
<h3 id="prefer-passkey-derivation" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl">Prefer passkey derivation<a href="#prefer-passkey-derivation" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h3>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">For browser apps, derive the keyring from a WebAuthn passkey using the PRF extension. This ties key access to the user’s authenticator hardware and avoids storing private key material anywhere:</p>
<div data-pagefind-ignore="all" class="nextra-code x:relative x:not-first:mt-[1.25em]"><pre class="x:group x:focus-visible:nextra-focus x:overflow-x-auto x:subpixel-antialiased x:text-[.9em] x:bg-white x:dark:bg-black x:py-4 x:ring-1 x:ring-inset x:ring-gray-300 x:dark:ring-neutral-700 x:contrast-more:ring-gray-900 x:contrast-more:dark:ring-gray-50 x:contrast-more:contrast-150 x:rounded-md not-prose" tabindex="0"><div class="x:group-hover:opacity-100 x:group-focus:opacity-100 x:opacity-0 x:transition x:focus-within:opacity-100 x:flex x:gap-1 x:absolute x:right-4 x:top-2"><button class="x:transition x:cursor-pointer x:border x:border-gray-300 x:dark:border-neutral-700 x:contrast-more:border-gray-900 x:contrast-more:dark:border-gray-50 x:rounded-md x:p-1.5 x:md:hidden" title="Toggle word wrap" type="button" data-headlessui-state=""><svg viewBox="0 0 24 24" fill="currentColor" height="1em"><path d="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3l3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z"></path></svg></button></div><code class="nextra-code" dir="ltr"><span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">import</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8"> { createUserKeyringFromPasskey } </span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">from</span><span style="--shiki-light:#032F62;--shiki-dark:#9ECBFF"> &quot;@anomaorg/anoma-app-sdk&quot;</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">;</span></span>
<span> </span>
<span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">const</span><span style="--shiki-light:#005CC5;--shiki-dark:#79B8FF"> keyring</span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583"> =</span><span style="--shiki-light:#6F42C1;--shiki-dark:#B392F0"> createUserKeyringFromPasskey</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">(credential);</span></span>
<span><span style="--shiki-light:#6A737D;--shiki-dark:#6A737D">// The keyring is derived fresh on each login — nothing is stored</span></span></code></pre></div>
<h3 id="separate-storage-for-the-discovery-key-pair" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl">Separate storage for the discovery key pair<a href="#separate-storage-for-the-discovery-key-pair" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h3>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">The discovery key pair is registered with the Indexer and is less sensitive than the signing/nullifier keys, but it is still a private key. Register it once and never re-register unnecessarily — doing so will not break anything but is wasted work.</p>
<h2 id="wasm-initialization" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border">WASM initialization<a href="#wasm-initialization" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h2>
<h3 id="initialize-once-at-app-startup" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl">Initialize once at app startup<a href="#initialize-once-at-app-startup" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h3>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200"><code class="nextra-code" dir="ltr">initWasm()</code> loads the WebAssembly module. Call it once at application startup before any other SDK calls:</p>
<div data-pagefind-ignore="all" class="nextra-code x:relative x:not-first:mt-[1.25em]"><pre class="x:group x:focus-visible:nextra-focus x:overflow-x-auto x:subpixel-antialiased x:text-[.9em] x:bg-white x:dark:bg-black x:py-4 x:ring-1 x:ring-inset x:ring-gray-300 x:dark:ring-neutral-700 x:contrast-more:ring-gray-900 x:contrast-more:dark:ring-gray-50 x:contrast-more:contrast-150 x:rounded-md not-prose" tabindex="0"><div class="x:group-hover:opacity-100 x:group-focus:opacity-100 x:opacity-0 x:transition x:focus-within:opacity-100 x:flex x:gap-1 x:absolute x:right-4 x:top-2"><button class="x:transition x:cursor-pointer x:border x:border-gray-300 x:dark:border-neutral-700 x:contrast-more:border-gray-900 x:contrast-more:dark:border-gray-50 x:rounded-md x:p-1.5 x:md:hidden" title="Toggle word wrap" type="button" data-headlessui-state=""><svg viewBox="0 0 24 24" fill="currentColor" height="1em"><path d="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3l3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z"></path></svg></button></div><code class="nextra-code" dir="ltr"><span><span style="--shiki-light:#6A737D;--shiki-dark:#6A737D">// e.g. in your React app entry point or _app.tsx</span></span>
<span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">import</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8"> { initWasm } </span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">from</span><span style="--shiki-light:#032F62;--shiki-dark:#9ECBFF"> &quot;@anomaorg/anoma-app-sdk&quot;</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">;</span></span>
<span> </span>
<span><span style="--shiki-light:#D73A49;--shiki-dark:#F97583">await</span><span style="--shiki-light:#6F42C1;--shiki-dark:#B392F0"> initWasm</span><span style="--shiki-light:#24292E;--shiki-dark:#E1E4E8">();</span></span></code></pre></div>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200">Calling <code class="nextra-code" dir="ltr">initWasm()</code> multiple times is safe but unnecessarily reloads the module.</p>
<h3 id="initialize-transferbuilder-once-and-reuse" class="x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-8 x:text-2xl">Initialize <code class="nextra-code" dir="ltr">TransferBuilder</code> once and reuse<a href="#initialize-transferbuilder-once-and-reuse" class="x:focus-visible:nextra-focus subheading-anchor" aria-label="Permalink for this section"></a></h3>
<p class="not-first:mt-[1.5em] leading-[1.65em] text-neutral-700 dark:text-neutral-200"><code class="nextra-code" dir="ltr">TransferBuilder.init()</code> also loads the WASM module (it calls <code class="nextra-code" dir="ltr">initWasm</code> internally). Create one instance and reuse it across all transfer operations in a session rather than calling <code class="nextra-code" dir="ltr">init()</code> per transaction:</p>
