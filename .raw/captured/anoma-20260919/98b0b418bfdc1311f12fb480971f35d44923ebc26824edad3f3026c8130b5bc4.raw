found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"33:I[55169,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"TOCProvider\"]\n34:I[769,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"Sidebar\"]\n35:I[47486,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"ClientWrapper\"]\n36:Td9a,"])</script><script>self.__next_f.push([1,"import { Disclaimer } from \"../components/Disclaimer.tsx\"\nimport { Steps } from 'nextra/components'\n\n# Getting Started\n\n## Requirements\n\n| Requirement | Minimum version |\n| --- | --- |\n| Node.js | `\u003e= 22` |\n| npm | bundled with Node.js |\n\n## Install the package\n\n```bash\nnpm install @anomaorg/anoma-app-sdk\n```\n\nFor React applications using wagmi for wallet interactions, also install:\n\n```bash\nnpm install wagmi viem\n```\n\n## WebAssembly initialization\n\nThe SDK's cryptographic layer is compiled from Rust to WebAssembly. Call `initWasm()` once before using any cryptographic operations. The best place for this is at application startup, before rendering your UI.\n\n```ts\nimport { initWasm } from \"@anomaorg/anoma-app-sdk\";\n\nawait initWasm();\n```\n\nIn browser environments the WASM module is loaded automatically from the bundle. In Node.js (e.g. tests or scripts) it works out of the box on Node.js 22+.\n\n\u003cDisclaimer\u003e\nCall initWasm() exactly once per application lifecycle. Calling it multiple times is harmless but wasteful. Failing to call it before using cryptographic functions will throw a runtime error.\n\u003c/Disclaimer\u003e\n\n## Quick start\n\nThe three operations below cover the most common startup path.\n\n### 1. Generate a keyring\n\nA **keyring** holds the four cryptographic key pairs that identify a user on the Anoma Pay protocol. Generate a fresh random one with:\n\n```ts\nimport { createUserKeyring } from \"@anomaorg/anoma-app-sdk\";\n\nconst keyring = createUserKeyring();\n```\n\nFor deterministic derivation from a 32-byte seed (e.g. derived from a wallet signature):\n\n```ts\nimport { createUserKeyring } from \"@anomaorg/anoma-app-sdk\";\n\nconst seed: Uint8Array = /* 32 bytes from your entropy source */;\nconst keyring = createUserKeyring(seed);\n```\n\n### 2. Produce a Pay Address\n\nA **Pay Address** encodes a user's public keys into a single shareable string. Others send tokens to this address.\n\n```ts\nimport {\n  createUserKeyring,\n  encodePayAddress,\n  extractUserPublicKeys,\n} from \"@anomaorg/anoma-app-sdk\";\n\nconst keyring = createUserKeyring();\nconst publicKeys = extractUserPublicKeys(keyring);\nconst payAddress = encodePayAddress(publicKeys);\n\nconsole.log(payAddress); // Base64URL-encoded, 180 characters\n```\n\n### 3. Validate a received Pay Address\n\nBefore sending tokens, validate that an address is well-formed:\n\n```ts\nimport { isValidPayAddress, decodePayAddress } from \"@anomaorg/anoma-app-sdk\";\n\nconst raw = \"...\";\n\nif (isValidPayAddress(raw)) {\n  const receiverKeys = decodePayAddress(raw);\n  // receiverKeys.authorityPublicKey, .discoveryPublicKey, etc.\n}\n```\n\n### 4. Persist and restore a keyring\n\nSerialize the keyring to a JSON string for storage:\n\n```ts\nimport {\n  serializeUserKeyring,\n  deserializeUserKeyring,\n} from \"@anomaorg/anoma-app-sdk\";\n\n// Save\nconst json = serializeUserKeyring(keyring);\nsessionStorage.setItem(\"keyring\", json);\n\n// Restore\nconst stored = sessionStorage.getItem(\"keyring\");\nif (stored) {\n  const restored = deserializeUserKeyring(stored);\n}\n```\n\n\u003cDisclaimer\u003e\nThe serialized keyring contains private key material. Store it only in secure, user-controlled storage (e.g. sessionStorage, an encrypted vault) and never transmit it over the network.\n\u003c/Disclaimer\u003e\n\n## Next steps\n\n- Read [Key Management](/key-management) for a full explanation of the key hierarchy.\n- Read [Transfers](/transfers) to understand mint, transfer, and burn operations.\n- Follow the [Build a Simple App](/build-simple-app) guide for an end-to-end React integration."])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"x:mx-auto x:flex x:max-w-(--nextra-content-width)\",\"children\":[\"$\",\"$L33\",null,{\"value\":[{\"value\":\"Requirements\",\"id\":\"requirements\",\"depth\":2},{\"value\":\"Install the package\",\"id\":\"install-the-package\",\"depth\":2},{\"value\":\"WebAssembly initialization\",\"id\":\"webassembly-initialization\",\"depth\":2},{\"value\":\"Quick start\",\"id\":\"quick-start\",\"depth\":2},{\"value\":\"1. Generate a keyring\",\"id\":\"1-generate-a-keyring\",\"depth\":3},{\"value\":\"2. Produce a Pay Address\",\"id\":\"2-produce-a-pay-address\",\"depth\":3},{\"value\":\"3. Validate a received Pay Address\",\"id\":\"3-validate-a-received-pay-address\",\"depth\":3},{\"value\":\"4. Persist and restore a keyring\",\"id\":\"4-persist-and-restore-a-keyring\",\"depth\":3},{\"value\":\"Next steps\",\"id\":\"next-steps\",\"depth\":2}],\"children\":[[\"$\",\"$L34\",null,{}],[\"$\",\"$L35\",null,{\"metadata\":\"$2:props:children:1:props:children:props:children:props:children:2:props:pageMap:15:frontMatter\",\"bottomContent\":\"$undefined\",\"sourceCode\":\"$36\",\"children\":[\"$L37\",\"$L38\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"39:I[63894,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/73350e696300078d.js\",\"/_next/static/chunks/3a4fb10029fc91d1.js\",\"/_next/static/chunks/2166b7d4a87176d4.js\"],\"HeadingAnchor\"]\n3a:I[83987,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/s